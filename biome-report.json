e anti-re-litigation line exists to prevent.`;\n\n    case \"digest-mismatch\":\n      return `${path} still names the right log head, but its CONTENT has changed since it was written (expected digest ${verification.expected ?? \"?\"}, found ${verification.found ?? \"?\"}). The log has not moved; the file was edited in place. An agent that rewrites a rule without superseding it has done exactly what the anti-re-litigation line exists to prevent.`;\n  }\n}\n\n/** The event payload shape `ExportIntegrityMismatch` expects, for the store to write. */\nexport function mismatchPayload(\n  path: string,\n  expectedHead: string,\n  verification: StampVerification,\n): { path: string; expectedHead: string; foundHead: string | null } {\n  return {\n    path,\n    expectedHead,\n    foundHead: verification.ok ? null : (verification.found ?? null),\n  };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Stamp verification ΓÇö 5.5.\n *\n  const record = parsed as Record<string, unknown>;\n  const head = typeof record[\"head\"] === \"string\" ? record[\"head\"]record.head : \"\";\n  if (head.length === 0) return null;\n  };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":65}},{"diffOp":{"equal":{"range":[37,142]}}},{"diffOp":{"delete":{"range":[142,156]}}},{"diffOp":{"insert":{"range":[156,167]}}},{"diffOp":{"equal":{"range":[167,168]}}},{"diffOp":{"equal":{"range":[168,212]}}},{"equalLines":{"line_count":103}},{"diffOp":{"equal":{"range":[212,219]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\stamp\\verify.ts"}