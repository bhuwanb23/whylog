ncies: {}, devDependencies: {} };\n  }\n}\n\nfunction listFiles(dir, out) {\n  out = out || [];\n  let entries;\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    if (entry.name === \"node_modules\" || entry.name === \".git\") continue;\n    const full = path.join(dir, entry.name);\n    if (entry.isDirectory()) listFiles(full, out);\n    else out.push(full.split(path.sep).join(\"/\"));\n  }\n  return out;\n}\n\nfunction readFile(p) {\n  try {\n    return fs.readFileSync(p, \"utf8\");\n  } catch {\n    return undefined;\n  }\n}\n\n/* -------------------------------------------------------------------- glob -- */\n/* Transcribed from src/lib/glob.ts so results match the in-browser run.      */\n\nfunction globToRegExpSource(glob) {\n  let out = \"\";\n  for (let i = 0; i < glob.length; i += 1) {\n    const c = glob[i];\n    if (c === \"*\") {\n      if (glob[i + 1] === \"*\") {\n        if (glob[i + 2] === \"/\") { out += \"(?:.*/)?\"; i += 2; }\n        else { out += \".*\"; i += 1; }\n      } else out += \"[^/]*\";\n    } else if (c === \"?\") out += \"[^/]\";\n    else if (c === \".\") out += \"\\\\.\";\n    else if (\"+^${}|()[]\".includes(c)) out += \"\\\\\" + c;\n    else out += c;\n  }\n  return out;\n}\n\nfunction matchesGlob(p, glob) {\n  return new RegExp(\"^\" + globToRegExpSource(glob) + \"$\").test(p);\n}\n\n/* Word boundaries ON by default: a bare substring match on \"pg\" hits \"pgp\",   */\n/* \"pgsql-tools\" and any passing mention in a comment.                        */\nfunction compilePattern(pattern, wordBoundary, caseSensitive) {\n  const escaped = pattern.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n  const source = wordBoundary === false ? escaped : \"\\\\b\" + escaped + \"\\\\b\";\n  return new RegExp(source, caseSensitive ? \"g\" : \"gi\");\n}\n\nfunction findMatchInText(text, pattern, wordBoundary, caseSensitive) {\n  const re = compilePattern(pattern, wordBoundary, caseSensitive);\n  const lines = text.split(\"\\n\");\n  for (let i = 0; i < lines.length; i += 1) {\n    re.lastIndex = 0;\n    if (re.test(lines[i])) return { line: i + 1, text: lines[i].trim() };\n  }\n  return null;\n}\n\n/* ---------------------------------------------------------------- evaluate -- */\n\nfunction evaluate(guard, project) {\n  const spec = guard.spec;\n\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\": {\n      /* Same asymmetry as the browser: an ABSENCE check covers devDependencies, because a\n       * rejected package installed for tooling is still installed. A PRESENCE check does not,\n       * because a build-only dependency does not mean the decision was implemented. */\n      const includeDev = spec.includeDev === undefined\n        ? spec.kind === \"dependency_absent\"\n        : spec.includeDev;\n\n      const inRuntime = project.dependencies[spec.package];\n      const inDev = includeDev ? project.devDependencies[spec.package] : undefined;\n      const version = inRuntime !== undefined ? inRuntime : inDev;\n      const where = inRuntime !== undefined ? \"dependencies\" : \"devDependencies\";\n\n      if (spec.kind === \"dependency_present\") {\n        return version === undefined\n          ? { outcome: \"fail\", evidence: '\"' + spec.package + '\" is not in package.json' + (includeDev ? \" (checked dependencies and devDependencies)\" : \" (checked dependencies only)\") }\n          : { outcome: \"pass\", evidence: '\"' + spec.package + '\": \"' + version + '\" is present in ' + where };\n      }\n      return version !== undefined\n        ? { outcome: \"fail\", evidence: '\"' + spec.package + '\": \"' + version + '\" found in package.json ' + where }\n        : { outcome: \"pass\", evidence: '\"' + spec.package + '\" does not appear in package.json' };\n    }\n\n    case \"path_glob_exists\":\n    case \"path_glob_absent\": {\n      const matches = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (spec.kind === \"path_glob_exists\") {\n        return matches.length === 0\n          ? { outcome: \"fail\", evidence: \"No file matches `\" + spec.glob + \"` among \" + project.files.length + \" path(s)\" }\n          : { outcome: \"pass\", evidence: matches.length + \" file(s) match `\" + spec.glob + \"`: \" + matches.slice(0, 6).join(\", \") };\n      }\n      return matches.length > 0\n        ? { outcome: \"fail\", evidence: matches.length + \" file(s) match `\" + spec.glob + \"` but none should: \" + matches.slice(0, 6).join(\", \") }\n        : { outcome: \"pass\", evidence: \"No file matches `\" + spec.glob + \"`\" };\n    }\n\n    case \"string_in_files\":\n    case \"string_absent_in_files\": {\n      const scoped = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (scoped.length === 0) {\n        return { outcome: \"skip\", evidence: \"no file matches the scope `\" + spec.glob + \"`\" };\n      }\n      const wordBoundary = spec.wordBoundary === undefined ? true : spec.wordBoundary;\n      const caseSensitive = spec.caseSensitive === undefined ? false : spec.caseSensitive;\n\n      for (const file of scoped) {\n        const text = readFile(file);\n        if (text === undefined) continue;\n        const hit = findMatchInText(text, spec.pattern, wordBoundary, caseSensitive);\n        if (hit === null) continue;\n\n        const where = file + \":\" + hit.line;\n        const quoted = JSON.stringify(hit.text.length > 160 ? hit.text.slice(0, 157) + \"...\" : hit.text);\n        if (spec.kind === \"string_absent_in_files\") {\n          return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n        }\n        return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n      }\n\n      if (spec.kind === \"string_in_files\") {\n        return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching `\" + spec.glob + \"`\" };\n      }\n      return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching `\" + spec.glob + \"`\" };\n    }\n\n    case \"command_exit_zero\": {\n      /* CI has a shell, which the browser does not. This is the one kind whose result can\n       * legitimately differ between the two targets, and it is environment-dependent by\n       * nature ΓÇö which is why it is never `blocking` by default. */\n      try {\n        const { execSync } = require(\"node:child_process\");\n        execSync(spec.command, { stdio: \"pipe\", cwd: spec.cwd || \".\" });\n        return { outcome: \"pass\", evidence: \"`\" + spec.command + \"` exited 0\" };\n      } catch (error) {\n        const out = (error.stdout || error.stderr || \"\").toString().trim().split(\"\\n\")[0] || \"\";\n        return { outcome: \"fail\", evidence: \"`\" + spec.command + \"` exited non-zero\" + (out ? \": \" + out : \"\") };\n      }\n    }\n\n    default:\n      return { outcome: \"skip\", evidence: \"kind \" + spec.kind + \" cannot run in CI without a model\" };\n  }\n}\n\n/* ----------------------------------------------------------------- report -- */\n/* The failure message is the product. It does the job of an ADR, a code-review */\n/* comment and an onboarding document, at the moment it is useful.             */\n\nfunction reportFailure(guard, result) {\n  const lines = [];\n  lines.push(\"\");\n  lines.push(\"\\x1b[31m\\u2717 \" + guard.decisionId + \" \\u2014 \" + guard.statement + \"\\x1b[0m\");\n  lines.push(\"  Guard \" + guard.id + \" (\" + guard.kind + \": \" + guard.target + \") FAILED  [\" + guard.severity + \"]\");\n  lines.push(\"  Evidence: \" + result.evidence);\n  lines.push(\"  Why this check verifies that decision: \" + guard.rationale);\n\n  const premises = guard.restsOn.length === 0\n    ? \"nothing recorded\"\n    : guard.restsOn.map((p) => p.id + \" \" + p.text + \" (\" + p.label + \")\").join(\", \");\n  lines.push(\"  Decided: \" + guard.decidedAt + \" \\u00b7 Rests on: \" + premises);\n\n  if (guard.restsOn.length === 0) {\n    lines.push(\"    (no recorded premise, so nothing can falsify it \\u2014 a gap worth filling in WhyLog)\");\n  }\n\n  for (const alt of guard.rejected) {\n    lines.push(\"  Rejected alternative \" + alt.value + (alt.whyRejected ? \" \\u2014 reason: \\\"\" + alt.whyRejected + \"\\\"\" : \" \\u2014 no reason recorded\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"  \\u2192 Is this a deliberate reversal?   Record it in WhyLog so the log stops claiming otherwise.\");\n  lines.push(\"  \\u2192 Or is this drift?                Undo the change: \" + undoHint(guard));\n  return lines.join(\"\\n\");\n}\n\nfunction undoHint(guard) {\n  switch (guard.kind) {\n    case \"dependency_absent\": return \"remove the \\\"\" + guard.target + \"\\\" dependency.\";\n    case \"dependency_present\": return \"install \\\"\" + guard.target + \"\\\", or record the decision that replaced it.\";\n    case \"path_glob_absent\": return \"remove the file(s) matching \\\"\" + guard.target + \"\\\".\";\n    case \"path_glob_exists\": return \"restore the file(s) matching \\\"\" + guard.target + \"\\\".\";\n    case \"string_absent_in_files\": return \"remove \\\"\" + guard.target + \"\\\" from the files in scope.\";\n    case \"string_in_files\": return \"add \\\"\" + guard.target + \"\\\" where the decision expects it.\";\n    default: return \"see the guard's rationale above.\";\n  }\n}\n\n/* -------------------------------------------------------------------- main -- */\n\n/* `--decision WLD-0007` restricts the run to one decision's guards. The verify command exported */\n/* into CLAUDE.md / AGENTS.md / DECISIONS.md uses exactly this flag, so an agent can check one    */\n/* rule without running the whole set. It is supported HERE rather than by a second runner: two   */\n/* runners would drift, and a verify command naming a flag the runner ignores would exit 0 for a  */\n/* decision that is broken.                                                                       */\nfunction parseArgs(argv) {\n  const opts = { decision: null };\n  for (let i = 0; i < argv.length; i += 1) {\n    if (argv[i] === \"--decision\" && argv[i + 1] !== undefined) { opts.decision = argv[i + 1]; i += 1; }\n    else if (typeof argv[i] === \"string\" && argv[i].startsWith(\"--decision=\")) { opts.decision = argv[i].slice(11); }\n  }\n  return opts;\n}\n\nfunction main() {\n  const opts = parseArgs(process.argv.slice(2));\n  const manifest = readManifest();\n  const files = listFiles(\".\");\n  const project = { dependencies: manifest.dependencies, devDependencies: manifest.devDependencies, files: files };\n\n  const selected = opts.decision === null ? GUARDS : GUARDS.filter((g) => g.decisionId === opts.decision);\n\n  if (opts.decision !== null && selected.length === 0) {\n    /* Exiting 0 here would tell an agent the decision is fine when the truth is that this runner\n     * holds no guards for it ΓÇö most likely because the export predates the decision. Exit 2 says\n     * \"I could not check this\", which is a different claim from \"it passed\". */\n    console.error(\"\u001b[31mNo guards in this runner for decision \" + opts.decision + \".\u001b[0m\");\n    console.error(\"The exported runner is probably older than that decision. Re-export from WhyLog.\");\n    process.exit(2);\n  }\n\n  console.log(\"WhyLog decision guards \\u00b7 \" + selected.length + \" of \" + GUARDS.length + \" guard(s)\" + (opts.decision === null ? \"\" : \" for \" + opts.decision) + \" \\u00b7 \" + files.length + \" file(s) scanned\");\n\n  let blocking = 0;\n  let warnings = 0;\n  let passed = 0;\n  let skipped = 0;\n\n  for (const guard of selected) {\n    const result = evaluate(guard, project);\n\n    if (result.outcome === \"pass\") { passed += 1; continue; }\n    if (result.outcome === \"skip\") {\n      skipped += 1;\n      console.log(\"\\x1b[33m\\u2013 \" + guard.id + \" SKIPPED\\x1b[0m (\" + guard.kind + \": \" + guard.target + \") \\u2014 \" + result.evidence);\n      continue;\n    }\n\n    if (guard.severity === \"blocking\") blocking += 1;\n    else warnings += 1;\n\n    console.log(reportFailure(guard, result));\n  }\n\n  console.log(\"\");\n  console.log(\"  passed \" + passed + \" \\u00b7 failed \" + (blocking + warnings) + \" (\" + blocking + \" blocking, \" + warnings + \" warning) \\u00b7 skipped \" + skipped);\n\n  if (blocking > 0) {\n    console.log(\"\\n\\x1b[31m\" + blocking + \" blocking decision guard(s) failed.\\x1b[0m\");\n    console.log(\"Each failure above names the decision, the premise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\n\" + warnings + \" warning-level guard(s) failed \\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * DecisionMemEval ΓÇö the evaluation harness, the metric suite and the ablation study.\n *} from \"./metrics\";\nexport type { ScoredRun } from \"./metrics\";\nexport { \n  COMPARATORS,METRIC_NAMES,UNUSUAL_METRICS,meanReciprocalRank,precisionAtK,precisionRecall,\n} from \"./metrics/types\";\nexport type { EngineMetric, MetricId, MetricResult, PrecisionRecall } from \"./metrics/types\";\nexport { MATCH_RULE, align, overlapOf } from \"./metrics/match\";export { describeStudy, runAblation } from \"./ablation/run\";\nexport type { AblationOutcome, AblationStudy, StudyOptions } from \"./ablation/run\";\nexport {TABLE_METRICS,buildDeltaRows,renderAblationTable,renderPredictionAudit} from \"./ablation/table\";\nexport type { DeltaRow, PredictionVerdict, VerdictKind } from \"./ablation/table\";\n/* --- the report (7.7) --- */\nexport { renderFullReport } from \"./report\";\n","ops":[{"diffOp":{"equal":{"range":[0,94]}}},{"equalLines":{"line_count":70}},{"diffOp":{"equal":{"range":[94,166]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[170,182]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[182,195]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[195,211]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[211,230]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[230,243]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[243,258]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[258,260]}}},{"diffOp":{"equal":{"range":[260,443]}}},{"equalLines":{"line_count":15}},{"diffOp":{"equal":{"range":[443,596]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[596,610]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[610,625]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[625,645]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,170]}}},{"diffOp":{"equal":{"range":[645,666]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[258,260]}}},{"diffOp":{"equal":{"range":[666,775]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[775,851]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\index.ts"},"span":null,"sourceCode":"/**\n * DecisionMemEval ΓÇö the evaluation harness, the metric suite and the ablation study.\n *\n * Phase 7 ┬╖ one import site.\n *\n * Three entry points, all runnable keyless:\n *   `npm run eval`           baseline run, thirteen metrics, every honest note printed\n *   `npm run eval:ablation`  fifteen configurations, delta table, prediction audit\n *   `npm run eval:report`    writes docs/generated/EVAL-REPORT.md\n *\n * The modules below are pure: no filesystem, no console, no `process`. Only `cli.ts`, `run.ts`,\n * `report.ts` and `ablation/cli.ts` touch the outside world, which is what keeps the suite importable\n * from the browser build without dragging Node into a Vite bundle.\n */\n\n/* --- the corpus (7.1) --- */\nexport {\n  CORPUS_ROOT,\n  CORPUS_VERSION,\n  DEMO_FIXTURE_IDS,\n  corpus,\n} from \"./corpus/data\";\nexport { describeCorpus, compositionOf } from \"./corpus/labels\";\nexport type {\n  Corpus,\n  CorpusComposition,\n  CorpusTier,\n  FalsifyStep,\n  LabelledAlternative,\n  LabelledDecision,\n  LabelledEpisode,\n  LabelledPremise,\n  LabelledQuestion,\n  LabelledTranscript,\n  Plant,\n  PlantKind,\n  PlantLevel,\n  ResolvedAlternative,\n  ResolvedCorpus,\n  ResolvedDecision,\n  ResolvedPremise,\n  ResolvedTranscript,\n} from \"./corpus/labels\";\nexport { describeLoad, findSpan, loadCorpus } from \"./corpus/loader\";\nexport type { LoadReport } from \"./corpus/loader\";\n\n/* --- the harness (7.2) --- */\nexport {\n  alternativesOf,\n  decisionsOf,\n  describeFailures,\n  eventsOf,\n  guardsOf,\n  labelOf,\n  premisesOf,\n  runConfig,\n} from \"./harness\";\nexport type {\n  InterventionOutcome,\n  QuestionRun,\n  RunConfig,\n  RunResult,\n  TranscriptRun,\n} from \"./harness\";\n\n/* --- the metric suite (7.2) --- */\nexport {\n  buildResolver,\n  metricById,\n  metricsWithoutComparator,\n  renderSuite,\n  scoreAll,\n  unusualMetrics,\n} from \"./metrics\";\nexport type { ScoredRun } from \"./metrics\";\nexport { COMPARATORS, METRIC_NAMES, UNUSUAL_METRICS, meanReciprocalRank, precisionAtK, precisionRecall } from \"./metrics/types\";\nexport type { EngineMetric, MetricId, MetricResult, PrecisionRecall } from \"./metrics/types\";\nexport { MATCH_RULE, align, overlapOf } from \"./metrics/match\";\nexport type { Alignment, AlignedPair, Span } from \"./metrics/match\";\n\n/* --- the ablation study (7.3) --- */\nexport {\n  DEFAULT_PARAMS,\n  EXPECTED_DAMAGE,\n  FULL,\n  NOISE_FLOOR,\n  TOGGLE_IDS,\n  ablationPlan,\n  describePlan,\n  fullPlan,\n  parameterPlan,\n} from \"./ablation/toggles\";\nexport type { Ablation, AblationConfig, SweptParams } from \"./ablation/toggles\";\nexport { describeStudy, runAblation } from \"./ablation/run\";\nexport type { AblationOutcome, AblationStudy, StudyOptions } from \"./ablation/run\";\nexport { TABLE_METRICS, buildDeltaRows, renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nexport type { DeltaRow, PredictionVerdict, VerdictKind } from \"./ablation/table\";\n\n/* --- hardening (7.4) --- */\nexport { checkDemoKillers, checkFailureModes, harden, renderHardening } from \"./hardening\";\nexport type { DemoKiller, FailureModeCheck, HardeningReport } from \"./hardening\";\n\n/* --- the report (7.7) --- */\nexport { renderFullReport } from \"./report\";\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The demo script ΓÇö 7.5.\n *  const lines: string[] = [];\n\n  lines.push(\"`DEMO SCRIPT ΓÇö \" + ${script.length + \"} beats, \"+ totalSeconds(script)s (\" +\n    (totalSeconds(script) / 60).toFixed(1) min));\n  lines.push(\"Cuttable if running long: \" + cuttableBeats(script).map((beat) => \"beat \" + beat.n).join(\", \"));\n  lines.push(\"\");  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,34]}}},{"equalLines":{"line_count":183}},{"diffOp":{"equal":{"range":[34,78]}}},{"diffOp":{"delete":{"range":[78,79]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[80,96]}}},{"diffOp":{"delete":{"range":[96,100]}}},{"diffOp":{"insert":{"range":[100,102]}}},{"diffOp":{"equal":{"range":[102,115]}}},{"diffOp":{"delete":{"range":[115,119]}}},{"diffOp":{"insert":{"range":[119,120]}}},{"diffOp":{"equal":{"range":[120,127]}}},{"diffOp":{"delete":{"range":[127,129]}}},{"diffOp":{"equal":{"range":[120,121]}}},{"diffOp":{"delete":{"range":[129,131]}}},{"diffOp":{"insert":{"range":[100,102]}}},{"diffOp":{"equal":{"range":[131,151]}}},{"diffOp":{"delete":{"range":[115,119]}}},{"diffOp":{"insert":{"range":[119,120]}}},{"diffOp":{"equal":{"range":[151,154]}}},{"diffOp":{"delete":{"range":[154,162]}}},{"diffOp":{"insert":{"range":[100,102]}}},{"diffOp":{"equal":{"range":[162,200]}}},{"diffOp":{"delete":{"range":[115,119]}}},{"diffOp":{"insert":{"range":[119,120]}}},{"diffOp":{"equal":{"range":[200,205]}}},{"diffOp":{"delete":{"range":[96,97]}}},{"diffOp":{"insert":{"range":[79,80]}}},{"diffOp":{"equal":{"range":[205,336]}}},{"equalLines":{"line_count":10}},{"diffOp":{"equal":{"range":[336,365]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\script.ts"},"span":[8918,9051],"sourceCode":"/**\n * The demo script ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * THE SCRIPT IS DATA, AND THE VERIFIER RUNS IT\n *\n * A demo script in a markdown file rots: the clicks stop matching the UI and nobody notices until the\n * rehearsal. Here the script is a typed list of beats, each with the view it happens in, the action\n * taken, what the audience should see, and the predicate that says whether it happened.\n *\n * `verify.ts` walks the same list. So the script that gets rehearsed, the script that gets checked and\n * the script that gets presented are one artefact, and a beat whose predicate fails is a beat that\n * cannot be delivered ΓÇö found before the room rather than in it.\n *\n * ---------------------------------------------------------------------------\n * FIVE MINUTES, AND THE PEAK IS GATE (c)\n *\n * The plan is explicit that the demo peak is premise invalidation, not contradiction detection. Beat 5\n * is where it lands and every earlier beat exists to make it legible: by the time the presenter says\n * \"nothing contradicted me\", the audience has already seen the decision, seen its premises, and seen a\n * transcript that never mentions databases.\n *\n * Contradiction detection is beat 3 and is deliberately underplayed. It is the thing every competitor\n * can do, and spending the demo's momentum on it would be spending it on the least defensible claim.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DemoKiller } from \"../hardening\";\n\nexport type ViewId =\n  | \"foundation\" | \"review\" | \"reasoning\" | \"ask\" | \"guards\" | \"export\"\n  | \"graph\" | \"timeline\" | \"health\" | \"time-machine\" | \"settings\";\n\nexport interface Beat {\n  readonly n: number;\n  readonly seconds: number;\n  readonly view: ViewId;\n  /** What the presenter does. One action per beat: a beat with two actions is two beats, and a script\n   *  that cannot be walked one step at a time cannot be recovered from mid-presentation. */\n  readonly action: string;\n  /** What the audience should see, in words a non-technical judge can follow. */\n  readonly expect: string;\n  /** The line to say. Written out rather than paraphrased, because the wording of the peak beat has\n   *  been chosen and improvising it loses the point. */\n  readonly say: string;\n  /** Machine-checkable. `verify.ts` evaluates it against the seeded graph. */\n  readonly check: CheckId;\n  /** Which demo-killer this beat would expose if it went wrong. Beats that expose none are marked\n   *  \"none\" and are the ones safe to cut if the demo is running long. */\n  readonly killer: DemoKiller[\"id\"] | \"none\";\n}\n\nexport type CheckId =\n  | \"seed-has-sqlite-decision\"\n  | \"seed-has-premises\"\n  | \"reversal-detected\"\n  | \"l2-unsound\"\n  | \"no-hypothetical-nodes\"\n  | \"guards-proposed-not-failing\"\n  | \"export-contains-decision\"\n  | \"answer-is-grounded\"\n  | \"graph-renders\"\n  | \"none\";\n\nexport const DEMO_SECONDS = 300;\n\nexport const SCRIPT: readonly Beat[] = [\n  {\n    n: 1,\n    seconds: 30,\n    view: \"foundation\",\n    action: \"Load the seed and show the SQLite decision with its premises expanded.\",\n    expect: \"A decision card reading 'Use SQLite, not Postgres' with two premises beneath it: single-user, and no deploy infrastructure.\",\n    say:\n      \"This is a decision an AI agent helped me make in October. Every tool that stores this stores the \" +\n      \"decision. Notice what is underneath it ΓÇö the assumptions it is true GIVEN. Nobody stores those.\",\n    check: \"seed-has-premises\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 2,\n    seconds: 30,\n    view: \"graph\",\n    action: \"Open the graph view and highlight the SQLite decision and its premise column.\",\n    expect: \"A bipartite lattice: premises in one column, decisions in another, edges from the SQLite decision to both of its premises.\",\n    say:\n      \"The graph is bipartite on purpose. Decisions on one side, assumptions on the other. The layout is \" +\n      \"deterministic ΓÇö same graph, same picture, every time ΓÇö because a diagram that moves between runs \" +\n      \"cannot be reasoned about.\",\n    check: \"graph-renders\",\n    killer: \"none\",\n  },\n  {\n    n: 3,\n    seconds: 40,\n    view: \"reasoning\",\n    action: \"Quick-log the reversal: 'actually let's switch to Postgres, we need concurrent writes'.\",\n    expect: \"A contradiction is raised between the new Postgres decision and the October SQLite decision, and the older one moves to superseded.\",\n    say:\n      \"Now I contradict myself. This is the part every tool can do ΓÇö you said SQLite, now you said \" +\n      \"Postgres, here is a red badge. It is worth about thirty seconds of your attention, because it is \" +\n      \"not why this exists.\",\n    check: \"reversal-detected\",\n    killer: \"none\",\n  },\n  {\n    n: 4,\n    seconds: 45,\n    view: \"foundation\",\n    action: \"Import the second fixture ΓÇö the November transcript ΓÇö and show that it never mentions databases.\",\n    expect: \"The transcript is imported and its decisions appear. None of them is about a database. Scroll the text to prove it: the word appears nowhere.\",\n    say:\n      \"Here is a transcript from a month later. Read it. There is no database decision in it. There is no \" +\n      \"argument about storage. The word Postgres does not appear. What it says is that there are now four \" +\n      \"people on the project and two of them edit decisions at the same time.\",\n    check: \"seed-has-sqlite-decision\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 5,\n    seconds: 60,\n    view: \"reasoning\",\n    action: \"Show the SQLite decision's label change to unsound, with the reason naming the falsified premise.\",\n    expect: \"The October SQLite decision is marked OUT, and the reason names the concurrent-writers exclusion ΓÇö a premise that was in the OUT-list of its justification.\",\n    say:\n      \"Nothing contradicted me. I never said the word database. The world moved, and the log noticed ΓÇö \" +\n      \"because the decision was stored with the assumption it rests on, and the assumption stopped \" +\n      \"holding. This is the whole product. Contradiction detection fires when you contradict yourself. \" +\n      \"This fires when reality does.\",\n    check: \"l2-unsound\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 6,\n    seconds: 35,\n    view: \"graph\",\n    action: \"Replay the cascade and show that decisions sharing no premise with the falsified one keep their labels.\",\n    expect: \"The cascade animation flips the SQLite decision and leaves unrelated decisions untouched. The survivors are visibly still IN.\",\n    say:\n      \"A cascade that retracts everything reachable is worse than no cascade. Watch what does NOT change: \" +\n      \"these decisions rest on other assumptions, so they keep their labels. Over-retraction is the \" +\n      \"failure mode that ends a tool like this, and it is the one we measure hardest.\",\n    check: \"no-hypothetical-nodes\",\n    killer: \"cascade-over-retraction\",\n  },\n  {\n    n: 7,\n    seconds: 30,\n    view: \"guards\",\n    action: \"Show the guards proposed for the Postgres decision, and the verify command compiled from them.\",\n    expect: \"A list of PROPOSED guards ΓÇö not installed ΓÇö with a copyable verify command.\",\n    say:\n      \"Every decision gets a check generated from it. Proposed, never auto-installed ΓÇö the system proposes \" +\n      \"and you dispose. Nobody in the fitness-function literature generates the check from the decision; \" +\n      \"it is always written by hand, which is why it is always stale.\",\n    check: \"guards-proposed-not-failing\",\n    killer: \"day-one-guard-failures\",\n  },\n  {\n    n: 8,\n    seconds: 30,\n    view: \"export\",\n    action: \"Export to CLAUDE.md and show the rejected-alternatives block and the consistency stamp.\",\n    expect: \"A CLAUDE.md with imperative MUST/MUST NOT rules scoped to globs, a rejected block, and a stamp whose digest covers the body.\",\n    say:\n      \"And it exports to what your agent actually reads ΓÇö CLAUDE.md, AGENTS.md, .cursorrules ΓÇö with the \" +\n      \"rejected alternatives in there too, so the agent does not re-propose Postgres in three weeks. \" +\n      \"Stamped, so you can tell whether the file matches the graph.\",\n    check: \"export-contains-decision\",\n    killer: \"none\",\n  },\n];\n\nexport function totalSeconds(script: readonly Beat[] = SCRIPT): number {\n  return script.reduce((sum, beat) => sum + beat.seconds, 0);\n}\n\n/** Beats safe to cut if the demo is running long, in cut order. None of them exposes a demo-killer,\n *  which is the criterion: a beat that could reveal a killer is not cuttable on stage. */\nexport function cuttableBeats(script: readonly Beat[] = SCRIPT): readonly Beat[] {\n  return script.filter((beat) => beat.killer === \"none\");\n}\n\nexport function renderScript(script: readonly Beat[] = SCRIPT): string {\n  const lines: string[] = [];\n\n  lines.push(\"DEMO SCRIPT ΓÇö \" + script.length + \" beats, \" + totalSeconds(script) + \"s (\" +\n    (totalSeconds(script) / 60).toFixed(1) + \" min)\");\n  lines.push(\"Cuttable if running long: \" + cuttableBeats(script).map((beat) => \"beat \" + beat.n).join(\", \"));\n  lines.push(\"\");\n\n  for (const beat of script) {\n    lines.push(\"BEAT \" + beat.n + \" ┬╖ \" + beat.seconds + \"s ┬╖ \" + beat.view + \" ┬╖ check: \" + beat.check +\n      (beat.killer === \"none\" ? \"\" : \" ┬╖ exposes: \" + beat.killer));\n    lines.push(\"  DO:     \" + beat.action);\n    lines.push(\"  SEE:    \" + beat.expect);\n    lines.push(\"  SAY:    \" + beat.say);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices