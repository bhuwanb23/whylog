ort { fullPlan, type Ablation } from \"./toggles\";\n\nexport interface AblationOutcome {\n  readonly ablation: Ablation;\n  readonly scored: ScoredRun | null;\n  readonly run: RunResult | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface AblationStudy {\n  readonly engine: EngineId;\n  readonly corpusVersion: string;\n  readonly ranAt: string;\n  readonly outcomes: readonly AblationOutcome[];\n  readonly baseline: AblationOutcome | null;\n  /** Configurations that threw. Printed in the table rather than silently absent. */\n  readonly failed: readonly { id: string; error: string }[];\n  readonly totalDurationMs: number;\n}\n\nexport interface StudyOptions {\n  readonly engine?: WhyLogEngine;\n  readonly engineId?: EngineId;\n  readonly plan?: readonly Ablation[];\n}\n\n/**\n * Run the whole study.\n *\n * Sequential, not concurrent. The harness mints ids from a counter and stamps learned time from a clock\n * that advances on every call; running configurations concurrently would interleave those and the deltas\n * would stop being attributable to the toggles. Slower and correct beats faster and uninterpretable.\n */\nexport async function runAblation(corpus: ResolvedCorpus, options: StudyOptions = {}): Promise<AblationStudy> {\n  const engine = options.engine ?? createLocalEngine();\n  const engineId = options.engineId ?? localEngineId();\n  const plan = options.plan ?? fullPlan();\n  const ranAt = nowISO();\n\n  const outcomes: AblationOutcome[] = [];\n  const started = Date.now();\n\n  for (const ablation of plan) {\n    const rowStart = Date.now();\n    try {\n      const run = await runConfig(corpus, {\n        id: ablation.id,\n        engine,\n        engineId,\n        toggles: ablation.toggles,\n        params: ablation.params,\n      });\n      outcomes.push({ ablation, scored: scoreAll(corpus, run, engineId), run, error: null, durationMs: Date.now() - rowStart });\n    } catch (error) {\n      outcomes.push({\n        ablation,\n        scored: null,\n        run: null,\n        error: error instanceof Error ? error.message + \"\\n\" + (error.stack ?? \"\") : String(error),\n        durationMs: Date.now() - rowStart,\n      });\n    }\n  }\n\n  const failed = outcomes\n    .filter((outcome) => outcome.error !== null)\n    .map((outcome) => ({ id: outcome.ablation.id, error: outcome.error ?? \"unknown\" }));\n\n  return {\n    engine: engineId,\n    corpusVersion: corpus.version,\n    ranAt,\n    outcomes,\n    baseline: outcomes.find((outcome) => outcome.ablation.id === \"full\") ?? null,\n    failed,\n    totalDurationMs: Date.now() - started,\n  };\n}\n\n/** The study as a short human-readable summary. Printed before the table so a run that produced no\n *  usable rows says so in the first line rather than in an empty grid. */\nexport function describeStudy(study: AblationStudy): string {\n  const usable = study.outcomes.filter((outcome) => outcome.scored !== null).length;\n  const lines = [\n    \"Ablation study: \" + study.outcomes.length + \" configuration(s), \" + usable + \" produced scores.\",\n    \"Engine: \" + study.engine.kind + (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") +\n      \"  ┬╖  corpus \" + study.corpusVersion + \"  ┬╖  ran \" + study.ranAt,\n    \"Total wall time: \" + (study.totalDurationMs / 1000).toFixed(1) + \"s\",\n  ];\n\n  if (study.baseline === null || study.baseline.scored === null) {\n    lines.push(\"\");\n    lines.push(\"THE BASELINE DID NOT PRODUCE SCORES. No delta in this study is meaningful, because every\");\n    lines.push(\"delta is measured against it. Fix the baseline before reading any row below.\");\n  }\n\n  if (study.failed.length > 0) {\n    lines.push(\"\");\n    lines.push(study.failed.length + \" configuration(s) threw and are EXCLUDED from the delta table:\");\n    for (const entry of study.failed) lines.push(\"  \" + entry.id + \" ┬╖ \" + entry.error.split(\"\\n\")[0]);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation study runner ΓÇö 7.3.\n *  const usable = study.outcomes.filter((outcome) => outcome.scored !== null).length;\n  const lines = [\n    \"Ablation study: \" + study.outcomes.length + \" configuration(s), \" + usable + \" produced scores.\",\n    \"`Engine: \" +${study.engine.kind + (}${study.engine.model.length > 0 ? \"/\" + study.engine.model : ) +\n        ┬╖  corpus+ study.corpusVersion + \"  ┬╖  ran \" + study.ranAt}`,\n    \"Total wall time: \" + (study.totalDurationMs / 1000).toFixed(1) + \"s\",\n  ];  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,44]}}},{"equalLines":{"line_count":113}},{"diffOp":{"equal":{"range":[44,249]}}},{"diffOp":{"equal":{"range":[249,254]}}},{"diffOp":{"delete":{"range":[254,255]}}},{"diffOp":{"insert":{"range":[255,256]}}},{"diffOp":{"equal":{"range":[256,263]}}},{"diffOp":{"delete":{"range":[263,267]}}},{"diffOp":{"equal":{"range":[44,45]}}},{"diffOp":{"insert":{"range":[267,269]}}},{"diffOp":{"equal":{"range":[269,286]}}},{"diffOp":{"delete":{"range":[286,290]}}},{"diffOp":{"insert":{"range":[290,293]}}},{"diffOp":{"equal":{"range":[293,352]}}},{"diffOp":{"delete":{"range":[254,255]}}},{"diffOp":{"equal":{"range":[254,255]}}},{"diffOp":{"delete":{"range":[352,362]}}},{"diffOp":{"equal":{"range":[254,255]}}},{"diffOp":{"insert":{"range":[290,291]}}},{"diffOp":{"equal":{"range":[362,374]}}},{"diffOp":{"delete":{"range":[263,265]}}},{"diffOp":