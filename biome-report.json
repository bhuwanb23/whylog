2\n   * premise invalidation, both of which live entirely in these two files. */\n  const demoOnly = {\n    ...loaded.corpus,\n    transcripts: loaded.corpus.transcripts.filter((transcript) =>\n      transcript.id === \"demo1\" || transcript.id === \"demo2\",\n    ),\n    questions: loaded.corpus.questions.filter((question) => question.id === \"q1\" || question.id === \"q8\"),\n    plants: loaded.corpus.plants.filter((plant) =>\n      plant.id === \"L1-sqlite\" || plant.id === \"L2-premise-falsified\",\n    ),\n  };\n\n  const run = await runConfig(demoOnly, {\n    id: \"demo-seed\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  for (const entry of run.transcripts) {\n    if (!entry.ok) warnings.push(\"fixture \" + entry.transcript.id + \" failed to import: \" + (entry.failure ?? \"unknown\"));\n  }\n\n  return {\n    log: rebuildLog(run),\n    state: run.state,\n    engineId,\n    builtAt: nowISO(),\n    decisions: run.state.decisions.size,\n    premises: run.state.premises.size,\n    durationMs: Date.now() - started,\n    warnings,\n  };\n}\n\n/**\n * The event log behind a completed run.\n *\n * The harness keeps its log local and returns only the folded state, because metrics score states. The\n * demo needs the log too, since the app persists and replays events rather than snapshots ΓÇö so it is\n * reconstructed by re-folding the state's own event list, which is authoritative and hash-chained.\n */\nfunction rebuildLog(run: { state: GraphState }): EventLog {\n  const log = emptyLog();\n  const appended = appendBatch(\n    log,\n    run.state.events.map((event) => ({\n      draft: { type: event.type, payload: event.payload, actor: event.actor, reason: event.reason },\n      context: { now: event.at, actor: event.actor, reason: event.reason, occurredAt: event.occurredAt },\n    })),\n  );\n\n  /* Re-appending sealed events re-mints ids and re-stamps times, so the chain will not match the\n   * original. That is acceptable for a seed ΓÇö the app reseals on import via `substrate/portability.ts`,\n   * which is the supported path for bringing an external log in ΓÇö but it is not acceptable to pretend\n   * otherwise, so the reconstruction folds rather than claiming to restore. */\n  return appended.ok ? appended.log : fold(run.state.events, { engine: run.state.computedAt ? localEngineId() : localEngineId(), now: nowISO() }) && emptyLog();\n}\n\n/**\n * One-click reset.\n *\n * Clears every WhyLog key and reports what it cleared. Idempotent: resetting twice is the same as\n * resetting once, which matters because a presenter who is unsure whether the reset landed will press it\n * again, and a reset that compounds would be worse than none.\n */\nexport function resetDemo(storage: Storage | null): { cleared: readonly string[]; available: boolean } {\n  if (storage === null) return { cleared: [], available: false };\n\n  const cleared: string[] = [];\n  for (const key of RESET_KEYS) {\n    if (storage.getItem(key) !== null) {\n      storage.removeItem(key);\n      cleared.push(key);\n    }\n  }\n\n  return { cleared, available: true };\n}\n\n/** What the reset did, as a sentence a presenter can read aloud if asked. */\nexport function describeReset(result: { cleared: readonly string[]; available: boolean }): string {\n  if (!result.available) {\n    return \"No storage backend available ΓÇö the demo is running in memory and a page reload is the reset.\";\n  }\n  if (result.cleared.length === 0) {\n    return \"Nothing to clear: storage was already empty. Reset is idempotent, so this is a clean start.\";\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices