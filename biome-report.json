rc\\eval\\metrics\\alternative.ts"},"span":null,"sourceCode":"/**\n * Metric 3 ΓÇö alternative extraction precision.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: ARGUS, 15.4% precision, alpha 0.64, FP:FN 13:1 (arXiv:2604.10345, docs/05 ┬º4.3).\n *\n * ---------------------------------------------------------------------------\n * PRECISION IS THE HEADLINE BECAUSE ARGUS SAYSO\n *\n * ARGUS found alternatives to be the worst-measured rationale component in the literature: 15.4%\n * precision with a false-positive-to-false-negative ratio of 13:1. The system produces fifteen wrong\n * alternatives for every one it misses. That ratio matters more than the absolute number, because it\n * says the failure is not caution but noise ΓÇö and noise is what makes a user stop reading the panel.\n *\n * So this metric reports precision first and the FP:FN ratio beside it, rather than leading with F1.\n * F1 would blend a catastrophic precision with a good recall into a number that looks acceptable, and\n * the whole reason ARGUS's result is memorable is that the blend hides the problem.\n *\n * ---------------------------------------------------------------------------\n * AN ALTERNATIVE WITHOUT `whyRejected` IS NOT A FALSE POSITIVE\n *\n * The corpus distinguishes alternatives that were rejected for a stated reason from ones merely\n * mentioned. The system stores both but only pre-empts on the former, and only the latter kind is a\n * plausible false positive: mentioning Redis is not an error, claiming Redis was rejected when nobody\n * rejected it is. Precision is therefore computed over ALL extracted alternatives, and a second number\n * ΓÇö pre-emption eligibility precision ΓÇö is computed over the ones the system would actually act on.\n * Reporting only the first would understate the risk; reporting only the second would overstate the\n * system's restraint.\n * ---------------------------------------------------------------------------\n */\n\nimport type { AlternativeId, EngineId, TranscriptId } from \"@/types/common\";\nimport type { RejectedAlternative } from \"@/types/domain\";\nimport type { ResolvedAlternative, ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface AlternativeOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedAlternative, RejectedAlternative>;\n  readonly fpToFnRatio: string;\n  /** Precision over the alternatives the system would actually pre-empt on. */\n  readonly preemptionPrecision: number;\n  readonly preemptionEligible: number;\n}\n\nexport function scoreAlternativeExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): AlternativeOutcome {\n  const labels: ResolvedAlternative[] = [];\n  for (const transcript of corpus.transcripts) {\n    for (const alternative of transcript.alternatives) {\n      /* `expectConfirmed` is the alternative-level form of \"should this become a node\": true when the\n       * transcript actually REJECTS the alternative, false when it merely mentions it. Alternatives\n       * need explicit confirmation before they may pre-empt anything, so a mention is not a miss. */\n      if (!alternative.expectConfirmed) continue;\n      labels.push(alternative);\n    }\n  }\n\n  const nodes: RejectedAlternative[] = [...run.state.alternatives.values()];\n\n  /* An alternative carries no transcript of its own ΓÇö it belongs to the decision it was rejected in\n   * favour of ΓÇö so eligibility goes through that decision's provenance. This is the same transcript\n   * test the decision metric applies, and without it a label from c01 could match a node extracted\n   * from m02 merely because their character spans overlap in two differently-numbered documents.\n   * That match would be scored as a true positive that never happened. */\n  const ownerOf = new Map<AlternativeId, TranscriptId>();\n  for (const alternative of nodes) {\n    const decision = run.state.decisions.get(alternative.decisionId);\n    if (decision !== undefined) ownerOf.set(alternative.id, decision.provenance.transcriptId);\n  }\n\n  const alignment = align(\n    labels,\n    nodes,\n    (label) => label.span,\n    (node) => ({ start: node.snippet.start, end: node.snippet.end }),\n    (label, node) => {\n      const owner = ownerOf.get(node.id);\n      if (owner === undefined) return false;\n      const entry = run.transcripts.find((candidate) => candidate.runtimeId === owner);\n      /* `label.transcript` is carried on the label precisely so this needs no search. */\n      return entry !== undefined && entry.transcript.id === label.transcript;\n    },\n  );\n\n  const detail = precisionRecall(alignment.truePositives, alignment.falsePositives, alignment.falseNegatives);\n\n  /* ARGUS's ratio, restated. Reported as a string because 13:1 is how the literature writes it and a\n   * decimal would invite a comparison with a different quantity. */\n  const fpToFnRatio =\n    detail.falseNegatives === 0\n      ? detail.falsePositives + \":0 (no misses to compare against)\"\n      : detail.falsePositives + \":\" + detail.falseNegatives +\n        \" (\" + (detail.falsePositives / detail.falseNegatives).toFixed(1) + \" FP per FN)\";\n\n  /* Pre-emption eligibility: an alternative only enters the pre-emption index with an explicit\n   * whyRejected AND human confirmation. Counting precision over just those answers the question a user\n   * actually has ΓÇö \"when the system warns me I am re-proposing something rejected, is it right?\" */\n  const eligible = nodes.filter((node) => node.whyRejected !== undefined);\n  const eligibleLabels = labels.filter((label) => label.whyRejected !== undefined);\n  const eligibleHits = alignment.pairs.filter((pair) => pair.node.whyRejected !== undefined).length;\n  const preemptionPrecision = eligible.length === 0 ? 0 : eligibleHits / eligible.length;\n\n  return {\n    alignment,\n    fpToFnRatio,\n    preemptionPrecision,\n    preemptionEligible: eligible.length,\n    metric: {\n      id: \"alternative-precision\",\n      name: METRIC_NAMES[\"alternative-precision\"],\n      value: detail.precision,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.precision, n: labels.length, detail }],\n      comparator: COMPARATORS[\"alternative-precision\"] ?? null,\n      gloss:\n        detail.precision.toFixed(3) + \" precision against ARGUS's 0.154; FP:FN \" + fpToFnRatio +\n        \" against ARGUS's 13:1. \" + eligible.length + \" alternative(s) carry a stated rejection reason and \" +\n        (preemptionPrecision * 100).toFixed(0) + \"% of those are correct ΓÇö the subset the system would act on.\",\n      honestNote:\n        \"Precision is the headline because ARGUS's finding is a PRECISION finding; F1 would blend a bad precision with a \" +\n        \"good recall into a number that looks acceptable. Matched by \" + MATCH_RULE + \", requiring the variable to agree. \" +\n        \"n=\" + labels.length + \" labelled alternatives, of which \" + eligibleLabels.length + \" state a rejection reason. \" +\n        \"The corpus is small enough that a single spurious alternative moves precision by several points, so the count is \" +\n        \"reported beside the ratio and neither should be quoted without it.\",\n    },\n  };\n}\n\nexport type { AlternativeId };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\cascade.ts"},"span":[3920,3923],"sourceCode":"/**\n * Metric 6 ΓÇö cascade correctness at L3 (propagation), and metric 7, survivor preservation.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: NONE PUBLISHED for either. No surveyed system cascades a retraction at all.\n *\n * ---------------------------------------------------------------------------\n * ONE METRIC, TWO HALVES, AND THE SECOND HALF IS THE ONE THAT MATTERS\n *\n * Cascade correctness is not \"did the right nodes flip\". It is \"did the right nodes flip AND the wrong\n * ones stay put\". A cascade that retracts everything reachable is perfectly correct on the first half\n * and catastrophic in use: the user falsifies one assumption about team size and eleven unrelated\n * decisions vanish from the graph. They will never trust it again, and they will be right not to.\n *\n * So the score is a strict conjunction per plant ΓÇö flips AND survivors ΓÇö and survivor preservation is\n * additionally reported on its own, because it is the number that predicts whether the product\n * survives contact with a real project. ┬º7.2 calls it one of the two unusual metrics; ┬º7.4 names\n * cascade over-retraction as the first of four demo-killers. Both point here.\n *\n * ---------------------------------------------------------------------------\n * THE PLANTED CASE IS BUILT TO DISTINGUISH THE TWO\n *\n * `l03` puts three decisions on deliberately different support:\n *   d1 pooling           rests on single-user ALONE\n *   d2 migration tooling rests on scope ALONE\n *   d3 read replicas     rests on single-user AND no-deploy-infra\n *\n * Falsifying single-user must flip d1, spare d2 entirely, and leave d3 to its remaining support. Three\n * different correct behaviours from one intervention, and each one distinguishes a different wrong\n * implementation: a cascade that flips d2 is following edges rather than justifications; one that flips\n * d3 is treating support as all-or-nothing.\n *\n * ---------------------------------------------------------------------------\n * AN UNRESOLVABLE SURVIVOR IS A FAILURE, NOT A SKIP\n *\n * If the decision that was supposed to survive was never extracted, the survivor cannot be verified and\n * the plant is scored as failed. Skipping it would report a cascade correctness computed only over the\n * plants that happened to extract cleanly ΓÇö a number that improves as extraction gets worse, which is\n * the exact inverse of what a benchmark should do.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { plantIsTestable, type Resolver } from \"./resolve\";\nimport { METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface PlantOutcome {\n  readonly plant: string;\n  readonly testable: boolean;\n  readonly interventionApplied: boolean;\n  readonly expectedFlips: readonly string[];\n  readonly flipped: readonly string[];\n  readonly missedFlips: readonly string[];\n  readonly expectedSurvivors: readonly string[];\n  readonly survived: readonly string[];\n  /** Survivors that were retracted. Each one is an over-retraction ΓÇö the demo-killer. */\n  readonly overRetracted: readonly string[];\n  readonly unresolvable: readonly string[];\n  readonly correct: boolean;\n}\n\nexport interface CascadeOutcome {\n  readonly correctness: MetricResult;\n  readonly survivorship: MetricResult;\n  readonly perPlant: readonly PlantOutcome[];\n  readonly overRetractions: number;\n  readonly survivorsExpected: number;\n}\n\nconst UNSOUND = new Set([\"OUT\", \"UNFOUNDED\"]);\n\nexport function scoreCascade(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): CascadeOutcome {\n  const plants = corpus.plants.filter((plant) => plant.kind === \"L3-cascade\" || plant.kind === \"L2-premise\");\n\n  const perPlant: PlantOutcome[] = plants.map((plant) => {\n    const testable = plantIsTestable(run, plant.transcripts);\n\n    /* An L3 plant is only testable if its intervention actually landed. An L2 plant has no\n     * intervention ΓÇö the falsification must come out of the transcript ΓÇö so it is testable whenever its\n     * transcripts imported. */\n    const interventionApplied =\n      plant.falsify === undefined ||\n      plant.falsify.every((step) =>\n        run.interventions.some((outcome) => outcome.plant === plant.id && outcome.predicate === step.predicate && outcome.applied),\n      );\n\n    const flipped: string[] = [];\n    const missedFlips: string[] = [];\n    const survived: string[] = [];\n    const overRetracted: string[] = [];\n    const unresolvable: string[] = [];\n\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        unresolvable.push(key);\n        continue;\n      }\n      if (isUnsound(run, id)) flipped.push(key);\n      else missedFlips.push(key);\n    }\n\n    for (const key of plant.expectSurvivors) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        /* A survivor that was never extracted cannot be shown to have survived. Counted as unresolved\n         * and the plant fails, per the header: skipping it would reward poor extraction. */\n        unresolvable.push(key);\n        continue;\n      }\n      if (isUnsound(run, id)) overRetracted.push(key);\n      else survived.push(key);\n    }\n\n    const correct =\n      testable &&\n      interventionApplied &&\n      missedFlips.length === 0 &&\n      overRetracted.length === 0 &&\n      unresolvable.length === 0 &&\n      plant.expectUnsound.length + plant.expectSurvivors.length > 0;\n\n    return {\n      plant: plant.id,\n      testable,\n      interventionApplied,\n      expectedFlips: plant.expectUnsound,\n      flipped,\n      missedFlips,\n      expectedSurvivors: plant.expectSurvivors,\n      survived,\n      overRetracted,\n      unresolvable,\n      correct,\n    };\n  });\n\n  const survivorsExpected = perPlant.reduce((sum, entry) => sum + entry.expectedSurvivors.length, 0);\n  const survivorsKept = perPlant.reduce((sum, entry) => sum + entry.survived.length, 0);\n  const overRetractions = perPlant.reduce((sum, entry) => sum + entry.overRetracted.length, 0);\n\n  const correctPlants = perPlant.filter((entry) => entry.correct).length;\n  const correctnessValue = perPlant.length === 0 ? 0 : correctPlants / perPlant.length;\n\n  /* Survivor preservation is 1.0 when no survivors are expected, which is vacuous rather than perfect.\n   * The report must not print it as an achievement, so the gloss says so explicitly. */\n  const survivorValue = survivorsExpected === 0 ? 1 : survivorsKept / survivorsExpected;\n\n  return {\n    perPlant,\n    overRetractions,\n    survivorsExpected,\n    correctness: {\n      id: \"cascade-correctness-l3\",\n      name: METRIC_NAMES[\"cascade-correctness-l3\"],\n      value: correctnessValue,\n      detail: null,\n      n: perPlant.length,\n      perEngine: [{ engine: describeEngineId(engine), value: correctnessValue, n: perPlant.length, detail: null }],\n      comparator: null,\n      gloss:\n        correctPlants + \" of \" + perPlant.length + \" plant(s) were FULLY correct ΓÇö every expected flip happened and no \" +\n        \"survivor was retracted. \" + overRetractions + \" over-retraction(s) across \" + survivorsExpected + \" expected survivor(s).\",\n      honestNote:\n        \"Scored as a strict conjunction per plant: a cascade that flips the right nodes AND retracts a survivor scores 0, \" +\n        \"not partial credit, because over-retraction is the failure that destroys trust and partial credit would hide it. \" +\n        \"n=\" + perPlant.length + \" plants ΓÇö small enough that this metric is a PASS/FAIL over named cases rather than a \" +\n        \"statistical rate, and it should be quoted as such. A plant whose intervention could not be applied, or whose \" +\n        \"survivor was never extracted, is scored as FAILED rather than skipped: skipping would make the number improve as \" +\n        \"extraction worsens. No published comparator exists, because no surveyed system propagates a retraction at all.\",\n    },\n    survivorship: {\n      id: \"survivor-preservation\",\n      name: METRIC_NAMES[\"survivor-preservation\"],\n      value: survivorValue,\n      detail: null,\n      n: survivorsExpected,\n      perEngine: [{ engine: describeEngineId(engine), value: survivorValue, n: survivorsExpected, detail: null }],\n      comparator: null,\n      gloss:\n        survivorsExpected === 0\n          ? \"VACUOUS: the corpus expected no survivors in the plants that ran, so 1.0 here means nothing was tested.\"\n          : survivorsKept + \" of \" + survivorsExpected + \" decision(s) that shared no falsified premise kept their label. \" +\n            overRetractions + \" were retracted anyway.\",\n      honestNote:\n        \"One of the two metrics ┬º7.2 calls unusual, and the one that predicts whether the product survives a real project. \" +\n        \"1.0 is VACUOUS when n=0 and the gloss says so rather than printing a perfect score for an untested property ΓÇö a \" +\n        \"benchmark that reports 100% because it measured nothing is worse than one that reports 40%. n=\" + survivorsExpected +\n        \" survivors, all from the single l03 plant, so this is a check that a specific mechanism does not over-fire, not an \" +\n        \"estimate of an over-retraction RATE. Nobody publishes a comparator because nobody cascades.\",\n    },\n  };\n}\n\nfunction isUnsound(run: RunResult, id: DecisionId): boolean {\n  const labelled = run.labels.get(id);\n  if (labelled !== undefined) return UNSOUND.has(labelled.label);\n\n  const decision = run.state.decisions.get(id);\n  return decision !== undefined && (decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 6 ΓÇö cascade correctness at L3 (propagation), and metric 7, survivor preservation.\n *      perEngine: [{ engine: describeEngineId(engine), value: correctnessValue, n: perPlant.length, detail: null }],\n      comparator: null,\n      gloss:\n        `${correctPlants + \"} of \" + ${perPlant.length plant(s) were FULLY correct ΓÇö every expected flip happened and no \" +\n        \"survivor was retracted. overRetractionsover-retraction(s) across survivorsExpected+ \" expected survivor(s).,\n      honestNote:\n        \"Scored as a strict conjunction per plant: a cascade that flips the right nodes AND retracts a survivor scores 0, \" +  return decision !== undefined && (decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,100]}}},{"equalLines":{"line_count":162}},{"diffOp":{"equal":{"range":[100,252]}}},{"diffOp":{"equal":{"range":[252,261]}}},{"diffOp":{"insert":{"range":[261,264]}}},{"diffOp":{"equal":{"range":[264,277]}}},{"diffOp":{"delete":{"range":[277,281]}}},{"diffOp":{"insert":{"range":[281,282]}}},{"diffOp":{"equal":{"range":[282,286]}}},{"diffOp":{"delete":{"range":[286,290]}}},{"diffOp":{"insert":{"range":[290,292]}}},{"diffOp":{"equal":{"range":[292,307]}}},{"diffOp":{"delete":{"range":[277,281]}}},{"diffOp":{"insert":{"range":[281,282]}}},{"diffOp":{"equ