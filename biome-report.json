om \"../harness\";\nimport type { Alignment } from \"./match\";\n\nexport interface Resolver {\n  decision(key: string): DecisionId | null;\n  premise(key: string): PremiseId | null;\n  alternative(key: string): AlternativeId | null;\n  /** Keys the corpus asked about that have no runtime node. Reported, never swallowed. */\n  readonly unresolvable: readonly string[];\n}\n\nexport interface Alignments<TDecision, TPremise, TAlternative> {\n  readonly decisions: Alignment<any, TDecision>;\n  readonly premises: Alignment<any, TPremise>;\n  readonly alternatives: Alignment<any, TAlternative>;\n}\n\nexport function buildResolver(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  decisions: Alignment<{ transcript: string; key: string }, { id: DecisionId }>,\n  premises: Alignment<{ transcript: string; key: string }, { id: PremiseId }>,\n  alternatives: Alignment<{ transcript: string; key: string }, { id: AlternativeId }>,\n): Resolver {\n  const decisionMap = new Map<string, DecisionId>();\n  const premiseMap = new Map<string, PremiseId>();\n  const alternativeMap = new Map<string, AlternativeId>();\n  const unresolvable: string[] = [];\n\n  for (const pair of decisions.pairs) decisionMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n  for (const pair of premises.pairs) premiseMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n  for (const pair of alternatives.pairs) alternativeMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n\n  /* Every key the plants reference is checked up front, so a missing node is reported once, here,\n   * rather than surfacing as a mysterious zero in whichever metric happened to ask. */\n  for (const plant of corpus.plants) {\n    for (const key of [...plant.expectUnsound, ...plant.expectSurvivors]) {\n      if (!decisionMap.has(key) && !premiseMap.has(key)) unresolvable.push(plant.id + \" -> \" + key);\n    }\n  }\n\n  return {\n    decision: (key) => decisionMap.get(key) ?? null,\n    premise: (key) => premiseMap.get(key) ?? null,\n    alternative: (key) => alternativeMap.get(key) ?? null,\n    unresolvable,\n  };\n}\n\n/** Runtime id of the transcript with this corpus key, or null if it failed to import. */\nexport function runtimeTranscriptId(run: RunResult, corpusKey: string): string | null {\n  const entry = run.transcripts.find((candidate) => candidate.transcript.id === corpusKey);\n  return entry === undefined ? null : entry.runtimeId;\n}\n\n/** Whether a plant's transcripts all imported. A plant spanning a failed transcript is untested. */\nexport function plantIsTestable(run: RunResult, transcripts: readonly string[]): boolean {\n  return transcripts.every((key) => runtimeTranscriptId(run, key) !== null);\n}\n\nexport type { ResolvedCorpus };\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The metric suite ΓÇö 7.2. Scores one run against the corpus.\n * *  no competitor can produce at any quality, because no competitor has the components they measure. */\nexport function unusualMetrics(scored: ScoredRun): readonly MetricResult[] {\n  return scored.metrics.filter((metric) =>\n    (UNUSUAL_METRICS as readonly string[]).includes(metric.id),\n  );\n}\n\n  for (const metric of scored.metrics) {\n    const comparator =\n      metric.comparator === null ? \"NONE PUBLISHED\" : metric.comparator.source;\n    const value =metric.id === \"false-positive-rate\"\n              ? metric.value.toFixed(1) + \"/100\"\n: metric.value.toFixed(3);\n\n    lines.push(metric.name.padEnd(46) + value.padStart(9) + String(metric.n).padStart(7) + \"  \" + comparator,\n    );\n  }\n  lines.push(\"Lower is better for: false-positive rate. Higher is better for everything else.\");\n  lines.push(\n    metricsWithoutComparator(scored).length +\" of \" +scored.metrics.length +\n\" metrics have NO published comparator ΓÇö that is the new-territory claim, stated as a count.\",\n  );\n  type PrecisionRecall,\n} from \"./types\";\n","ops":[{"diffOp":{"equal":{"range":[0,70]}}},{"equalLines":{"line_count":130}},{"diffOp":{"equal":{"range":[70,293]}}},{"diffOp":{"delete":{"range":[70,71]}}},{"diffOp":{"insert":{"range":[293,298]}}},{"diffOp":{"equal":{"range":[298,356]}}},{"diffOp":{"insert":{"range":[356,360]}}},{"diffOp":{"equal":{"range":[360,365]}}},{"equalLines":{"line_count":17}},{"diffOp":{"equal":{"range":[365,429]}}},{"diffOp":{"delete":{"range":[429,436]}}},{"diffOp":{"insert":{"range":[70,71]}}},{"diffOp":{"equal":{"range":[436,527]}}},{"diffOp":{"delete":{"range":[70,71]}}},{"diffOp":{"insert":{"range":[429,436]}}},{"diffOp":{"equal":{"range":[527,563]}}},{"diffOp":{"delete":{"range":[563,569]}}},{"diffOp":{"insert":{"range":[569,577]}}},{"diffOp":{"equal":{"range":[577,612]}}},{"diffOp":{"delete":{"range":[563,569]}}},{"diffOp":{"insert":{"range":[569,577]}}},{"diffOp":{"equal":{"range":[612,655]}}},{"diffOp":{"insert":{"range":[429,436]}}},{"diffOp":{"equal":{"range":[655,748]}}},{"diffOp":{"insert":{"range":[748,754]}}},{"diffOp":{"equal":{"range":[754,761]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[761,917]}}},{"diffOp":{"delete":{"range":[569,570]}}},{"diffOp":{"insert":{"range":[429,436]}}},{"diffOp":{"equal":{"range":[917,925]}}},{"diffOp":{"delete":{"range":[569,570]}}},{"diffOp":{"insert":{"range":[429,436]}}},{"diffOp":{"equal":{"range":[925,949]}}},{"diffOp":{"delete":{"range":[569,573]}}},{"diffOp":{"insert":{"range":[569,575]}}},{"diffOp":{"equal":{"range":[949,1051]}}},{"equalLines":{"line_count":15}},{"diffOp":{"equal":{"range":[1051,1093]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\index.ts"},"span":null,"sourceCode":"/**\n * The metric suite ΓÇö 7.2. Scores one run against the corpus.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * ORDER OF SCORING IS NOT ARBITRARY\n *\n * The three extraction metrics run FIRST, because their alignments are what build the resolver that\n * maps corpus keys to runtime ids. Every reasoning metric depends on that resolver: a cascade cannot be\n * checked against `l03/d1` without knowing which node `l03/d1` became.\n *\n * This creates a real dependency and it is worth stating plainly, because it means extraction failure\n * propagates into the reasoning scores. If premise extraction misses the premise a cascade should have\n * travelled through, cascade correctness falls ΓÇö and the fall is a premise-extraction failure wearing a\n * cascade metric's name. Every reasoning metric's honest note points at the extraction metric to check\n * first. A benchmark whose rows are independent would be easier to read and would be lying.\n *\n * ---------------------------------------------------------------------------\n * THIRTEEN METRICS, ONE SHAPE\n *\n * Ten from ┬º7.2's list, plus survivor preservation and modality precision which ┬º7.2 calls out as the\n * two unusual ones, plus retrieval MRR which precision@5 alone cannot substitute for. Every one returns\n * a `MetricResult` carrying n, a comparator (null where none is published, which is itself the finding)\n * and an honest note stating what the number does not establish.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { scoreAlternativeExtraction, type AlternativeOutcome } from \"./alternative\";\nimport { scoreCascade, type CascadeOutcome } from \"./cascade\";\nimport { scoreContradictionRecall, type ContradictionOutcome } from \"./contradiction\";\nimport { scoreDecisionExtraction, type ExtractionOutcome } from \"./extraction\";\nimport { scoreFalsePositives, type FalsePositiveOutcome } from \"./false-positive\";\nimport { scoreGroundedness, type GroundednessOutcome } from \"./groundedness\";\nimport { scoreGuards, type GuardOutcome } from \"./guards\";\nimport { scoreInvalidationRecall, type InvalidationOutcome } from \"./invalidation\";\nimport { scoreModalityPrecision, type ModalityOutcome } from \"./modality\";\nimport { scorePremiseExtraction, type PremiseOutcome } from \"./premise\";\nimport { scoreRetrieval, type RetrievalOutcome } from \"./retrieval\";\nimport { buildResolver, type Resolver } from \"./resolve\";\nimport { METRIC_NAMES, UNUSUAL_METRICS, type MetricId, type MetricResult } from \"./types\";\n\nexport interface ScoredRun {\n  readonly run: RunResult;\n  readonly resolver: Resolver;\n  /** All thirteen, in the order they are reported. */\n  readonly metrics: readonly MetricResult[];\n  /* The full outcomes, not just the metrics: the report needs the per-plant and per-question detail to\n   * show its working, and a summary number with no breakdown behind it is not defensible. */\n  readonly extraction: ExtractionOutcome;\n  readonly premise: PremiseOutcome;\n  readonly alternative: AlternativeOutcome;\n  readonly modality: ModalityOutcome;\n  readonly contradiction: ContradictionOutcome;\n  readonly invalidation: InvalidationOutcome;\n  readonly cascade: CascadeOutcome;\n  readonly falsePositives: FalsePositiveOutcome;\n  readonly groundedness: GroundednessOutcome;\n  readonly retrieval: RetrievalOutcome;\n  readonly guards: GuardOutcome;\n}\n\n/**\n * Score one completed run against the corpus.\n *\n * Pure: it reads the run and the corpus and writes nothing. Running it twice on the same input gives\n * the same output, which is what makes an ablation delta attributable to the toggle rather than to the\n * scorer.\n */\nexport function scoreAll(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): ScoredRun {\n  /* ---- extraction first: these alignments build the resolver ---- */\n  const extraction = scoreDecisionExtraction(corpus, run, engine);\n  const premise = scorePremiseExtraction(corpus, run, engine);\n  const alternative = scoreAlternativeExtraction(corpus, run, engine);\n  const modality = scoreModalityPrecision(corpus, run, engine);\n\n  const resolver = buildResolver(\n    corpus,\n    run,\n    extraction.alignment,\n    premise.alignment,\n    alternative.alignment,\n  );\n\n  /* ---- reasoning: all depend on the resolver ---- */\n  const contradiction = scoreContradictionRecall(corpus, run, resolver, engine);\n  const invalidation = scoreInvalidationRecall(corpus, run, resolver, engine);\n  const cascade = scoreCascade(corpus, run, resolver, engine);\n  const falsePositives = scoreFalsePositives(corpus, run, resolver, engine);\n\n  /* ---- retrieval and answering ---- */\n  const groundedness = scoreGroundedness(corpus, run, engine);\n  const retrieval = scoreRetrieval(corpus, run, resolver, engine);\n\n  /* ---- guards ---- */\n  const guards = scoreGuards(corpus, run, engine);\n\n  return {\n    run,\n    resolver,\n    extraction,\n    premise,\n    alternative,\n    modality,\n    contradiction,\n    invalidation,\n    cascade,\n    falsePositives,\n    groundedness,\n    retrieval,\n    guards,\n    metrics: [\n      extraction.metric,\n      premise.metric,\n      alternative.metric,\n      contradiction.metric,\n      invalidation.metric,\n      cascade.correctness,\n      cascade.survivorship,\n      falsePositives.metric,\n      groundedness.metric,\n      retrieval.precision,\n      retrieval.mrr,\n      guards.metric,\n      modality.metric,\n    ],\n  };\n}\n\n/** The two metrics ┬º7.2 flags as unusual, pulled to the front of a report section. They are the ones\n *  no competitor can produce at any quality, because no competitor has the components they measure. */\nexport function unusualMetrics(scored: ScoredRun): readonly MetricResult[] {\n  return scored.metrics.filter((metric) => (UNUSUAL_METRICS as readonly string[]).includes(metric.id));\n}\n\n/** Metrics with no published comparator. Not a gap in the work ΓÇö the claim that this is new territory,\n *  stated as a list of metric ids rather than as an adjective. */\nexport function metricsWithoutComparator(scored: ScoredRun): readonly MetricResult[] {\n  return scored.metrics.filter((metric) => metric.comparator === null);\n}\n\nexport function metricById(scored: ScoredRun, id: MetricId): MetricResult | null {\n  return scored.metrics.find((metric) => metric.id === id) ?? null;\n}\n\n/** The suite as a compact table. Every row carries n beside the value, because a number without a\n *  denominator is not a measurement and this is the shortest form in which the suite gets quoted. */\nexport function renderSuite(scored: ScoredRun): string {\n  const lines: string[] = [];\n\n  lines.push(\"Metric\".padEnd(46) + \"Value\".padStart(9) + \"n\".padStart(7) + \"  Comparator\");\n  lines.push(\"-\".repeat(100));\n\n  for (const metric of scored.metrics) {\n    const comparator =\n      metric.comparator === null ? \"NONE PUBLISHED\" : metric.comparator.source;\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \"/100\"\n      : metric.value.toFixed(3);\n\n    lines.push(metric.name.padEnd(46) + value.padStart(9) + String(metric.n).padStart(7) + \"  \" + comparator);\n  }\n\n  lines.push(\"\");\n  lines.push(\"Lower is better for: false-positive rate. Higher is better for everything else.\");\n  lines.push(\n    metricsWithoutComparator(scored).length + \" of \" + scored.metrics.length +\n    \" metrics have NO published comparator ΓÇö that is the new-territory claim, stated as a count.\",\n  );\n\n  return lines.join(\"\\n\");\n}\n\nexport { METRIC_NAMES };\nexport type { MetricId, MetricResult, Resolver };\nexport { buildResolver } from \"./resolve\";\nexport { MATCH_RULE, align, overlapOf, type Alignment, type AlignedPair, type Span } from \"./match\";\nexport {\n  COMPARATORS,\n  UNUSUAL_METRICS,\n  meanReciprocalRank,\n  precisionAtK,\n  precisionRecall,\n  describeEngineId,\n  type EngineMetric,\n  type PrecisionRecall,\n} from \"./types\";\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 2 ΓÇö premise extraction precision / recall / F1.\n *      perEngine: [{ engine: describeEngineId(engine), value: detail.f1, n: labels.length, detail }],\n      comparator: null, /* deliberately null: see COMPARATORS, whose entry states that none exists */\n      gloss:\n        `${detail.truePositives +}\" of \" +${labels.length + \" labelled premises became shared nodes;+\n        predicateErrors.length matched on span but were given the wrong predicate; \" +\n        unspanned node(s) carried no extraction span at all.,\n      honestNote:\n        \"NO PUBLISHED COMPARATOR EXISTS for this metric ΓÇö see \" + (COMPARATORS[\"premise-extraction\"]?.source ?? \"none\") +\nexport type { PremiseId };\n","ops":[{"diffOp":{"equal":{"range":[0,66]}}},{"equalLines":{"line_count":105}},{"diffOp":{"equal":{"range":[66,281]}}},{"diffOp":{"equal":{"range":[281,290]}}},{"diffOp":{"insert":{"range":[290,293]}}},{"diffOp":{"equal":{"range":[293,313]}}},{"diffOp":{"delete":{"range":[313,315]}}},{"diffOp":{"insert":{"range":[315,316]}}},{"diffOp":{"equal":{"range":[66,67]}}},{"diffOp":{"delete":{"range":[316,318]}}},{"diffOp":{"equal":{"range":[318,320]}}},{"diffOp":{"delete":{"range":[320,324]}}},{"diffOp":{"equal":{"range":[320,321]}}},{"diffOp":{"insert":{"range":[324,326]}}},{"diffOp":{"equal":{"range":[326,339]}}},{"diffOp":{"delete":{"range":[339,343]}}},{"diffOp":{"insert":{"range":[315,316]}}},{"diffOp":{"equal":{"range":[343,382]}}},{"diffOp":{"delete":{"range":[320,322]}}},{"diffOp":{"equal":{"range":[313,314]}}},{"diffOp":{"delete":{"range":[382,392]}}},{"diffOp":{"insert":{"range":[324,326]}}},{"diffOp":{"equal":{"range":[392,414]}}},{"diffOp":{"delete":{"range":[339,343]}}},{"diffOp":{"insert":{"range":[315,316]}}},{"diffOp":{"equal":{"range":[414,467]}}},{"diffOp":{"delete":{"range":[467,479]}}},{"diffOp":{"insert":{"range":[324,326]}}},{"diffOp":{"equal":{"range":[479,488]}}},{"diffOp":{"delete":{"range":[339,343]}}},{"diffOp":{"insert":{"range":[315,316]}}},{"diffOp":{"equal":{"range":[488,531]}}},{"diffOp":{"delete":{"range":[316,317]}}},{"diffOp":{"insert":{"range":[290,291]}}},{"diffOp":{"equal":{"range":[531,674]}}},{"equalLines":{"line_count":35}},{"diffOp":{"equal":{"range":[674,702]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\premise.ts"},"span":[5262,5511],"sourceCode":"/**\n * Metric 2 ΓÇö premise extraction precision / recall / F1.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: NONE PUBLISHED. That absence is the result.\n *\n * ---------------------------------------------------------------------------\n * WHY THIS METRIC HAS NO COMPARATOR, AND WHY THAT IS THE POINT\n *\n * No system surveyed in docs/05 or docs/06 extracts premises from dialogue. RecovAr recovers\n * rationale, ARGUS recovers alternatives, Kantara builds decision graphs from commits, agentmemory\n * stores turns. None of them represents \"this decision is true GIVEN these assumptions\" as first-class\n * nodes, so none of them can be measured on recovering them.\n *\n * A metric with no comparator cannot be spun. There is no prior number to beat, no framing in which\n * 0.4 recall is a win, and no baseline to blame. It is the one metric in this file where the only\n * available interpretation of the number is the true one ΓÇö which is precisely why ┬º7.2 requires it and\n * why the report leads with it rather than burying it after the metrics that do have comparators.\n *\n * ---------------------------------------------------------------------------\n * PREDICATE-FIRST, TYPE-STRICT\n *\n * A premise node is matched on span overlap like every other node, but the alignment additionally\n * requires the premise TYPE to agree. The substrate forbids merging across types regardless of text\n * similarity ΓÇö \"single user\" (scale) and \"single sign-on user flow\" (requirement) are never the same\n * node, because a false merge produces a spectacular wrong cascade. A metric that scored across types\n * would be measuring something the system is not allowed to do.\n *\n * Predicate disagreement is counted separately, for the same reason variable disagreement is in\n * `extraction.ts`: the right sentence found and the wrong predicate assigned is a distinct, fixable\n * failure and folding it into a miss makes it invisible.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId, PremiseId } from \"@/types/common\";\nimport type { Premise } from \"@/types/domain\";\nimport type { ResolvedCorpus, ResolvedPremise } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface PremiseOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedPremise, Premise>;\n  readonly predicateErrors: readonly { label: ResolvedPremise; node: Premise }[];\n  readonly typeErrors: readonly { label: ResolvedPremise; node: Premise }[];\n}\n\nexport function scorePremiseExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): PremiseOutcome {\n  const labels: ResolvedPremise[] = [];\n  for (const transcript of corpus.transcripts) {\n    for (const premise of transcript.premises) {\n      /* `expectInList` is the premise-level form of \"should this become a node\": true when the\n       * transcript STATES it as a fact, false when it is only mentioned. A mentioned premise is not\n       * an extraction failure, so counting it as one would penalise the system for not inventing\n       * beliefs nobody held. */\n      if (!premise.expectInList) continue;\n      labels.push(premise);\n    }\n  }\n\n  const nodes: Premise[] = [...run.state.premises.values()];\n\n  /* Premise spans live on the EVIDENCE, not the node: a premise is shared (invariant I2) and may have\n   * several observations behind it. The first evidence entry with a span is the one that created it,\n   * which is the span the label refers to. A premise with no span at all ΓÇö created by a guard result\n   * or a human assertion rather than by extraction ΓÇö cannot be matched and is reported as spurious,\n   * which is correct: it was not extracted from this corpus. */\n  const spanOf = (premise: Premise): { start: number; end: number } | null => {\n    for (const evidence of premise.evidence) {\n      if (evidence.span !== undefined) return { start: evidence.span.start, end: evidence.span.end };\n    }\n    return null;\n  };\n\n  const alignable = nodes.filter((node) => spanOf(node) !== null);\n  const unspanned = nodes.length - alignable.length;\n\n  const alignment = align(\n    labels,\n    alignable,\n    (label) => label.span,\n    (node) => spanOf(node) ?? { start: 0, end: 0 },\n    (label, node) => label.type === node.type,\n  );\n\n  const predicateErrors = alignment.pairs\n    .filter((pair) => pair.label.predicate !== pair.node.predicate)\n    .map((pair) => ({ label: pair.label, node: pair.node }));\n\n  const typeErrors = findTypeErrors(labels, nodes);\n\n  const detail = precisionRecall(\n    alignment.truePositives,\n    alignment.falsePositives + unspanned,\n    alignment.falseNegatives,\n  );\n\n  return {\n    alignment,\n    predicateErrors,\n    typeErrors,\n    metric: {\n      id: \"premise-extraction\",\n      name: METRIC_NAMES[\"premise-extraction\"],\n      value: detail.f1,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.f1, n: labels.length, detail }],\n      comparator: null, /* deliberately null: see COMPARATORS, whose entry states that none exists */\n      gloss:\n        detail.truePositives + \" of \" + labels.length + \" labelled premises became shared nodes; \" +\n        predicateErrors.length + \" matched on span but were given the wrong predicate; \" +\n        unspanned + \" node(s) carried no extraction span at all.\",\n      honestNote:\n        \"NO PUBLISHED COMPARATOR EXISTS for this metric ΓÇö see \" + (COMPARATORS[\"premise-extraction\"]?.source ?? \"none\") +\n        \". The absence is reported rather than filled with a borrowed number from a different task. \" +\n        \"Matched by \" + MATCH_RULE + \", additionally requiring premise TYPE to agree, because the substrate forbids \" +\n        \"merging across types and a metric that scored across them would measure something the system may not do. \" +\n        \"n=\" + labels.length + \" premises, hand-labelled by the system's author. Premise extraction is the weakest link \" +\n        \"in the architecture (risk R1) and this is the metric that would show it.\",\n    },\n  };\n}\n\n/** Spans that overlap but whose types disagree. Excluded from `align` by the eligibility predicate, so\n *  they surface here instead ΓÇö otherwise a type error would look identical to a total miss. */\nfunction findTypeErrors(labels: readonly ResolvedPremise[], nodes: readonly Premise[]): { label: ResolvedPremise; node: Premise }[] {\n  const out: { label: ResolvedPremise; node: Premise }[] = [];\n\n  for (const label of labels) {\n    for (const node of nodes) {\n      if (node.type === label.type) continue;\n\n      let span: { start: number; end: number } | null = null;\n      for (const evidence of node.evidence) {\n        if (evidence.span !== undefined) {\n          span = { start: evidence.span.start, end: evidence.span.end };\n          break;\n        }\n      }\n      if (span === null) continue;\n\n      const start = Math.max(label.span.start, span.start);\n      const end = Math.min(label.span.end, span.end);\n      if (end > start) out.push({ label, node });\n    }\n  }\n\n  return out;\n}\n\nexport type { PremiseId };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 2 ΓÇö premise extraction precision / recall / F1.\n *        predicateErrors.length + \" matched on span but were given the wrong predicate; \" +\n        unspanned + \" node(s) carried no extraction span at all.\",\n      honestNote:\n        \"`NO PUBLISHED COMPARATOR EXISTS for this metric ΓÇö see \" + (${COMPARATORS[\"premise-extraction\"]?.source ?? \"none\") +\n        \"}. The absence is reported rather than filled with a borrowed number from a different task. \" +\n        \"Matched by MATCH_RULE + \", additionally requiring premise TYPE to agree, because the substrate forbids \"+\n        \"merging across types and a metric that scored across them would measure something the system may not do.n=labels.length premises, hand-labelled by the system's author. Premise extraction is the weakest link in the architecture (risk R1) and this is the metric that would sh