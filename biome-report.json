ingField(fields, \"statement\") === null\n      ? {}\n      : { statement: stringField(fields, \"statement\") as string }),\n    ...(stringField(fields, \"yStatement\") === null\n      ? {}\n      : { yStatement: stringField(fields, \"yStatement\") as string }),\n    ...(stringField(fields, \"rationale\") === null\n      ? {}\n      : { rationale: stringField(fields, \"rationale\") as string }),\n    origin: \"human_override\",\n    confidence: EDITED_CONFIDENCE,\n    // An edited decision is asserted, not proposed: the human has said the words.\n    // This is the one place `modality` is changed by the review rather than by the\n    // modality detector, and it is correct ΓÇö the human asserting it IS the evidence.\n    modality: \"asserted\",\n  };\n}\n\nfunction editPremise(\n  candidate: PremiseCandidate,\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): PremiseCandidate {\n  return {\n    ...candidate,\n    ...(stringField(fields, \"predicate\") === null\n      ? {}\n      : { predicate: stringField(fields, \"predicate\") as string }),\n    ...(stringField(fields, \"text\") === null\n      ? {}\n      : { text: stringField(fields, \"text\") as string }),\n    ...(fields[\"value\"] === undefined || fields[\"value\"] === null\n      ? {}\n      : { value: fields[\"value\"] as string | number | boolean }),\n    confidence: EDITED_CONFIDENCE,\n    // A human-confirmed premise no longer needs review. This is the only route to\n    // `needsReview: false` in Phase 1, and it requires a person.\n    needsReview: false,\n  };\n}\n\nfunction editAlternative(\n  candidate: AlternativeCandidate,\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): AlternativeCandidate {\n  return {\n    ...candidate,\n    ...(stringField(fields, \"value\") === null\n      ? {}\n      : { value: stringField(fields, \"value\") as string }),\n    ...(stringField(fields, \"whyRejected\") === null\n      ? {}\n      : { whyRejected: stringField(fields, \"whyRejected\") as string }),\n    confidence: EDITED_CONFIDENCE,\n  };\n}\n\nfunction stringField(\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n  key: string,\n): string | null {\n  const value = fields[key];\n  return typeof value === \"string\" ? value : null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Batch                                                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one action to a batch.\n *\n * Bulk approve passes `viaBulk: true`, which the fold reads to KEEP THE LABEL AT\n * UNKNOWN. Ten decisions promoted to IN by one click is how a machine inference\n * ends up driving a cascade, so the fast path is fast without being authoritative.\n */\nexport function applyBatch(\n  candidates: readonly ResolvedCandidate[],\n  action: ReviewAction,\n): readonly ResolvedCandidate[] {\n  return candidates.map((candidate) => applyAction(candidate, action));\n}\n\n/** The discard event for one item. Keeps the confidence the item HAD, so the\n *  precision metric can be computed per tier: \"of the items scored high, how many\n *  did the human discard?\" is the number that says whether the rubric is calibrated. */\nexport function discardFrom(item: ReviewItem): DiscardedCandidate {\n  return {\n    kind: item.kind,\n    discardedBy: \"human\",\n    // The quote is preferred over the machine's summary: the discard list is what\n    // Phase 7 reads to compute precision, and a paraphrase in it would make the\n    // measurement measure the paraphraser.\n    rawText: item.quote.length > 0 ? item.quote : item.detail,\n    confidence: asConfidence(item.confidence),\n  };\n}\n\n/**\n * Which decisions a batch would conflict with.\n *\n * Shown BEFORE the action is applied. Bulk-approving three items that each\n * contradict a live decision is the fastest way to put the graph into a state where\n * every subsequent contradiction check fires, and the user is told first.\n */\nexport function conflictsInBatch(candidates: readonly ResolvedCandidate[]): readonly DecisionId[] {\n  const out = new Set<DecisionId>();\n  for (const candidate of candidates) {\n    for (const id of candidate.resolution.conflictsWith) out.add(id);\n  }\n  return [...out];\n}\n\n/** Can this item be bulk-approved? Mirrors `tierDecision.bulkApprovable` for the\n *  graph-sourced queue, where the tier is recomputed from the node's confidence. */\nexport function isBulkApprovable(item: ReviewItem): boolean {\n  return item.kind === \"decision\" && item.tier === \"high\" && item.action === null;\n}\n\n/** The contested items, which is the Hansson queue in Phase 1's clothing: things\n *  that could not outrank a contradictor and are waiting for a human. */\nexport function contestedIn(\n  candidates: readonly ResolvedCandidate[],\n): readonly ResolvedCandidate[] {\n  return candidates.filter((candidate) => candidate.action?.type === \"contest\");\n}\n\n/** The keyboard map, exported so the component and the help panel cannot disagree\n *  about what a key does. */\nexport const REVIEW_KEYS: Readonly<Record<string, string>> = {\n  j: \"next item\",\n  k: \"previous item\",\n  a: \"approve\",\n  d: \"discard\",\n  e: \"edit\",\n  c: \"contest\",\n  Enter: \"approve and advance\",\n  Escape: \"close the editor\",\n  \"Shift+A\": \"approve every expanded item (bulk ΓÇö stays UNKNOWN)\",\n  \"Shift+D\": \"discard every collapsed item\",\n};\n\nexport function describeKeys(): string {\n  return Object.entries(REVIEW_KEYS)\n    .map(([key, meaning]) => `${key} ΓÇö ${meaning}`)\n    .join(\" ┬╖ \");\n}\n\n/** What an action says, in the words the audit trail will show. */\nexport function describeAction(action: ReviewAction | null): string {\n  if (action === null) return \"not reviewed\";\n  switch (action.type) {\n    case \"approve\":\n      return action.viaBulk\n        ? \"approved in bulk ΓÇö recorded, but stays UNKNOWN until approved individually\"\n        : \"approved\";\n    case \"edit\":\n      return `edited: ${Object.keys(action.fields).join(\", \")}`;\n    case \"discard\":\n      return `discarded ΓÇö ${action.reason}`;\n    case \"merge-into\":\n      return `merged into ${action.targetId}, overriding the ladder`;\n    case \"contest\":\n      return `contested ΓÇö ${action.reason}`;\n  }\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\rationale.ts"},"span":[6090,6101],"sourceCode":"/**\n * Rationale, accepted downside and `applies_to` ΓÇö 1.3, component 5.\n *\n * Phase 1 ┬╖ sub-phase 1.3\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.3\n *\n * ---------------------------------------------------------------------------\n * WHY THE RATIONALE IS A SEPARATE FIELD AND NOT PART OF THE STATEMENT\n *\n * The statement is what the export ships as a rule; the rationale is why the rule\n * exists. Keeping them apart is what lets Phase 2 ask \"is this rationale still\n * true?\" ΓÇö a question that cannot be posed of a sentence where the two are fused.\n *\n * ---------------------------------------------------------------------------\n * WHY `acceptedDownside` DESERVES EXTRACTION EFFORT\n *\n * Nobody stores it, and it is precisely what a future you needs when the downside\n * arrives. \"SQLite, and yes that means one writer at a time\" is the sentence that\n * stops a re-litigation six months later. It is also the cheapest trust signal\n * available: an extractor that recovers the cost of a decision, not only its\n * benefit, is visibly reading rather than pattern-matching.\n *\n * ---------------------------------------------------------------------------\n * DIRECTION\n *\n * Rationale markers are sought BOTH after and before the cue. Dialogue puts the\n * reason first about as often as last ΓÇö \"single-user and no deploy hassle is the\n * whole argument\" follows the decision, but \"we can't afford a managed service, so\n * SQLite\" precedes it. Searching only one direction halves recall for no gain.\n * ---------------------------------------------------------------------------\n */\n\nimport { findGlobs } from \"@/lib/glob\";\nimport { contentTokens } from \"@/lib/text\";\n\nexport interface RationaleCandidate {\n  readonly text: string;\n  readonly marker: string;\n  readonly direction: \"after\" | \"before\";\n  readonly start: number;\n  readonly end: number;\n  /** 0..1. Explicit markers score above the topic sentence. */\n  readonly strength: number;\n}\n\nexport interface DownsideCandidate {\n  readonly text: string;\n  readonly marker: string;\n  readonly start: number;\n  readonly end: number;\n}\n\nexport interface ClauseFields {\n  readonly rationale: RationaleCandidate | null;\n  readonly downside: DownsideCandidate | null;\n  readonly appliesTo: readonly string[];\n  /** What the decision is trying to achieve ΓÇö the `to achieve Γƒ¿qualityΓƒ⌐` slot. */\n  readonly quality: string | null;\n  /** What problem prompted it ΓÇö the `facing Γƒ¿concernΓƒ⌐` slot. */\n  readonly concern: string | null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Markers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/** Explicit reason markers, strongest first. */\nconst RATIONALE_MARKERS: readonly string[] = [\n  \"the whole argument is\",\n  \"the whole reason is\",\n  \"the reason being\",\n  \"the reason is\",\n  \"mainly because\",\n  \"mostly because\",\n  \"purely because\",\n  \"simply because\",\n  \"so that\",\n  \"in order to\",\n  \"because\",\n  \"due to\",\n  \"owing to\",\n  \"on account of\",\n  \"given that\",\n  \"seeing as\",\n  \"as long as\",\n  \"since\",\n  \"for this reason\",\n  \"which means\",\n  \"that means\",\n  \"to avoid\",\n  \"to keep\",\n  \"to prevent\",\n  \"to sidestep\",\n  \"so we don't\",\n  \"so we do not\",\n  \"so we can\",\n  \"so it\",\n  \"so\",\n];\n\nconst DOWNSIDE_MARKERS: readonly string[] = [\n  \"accepted downside\",\n  \"accepting that\",\n  \"accepting the\",\n  \"we accept\",\n  \"i accept\",\n  \"the downside is\",\n  \"downside is\",\n  \"the trade-off is\",\n  \"trade-off is\",\n  \"tradeoff is\",\n  \"the cost is\",\n  \"the catch is\",\n  \"catch is\",\n  \"the caveat is\",\n  \"caveat is\",\n  \"the limitation is\",\n  \"at the cost of\",\n  \"even though\",\n  \"yes that means\",\n  \"which does mean\",\n  \"which means we lose\",\n  \"we lose\",\n  \"gives up\",\n  \"giving up\",\n  \"sacrificing\",\n  \"in exchange for\",\n  \"the price is\",\n];\n\n/** Quality attributes ΓÇö the `to achieve` slot's vocabulary. */\nconst QUALITY_TERMS: readonly string[] = [\n  \"simplicity\",\n  \"simple\",\n  \"portability\",\n  \"portable\",\n  \"performance\",\n  \"speed\",\n  \"fast\",\n  \"reliability\",\n  \"reliable\",\n  \"testability\",\n  \"testable\",\n  \"maintainability\",\n  \"flexibility\",\n  \"flexible\",\n  \"control\",\n  \"predictability\",\n  \"deterministic\",\n  \"offline\",\n  \"zero-config\",\n  \"zero config\",\n  \"no deploy\",\n  \"no infrastructure\",\n  \"low cost\",\n  \"free\",\n  \"cheap\",\n  \"security\",\n  \"privacy\",\n  \"latency\",\n  \"throughput\",\n  \"developer experience\",\n  \"dx\",\n  \"velocity\",\n  \"stability\",\n  \"observability\",\n];\n\n/** Concern markers ΓÇö the `facing` slot. */\nconst CONCERN_MARKERS: readonly string[] = [\n  \"the problem is\",\n  \"problem is\",\n  \"the issue is\",\n  \"issue is\",\n  \"the pain is\",\n  \"facing\",\n  \"we need\",\n  \"i need\",\n  \"we're hitting\",\n  \"we hit\",\n  \"blocked by\",\n  \"struggling with\",\n  \"the hard part is\",\n  \"concern is\",\n  \"the worry is\",\n];\n\n/** How far either side of the cue to look. Longer than the negation window\n *  because a rationale is a clause, not a word. */\nconst RATIONALE_WINDOW = 260;\nconst DOWNSIDE_WINDOW = 200;\n\nconst CLAUSE_END = /[.!?\\n;]/;\n\n/* -------------------------------------------------------------------------- */\n/* Extraction                                                                 */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Pull the clause fields out of an episode or turn body.\n *\n * @param text  the body being read\n * @param at    the position of the decision cue within it\n */\nexport function extractClauseFields(text: string, at: number): ClauseFields {\n  return {\n    rationale: extractRationale(text, at),\n    downside: extractDownside(text, at),\n    appliesTo: extractAppliesTo(text, at),\n    quality: extractQuality(text, at),\n    concern: extractConcern(text, at),\n  };\n}\n\n/** The reason clause, searching after the cue first because that is where prose\n *  usually puts it, then before. */\nexport function extractRationale(text: string, at: number): RationaleCandidate | null {\n  return rationaleIn(text, at, \"after\") ?? rationaleIn(text, at, \"before\");\n}\n\nfunction rationaleIn(\n  text: string,\n  at: number,\n  direction: \"after\" | \"before\",\n): RationaleCandidate | null {\n  const windowStart = direction === \"after\" ? at : Math.max(0, at - RATIONALE_WINDOW);\n  const windowEnd = direction === \"after\" ? Math.min(text.length, at + RATIONALE_WINDOW) : at;\n  const window = text.slice(windowStart, windowEnd);\n  const lower = window.toLowerCase();\n\n  let best: RationaleCandidate | null = null;\n\n  for (let m = 0; m < RATIONALE_MARKERS.length; m += 1) {\n    const marker = RATIONALE_MARKERS[m];\n    if (marker === undefined) continue;\n\n    const found = lower.indexOf(marker);\n    if (found < 0) continue;\n\n    const bodyStart = windowStart + found + marker.length;\n    const body = readClause(text, bodyStart);\n    if (body.text.trim().length < 8) continue;\n\n    // Earlier in the table means a more explicit marker, so the first hit wins\n    // unless a later one is markedly longer ΓÇö a longer reason is a better reason.\n    const strength = 1 - m / (RATIONALE_MARKERS.length * 1.6);\n    const candidate: RationaleCandidate = {\n      text: body.text.trim(),\n      marker,\n      direction,\n      start: body.start,\n      end: body.end,\n      strength: Math.max(0.2, Math.min(0.98, strength + (body.text.length > 60 ? 0.05 : 0))),\n    };\n\n    if (best === null || candidate.strength > best.strength) best = candidate;\n    if (best !== null && best.strength > 0.9) break;\n  }\n\n  return best;\n}\n\nexport function extractDownside(text: string, at: number): DownsideCandidate | null {\n  const start = Math.max(0, at - Math.floor(DOWNSIDE_WINDOW / 3));\n  const end = Math.min(text.length, at + DOWNSIDE_WINDOW);\n  const window = text.slice(start, end);\n  const lower = window.toLowerCase();\n\n  for (const marker of DOWNSIDE_MARKERS) {\n    const found = lower.indexOf(marker);\n    if (found < 0) continue;\n\n    const body = readClause(text, start + found + marker.length);\n    if (body.text.trim().length < 6) continue;\n\n    return {\n      text: body.text.trim(),\n      marker,\n      start: body.start,\n      end: body.end,\n    };\n  }\n  return null;\n}\n\n/**\n * File globs this decision governs.\n *\n * Sought in a wider window than the other fields because `applies_to` is often\n * stated a sentence or two away from the decision: \"that's the rule for anything\n * under src/db\". Feeds export ┬º5.3 and guard scoping ┬º4.2.\n */\nexport function extractAppliesTo(text: string, at: number): readonly string[] {\n  const start = Math.max(0, at - 300);\n  const end = Math.min(text.length, at + 400);\n  const found = findGlobs(text.slice(start, end));\n  return [...new Set(found)].slice(0, 8);\n}\n\nfunction extractQuality(text: string, at: number): string | null {\n  const window = text\n    .slice(Math.max(0, at - 120), Math.min(text.length, at + RATIONALE_WINDOW))\n    .toLowerCase();\n  for (const term of QUALITY_TERMS) {\n    if (window.includes(term)) return term;\n  }\n  return null;\n}\n\nfunction extractConcern(text: string, at: number): string | null {\n  const start = Math.max(0, at - 300);\n  const window = text.slice(start, at);\n  const lower = window.toLowerCase();\n\n  for (const marker of CONCERN_MARKERS) {\n    const found = lower.lastIndexOf(marker);\n    if (found < 0) continue;\n    const body = readClause(window, found + marker.length);\n    if (body.text.trim().length < 6) continue;\n    return body.text.trim();\n  }\n\n  // No marker: the tokens of the preceding clause are the best available summary\n  // of what prompted the decision. Weak, and reported as such by being the last\n  // resort rather than a scored candidate.\n  const preceding = window\n    .trim()\n    .split(CLAUSE_END)\n    .filter((s) => s.trim().length > 0);\n  const last = preceding[preceding.length - 1];\n  if (last === undefined) return null;\n  const tokens = contentTokens(last);\n  return tokens.length >= 3 ? last.trim() : null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Clause reading                                                             */\n/* -------------------------------------------------------------------------- */\n\n/** Read forward from `start` to the end of the clause, trimming a leading\n *  conjunction or comma. */\nfunction readClause(text: string, start: number): { text: string; start: number; end: number } {\n  let i = start;\n  while (i < text.length && /[\\s,;:]/.test(text[i] ?? \"\")) i += 1;\n\n  let end = i;\n  while (end < text.length && !CLAUSE_END.test(text[end] ?? \"\")) end += 1;\n\n  const body = text.slice(i, end);\n  const trimmed = body.replace(/^(?:and|but|so|which|that)\\s+/i, \"\");\n  return { text: trimmed, start: i, end };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeFields(fields: ClauseFields): string {\n  const parts: string[] = [];\n  parts.push(\n    fields.rationale === null\n      ? \"no rationale clause\"\n      : `rationale via \"${fields.rationale.marker}\"`,\n  );\n  parts.push(fields.downside === null ? \"no accepted downside\" : \"accepted downside recovered\");\n  parts.push(fields.quality === null ? \"no quality term\" : `quality: ${fields.quality}`);\n  parts.push(fields.concern === null ? \"no concern\" : `concern: ${fields.concern.slice(0, 40)}`);\n  if (fields.appliesTo.length > 0) parts.push(`applies to ${fields.appliesTo.join(\", \")}`);\n  return parts.join(\" ┬╖ \");\n}\n\nexport function markerCounts(): Readonly<Record<string, number>> {\n  return {\n    rationale: RATIONALE_MARKERS.length,\n    downside: DOWNSIDE_MARKERS.length,\n    quality: QUALITY_TERMS.length,\n    concern: CONCERN_MARKERS.length,\n  };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 26 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 26 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 26 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\review\\index.ts"},"span":[8996,8999],"sourceCode":"/**\n * The review model ΓÇö 1.9.\n *\n * Phase 1 ┬╖ sub-phase 1.9\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.9\n *\n * ---------------------------------------------------------------------------\n * THE QUEUE IS SORTED FOR REJECTION, NOT FOR ACCEPTANCE\n *\n * Extraction over-generates: ARGUS measured 155 false positives against 12 false\n * negatives, a 13:1 ratio (docs/05). So the review surface is optimised to make\n * saying NO cheap ΓÇö collapsed rows, one-click discard, `j`/`k`/`d`/`a` keys ΓÇö and\n * only incidentally easy to say yes to.\n *\n * That is a design decision with a measurable consequence, and it is the right one:\n * the cost of a wrong approval is a false node in the log that later drives a\n * cascade, while the cost of a wrong discard is losing an inference the user can\n * re-extract in one click.\n *\n * ---------------------------------------------------------------------------\n * TWO SOURCES, ONE QUEUE\n *\n * Before a commit the queue is the EXTRACTION RUN: candidates with no ids yet,\n * living in `store/extraction.ts`. After a commit it is the GRAPH: real nodes at\n * `status === \"proposed\"`, reached via `state.pendingReview`. Both have to render\n * in the same component with the same affordances, so both are projected onto one\n * shape here.\n *\n * They are NOT the same items and the queue is not additive: committing moves items\n * from the first representation to the second. A UI that showed both would show\n * every decision twice.\n * ---------------------------------------------------------------------------\n */\n\nimport type { ExtractionRun } from \"@/extraction/types\";\nimport type { ResolvedCandidate } from \"@/extraction/types\";\nimport { tierOf } from \"@/extraction/types\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { ReviewFilter, ReviewItem, ReviewQueueOptions, ReviewSort } from \"./types\";\n\n/* -------------------------------------------------------------------------- */\n/* From an uncommitted run                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Project a run's candidates onto review items.\n *\n * Called before a commit. The items have no ids, so `accept` on one of them means\n * \"write the events\", and `discard` means \"write an `ExtractionDiscarded`\".\n */\nexport function queueFromRun(\n  run: ExtractionRun,\n  candidates: readonly ResolvedCandidate[],\n): readonly ReviewItem[] {\n  return candidates.map((candidate) => itemFromCandidate(run, candidate));\n}\n\nfunction itemFromCandidate(run: ExtractionRun, candidate: ResolvedCandidate): ReviewItem {\n  const base = {\n    key: candidate.key,\n    id: null,\n    quote: candidate.snippet.text,\n    confidence: candidate.confidence,\n    tier: candidate.tier,\n    origin: candidate.origin.replace(/_/g, \" \"),\n    engine: run.engine.model,\n    expanded: candidate.tier !== \"low\",\n    resolution: candidate.resolution.explanation,\n    conflictsWith: candidate.resolution.conflictsWith,\n    action: null,\n  };\n\n  if (candidate.kind === \"decision\" && candidate.decision !== null) {\n    const decision = candidate.decision;\n    return {\n      ...base,\n      kind: \"decision\",\n      title: `${decision.variable} ΓåÆ ${decision.value}`,\n      detail: decision.yStatement ?? decision.statement,\n      derived: false,\n    };\n  }\n\n  if (candidate.kind === \"premise\" && candidate.premise !== null) {\n    const premise = candidate.premise;\n    const derived = isDerivedPremise(premise.predicate, premise.text);\n    return {\n      ...base,\n      kind: \"premise\",\n      title: `${premise.type}.${premise.predicate}`,\n      detail: premise.text,\n      derived,\n      // A derived premise is an inference from another premise, so it is never\n      // expanded by default even at high confidence.\n      expanded: base.expanded && !derived,\n    };\n  }\n\n  if (candidate.kind === \"alternative\" && candidate.alternative !== null) {\n    const alternative = candidate.alternative;\n    return {\n      ...base,\n      kind: \"alternative\",\n      title: `rejected: ${alternative.value}`,\n      detail: alternative.whyRejected ?? \"no reason recovered ΓÇö stored, but it will never pre-empt\",\n      derived: false,\n      // Alternatives are never expanded, at any tier. Published precision is 15.4%.\n      expanded: false,\n    };\n  }\n\n  return { ...base, kind: candidate.kind, title: candidate.key, detail: \"\", derived: false };\n}\n\n/**\n * Is this premise an OUT-list entry rather than a quoted one?\n *\n * Detected from the text marker `premise-linker.ts` writes, because the marker is\n * the only place the derivation is recorded ΓÇö a `PremiseCandidate` has no field for\n * it, and adding one would mean widening the engine interface for a local-engine\n * concern.\n */\nexport function isDerivedPremise(_predicate: string, text: string): boolean {\n  // `hasExclusion(predicate)` is deliberately NOT part of this test: a SUPPORTING\n  // premise can also have an exclusion rule (that is how its OUT-list entry is\n  // derived), so the predicate alone cannot distinguish the two. Only the marker\n  // can.\n  return text.includes(\"ΓÇö excluded by\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* From the graph                                                             */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Project the graph's review queues onto review items.\n *\n * Called after a commit. These are real nodes, so `accept` means\n * `DecisionApproved` and `discard` means `DecisionSuperseded` or\n * `PremiseRetracted` ΓÇö different events, same button.\n */\nexport function queueFromState(state: GraphState): readonly ReviewItem[] {\n  const items: ReviewItem[] = [];\n\n  for (const id of state.pendingReview) {\n    const decision = state.decisions.get(id);\n    if (decision === undefined) continue;\n    items.push(itemFromDecision(decision));\n  }\n\n  for (const id of state.pendingPremises) {\n    const premise = state.premises.get(id);\n    if (premise === undefined) continue;\n    items.push(itemFromPremise(premise));\n  }\n\n  for (const alternative of state.alternatives.values()) {\n    if (alternative.provenance === undefined) continue;\n    items.push(itemFromAlternative(alternative));\n  }\n\n  return items;\n}\n\nfunction itemFromDecision(decision: Decision): ReviewItem {\n  const confidence = decision.provenance?.confidence ?? 0.5;\n  return {\n    key: decision.id,\n    kind: \"decision\",\n    id: decision.id,\n    title: `${decision.variable} ΓåÆ ${decision.value}`,\n    detail: decision.yStatement ?? decision.statement,\n    quote: decision.provenance?.snippet.text ?? \"\",\n    confidence,\n    tier: tierOf(confidence),\n    origin: decision.provenance?.origin.replace(/_/g, \" \") ?? \"unknown\",\n    engine: decision.provenance?.extractedBy.model ?? \"unknown\",\n    expanded: tierOf(confidence) !== \"low\",\n    resolution: decision.status === \"proposed\" ? \"awaiting approval\" : decision.status,\n    conflictsWith: [],\n    derived: false,\n    action: null,\n  };\n}\n\nfunction itemFromPremise(premise: Premise): ReviewItem {\n  const confidence = premise.confidence;\n  const derived = isDerivedPremise(premise.predicate, premise.text);\n  return {\n    key: premise.id,\n    kind: \"premise\",\n    id: premise.id,\n    title: `${premise.type}.${premise.predicate}`,\n    detail: premise.text,\n    quote: premise.provenance.snippet.text,\n    confidence,\n    tier: tierOf(confidence),\n    origin: premise.provenance.origin.replace(/_/g, \" \"),\n    engine: premise.provenance.extractedBy.model,\n    expanded: tierOf(confidence) !== \"low\" && !derived,\n    resolution: `corroborated ${premise.corroboration}├ù`,\n    conflictsWith: [],\n    derived,\n    action: null,\n  };\n}\n\nfunction itemFromAlternative(alternative: RejectedAlternative): ReviewItem {\n  const confidence = alternative.confidence;\n  return {\n    key: alternative.id,\n    kind: \"alternative\",\n    id: alternative.id,\n    title: `rejected: ${alternative.value}`,\n    detail: alternative.whyRejected ?? \"no reason recovered ΓÇö stored, but it will never pre-empt\",\n    quote: alternative.provenance?.snippet.text ?? \"\",\n    confidence,\n    tier: tierOf(confidence),\n    origin: alternative.provenance?.origin.replace(/_/g, \" \") ?? \"unknown\",\n    engine: alternative.provenance?.extractedBy.model ?? \"unknown\",\n    expanded: false,\n    resolution: `against ${alternative.decisionId}`,\n    conflictsWith: [],\n    derived: false,\n    action: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Filtering and sorting                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport function filterQueue(\n  items: readonly ReviewItem[],\n  options: ReviewQueueOptions,\n): readonly ReviewItem[] {\n  const search = options.search.trim().toLowerCase();\n\n  return items.filter((item) => {\n    if (options.filter === \"unreviewed\" && item.action !== null) return false;\n\n    switch (options.filter) {\n      case \"decisions\":\n        if (item.kind !== \"decision\") return false;\n        break;\n      case \"premises\":\n        if (item.kind !== \"premise\") return false;\n        break;\n      case \"alternatives\":\n        if (item.kind !== \"alternative\") return false;\n        break;\n      case \"conflicts\":\n        if (item.conflictsWith.length === 0) return false;\n        break;\n      case \"derived\":\n        if (!item.derived) return false;\n        break;\n      case \"low\":\n        if (item.tier !== \"low\") return false;\n        break;\n      case \"all\":\n      case \"unreviewed\":\n        break;\n    }\n\n    if (search.length === 0) return true;\n    return (\n      item.title.toLowerCase().includes(search) ||\n      item.detail.toLowerCase().includes(search) ||\n      item.quote.toLowerCase().includes(search)\n    );\n  });\n}\n\nexport function sortQueue(items: readonly ReviewItem[], sort: ReviewSort): readonly ReviewItem[] {\n  const copy = [...items];\n\n  switch (sort) {\n    case \"confidence-desc\":\n      copy.sort((a, b) => b.confidence - a.confidence || a.key.localeCompare(b.key));\n      break;\n    case \"confidence-asc\":\n      copy.sort((a, b) => a.confidence - b.confidence || a.key.localeCompare(b.key));\n      break;\n    case \"kind\":\n      copy.sort((a, b) => kindRank(a.kind) - kindRank(b.kind) || b.confidence - a.confidence);\n      break;\n    case \"conflicts-first\":\n      copy.sort(\n        (a, b) =>\n          Number(b.conflictsWith.length > 0) - Number(a.conflictsWith.length > 0) ||\n          b.confidence - a.confidence,\n      );\n      break;\n  }\n\n  return copy;\n}\n\nfunction kindRank(kind: ReviewItem[\"kind\"]): number {\n  return kind === \"decision\" ? 0 : kind === \"premise\" ? 1 : 2;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface QueueSummary {\n  readonly total: number;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly derived: number;\n  readonly conflicts: number;\n  readonly low: number;\n  readonly expanded: number;\n  readonly reviewed: number;\n  readonly accepted: number;\n  readonly edited: number;\n  readonly discarded: number;\n}\n\nexport function summariseQueue(items: readonly ReviewItem[]): QueueSummary {\n  const count = (predicate: (item: ReviewItem) => boolean): number =>\n    items.filter(predicate).length;\n\n  return {\n    total: items.length,\n    decisions: count((i) => i.kind === \"decision\"),\n    premises: count((i) => i.kind === \"premise\"),\n    alternatives: count((i) => i.kind === \"alternative\"),\n    derived: count((i) => i.derived),\n    conflicts: count((i) => i.conflictsWith.length > 0),\n    low: count((i) => i.tier === \"low\"),\n    expanded: count((i) => i.expanded),\n    reviewed: count((i) => i.action !== null),\n    accepted: count((i) => i.action?.type === \"approve\"),\n    edited: count((i) => i.action?.type === \"edit\"),\n    discarded: count((i) => i.action?.type === \"discard\"),\n  };\n}\n\n/**\n * The sentence above the queue.\n *\n * Written to tell the user how long this will take and what most of it probably is,\n * because a queue of 40 items where 30 are collapsed low-tier is a 90-second job and\n * a queue of 40 expanded decisions is a ten-minute one.\n */\nexport function describeQueue(summary: QueueSummary): string {\n  if (summary.total === 0) return \"nothing to review\";\n\n  const parts = [\n    `${summary.total} item${summary.total === 1 ? \"\" : \"s\"} ΓÇö ${summary.decisions} decisions, ${summary.premises} premises, ${summary.alternatives} alternatives`,\n  ];\n  if (summary.expanded > 0) parts.push(`${summary.expanded} expanded`);\n  if (summary.low > 0) parts.push(`${summary.low} collapsed as low-confidence, probably wrong`);\n  if (summary.derived > 0) parts.push(`${summary.derived} derived rather than quoted ΓÇö read those`);\n  if (summary.conflicts > 0) parts.push(`${summary.conflicts} conflict with a live decision`);\n  if (summary.reviewed > 0) {\n    parts.push(\n      `${summary.reviewed} reviewed (${summary.accepted} accepted, ${summary.edited} edited, ${summary.discarded} discarded)`,\n    );\n  }\n  return parts.join(\" ┬╖ \");\n}\n\nexport const REVIEW_FILTERS: readonly { readonly id: ReviewFilter; readonly label: string }[] = [\n  { id: \"all\", label: \"All\" },\n  { id: \"unreviewed\", label: \"Unreviewed\" },\n  { id: \"decisions\", label: \"Decisions\" },\n  { id: \"premises\", label: \"Premises\" },\n  { id: \"alternatives\", label: \"Alternatives\" },\n  { id: \"conflicts\", label: \"Conflicts\" },\n  { id: \"derived\", label: \"Derived\" },\n  { id: \"low\", label: \"Low confidence\" },\n];\n\n/* -------------------------------------------------------------------------- */\n/* The barrel                                                                 */\n/* -------------------------------------------------------------------------- */\n\n/**\n * `src/extraction/review/index.ts` IS the review model, and it also re-exports the\n * other two review modules.\n *\n * That is unusual for a barrel and deliberate here: the model, the actions and the\n * commit preview are one feature seen from three angles, and a caller that has to\n * know which of the three files a function lives in has been made to understand the\n * implementation. `import { review } from \"@/extraction\"` gives them all of it.\n */\n\nexport {\n  EDITED_CONFIDENCE,\n  REVIEW_KEYS,\n  applyAction,\n  applyBatch,\n  applyEdit,\n  approve,\n  contest,\n  contestedIn,\n  conflictsInBatch,\n  describeAction,\n  describeKeys,\n  discard,\n  discardFrom,\n  edit,\n  isActedOn,\n  isBulkApprovable,\n  mergeInto,\n} from \"./actions\";\n\nexport {\n  MERGE_TARGETS_SHOWN,\n  describeCommit,\n  describeMergeTargets,\n  previewCommit,\n  summariseCommit,\n  type CommitPreview,\n} from \"./diff\";\n\n/* Re-exported so `@/extraction/review` remains the one import a caller needs. */\nexport type { ReviewFilter, ReviewItem, ReviewQueueOptions, ReviewSort } from \"./types\";\nexport { DEFAULT_REVIEW_OPTIONS } from \"./types\";\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\segmentation.ts"},"span":[3781,3792],"sourceCode":"import type { VariableGuess } from \"@/ontology/canonicalize\";\nimport { type CueHit, episodeVariable, scanCues, variableAtCue } from \"./cue-scan\";\nimport { toRawBounds } from \"./normalizer\";\nimport type {\n  EpisodeBoundaryReason,\n  EpisodeWindow,\n  NormalizedTranscript,\n  NormalizedTurn,\n} from \"./types\";\n\n/** Consecutive cue-less turns that close an episode. Three rather than one\n *  because a negotiation routinely has a digression in the middle of it, and\n *  closing on the first quiet turn is how a four-turn episode becomes two\n *  half-episodes with the premise in the wrong one. */\nconst CUE_GAP_TURNS = 3;\n\n/** Hard ceiling on episode length. Beyond this the episode is split and reported\n *  as `length-cap`, because an episode that long is two negotiations that happen\n *  to share a variable. */\nconst MAX_EPISODE_TURNS = 14;\nconst MAX_EPISODE_CHARS = 9_000;\n\n/** Turns included before the first cue. See the file header. */\nconst LEAD_TURNS = 1;\n\n/** Turns included after the last cue, so a trailing rationale is inside the\n *  window. Two rather than one: \"going with SQLite\" is often followed by the\n *  reason in the NEXT turn (\"yeah ΓÇö and the schema is tiny so migration stays\n *  open\"). */\nconst TRAIL_TURNS = 2;\n\n/** A variable guess at or above this score, differing from the running episode\n *  variable, is a topic shift. Below it, the guess is too weak to split on. */\nconst TOPIC_SHIFT_SCORE = 0.6;\n\nexport interface SegmentationResult {\n  readonly episodes: readonly EpisodeWindow[];\n  /** Turns that were in no episode. Reported, because a transcript where most\n   *  turns are skipped is a transcript the segmenter did not understand. */\n  readonly uncoveredTurns: number;\n  readonly cueHits: number;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function segmentEpisodes(normalized: NormalizedTranscript): SegmentationResult {\n  const turns = normalized.turns;\n  if (turns.length === 0) return { episodes: [], uncoveredTurns: 0, cueHits: 0 };\n\n  const perTurn = turns.map((turn) => scanCues(turn.text));\n  const cueHits = perTurn.reduce((total, hits) => total + hits.length, 0);\n\n  const ranges = groupRanges(turns, perTurn);\n  const episodes = ranges.map((range, index) =>\n    buildEpisode(index, normalized, turns, perTurn, range.start, range.end, range.reason),\n  );\n\n  const covered = new Set<number>();\n  for (const episode of episodes) {\n    for (let i = episode.turnRange[0]; i < episode.turnRange[1]; i += 1) covered.add(i);\n  }\n\n  return {\n    episodes,\n    uncoveredTurns: turns.length - covered.size,\n    cueHits,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Grouping                                                                   */\n/* -------------------------------------------------------------------------- */\n\ninterface Range {\n  readonly start: number;\n  readonly end: number;\n  readonly reason: EpisodeBoundaryReason;\n}\n\n/**\n * An episode being grown. The variable is a GUESS, not a label: the score is\n * what decides whether a shift to a different variable is a topic change or\n * just noise.\n */\ninterface OpenEpisode {\n  readonly firstCue: number;\n  readonly lastCue: number;\n  readonly variable: VariableGuess | null;\n}\n\n/**\n * Walk the turns and collect [start, end) ranges that contain at least one cue.\n *\n * The window is grown around the cues rather than built from them: the first cue\n * opens a candidate range one turn earlier (the lead turn) and the range stays\n * open through `CUE_GAP_TURNS` quiet turns and `TRAIL_TURNS` after the last cue.\n */\nfunction groupRanges(\n  turns: readonly NormalizedTurn[],\n  perTurn: readonly (readonly CueHit[])[],\n): readonly Range[] {\n  const ranges: Range[] = [];\n\n  let open: OpenEpisode | null = null;\n  let quiet = 0;\n\n  const close = (end: number, reason: EpisodeBoundaryReason): void => {\n    if (open === null) return;\n    const start = Math.max(0, open.firstCue - LEAD_TURNS);\n    const boundedEnd = Math.min(turns.length, Math.max(end, open.lastCue + 1 + TRAIL_TURNS));\n    ranges.push({ start, end: boundedEnd, reason });\n    open = null;\n    quiet = 0;\n  };\n\n  for (let i = 0; i < turns.length; i += 1) {\n    const hits = perTurn[i] ?? [];\n\n    if (hits.length > 0) {\n      const variable = variableForTurn(turns[i] as NormalizedTurn, hits);\n\n      // `open` is read through a local because a `let` that a closure could\n      // touch loses its narrowing after every function call ΓÇö and `close` is one.\n      const current: OpenEpisode | null = open;\n\n      if (current === null) {\n        open = { firstCue: i, lastCue: i, variable };\n        quiet = 0;\n        continue;\n      }\n\n      // Topic shift: a confident guess at a DIFFERENT variable closes the episode\n      // and opens a new one at this turn. Splitting here is what keeps a database\n      // decision and an auth decision out of the same justification.\n      if (\n        current.variable !== null &&\n        variable !== null &&\n        variable.variable !== current.variable.variable &&\n        variable.score >= TOPIC_SHIFT_SCORE\n      ) {\n        close(i, \"topic-shift\");\n        open = { firstCue: i, lastCue: i, variable };\n        quiet = 0;\n        continue;\n      }\n\n      const grown: OpenEpisode = {\n        ...current,\n        lastCue: i,\n        variable: current.variable ?? variable,\n      };\n      open = grown;\n      quiet = 0;\n\n      if (i - grown.firstCue + 1 >= MAX_EPISODE_TURNS) close(i + 1, \"length-cap\");\n      continue;\n    }\n\n    const current: OpenEpisode | null = open;\n    if (current === null) continue;\n\n    quiet += 1;\n    if (quiet >= CUE_GAP_TURNS) {\n      close(i - quiet + 1, \"cue-gap\");\n      continue;\n    }\n\n    const soFar = charSpan(turns, Math.max(0, current.firstCue - LEAD_TURNS), i + 1);\n    if (soFar > MAX_EPISODE_CHARS) close(i, \"length-cap\");\n  }\n\n  close(turns.length, \"end-of-transcript\");\n  return ranges;\n}\n\n/** The variable a single turn's cues point at. `hits` is unused here because the\n *  strongest cue is re-found from the text: `variableAtCue` needs the cue's\n *  POSITION to take its context window, and the caller's list is already\n *  position-correct, so the strongest of it is the right one to pass. */\nfunction variableForTurn(turn: NormalizedTurn, hits: readonly CueHit[]): VariableGuess | null {\n  const best = hits.reduce<CueHit | null>(\n    (current, hit) => (current === null || hit.weight > current.weight ? hit : current),\n    null,\n  );\n  if (best === null) return null;\n  return variableAtCue(turn.text, best);\n}\n\nfunction charSpan(turns: readonly NormalizedTurn[], start: number, end: number): number {\n  let total = 0;\n  for (let i = start; i < Math.min(end, turns.length); i += 1)\n    total += (turns[i]?.text.length ?? 0) + 2;\n  return total;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Building                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction buildEpisode(\n  index: number,\n  normalized: NormalizedTranscript,\n  turns: readonly NormalizedTurn[],\n  perTurn: readonly (readonly CueHit[])[],\n  start: number,\n  end: number,\n  reason: EpisodeBoundaryReason,\n): EpisodeWindow {\n  const slice = turns.slice(start, end);\n\n  // `text` is assembled from turn bodies rather than sliced out of the\n  // normalised transcript, because a slice would include the gaps between turns\n  // (marker remnants, collapsed placeholders) that the recognisers should not\n  // read. `turnOffsets` records where each body starts so a within-turn cue\n  // position converts to an episode position without a second search.\n  const parts: string[] = [];\n  const turnOffsets: number[] = [];\n  let length = 0;\n\n  for (const turn of slice) {\n    turnOffsets.push(length);\n    parts.push(turn.text);\n    length += turn.text.length + 2;\n  }\n\n  const text = parts.join(\"\\n\\n\");\n\n  const hits: CueHit[] = [];\n  slice.forEach((turn, position) => {\n    const offset = turnOffsets[position] ?? 0;\n    for (const hit of perTurn[turn.index] ?? []) {\n      hits.push(shiftHit(hit, offset));\n    }\n  });\n\n  const first = slice[0];\n  const last = slice[slice.length - 1];\n\n  return {\n    index,\n    turns: slice,\n    turnRange: [start, end],\n    charRange: [first?.start ?? 0, last?.end ?? 0],\n    rawRange: rawRangeOf(normalized, first, last),\n    text,\n    turnOffsets,\n    variable: episodeVariable(text, hits),\n    cuePositions: hits.map((hit) => hit.start),\n    boundaryReason: reason,\n  };\n}\n\nfunction shiftHit(hit: CueHit, offset: number): CueHit {\n  return { ...hit, start: hit.start + offset, end: hit.end + offset };\n}\n\n/** Turn bounds are in NORMALISED coordinates; the review pane needs RAW ones. */\nfunction rawRangeOf(\n  normalized: NormalizedTranscript,\n  first: NormalizedTurn | undefined,\n  last: NormalizedTurn | undefined,\n): readonly [number, number] {\n  if (first === undefined || last === undefined) return [0, 0];\n  return toRawBounds(normalized, first.start, last.end);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeSegmentation(result: SegmentationResult, turnCount: number): string {\n  const parts = [`${result.episodes.length} episode${result.episodes.length === 1 ? \"\" : \"s\"}`];\n  parts.push(`${result.cueHits} cue${result.cueHits === 1 ? \"\" : \"s\"}`);\n  if (result.uncoveredTurns > 0) {\n    parts.push(\n      `${result.uncoveredTurns} of ${turnCount} turns in no episode ΓÇö no decision cue, so nothing to extract`,\n    );\n  }\n  const capped = result.episodes.filter((e) => e.boundaryReason === \"length-cap\").length;\n  if (capped > 0) parts.push(`${capped} split on length, not on topic`);\n  return parts.join(\" ┬╖ \");\n}\n\n/** The episode a normalised character position falls in. Used to attribute a\n *  snippet to its episode when the recogniser only has an offset. */\nexport function episodeAt(\n  episodes: readonly EpisodeWindow[],\n  position: number,\n): EpisodeWindow | null {\n  for (const episode of episodes) {\n    if (position >= episode.charRange[0] && position < episode.charRange[1]) return episode;\n  }\n  return null;\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"`Generated \" + ${nowISO() + \"}. Do not edit by hand: \\`npm run eval:report` regenerates it.);\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":50}},{"diffOp":{"equal":{"range":[77,159]}}},{"diffOp":{"delete":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[160,161]}}},{"diffOp":{"equal":{"range":[161,171]}}},{"diffOp":{"delete":{"range":[171,175]}}},{"diffOp":{"insert":{"range":[175,177]}}},{"diffOp":{"equal":{"range":[177,185]}}},{"diffOp":{"delete":{"range":[185,189]}}},{"diffOp":{"insert":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[190,213]}}},{"diffOp":{"insert":{"range":[213,214]}}},{"diffOp":{"equal":{"range":[214,234]}}},{"diffOp":{"insert":{"range":[213,214]}}},{"diffOp":{"equal":{"range":[234,251]}}},{"diffOp":{"delete":{"range":[171,172]}}},{"diffOp":{"insert":{"range":[214,215]}}},{"diffOp":{"equal":{"range":[251,404]}}},{"equalLines":{"line_count":333}},{"diffOp":{"equal":{"range":[404,432]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[2587,2675],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"`Corpus \" + ${corpus.version + \"} ┬╖ engine \"+ describeEngine(scored)corpus.transcripts.length transcripts);\n  out.push(\"\");\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":52}},{"diffOp":{"equal":{"range":[77,206]}}},{"diffOp":{"delete":{"range":[206,207]}}},{"diffOp":{"insert":{"range":[207,208]}}},{"diffOp":{"equal":{"range":[208,215]}}},{"diffOp":{"delete":{"range":[215,219]}}},{"diffOp":{"insert":{"range":[219,221]}}},{"diffOp":{"equal":{"range":[221,235]}}},{"diffOp":{"delete":{"range":[235,239]}}},{"diffOp":{"insert":{"range":[239,240]}}},{"diffOp":{"equal":{"range":[240,250]}}},{"diffOp":{"delete":{"range":[250,252]}}},{"diffOp":{"equal":{"range":[240,241]}}},{"diffOp":{"delete":{"range":[252,254]}}},{"diffOp":{"insert":{"range":[219,221]}}},{"diffOp":{"equal":{"range":[254,276]}}},{"diffOp":{"delete":{"range":[235,239]}}},{"diffOp":{"insert":{"range":[239,240]}}},{"diffOp":{"equal":{"range":[240,244]}}},{"diffOp":{"delete":{"range":[215,219]}}},{"diffOp":{"insert":{"range":[219,221]}}},{"diffOp":{"equal":{"range":[276,301]}}},{"diffOp":{"delete":{"range":[235,239]}}},{"diffOp":{"insert":{"range":[239,240]}}},{"diffOp":{"equal":{"range":[301,313]}}},{"diffOp":{"delete":{"range":[215,216]}}},{"diffOp":{"insert":{"range":[207,208]}}},{"diffOp":{"equal":{"range":[313,332]}}},{"equalLines":{"line_count":331}},{"diffOp":{"equal":{"range":[332,360]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[2705,2826],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"`- **\" + ${metric.name + \"}** ΓÇö metric.gloss}`);\n    out.push(\"  \" + metric.honestNote);\n  }  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":83}},{"diffOp":{"equal":{"range":[77,155]}}},{"diffOp":{"delete":{"range":[155,156]}}},{"diffOp":{"insert":{"range":[156,157]}}},{"diffOp":{"equal":{"range":[157,161]}}},{"diffOp":{"delete":{"range":[161,165]}}},{"diffOp":{"insert":{"range":[165,167]}}},{"diffOp":{"equal":{"range":[167,178]}}},{"diffOp":{"delete":{"range":[178,182]}}},{"diffOp":{"insert":{"range":[182,183]}}},{"diffOp":{"equal":{"range":[183,190]}}},{"diffOp":{"delete":{"range":[161,165]}}},{"diffOp":{"insert":{"range":[165,167]}}},{"diffOp":{"equal":{"range":[190,202]}}},{"diffOp":{"insert":{"range":[202,204]}}},{"diffOp":{"equal":{"range":[204,250]}}},{"equalLines":{"line_count":300}},{"diffOp":{"equal":{"range":[250,278]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[3837,3884],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"`\" + ${metric.honestNote}`);\n  }\n  out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":84}},{"diffOp":{"equal":{"range":[77,202]}}},{"diffOp":{"delete":{"range":[202,203]}}},{"diffOp":{"insert":{"range":[203,204]}}},{"diffOp":{"equal":{"range":[77,79]}}},{"diffOp":{"delete":{"range":[204,208]}}},{"diffOp":{"insert":{"range":[208,210]}}},{"diffOp":{"equal":{"range":[210,227]}}},{"diffOp":{"insert":{"range":[227,229]}}},{"diffOp":{"equal":{"range":[229,251]}}},{"equalLines":{"line_count":299}},{"diffOp":{"equal":{"range":[251,279]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[3900,3924],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    `${without.length + \"} of \" + ${scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than,\n    \"as an adjective:\",\n  );  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":139}},{"diffOp":{"equal":{"range":[77,156]}}},{"diffOp":{"equal":{"range":[156,161]}}},{"diffOp":{"insert":{"range":[161,164]}}},{"diffOp":{"equal":{"range":[164,178]}}},{"diffOp":{"delete":{"range":[178,182]}}},{"diffOp":{"insert":{"range":[182,183]}}},{"diffOp":{"equal":{"range":[183,187]}}},{"diffOp":{"delete":{"range":[187,191]}}},{"diffOp":{"insert":{"range":[191,193]}}},{"diffOp":{"equal":{"range":[193,214]}}},{"diffOp":{"delete":{"range":[214,222]}}},{"diffOp":{"insert":{"range":[182,183]}}},{"diffOp":{"equal":{"range":[222,322]}}},{"diffOp":{"delete":{"range":[187,188]}}},{"diffOp":{"insert":{"range":[161,162]}}},{"diffOp":{"equal":{"range":[322,352]}}},{"equalLines":{"line_count":242}},{"diffOp":{"equal":{"range":[352,380]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[5521,5677],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"`- \" + ${metric.name}`);\n  out.push(\"\");\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":145}},{"diffOp":{"equal":{"range":[77,139]}}},{"diffOp":{"delete":{"range":[139,140]}}},{"diffOp":{"insert":{"range":[140,141]}}},{"diffOp":{"equal":{"range":[141,143]}}},{"diffOp":{"delete":{"range":[143,147]}}},{"diffOp":{"insert":{"range":[147,149]}}},{"diffOp":{"equal":{"range":[149,160]}}},{"diffOp":{"insert":{"range":[160,162]}}},{"diffOp":{"equal":{"range":[162,181]}}},{"equalLines":{"line_count":238}},{"diffOp":{"equal":{"range":[181,209]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[5765,5783],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"`Thirteen metrics over \" + ${scored.run.transcripts.length + \"} transcripts. Every one carries its sample,\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":161}},{"diffOp":{"equal":{"range":[77,148]}}},{"diffOp":{"equal":{"range":[148,153]}}},{"diffOp":{"delete":{"range":[153,154]}}},{"diffOp":{"insert":{"range":[154,155]}}},{"diffOp":{"equal":{"range":[155,177]}}},{"diffOp":{"delete":{"range":[177,181]}}},{"diffOp":{"insert":{"range":[181,183]}}},{"diffOp":{"equal":{"range":[183,212]}}},{"diffOp":{"delete":{"range":[212,216]}}},{"diffOp":{"insert":{"range":[216,217]}}},{"diffOp":{"equal":{"range":[217,259]}}},{"diffOp":{"delete":{"range":[177,178]}}},{"diffOp":{"insert":{"range":[154,155]}}},{"diffOp":{"equal":{"range":[259,367]}}},{"equalLines":{"line_count":221}},{"diffOp":{"equal":{"range":[367,395]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[6312,6415],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? `${metric.value.toFixed(1) + \"} per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":169}},{"diffOp":{"equal":{"range":[77,180]}}},{"diffOp":{"insert":{"range":[180,183]}}},{"diffOp":{"equal":{"range":[183,206]}}},{"diffOp":{"delete":{"range":[206,210]}}},{"diffOp":{"insert":{"range":[210,211]}}},{"diffOp":{"equal":{"range":[211,237]}}},{"diffOp":{"delete":{"range":[237,238]}}},{"diffOp":{"insert":{"range":[180,181]}}},{"diffOp":{"equal":{"range":[238,352]}}},{"equalLines":{"line_count":214}},{"diffOp":{"equal":{"range":[352,380]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[6633,6687],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"`- **\" + ${metric.name + \"}**: \"+ value (n=));\n  }\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":171}},{"diffOp":{"equal":{"range":[77,188]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[190,194]}}},{"diffOp":{"delete":{"range":[194,198]}}},{"diffOp":{"insert":{"range":[198,200]}}},{"diffOp":{"equal":{"range":[200,211]}}},{"diffOp":{"delete":{"range":[211,215]}}},{"diffOp":{"insert":{"range":[215,216]}}},{"diffOp":{"equal":{"range":[216,219]}}},{"diffOp":{"delete":{"range":[219,221]}}},{"diffOp":{"equal":{"range":[219,220]}}},{"diffOp":{"delete":{"range":[221,223]}}},{"diffOp":{"insert":{"range":[198,200]}}},{"diffOp":{"equal":{"range":[223,228]}}},{"diffOp":{"delete":{"range":[211,215]}}},{"diffOp":{"insert":{"range":[215,216]}}},{"diffOp":{"equal":{"range":[228,232]}}},{"diffOp":{"delete":{"range":[194,198]}}},{"diffOp":{"insert":{"range":[198,200]}}},{"diffOp":{"equal":{"range":[200,208]}}},{"diffOp":{"delete":{"range":[211,215]}}},{"diffOp":{"insert":{"range":[215,216]}}},{"diffOp":{"equal":{"range":[232,233]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[233,240]}}},{"equalLines":{"line_count":212}},{"diffOp":{"equal":{"range":[240,268]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[6736,6799],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"`#### \" + ${metric.name}`, \"\"];\n  const detail = metric.detail;\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":178}},{"diffOp":{"equal":{"range":[77,150]}}},{"diffOp":{"delete":{"range":[150,151]}}},{"diffOp":{"insert":{"range":[151,152]}}},{"diffOp":{"equal":{"range":[152,157]}}},{"diffOp":{"delete":{"range":[157,161]}}},{"diffOp":{"insert":{"range":[161,163]}}},{"diffOp":{"equal":{"range":[163,174]}}},{"diffOp":{"insert":{"range":[174,176]}}},{"diffOp":{"equal":{"range":[176,215]}}},{"equalLines":{"line_count":205}},{"diffOp":{"equal":{"range":[215,243]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[6909,6930],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  const detail = metric.detail;\n\n  out.push(\n    \"`**\" + (${metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"}** ┬╖ n=metric.n +\n    (}${detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"}`,\n  );\n  out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":181}},{"diffOp":{"equal":{"range":[77,121]}}},{"diffOp":{"equal":{"range":[121,126]}}},{"diffOp":{"delete":{"range":[126,127]}}},{"diffOp":{"insert":{"range":[127,128]}}},{"diffOp":{"equal":{"range":[128,130]}}},{"diffOp":{"delete":{"range":[130,135]}}},{"diffOp":{"insert":{"range":[135,137]}}},{"diffOp":{"equal":{"range":[137,247]}}},{"diffOp":{"delete":{"range":[247,256]}}},{"diffOp":{"insert":{"range":[256,257]}}},{"diffOp":{"equal":{"range":[257,265]}}},{"diffOp":{"delete":{"range":[130,134]}}},{"diffOp":{"insert":{"range":[135,137]}}},{"diffOp":{"equal":{"range":[265,273]}}},{"diffOp":{"delete":{"range":[273,281]}}},{"diffOp":{"insert":{"range":[281,284]}}},{"diffOp":{"equal":{"range":[284,529]}}},{"diffOp":{"delete":{"range":[247,248]}}},{"diffOp":{"insert":{"range":[529,531]}}},{"diffOp":{"equal":{"range":[531,553]}}},{"equalLines":{"line_count":198}},{"diffOp":{"equal":{"range":[553,581]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[6986,7387],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? `${metric.value.toFixed(1) + \"} per 100 decisions\": metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":182}},{"diffOp":{"equal":{"range":[77,140]}}},{"diffOp":{"insert":{"range":[140,143]}}},{"diffOp":{"equal":{"range":[143,166]}}},{"diffOp":{"delete":{"range":[166,170]}}},{"diffOp":{"insert":{"range":[170,171]}}},{"diffOp":{"equal":{"range":[171,189]}}},{"diffOp":{"delete":{"range":[189,190]}}},{"diffOp":{"insert":{"range":[140,141]}}},{"diffOp":{"equal":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[190,352]}}},{"equalLines":{"line_count":201}},{"diffOp":{"equal":{"range":[352,380]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[7032,7078],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \"` ┬╖ P \" + ${detail.precision.toFixed(3)}+ \" / R detail.recall.toFixed(3) +\n      \" / F1 detail.f1.toFixed(3) + \" (TP detail.truePositives, FP detail.falsePositives, FN detail.falseNegatives)),\n  );\n  out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":184}},{"diffOp":{"equal":{"range":[77,259]}}},{"diffOp":{"delete":{"range":[259,260]}}},{"diffOp":{"insert":{"range":[260,261]}}},{"diffOp":{"equal":{"range":[261,267]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"insert":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[273,300]}}},{"diffOp":{"insert":{"range":[300,301]}}},{"diffOp":{"equal":{"range":[261,262]}}},{"diffOp":{"delete":{"range":[301,305]}}},{"diffOp":{"equal":{"range":[305,309]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"insert":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[309,333]}}},{"diffOp":{"delete":{"range":[333,343]}}},{"diffOp":{"insert":{"range":[300,301]}}},{"diffOp":{"equal":{"range":[343,349]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"insert":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[349,369]}}},{"diffOp":{"delete":{"range":[369,373]}}},{"diffOp":{"insert":{"range":[300,301]}}},{"diffOp":{"equal":{"range":[373,378]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"insert":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[378,398]}}},{"diffOp":{"delete":{"range":[369,373]}}},{"diffOp":{"insert":{"range":[300,301]}}},{"diffOp":{"equal":{"range":[398,403]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"insert":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[403,424]}}},{"diffOp":{"delete":{"range":[369,373]}}},{"diffOp":{"insert":{"range":[300,301]}}},{"diffOp":{"equal":{"range":[424,429]}}},{"diffOp":{"delete":{"range":[267,271]}}},{"diffOp":{"insert":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[429,450]}}},{"diffOp":{"delete":{"range":[369,373]}}},{"diffOp":{"insert":{"range":[300,301]}}},{"diffOp":{"equal":{"range":[450,451]}}},{"diffOp":{"delete":{"range":[267,268]}}},{"diffOp":{"insert":{"range":[260,261]}}},{"diffOp":{"equal":{"range":[451,474]}}},{"equalLines":{"line_count":198}},{"diffOp":{"equal":{"range":[474,502]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[7164,7386],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"`Comparator: \" + (${metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value)}`);\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":190}},{"diffOp":{"equal":{"range":[77,130]}}},{"diffOp":{"delete":{"range":[130,131]}}},{"diffOp":{"insert":{"range":[131,132]}}},{"diffOp":{"equal":{"range":[132,144]}}},{"diffOp":{"delete":{"range":[144,149]}}},{"diffOp":{"insert":{"range":[149,151]}}},{"diffOp":{"equal":{"range":[151,324]}}},{"diffOp":{"delete":{"range":[324,325]}}},{"diffOp":{"insert":{"range":[325,327]}}},{"diffOp":{"equal":{"range":[327,383]}}},{"equalLines":{"line_count":191}},{"diffOp":{"equal":{"range":[383,411]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[7463,7655],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : `${metric.comparator.source + \"} ΓÇö \" + ${metric.comparator.value}`));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":192}},{"diffOp":{"equal":{"range":[77,219]}}},{"diffOp":{"insert":{"range":[219,222]}}},{"diffOp":{"equal":{"range":[222,246]}}},{"diffOp":{"delete":{"range":[246,250]}}},{"diffOp":{"insert":{"range":[250,251]}}},{"diffOp":{"equal":{"range":[251,256]}}},{"diffOp":{"delete":{"range":[256,260]}}},{"diffOp":{"insert":{"range":[260,262]}}},{"diffOp":{"equal":{"range":[262,285]}}},{"diffOp":{"insert":{"range":[285,287]}}},{"diffOp":{"equal":{"range":[287,344]}}},{"equalLines":{"line_count":191}},{"diffOp":{"equal":{"range":[344,372]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[7594,7654],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"`> \" + ${metric.honestNote}`);\n  out.push(\"\");\n  return out;  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":194}},{"diffOp":{"equal":{"range":[77,174]}}},{"diffOp":{"delete":{"range":[174,175]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[176,178]}}},{"diffOp":{"delete":{"range":[178,182]}}},{"diffOp":{"insert":{"range":[182,184]}}},{"diffOp":{"equal":{"range":[184,201]}}},{"diffOp":{"insert":{"range":[201,203]}}},{"diffOp":{"equal":{"range":[203,235]}}},{"equalLines":{"line_count":189}},{"diffOp":{"equal":{"range":[235,263]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[7685,7709],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"`| \" + ${entry.transcript + \"} | entry.tpentry.fpentry.fn+ \" );\n  }\n  out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":205}},{"diffOp":{"equal":{"range":[77,188]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[190,192]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,198]}}},{"diffOp":{"equal":{"range":[198,214]}}},{"diffOp":{"delete":{"range":[214,218]}}},{"diffOp":{"insert":{"range":[218,219]}}},{"diffOp":{"equal":{"range":[219,222]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,198]}}},{"diffOp":{"equal":{"range":[222,230]}}},{"diffOp":{"delete":{"range":[214,218]}}},{"diffOp":{"insert":{"range":[218,219]}}},{"diffOp":{"equal":{"range":[219,222]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,198]}}},{"diffOp":{"equal":{"range":[230,238]}}},{"diffOp":{"delete":{"range":[214,216]}}},{"diffOp":{"insert":{"range":[218,219]}}},{"diffOp":{"equal":{"range":[214,215]}}},{"diffOp":{"delete":{"range":[192,194]}}},{"diffOp":{"equal":{"range":[190,192]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,198]}}},{"diffOp":{"equal":{"range":[238,246]}}},{"diffOp":{"insert":{"range":[218,219]}}},{"diffOp":{"equal":{"range":[214,215]}}},{"diffOp":{"delete":{"range":[246,250]}}},{"diffOp":{"equal":{"range":[190,191]}}},{"diffOp":{"delete":{"range":[188,189]}}},{"diffOp":{"insert":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[250,272]}}},{"equalLines":{"line_count":178}},{"diffOp":{"equal":{"range":[272,300]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[7997,8084],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"`Found the sentence, understood it as the wrong kind of decision (\" +\n      ${scored.extraction.variableErrors.length + \"}):,\n    );\n    out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":210}},{"diffOp":{"equal":{"range":[77,144]}}},{"diffOp":{"equal":{"range":[144,151]}}},{"diffOp":{"delete":{"range":[151,152]}}},{"diffOp":{"insert":{"range":[152,153]}}},{"diffOp":{"equal":{"range":[153,218]}}},{"diffOp":{"delete":{"range":[218,228]}}},{"diffOp":{"insert":{"range":[228,230]}}},{"diffOp":{"equal":{"range":[230,269]}}},{"diffOp":{"delete":{"range":[269,273]}}},{"diffOp":{"insert":{"range":[273,274]}}},{"diffOp":{"equal":{"range":[274,276]}}},{"diffOp":{"delete":{"range":[151,152]}}},{"diffOp":{"insert":{"range":[152,153]}}},{"diffOp":{"equal":{"range":[276,302]}}},{"equalLines":{"line_count":171}},{"diffOp":{"equal":{"range":[302,330]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[8181,8303],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"`- \\\" + ${entry.label.key + \"}\\` labelled entry.label.variable, extracted as entry.node.variable}`);\n    }\n    out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":216}},{"diffOp":{"equal":{"range":[77,183]}}},{"diffOp":{"delete":{"range":[183,184]}}},{"diffOp":{"insert":{"range":[184,185]}}},{"diffOp":{"equal":{"range":[185,187]}}},{"diffOp":{"insert":{"range":[187,188]}}},{"diffOp":{"equal":{"range":[184,185]}}},{"diffOp":{"delete":{"range":[188,192]}}},{"diffOp":{"insert":{"range":[192,194]}}},{"diffOp":{"equal":{"range":[194,209]}}},{"diffOp":{"delete":{"range":[209,213]}}},{"diffOp":{"insert":{"range":[213,215]}}},{"diffOp":{"equal":{"range":[215,226]}}},{"diffOp":{"delete":{"range":[188,192]}}},{"diffOp":{"insert":{"range":[192,194]}}},{"diffOp":{"equal":{"range":[226,246]}}},{"diffOp":{"delete":{"range":[209,213]}}},{"diffOp":{"insert":{"range":[213,214]}}},{"diffOp":{"equal":{"range":[246,261]}}},{"diffOp":{"delete":{"range":[188,192]}}},{"diffOp":{"insert":{"range":[192,194]}}},{"diffOp":{"equal":{"range":[261,280]}}},{"diffOp":{"insert":{"range":[280,282]}}},{"diffOp":{"equal":{"range":[282,308]}}},{"equalLines":{"line_count":167}},{"diffOp":{"equal":{"range":[308,336]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[8418,8522],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"`Premises matched on span but given the wrong predicate (\" + ${scored.premise.predicateErrors.length + \"}):);\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":222}},{"diffOp":{"equal":{"range":[77,142]}}},{"diffOp":{"delete":{"range":[142,143]}}},{"diffOp":{"insert":{"range":[143,144]}}},{"diffOp":{"equal":{"range":[144,200]}}},{"diffOp":{"delete":{"range":[200,204]}}},{"diffOp":{"insert":{"range":[204,206]}}},{"diffOp":{"equal":{"range":[206,243]}}},{"diffOp":{"delete":{"range":[243,247]}}},{"diffOp":{"insert":{"range":[247,248]}}},{"diffOp":{"equal":{"range":[248,250]}}},{"diffOp":{"delete":{"range":[142,143]}}},{"diffOp":{"insert":{"range":[143,144]}}},{"diffOp":{"equal":{"range":[250,341]}}},{"equalLines":{"line_count":161}},{"diffOp":{"equal":{"range":[341,369]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[8618,8723],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"`- \\\" + ${entry.label.key + \"}\\` labelled entry.label.predicate`, extracted as entry.node.predicate}\\`);\n    }\n    out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":225}},{"diffOp":{"equal":{"range":[77,181]}}},{"diffOp":{"delete":{"range":[181,182]}}},{"diffOp":{"insert":{"range":[182,183]}}},{"diffOp":{"equal":{"range":[183,185]}}},{"diffOp":{"insert":{"range":[185,186]}}},{"diffOp":{"equal":{"range":[182,183]}}},{"diffOp":{"delete":{"range":[186,190]}}},{"diffOp":{"insert":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[192,207]}}},{"diffOp":{"delete":{"range":[207,211]}}},{"diffOp":{"insert":{"range":[211,213]}}},{"diffOp":{"equal":{"range":[213,224]}}},{"diffOp":{"insert":{"range":[185,186]}}},{"diffOp":{"equal":{"range":[213,214]}}},{"diffOp":{"delete":{"range":[186,190]}}},{"diffOp":{"insert":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[224,245]}}},{"diffOp":{"delete":{"range":[207,211]}}},{"diffOp":{"insert":{"range":[211,213]}}},{"diffOp":{"equal":{"range":[245,261]}}},{"diffOp":{"insert":{"range":[185,186]}}},{"diffOp":{"equal":{"range":[213,214]}}},{"diffOp":{"delete":{"range":[186,190]}}},{"diffOp":{"insert":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[261,281]}}},{"diffOp":{"delete":{"range":[207,211]}}},{"diffOp":{"insert":{"range":[281,284]}}},{"diffOp":{"equal":{"range":[182,183]}}},{"diffOp":{"delete":{"range":[181,182]}}},{"diffOp":{"equal":{"range":[284,310]}}},{"equalLines":{"line_count":158}},{"diffOp":{"equal":{"range":[310,338]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[8830,8945],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"`Premise TYPE errors (\" + ${scored.premise.typeErrors.length + \"}) ΓÇö spans overlap but the types disagree.,\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":231}},{"diffOp":{"equal":{"range":[77,137]}}},{"diffOp":{"equal":{"range":[137,144]}}},{"diffOp":{"delete":{"range":[144,145]}}},{"diffOp":{"insert":{"range":[145,146]}}},{"diffOp":{"equal":{"range":[146,167]}}},{"diffOp":{"delete":{"range":[167,171]}}},{"diffOp":{"insert":{"range":[171,173]}}},{"diffOp":{"equal":{"range":[173,205]}}},{"diffOp":{"delete":{"range":[205,209]}}},{"diffOp":{"insert":{"range":[209,210]}}},{"diffOp":{"equal":{"range":[210,253]}}},{"diffOp":{"delete":{"range":[144,145]}}},{"diffOp":{"insert":{"range":[145,146]}}},{"diffOp":{"equal":{"range":[253,362]}}},{"equalLines":{"line_count":151}},{"diffOp":{"equal":{"range":[362,390]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[9043,9149],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"`- \\\" + ${entry.label.key + \"}\\` labelled entry.label.type, extracted as entry.node.type}`);\n    }\n    out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":237}},{"diffOp":{"equal":{"range":[77,176]}}},{"diffOp":{"delete":{"range":[176,177]}}},{"diffOp":{"insert":{"range":[177,178]}}},{"diffOp":{"equal":{"range":[178,180]}}},{"diffOp":{"insert":{"range":[180,181]}}},{"diffOp":{"equal":{"range":[177,178]}}},{"diffOp":{"delete":{"range":[181,185]}}},{"diffOp":{"insert":{"range":[185,187]}}},{"diffOp":{"equal":{"range":[187,202]}}},{"diffOp":{"delete":{"range":[202,206]}}},{"diffOp":{"insert":{"range":[206,208]}}},{"diffOp":{"equal":{"range":[208,219]}}},{"diffOp":{"delete":{"range":[181,185]}}},{"diffOp":{"insert":{"range":[185,187]}}},{"diffOp":{"equal":{"range":[219,235]}}},{"diffOp":{"delete":{"range":[202,206]}}},{"diffOp":{"insert":{"range":[206,207]}}},{"diffOp":{"equal":{"range":[235,250]}}},{"diffOp":{"delete":{"range":[181,185]}}},{"diffOp":{"insert":{"range":[185,187]}}},{"diffOp":{"equal":{"range":[250,265]}}},{"diffOp":{"insert":{"range":[265,267]}}},{"diffOp":{"equal":{"range":[267,293]}}},{"equalLines":{"line_count":146}},{"diffOp":{"equal":{"range":[293,321]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[9358,9454],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"`**Statements that should not have become nodes, and did** (\" + ${scored.modality.wronglyPromoted.length + \"}):);\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":243}},{"diffOp":{"equal":{"range":[77,143]}}},{"diffOp":{"delete":{"range":[143,144]}}},{"diffOp":{"insert":{"range":[144,145]}}},{"diffOp":{"equal":{"range":[145,204]}}},{"diffOp":{"delete":{"range":[204,208]}}},{"diffOp":{"insert":{"range":[208,210]}}},{"diffOp":{"equal":{"range":[210,248]}}},{"diffOp":{"delete":{"range":[248,252]}}},{"diffOp":{"insert":{"range":[252,253]}}},{"diffOp":{"equal":{"range":[253,255]}}},{"diffOp":{"delete":{"range":[143,144]}}},{"diffOp":{"insert":{"range":[144,145]}}},{"diffOp":{"equal":{"range":[255,334]}}},{"equalLines":{"line_count":140}},{"diffOp":{"equal":{"range":[334,362]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[9551,9660],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"`- \\\" + ${entry.label.key + \"}\\` (entry.label.modality) ΓåÆ entry.node.id}`);\n    }\n    out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":246}},{"diffOp":{"equal":{"range":[77,169]}}},{"diffOp":{"delete":{"range":[169,170]}}},{"diffOp":{"insert":{"range":[170,171]}}},{"diffOp":{"equal":{"range":[171,173]}}},{"diffOp":{"insert":{"range":[173,174]}}},{"diffOp":{"equal":{"range":[170,171]}}},{"diffOp":{"delete":{"range":[174,178]}}},{"diffOp":{"insert":{"range":[178,180]}}},{"diffOp":{"equal":{"range":[180,195]}}},{"diffOp":{"delete":{"range":[195,199]}}},{"diffOp":{"insert":{"range":[199,201]}}},{"diffOp":{"equal":{"range":[201,204]}}},{"diffOp":{"delete":{"range":[174,178]}}},{"diffOp":{"insert":{"range":[178,180]}}},{"diffOp":{"equal":{"range":[204,224]}}},{"diffOp":{"delete":{"range":[195,199]}}},{"diffOp":{"insert":{"range":[199,200]}}},{"diffOp":{"equal":{"range":[224,230]}}},{"diffOp":{"delete":{"range":[174,178]}}},{"diffOp":{"insert":{"range":[178,180]}}},{"diffOp":{"equal":{"range":[230,243]}}},{"diffOp":{"insert":{"range":[243,245]}}},{"diffOp":{"equal":{"range":[245,271]}}},{"equalLines":{"line_count":137}},{"diffOp":{"equal":{"range":[271,299]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[9755,9836],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  }\n\n  out.push(\"`Alternative FP:FN ratio ΓÇö \" + ${scored.alternative.fpToFnRatio + \"} (ARGUS published 13:1).);\n  out.push(\"\");\n  return out;  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":251}},{"diffOp":{"equal":{"range":[77,93]}}},{"diffOp":{"delete":{"range":[93,94]}}},{"diffOp":{"insert":{"range":[94,95]}}},{"diffOp":{"equal":{"range":[95,123]}}},{"diffOp":{"delete":{"range":[123,127]}}},{"diffOp":{"insert":{"range":[127,129]}}},{"diffOp":{"equal":{"range":[129,159]}}},{"diffOp":{"delete":{"range":[159,163]}}},{"diffOp":{"insert":{"range":[163,164]}}},{"diffOp":{"equal":{"range":[164,188]}}},{"diffOp":{"delete":{"range":[123,124]}}},{"diffOp":{"insert":{"range":[94,95]}}},{"diffOp":{"equal":{"range":[188,220]}}},{"equalLines":{"line_count":132}},{"diffOp":{"equal":{"range":[220,248]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[9879,9971],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"`| \"+ ${entry.plant + \"} | \" + (entry.testable ? \"yes\" : \"NO\") + entry.expectedFlips.length\" +\n      entry.flipped.lengthentry.missedFlips.lengthentry.survived.lengthentry.overRetracted.lengthentry.correct ? \"Γ£ô\" : \"Γ£ù\")+ \" ,\n    );\n  }  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":262}},{"diffOp":{"equal":{"range":[77,204]}}},{"diffOp":{"equal":{"range":[204,211]}}},{"diffOp":{"delete":{"range":[211,212]}}},{"diffOp":{"insert":{"range":[212,213]}}},{"diffOp":{"equal":{"range":[213,214]}}},{"diffOp":{"delete":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[77,78]}}},{"diffOp":{"delete":{"range":[216,218]}}},{"diffOp":{"insert":{"range":[218,220]}}},{"diffOp":{"equal":{"range":[220,231]}}},{"diffOp":{"delete":{"range":[231,235]}}},{"diffOp":{"insert":{"range":[235,236]}}},{"diffOp":{"equal":{"range":[236,239]}}},{"diffOp":{"delete":{"range":[239,244]}}},{"diffOp":{"insert":{"ra