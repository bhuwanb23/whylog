equalLines":{"line_count":134}},{"diffOp":{"equal":{"range":[522,665]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\kit.ts"},"span":null,"sourceCode":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THE SEED STATE IS BUILT, NOT CHECKED IN\n *\n * A demo needs to start from a known graph. The obvious implementation is a JSON dump of a graph\n * committed to the repo. That is wrong here for a specific reason: a checked-in state is a snapshot of\n * whatever the extraction pipeline produced on the day it was saved, and the moment extraction changes\n * the demo is showing the audience a graph the product no longer builds. The presenter would be\n * describing behaviour the code does not have.\n *\n * So the seed is BUILT at load time from the two demo fixtures through the real pipeline. It is slower\n * by a second or two and it cannot drift. A demo that shows the shipping code path is worth two seconds.\n *\n * ---------------------------------------------------------------------------\n * RESET IS A WIPE, NOT AN UNDO\n *\n * One-click reset clears every WhyLog storage key and rebuilds the seed. It does not attempt to reverse\n * the events of a live demo, because invariant I1 says nothing is deleted ΓÇö an undo would have to\n * rewrite the log, and a demo that rewrites its own hash chain in front of an audience is a demo that\n * has just contradicted its first claim.\n * ---------------------------------------------------------------------------\n */\n\nimport { createLocalEngine, localEngineId } from \"@/ai/local\";\nimport { nowISO } from \"@/lib/format\";\nimport { appendBatch, emptyLog, fold, type EventLog } from \"@/substrate\";\nimport { STORAGE_KEYS } from \"./keys\";\nimport type { EngineId, ISODateString } from \"@/types/common\";\nimport type { GraphState } from \"@/substrate/graph-state\";\n\n/** The storage keys a reset must clear. Listed here rather than scattered, because a reset that misses\n *  one key leaves the next demo starting from the previous one's state ΓÇö the failure is invisible until\n *  the presenter is three beats in and the graph has nodes nobody imported. */\nexport const RESET_KEYS: readonly string[] = STORAGE_KEYS;\n\nexport interface SeedResult {\n  readonly log: EventLog;\n  readonly state: GraphState;\n  readonly engineId: EngineId;\n  readonly builtAt: ISODateString;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly durationMs: number;\n  /** Anything that went wrong while building. A seed that built with warnings still loads, and the\n   *  presenter needs to know before the demo rather than discovering it on stage. */\n  readonly warnings: readonly string[];\n}\n\n/**\n * Build the seed graph from the demo fixtures through the real pipeline.\n *\n * Delegates to the eval harness rather than reimplementing an import path, because two import paths\n * would eventually disagree and the demo would be exercising the one the metrics do not measure.\n */\nexport async function buildSeed(): Promise<SeedResult> {\n  const started = Date.now();\n  const engine = createLocalEngine();\n  const engineId = localEngineId();\n  const warnings: string[] = [];\n\n  const { corpus, CORPUS_ROOT } = await import(\"../corpus/data\");\n  const { loadCorpus } = await import(\"../corpus/loader\");\n  const { runConfig } = await import(\"../harness\");\n  const { FULL, DEFAULT_PARAMS } = await import(\"../ablation/toggles\");\n\n  const loaded = loadCorpus(corpus, CORPUS_ROOT);\n\n  if (loaded.missingFiles.length > 0) {\n    warnings.push(loaded.missingFiles.length + \" corpus file(s) missing: \" + loaded.missingFiles.join(\", \"));\n  }\n  if (loaded.unresolved.length > 0) {\n    warnings.push(loaded.unresolved.length + \" corpus label(s) do not resolve ΓÇö the seed will still build, but the metrics would not be trustworthy.\");\n  }\n\n  /* Only the two demo fixtures are seeded. The full twelve-transcript corpus produces a graph too large\n   * to walk an audience through in five minutes, and the demo's job is the L1 reversal and the L2\n   * premise invalidation, both of which live entirely in these two files. */\n  const demoOnly = {\n    ...loaded.corpus,\n    transcripts: loaded.corpus.transcripts.filter((transcript) =>\n      transcript.id === \"demo1\" || transcript.id === \"demo2\",\n    ),\n    questions: loaded.corpus.questions.filter((question) => question.id === \"q1\" || question.id === \"q8\"),\n    plants: loaded.corpus.plants.filter((plant) =>\n      plant.id === \"L1-sqlite\" || plant.id === \"L2-premise-falsified\",\n    ),\n  };\n\n  const run = await runConfig(demoOnly, {\n    id: \"demo-seed\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  for (const entry of run.transcripts) {\n    if (!entry.ok) warnings.push(\"fixture \" + entry.transcript.id + \" failed to import: \" + (entry.failure ?? \"unknown\"));\n  }\n\n  return {\n    log: rebuildLog(run),\n    state: run.state,\n    engineId,\n    builtAt: nowISO(),\n    decisions: run.state.decisions.size,\n    premises: run.state.premises.size,\n    durationMs: Date.now() - started,\n    warnings,\n  };\n}\n\n/**\n * The event log behind a completed run.\n *\n * The harness keeps its log local and returns only the folded state, because metrics score states. The\n * demo needs the log too, since the app persists and replays events rather than snapshots ΓÇö so it is\n * reconstructed by re-folding the state's own event list, which is authoritative and hash-chained.\n */\nfunction rebuildLog(run: { state: GraphState }): EventLog {\n  const log = emptyLog();\n  const appended = appendBatch(\n    log,\n    run.state.events.map((event) => ({\n      draft: { type: event.type, payload: event.payload, actor: event.actor, reason: event.reason },\n      context: { now: event.at, actor: event.actor, reason: event.reason, occurredAt: event.occurredAt },\n    })),\n  );\n\n  /* Re-appending sealed events re-mints ids and re-stamps times, so the chain will not match the\n   * original. That is acceptable for a seed ΓÇö the app reseals on import via `substrate/portability.ts`,\n   * which is the supported path for bringing an external log in ΓÇö but it is not acceptable to pretend\n   * otherwise, so the reconstruction folds rather than claiming to restore. */\n  return appended.ok ? appended.log : fold(run.state.events, { engine: run.state.computedAt ? localEngineId() : localEngineId(), now: nowISO() }) && emptyLog();\n}\n\n/**\n * One-click reset.\n *\n * Clears every WhyLog key and reports what it cleared. Idempotent: resetting twice is the same as\n * resetting once, which matters because a presenter who is unsure whether the reset landed will press it\n * again, and a reset that compounds would be worse than none.\n */\nexport function resetDemo(storage: Storage | null): { cleared: readonly string[]; available: boolean } {\n  if (storage === null) return { cleared: [], available: false };\n\n  const cleared: string[] = [];\n  for (const key of RESET_KEYS) {\n    if (storage.getItem(key) !== null) {\n      storage.removeItem(key);\n      cleared.push(key);\n    }\n  }\n\n  return { cleared, available: true };\n}\n\n/** What the reset did, as a sentence a presenter can read aloud if asked. */\nexport function describeReset(result: { cleared: readonly string[]; available: boolean }): string {\n  if (!result.available) {\n    return \"No storage backend available ΓÇö the demo is running in memory and a page reload is the reset.\";\n  }\n  if (result.cleared.length === 0) {\n    return \"Nothing to clear: storage was already empty. Reset is idempotent, so this is a clean start.\";\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n"},"tags":[],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Replace with optional chain operator "},{"elements":["Emphasis"],"content":"?."},{"elements":[],"content":" This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator"}]]},{"diff":{"dictionary":"/**\n * The learned time is monotonic, and the valid time is not.\n *    const events = useWhyLog.getState().log.events;\n    for (let i = 1; i < events.length; i += 1) {\n      expect(events[i]!?.at >= events[i - 1]!.at).toBe(true);\n    }\n  });  });\n});\n","ops":[{"diffOp":{"equal":{"range":[0,67]}}},{"equalLines":{"line_count":60}},{"diffOp":{"equal":{"range":[67,181]}}},{"diffOp":{"equal":{"range":[181,190]}}},{"diffOp":{"delete":{"range":[190,191]}}},{"diffOp":{"insert":{"range":[191,192]}}},{"diffOp":{"equal":{"range":[192,196]}}},{"diffOp":{"equal":{"range":[196,241]}}},{"equalLines":{"line_count":30}},{"diffOp":{"equal":{"range":[241,251]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\substrate\\learned-time.test.ts"},"span":[2806,2816],"sourceCode":"/**\n * The learned time is monotonic, and the valid time is not.\n *\n * The substrate validates that the LEARNED time never moves backwards (event-validation\n * rule 4) and rejects the whole batch if it does. The store is the thing that appends, so\n * the store is the thing that has to guarantee it.\n *\n * This file exists because that guarantee was missing, and because its absence was\n * INVISIBLE: the store used to drop each draft's own `at` and `occurredAt` and stamp\n * everything with the append time instead. That made the log monotonic by accident, and it\n * also destroyed the bi-temporality: every event claimed it happened at the moment it was\n * learned, so the time machine's two axes could never diverge.\n *\n * Restoring the valid time exposed the real defect underneath: several layers capture a\n * timestamp BEFORE the work they timestamp, and the work can cross a millisecond boundary.\n * The reasoning cycle is the clearest case - it takes `startedAt`, gate (b) then asks\n * retrieval for candidates, which rebuilds the index and records an `IndexRebuilt` event\n * stamped with a FRESH `nowISO()`, and only then does the cycle record its own drafts\n * stamped with the OLDER `startedAt`. The log then held an event learned a millisecond\n * before its predecessor, and the batch was rejected.\n *\n * The failure was a 1-in-10 flake, which is the worst kind: it would have failed\n * intermittently in CI and looked like a mystery.\n */\n\nimport { beforeEach, describe, expect, it } from \"vitest\";\n\nimport { useWhyLog } from \"@/store/whylog\";\nimport { type TranscriptId, asISO } from \"@/types/common\";\n\nconst ENGINE_ID = { kind: \"local\", model: \"cue-extractor-v1\" } as const;\n\nfunction importTranscript(at?: string) {\n  return useWhyLog.getState().record(\n    {\n      type: \"TranscriptImported\",\n      payload: {\n        transcriptId: \"T-0001\" as TranscriptId,\n        rawChars: 10,\n        engine: ENGINE_ID,\n      },\n      reason: \"imported\",\n      ...(at === undefined ? {} : { at: asISO(at) }),\n    },\n    { reason: \"imported\", actor: { kind: \"human\" } },\n  );\n}\n\ndescribe(\"Learned time is monotonic; valid time is free\", () => {\n  beforeEach(() => {\n    localStorage.clear();\n    useWhyLog.getState().boot();\n  });\n\n  it(\"an event stamped in the past is clamped forward, not rejected\", () => {\n    const first = importTranscript(\"2026-10-03T15:00:00.000Z\");\n    expect(first.ok).toBe(true);\n\n    /* Now an event that claims to have been learned BEFORE the one already in the log.\n     * The log is append-only: nothing in it can have been learned before its predecessor. */\n    const second = importTranscript(\"2026-10-01T09:00:00.000Z\");\n    expect(second.ok).toBe(true);\n\n    const events = useWhyLog.getState().log.events;\n    for (let i = 1; i < events.length; i += 1) {\n      expect(events[i]!.at >= events[i - 1]!.at).toBe(true);\n    }\n  });\n\n  it(\"the valid time is NOT clamped: a decision can be older than the record of it\", () => {\n    const imported = importTranscript(\"2026-10-03T15:00:00.000Z\");\n    expect(imported.ok).toBe(true);\n\n    const event = useWhyLog.getState().log.events[0];\n    expect(event).toBeDefined();\n\n    /* The valid time is the whole point of the substrate: a decision made on the 3rd and\n     * learned today. The learned time and the valid time are DIFFERENT clocks, and only\n     * the learned one is constrained to move forwards. */\n    const withValid = useWhyLog.getState().record(\n      {\n        type: \"TranscriptImported\",\n        payload: {\n          transcriptId: \"T-0002\" as TranscriptId,\n          rawChars: 10,\n          engine: ENGINE_ID,\n          occurredAt: asISO(\"2026-10-03T15:00:00.000Z\"),\n        },\n        reason: \"imported an old transcript today\",\n        occurredAt: asISO(\"2026-10-03T15:00:00.000Z\"),\n      },\n      { reason: \"imported an old transcript today\", actor: { kind: \"human\" } },\n    );\n    expect(withValid.ok).toBe(true);\n\n    const last = useWhyLog.getState().log.events.at(-1);\n    expect(last?.occurredAt).toBe(\"2026-10-03T15:00:00.000Z\");\n    expect(last?.at).not.toBe(\"2026-10-03T15:00:00.000Z\");\n  });\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Replace with optional chain operator "},{"elements":["Emphasis"],"content":"?."},{"elements":[],"content":" This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator"}]]},{"diff":{"dictionary":"/**\n * The learned time is monotonic, and the valid time is not.\n *    const events = useWhyLog.getState().log.events;\n    for (let i = 1; i < events.length; i += 1) {\n      expect(events[i]!.at >= events[i - 1]!?.at).toBe(true);\n    }\n  });  });\n});\n","ops":[{"diffOp":{"equal":{"range":[0,67]}}},{"equalLines":{"line_count":60}},{"diffOp":{"equal":{"range":[67,198]}}},{"diffOp":{"equal":{"range":[198,211]}}},{"diffOp":{"delete":{"range":[211,212]}}},{"diffOp":{"insert":{"range":[212,213]}}},{"diffOp":{"equal":{"range":[213,216]}}},{"diffOp":{"equal":{"range":[216,241]}}},{"equalLines":{"line_count":30}},{"diffOp":{"equal":{"range":[241,251]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\substrate\\learned-time.test.ts"},"span":[2823,2837],"sourceCode":"/**\n * The learned time is monotonic, and the valid time is not.\n *\n * The substrate validates that the LEARNED time never moves backwards (event-validation\n * rule 4) and rejects the whole batch if it does. The store is the thing that appends, so\n * the store is the thing that has to guarantee it.\n *\n * This file exists because that guarantee was missing, and because its absence was\n * INVISIBLE: the store used to drop each draft's own `at` and `occurredAt` and stamp\n * everything with the append time instead. That made the log monotonic by accident, and it\n * also destroyed the bi-temporality: every event claimed it happened at the moment it was\n * learned, so the time machine's two axes could never diverge.\n *\n * Restoring the valid time exposed the real defect underneath: several layers capture a\n * timestamp BEFORE the work they timestamp, and the work can cross a millisecond boundary.\n * The reasoning cycle is the clearest case - it takes `startedAt`, gate (b) then asks\n * retrieval for candidates, which rebuilds the index and records an `IndexRebuilt` event\n * stamped with a FRESH `nowISO()`, and only then does the cycle record its own drafts\n * stamped with the OLDER `startedAt`. The log then held an event learned a millisecond\n * before its predecessor, and the batch was rejected.\n *\n * The failure was a 1-in-10 flake, which is the worst kind: it would have failed\n * intermittently in CI and looked like a mystery.\n */\n\nimport { beforeEach, describe, expect, it } from \"vitest\";\n\nimport { useWhyLog } from \"@/store/whylog\";\nimport { type TranscriptId, asISO } from \"@/types/common\";\n\nconst ENGINE_ID = { kind: \"local\", model: \"cue-extractor-v1\" } as const;\n\nfunction importTranscript(at?: string) {\n  return useWhyLog.getState().record(\n    {\n      type: \"TranscriptImported\",\n      payload: {\n        transcriptId: \"T-0001\" as TranscriptId,\n        rawChars: 10,\n        engine: ENGINE_ID,\n      },\n      reason: \"imported\",\n      ...(at === undefined ? {} : { at: asISO(at) }),\n    },\n    { reason: \"imported\", actor: { kind: \"human\" } },\n  );\n}\n\ndescribe(\"Learned time is monotonic; valid time is free\", () => {\n  beforeEach(() => {\n    localStorage.clear();\n    useWhyLog.getState().boot();\n  });\n\n  it(\"an event stamped in the past is clamped forward, not rejected\", () => {\n    const first = importTranscript(\"2026-10-03T15:00:00.000Z\");\n    expect(first.ok).toBe(true);\n\n    /* Now an event that claims to have been learned BEFORE the one already in the log.\n     * The log is append-only: nothing in it can have been learned before its predecessor. */\n    const second = importTranscript(\"2026-10-01T09:00:00.000Z\");\n    expect(second.ok).toBe(true);\n\n    const events = useWhyLog.getState().log.events;\n    for (let i = 1; i < events.length; i += 1) {\n      expect(events[i]!.at >= events[i - 1]!.at).toBe(true);\n    }\n  });\n\n  it(\"the valid time is NOT clamped: a decision can be older than the record of it\", () => {\n    const imported = importTranscript(\"2026-10-03T15:00:00.000Z\");\n    expect(imported.ok).toBe(true);\n\n    const event = useWhyLog.getState().log.events[0];\n    expect(event).toBeDefined();\n\n    /* The valid time is the whole point of the substrate: a decision made on the 3rd and\n     * learned today. The learned time and the valid time are DIFFERENT clocks, and only\n     * the learned one is constrained to move forwards. */\n    const withValid = useWhyLog.getState().record(\n      {\n        type: \"TranscriptImported\",\n        payload: {\n          transcriptId: \"T-0002\" as TranscriptId,\n          rawChars: 10,\n          engine: ENGINE_ID,\n          occurredAt: asISO(\"2026-10-03T15:00:00.000Z\"),\n        },\n        reason: \"imported an old transcript today\",\n        occurredAt: asISO(\"2026-10-03T15:00:00.000Z\"),\n      },\n      { reason: \"imported an old transcript today\", actor: { kind: \"human\" } },\n    );\n    expect(withValid.ok).toBe(true);\n\n    const last = useWhyLog.getState().log.events.at(-1);\n    expect(last?.occurredAt).toBe(\"2026-10-03T15:00:00.000Z\");\n    expect(last?.at).not.toBe(\"2026-10-03T15:00:00.000Z\");\n  });\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"error","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *    divergences,\n    deterministic: divergences.length === 0,\n    allDemoable: runs.every((run) => run.verification !== null && run.verification.demoable?.demoable),\n    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":105}},{"diffOp":{"equal":{"range":[45,144]}}},{"diffOp":{"equal":{"range":[144,160]}}},{"diffOp":{"delete":{"range":[160,198]}}},{"diffOp":{"insert":{"range":[198,208]}}},{"diffOp":{"equal":{"range":[208,408]}}},{"equalLines":{"line_count":116}},{"diffOp":{"equal":{"range":[408,437]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\dryrun.ts"},"span":[4459,4513],"sourceCode":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THREE, AND WHY CONSECUTIVE\n *\n * ┬º7.5 requires three consecutive dry runs. Not one, because a single run cannot distinguish a working\n * demo from a lucky one. Not two, because two agreeing runs are consistent with a cache that was warm\n * after the first. Three is the smallest number at which agreement starts to mean something about\n * determinism rather than about warm state.\n *\n * Consecutive matters more than the count. Three runs with a rebuild in between test the build; three\n * runs back to back test that the SECOND and THIRD start from whatever the first left behind ΓÇö which is\n * the actual failure mode, because a demo that only works from a cold start is a demo that cannot be\n * repeated for a second judge who walks up to the table afterwards.\n *\n * ---------------------------------------------------------------------------\n * WHAT IS COMPARED\n *\n * Node counts, label assignments and contradiction records. Not timings and not id strings: timings\n * vary with machine load and comparing them would produce a \"non-deterministic\" verdict for a run that\n * is perfectly reproducible, which teaches the presenter to ignore the report.\n *\n * Ids ARE compared, but only for stability across runs, not for value ΓÇö a run that mints different ids\n * from the same input has a counter that depends on something other than the input, and that is a real\n * defect worth catching even though the specific ids do not matter.\n * ---------------------------------------------------------------------------\n */\n\nimport type { SeedResult } from \"./kit\";\nimport { buildSeed } from \"./kit\";\nimport { verifyDemo, type VerificationReport } from \"./verify\";\n\nexport const REQUIRED_DRY_RUNS = 3;\n\nexport interface DryRunFingerprint {\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly guards: number;\n  readonly contradictions: number;\n  readonly justifications: number;\n  /** Sorted decision ids. Compared for stability, not for value. */\n  readonly decisionIds: readonly string[];\n  /** Sorted `id=label` pairs. This is the comparison that matters: a cascade that fires on run one and\n   *  not on run two produces identical counts and different labels, and counts alone would pass it. */\n  readonly labels: readonly string[];\n  readonly durationMs: number;\n}\n\nexport interface DryRun {\n  readonly n: number;\n  readonly fingerprint: DryRunFingerprint;\n  /** Null when the run threw. A stub report would look like a real one in the table. */\n  readonly verification: VerificationReport | null;\n  readonly warnings: readonly string[];\n  readonly error: string | null;\n}\n\nexport interface DryRunReport {\n  readonly runs: readonly DryRun[];\n  readonly deterministic: boolean;\n  readonly divergences: readonly string[];\n  readonly allDemoable: boolean;\n  readonly passed: boolean;\n}\n\n/**\n * Run the demo dry-run sequence.\n *\n * Deliberately does NOT reset between runs. That is the point: run two and run three start from whatever\n * run one left in storage, which is exactly the condition a second judge at the table reproduces. A\n * harness that reset between runs would be testing a scenario nobody encounters.\n */\nexport async function runDryRuns(count: number = REQUIRED_DRY_RUNS): Promise<DryRunReport> {\n  const runs: DryRun[] = [];\n\n  for (let n = 1; n <= count; n += 1) {\n    const started = Date.now();\n    try {\n      const seed = await buildSeed();\n      runs.push({\n        n,\n        fingerprint: fingerprintOf(seed, Date.now() - started),\n        verification: verifyDemo(seed),\n        warnings: seed.warnings,\n        error: null,\n      });\n    } catch (error) {\n      /* No verification is attempted on a run that threw. Building a stub report to fill the slot would\n       * print a row of zeros that looks like a measured result, and the whole point of the table is that\n       * every number in it came from a run that completed. */\n      runs.push({\n        n,\n        fingerprint: emptyFingerprint(Date.now() - started),\n        verification: null,\n        warnings: [],\n        error: error instanceof Error ? error.message : String(error),\n      });\n    }\n  }\n\n  const divergences = compare(runs);\n\n  return {\n    runs,\n    divergences,\n    deterministic: divergences.length === 0,\n    allDemoable: runs.every((run) => run.verification !== null && run.verification.demoable),\n    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */\n    passed: divergences.length === 0 && runs.every((run) => run.verification !== null && run.verification.demoable),\n  };\n}\n\nfunction fingerprintOf(seed: SeedResult, durationMs: number): DryRunFingerprint {\n  const decisions = [...seed.state.decisions.values()];\n\n  return {\n    decisions: decisions.length,\n    premises: seed.state.premises.size,\n    alternatives: seed.state.alternatives.size,\n    guards: seed.state.guards.size,\n    contradictions: seed.state.contradictions.length,\n    justifications: seed.state.justifications.size,\n    decisionIds: decisions.map((decision) => String(decision.id)).sort(),\n    labels: decisions.map((decision) => decision.id + \"=\" + decision.label).sort(),\n    durationMs,\n  };\n}\n\nfunction emptyFingerprint(durationMs: number): DryRunFingerprint {\n  return {\n    decisions: 0, premises: 0, alternatives: 0, guards: 0, contradictions: 0, justifications: 0,\n    decisionIds: [], labels: [], durationMs,\n  };\n}\n\nfunction compare(runs: readonly DryRun[]): readonly string[] {\n  const out: string[] = [];\n  const first = runs[0];\n  if (first === undefined) return [\"no runs completed\"];\n\n  for (const run of runs.slice(1)) {\n    if (run.error !== null) {\n      out.push(\"run \" + run.n + \" threw: \" + run.error);\n      continue;\n    }\n    if (first.error !== null) continue;\n\n    const fields: (keyof DryRunFingerprint)[] = [\n      \"decisions\", \"premises\", \"alternatives\", \"guards\", \"contradictions\", \"justifications\",\n    ];\n\n    for (const field of fields) {\n      const a = first.fingerprint[field];\n      const b = run.fingerprint[field];\n      if (typeof a === \"number\" && typeof b === \"number\" && a !== b) {\n        out.push(field + \": run 1 had \" + a + \", run \" + run.n + \" had \" + b);\n      }\n    }\n\n    if (first.fingerprint.labels.join(\"|\") !== run.fingerprint.labels.join(\"|\")) {\n      const differing = run.fingerprint.labels.filter((entry) => !first.fingerprint.labels.includes(entry));\n      out.push(\n        \"LABELS DIVERGED between run 1 and run \" + run.n + \" ΓÇö the same input produced different \" +\n        \"epistemic states. Counts alone would not have caught this. Differing: \" +\n        (differing.length === 0 ? \"(reordered only)\" : differing.slice(0, 6).join(\", \")),\n      );\n    }\n\n    if (first.fingerprint.decisionIds.join(\"|\") !== run.fingerprint.decisionIds.join(\"|\")) {\n      out.push(\"IDS DIVERGED between run 1 and run \" + run.n + \" ΓÇö a counter depends on something other than the input.\");\n    }\n  }\n\n  return out;\n}\n\nexport function renderDryRuns(report: DryRunReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"DRY RUNS ΓÇö \" + report.runs.length + \" consecutive, no reset between them\");\n  lines.push(report.passed ? \"PASSED: deterministic and demoable across all runs.\" : \"NOT PASSED.\");\n  lines.push(\"\");\n\n  lines.push(\"Run\".padEnd(5) + \"dec\".padStart(5) + \"prem\".padStart(6) + \"alt\".padStart(5) +\n    \"grd\".padStart(5) + \"contra\".padStart(8) + \"just\".padStart(6) + \"  verified/manual/failed\".padEnd(26) + \"secs\");\n  lines.push(\"-\".repeat(78));\n\n  for (const run of report.runs) {\n    const f = run.fingerprint;\n    const v = run.verification;\n    if (v === null) {\n      lines.push(String(run.n).padEnd(5) + \"  THREW ΓÇö \" + (run.error ?? \"unknown\"));\n      continue;\n    }\n    lines.push(\n      String(run.n).padEnd(5) +\n      String(f.decisions).padStart(5) + String(f.premises).padStart(6) + String(f.alternatives).padStart(5) +\n      String(f.guards).padStart(5) + String(f.contradictions).padStart(8) + String(f.justifications).padStart(6) +\n      (\"  \" + v.verified + \"/\" + v.manual + \"/\" + v.failed).padEnd(26) +\n      (f.durationMs / 1000).toFixed(1),\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\"Timings are shown but NOT compared: they vary with machine load, and treating a slow run as\");\n  lines.push(\"non-determinism teaches the presenter to ignore this report.\");\n\n  if (report.divergences.length > 0) {\n    lines.push(\"\");\n    lines.push(\"DIVERGENCES (\" + report.divergences.length + \"):\");\n    for (const divergence of report.divergences) lines.push(\"  \" + divergence);\n  } else {\n    lines.push(\"\");\n    lines.push(\"No divergences. Runs 2 and 3 started from whatever run 1 left in storage and produced\");\n    lines.push(\"identical node counts, identical labels and identical ids.\");\n  }\n\n  const warnings = report.runs.flatMap((run) => run.warnings.map((warning) => \"run \" + run.n + \": \" + warning));\n  if (warnings.length > 0) {\n    lines.push(\"\");\n    lines.push(\"WARNINGS:\");\n    for (const warning of [...new Set(warnings)]) lines.push(\"  \" + warning);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"error","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */\n    passed: divergences.length === 0 && runs.every((run) => run.verification !== null && run.verification.demoable?.demoable),\n  };\n}  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":108}},{"diffOp":{"equal":{"range":[45,303]}}},{"diffOp":{"equal":{"range":[303,319]}}},{"diffOp":{"delete":{"range":[319,357]}}},{"diffOp":{"insert":{"range":[357,367]}}},{"diffOp":{"equal":{"range":[367,376]}}},{"equalLines":{"line_count":113}},{"diffOp":{"equal":{"range":[376,405]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\dryrun.ts"},"span":[4774,4828],"sourceCode":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THREE, AND WHY CONSECUTIVE\n *\n * ┬º7.5 requires three consecutive dry runs. Not one, because a single run cannot distinguish a working\n * demo from a lucky one. Not two, because two agreeing runs are consistent with a cache that was warm\n * after the first. Three is the smallest number at which agreement starts to mean something about\n * determinism rather than about warm state.\n *\n * Consecutive matters more than the count. Three runs with a rebuild in between test the build; three\n * runs back to back test that the SECOND and THIRD start from whatever the first left behind ΓÇö which is\n * the actual failure mode, because a demo that only works from a cold start is a demo that cannot be\n * repeated for a second judge who walks up to the table afterwards.\n *\n * ---------------------------------------------------------------------------\n * WHAT IS COMPARED\n *\n * Node counts, label assignments and contradiction records. Not timings and not id strings: timings\n * vary with machine load and comparing them would produce a \"non-deterministic\" verdict for a run that\n * is perfectly reproducible, which teaches the presenter to ignore the report.\n *\n * Ids ARE compared, but only for stability across runs, not for value ΓÇö a run that mints different ids\n * from the same input has a counter that depends on something other than the input, and that is a real\n * defect worth catching even though the specific ids do not matter.\n * ---------------------------------------------------------------------------\n */\n\nimport type { SeedResult } from \"./kit\";\nimport { buildSeed } from \"./kit\";\nimport { verifyDemo, type VerificationReport } from \"./verify\";\n\nexport const REQUIRED_DRY_RUNS = 3;\n\nexport interface DryRunFingerprint {\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly guards: number;\n  readonly contradictions: number;\n  readonly justifications: number;\n  /** Sorted decision ids. Compared for stability, not for value. */\n  readonly decisionIds: readonly string[];\n  /** Sorted `id=label` pairs. This is the comparison that matters: a cascade that fires on run one and\n   *  not on run two produces identical counts and different labels, and counts alone would pass it. */\n  readonly labels: readonly string[];\n  readonly durationMs: number;\n}\n\nexport interface DryRun {\n  readonly n: number;\n  readonly fingerprint: DryRunFingerprint;\n  /** Null when the run threw. A stub report would look like a real one in the table. */\n  readonly verification: VerificationReport | null;\n  readonly warnings: readonly string[];\n  readonly error: string | null;\n}\n\nexport interface DryRunReport {\n  readonly runs: readonly DryRun[];\n  readonly deterministic: boolean;\n  readonly divergences: readonly string[];\n  readonly allDemoable: boolean;\n  readonly passed: boolean;\n}\n\n/**\n * Run the demo dry-run sequence.\n *\n * Deliberately does NOT reset between runs. That is the point: run two and run three start from whatever\n * run one left in storage, which is exactly the condition a second judge at the table reproduces. A\n * harness that reset between runs would be testing a scenario nobody encounters.\n */\nexport async function runDryRuns(count: number = REQUIRED_DRY_RUNS): Promise<DryRunReport> {\n  const runs: DryRun[] = [];\n\n  for (let n = 1; n <= count; n += 1) {\n    const started = Date.now();\n    try {\n      const seed = await buildSeed();\n      runs.push({\n        n,\n        fingerprint: fingerprintOf(seed, Date.now() - started),\n        verification: verifyDemo(seed),\n        warnings: seed.warnings,\n        error: null,\n      });\n    } catch (error) {\n      /* No verification is attempted on a run that threw. Building a stub report to fill the slot would\n       * print a row of zeros that looks like a measured result, and the whole point of the table is that\n       * every number in it came from a run that completed. */\n      runs.push({\n        n,\n        fingerprint: emptyFingerprint(Date.now() - started),\n        verification: null,\n        warnings: [],\n        error: error instanceof Error ? error.message : String(error),\n      });\n    }\n  }\n\n  const divergences = compare(runs);\n\n  return {\n    runs,\n    divergences,\n    deterministic: divergences.length === 0,\n    allDemoable: runs.every((run) => run.verification !== null && run.verification.demoable),\n    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */\n    passed: divergences.length === 0 && runs.every((run) => run.verification !== null && run.verification.demoable),\n  };\n}\n\nfunction fingerprintOf(seed: SeedResult, durationMs: number): DryRunFingerprint {\n  const decisions = [...seed.state.decisions.values()];\n\n  return {\n    decisions: decisions.length,\n    premises: seed.state.premises.size,\n    alternatives: seed.state.alternatives.size,\n    guards: seed.state.guards.size,\n    contradictions: seed.state.contradictions.length,\n    justifications: seed.state.justifications.size,\n    decisionIds: decisions.map((decision) => String(decision.id)).sort(),\n    labels: decisions.map((decision) => decision.id + \"=\" + decision.label).sort(),\n    durationMs,\n  };\n}\n\nfunction emptyFingerprint(durationMs: number): DryRunFingerprint {\n  return {\n    decisions: 0, premises: 0, alternatives: 0, guards: 0, contradictions: 0, justifications: 0,\n    decisionIds: [], labels: [], durationMs,\n  };\n}\n\nfunction compare(runs: readonly DryRun[]): readonly string[] {\n  const out: string[] = [];\n  const first = runs[0];\n  if (first === undefined) return [\"no runs completed\"];\n\n  for (const run of runs.slice(1)) {\n    if (run.error !== null) {\n      out.push(\"run \" + run.n + \" threw: \" + run.error);\n      continue;\n    }\n    if (first.error !== null) continue;\n\n    const fields: (keyof DryRunFingerprint)[] = [\n      \"decisions\", \"premises\", \"alternatives\", \"guards\", \"contradictions\", \"justifications\",\n    ];\n\n    for (const field of fields) {\n      const a = first.fingerprint[field];\n      const b = run.fingerprint[field];\n      if (typeof a === \"number\" && typeof b === \"number\" && a !== b) {\n        out.push(field + \": run 1 had \" + a + \", run \" + run.n + \" had \" + b);\n      }\n    }\n\n    if (first.fingerprint.labels.join(\"|\") !== run.fingerprint.labels.join(\"|\")) {\n      const differing = run.fingerprint.labels.filter((entry) => !first.fingerprint.labels.includes(entry));\n      out.push(\n        \"LABELS DIVERGED between run 1 and run \" + run.n + \" ΓÇö the same input produced different \" +\n        \"epistemic states. Counts alone would not have caught this. Differing: \" +\n        (differing.length === 0 ? \"(reordered only)\" : differing.slice(0, 6).join(\", \")),\n      );\n    }\n\n    if (first.fingerprint.decisionIds.join(\"|\") !== run.fingerprint.decisionIds.join(\"|\")) {\n      out.push(\"IDS DIVERGED between run 1 and run \" + run.n + \" ΓÇö a counter depends on something other than the input.\");\n    }\n  }\n\n  return out;\n}\n\nexport function renderDryRuns(report: DryRunReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"DRY RUNS ΓÇö \" + report.runs.length + \" consecutive, no reset between them\");\n  lines.push(report.passed ? \"PASSED: deterministic and demoable across all runs.\" : \"NOT PASSED.\");\n  lines.push(\"\");\n\n  lines.push(\"Run\".padEnd(5) + \"dec\".padStart(5) + \"prem\".padStart(6) + \"alt\".padStart(5) +\n    \"grd\".padStart(5) + \"contra\".padStart(8) + \"just\".padStart(6) + \"  verified/manual/failed\".padEnd(26) + \"secs\");\n  lines.push(\"-\".repeat(78));\n\n  for (const run of report.runs) {\n    const f = run.fingerprint;\n    const v = run.verification;\n    if (v === null) {\n      lines.push(String(run.n).padEnd(5) + \"  THREW ΓÇö \" + (run.error ?? \"unknown\"));\n      continue;\n    }\n    lines.push(\n      String(run.n).padEnd(5) +\n      String(f.decisions).padStart(5) + String(f.premises).padStart(6) + String(f.alternatives).padStart(5) +\n      String(f.guards).padStart(5) + String(f.contradictions).padStart(8) + String(f.justifications).padStart(6) +\n      (\"  \" + v.verified + \"/\" + v.manual + \"/\" + v.failed).padEnd(26) +\n      (f.durationMs / 1000).toFixed(1),\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\"Timings are shown but NOT compared: they vary with machine load, and treating a slow run as\");\n  lines.push(\"non-determinism teaches the presenter to ignore this report.\");\n\n  if (report.divergences.length > 0) {\n    lines.push(\"\");\n    lines.push(\"DIVERGENCES (\" + report.divergences.length + \"):\");\n    for (const divergence of report.divergences) lines.push(\"  \" + divergence);\n  } else {\n    lines.push(\"\");\n    lines.push(\"No divergences. Runs 2 and 3 started from whatever run 1 left in storage and produced\");\n    lines.push(\"identical node counts, identical labels and identical ids.\");\n  }\n\n  const warnings = report.runs.flatMap((run) => run.warnings.map((warning) => \"run \" + run.n + \": \" + warning));\n  if (warnings.length > 0) {\n    lines.push(\"\");\n    lines.push(\"WARNINGS:\");\n    for (const warning of [...new Set(warnings)]) lines.push(\"  \" + warning);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *    justifications: seed.state.justifications.size,\n    decisionIds: decisions.map((decision) => String(decision.id)).sort(),\n    labels: decisions.map((decision) => `${decision.id + \"}=\" + ${decision.label}`).sort(),\n    durationMs,\n  };  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":123}},{"diffOp":{"equal":{"range":[45,211]}}},{"diffOp":{"insert":{"range":[211,214]}}},{"diffOp":{"equal":{"range":[214,225]}}},{"diffOp":{"delete":{"range":[225,229]}}},{"diffOp":{"insert":{"range":[229,230]}}},{"diffOp":{"equal":{"range":[230,231]}}},{"diffOp":{"delete":{"range":[231,235]}}},{"diffOp":{"insert":{"range":[235,237]}}},{"diffOp":{"equal":{"range":[237,251]}}},{"diffOp":{"insert":{"range":[251,253]}}},{"diffOp":{"equal":{"range":[253,283]}}},{"equalLines":{"line_count":98}},{"diffOp":{"equal":{"range":[283,312]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\dryrun.ts"},"span":[5366,5400],"sourceCode":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THREE, AND WHY CONSECUTIVE\n *\n * ┬º7.5 requires three consecutive dry runs. Not one, because a single run cannot distinguish a working\n * demo from a lucky one. Not two, because two agreeing runs are consistent with a cache that was warm\n * after the first. Three is the smallest number at which agreement starts to mean something about\n * determinism rather than about warm state.\n *\n * Consecutive matters more than the count. Three runs with a rebuild in between test the build; three\n * runs back to back test that the SECOND and THIRD start from whatever the first left behind ΓÇö which is\n * the actual failure mode, because a demo that only works from a cold start is a demo that cannot be\n * repeated for a second judge who walks up to the table afterwards.\n *\n * ---------------------------------------------------------------------------\n * WHAT IS COMPARED\n *\n * Node counts, label assignments and contradiction records. Not timings and not id strings: timings\n * vary with machine load and comparing them would produce a \"non-deterministic\" verdict for a run that\n * is perfectly reproducible, which teaches the presenter to ignore the report.\n *\n * Ids ARE compared, but only for stability across runs, not for value ΓÇö a run that mints different ids\n * from the same input has a counter that depends on something other than the input, and that is a real\n * defect worth catching even though the specific ids do not matter.\n * ---------------------------------------------------------------------------\n */\n\nimport type { SeedResult } from \"./kit\";\nimport { buildSeed } from \"./kit\";\nimport { verifyDemo, type VerificationReport } from \"./verify\";\n\nexport const REQUIRED_DRY_RUNS = 3;\n\nexport interface DryRunFingerprint {\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly guards: number;\n  readonly contradictions: number;\n  readonly justifications: number;\n  /** Sorted decision ids. Compared for stability, not for value. */\n  readonly decisionIds: readonly string[];\n  /** Sorted `id=label` pairs. This is the comparison that matters: a cascade that fires on run one and\n   *  not on run two produces identical counts and different labels, and counts alone would pass it. */\n  readonly labels: readonly string[];\n  readonly durationMs: number;\n}\n\nexport interface DryRun {\n  readonly n: number;\n  readonly fingerprint: DryRunFingerprint;\n  /** Null when the run threw. A stub report would look like a real one in the table. */\n  readonly verification: VerificationReport | null;\n  readonly warnings: readonly string[];\n  readonly error: string | null;\n}\n\nexport interface DryRunReport {\n  readonly runs: readonly DryRun[];\n  readonly deterministic: boolean;\n  readonly divergences: readonly string[];\n  readonly allDemoable: boolean;\n  readonly passed: boolean;\n}\n\n/**\n * Run the demo dry-run sequence.\n *\n * Deliberately does NOT reset between runs. That is the point: run two and run three start from whatever\n * run one left in storage, which is exactly the condition a second judge at the table reproduces. A\n * harness that reset between runs would be testing a scenario nobody encounters.\n */\nexport async function runDryRuns(count: number = REQUIRED_DRY_RUNS): Promise<DryRunReport> {\n  const runs: DryRun[] = [];\n\n  for (let n = 1; n <= count; n += 1) {\n    const started = Date.now();\n    try {\n      const seed = await buildSeed();\n      runs.push({\n        n,\n        fingerprint: fingerprintOf(seed, Date.now() - started),\n        verification: verifyDemo(seed),\n        warnings: seed.warnings,\n        error: null,\n      });\n    } catch (error) {\n      /* No verification is attempted on a run that threw. Building a stub report to fill the slot would\n       * print a row of zeros that looks like a measured result, and the whole point of the table is that\n       * every number in it came from a run that completed. */\n      runs.push({\n        n,\n        fingerprint: emptyFingerprint(Date.now() - started),\n        verification: null,\n        warnings: [],\n        error: error instanceof Error ? error.message : String(error),\n      });\n    }\n  }\n\n  const divergences = compare(runs);\n\n  return {\n    runs,\n    divergences,\n    deterministic: divergences.length === 0,\n    allDemoable: runs.every((run) => run.verification !== null && run.verification.demoable),\n    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */\n    passed: divergences.length === 0 && runs.every((run) => run.verification !== null && run.verification.demoable),\n  };\n}\n\nfunction fingerprintOf(seed: SeedResult, durationMs: number): DryRunFingerprint {\n  const decisions = [...seed.state.decisions.values()];\n\n  return {\n    decisions: decisions.length,\n    premises: seed.state.premises.size,\n    alternatives: seed.state.alternatives.size,\n    guards: seed.state.guards.size,\n    contradictions: seed.state.contradictions.length,\n    justifications: seed.state.justifications.size,\n    decisionIds: decisions.map((decision) => String(decision.id)).sort(),\n    labels: decisions.map((decision) => decision.id + \"=\" + decision.label).sort(),\n    durationMs,\n  };\n}\n\nfunction emptyFingerprint(durationMs: number): DryRunFingerprint {\n  return {\n    decisions: 0, premises: 0, alternatives: 0, guards: 0, contradictions: 0, justifications: 0,\n    decisionIds: [], labels: [], durationMs,\n  };\n}\n\nfunction compare(runs: readonly DryRun[]): readonly string[] {\n  const out: string[] = [];\n  const first = runs[0];\n  if (first === undefined) return [\"no runs completed\"];\n\n  for (const run of runs.slice(1)) {\n    if (run.error !== null) {\n      out.push(\"run \" + run.n + \" threw: \" + run.error);\n      continue;\n    }\n    if (first.error !== null) continue;\n\n    const fields: (keyof DryRunFingerprint)[] = [\n      \"decisions\", \"premises\", \"alternatives\", \"guards\", \"contradictions\", \"justifications\",\n    ];\n\n    for (const field of fields) {\n      const a = first.fingerprint[field];\n      const b = run.fingerprint[field];\n      if (typeof a === \"number\" && typeof b === \"number\" && a !== b) {\n        out.push(field + \": run 1 had \" + a + \", run \" + run.n + \" had \" + b);\n      }\n    }\n\n    if (first.fingerprint.labels.join(\"|\") !== run.fingerprint.labels.join(\"|\")) {\n      const differing = run.fingerprint.labels.filter((entry) => !first.fingerprint.labels.includes(entry));\n      out.push(\n        \"LABELS DIVERGED between run 1 and run \" + run.n + \" ΓÇö the same input produced different \" +\n        \"epistemic states. Counts alone would not have caught this. Differing: \" +\n        (differing.length === 0 ? \"(reordered only)\" : differing.slice(0, 6).join(\", \")),\n      );\n    }\n\n    if (first.fingerprint.decisionIds.join(\"|\") !== run.fingerprint.decisionIds.join(\"|\")) {\n      out.push(\"IDS DIVERGED between run 1 and run \" + run.n + \" ΓÇö a counter depends on something other than the input.\");\n    }\n  }\n\n  return out;\n}\n\nexport function renderDryRuns(report: DryRunReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"DRY RUNS ΓÇö \" + report.runs.length + \" consecutive, no reset between them\");\n  lines.push(report.passed ? \"PASSED: deterministic and demoable across all runs.\" : \"NOT PASSED.\");\n  lines.push(\"\");\n\n  lines.push(\"Run\".padEnd(5) + \"dec\".padStart(5) + \"prem\".padStart(6) + \"alt\".padStart(5) +\n    \"grd\".padStart(5) + \"contra\".padStart(8) + \"just\".padStart(6) + \"  verified/manual/failed\".padEnd(26) + \"secs\");\n  lines.push(\"-\".repeat(78));\n\n  for (const run of report.runs) {\n    const f = run.fingerprint;\n    const v = run.verification;\n    if (v === null) {\n      lines.push(String(run.n).padEnd(5) + \"  THREW ΓÇö \" + (run.error ?? \"unknown\"));\n      continue;\n    }\n    lines.push(\n      String(run.n).padEnd(5) +\n      String(f.decisions).padStart(5) + String(f.premises).padStart(6) + String(f.alternatives).padStart(5) +\n      String(f.guards).padStart(5) + String(f.contradictions).padStart(8) + String(f.justifications).padStart(6) +\n      (\"  \" + v.verified + \"/\" + v.manual + \"/\" + v.failed).padEnd(26) +\n      (f.durationMs / 1000).toFixed(1),\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\"Timings are shown but NOT compared: they vary with machine load, and treating a slow run as\");\n  lines.push(\"non-determinism teaches the presenter to ignore this report.\");\n\n  if (report.divergences.length > 0) {\n    lines.push(\"\");\n    lines.push(\"DIVERGENCES (\" + report.divergences.length + \"):\");\n    for (const divergence of report.divergences) lines.push(\"  \" + divergence);\n  } else {\n    lines.push(\"\");\n    lines.push(\"No divergences. Runs 2 and 3 started from whatever run 1 left in storage and produced\");\n    lines.push(\"identical node counts, identical labels and identical ids.\");\n  }\n\n  const warnings = report.runs.flatMap((run) => run.warnings.map((warning) => \"run \" + run.n + \": \" + warning));\n  if (warnings.length > 0) {\n    lines.push(\"\");\n    lines.push(\"WARNINGS:\");\n    for (const warning of [...new Set(warnings)]) lines.push(\"  \" + warning);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *  for (const run of runs.slice(1)) {\n    if (run.error !== null) {\n      out.push(\"`run \" +${run.n + \"} threw: \" + run.error}`);\n      continue;\n    }  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":142}},{"diffOp":{"equal":{"range":[45,127]}}},{"diffOp":{"delete":{"range":[127,128]}}},{"diffOp":{"insert":{"range":[128,129]}}},{"diffOp":{"equal":{"range":[129,132]}}},{"diffOp":{"delete":{"range":[132,136]}}},{"diffOp":{"equal":{"range":[132,133]}}},{"diffOp":{"insert":{"range":[136,138]}}},{"diffOp":{"equal":{"range":[138,143]}}},{"diffOp":{"delete":{"range":[143,147]}}},{"diffOp":{"insert":{"range":[147,148]}}},{"diffOp":{"equal":{"range":[148,156]}}},{"diffOp":{"delete":{"range":[156,160]}}},{"diffOp":{"insert":{"range":[136,138]}}},{"diffOp":{"equal":{"range":[160,169]}}},{"diffOp":{"insert":{"range":[169,171]}}},{"diffOp":{"equal":{"range":[171,195]}}},{"equalLines":{"line_count":79}},{"diffOp":{"equal":{"range":[195,224]}}}]}}]},"verboseAdvices":{"advices":[]},"locatio