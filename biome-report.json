 drop it.\n *\n * ---------------------------------------------------------------------------\n * MRR IS REPORTED BECAUSE PRECISION@5 ALONE HIDES THE FAILURE\n *\n * A system that puts the right decision fifth scores 0.2 precision@5 and 0.2 MRR. A system that never\n * retrieves it at all scores 0 and 0. Those are different failures with different fixes ΓÇö the first is\n * a ranking problem, the second a recall problem ΓÇö and precision@5 cannot tell them apart at small k.\n * MRR can, because a query with no relevant result contributes exactly 0 under the standard convention\n * rather than being dropped from the denominator. Dropping failed queries is the usual way retrieval\n * numbers get inflated, and `meanReciprocalRank` in `types.ts` refuses to do it.\n *\n * ---------------------------------------------------------------------------\n * THE UNANSWERABLE QUESTION IS SCORED HERE, NOT DISCARDED\n *\n * One corpus question has an empty `relevant` set on purpose. A retrieval metric computed only over\n * answerable questions measures a system that has been told which questions have answers. This one is\n * included: it contributes no relevant results, so it can only lower the score, and the groundedness\n * metric is where its real behaviour ΓÇö refusing to answer ΓÇö is measured.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, meanReciprocalRank, precisionAtK, type MetricResult } from \"./types\";\n\nconst K = 5;\n\nexport interface RetrievalOutcome {\n  readonly precision: MetricResult;\n  readonly mrr: MetricResult;\n  readonly perQuestion: readonly {\n    question: string;\n    relevant: readonly string[];\n    relevantFound: number;\n    retrieved: readonly string[];\n    firstRelevantRank: number | null;\n    unanswerable: boolean;\n  }[];\n}\n\nexport function scoreRetrieval(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): RetrievalOutcome {\n  const perQuestion = run.questions.map((entry) => {\n    const relevantIds = entry.question.relevant\n      .map((key) => resolver.decision(key))\n      .filter((id): id is DecisionId => id !== null);\n\n    const retrieved = entry.answer === null ? [] : entry.answer.retrieved.slice(0, K).map((hit) => hit.decisionId);\n    const relevantFound = retrieved.filter((id) => relevantIds.includes(id)).length;\n\n    const firstRelevantRank = (() => {\n      for (let rank = 0; rank < retrieved.length; rank += 1) {\n        const id = retrieved[rank];\n        if (id !== undefined && relevantIds.includes(id)) return rank + 1;\n      }\n      return null;\n    })();\n\n    return {\n      question: entry.question.id,\n      relevant: entry.question.relevant,\n      relevantFound,\n      retrieved: retrieved.map((id) => String(id)),\n      firstRelevantRank,\n      unanswerable: entry.question.relevant.length === 0,\n    };\n  });\n\n  /* The expected number of relevant results in the top K, summed over questions. Precision@5 is\n   * normally relevant-in-top-5 divided by 5, which is what `precisionAtK` computes ΓÇö but for a question\n   * with only one relevant decision, a perfect retrieval still scores 0.2. The cap below reports the\n   * achievable precision beside it so the number is not read as a failure that is actually a ceiling. */\n  const relevantInTopK = perQuestion.reduce((sum, entry) => sum + entry.relevantFound, 0);\n  const slots = perQuestion.length * K;\n  const precisionValue = precisionAtK(relevantInTopK, slots);\n\n  const achievable = perQuestion.reduce(\n    (sum, entry) => sum + Math.min(entry.relevant.length, K) / (entry.unanswerable ? 1 : K),\n    0,\n  );\n  const achievableValue = perQuestion.length === 0 ? 0 : achievable / perQuestion.length;\n\n  const ranks = perQuestion.filter((entry) => !entry.unanswerable).map((entry) => entry.firstRelevantRank);\n  const mrrValue = meanReciprocalRank(ranks);\n\n  const detail = {\n    precision: precisionValue,\n    recall: 0,\n    f1: 0,\n    truePositives: relevantInTopK,\n    falsePositives: slots - relevantInTopK,\n    falseNegatives: 0,\n  };\n\n  return {\n    perQuestion,\n    precision: {\n      id: \"retrieval-precision\",\n      name: METRIC_NAMES[\"retrieval-precision\"],\n      value: precisionValue,\n      detail,\n      n: perQuestion.length,\n      perEngine: [{ engine: describeEngineId(engine), value: precisionValue, n: perQuestion.length, detail }],\n      comparator: COMPARATORS[\"retrieval-precision\"] ?? null,\n      gloss:\n        relevantInTopK + \" relevant result(s) across \" + slots + \" top-\" + K + \" slots = \" +\n        (precisionValue * 100).toFixed(1) + \"%. The achievable ceiling on these questions is \" +\n        (achievableValue * 100).toFixed(1) + \"%, because \" + perQuestion.filter((entry) => entry.relevant.length < K).length +\n        \" question(s) have fewer than \" + K + \" relevant decisions in the whole corpus.\",\n      honestNote:\n        \"precision@\" + K + \" over \" + perQuestion.length + \" questions, one of which is deliberately UNANSWERABLE and \" +\n        \"contributes a guaranteed zero rather than being dropped ΓÇö dropping it would inflate the score by deleting the \" +\n        \"hardest case. The achievable ceiling is printed beside the value because most questions have one or two relevant \" +\n        \"decisions in a twelve-transcript corpus, so a perfect system scores well under 1.0 and the raw number must not be \" +\n        \"read as an error rate. agentmemory's R@5 95.2% is a DIFFERENT TASK (retrieving conversation turns the query \" +\n        \"near-copies, not decisions the query paraphrases) and is cited as the nearest published figure, not as a baseline.\",\n    },\n    mrr: {\n      id: \"retrieval-mrr\",\n      name: METRIC_NAMES[\"retrieval-mrr\"],\n      value: mrrValue,\n      detail: null,\n      n: ranks.length,\n      perEngine: [{ engine: describeEngineId(engine), value: mrrValue, n: ranks.length, detail: null }],\n      comparator: null,\n      gloss:\n        \"MRR \" + mrrValue.toFixed(3) + \" over \" + ranks.length + \" answerable question(s). \" +\n        ranks.filter((rank) => rank === null).length + \" returned no relevant decision in the top \" + K + \" at all.\",\n      honestNote:\n        \"MRR is reported because precision@5 cannot distinguish 'ranked fifth' from 'never retrieved', and those are \" +\n        \"different failures with different fixes. n=\" + ranks.length + \" ΓÇö the unanswerable question is EXCLUDED from MRR \" +\n        \"(where it can only contribute a structural zero) but INCLUDED in precision@5, which is an inconsistency in \" +\n        \"convention made deliberately and stated here rather than hidden: MRR answers 'when there is an answer, how high \" +\n        \"is it', and the unanswerable question has no answer to rank. A query with no relevant result contributes 0 under \" +\n        \"the standard convention; failed queries are never removed from the denominator.\",\n    },\n  };\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metric 13 ΓÇö modality precision: of the statements the system DECLINED, how many were correctly declined.\n *}\n\nexport function scoreModalityPrecision(\n  corpus: ResolvedCorpus, run: RunResult,engine: EngineId,\n): ModalityOutcome {\n  const nodes: Decision[] = [...run.state.decisions.values()];\n  const declines: { label: ResolvedDecision; tier: string }[] = [];     * required, because the failure mode is not \"found it and mislabelled the variable\" ΓÇö it is \"made\n     * a node out of a sentence that was not a decision\", and such a node may carry any variable. */\n    const hit = nodes.find(\n      (node) =>\n              overlapOf(entry.label.span, {\n          start: node.provenance.snippet.start,end: node.provenance.snippet.end,\n        }) > 0,\n    );\n    if (hit !== undefined) wronglyPromoted.push({ label: entry.label, node: hit });      comparator: null,\n      gloss:\n        correctlyDeclined +\" of \" +declines.length +\" non-decisions were correctly left out of the graph; \" +\n        wronglyPromoted.length +\" became nodes anyway.\",\n      honestNote:\n        \"This is a PRECISION over declines, not a recall over hypotheticals: the denominator is the statements the corpus \" +\n        \"marks as must-not-become-nodes, so a system that declines nothing scores 0 rather than undefined. n=\" +\n        declines.length +\", concentrated in the adversarial tier, which is small enough that one violation moves the number \" +\n        \"by several points ΓÇö the per-tier breakdown is printed beside it for that reason. No comparator exists because no \" +\n        \"surveyed extractor operates on a corpus where speculation outnumbers decisions; the absence is a property of the \" +  return \"unknown\";\n}\n","ops":[{"diffOp":{"equal":{"range":[0,116]}}},{"equalLines":{"line_count":49}},{"diffOp":{"equal":{"range":[116,158]}}},{"diffOp":{"insert":{"range":[158,161]}}},{"diffOp":{"equal":{"range":[161,184]}}},{"diffOp":{"delete":{"range":[184,185]}}},{"diffOp":{"insert":{"range":[158,161]}}},{"diffOp":{"equal":{"range":[185,200]}}},{"diffOp":{"delete":{"range":[184,185]}}},{"diffOp":{"insert":{"range":[158,161]}}},{"diffOp":{"equal":{"range":[200,216]}}},{"diffOp":{"insert":{"range":[216,218]}}},{"diffOp":{"equal":{"range":[218,369]}}},{"equalLines":{"line_count":12}},{"diffOp":{"equal":{"range":[369,602]}}},{"diffOp":{"insert":{"range":[602,609]}}},{"diffOp":{"equal":{"range":[609,619]}}},{"diffOp":{"delete":{"range":[619,625]}}},{"diffOp":{"insert":{"range":[625,633]}}},{"diffOp":{"equal":{"range":[633,662]}}},{"diffOp":{"delete":{"range":[619,620]}}},{"diffOp":{"insert":{"range":[662,673]}}},{"diffOp":{"equal":{"range":[673,710]}}},{"diffOp":{"delete":{"range":[619,620]}}},{"diffOp":{"insert":{"range":[662,673]}}},{"diffOp":{"equal":{"range":[710,742]}}},{"diffOp":{"delete":{"range":[619,620]}}},{"diffOp":{"insert":{"range":[742,752]}}},{"diffOp":{"equal":{"range":[752,850]}}},{"equalLines":{"line_count":24}},{"diffOp":{"equal":{"range":[850,914]}}},{"diffOp":{"delete":{"range":[625,626]}}},{"diffOp":{"insert":{"range":[662,671]}}},{"diffOp":{"equal":{"range":[914,922]}}},{"diffOp":{"delete":{"range":[625,626]}}},{"diffOp":{"insert":{"range":[662,671]}}},{"diffOp":{"equal":{"range":[922,939]}}},{"diffOp":{"delete":{"range":[625,626]}}},{"diffOp":{"insert":{"range":[662,671]}}},{"diffOp":{"equal":{"range":[939,1029]}}},{"diffOp":{"delete":{"range":[850,851]}}},{"diffOp":{"insert":{"range":[662,671]}}},{"diffOp":{"equal":{"range":[1029,1336]}}},{"diffOp":{"delete":{"range":[850,851]}}},{"diffOp":{"insert":{"range":[662,671]}}},{"diffOp":{"equal":{"range":[1336,1692]}}},{"equalLines":{"line_count":9}},{"diffOp":{"equal":{"range":[1692,1714]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\modality.ts"},"span":null,"sourceCode":"/**\n * Metric 13 ΓÇö modality precision: of the statements the system DECLINED, how many were correctly declined.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: none published. ┬º7.2 calls this one of the two unusual metrics.\n *\n * ---------------------------------------------------------------------------\n * THE INVERSE OF THE USUAL QUESTION, AND THE ONE THAT MATTERS HERE\n *\n * Every extraction metric asks \"did you find the things that are there\". This one asks \"did you leave\n * alone the things that are not decisions\". A system that turns \"what if we used Redis?\" into a Redis\n * decision has perfect recall and is unusable, because the graph now contains things nobody decided\n * and every downstream guarantee ΓÇö contradiction detection, cascade, export ΓÇö is built on a lie.\n *\n * It is called precision rather than specificity because that is what it is: of the population the\n * system declined to promote, the fraction it was right to decline. The denominator is the declines,\n * not the hypotheticals, so a system that declines nothing scores zero rather than undefined.\n *\n * ---------------------------------------------------------------------------\n * WHY NOBODY MEASURES IT\n *\n * Because nobody's extractor is allowed to decline. A rationale miner over commit messages has no\n * hypotheticals to decline ΓÇö a commit message does not speculate. Agent dialogue is the first corpus\n * in this literature where speculation, reported speech and rejected proposals outnumber decisions,\n * which is why the metric exists here and not in the surveyed systems. Reporting it as \"no comparator\"\n * is accurate rather than modest.\n *\n * ---------------------------------------------------------------------------\n * THE DEMO-KILLER THIS GUARDS\n *\n * ┬º7.4 names \"hypotheticals becoming nodes\" as one of four demo-killers. This is the number that says\n * whether it happens. It is reported per transcript tier as well as in aggregate, because the\n * adversarial tier is where the failure lives and an aggregate over twelve transcripts can hide a\n * catastrophic 0.0 on three of them behind a good score on nine.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { ResolvedCorpus, ResolvedDecision } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { overlapOf } from \"./match\";\nimport { METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface ModalityOutcome {\n  readonly metric: MetricResult;\n  /** Statements the corpus says must NOT become nodes, and did. Each one is a visible defect. */\n  readonly wronglyPromoted: readonly { label: ResolvedDecision; node: Decision }[];\n  /** Statements the corpus says must not become nodes, and did not. Correct declines. */\n  readonly correctlyDeclined: number;\n  readonly declinesExpected: number;\n  readonly byTier: readonly { tier: string; expected: number; wronglyPromoted: number }[];\n}\n\nexport function scoreModalityPrecision(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): ModalityOutcome {\n  const nodes: Decision[] = [...run.state.decisions.values()];\n  const declines: { label: ResolvedDecision; tier: string }[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    for (const label of transcript.decisions) {\n      if (label.expectNode) continue;\n      declines.push({ label, tier: transcript.tier });\n    }\n  }\n\n  const wronglyPromoted: { label: ResolvedDecision; node: Decision }[] = [];\n\n  for (const entry of declines) {\n    /* A decline is violated when ANY node overlaps the labelled span. Variable agreement is not\n     * required, because the failure mode is not \"found it and mislabelled the variable\" ΓÇö it is \"made\n     * a node out of a sentence that was not a decision\", and such a node may carry any variable. */\n    const hit = nodes.find((node) =>\n      overlapOf(entry.label.span, { start: node.provenance.snippet.start, end: node.provenance.snippet.end }) > 0,\n    );\n    if (hit !== undefined) wronglyPromoted.push({ label: entry.label, node: hit });\n  }\n\n  const correctlyDeclined = declines.length - wronglyPromoted.length;\n  const value = declines.length === 0 ? 1 : correctlyDeclined / declines.length;\n\n  const tiers = [...new Set(corpus.transcripts.map((transcript) => transcript.tier))];\n  const byTier = tiers.map((tier) => {\n    const expected = declines.filter((entry) => entry.tier === tier).length;\n    const wrong = wronglyPromoted.filter((entry) => tierOf(corpus, entry.label) === tier).length;\n    return { tier, expected, wronglyPromoted: wrong };\n  });\n\n  return {\n    wronglyPromoted,\n    correctlyDeclined,\n    declinesExpected: declines.length,\n    byTier,\n    metric: {\n      id: \"modality-precision\",\n      name: METRIC_NAMES[\"modality-precision\"],\n      value,\n      detail: null,\n      n: declines.length,\n      perEngine: [{ engine: describeEngineId(engine), value, n: declines.length, detail: null }],\n      comparator: null,\n      gloss:\n        correctlyDeclined + \" of \" + declines.length + \" non-decisions were correctly left out of the graph; \" +\n        wronglyPromoted.length + \" became nodes anyway.\",\n      honestNote:\n        \"This is a PRECISION over declines, not a recall over hypotheticals: the denominator is the statements the corpus \" +\n        \"marks as must-not-become-nodes, so a system that declines nothing scores 0 rather than undefined. n=\" +\n        declines.length + \", concentrated in the adversarial tier, which is small enough that one violation moves the number \" +\n        \"by several points ΓÇö the per-tier breakdown is printed beside it for that reason. No comparator exists because no \" +\n        \"surveyed extractor operates on a corpus where speculation outnumbers decisions; the absence is a property of the \" +\n        \"literature, not a gap in this measurement.\",\n    },\n  };\n}\n\nfunction tierOf(corpus: ResolvedCorpus, label: ResolvedDecision): string {\n  for (const transcript of corpus.transcripts) {\n    if (transcript.decisions.some((candidate) => candidate === label)) return transcript.tier;\n  }\n  return \"unknown\";\n}\n"},"tags":[],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metrics 10 and 11 ΓÇö retrieval precision@5 and MRR.\n *import type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, type MetricResult, describeEngineId, meanReciprocalRank, precisionAtK, type MetricResult } from \"./types\";\n\nconst K = 5;  };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,62]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[62,186]}}},{"diffOp":{"insert":{"range":[186,205]}}},{"diffOp":{"equal":{"range":[205,255]}}},{"diffOp":{"delete":{"range":[255,274]}}},{"diffOp":{"equal":{"range":[274,306]}}},{"equalLines":{"line_count":114}},{"diffOp":{"equal":{"range":[306,313]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\retrieval.ts"},"span":null,"sourceCode":"/**\n * Metrics 10 and 11 ΓÇö retrieval precision@5 and MRR.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: agentmemory R@5 95.2% ΓÇö A DIFFERENT TASK.\n *\n * ---------------------------------------------------------------------------\n * WHY THE COMPARATOR IS CITED AND THEN DISMISSED\n *\n * agentmemory reports recall@5 of 95.2% using BM25 + vector + graph fusion with RRF ΓÇö architecturally\n * the same retrieval stack as this one. It is the nearest published number and it is much higher than\n * anything measured here will be, so it has to be addressed rather than quietly omitted.\n *\n * It is not comparable, for one reason that is decisive: agentmemory retrieves CONVERSATION TURNS that\n * the query is usually a near-copy of. This retrieves DECISIONS, where the query is a question about\n * rationale and the answer is a node whose text may share no content words with it. \"Why did we avoid\n * Postgres?\" and \"Use SQLite; single-user, no deploy infra\" overlap on one word.\n *\n * Printing 95.2% beside a 0.6 without saying that would be misleading in the direction that flatters\n * the comparator; printing ours alone would be misleading in the direction that flatters us. So both\n * are printed, with the task difference in the comparator field where the report cannot drop it.\n *\n * ---------------------------------------------------------------------------\n * MRR IS REPORTED BECAUSE PRECISION@5 ALONE HIDES THE FAILURE\n *\n * A system that puts the right decision fifth scores 0.2 precision@5 and 0.2 MRR. A system that never\n * retrieves it at all scores 0 and 0. Those are different failures with different fixes ΓÇö the first is\n * a ranking problem, the second a recall problem ΓÇö and precision@5 cannot tell them apart at small k.\n * MRR can, because a query with no relevant result contributes exactly 0 under the standard convention\n * rather than being dropped from the denominator. Dropping failed queries is the usual way retrieval\n * numbers get inflated, and `meanReciprocalRank` in `types.ts` refuses to do it.\n *\n * ---------------------------------------------------------------------------\n * THE UNANSWERABLE QUESTION IS SCORED HERE, NOT DISCARDED\n *\n * One corpus question has an empty `relevant` set on purpose. A retrieval metric computed only over\n * answerable questions measures a system that has been told which questions have answers. This one is\n * included: it contributes no relevant results, so it can only lower the score, and the groundedness\n * metric is where its real behaviour ΓÇö refusing to answer ΓÇö is measured.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, meanReciprocalRank, precisionAtK, type MetricResult } from \"./types\";\n\nconst K = 5;\n\nexport interface RetrievalOutcome {\n  readonly precision: MetricResult;\n  readonly mrr: MetricResult;\n  readonly perQuestion: readonly {\n    question: string;\n    relevant: readonly string[];\n    relevantFound: number;\n    retrieved: readonly string[];\n    firstRelevantRank: number | null;\n    unanswerable: boolean;\n  }[];\n}\n\nexport function scoreRetrieval(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): RetrievalOutcome {\n  const perQuestion = run.questions.map((entry) => {\n    const relevantIds = entry.question.relevant\n      .map((key) => resolver.decision(key))\n      .filter((id): id is DecisionId => id !== null);\n\n    const retrieved = entry.answer === null ? [] : entry.answer.retrieved.slice(0, K).map((hit) => hit.decisionId);\n    const relevantFound = retrieved.filter((id) => relevantIds.includes(id)).length;\n\n    const firstRelevantRank = (() => {\n      for (let rank = 0; rank < retrieved.length; rank += 1) {\n        const id = retrieved[rank];\n        if (id !== undefined && relevantIds.includes(id)) return rank + 1;\n      }\n      return null;\n    })();\n\n    return {\n      question: entry.question.id,\n      relevant: entry.question.relevant,\n      relevantFound,\n      retrieved: retrieved.map((id) => String(id)),\n      firstRelevantRank,\n      unanswerable: entry.question.relevant.length === 0,\n    };\n  });\n\n  /* The expected number of relevant results in the top K, summed over questions. Precision@5 is\n   * normally relevant-in-top-5 divided by 5, which is what `precisionAtK` computes ΓÇö but for a question\n   * with only one relevant decision, a perfect retrieval still scores 0.2. The cap below reports the\n   * achievable precision beside it so the number is not read as a failure that is actually a ceiling. */\n  const relevantInTopK = perQuestion.reduce((sum, entry) => sum + entry.relevantFound, 0);\n  const slots = perQuestion.length * K;\n  const precisionValue = precisionAtK(relevantInTopK, slots);\n\n  const achievable = perQuestion.reduce(\n    (sum, entry) => sum + Math.min(entry.relevant.length, K) / (entry.unanswerable ? 1 : K),\n    0,\n  );\n  const achievableValue = perQuestion.length === 0 ? 0 : achievable / perQuestion.length;\n\n  const ranks = perQuestion.filter((entry) => !entry.unanswerable).map((entry) => entry.firstRelevantRank);\n  const mrrValue = meanReciprocalRank(ranks);\n\n  const detail = {\n    precision: precisionValue,\n    recall: 0,\n    f1: 0,\n    truePositives: relevantInTopK,\n    falsePositives: slots - relevantInTopK,\n    falseNegatives: 0,\n  };\n\n  return {\n    perQuestion,\n    precision: {\n      id: \"retrieval-precision\",\n      name: METRIC_NAMES[\"retrieval-precision\"],\n      value: precisionValue,\n      detail,\n      n: perQuestion.length,\n      perEngine: [{ engine: describeEngineId(engine), value: precisionValue, n: perQuestion.length, detail }],\n      comparator: COMPARATORS[\"retrieval-precision\"] ?? null,\n      gloss:\n        relevantInTopK + \" relevant result(s) across \" + slots + \" top-\" + K + \" slots = \" +\n        (precisionValue * 100).toFixed(1) + \"%. The achievable ceiling on these questions is \" +\n        (achievableValue * 100).toFixed(1) + \"%, because \" + perQuestion.filter((entry) => entry.relevant.length < K).length +\n        \" question(s) have fewer than \" + K + \" relevant decisions in the whole corpus.\",\n      honestNote:\n        \"precision@\" + K + \" over \" + perQuestion.length + \" questions, one of which is deliberately UNANSWERABLE and \" +\n        \"contributes a guaranteed zero rather than being dropped ΓÇö dropping it would inflate the score by deleting the \" +\n        \"hardest case. The achievable ceiling is printed beside the value because most questions have one or two relevant \" +\n        \"decisions in a twelve-transcript corpus, so a perfect system scores well under 1.0 and the raw number must not be \" +\n        \"read as an error rate. agentmemory's R@5 95.2% is a DIFFERENT TASK (retrieving conversation turns the query \" +\n        \"near-copies, not decisions the query paraphrases) and is cited as the nearest published figure, not as a baseline.\",\n    },\n    mrr: {\n      id: \"retrieval-mrr\",\n      name: METRIC_NAMES[\"retrieval-mrr\"],\n      value: mrrValue,\n      detail: null,\n      n: ranks.length,\n      perEngine: [{ engine: describeEngineId(engine), value: mrrValue, n: ranks.length, detail: null }],\n      comparator: null,\n      gloss:\n        \"MRR \" + mrrValue.toFixed(3) + \" over \" + ranks.length + \" answerable question(s). \" +\n        ranks.filter((rank) => rank === null).length + \" returned no relevant decision in the top \" + K + \" at all.\",\n      honestNote:\n        \"MRR is reported because precision@5 cannot distinguish 'ranked fifth' from 'never retrieved', and those are \" +\n        \"different failures with different fixes. n=\" + ranks.length + \" ΓÇö the unanswerable question is EXCLUDED from MRR \" +\n        \"(where it can only contribute a structural zero) but INCLUDED in precision@5, which is an inconsistency in \" +\n        \"convention made deliberately and stated here rather than hidden: MRR answers 'when there is an answer, how high \" +\n        \"is it', and the unanswerable question has no answer to rank. A query with no relevant result contributes 0 under \" +\n        \"the standard convention; failed queries are never removed from the denominator.\",\n    },\n  };\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Label keys to runtime ids.\n *  const unresolvable: string[] = [];\n\n  for (const pair of decisions.pairs)\n    decisionMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n  for (const pair of premises.pairs)premiseMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n  for (const pair of alternatives.pairs)alternativeMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n\n  /* Every key the plants reference is checked up front, so a missing node is reported once, here,\nexport type { ResolvedCorpus };\n","ops":[{"diffOp":{"equal":{"range":[0,36]}}},{"equalLines":{"line_count":48}},{"diffOp":{"equal":{"range":[36,111]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[111,116]}}},{"diffOp":{"equal":{"range":[116,229]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[111,116]}}},{"diffOp":{"equal":{"range":[229,345]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[111,116]}}},{"diffOp":{"equal":{"range":[345,524]}}},{"equalLines":{"line_count":25}},{"diffOp":{"equal":{"range":[524,557]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\resolve.ts"},"span":null,"sourceCode":"/**\n * Label keys to runtime ids.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHY THIS EXISTS\n *\n * The corpus names nodes `\"l03/d1\"` ΓÇö a stable, readable key. The graph names them `WLD-0007`, minted\n * from a counter whose value depends on how many nodes every earlier transcript produced. Neither can\n * be written in terms of the other: hardcoding runtime ids in the corpus would make the labels break\n * whenever extraction improves, and deriving corpus keys from the graph would make the ground truth a\n * function of the system being measured, which is circular.\n *\n * So the bridge is built at scoring time from the ALIGNMENT the extraction metrics already computed.\n * A label that did not align has no runtime id, and every metric that depends on it reports the plant\n * as UNTESTED rather than as passed. That distinction is the whole reason this module exists: a plant\n * whose decision was never extracted cannot have its cascade verified, and scoring it as a pass would\n * be the single most misleading number this benchmark could produce.\n * ---------------------------------------------------------------------------\n */\n\nimport type { AlternativeId, DecisionId, PremiseId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport type { Alignment } from \"./match\";\n\nexport interface Resolver {\n  decision(key: string): DecisionId | null;\n  premise(key: string): PremiseId | null;\n  alternative(key: string): AlternativeId | null;\n  /** Keys the corpus asked about that have no runtime node. Reported, never swallowed. */\n  readonly unresolvable: readonly string[];\n}\n\nexport interface Alignments<TDecision, TPremise, TAlternative> {\n  readonly decisions: Alignment<any, TDecision>;\n  readonly premises: Alignment<any, TPremise>;\n  readonly alternatives: Alignment<any, TAlternative>;\n}\n\nexport function buildResolver(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  decisions: Alignment<{ transcript: string; key: string }, { id: DecisionId }>,\n  premises: Alignment<{ transcript: string; key: string }, { id: PremiseId }>,\n  alternatives: Alignment<{ transcript: string; key: string }, { id: AlternativeId }>,\n): Resolver {\n  const decisionMap = new Map<string, DecisionId>();\n  const premiseMap = new Map<string, PremiseId>();\n  const alternativeMap = new Map<string, AlternativeId>();\n  const unresolvable: string[] = [];\n\n  for (const pair of decisions.pairs) decisionMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n  for (const pair of premises.pairs) premiseMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n  for (const pair of alternatives.pairs) alternativeMap.set(pair.label.transcript + \"/\" + pair.label.key, pair.node.id);\n\n  /* Every key the plants reference is checked up front, so a missing node is reported once, here,\n   * rather than surfacing as a mysterious zero in whichever metric happened to ask. */\n  for (const plant of corpus.plants) {\n    for (const key of [...plant.expectUnsound, ...plant.expectSurvivors]) {\n      if (!decisionMap.has(key) && !premiseMap.has(key)) unresolvable.push(plant.id + \" -> \" + key);\n    }\n  }\n\n  return {\n    decision: (key) => decisionMap.get(key) ?? null,\n    premise: (key) => premiseMap.get(key) ?? null,\n    alternative: (key) => alternativeMap.get(key) ?? null,\n    unresolvable,\n  };\n}\n\n/** Runtime id of the transcript with this corpus key, or null if it failed to import. */\nexport function runtimeTranscriptId(run: RunResult, corpusKey: string): string | null {\n  const entry = run.transcripts.find((candidate) => candidate.transcript.id === corpusKey);\n  return entry === undefined ? null : entry.runtimeId;\n}\n\n/** Whether a plant's transcripts all imported. A plant spanning a failed transcript is untested. */\nexport function plantIsTestable(run: RunResult, transcripts: readonly string[]): boolean {\n  return transcripts.every((key) => runtimeTranscriptId(run, key) !== null);\n}\n\nexport type { ResolvedCorpus };\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"#!/usr/bin/env node\n/*\n * Emitted by the WhyLog export compiler alongside CLAUDE.md / AGENTS.md / DECISIONS.md.    } else if (c === \"?\") out += \"[^/]\";\n    else if (c === \".\") out += \"\\\\.\";\n    else if (\"+^${}|()[]\".includes(c)) out += \"`\\\\\" + $