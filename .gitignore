# --- dependencies & build output -------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
*.local

# --- secrets ----------------------------------------------------------------
# Keys are optional and live in localStorage at runtime. They must never be
# committed, and must never reach the event log or an export.
.env
.env.*
!.env.example
*.pem
*.key

# --- editors & OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.sw?

# --- logs & temp ------------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
.cache/
.temp/
tmp/

# --- test & tooling artifacts ----------------------------------------------
.vitest/
*.tsbuildinfo

# --- WhyLog runtime data ----------------------------------------------------
# Exported logs and generated agent files are artifacts of a run, not source.
# Commit them deliberately if you want them versioned with a project.
.whylog/
whylog-export/

# The reconciliation tool's scratch directory, and Python's bytecode cache.
.reconcile/
__pycache__/


# The exported guard set and its workflow are BUILD OUTPUTS of the guard
# export. They are regenerated from the log on every export, so committing them
# would mean committing a snapshot of a decision log that changes.
scripts/whylog-guards.cjs
.github/workflows/decision-guards.yml
*.exe
.hyperframes/
.thumbnails/
