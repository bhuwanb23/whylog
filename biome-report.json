e":[36,37]}}},{"diffOp":{"insert":{"range":[138,145]}}},{"diffOp":{"equal":{"range":[692,726]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[138,145]}}},{"diffOp":{"equal":{"range":[726,746]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[138,145]}}},{"diffOp":{"equal":{"range":[746,763]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[138,145]}}},{"diffOp":{"equal":{"range":[763,886]}}},{"diffOp":{"insert":{"range":[138,145]}}},{"diffOp":{"equal":{"range":[886,905]}}},{"diffOp":{"delete":{"range":[36,37]}}},{"diffOp":{"insert":{"range":[138,147]}}},{"diffOp":{"equal":{"range":[905,933]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[138,147]}}},{"diffOp":{"equal":{"range":[933,981]}}},{"diffOp":{"insert":{"range":[231,237]}}},{"diffOp":{"equal":{"range":[981,1056]}}},{"equalLines":{"line_count":2}},{"diffOp":{"equal":{"range":[1056,1121]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[138,147]}}},{"diffOp":{"equal":{"range":[1121,1147]}}},{"diffOp":{"delete":{"range":[270,271]}}},{"diffOp":{"insert":{"range":[138,147]}}},{"diffOp":{"equal":{"range":[1147,1447]}}},{"diffOp":{"insert":{"range":[138,147]}}},{"diffOp":{"equal":{"range":[1447,1540]}}},{"diffOp":{"insert":{"range":[231,239]}}},{"diffOp":{"equal":{"range":[1540,1559]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[1559,1632]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\corpus\\loader.ts"},"span":null,"sourceCode":"/**\n * The corpus loader ΓÇö 7.1.\n *\n * Phase 7 ┬╖ sub-phase 7.1\n *\n * ---------------------------------------------------------------------------\n * QUOTES ARE RESOLVED TO SPANS, AND A QUOTE THAT IS NOT FOUND IS A FAILURE\n *\n * Every label carries verbatim text. The loader finds it in the transcript and records the offsets.\n * If it cannot be found, the label is reported as UNRESOLVED and excluded from scoring ΓÇö never\n * silently dropped and never quietly matched at offset zero.\n *\n * Silently dropping it would lower recall for a reason nobody can see: the metric would report a\n * miss that is actually a typo in the ground truth. Matching it anyway would score a label against\n * text it does not describe. Both are worse than stopping and saying which label is wrong.\n *\n * Matching is case-insensitive but otherwise literal. Case-insensitive because transcripts are\n * typed by people who capitalise inconsistently; literal in every other respect because a fuzzy\n * match would let a paraphrased label pass, and a paraphrased ground truth is not ground truth.\n * ---------------------------------------------------------------------------\n */\n\nimport { readFileSync } from \"node:fs\";\nimport { resolve as resolvePath } from \"node:path\";\nimport type {\n  Corpus,\n  LabelledAlternative,\n  LabelledDecision,\n  LabelledPremise,\n  ResolvedAlternative,\n  ResolvedCorpus,\n  ResolvedDecision,\n  ResolvedPremise,\n  ResolvedTranscript,\n} from \"./labels\";\n\nexport interface LoadReport {\n  readonly corpus: ResolvedCorpus;\n  readonly resolved: number;\n  readonly unresolved: readonly { transcript: string; kind: string; key: string; quote: string }[];\n  readonly missingFiles: readonly string[];\n}\n\n/**\n * Load and resolve the corpus.\n *\n * Reads from disk rather than bundling the text, so the corpus is a set of inspectable files a\n * third party can extend ΓÇö which is the plan's mitigation for a corpus too small to be credible.\n */\nexport function loadCorpus(corpus: Corpus, root: string): LoadReport {\n  const transcripts: ResolvedTranscript[] = [];\n  const unresolved: { transcript: string; kind: string; key: string; quote: string }[] = [];\n  const missingFiles: string[] = [];\n  let resolvedCount = 0;\n\n  for (const transcript of corpus.transcripts) {\n    const path = resolvePath(root, \"..\", transcript.file);\n\n    let raw: string;\n    try {\n      raw = readFileSync(path, \"utf8\");\n    } catch {\n      missingFiles.push(transcript.file);\n      continue;\n    }\n\n    const decisions: ResolvedDecision[] = [];\n    for (const decision of transcript.decisions) {\n      const span = findSpan(raw, decision.quote);\n      if (span === null) {\n        unresolved.push({ transcript: transcript.id, kind: \"decision\", key: decision.key, quote: decision.quote });\n        continue;\n      }\n      resolvedCount += 1;\n      decisions.push({ ...decision, transcript: transcript.id, span });\n    }\n\n    const premises: ResolvedPremise[] = [];\n    for (const premise of transcript.premises) {\n      const span = findSpan(raw, premise.quote);\n      if (span === null) {\n        unresolved.push({ transcript: transcript.id, kind: \"premise\", key: premise.key, quote: premise.quote });\n        continue;\n      }\n      resolvedCount += 1;\n      premises.push({ ...premise, transcript: transcript.id, span });\n    }\n\n    const alternatives: ResolvedAlternative[] = [];\n    for (const alternative of transcript.alternatives) {\n      const span = findSpan(raw, alternative.quote);\n      if (span === null) {\n        unresolved.push({ transcript: transcript.id, kind: \"alternative\", key: alternative.key, quote: alternative.quote });\n        continue;\n      }\n      resolvedCount += 1;\n      alternatives.push({ ...alternative, transcript: transcript.id, span });\n    }\n\n    transcripts.push({\n      ...transcript,\n      raw,\n      decisions,\n      premises,\n      alternatives,\n      unresolved: [\n        ...unresolved\n          .filter((entry) => entry.transcript === transcript.id)\n          .map((entry) => ({ kind: entry.kind, key: entry.key, quote: entry.quote })),\n      ],\n    });\n  }\n\n  return {\n    corpus: { ...corpus, transcripts },\n    resolved: resolvedCount,\n    unresolved,\n    missingFiles,\n  };\n}\n\n/**\n * Locate a quote in the text.\n *\n * Case-insensitive, whitespace-normalised on both sides of the comparison, because transcripts wrap\n * lines and a quote written on one line will not byte-match text that was wrapped at 80 columns.\n * The returned offsets are into the ORIGINAL text, not the normalised copy.\n */\nexport function findSpan(raw: string, quote: string): { start: number; end: number } | null {\n  const needle = normalise(quote);\n  if (needle.length === 0) return null;\n\n  /* Direct hit first: fastest, and preserves exact offsets. */\n  const direct = raw.toLowerCase().indexOf(needle.toLowerCase());\n  if (direct >= 0) return { start: direct, end: direct + quote.length };\n\n  /* Fall back to a whitespace-insensitive search. Builds an index map from normalised position to\n   * original position so the returned span still points into the raw text. */\n  const mapped = normaliseWithMap(raw);\n  const index = mapped.text.toLowerCase().indexOf(needle.toLowerCase());\n  if (index < 0) return null;\n\n  const start = mapped.indexes[index] ?? 0;\n  const endOffset = mapped.indexes[index + needle.length - 1];\n  const end = endOffset === undefined ? raw.length : endOffset + 1;\n\n  return { start, end };\n}\n\nfunction normalise(text: string): string {\n  return text.replace(/\\s+/g, \" \").trim();\n}\n\nfunction normaliseWithMap(text: string): { text: string; indexes: number[] } {\n  const out: string[] = [];\n  const indexes: number[] = [];\n  let lastWasSpace = false;\n\n  for (let i = 0; i < text.length; i += 1) {\n    const char = text[i];\n    if (char === undefined) continue;\n\n    if (/\\s/.test(char)) {\n      if (!lastWasSpace && out.length > 0) {\n        out.push(\" \");\n        indexes.push(i);\n        lastWasSpace = true;\n      }\n      continue;\n    }\n\n    out.push(char);\n    indexes.push(i);\n    lastWasSpace = false;\n  }\n\n  return { text: out.join(\"\"), indexes };\n}\n\n/** The load report as text. Printed before any metric, because a corpus with unresolved labels\n *  produces numbers that mean something other than what they appear to. */\nexport function describeLoad(report: LoadReport): string {\n  const lines = [\n    \"Corpus load: \" + report.corpus.transcripts.length + \" transcript(s), \" + report.resolved + \" label(s) resolved to character spans.\",\n  ];\n\n  if (report.missingFiles.length > 0) {\n    lines.push(\"\");\n    lines.push(\"MISSING FILES (\" + report.missingFiles.length + \") ΓÇö these transcripts were skipped entirely:\");\n    for (const file of report.missingFiles) lines.push(\"  \" + file);\n  }\n\n  if (report.unresolved.length > 0) {\n    lines.push(\"\");\n    lines.push(\n      \"UNRESOLVED LABELS (\" + report.unresolved.length + \") ΓÇö the quote is not a literal substring of the transcript.\",\n      \"These are EXCLUDED from scoring and reported rather than dropped, because a label that silently\",\n      \"vanishes lowers recall for a reason nobody can see:\",\n    );\n    for (const entry of report.unresolved) {\n      lines.push(\"  \" + entry.transcript + \" ┬╖ \" + entry.kind + \" \" + entry.key + ' ┬╖ \"' + entry.quote + '\"');\n    }\n  } else {\n    lines.push(\"Every label resolved. The ground truth is verifiable against the transcripts.\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nexport type { LabelledDecision, LabelledPremise, LabelledAlternative };\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 3 ΓÇö alternative extraction precision.\n *  const fpToFnRatio =\n    detail.falseNegatives === 0\n      ? `${detail.falsePositives + \"}:0 (no misses to compare against)\"\n      : detail.falsePositives + \":\" + detail.falseNegatives +\n        \" (\" + (detail.falsePositives / detail.falseNegatives).toFixed(1) + \" FP per FN)\";\nexport type { AlternativeId };\n","ops":[{"diffOp":{"equal":{"range":[0,56]}}},{"equalLines":{"line_count":87}},{"diffOp":{"equal":{"range":[56,118]}}},{"diffOp":{"insert":{"range":[118,121]}}},{"diffOp":{"equal":{"range":[121,142]}}},{"diffOp":{"delete":{"range":[142,146]}}},{"diffOp":{"insert":{"range":[146,147]}}},{"diffOp":{"equal":{"range":[147,180]}}},{"diffOp":{"delete":{"range":[180,181]}}},{"diffOp":{"insert":{"range":[118,119]}}},{"diffOp":{"equal":{"range":[181,334]}}},{"equalLines":{"line_count":35}},{"diffOp":{"equal":{"range":[334,366]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\alternative.ts"},"span":[5014,5073],"sourceCode":"/**\n * Metric 3 ΓÇö alternative extraction precision.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: ARGUS, 15.4% precision, alpha 0.64, FP:FN 13:1 (arXiv:2604.10345, docs/05 ┬º4.3).\n *\n * ---------------------------------------------------------------------------\n * PRECISION IS THE HEADLINE BECAUSE ARGUS SAYSO\n *\n * ARGUS found alternatives to be the worst-measured rationale component in the literature: 15.4%\n * precision with a false-positive-to-false-negative ratio of 13:1. The system produces fifteen wrong\n * alternatives for every one it misses. That ratio matters more than the absolute number, because it\n * says the failure is not caution but noise ΓÇö and noise is what makes a user stop reading the panel.\n *\n * So this metric reports precision first and the FP:FN ratio beside it, rather than leading with F1.\n * F1 would blend a catastrophic precision with a good recall into a number that looks acceptable, and\n * the whole reason ARGUS's result is memorable is that the blend hides the problem.\n *\n * ---------------------------------------------------------------------------\n * AN ALTERNATIVE WITHOUT `whyRejected` IS NOT A FALSE POSITIVE\n *\n * The corpus distinguishes alternatives that were rejected for a stated reason from ones merely\n * mentioned. The system stores both but only pre-empts on the former, and only the latter kind is a\n * plausible false positive: mentioning Redis is not an error, claiming Redis was rejected when nobody\n * rejected it is. Precision is therefore computed over ALL extracted alternatives, and a second number\n * ΓÇö pre-emption eligibility precision ΓÇö is computed over the ones the system would actually act on.\n * Reporting only the first would understate the risk; reporting only the second would overstate the\n * system's restraint.\n * ---------------------------------------------------------------------------\n */\n\nimport type { AlternativeId, EngineId, TranscriptId } from \"@/types/common\";\nimport type { RejectedAlternative } from \"@/types/domain\";\nimport type { ResolvedAlternative, ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface AlternativeOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedAlternative, RejectedAlternative>;\n  readonly fpToFnRatio: string;\n  /** Precision over the alternatives the system would actually pre-empt on. */\n  readonly preemptionPrecision: number;\n  readonly preemptionEligible: number;\n}\n\nexport function scoreAlternativeExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): AlternativeOutcome {\n  const labels: ResolvedAlternative[] = [];\n  for (const transcript of corpus.transcripts) {\n    for (const alternative of transcript.alternatives) {\n      /* `expectConfirmed` is the alternative-level form of \"should this become a node\": true when the\n       * transcript actually REJECTS the alternative, false when it merely mentions it. Alternatives\n       * need explicit confirmation before they may pre-empt anything, so a mention is not a miss. */\n      if (!alternative.expectConfirmed) continue;\n      labels.push(alternative);\n    }\n  }\n\n  const nodes: RejectedAlternative[] = [...run.state.alternatives.values()];\n\n  /* An alternative carries no transcript of its own ΓÇö it belongs to the decision it was rejected in\n   * favour of ΓÇö so eligibility goes through that decision's provenance. This is the same transcript\n   * test the decision metric applies, and without it a label from c01 could match a node extracted\n   * from m02 merely because their character spans overlap in two differently-numbered documents.\n   * That match would be scored as a true positive that never happened. */\n  const ownerOf = new Map<AlternativeId, TranscriptId>();\n  for (const alternative of nodes) {\n    const decision = run.state.decisions.get(alternative.decisionId);\n    if (decision !== undefined) ownerOf.set(alternative.id, decision.provenance.transcriptId);\n  }\n\n  const alignment = align(\n    labels,\n    nodes,\n    (label) => label.span,\n    (node) => ({ start: node.snippet.start, end: node.snippet.end }),\n    (label, node) => {\n      const owner = ownerOf.get(node.id);\n      if (owner === undefined) return false;\n      const entry = run.transcripts.find((candidate) => candidate.runtimeId === owner);\n      /* `label.transcript` is carried on the label precisely so this needs no search. */\n      return entry !== undefined && entry.transcript.id === label.transcript;\n    },\n  );\n\n  const detail = precisionRecall(alignment.truePositives, alignment.falsePositives, alignment.falseNegatives);\n\n  /* ARGUS's ratio, restated. Reported as a string because 13:1 is how the literature writes it and a\n   * decimal would invite a comparison with a different quantity. */\n  const fpToFnRatio =\n    detail.falseNegatives === 0\n      ? detail.falsePositives + \":0 (no misses to compare against)\"\n      : detail.falsePositives + \":\" + detail.falseNegatives +\n        \" (\" + (detail.falsePositives / detail.falseNegatives).toFixed(1) + \" FP per FN)\";\n\n  /* Pre-emption eligibility: an alternative only enters the pre-emption index with an explicit\n   * whyRejected AND human confirmation. Counting precision over just those answers the question a user\n   * actually has ΓÇö \"when the system warns me I am re-proposing something rejected, is it right?\" */\n  const eligible = nodes.filter((node) => node.whyRejected !== undefined);\n  const eligibleLabels = labels.filter((label) => label.whyRejected !== undefined);\n  const eligibleHits = alignment.pairs.filter((pair) => pair.node.whyRejected !== undefined).length;\n  const preemptionPrecision = eligible.length === 0 ? 0 : eligibleHits / eligible.length;\n\n  return {\n    alignment,\n    fpToFnRatio,\n    preemptionPrecision,\n    preemptionEligible: eligible.length,\n    metric: {\n      id: \"alternative-precision\",\n      name: METRIC_NAMES[\"alternative-precision\"],\n      value: detail.precision,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.precision, n: labels.length, detail }],\n      comparator: COMPARATORS[\"alternative-precision\"] ?? null,\n      gloss:\n        detail.precision.toFixed(3) + \" precision against ARGUS's 0.154; FP:FN \" + fpToFnRatio +\n        \" against ARGUS's 13:1. \" + eligible.length + \" alternative(s) carry a stated rejection reason and \" +\n        (preemptionPrecision * 100).toFixed(0) + \"% of those are correct ΓÇö the subset the system would act on.\",\n      honestNote:\n        \"Precision is the headline because ARGUS's finding is a PRECISION finding; F1 would blend a bad precision with a \" +\n        \"good recall into a number that looks acceptable. Matched by \" + MATCH_RULE + \", requiring the variable to agree.