{"insert":{"range":[743,751]}}},{"diffOp":{"equal":{"range":[751,795]}}},{"diffOp":{"insert":{"range":[642,647]}}},{"diffOp":{"equal":{"range":[795,890]}}},{"diffOp":{"insert":{"range":[743,747]}}},{"diffOp":{"equal":{"range":[890,995]}}},{"diffOp":{"insert":{"range":[642,647]}}},{"diffOp":{"equal":{"range":[995,1028]}}},{"diffOp":{"insert":{"range":[154,155]}}},{"diffOp":{"equal":{"range":[1028,1056]}}},{"diffOp":{"insert":{"range":[890,891]}}},{"diffOp":{"equal":{"range":[1056,1080]}}},{"diffOp":{"insert":{"range":[743,747]}}},{"diffOp":{"equal":{"range":[1080,1111]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\cli.ts"},"span":null,"sourceCode":"/**\n * `npm run demo:verify` ΓÇö build the seed, verify every beat, run the dry runs.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * The rehearsal command. It answers three questions in order, and stops at the first one that fails:\n *   1. does the seed build at all\n *   2. does every beat of the script have something to show\n *   3. does it do the same thing three times in a row\n *\n * Keyless throughout. If this command needs an API key to pass, the demo is not verifiable and the\n * requirement in ┬º7.5 has not been met.\n */\n\nimport { banner, blank, heading, line, readArgs, write } from \"../cli\";\nimport { buildSeed, describeReset, resetDemo } from \"./kit\";\nimport { renderScript } from \"./script\";\nimport { renderVerification, verifyDemo } from \"./verify\";\nimport { REQUIRED_DRY_RUNS, renderDryRuns, runDryRuns } from \"./dryrun\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n\n  banner(\"Demo kit ΓÇö keyless verification\");\n\n  heading(\"Script\");\n  line(renderScript());\n\n  heading(\"Reset\");\n  /* In Node there is no localStorage, so the reset reports that and the seed is built from scratch\n   * anyway. Printed rather than skipped: a presenter rehearsing in a browser needs to know the reset is\n   * a real action there, and a rehearsal harness that silently did nothing would not catch a key it\n   * forgot to clear. */\n  line(describeReset(resetDemo(null)));\n\n  heading(\"Seed\");\n  const seed = await buildSeed();\n  line(\n    \"built in \" + (seed.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + seed.decisions + \" decisions ┬╖ \" +\n    seed.premises + \" premises ┬╖ engine \" + seed.engineId.kind,\n  );\n  for (const warning of seed.warnings) line(\"  warning: \" + warning);\n\n  heading(\"Beat verification\");\n  const report = verifyDemo(seed);\n  line(renderVerification(report));\n\n  if (!report.demoable && !args.has(\"force\")) {\n    blank();\n    line(\"STOPPING: a beat will visibly not work. Fix it or use the mitigation printed above.\");\n    line(\"Pass --force to run the dry runs anyway.\");\n    process.exitCode = 1;\n    if (args.has(\"out\")) write(args.get(\"out\") ?? \"demo-verification.md\", renderVerification(report));\n    return;\n  }\n\n  const count = Number(args.get(\"runs\") ?? REQUIRED_DRY_RUNS);\n  heading(\"Dry runs ΓÇö \" + count + \" consecutive, no reset between them\");\n  const dry = await runDryRuns(Number.isFinite(count) && count > 0 ? count : REQUIRED_DRY_RUNS);\n  line(renderDryRuns(dry));\n\n  if (args.has(\"out\")) {\n    write(\n      args.get(\"out\") ?? \"demo-verification.md\",\n      [\"# Demo verification\", \"\", \"```\", renderScript(), \"\", renderVerification(report), \"\", renderDryRuns(dry), \"```\", \"\"].join(\"\\n\"),\n    );\n  }\n\n  blank();\n  line(dry.passed ? \"DEMO IS READY.\" : \"DEMO IS NOT READY ΓÇö see the divergences and failures above.\");\n  if (!dry.passed) process.exitCode = 1;\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The ablation study runner ΓÇö 7.3.\n * * would stop being attributable to the toggles. Slower and correct beats faster and uninterpretable.\n */\nexport async function runAblation(\n  corpus: ResolvedCorpus,options: StudyOptions = {},\n): Promise<AblationStudy> {\n  const engine = options.engine ?? createLocalEngine();\n  const engineId = options.engineId ?? localEngineId();        params: ablation.params,\n      });\n      outcomes.push({\n        ablation,scored: scoreAll(corpus, run, engineId),run,error: null,durationMs: Date.now() - rowStart,\n      });\n    } catch (error) {\n      outcomes.push({  const usable = study.outcomes.filter((outcome) => outcome.scored !== null).length;\n  const lines = [\n    \"Ablation study: \" +study.outcomes.length +\" configuration(s), \" +usable +\" produced scores.\",\n    \"Engine: \" +study.engine.kind +(study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") +\n      \"  ┬╖  corpus \" +study.corpusVersion +\"  ┬╖  ran \" +study.ranAt,\n    \"Total wall time: \" + (study.totalDurationMs / 1000).toFixed(1) + \"s\",\n  ];  if (study.baseline === null || study.baseline.scored === null) {\n    lines.push(\"\");\n    lines.push(\"THE BASELINE DID NOT PRODUCE SCORES. No delta in this study is meaningful, because every\");\n    lines.push(\"delta is measured against it. Fix the baseline before reading any row below.\");\n  }  if (study.failed.length > 0) {\n    lines.push(\"\");\n    lines.push(study.failed.length + \" configuration(s) threw and are EXCLUDED from the delta table:\");\n    for (const entry of study.failed)lines.push(\"  \" + entry.id + \" ┬╖ \" + entry.error.split(\"\\n\")[0]);\n  }\n\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,44]}}},{"equalLines":{"line_count":62}},{"diffOp":{"equal":{"range":[44,184]}}},{"diffOp":{"insert":{"range":[18