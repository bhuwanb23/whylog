etric 3 ΓÇö alternative extraction precision.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: ARGUS, 15.4% precision, alpha 0.64, FP:FN 13:1 (arXiv:2604.10345, docs/05 ┬º4.3).\n *\n * ---------------------------------------------------------------------------\n * PRECISION IS THE HEADLINE BECAUSE ARGUS SAYSO\n *\n * ARGUS found alternatives to be the worst-measured rationale component in the literature: 15.4%\n * precision with a false-positive-to-false-negative ratio of 13:1. The system produces fifteen wrong\n * alternatives for every one it misses. That ratio matters more than the absolute number, because it\n * says the failure is not caution but noise ΓÇö and noise is what makes a user stop reading the panel.\n *\n * So this metric reports precision first and the FP:FN ratio beside it, rather than leading with F1.\n * F1 would blend a catastrophic precision with a good recall into a number that looks acceptable, and\n * the whole reason ARGUS's result is memorable is that the blend hides the problem.\n *\n * ---------------------------------------------------------------------------\n * AN ALTERNATIVE WITHOUT `whyRejected` IS NOT A FALSE POSITIVE\n *\n * The corpus distinguishes alternatives that were rejected for a stated reason from ones merely\n * mentioned. The system stores both but only pre-empts on the former, and only the latter kind is a\n * plausible false positive: mentioning Redis is not an error, claiming Redis was rejected when nobody\n * rejected it is. Precision is therefore computed over ALL extracted alternatives, and a second number\n * ΓÇö pre-emption eligibility precision ΓÇö is computed over the ones the system would actually act on.\n * Reporting only the first would understate the risk; reporting only the second would overstate the\n * system's restraint.\n * ---------------------------------------------------------------------------\n */\n\nimport type { AlternativeId, EngineId, TranscriptId } from \"@/types/common\";\nimport type { RejectedAlternative } from \"@/types/domain\";\nimport type { ResolvedAlternative, ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface AlternativeOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedAlternative, RejectedAlternative>;\n  readonly fpToFnRatio: string;\n  /** Precision over the alternatives the system would actually pre-empt on. */\n  readonly preemptionPrecision: number;\n  readonly preemptionEligible: number;\n}\n\nexport function scoreAlternativeExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): AlternativeOutcome {\n  const labels: ResolvedAlternative[] = [];\n  for (const transcript of corpus.transcripts) {\n    for (const alternative of transcript.alternatives) {\n      /* `expectConfirmed` is the alternative-level form of \"should this become a node\": true when the\n       * transcript actually REJECTS the alternative, false when it merely mentions it. Alternatives\n       * need explicit confirmation before they may pre-empt anything, so a mention is not a miss. */\n      if (!alternative.expectConfirmed) continue;\n      labels.push(alternative);\n    }\n  }\n\n  const nodes: RejectedAlternative[] = [...run.state.alternatives.values()];\n\n  /* An alternative carries no transcript of its own ΓÇö it belongs to the decision it was rejected in\n   * favour of ΓÇö so eligibility goes through that decision's provenance. This is the same transcript\n   * test the decision metric applies, and without it a label from c01 could match a node extracted\n   * from m02 merely because their character spans overlap in two differently-numbered documents.\n   * That match would be scored as a true positive that never happened. */\n  const ownerOf = new Map<AlternativeId, TranscriptId>();\n  for (const alternative of nodes) {\n    const decision = run.state.decisions.get(alternative.decisionId);\n    if (decision !== undefined) ownerOf.set(alternative.id, decision.provenance.transcriptId);\n  }\n\n  const alignment = align(\n    labels,\n    nodes,\n    (label) => label.span,\n    (node) => ({ start: node.snippet.start, end: node.snippet.end }),\n    (label, node) => {\n      const owner = ownerOf.get(node.id);\n      if (owner === undefined) return false;\n      const entry = run.transcripts.find((candidate) => candidate.runtimeId === owner);\n      /* `label.transcript` is carried on the label precisely so this needs no search. */\n      return entry !== undefined && entry.transcript.id === label.transcript;\n    },\n  );\n\n  const detail = precisionRecall(alignment.truePositives, alignment.falsePositives, alignment.falseNegatives);\n\n  /* ARGUS's ratio, restated. Reported as a string because 13:1 is how the literature writes it and a\n   * decimal would invite a comparison with a different quantity. */\n  const fpToFnRatio =\n    detail.falseNegatives === 0\n      ? detail.falsePositives + \":0 (no misses to compare against)\"\n      : detail.falsePositives + \":\" + detail.falseNegatives +\n        \" (\" + (detail.falsePositives / detail.falseNegatives).toFixed(1) + \" FP per FN)\";\n\n  /* Pre-emption eligibility: an alternative only enters the pre-emption index with an explicit\n   * whyRejected AND human confirmation. Counting precision over just those answers the question a user\n   * actually has ΓÇö \"when the system warns me I am re-proposing something rejected, is it right?\" */\n  const eligible = nodes.filter((node) => node.whyRejected !== undefined);\n  const eligibleLabels = labels.filter((label) => label.whyRejected !== undefined);\n  const eligibleHits = alignment.pairs.filter((pair) => pair.node.whyRejected !== undefined).length;\n  const preemptionPrecision = eligible.length === 0 ? 0 : eligibleHits / eligible.length;\n\n  return {\n    alignment,\n    fpToFnRatio,\n    preemptionPrecision,\n    preemptionEligible: eligible.length,\n    metric: {\n      id: \"alternative-precision\",\n      name: METRIC_NAMES[\"alternative-precision\"],\n      value: detail.precision,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.precision, n: labels.length, detail }],\n      comparator: COMPARATORS[\"alternative-precision\"] ?? null,\n      gloss:\n        detail.precision.toFixed(3) + \" precision against ARGUS's 0.154; FP:FN \" + fpToFnRatio +\n        \" against ARGUS's 13:1. \" + eligible.length + \" alternative(s) carry a stated rejection reason and \" +\n        (preemptionPrecision * 100).toFixed(0) + \"% of those are correct ΓÇö the subset the system would act on.\",\n      honestNote:\n        \"Precision is the headline because ARGUS's finding is a PRECISION finding; F1 would blend a bad precision with a \" +\n        \"good recall into a number that looks acceptable. Matched by \" + MATCH_RULE + \", requiring the variable to agree. \" +\n        \"n=\" + labels.length + \" labelled alternatives, of which \" + eligibleLabels.length + \" state a rejection reason. \" +\n        \"The corpus is small enough that a single spurious alternative moves precision by several points, so the count is \" +\n        \"reported beside the ratio and neither should be quoted without it.\",\n    },\n  };\n}\n\nexport type { AlternativeId };\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *import type { SeedResult } from \"./kit\";\nimport { buildSeed } from \"./kit\";\nimport { verifyDemo, type VerificationReport, verifyDemo } from \"./verify\";\n\nexport const REQUIRED_DRY_RUNS = 3;  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[45,130]}}},{"diffOp":{"delete":{"range":[130,142]}}},{"diffOp":{"equal":{"range":[142,165]}}},{"diffOp":{"insert":{"range":[165,177]}}},{"diffOp":{"equal":{"range":[177,233]}}},{"equalLines":{"line_count":193}},{"diffOp":{"equal":{"range":[233,262]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\dryrun.ts"},"span":null,"sourceCode":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THREE, AND WHY CONSECUTIVE\n *\n * ┬º7.5 requires three consecutive dry runs. Not one, because a single run cannot distinguish a working\n * demo from a lucky one. Not two, because two agreeing runs are consistent with a cache that was warm\n * after the first. Three is the smallest number at which agreement starts to mean something about\n * determinism rather than about warm state.\n *\n * Consecutive matters more than the count. Three runs with a rebuild in between test the build; three\n * runs back to back test that the SECOND and THIRD start from whatever the first left behind ΓÇö which is\n * the actual failure mode, because a demo that only works from a cold start is a demo that cannot be\n * repeated for a second judge who walks up to the table afterwards.\n *\n * ---------------------------------------------------------------------------\n * WHAT IS COMPARED\n *\n * Node counts, label assignments and contradiction records. Not timings and not id strings: timings\n * vary with machine load and comparing them would produce a \"non-deterministic\" verdict for a run that\n * is perfectly reproducible, which teaches the presenter to ignore the report.\n *\n * Ids ARE compared, but only for stability across runs, not for value ΓÇö a run that mints different ids\n * from the same input has a counter that depends on something other than the input, and that is a real\n * defect worth catching even though the specific ids do not matter.\n * ---------------------------------------------------------------------------\n */\n\nimport type { SeedResult } from \"./kit\";\nimport { buildSeed } from \"./kit\";\nimport { verifyDemo, type VerificationReport } from \"./verify\";\n\nexport const REQUIRED_DRY_RUNS = 3;\n\nexport interface DryRunFingerprint {\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly guards: number;\n  readonly contradictions: number;\n  readonly justifications: number;\n  /** Sorted decision ids. Compared for stability, not for value. */\n  readonly decisionIds: readonly string[];\n  /** Sorted `id=label` pairs. This is the comparison that matters: a cascade that fires on run one and\n   *  not on run two produces identical counts and different labels, and counts alone would pass it. */\n  readonly labels: readonly string[];\n  readonly durationMs: number;\n}\n\nexport interface DryRun {\n  readonly n: number;\n  readonly fingerprint: DryRunFingerprint;\n  /** Null when the run threw. A stub report would look like a real one in the table. */\n  readonly verification: VerificationReport | null;\n  readonly warnings: readonly string[];\n  readonly error: string | null;\n}\n\nexport interface DryRunReport {\n  readonly runs: readonly DryRun[];\n  readonly deterministic: boolean;\n  readonly divergences: readonly string[];\n  readonly allDemoable: boolean;\n  readonly passed: boolean;\n}\n\n/**\n * Run the demo dry-run sequence.\n *\n * Deliberately does NOT reset between runs. That is the point: run two and run three start from whatever\n * run one left in storage, which is exactly the condition a second judge at the table reproduces. A\n * harness that reset between runs would be testing a scenario nobody encounters.\n */\nexport async function runDryRuns(count: number = REQUIRED_DRY_RUNS): Promise<DryRunReport> {\n  const runs: DryRun[] = [];\n\n  for (let n = 1; n <= count; n += 1) {\n    const started = Date.now();\n    try {\n      const seed = await buildSeed();\n      runs.push({\n        n,\n        fingerprint: fingerprintOf(seed, Date.now() - started),\n        verification: verifyDemo(seed),\n        warnings: seed.warnings,\n        error: null,\n      });\n    } catch (error) {\n      /* No verification is attempted on a run that threw. Building a stub report to fill the slot would\n       * print a row of zeros that looks like a measured result, and the whole point of the table is that\n       * every number in it came from a run that completed. */\n      runs.push({\n        n,\n        fingerprint: emptyFingerprint(Date.now() - started),\n        verification: null,\n        warnings: [],\n        error: error instanceof Error ? error.message : String(error),\n      });\n    }\n  }\n\n  const divergences = compare(runs);\n\n  return {\n    runs,\n    divergences,\n    deterministic: divergences.length === 0,\n    allDemoable: runs.every((run) => run.verification !== null && run.verification.demoable),\n    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */\n    passed: divergences.length === 0 && runs.every((run) => run.verification !== null && run.verification.demoable),\n  };\n}\n\nfunction fingerprintOf(seed: SeedResult, durationMs: number): DryRunFingerprint {\n  const decisions = [...seed.state.decisions.values()];\n\n  return {\n    decisions: decisions.length,\n    premises: seed.state.premises.size,\n    alternatives: seed.state.alternatives.size,\n    guards: seed.state.guards.size,\n    contradictions: seed.state.contradictions.length,\n    justifications: seed.state.justifications.size,\n    decisionIds: decisions.map((decision) => String(decision.id)).sort(),\n    labels: decisions.map((decision) => decision.id + \"=\" + decision.label).sort(),\n    durationMs,\n  };\n}\n\nfunction emptyFingerprint(durationMs: number): DryRunFingerprint {\n  return {\n    decisions: 0, premises: 0, alternatives: 0, guards: 0, contradictions: 0, justifications: 0,\n    decisionIds: [], labels: [], durationMs,\n  };\n}\n\nfunction compare(runs: readonly DryRun[]): readonly string[] {\n  const out: string[] = [];\n  const first = runs[0];\n  if (first === undefined) return [\"no runs completed\"];\n\n  for (const run of runs.slice(1)) {\n    if (run.error !== null) {\n      out.push(\"run \" + run.n + \" threw: \" + run.error);\n      continue;\n    }\n    if (first.error !== null) continue;\n\n    const fields: (keyof DryRunFingerprint)[] = [\n      \"decisions\", \"premises\", \"alternatives\", \"guards\", \"contradictions\", \"justifications\",\n    ];\n\n    for (const field of fields) {\n      const a = first.fingerprint[field];\n      const b = run.fingerprint[field];\n      if (typeof a === \"number\" && typeof b === \"number\" && a !== b) {\n        out.push(field + \": run 1 had \" + a + \", run \" + run.n + \" had \" + b);\n      }\n    }\n\n    if (first.fingerprint.labels.join(\"|\") !== run.fingerprint.labels.join(\"|\")) {\n      const differing = run.fingerprint.labels.filter((entry) => !first.fingerprint.labels.includes(entry));\n      out.push(\n        \"LABELS DIVERGED between run 1 and run \" + run.n + \" ΓÇö the same input produced different \" +\n        \"epistemic states. Counts alone would not have caught this. Differing: \" +\n        (differing.length === 0 ? \"(reordered only)\" : differing.slice(0, 6).join(\", \")),\n      );\n    }\n\n    if (first.fingerprint.decisionIds.join(\"|\") !== run.fingerprint.decisionIds.join(\"|\")) {\n      out.push(\"IDS DIVERGED between run 1 and run \" + run.n + \" ΓÇö a counter depends on something other than the input.\");\n    }\n  }\n\n  return out;\n}\n\nexport function renderDryRuns(report: DryRunReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"DRY RUNS ΓÇö \" + report.runs.length + \" consecutive, no reset between them\");\n  lines.push(report.passed ? \"PASSED: deterministic and demoable across all runs.\" : \"NOT PASSED.\");\n  lines.push(\"\");\n\n  lines.push(\"Run\".padEnd(5) + \"dec\".padStart(5) + \"prem\".padStart(6) + \"alt\".padStart(5) +\n    \"grd\".padStart(5) + \"contra\".padStart(8) + \"just\".padStart(6) + \"  verified/manual/failed\".padEnd(26) + \"secs\");\n  lines.push(\"-\".repeat(78));\n\n  for (const run of report.runs) {\n    const f = run.fingerprint;\n    const v = run.verification;\n    if (v === null) {\n      lines.push(String(run.n).padEnd(5) + \"  THREW ΓÇö \" + (run.error ?? \"unknown\"));\n      continue;\n    }\n    lines.push(\n      String(run.n).padEnd(5) +\n      String(f.decisions).padStart(5) + String(f.premises).padStart(6) + String(f.alternatives).padStart(5) +\n      String(f.guards).padStart(5) + String(f.contradictions).padStart(8) + String(f.justifications).padStart(6) +\n      (\"  \" + v.verified + \"/\" + v.manual + \"/\" + v.failed).padEnd(26) +\n      (f.durationMs / 1000).toFixed(1),\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\"Timings are shown but NOT compared: they vary with machine load, and treating a slow run as\");\n  lines.push(\"non-determinism teaches the presenter to ignore this report.\");\n\n  if (report.divergences.length > 0) {\n    lines.push(\"\");\n    lines.push(\"DIVERGENCES (\" + report.divergences.length + \"):\");\n    for (const divergence of report.divergences) lines.push(\"  \" + divergence);\n  } else {\n    lines.push(\"\");\n    lines.push(\"No divergences. Runs 2 and 3 started from whatever run 1 left in storage and produced\");\n    lines.push(\"identical node counts, identical labels and identical ids.\");\n  }\n\n  const warnings = report.runs.flatMap((run) => run.warnings.map((warning) => \"run \" + run.n + \": \" + warning));\n  if (warnings.length > 0) {\n    lines.push(\"\");\n    lines.push(\"WARNINGS:\");\n    for (const warning of [...new Set(warnings)]) lines.push(\"  \" + warning);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metric 3 ΓÇö alternative extraction precision.\n *import type { ResolvedAlternative, ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { aligntype Alignment, MATCH_RULE,  } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, type MetricResult, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface AlternativeOutcome {\nexport type { AlternativeId };\n","ops":[{"diffOp":{"equal":{"range":[0,56]}}},{"equalLines":{"line_count":30}},{"diffOp":{"equal":{"range":[56,187]}}},{"diffOp":{"delete":{"range":[187,192]}}},{"diffOp":{"insert":{"range":[192,206]}}},{"diffOp":{"equal":{"range":[206,220]}}},{"diffOp":{"delete":{"range":[192,206]}}},{"diffOp":{"insert":{"range":[187,192]}}},{"diffOp":{"equal":{"range":[220,275]}}},{"diffOp":{"insert":{"range":[275,294]}}},{"diffOp":{"equal":{"range":[294,327]}}},{"diffOp":{"delete":{"range":[327,346]}}},{"diffOp":{"equal":{"range":[346,403]}}},{"equalLines":{"line_count":91}},{"diffOp":{"equal":{"range":[403,435]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\alternative.ts"},"span":null,"sourceCode":"/**\n * Metric 3 ΓÇö alternative extraction precision.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: ARGUS, 15.4% precision, alpha 0.64, FP:FN 13:1 (arXiv:2604.10345, docs/05 ┬º4.3).\n *\n * ---------------------------------------------------------------------------\n * PRECISION IS THE HEADLINE BECAUSE ARGUS SAYSO\n *\n * ARGUS found alternatives to be the worst-measured rationale component in the literature: 15.4%\n * precision with a false-positive-to-false-negative ratio of 13:1. The system produces fifteen wrong\n * alternatives for every one it misses. That ratio matters more than the absolute number, because it\n * says the failure is not caution but noise ΓÇö and noise is what makes a user stop reading the panel.\n *\n * So this metric reports precision first and the FP:FN ratio beside it, rather than leading with F1.\n * F1 would blend a catastrophic precision with a good recall into a number that looks acceptable, and\n * the whole reason ARGUS's result is memorable is that the blend hides the problem.\n *\n * ---------------------------------------------------------------------------\n * AN ALTERNATIVE WITHOUT `whyRejected` IS NOT A FALSE POSITIVE\n *\n * The corpus distinguishes alternatives that were rejected for a stated reason from ones merely\n * mentioned. The system stores both but only pre-empts on the former, and only the latter kind is a\n * plausible false positive: mentioning Redis is not an error, claiming Redis was rejected when nobody\n * rejected it is. Precision is therefore computed over ALL extracted alternatives, and a second number\n * ΓÇö pre-emption eligibility precision ΓÇö is computed over the ones the system would actually act on.\n * Reporting only the first would understate the risk; reporting only the second would overstate the\n * system's restraint.\n * ---------------------------------------------------------------------------\n */\n\nimport type { AlternativeId, EngineId, TranscriptId } from \"@/types/common\";\nimport type { RejectedAlternative } from \"@/types/domain\";\nimport type { ResolvedAlternative, ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface AlternativeOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedAlternative, RejectedAlternative>;\n  readonly fpToFnRatio: string;\n  /** Precision over the alternatives the system would actually pre-empt on. */\n  readonly preemptionPrecision: number;\n  readonly preemptionEligible: number;\n}\n\nexport function scoreAlternativeExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): AlternativeOutcome {\n  const labels: ResolvedAlternative[] = [];\n  for (const transcript of corpus.transcripts) {\n    for (const alternative of transcript.alternatives) {\n      /* `expectConfirmed` is the alternative-level form of \"should this become a node\": true when the\n       * transcript actually REJECTS the alternative, false when it merely mentions it. Alternatives\n       * need explicit confirmation before they may pre-empt anything, so a mention is not a miss. */\n      if (!alternative.expectConfirmed) continue;\n      labels.push(alternative);\n    }\n  }\n\n  const nodes: RejectedAlternative[] = [...run.state.alternatives.values()];\n\n  /* An alternative carries no transcript of its own ΓÇö it belongs to the decision it was rejected in\n   * favour of ΓÇö so eligibility goes through that decision's provenance. This is the same transcript\n   * test the decision metric applies, and without it a label from c01 could match a node extracted\n   * from m02 merely because their character spans overlap in two differently-numbered documents.\n   * That match would be scored as a true positive that never happened. */\n  const ownerOf = new Map<AlternativeId, TranscriptId>();\n  for (const alternative of nodes) {\n    const decision = run.state.decisions.get(alternative.decisionId);\n    if (decision !== undefined) ownerOf.set(alternative.id, decision.provenance.transcriptId);\n  }\n\n  const alignment = align(\n    labels,\n    nodes,\n    (label) => label.span,\n    (node) => ({ start: node.snippet.start, end: node.snippet.end }),\n    (label, node) => {\n      const owner = ownerOf.get(node.id);\n      if (owner === undefined) return false;\n      const entry = run.transcripts.find((candidate) => candidate.runtimeId === owner);\n      /* `label.transcript` is carried on the label precisely so this needs no search. */\n      return entry !== undefined && entry.transcript.id === label.transcript;\n    },\n  );\n\n  const detail = precisionRecall(alignment.truePositives, alignment.falsePositives, alignment.falseNegatives);\n\n  /* ARGUS's ratio, restated. Reported as a string because 13:1 is how the literature writes it and a\n   * decimal would invite a comparison with a different quantity. */\n  const fpToFnRatio =\n    detail.falseNegatives === 0\n      ? detail.falsePositives + \":0 (no misses to compare against)\"\n      : detail.falsePositives + \":\" + detail.falseNegatives +\n        \" (\" + (detail.falsePositives / detail.falseNegatives).toFixed(1) + \" FP per FN)\";\n\n  /* Pre-emption eligibility: an alternative only enters the pre-emption index with an explicit\n   * whyRejected AND human confirmation. Counting precision over just those answers the question a user\n   * actually has ΓÇö \"when the system warns me I am re-proposing something rejected, is it right?\" */\n  const eligible = nodes.filter((node) => node.whyRejected !== undefined);\n  const eligibleLabels = labels.filter((label) => label.whyRejected !== undefined);\n  const eligibleHits = alignment.pairs.filter((pair) => pair.node.whyRejected !== undefined).length;\n  const preemptionPrecision = eligible.length === 0 ? 0 : eligibleHits / eligible.length;\n\n  return {\n    alignment,\n    fpToFnRatio,\n    preemptionPrecision,\n    preemptionEligible: eligible.length,\n    metric: {\n      id: \"alternative-precision\",\n      name: METRIC_NAMES[\"alternative-precision\"],\n      value: detail.precision,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.precision, n: labels.length, detail }],\n      comparator: COMPARATORS[\"alternative-precision\"] ?? null,\n      gloss:\n        detail.precision.toFixed(3) + \" precision against ARGUS's 0.154; FP:FN \" + fpToFnRatio +\n        \" against ARGUS's 13:1. \" + eligible.length + \" alternative(s) carry a stated rejection reason and \" +\n        (preemptionPrecision * 100).toFixed(0) + \"% of those are correct ΓÇö the subset the system would act on.\",\n      honestNote:\n        \"Precision is the headline because ARGUS's finding is a PRECISION finding; F1 would blend a bad precision with a \" +\n        \"good recall into a number that looks acceptable. Matched by \" + MATCH_RULE + \", requiring the variable to agree. \" +\n        \"n=\" + labels.length + \" labelled alternatives, of which \" + eligibleLabels.length + \" state a rejection reason. \" +\n        \"The corpus is small enough that a single spurious alternative moves precision by several points, so the count is \" +\n        \"reported beside the ratio and neither should be quoted without it.\",\n    },\n  };\n}\n\nexport type { AlternativeId };\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The demo script ΓÇö 7.5.\n *\nexport type ViewId =\n  | \"foundation\" \n  | \"review\"| \"reasoning\"| \"ask\"| \"guards\"| \"export\"\n  | \"graph\"| \"timeline\"| \"health\"| \"time-machine\"| \"settings\";\n\nexport interface Beat {    view: \"foundation\",\n    action: \"Load the seed and show the SQLite decision with its premises expanded.\",\n    expect:\n      \"A decision card reading 'Use SQLite, not Postgres' with two premises beneath it: single-user, and no deploy infrastructure.\",\n    say:\n      \"This is a decision an AI agent helped me make in October. Every tool that stores this stores the \" +    view: \"graph\",\n    action: \"Open the graph view and highlight the SQLite decision and its premise column.\",\n    expect:\"A bipartite lattice: premises in one column, decisions in another, edges from the SQLite decision to both of its premises.\",\n    say:\n      \"The graph is bipartite on purpose. Decisions on one side, assumptions on the other. The layout is \" +    seconds: 40,\n    view: \"reasoning\",\n    action:\"Quick-log the reversal: 'actually let's switch to Postgres, we need concurrent writes'.\",\n    expect:\"A contradiction is raised between the new Postgres decision and the October SQLite decision, and the older one moves to superseded.\",\n    say:\n      \"Now I contradict myself. This is the part every tool can do ΓÇö you said SQLite, now you said \" +    seconds: 45,\n    view: \"foundation\",\n    action:\"Import the second fixture ΓÇö the November transcript ΓÇö and show that it never mentions databases.\",\n    expect:\"The transcript is imported and its decisions appear. None of them is about a database. Scroll the text to prove it: the word appears nowhere.\",\n    say:\n      \"Here is a transcript from a month later. Read it. There is no database decision in it. There is no \" +    seconds: 60,\n    view: \"reasoning\",\n    action:\"Show the SQLite decision's label change to unsound, with the reason naming the falsified premise.\",\n    expect:\"The October SQLite decision is marked OUT, and the reason names the concurrent-writers exclusion ΓÇö a premise that was in the OUT-list of its justification.\",\n    say:\n      \"Nothing contradicted me. I never said the word database. The world moved, and the log noticed ΓÇö \" +    seconds: 35,\n    view: \"graph\",\n    action:\"Replay the cascade and show that decisions sharing no premise with the falsified one keep their labels.\",\n    expect:\"The cascade animation flips the SQLite decision and leaves unrelated decisions untouched. The survivors are visibly still IN.\",\n    say:\n      \"A cascade that retracts everything reachable is worse than no cascade. Watch what does NOT change: \" +    seconds: 30,\n    view: \"guards\",\n    action:\"Show the guards proposed for the Postgres decision, and the verify command compiled from them.\",\n    expect: \"A list of PROPOSED guards ΓÇö not installed ΓÇö with a copyable verify command.\",\n    say:    seconds: 30,\n    view: \"export\",\n    action:\"Export to CLAUDE.md and show the rejected-alternatives block and the consistency stamp.\",\n    expect:\"A CLAUDE.md with imperative MUST/MUST NOT rules scoped to globs, a rejected block, and a stamp whose digest covers the body.\",\n    say:\n      \"And it exports to what your agent actually reads ΓÇö CLAUDE.md, AGENTS.md, .cursorrules ΓÇö with the \" +  const lines: string[] = [];\n\n  lines.push(\"DEMO SCRIPT ΓÇö \" +script.length +\" beats, \" +totalSeconds(script) +\"s (\" +\n      (totalSeconds(script) / 60).toFixed(1) +\" min)\",\n  );\n  lines.push(\"Cuttable if running long: \" +cuttableBeats(script)\n        .map((beat) => \"beat \" + beat.n).join(\", \"));\n  lines.push(\"\");\n\n  for (const beat of script) {\n    lines.push(\"BEAT \" +beat.n +\" ┬╖ \" +beat.seconds +\"s ┬╖ \" +beat.view +\" ┬╖ check: \" +beat.check +\n        (beat.killer === \"none\" ? \"\" : \" ┬╖ exposes: \" + beat.killer),\n    );\n    lines.push(\"  DO:     \" + beat.action);\n    lines.push(\"  SEE:    \" + beat.expect);  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,34]}}},{"equalLines":{"line_count":27}},{"diffOp":{"equal":{"range":[34,72]}}},{"diffOp":{"delete":{"range":[72,73]}}},{"diffOp":{"insert":{"range":[73,76]}}},{"diffOp":{"equal":{"range":[76,86]}}},{"diffOp":{"delete":{"range":[72,73]}}},{"diffOp":{"insert":{"range":[73,76]}}},{"diffOp":{"equal":{"range":[86,99]}}},{"diffOp":{"delete":{"range":[72,73]}}},{"diffOp":{"insert":{"range":[73,76]}}},{"diffOp":{"equal":{"range":[99,106]}}},{"diffOp":{"delete"