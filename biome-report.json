nge":[1191,1212]}}},{"diffOp":{"delete":{"range":[429,430]}}},{"diffOp":{"insert":{"range":[314,323]}}},{"diffOp":{"equal":{"range":[1212,1240]}}},{"diffOp":{"delete":{"range":[429,430]}}},{"diffOp":{"insert":{"range":[994,1002]}}},{"diffOp":{"equal":{"range":[1240,1256]}}},{"equalLines":{"line_count":3}},{"diffOp":{"equal":{"range":[1256,1461]}}},{"diffOp":{"delete":{"range":[429,430]}}},{"diffOp":{"insert":{"range":[314,319]}}},{"diffOp":{"equal":{"range":[1461,1475]}}},{"diffOp":{"delete":{"range":[429,430]}}},{"diffOp":{"insert":{"range":[314,319]}}},{"diffOp":{"equal":{"range":[1475,1501]}}},{"diffOp":{"delete":{"range":[429,430]}}},{"diffOp":{"insert":{"range":[314,323]}}},{"diffOp":{"equal":{"range":[1501,1566]}}},{"diffOp":{"delete":{"range":[429,430]}}},{"diffOp":{"insert":{"range":[314,323]}}},{"diffOp":{"equal":{"range":[1566,1579]}}},{"diffOp":{"delete":{"range":[313,314]}}},{"diffOp":{"insert":{"range":[994,1002]}}},{"diffOp":{"equal":{"range":[1579,1599]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[1599,1719]}}},{"diffOp":{"delete":{"range":[1599,1600]}}},{"diffOp":{"insert":{"range":[833,836]}}},{"diffOp":{"equal":{"range":[1719,1746]}}},{"diffOp":{"delete":{"range":[1599,1600]}}},{"diffOp":{"insert":{"range":[833,836]}}},{"diffOp":{"equal":{"range":[1746,1764]}}},{"diffOp":{"delete":{"range":[313,314]}}},{"diffOp":{"insert":{"range":[1764,1766]}}},{"diffOp":{"equal":{"range":[1766,1836]}}},{"equalLines":{"line_count":17}},{"diffOp":{"equal":{"range":[1836,1955]}}},{"diffOp":{"insert":{"range":[1955,1961]}}},{"diffOp":{"equal":{"range":[1961,1973]}}},{"diffOp":{"delete":{"range":[1836,1837]}}},{"diffOp":{"insert":{"range":[314,319]}}},{"diffOp":{"equal":{"range":[1973,1996]}}},{"diffOp":{"delete":{"range":[1836,1837]}}},{"diffOp":{"insert":{"range":[314,319]}}},{"diffOp":{"equal":{"range":[1996,2009]}}},{"diffOp":{"delete":{"range":[1836,1837]}}},{"diffOp":{"insert":{"range":[314,319]}}},{"diffOp":{"equal":{"range":[2009,2036]}}},{"diffOp":{"delete":{"range":[1836,1837]}}},{"diffOp":{"insert":{"range":[314,319]}}},{"diffOp":{"equal":{"range":[2036,2087]}}},{"diffOp":{"insert":{"range":[2087,2091]}}},{"diffOp":{"equal":{"range":[2091,2095]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\kit.ts"},"span":null,"sourceCode":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THE SEED STATE IS BUILT, NOT CHECKED IN\n *\n * A demo needs to start from a known graph. The obvious implementation is a JSON dump of a graph\n * committed to the repo. That is wrong here for a specific reason: a checked-in state is a snapshot of\n * whatever the extraction pipeline produced on the day it was saved, and the moment extraction changes\n * the demo is showing the audience a graph the product no longer builds. The presenter would be\n * describing behaviour the code does not have.\n *\n * So the seed is BUILT at load time from the two demo fixtures through the real pipeline. It is slower\n * by a second or two and it cannot drift. A demo that shows the shipping code path is worth two seconds.\n *\n * ---------------------------------------------------------------------------\n * RESET IS A WIPE, NOT AN UNDO\n *\n * One-click reset clears every WhyLog storage key and rebuilds the seed. It does not attempt to reverse\n * the events of a live demo, because invariant I1 says nothing is deleted ΓÇö an undo would have to\n * rewrite the log, and a demo that rewrites its own hash chain in front of an audience is a demo that\n * has just contradicted its first claim.\n * ---------------------------------------------------------------------------\n */\n\nimport { createLocalEngine, localEngineId } from \"@/ai/local\";\nimport { nowISO } from \"@/lib/format\";\nimport { appendBatch, emptyLog, fold, type EventLog } from \"@/substrate\";\nimport { STORAGE_KEYS } from \"./keys\";\nimport type { EngineId, ISODateString } from \"@/types/common\";\nimport type { GraphState } from \"@/substrate/graph-state\";\n\n/** The storage keys a reset must clear. Listed here rather than scattered, because a reset that misses\n *  one key leaves the next demo starting from the previous one's state ΓÇö the failure is invisible until\n *  the presenter is three beats in and the graph has nodes nobody imported. */\nexport const RESET_KEYS: readonly string[] = STORAGE_KEYS;\n\nexport interface SeedResult {\n  readonly log: EventLog;\n  readonly state: GraphState;\n  readonly engineId: EngineId;\n  readonly builtAt: ISODateString;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly durationMs: number;\n  /** Anything that went wrong while building. A seed that built with warnings still loads, and the\n   *  presenter needs to know before the demo rather than discovering it on stage. */\n  readonly warnings: readonly string[];\n}\n\n/**\n * Build the seed graph from the demo fixtures through the real pipeline.\n *\n * Delegates to the eval harness rather than reimplementing an import path, because two import paths\n * would eventually disagree and the demo would be exercising the one the metrics do not measure.\n */\nexport async function buildSeed(): Promise<SeedResult> {\n  const started = Date.now();\n  const engine = createLocalEngine();\n  const engineId = localEngineId();\n  const warnings: string[] = [];\n\n  const { corpus, CORPUS_ROOT } = await import(\"../corpus/data\");\n  const { loadCorpus } = await import(\"../corpus/loader\");\n  const { runConfig } = await import(\"../harness\");\n  const { FULL, DEFAULT_PARAMS } = await import(\"../ablation/toggles\");\n\n  const loaded = loadCorpus(corpus, CORPUS_ROOT);\n\n  if (loaded.missingFiles.length > 0) {\n    warnings.push(loaded.missingFiles.length + \" corpus file(s) missing: \" + loaded.missingFiles.join(\", \"));\n  }\n  if (loaded.unresolved.length > 0) {\n    warnings.push(loaded.unresolved.length + \" corpus label(s) do not resolve ΓÇö the seed will still build, but the metrics would not be trustworthy.\");\n  }\n\n  /* Only the two demo fixtures are seeded. The full twelve-transcript corpus produces a graph too large\n   * to walk an audience through in five minutes, and the demo's job is the L1 reversal and the L2\n   * premise invalidation, both of which live entirely in these two files. */\n  const demoOnly = {\n    ...loaded.corpus,\n    transcripts: loaded.corpus.transcripts.filter((transcript) =>\n      transcript.id === \"demo1\" || transcript.id === \"demo2\",\n    ),\n    questions: loaded.corpus.questions.filter((question) => question.id === \"q1\" || question.id === \"q8\"),\n    plants: loaded.corpus.plants.filter((plant) =>\n      plant.id === \"L1-sqlite\" || plant.id === \"L2-premise-falsified\",\n    ),\n  };\n\n  const run = await runConfig(demoOnly, {\n    id: \"demo-seed\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  for (const entry of run.transcripts) {\n    if (!entry.ok) warnings.push(\"fixture \" + entry.transcript.id + \" failed to import: \" + (entry.failure ?? \"unknown\"));\n  }\n\n  return {\n    log: rebuildLog(run),\n    state: run.state,\n    engineId,\n    builtAt: nowISO(),\n    decisions: run.state.decisions.size,\n    premises: run.state.premises.size,\n    durationMs: Date.now() - started,\n    warnings,\n  };\n}\n\n/**\n * The event log behind a completed run.\n *\n * The harness keeps its log local and returns only the folded state, because metrics score states. The\n * demo needs the log too, since the app persists and replays events rather than snapshots ΓÇö so it is\n * reconstructed by re-folding the state's own event list, which is authoritative and hash-chained.\n */\nfunction rebuildLog(run: { state: GraphState }): EventLog {\n  const log = emptyLog();\n  const appended = appendBatch(\n    log,\n    run.state.events.map((event) => ({\n      draft: { type: event.type, payload: event.payload, actor: event.actor, reason: event.reason },\n      context: { now: event.at, actor: event.actor, reason: event.reason, occurredAt: event.occurredAt },\n    })),\n  );\n\n  /* Re-appending sealed events re-mints ids and re-stamps times, so the chain will not match the\n   * original. That is acceptable for a seed ΓÇö the app reseals on import via `substrate/portability.ts`,\n   * which is the supported path for bringing an external log in ΓÇö but it is not acceptable to pretend\n   * otherwise, so the reconstruction folds rather than claiming to restore. */\n  return appended.ok ? appended.log : fold(run.state.events, { engine: run.state.computedAt ? localEngineId() : localEngineId(), now: nowISO() }) && emptyLog();\n}\n\n/**\n * One-click reset.\n *\n * Clears every WhyLog key and reports what it cleared. Idempotent: resetting twice is the same as\n * resetting once, which matters because a presenter who is unsure whether the reset landed will press it\n * again, and a reset that compounds would be worse than none.\n */\nexport function resetDemo(storage: Storage | null): { cleared: readonly string[]; available: boolean } {\n  if (storage === null) return { cleared: [], available: false };\n\n  const cleared: string[] = [];\n  for (const key of RESET_KEYS) {\n    if (storage.getItem(key) !== null) {\n      storage.removeItem(key);\n      cleared.push(key);\n    }\n  }\n\n  return { cleared, available: true };\n}\n\n/** What the reset did, as a sentence a presenter can read aloud if asked. */\nexport function describeReset(result: { cleared: readonly string[]; available: boolean }): string {\n  if (!result.available) {\n    return \"No storage backend available ΓÇö the demo is running in memory and a page reload is the reset.\";\n  }\n  if (result.cleared.length === 0) {\n    return \"Nothing to clear: storage was already empty. Reset is idempotent, so this is a clean start.\";\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n"},"tags":[],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metric 6 ΓÇö cascade correctness at L3 (propagation), and metric 7, survivor preservation.\n *import type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { plantIsTestable, type Resolver, plantIsTestable } from \"./resolve\";\nimport { METRIC_NAMES, describeEngineId, type MetricResult, describeEngineId } from \"./types\";\n\nexport interface PlantOutcome {  return decision !== undefined && (decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,100]}}},{"equalLines":{"line_count":40}},{"diffOp":{"equal":{"range":[100,210]}}},{"diffOp":{"delete":{"range":[210,227]}}},{"diffOp":{"equal":{"range":[227,240]}}},{"diffOp":{"insert":{"range":[240,257]}}},{"diffOp":{"equal":{"range":[257,301]}}},{"diffOp":{"delete":{"range":[301,319]}}},{"diffOp":{"equal":{"range":[319,336]}}},{"diffOp":{"insert":{"range":[336,354]}}},{"diffOp":{"equal":{"range":[354,405]}}},{"equalLines":{"line_count":157}},{"diffOp":{"equal":{"range":[405,504]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\cascade.ts"},"span":null,"sourceCode":"/**\n * Metric 6 ΓÇö cascade correctness at L3 (propagation), and metric 7, survivor preservation.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: NONE PUBLISHED for either. No surveyed system cascades a retraction at all.\n *\n * ---------------------------------------------------------------------------\n * ONE METRIC, TWO HALVES, AND THE SECOND HALF IS THE ONE THAT MATTERS\n *\n * Cascade correctness is not \"did the right nodes flip\". It is \"did the right nodes flip AND the wrong\n * ones stay put\". A cascade that retracts everything reachable is perfectly correct on the first half\n * and catastrophic in use: the user falsifies one assumption about team size and eleven unrelated\n * decisions vanish from the graph. They will never trust it again, and they will be right not to.\n *\n * So the score is a strict conjunction per plant ΓÇö flips AND survivors ΓÇö and survivor preservation is\n * additionally reported on its own, because it is the number that predicts whether the product\n * survives contact with a real project. ┬º7.2 calls it one of the two unusual metrics; ┬º7.4 names\n * cascade over-retraction as the first of four demo-killers. Both point here.\n *\n * ---------------------------------------------------------------------------\n * THE PLANTED CASE IS BUILT TO DISTINGUISH THE TWO\n *\n * `l03` puts three decisions on deliberately different support:\n *   d1 pooling           rests on single-user ALONE\n *   d2 migration tooling rests on scope ALONE\n *   d3 read replicas     rests on single-user AND no-deploy-infra\n *\n * Falsifying single-user must flip d1, spare d2 entirely, and leave d3 to its remaining support. Three\n * different correct behaviours from one intervention, and each one distinguishes a different wrong\n * implementation: a cascade that flips d2 is following edges rather than justifications; one that flips\n * d3 is treating support as all-or-nothing.\n *\n * ---------------------------------------------------------------------------\n * AN UNRESOLVABLE SURVIVOR IS A FAILURE, NOT A SKIP\n *\n * If the decision that was supposed to survive was never extracted, the survivor cannot be verified and\n * the plant is scored as failed. Skipping it would report a cascade correctness computed only over the\n * plants that happened to extract cleanly ΓÇö a number that improves as extraction gets worse, which is\n * the exact inverse of what a benchmark should do.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { plantIsTestable, type Resolver } from \"./resolve\";\nimport { METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface PlantOutcome {\n  readonly plant: string;\n  readonly testable: boolean;\n  readonly interventionApplied: boolean;\n  readonly expectedFlips: readonly string[];\n  readonly flipped: readonly string[];\n  readonly missedFlips: readonly string[];\n  readonly expectedSurvivors: readonly string[];\n  readonly survived: readonly string[];\n  /** Survivors that were retracted. Each one is an over-retraction ΓÇö the demo-killer. */\n  readonly overRetracted: readonly string[];\n  readonly unresolvable: readonly string[];\n  readonly correct: boolean;\n}\n\nexport interface CascadeOutcome {\n  readonly correctness: MetricResult;\n  readonly survivorship: MetricResult;\n  readonly perPlant: readonly PlantOutcome[];\n  readonly overRetractions: number;\n  readonly survivorsExpected: number;\n}\n\nconst UNSOUND = new Set([\"OUT\", \"UNFOUNDED\"]);\n\nexport function scoreCascade(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): CascadeOutcome {\n  const plants = corpus.plants.filter((plant) => plant.kind === \"L3-cascade\" || plant.kind === \"L2-premise\");\n\n  const perPlant: PlantOutcome[] = plants.map((plant) => {\n    const testable = plantIsTestable(run, plant.transcripts);\n\n    /* An L3 plant is only testable if its intervention actually landed. An L2 plant has no\n     * intervention ΓÇö the falsification must come out of the transcript ΓÇö so it is testable whenever its\n     * transcripts imported. */\n    const interventionApplied =\n      plant.falsify === undefined ||\n      plant.falsify.every((step) =>\n        run.interventions.some((outcome) => outcome.plant === plant.id && outcome.predicate === step.predicate && outcome.applied),\n      );\n\n    const flipped: string[] = [];\n    const missedFlips: string[] = [];\n    const survived: string[] = [];\n    const overRetracted: string[] = [];\n    const unresolvable: string[] = [];\n\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        unresolvable.push(key);\n        continue;\n      }\n      if (isUnsound(run, id)) flipped.push(key);\n      else missedFlips.push(key);\n    }\n\n    for (const key of plant.expectSurvivors) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        /* A survivor that was never extracted cannot be shown to have survived. Counted as unresolved\n         * and the plant fails, per the header: skipping it would reward poor extraction. */\n        unresolvable.push(key);\n        continue;\n      }\n      if (isUnsound(run, id)) overRetracted.push(key);\n      else survived.push(key);\n    }\n\n    const correct =\n      testable &&\n      interventionApplied &&\n      missedFlips.length === 0 &&\n      overRetracted.length === 0 &&\n      unresolvable.length === 0 &&\n      plant.expectUnsound.length + plant.expectSurvivors.length > 0;\n\n    return {\n      plant: plant.id,\n      testable,\n      interventionApplied,\n      expectedFlips: plant.expectUnsound,\n      flipped,\n      missedFlips,\n      expectedSurvivors: plant.expectSurvivors,\n      survived,\n      overRetracted,\n      unresolvable,\n      correct,\n    };\n  });\n\n  const survivorsExpected = perPlant.reduce((sum, entry) => sum + entry.expectedSurvivors.length, 0);\n  const survivorsKept = perPlant.reduce((sum, entry) => sum + entry.survived.length, 0);\n  const overRetractions = perPlant.reduce((sum, entry) => sum + entry.overRetracted.length, 0);\n\n  const correctPlants = perPlant.filter((entry) => entry.correct).length;\n  const correctnessValue = perPlant.length === 0 ? 0 : correctPlants / perPlant.length;\n\n  /* Survivor preservation is 1.0 when no survivors are expected, which is vacuous rather than perfect.\n   * The report must not print it as an achievement, so the gloss says so explicitly. */\n  const survivorValue = survivorsExpected === 0 ? 1 : survivorsKept / survivorsExpected;\n\n  return {\n    perPlant,\n    overRetractions,\n    survivorsExpected,\n    correctness: {\n      id: \"cascade-correctness-l3\",\n      name: METRIC_NAMES[\"cascade-correctness-l3\"],\n      value: correctnessValue,\n      detail: null,\n      n: perPlant.length,\n      perEngine: [{ engine: describeEngineId(engine), value: correctnessValue, n: perPlant.length, detail: null }],\n      comparator: null,\n      gloss:\n        correctPlants + \" of \" + perPlant.length + \" plant(s) were FULLY correct ΓÇö every expected flip happened and no \" +\n        \"survivor was retracted. \" + overRetractions + \" over-retraction(s) across \" + survivorsExpected + \" expected survivor(s).\",\n      honestNote:\n        \"Scored as a strict conjunction per plant: a cascade that flips the right nodes AND retracts a survivor scores 0, \" +\n        \"not partial credit, because over-retraction is the failure that destroys trust and partial credit would hide it. \" +\n        \"n=\" + perPlant.length + \" plants ΓÇö small enough that this metric is a PASS/FAIL over named cases rather than a \" +\n        \"statistical rate, and it should be quoted as such. A plant whose intervention could not be applied, or whose \" +\n        \"survivor was never extracted, is scored as FAILED rather than skipped: skipping would make the number improve as \" +\n        \"extraction worsens. No published comparator exists, because no surveyed system propagates a retraction at all.\",\n    },\n    survivorship: {\n      id: \"survivor-preservation\",\n      name: METRIC_NAMES[\"survivor-preservation\"],\n      value: survivorValue,\n      detail: null,\n      n: survivorsExpected,\n      perEngine: [{ engine: describeEngineId(engine), value: survivorValue, n: survivorsExpected, detail: null }],\n      comparator: null,\n      gloss:\n        survivorsExpected === 0\n          ? \"VACUOUS: the corpus expected no survivors in the plants that ran, so 1.0 here means nothing was tested.\"\n          : survivorsKept + \" of \" + survivorsExpected + \" decision(s) that shared no falsified premise kept their label. \" +\n            overRetractions + \" were retracted anyway.\",\n      honestNote:\n        \"One of the two metrics ┬º7.2 calls unusual, and the one that predicts whether the product survives a real project. \" +\n        \"1.0 is VACUOUS when n=0 and the gloss says so rather than printing a perfect score for an untested property ΓÇö a \" +\n        \"benchmark that reports 100% because it measured nothing is worse than one that reports 40%. n=\" + survivorsExpected +\n        \" survivors, all from the single l03 plant, so this is a check that a specific mechanism does not over-fire, not an \" +\n        \"estimate of an over-retraction RATE. Nobody publishes a comparator because nobody cascades.\",\n    },\n  };\n}\n\nfunction isUnsound(run: RunResult, id: DecisionId): boolean {\n  const labelled = run.labels.get(id);\n  if (labelled !== undefined) return UNSOUND.has(labelled.label);\n\n  const decision = run.state.decisions.get(id);\n  return decision !== undefined && (decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"`No damage was predicted for this switch, so no hypothesis was at risk. \"+\n        (${ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\")}`,\n    }];\n  }\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":120}},{"diffOp":{"equal":{"range":[68,130]}}},{"diffOp":{"equal":{"range":[130,139]}}},{"diffOp":{"delete":{"range":[139,140]}}},{"diffOp":{"insert":{"range":[140,141]}}},{"diffOp":{"equal":{"range":[141,211]}}},{"diffOp":{"delete":{"range":[211,213]}}},{"diffOp":{"equal":{"range":[68,69]}}},{"diffOp":{"delete":{"range":[213,224]}}},{"diffOp":{"insert":{"range":[224,226]}}},{"diffOp":{"equal":{"range":[226,593]}}},{"diffOp":{"delete":{"range":[593,594]}}},{"diffOp":{"insert":{"range":[594,596]}}},{"diffOp":{"equal":{"range":[596,609]}}},{"equalLines":{"line_count":195}},{"diffOp":{"equal":{"range":[609,645]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[5002,5455],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *        baselineValue,\n        ablatedValue,\n        sentence:\n          \"`Removing it moved \" + ${name(expectation.metric) + \"} by signed(delta) +\n          \", at or above the declared threshold of expectation.threshold.toFixed(2). The component earns its place on this corpus.,\n      };\n    }\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":158}},{"diffOp":{"equal":{"range":[68,130]}}},{"diffOp":{"equal":{"range":[130,141]}}},{"diffOp":{"delete":{"range":[141,142]}}},{"diffOp":{"insert":{"range":[142,143]}}},{"diffOp":{"equal":{"range":[143,161]}}},{"diffOp":{"delete":{"range":[161,165]}}},{"diffOp":{"insert":{"range":[165,167]}}},{"diffOp":{"equal":{"range":[167,191]}}},{"diffOp":{"delete":{"range":[191,195]}}},{"diffOp":{"insert":{"range":[195,196]}}},{"diffOp":{"equal":{"range":[196,200]}}},{"diffOp":{"delete":{"range":[161,165]}}},{"diffOp":{"insert":{"range":[165,167]}}},{"diffOp":{"equal":{"range":[200,213]}}},{"diffOp":{"delete":{"range":[213,227]}}},{"diffOp":{"insert":{"range":[195,196]}}},{"diffOp":{"equal":{"range":[227,267]}}},{"diffOp":{"delete":{"range":[161,165]}}},{"diffOp":{"insert":{"range":[165,167]}}},{"diffOp":{"equal":{"range":[267,299]}}},{"diffOp":{"delete":{"range":[213,227]}}},{"diffOp":{"insert":{"range":[195,196]}}},{"diffOp":{"equal":{"range":[299,346]}}},{"diffOp":{"delete":{"range":[161,162]}}},{"diffOp":{"insert":{"range":[142,143]}}},{"diffOp":{"equal":{"range":[346,362]}}},{"equalLines":{"line_count":158}},{"diffOp":{"equal":{"range":[362,398]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[6700,6924],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *        baselineValue,\n        ablatedValue,\n        sentence:\n          \"`Removing it moved \"+ ${name(expectation.metric) + \"} by \" + signed(delta) +\n          \", below the NOISE_FLOOR.toFixed(2) noise floor for a twelve-transcript corpus.+\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small totell, and those are different claims.,\n      };\n    }\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":173}},{"diffOp":{"equal":{"range":[68,130]}}},{"diffOp":{"equal":{"range":[130,141]}}},{"diffOp":{"delete":{"range":[141,142]}}},{"diffOp":{"insert":{"range":[142,143]}}},{"diffOp":{"equal":{"range":[143,160]}}},{"diffOp":{"delete":{"range":[160,162]}}},{"diffOp":{"equal":{"range":[68,69]}}},{"diffOp":{"delete":{"range":[162,164]}}},{"diffOp":{"insert":{"range":[164,166]}}},{"diffOp":{"equal":{"range":[166,190]}}},{"diffOp":{"delete":{"range":[190,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[195,199]}}},{"diffOp":{"delete":{"range":[199,203]}}},{"diffOp":{"insert":{"range":[164,166]}}},{"diffOp":{"equal":{"range":[203,216]}}},{"diffOp":{"delete":{"range":[216,230]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[230,242]}}},{"diffOp":{"delete":{"range":[199,203]}}},{"diffOp":{"insert":{"range":[164,166]}}},{"diffOp":{"equal":{"range":[242,264]}}},{"diffOp":{"delete":{"range":[190,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[264,308]}}},{"diffOp":{"delete":{"range":[160,162]}}},{"diffOp":{"equal":{"range":[190,191]}}},{"diffOp":{"delete":{"range":[308,321]}}},{"diffOp":{"equal":{"range":[321,412]}}},{"diffOp":{"delete":{"range":[160,162]}}},{"diffOp":{"equal":{"range":[195,196]}}},{"diffOp":{"delete":{"range":[308,321]}}},{"diffOp":{"equal":{"range":[412,449]}}},{"diffOp":{"delete":{"range":[199,200]}}},{"diffOp":{"insert":{"range":[142,143]}}},{"diffOp":{"equal":{"range":[449,465]}}},{"equalLines":{"line_count":142}},{"diffOp":{"equal":{"range":[465,501]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[7208,7541],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *      baselineValue,\n      ablatedValue,\n      sentence:\n        \"`PREDICTION FALSIFIED. Removing this component moved \"+ ${name(expectation.metric) + \"} by \" +\n        signed(delta)against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is+\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishingthose needs more transcripts rather than more argument.,\n    };\n  });\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":188}},{"diffOp":{"equal":{"range":[68,124]}}},{"diffOp":{"equal":{"range":[124,133]}}},{"diffOp":{"delete":{"range":[133,134]}}},{"diffOp":{"insert":{"range":[134,135]}}},{"diffOp":{"equal":{"range":[135,186]}}},{"diffOp":{"delete":{"range":[186,188]}}},{"diffOp":{"equal":{"range":[68,69]}}},{"diffOp":{"delete":{"range":[188,190]}}},{"diffOp":{"insert":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[192,216]}}},{"diffOp":{"delete":{"range":[216,220]}}},{"diffOp":{"insert":{"range":[220,221]}}},{"diffOp":{"equal":{"range":[221,225]}}},{"diffOp":{"delete":{"range":[225,237]}}},{"diffOp":{"insert":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[237,250]}}},{"diffOp":{"delete":{"range":[216,218]}}},{"diffOp":{"insert":{"range":[220,221]}}},{"diffOp":{"equal":{"range":[216,217]}}},{"diffOp":{"delete":{"range":[225,227]}}},{"diffOp":{"equal":{"range":[250,282]}}},{"diffOp":{"delete":{"range":[282,286]}}},{"diffOp":{"insert":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[286,318]}}},{"diffOp":{"delete":{"range":[318,330]}}},{"diffOp":{"insert":{"range":[220,221]}}},{"diffOp":{"equal":{"range":[330,426]}}},{"diffOp":{"delete":{"range":[186,188]}}},{"diffOp":{"equal":{"range":[221,222]}}},{"diffOp":{"delete":{"range":[426,437]}}},{"diffOp":{"equal":{"range":[437,532]}}},{"diffOp":{"delete":{"range":[186,188]}}},{"diffOp":{"equal":{"range":[221,222]}}},{"diffOp":{"delete":{"range":[426,437]}}},{"diffOp":{"equal":{"range":[532,587]}}},{"diffOp":{"delete":{"range":[282,283]}}},{"diffOp":{"insert":{"range":[134,135]}}},{"diffOp":{"equal":{"range":[587,601]}}},{"equalLines":{"line_count":126}},{"diffOp":{"equal":{"range":[601,637]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[7764,8238],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 20 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 20 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 20 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[5520,5523],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","descriptio