\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  );\n  out.push(\"\");\n  out.push(\"`- synthesis rate: \"+ ${scored.guards.decisionsWithGuard + \"} of \" + scored.guards.decisionsTotal decisions got a proposed guard);\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":340}},{"diffOp":{"equal":{"range":[77,109]}}},{"diffOp":{"delete":{"range":[109,110]}}},{"diffOp":{"insert":{"range":[110,111]}}},{"diffOp":{"equal":{"range":[111,128]}}},{"diffOp":{"delete":{"range":[128,130]}}},{"diffOp":{"equal":{"range":[128,129]}}},{"diffOp":{"delete":{"range":[130,132]}}},{"diffOp":{"insert":{"range":[132,134]}}},{"diffOp":{"equal":{"range":[134,166]}}},{"diffOp":{"delete":{"range":[166,170]}}},{"diffOp":{"insert":{"range":[170,171]}}},{"diffOp":{"equal":{"range":[171,175]}}},{"diffOp":{"delete":{"range":[175,179]}}},{"diffOp":{"insert":{"range":[132,134]}}},{"diffOp":{"equal":{"range":[179,207]}}},{"diffOp":{"delete":{"range":[166,170]}}},{"diffOp":{"insert":{"range":[170,171]}}},{"diffOp":{"equal":{"range":[207,238]}}},{"diffOp":{"delete":{"range":[109,110]}}},{"diffOp":{"insert":{"range":[110,111]}}},{"diffOp":{"equal":{"range":[238,460]}}},{"equalLines":{"line_count":43}},{"diffOp":{"equal":{"range":[460,488]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[13689,13820],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"`- determinism share: \"+ ${scored.guards.deterministic + \"} deterministic, \" + scored.guards.judged+ \" \\`llm_judge\\`);\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":341}},{"diffOp":{"equal":{"range":[77,249]}}},{"diffOp":{"delete":{"range":[249,250]}}},{"diffOp":{"insert":{"range":[250,251]}}},{"diffOp":{"equal":{"range":[251,271]}}},{"diffOp":{"delete":{"range":[271,273]}}},{"diffOp":{"equal":{"range":[271,272]}}},{"diffOp":{"delete":{"range":[273,275]}}},{"diffOp":{"insert":{"range":[275,277]}}},{"diffOp":{"equal":{"range":[277,304]}}},{"diffOp":{"delete":{"range":[304,308]}}},{"diffOp":{"insert":{"range":[308,309]}}},{"diffOp":{"equal":{"range":[309,325]}}},{"diffOp":{"delete":{"range":[325,329]}}},{"diffOp":{"insert":{"range":[275,277]}}},{"diffOp":{"equal":{"range":[329,349]}}},{"diffOp":{"insert":{"range":[308,309]}}},{"diffOp":{"equal":{"range":[309,310]}}},{"diffOp":{"delete":{"range":[349,353]}}},{"diffOp":{"insert":{"range":[353,354]}}},{"diffOp":{"equal":{"range":[354,364]}}},{"diffOp":{"insert":{"range":[364,366]}}},{"diffOp":{"equal":{"range":[354,355]}}},{"diffOp":{"delete":{"range":[249,250]}}},{"diffOp":{"equal":{"range":[366,571]}}},{"equalLines":{"line_count":42}},{"diffOp":{"equal":{"range":[571,599]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[13834,13948],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"`- skips counted as passes (must be 0): \" + ${scored.guards.skippedCountedAsPass}`);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":342}},{"diffOp":{"equal":{"range":[77,361]}}},{"diffOp":{"delete":{"range":[361,362]}}},{"diffOp":{"insert":{"range":[362,363]}}},{"diffOp":{"equal":{"range":[363,402]}}},{"diffOp":{"delete":{"range":[402,406]}}},{"diffOp":{"insert":{"range":[406,408]}}},{"diffOp":{"equal":{"range":[408,442]}}},{"diffOp":{"insert":{"range":[442,444]}}},{"diffOp":{"equal":{"range":[444,661]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[661,689]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[13962,14040],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"`- guards auto-accepted without a human (must be 0, invariant I4): \" + ${scored.guards.autoAccepted}`);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":343}},{"diffOp":{"equal":{"range":[77,308]}}},{"diffOp":{"delete":{"range":[308,309]}}},{"diffOp":{"insert":{"range":[309,310]}}},{"diffOp":{"equal":{"range":[310,376]}}},{"diffOp":{"delete":{"range":[376,380]}}},{"diffOp":{"insert":{"range":[380,382]}}},{"diffOp":{"equal":{"range":[382,408]}}},{"diffOp":{"insert":{"range":[408,410]}}},{"diffOp":{"equal":{"range":[410,532]}}},{"equalLines":{"line_count":40}},{"diffOp":{"equal":{"range":[532,560]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[14054,14151],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"`- stale \\`disabledByDecisionLabel` flags (must be 0): \" + ${scored.guards.staleDisabledFlags}`);\n  out.push(\"\");\n  return out;  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":344}},{"diffOp":{"equal":{"range":[77,291]}}},{"diffOp":{"delete":{"range":[291,292]}}},{"diffOp":{"insert":{"range":[292,293]}}},{"diffOp":{"equal":{"range":[293,301]}}},{"diffOp":{"insert":{"range":[301,302]}}},{"diffOp":{"equal":{"range":[302,326]}}},{"diffOp":{"insert":{"range":[301,302]}}},{"diffOp":{"equal":{"range":[326,347]}}},{"diffOp":{"delete":{"range":[347,351]}}},{"diffOp":{"insert":{"range":[351,353]}}},{"diffOp":{"equal":{"range":[353,385]}}},{"diffOp":{"insert":{"range":[385,387]}}},{"diffOp":{"equal":{"range":[387,419]}}},{"equalLines":{"line_count":39}},{"diffOp":{"equal":{"range":[419,447]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[14165,14255],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"`imported in \"+ ${(run.durationMs / 1000).toFixed(1) + \"}s ┬╖ \" + run.state.decisions.size decisions);\n\n  const scored = scoreAll(resolved, run, engineId);  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":364}},{"diffOp":{"equal":{"range":[77,225]}}},{"diffOp":{"delete":{"range":[225,226]}}},{"diffOp":{"insert":{"range":[226,227]}}},{"diffOp":{"equal":{"range":[227,238]}}},{"diffOp":{"delete":{"range":[238,240]}}},{"diffOp":{"equal":{"range":[238,239]}}},{"diffOp":{"delete":{"range":[240,242]}}},{"diffOp":{"insert":{"range":[242,244]}}},{"diffOp":{"equal":{"range":[244,278]}}},{"diffOp":{"delete":{"range":[278,282]}}},{"diffOp":{"insert":{"range":[282,283]}}},{"diffOp":{"equal":{"range":[283,288]}}},{"diffOp":{"delete":{"range":[288,292]}}},{"diffOp":{"insert":{"range":[242,244]}}},{"diffOp":{"equal":{"range":[292,316]}}},{"diffOp":{"delete":{"range":[278,282]}}},{"diffOp":{"insert":{"range":[282,283]}}},{"diffOp":{"equal":{"range":[316,326]}}},{"diffOp":{"delete":{"range":[288,289]}}},{"diffOp":{"insert":{"range":[226,227]}}},{"diffOp":{"equal":{"range":[326,381]}}},{"equalLines":{"line_count":19}},{"diffOp":{"equal":{"range":[381,409]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[14957,15060],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\nmain().catch((error: unknown) => {\n  process.stderr.write(\"`\\n\" + (${error instanceof Error ? error.stack ?? error.message : String(error)) + \"});\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":385}},{"diffOp":{"equal":{"range":[77,136]}}},{"diffOp":{"delete":{"range":[136,137]}}},{"diffOp":{"insert":{"range":[137,138]}}},{"diffOp":{"equal":{"range":[138,140]}}},{"diffOp":{"delete":{"range":[140,145]}}},{"diffOp":{"insert":{"range":[145,147]}}},{"diffOp":{"equal":{"range":[147,216]}}},{"diffOp":{"delete":{"range":[216,221]}}},{"diffOp":{"insert":{"range":[221,222]}}},{"diffOp":{"equal":{"range":[138,140]}}},{"diffOp":{"delete":{"range":[140,141]}}},{"diffOp":{"insert":{"range":[137,138]}}},{"diffOp":{"equal":{"range":[222,253]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":[15793,15878],"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpustype AblationStudy, describeStudy, runAblation } from \"./corpusablationlabelsrun\";\nimport { describeLoadrenderAblationTable, renderPredictionAuditloadertable{DEFAULT_PARAMS,ResolvedCorpusFULLtoggles{ ScoredRunbanner,blank, heading, line, prepare, readArgs, write } from \"./metricsclimetricsWithoutComparator, renderSuite, unusualMetricscorpus/labels\";\nimport type { MetricResulttypesdescribeStudy, runAblation,type AblationStudy harden,renderHardeningHardeningReport,  } from \"./hardening\";\nimport { runConfig/ablationharness{ banner, blank, heading, line, prepare,readArgs,write\";\nimport { scoreAll } from \"./metrics\";\nimport \";\n\n/**  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":19}},{"diffOp":{"equal":{"range":[77,126]}}},{"diffOp":{"delete":{"range":[126,140]}}},{"diffOp":{"insert":{"range":[140,186]}}},{"diffOp":{"equal":{"range":[186,197]}}},{"diffOp":{"delete":{"range":[197,203]}}},{"diffOp":{"insert":{"range":[203,211]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[211,217]}}},{"diffOp":{"insert":{"range":[217,220]}}},{"diffOp":{"equal":{"range":[220,232]}}},{"diffOp":{"delete":{"range":[232,244]}}},{"diffOp":{"insert":{"range":[244,286]}}},{"diffOp":{"equal":{"range":[186,197]}}},{"diffOp":{"delete":{"range":[197,203]}}},{"diffOp":{"insert":{"range":[203,211]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"de