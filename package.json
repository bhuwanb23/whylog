{
  "name": "whylog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A truth maintenance system for the decisions you make while building with AI.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:structure": "node scripts/run_python.mjs scripts/check_structure.py",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx src/eval/run.ts",
    "eval:ablation": "tsx src/eval/ablation/cli.ts",
    "eval:report": "tsx src/eval/report.ts",
    "guards:ci": "tsx scripts/export_guards.ts",
    "verify": "npm run typecheck && npm run check && npm run check:structure && npm run test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "demo:verify": "tsx src/eval/demo/cli.ts",
    "demo:dryrun": "tsx src/eval/demo/cli.ts --runs 3",
    "verify:all": "npm run verify && npm run eval && npm run demo:verify",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
