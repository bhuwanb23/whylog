ines":{"line_count":651}},{"diffOp":{"equal":{"range":[1723,1752]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":null,"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : `${over + \"} over-retraction(s) across \" + ${n expected survivor(s); survivor preservation value.toFixed(3).,\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":80}},{"diffOp":{"equal":{"range":[37,183]}}},{"diffOp":{"insert":{"range":[183,186]}}},{"diffOp":{"equal":{"range":[186,190]}}},{"diffOp":{"delete":{"range":[190,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[195,222]}}},{"diffOp":{"delete":{"range":[222,226]}}},{"diffOp":{"insert":{"range":[226,228]}}},{"diffOp":{"equal":{"range":[228,229]}}},{"diffOp":{"delete":{"range":[190,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[229,274]}}},{"diffOp":{"delete":{"range":[222,226]}}},{"diffOp":{"insert":{"range":[226,228]}}},{"diffOp":{"equal":{"range":[274,290]}}},{"diffOp":{"delete":{"range":[190,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[290,291]}}},{"diffOp":{"delete":{"range":[222,223]}}},{"diffOp":{"insert":{"range":[183,184]}}},{"diffOp":{"equal":{"range":[291,409]}}},{"equalLines":{"line_count":351}},{"diffOp":{"equal":{"range":[409,438]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[3955,4070],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useOptionalChain","severity":"error","description":"Change to an optional chain.","message":[{"elements":[],"content":"Change to an optional chain."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Change to an optional chain."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *function falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2?.testable && l2.flipped.length > 0;\n\n  const detail =  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":97}},{"diffOp":{"equal":{"range":[37,241]}}},{"diffOp":{"equal":{"range":[241,243]}}},{"diffOp":{"delete":{"range":[243,263]}}},{"diffOp":{"insert":{"range":[263,264]}}},{"diffOp":{"equal":{"range":[264,274]}}},{"diffOp":{"equal":{"range":[274,317]}}},{"equalLines":{"line_count":334}},{"diffOp":{"equal":{"range":[317,346]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[4914,4945],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? `${l2.flipped.join(\", \") + \"} went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":105}},{"diffOp":{"equal":{"range":[37,161]}}},{"diffOp":{"insert":{"range":[161,164]}}},{"diffOp":{"equal":{"range":[164,185]}}},{"diffOp":{"delete":{"range":[185,189]}}},{"diffOp":{"insert":{"range":[189,190]}}},{"diffOp":{"equal":{"range":[190,215]}}},{"diffOp":{"delete":{"range":[215,216]}}},{"diffOp":{"insert":{"range":[161,162]}}},{"diffOp":{"equal":{"range":[216,401]}}},{"equalLines":{"line_count":326}},{"diffOp":{"equal":{"range":[401,430]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[5207,5258],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"`expected \" + ${l2.expectedUnsound.join(\", \") + \"} to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (}${l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\"}`;\n\n  return {  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":106}},{"diffOp":{"equal":{"range":[37,145]}}},{"diffOp":{"delete":{"range":[145,146]}}},{"diffOp":{"insert":{"range":[146,147]}}},{"diffOp":{"equal":{"range":[147,156]}}},{"diffOp":{"delete":{"range":[156,160]}}},{"diffOp":{"insert":{"range":[160,162]}}},{"diffOp":{"equal":{"range":[162,191]}}},{"diffOp":{"delete":{"range":[191,195]}}},{"diffOp":{"insert":{"range":[195,196]}}},{"diffOp":{"equal":{"range":[196,212]}}},{"diffOp":{"delete":{"range":[212,229]}}},{"diffOp":{"insert":{"range":[160,162]}}},{"diffOp":{"equal":{"range":[229,318]}}},{"diffOp":{"delete":{"range":[318,335]}}},{"diffOp":{"insert":{"range":[335,338]}}},{"diffOp":{"equal":{"range":[338,419]}}},{"diffOp":{"delete":{"range":[318,319]}}},{"diffOp":{"insert":{"range":[419,421]}}},{"diffOp":{"equal":{"range":[421,434]}}},{"equalLines":{"line_count":323}},{"diffOp":{"equal":{"range":[434,463]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[5271,5539],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? `${l2.notFlipped.join(\", \") + \"} did not\": \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":107}},{"diffOp":{"equal":{"range":[37,220]}}},{"diffOp":{"insert":{"range":[220,223]}}},{"diffOp":{"equal":{"range":[223,247]}}},{"diffOp":{"delete":{"range":[247,251]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[252,260]}}},{"diffOp":{"delete":{"range":[260,261]}}},{"diffOp":{"insert":{"range":[220,221]}}},{"diffOp":{"equal":{"range":[252,253]}}},{"diffOp":{"equal":{"range":[261,386]}}},{"equalLines":{"line_count":324}},{"diffOp":{"equal":{"range":[386,415]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[5378,5415],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"`; unresolvable: \" + ${l2.unresolvable.join(\", \")}`: \"\");\n\n  return {  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":108}},{"diffOp":{"equal":{"range":[37,264]}}},{"diffOp":{"delete":{"range":[264,265]}}},{"diffOp":{"insert":{"range":[265,266]}}},{"diffOp":{"equal":{"range":[266,282]}}},{"diffOp":{"delete":{"range":[282,286]}}},{"diffOp":{"insert":{"range":[286,288]}}},{"diffOp":{"equal":{"range":[288,314]}}},{"diffOp":{"insert":{"range":[314,316]}}},{"diffOp":{"equal":{"range":[37,38]}}},{"diffOp":{"equal":{"range":[316,334]}}},{"equalLines":{"line_count":323}},{"diffOp":{"equal":{"range":[334,363]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[5486,5533],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: `${detail + \"}. Non-empty OUT-lists in the graph: \" + ${scored.invalidation.outListPopulated,\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":118}},{"diffOp":{"equal":{"range":[37,121]}}},{"diffOp":{"insert":{"range":[121,124]}}},{"diffOp":{"equal":{"range":[124,130]}}},{"diffOp":{"delete":{"range":[130,134]}}},{"diffOp":{"insert":{"range":[134,135]}}},{"diffOp":{"equal":{"range":[135,171]}}},{"diffOp":{"delete":{"range":[171,175]}}},{"diffOp":{"insert":{"range":[175,177]}}},{"diffOp":{"equal":{"range":[177,213]}}},{"diffOp":{"delete":{"range":[130,134]}}},{"diffOp":{"insert":{"range":[134,135]}}},{"diffOp":{"equal":{"range":[135,136]}}},{"diffOp":{"delete":{"range":[171,172]}}},{"diffOp":{"insert":{"range":[121,122]}}},{"diffOp":{"equal":{"range":[213,317]}}},{"equalLines":{"line_count":313}},{"diffOp":{"equal":{"range":[317,346]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[5945,6037],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      `${modality.wronglyPromoted.length + \"} non-decision(s) became nodes out of \" + ${modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".,\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":145}},{"diffOp":{"equal":{"range":[37,156]}}},{"diffOp":{"equal":{"range":[156,163]}}},{"diffOp":{"insert":{"range":[163,166]}}},{"diffOp":{"equal":{"range":[166,197]}}},{"diffOp":{"delete":{"range":[197,201]}}},{"diffOp":{"insert":{"range":[201,202]}}},{"diffOp":{"equal":{"range":[202,239]}}},{"diffOp":{"delete":{"range":[239,243]}}},{"diffOp":{"insert":{"range":[243,245]}}},{"diffOp":{"equal":{"range":[245,270]}}},{"diffOp":{"delete":{"range":[270,280]}}},{"diffOp":{"insert":{"range":[201,202]}}},{"diffOp":{"equal":{"range":[280,318]}}},{"diffOp":{"delete":{"range":[318,329]}}},{"diffOp":{"insert":{"range":[243,245]}}},{"diffOp":{"equal":{"range":[329,502]}}},{"diffOp":{"delete":{"range":[502,507]}}},{"diffOp":{"insert":{"range":[201,202]}}},{"diffOp":{"equal":{"range":[507,508]}}},{"diffOp":{"delete":{"range":[318,319]}}},{"diffOp":{"insert":{"range":[163,164]}}},{"diffOp":{"equal":{"range":[508,632]}}},{"equalLines":{"line_count":281}},{"diffOp":{"equal":{"range":[632,661]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[7306,7646],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : `${adversarial.wronglyPromoted + \"} wrongly promoted of \" + ${adversarial.expected expected declines) + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":150}},{"diffOp":{"equal":{"range":[37,118]}}},{"diffOp":{"insert":{"range":[118,121]}}},{"diffOp":{"equal":{"range":[121,148]}}},{"diffOp":{"delete":{"range":[148,152]}}},{"diffOp":{"insert":{"range":[152,153]}}},{"diffOp":{"equal":{"range":[153,174]}}},{"diffOp":{"delete":{"range":[174,178]}}},{"diffOp":{"insert":{"range":[178,180]}}},{"diffOp":{"equal":{"range":[180,200]}}},{"diffOp":{"delete":{"range":[148,152]}}},{"diffOp":{"insert":{"range":[152,153]}}},{"diffOp":{"equal":{"range":[200,218]}}},{"diffOp":{"delete":{"range":[174,175]}}},{"diffOp":{"insert":{"range":[118,119]}}},{"diffOp":{"equal":{"range":[218,349]}}},{"equalLines":{"line_count":281}},{"diffOp":{"equal":{"range":[349,378]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[7540,7639],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      `${guards.guards + \"} guard(s) synthesised across \" + ${guards.decisionsTotaldecisions (\" +\n      (guards.synthesisRate * 100).toFixed(0)%). Invariant violations: guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, guards.autoAccepted auto-accepted, \"+ guards.staleDisabledFlags stale disabled flag(s). All three must be zero.,\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":178}},{"diffOp":{"equal":{"range":[37,144]}}},{"diffOp":{"equal":{"range":[144,151]}}},{"diffOp":{"insert":{"range":[151,154]}}},{"diffOp":{"equal":{"range":[154,167]}}},{"diffOp":{"delete":{"range":[167,171]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[172,201]}}},{"diffOp":{"delete":{"range":[201,205]}}},{"diffOp":{"insert":{"range":[205,207]}}},{"diffOp":{"equal":{"range":[207,228]}}},{"diffOp":{"delete":{"range":[167,169]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[167,168]}}},{"diffOp":{"delete":{"range":[201,203]}}},{"diffOp":{"equal":{"range":[228,239]}}},{"diffOp":{"delete":{"range":[239,249]}}},{"diffOp":{"insert":{"range":[205,207]}}},{"diffOp":{"equal":{"range":[249,288]}}},{"diffOp":{"delete":{"range":[167,171]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[288,314]}}},{"diffOp":{"delete":{"range":[201,205]}}},{"diffOp":{"insert":{"range":[205,207]}}},{"diffOp":{"equal":{"range":[314,341]}}},{"diffOp":{"delete":{"range":[341,351]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[351,377]}}},{"diffOp":{"delete":{"range":[201,205]}}},{"diffOp":{"insert":{"range":[205,207]}}},{"diffOp":{"equal":{"range":[377,396]}}},{"diffOp":{"delete":{"range":[167,171]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[396,411]}}},{"diffOp":{"delete":{"range":[411,413]}}},{"diffOp":{"equal":{"range":[396,397]}}},{"diffOp":{"delete":{"range":[413,415]}}},{"diffOp":{"insert":{"range":[205,207]}}},{"diffOp":{"equal":{"range":[415,440]}}},{"diffOp":{"delete":{"range":[341,351]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[440,488]}}},{"diffOp":{"delete":{"range":[239,240]}}},{"diffOp":{"insert":{"range":[151,152]}}},{"diffOp":{"equal":{"range":[488,612]}}},{"equalLines":{"line_count":249}},{"diffOp":{"equal":{"range":[612,641]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[8906,9270],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    `${scored.cascade.overRetractions + \"} over-retraction(s); \" + ${scored.cascade.survivorsExpected survivor(s) expected.));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":215}},{"diffOp":{"equal":{"range":[37,280]}}},{"diffOp":{"equal":{"range":[280,285]}}},{"diffOp":{"insert":{"range":[285,288]}}},{"diffOp":{"equal":{"range":[288,318]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"insert":{"range":[322,323]}}},{"diffOp":{"equal":{"range":[323,344]}}},{"diffOp":{"delete":{"range":[344,348]}}},{"diffOp":{"insert":{"range":[348,350]}}},{"diffOp":{"equal":{"range":[350,382]}}},{"diffOp":{"delete":{"range":[318,322]}}},{"diffOp":{"insert":{"range":[322,323]}}},{"diffOp":{"equal":{"range":[382,404]}}},{"diffOp":{"delete":{"range":[344,345]}}},{"diffOp":{"insert":{"range":[285,286]}}},{"diffOp":{"equal":{"range":[404,498]}}},{"equalLines":{"line_count":215}},{"diffOp":{"equal":{"range":[498,527]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[10869,10987],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    `${scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \"} expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":219}},{"diffOp":{"equal":{"range":[37,224]}}},{"diffOp":{"equal":{"range":[224,229]}}},{"diffOp":{"insert":{"range":[229,232]}}},{"diffOp":{"equal":{"range":[232,323]}}},{"diffOp":{"delete":{"range":[323,327]}}},{"diffOp":{"insert":{"range":[327,328]}}},{"diffOp":{"equal":{"range":[328,353]}}},{"diffOp":{"delete":{"range":[353,354]}}},{"diffOp":{"insert":{"range":[229,230]}}},{"diffOp":{"equal":{"range":[354,464]}}},{"equalLines":{"line_count":211}},{"diffOp":{"equal":{"range":[464,493]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[11183,11304],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    `${scored.invalidation.outListPopulated + \"} justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":231}},{"diffOp":{"equal":{"range":[37,188]}}},{"diffOp":{"equal":{"range":[188,193]}}},{"diffOp":{"insert":{"range":[193,196]}}},{"diffOp":{"equal":{"range":[196,232]}}},{"diffOp":{"delete":{"range":[232,236]}}},{"diffOp":{"insert":{"range":[236,237]}}},{"diffOp":{"equal":{"range":[237,282]}}},{"diffOp":{"delete":{"range":[282,283]}}},{"diffOp":{"insert":{"range":[193,194]}}},{"diffOp":{"equal":{"range":[283,395]}}},{"equalLines":{"line_count":199}},{"diffOp":{"equal":{"range":[395,424]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[12056,12142],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    `${scored.falsePositives.refinementVerdicts + \"} refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":251}},{"diffOp":{"equal":{"range":[37,273]}}},{"diffOp":{"equal":{"range":[273,278]}}},{"diffOp":{"insert":{"range":[278,281]}}},{"diffOp":{"equal":{"range":[281,321]}}},{"diffOp":{"delete":{"range":[321,325]}}},{"diffOp":{"insert":{"range":[325,326]}}},{"diffOp":{"equal":{"range":[326,377]}}},{"diffOp":{"delete":{"range":[377,378]}}},{"diffOp":{"insert":{"range":[278,279]}}},{"diffOp":{"equal":{"range":[378,477]}}},{"equalLines":{"line_count":179}},{"diffOp":{"equal":{"range":[477,506]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[13547,13643],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    `${scored.groundedness.searchBudgetViolations + \"} answer(s) exceeded the \" + ${3-search budget.));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":255}},{"diffOp":{"equal":{"range":[37,186]}}},{"diffOp":{"equal":{"range":[186,191]}}},{"diffOp":{"insert":{"range":[191,194]}}},{"diffOp":{"equal":{"range":[194,236]}}},{"diffOp":{"delete":{"range":[236,240]}}},{"diffOp":{"insert":{"range":[240,241]}}},{"diffOp":{"equal":{"range":[241,265]}}},{"diffOp":{"delete":{"range":[265,269]}}},{"diffOp":{"insert":{"range":[269,271]}}},{"diffOp":{"equal":{"range":[271,272]}}},{"diffOp":{"delete":{"range":[236,240]}}},{"diffOp":{"insert":{"range":[240,241]}}},{"diffOp":{"equal":{"range":[272,287]}}},{"diffOp":{"delete":{"range":[265,266]}}},{"diffOp":{"insert":{"range":[191,192]}}},{"diffOp":{"equal":{"range":[287,376]}}},{"equalLines":{"line_count":175}},{"diffOp":{"equal":{"range":[376,405]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[13801,13896],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    `${scored.groundedness.emptyAnswers + \"} empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":259}},{"diffOp":{"equal":{"range":[37,222]}}},{"diffOp":{"equal":{"range":[222,227]}}},{"diffOp":{"insert":{"range":[227,230]}}},{"diffOp":{"equal":{"range":[230,262]}}},{"diffOp":{"delete":{"range":[262,266]}}},{"diffOp":{"insert":{"range":[266,267]}}},{"diffOp":{"equal":{"range":[267,312]}}},{"diffOp":{"delete":{"range":[312,313]}}},{"diffOp":{"insert":{"range":[227,228]}}},{"diffOp":{"equal":{"range":[313,406]}}},{"equalLines":{"line_count":171}},{"diffOp":{"equal":{"range":[406,435]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[14090,14172],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    `${scored.groundedness.refusalsCorrect + \"} of \" + ${scored.groundedness.refusalsExpected unanswerable question(s) refused.));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":263}},{"diffOp":{"equal":{"range":[37,252]}}},{"diffOp":{"equal":{"range":[252,257]}}},{"diffOp":{"insert":{"range":[257,260]}}},{"diffOp":{"equal":{"range":[260,295]}}},{"diffOp":{"delete":{"range":[295,299]}}},{"diffOp":{"insert":{"range":[299,300]}}},{"diffOp":{"equal":{"range":[300,304]}}},{"diffOp":{"delete":{"range":[304,308]}}},{"diffOp":{"insert":{"range":[308,310]}}},{"diffOp":{"equal":{"range":[310,346]}}},{"diffOp":{"delete":{"range":[295,299]}}},{"diffOp":{"insert":{"range":[299,300]}}},{"diffOp":{"equal":{"range":[346,380]}}},{"diffOp":{"delete":{"range":[304,305]}}},{"diffOp":{"insert":{"range":[257,258]}}},{"diffOp":{"equal":{"range":[380,473]}}},{"equalLines":{"line_count":167}},{"diffOp":{"equal":{"range":[473,502]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[14396,14518],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    `${scored.guards.skippedCountedAsPass + \"} skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":288}},{"diffOp":{"equal":{"range":[37,201]}}},{"diffOp":{"equal":{"range":[201,206]}}},{"diffOp":{"insert":{"range":[206,209]}}},{"diffOp":{"equal":{"range":[209,243]}}},{"diffOp":{"delete":{"range":[243,247]}}},{"diffOp":{"insert":{"range":[247,248]}}},{"diffOp":{"equal":{"range":[248,286]}}},{"diffOp":{"delete":{"range":[286,287]}}},{"diffOp":{"insert":{"range":[206,207]}}},{"diffOp":{"equal":{"range":[287,382]}}},{"equalLines":{"line_count":142}},{"diffOp":{"equal":{"range":[382,411]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[16181,16258],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    `${scored.guards.autoAccepted + \"} guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":292}},{"diffOp":{"equal":{"range":[37,166]}}},{"diffOp":{"equal":{"range":[166,171]}}},{"diffOp":{"insert":{"range":[171,174]}}},{"diffOp":{"equal":{"range":[174,200]}}},{"diffOp":{"delete":{"range":[200,204]}}},{"diffOp":{"insert":{"range":[204,205]}}},{"diffOp":{"equal":{"range":[205,240]}}},{"diffOp":{"delete":{"range":[240,241]}}},{"diffOp":{"insert":{"range":[171,172]}}},{"diffOp":{"equal":{"range":[241,341]}}},{"equalLines":{"line_count":138}},{"diffOp":{"equal":{"range":[341,370]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[16396,16462],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    `${scored.guards.staleDisabledFlags + \"} stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":296}},{"diffOp":{"equal":{"range":[37,177]}}},{"diffOp":{"equal":{"range":[177,182]}}},{"diffOp":{"insert":{"range":[182,185]}}},{"diffOp":{"equal":{"range":[185,217]}}},{"diffOp":{"delete":{"range":[217,221]}}},{"diffOp":{"insert":{"range":[221,222]}}},{"diffOp":{"equal":{"range":[222,309]}}},{"diffOp":{"delete":{"range":[309,310]}}},{"diffOp":{"insert":{"range":[182,183]}}},{"diffOp":{"equal":{"range":[310,395]}}},{"equalLines":{"line_count":134}},{"diffOp":{"equal":{"range":[395,424]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[16611,16735],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    `${scored.guards.deterministic +}\" deterministic and \" +${scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on \\`isDeterministic`.));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":300}},{"diffOp":{"equal":{"range":[37,188]}}},{"diffOp":{"equal":{"range":[188,193]}}},{"diffOp":{"insert":{"range":[193,196]}}},{"diffOp":{"equal":{"range":[196,223]}}},{"diffOp":{"delete":{"range":[223,225]}}},{"diffOp":{"insert":{"range":[225,226]}}},{"diffOp":{"equal":{"range":[223,224]}}},{"diffOp":{"delete":{"range":[226,228]}}},{"diffOp":{"equal":{"range":[228,245]}}},{"diffOp":{"delete":{"range":[245,249]}}},{"diffOp":{"equal":{"range":[245,246]}}},{"diffOp":{"insert":{"range":[249,251]}}},{"diffOp":{"equal":{"range":[251,271]}}},{"diffOp":{"delete":{"range":[271,275]}}},{"diffOp":{"insert":{"range":[225,226]}}},{"diffOp":{"equal":{"range":[275,356]}}},{"diffOp":{"insert":{"range":[356,357]}}},{"diffOp":{"equal":{"range":[357,373]}}},{"diffOp":{"insert":{"range":[356,357]}}},{"diffOp":{"equal":{"range":[373,375]}}},{"diffOp":{"delete":{"range":[226,227]}}},{"diffOp":{"insert":{"range":[373,374]}}},{"diffOp":{"equal":{"range":[375,478]}}},{"equalLines":{"line_count":130}},{"diffOp":{"equal":{"range":[478,507]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[16895,17073],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[19575,19591],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  lines.push(\"\");\n\n  lines.push(\"`THE FOUR DEMO-KILLERS (\" + (${4 - report.killersFailing) + \"}/4 passing));\n  lines.push(\"\");\n  for (const killer of report.killers) {  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":407}},{"diffOp":{"equal":{"range":[37,69]}}},{"diffOp":{"delete":{"range":[69,70]}}},{"diffOp":{"insert":{"range":[70,71]}}},{"diffOp":{"equal":{"range":[71,94]}}},{"diffOp":{"delete":{"range":[94,99]}}},{"diffOp":{"insert":{"range":[99,101]}}},{"diffOp":{"equal":{"range":[101,126]}}},{"diffOp":{"delete":{"range":[126,131]}}},{"diffOp":{"insert":{"range":[131,132]}}},{"diffOp":{"equal":{"range":[132,143]}}},{"diffOp":{"delete":{"range":[94,95]}}},{"diffOp":{"insert":{"range":[70,71]}}},{"diffOp":{"equal":{"range":[143,204]}}},{"equalLines":{"line_count":24}},{"diffOp":{"equal":{"range":[204,233]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[21941,22012],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"`          visible as: \" + ${killer.visibleAs}`);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":411}},{"diffOp":{"equal":{"range":[37,166]}}},{"diffOp":{"delete":{"range":[166,167]}}},{"diffOp":{"insert":{"range":[167,168]}}},{"diffOp":{"equal":{"range":[168,190]}}},{"diffOp":{"delete":{"range":[190,194]}}},{"diffOp":{"insert":{"range":[194,196]}}},{"diffOp":{"equal":{"range":[196,212]}}},{"diffOp":{"insert":{"range":[212,214]}}},{"diffOp":{"equal":{"range":[214,358]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[358,387]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[22162,22205],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"`          evidence:   \" + ${killer.evidence}`);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":412}},{"diffOp":{"equal":{"range":[37,186]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[187,188]}}},{"diffOp":{"equal":{"range":[188,210]}}},{"diffOp":{"delete":{"range":[210,214]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[216,231]}}},{"diffOp":{"insert":{"range":[231,233]}}},{"diffOp":{"equal":{"range":[233,337]}}},{"equalLines":{"line_count":19}},{"diffOp":{"equal":{"range":[337,366]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[22223,22265],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"`          on stage:   \" + ${killer.mitigation}`);\n    lines.push(\"\");\n  }  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":413}},{"diffOp":{"equal":{"range":[37,193]}}},{"diffOp":{"delete":{"range":[193,194]}}},{"diffOp":{"insert":{"range":[194,195]}}},{"diffOp":{"equal":{"range":[195,217]}}},{"diffOp":{"delete":{"range":[217,221]}}},{"diffOp":{"insert":{"range":[221,223]}}},{"diffOp":{"equal":{"range":[223,240]}}},{"diffOp":{"insert":{"range":[240,242]}}},{"diffOp":{"equal":{"range":[242,268]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[268,297]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[22303,22347],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  }\n\n  lines.push(\"`DOCUMENTED FAILURE MODES (\" + ${report.mechanicalTotal + \"} mechanical, report.arguedTotal argued));\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":417}},{"diffOp":{"equal":{"range":[37,55]}}},{"diffOp":{"delete":{"range":[55,56]}}},{"diffOp":{"insert":{"range":[56,57]}}},{"diffOp":{"equal":{"range":[57,83]}}},{"diffOp":{"delete":{"range":[83,87]}}},{"diffOp":{"insert":{"range":[87,89]}}},{"diffOp":{"equal":{"range":[89,111]}}},{"diffOp":{"delete":{"range":[111,115]}}},{"diffOp":{"insert":{"range":[115,116]}}},{"diffOp":{"equal":{"range":[116,129]}}},{"diffOp":{"delete":{"range":[83,87]}}},{"diffOp":{"insert":{"range":[87,89]}}},{"diffOp":{"equal":{"range":[129,147]}}},{"diffOp":{"delete":{"range":[111,115]}}},{"diffOp":{"insert":{"range":[115,116]}}},{"diffOp":{"equal":{"range":[147,155]}}},{"diffOp":{"delete":{"range":[83,84]}}},{"diffOp":{"insert":{"range":[56,57]}}},{"diffOp":{"equal":{"range":[155,285]}}},{"equalLines":{"line_count":14}},{"diffOp":{"equal":{"range":[285,314]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[22388,22493],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(`${mark + \"} [\" + ${entry.source] \"+ entry.mode}`);\n    lines.push(\"           \" + entry.note);\n  }  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":425}},{"diffOp":{"equal":{"range":[37,196]}}},{"diffOp":{"insert":{"range":[196,199]}}},{"diffOp":{"equal":{"range":[199,203]}}},{"diffOp":{"delete":{"range":[203,207]}}},{"diffOp":{"insert":{"range":[207,208]}}},{"diffOp":{"equal":{"range":[208,210]}}},{"diffOp":{"delete":{"range":[210,214]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[216,228]}}},{"diffOp":{"delete":{"range":[203,207]}}},{"diffOp":{"insert":{"range":[207,208]}}},{"diffOp":{"equal":{"range":[228,229]}}},{"diffOp":{"delete":{"range":[229,231]}}},{"diffOp":{"equal":{"range":[208,209]}}},{"diffOp":{"delete":{"range":[231,233]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[233,243]}}},{"diffOp":{"insert":{"range":[243,245]}}},{"diffOp":{"equal":{"range":[245,295]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[295,324]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[22915,22961],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"`           \" + ${entry.note}`);\n  }\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":426}},{"diffOp":{"equal":{"range":[37,215]}}},{"diffOp":{"delete":{"range":[215,216]}}},{"diffOp":{"insert":{"range":[216,217]}}},{"diffOp":{"equal":{"range":[217,228]}}},{"diffOp":{"delete":{"range":[228,232]}}},{"diffOp":{"insert":{"range":[232,234]}}},{"diffOp":{"equal":{"range":[234,244]}}},{"diffOp":{"insert":{"range":[244,246]}}},{"diffOp":{"equal":{"range":[246,253]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[253,282]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[22979,23005],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *\n  lines.push(\"\");\n  lines.push(`${report.mechanicalFailing + \"} of \" + ${report.mechanicalTotal mechanical checks failing.);\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":430}},{"diffOp":{"equal":{"range":[37,69]}}},{"diffOp":{"insert":{"range":[69,72]}}},{"diffOp":{"equal":{"range":[72,96]}}},{"diffOp":{"delete":{"range":[96,100]}}},{"diffOp":{"insert":{"range":[100,101]}}},{"diffOp":{"equal":{"range":[101,105]}}},{"diffOp":{"delete":{"range":[105,109]}}},{"diffOp":{"insert":{"range":[109,111]}}},{"diffOp":{"equal":{"range":[111,133]}}},{"diffOp":{"delete":{"range":[96,100]}}},{"diffOp":{"insert":{"range":[100,101]}}},{"diffOp":{"equal":{"range":[133,160]}}},{"diffOp":{"delete":{"range":[105,106]}}},{"diffOp":{"insert":{"range":[69,70]}}},{"diffOp":{"equal":{"range":[160,394]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[394,423]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[23044,23134],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(`${report.arguedTotal + \"} modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":431}},{"diffOp":{"equal":{"range":[37,174]}}},{"diffOp":{"insert":{"range":[174,177]}}},{"diffOp":{"equal":{"range":[177,195]}}},{"diffOp":{"delete":{"range":[195,199]}}},{"diffOp":{"insert":{"range":[199,200]}}},{"diffOp":{"equal":{"range":[200,281]}}},{"diffOp":{"delete":{"range":[281,282]}}},{"diffOp":{"insert":{"range":[174,175]}}},{"diffOp":{"equal":{"range":[282,427]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[23150,23254],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"error","description":"This parameter is unused.","message":[{"elements":[],"content":"This parameter is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables usually are result of incomplete refactoring, typos and other source of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"corpus"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n * * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus_corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":95}},{"diffOp":{"equal":{"range":[37,131]}}},{"diffOp":{"delete":{"range":[131,137]}}},{"diffOp":{"insert":{"range":[137,144]}}},{"diffOp":{"equal":{"range":[144,367]}}},{"equalLines":{"line_count":336}},{"diffOp":{"equal":{"range":[367,396]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[4742,4748],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"error","description":"This parameter is unused.","message":[{"elements":[],"content":"This parameter is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables usually are result of incomplete refactoring, typos and other source of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"corpus"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n * * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus_corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":210}},{"diffOp":{"equal":{"range":[37,173]}}},{"diffOp":{"delete":{"range":[173,179]}}},{"diffOp":{"insert":{"range":[179,186]}}},{"diffOp":{"equal":{"range":[186,311]}}},{"equalLines":{"line_count":221}},{"diffOp":{"equal":{"range":[311,340]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":[10489,10495],"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *import type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRunRunResult } from \"./metricsharness\";\nimport type { \";\n\n/* -------------------------------------------------------------------------- */  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,37]}}},{"equalLines":{"line_count":27}},{"diffOp":{"equal":{"range":[37,156]}}},{"diffOp":{"delete":{"range":[156,165]}}},{"diffOp":{"insert":{"range":[165,174]}}},{"diffOp":{"equal":{"range":[174,185]}}},{"diffOp":{"delete":{"range":[185,192]}}},{"diffOp":{"insert":{"range":[192,199]}}},{"diffOp":{"equal":{"range":[199,216]}}},{"diffOp":{"delete":{"range":[165,174]}}},{"diffOp":{"insert":{"range":[156,165]}}},{"diffOp":{"equal":{"range":[174,185]}}},{"diffOp":{"delete":{"range":[192,199]}}},{"diffOp":{"insert":{"range":[185,192]}}},{"diffOp":{"equal":{"range":[216,300]}}},{"equalLines":{"line_count":403}},{"diffOp":{"equal":{"range":[300,329]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\hardening.ts"},"span":null,"sourceCode":"/**\n * The hardening pass ΓÇö 7.4.\n *\n * Phase 7 ┬╖ sub-phase 7.4\n *\n * ---------------------------------------------------------------------------\n * WHAT \"HARDENED\" MEANS HERE, PRECISELY\n *\n * Not \"we thought about the failure modes\". Every failure mode documented in docs/02 ┬º7 (8), docs/03 ┬º8\n * (9) and docs/04 ┬º8 (7) is registered below against either a MECHANICAL CHECK ΓÇö a predicate over a\n * real run that passes or fails ΓÇö or an explicit `argued` entry saying why it cannot be checked on a\n * transcript corpus.\n *\n * Twenty-four failure modes, no silent ones. A failure mode with no check and no argument is the\n * dangerous category, because it reads as covered in the docs and is covered nowhere in the code. The\n * registry makes that category empty by construction: adding a failure mode to the docs requires adding\n * a row here, and a row requires one of the two.\n *\n * ---------------------------------------------------------------------------\n * THE FOUR DEMO-KILLERS ARE CHECKED FIRST AND HARD\n *\n * ┬º7.4 names four. Each is a `DemoKiller` with a predicate that must hold, because these are not\n * quality regressions ΓÇö they are the specific moments in a live demo where the product stops looking\n * like a product. A demo that over-retracts eleven decisions in front of a judge does not recover by\n * being right about the other ten.\n *\n * They are checked against the baseline run, not against a curated one, and the check fails loudly.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport type { RunResult } from \"./harness\";\n\n/* -------------------------------------------------------------------------- */\n/* The four demo-killers                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface DemoKiller {\n  readonly id: string;\n  readonly name: string;\n  /** What the audience sees when this fires. Written in demo terms, not metric terms, because the\n   *  reason it is a killer is a perception and not a number. */\n  readonly visibleAs: string;\n  readonly passes: boolean;\n  readonly evidence: string;\n  /** What to do about it during a live demo, because the fix is not available on stage. */\n  readonly mitigation: string;\n}\n\nexport function checkDemoKillers(corpus: ResolvedCorpus, scored: ScoredRun): readonly DemoKiller[] {\n  return [\n    overRetraction(scored),\n    falsePremiseResolution(corpus, scored),\n    hypotheticalsAsNodes(scored),\n    dayOneGuardFailures(scored),\n  ];\n}\n\n/**\n * Killer 1 ΓÇö cascade over-retraction.\n *\n * The user falsifies one assumption about team size and a dozen unrelated decisions disappear from the\n * graph. This is the single fastest way to lose the room, because the audience can see it happen and\n * needs no explanation of why it is wrong.\n */\nfunction overRetraction(scored: ScoredRun): DemoKiller {\n  const survivorship = scored.metrics.find((metric) => metric.id === \"survivor-preservation\");\n  const value = survivorship?.value ?? 0;\n  const n = survivorship?.n ?? 0;\n  const over = scored.cascade.overRetractions;\n\n  return {\n    id: \"cascade-over-retraction\",\n    name: \"Cascade over-retraction\",\n    visibleAs:\n      \"One premise is falsified and decisions that share nothing with it lose their label. The graph looks \" +\n      \"like it is deleting the user's history rather than maintaining it.\",\n    /* Vacuous passes are failures. A 1.0 with n=0 means no survivor was ever at risk, which is not\n     * evidence the cascade is disciplined ΓÇö it is evidence the corpus did not test it. */\n    passes: over === 0 && n > 0,\n    evidence:\n      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over + \" over-retraction(s) across \" + n + \" expected survivor(s); survivor preservation \" + value.toFixed(3) + \".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +\n      \"two-level one and removes the possibility of a wide retraction on stage. Say the cap out loud \" +\n      \"rather than hiding it: a bounded cascade is a design choice, a runaway one is a bug.\",\n  };\n}\n\n/**\n * Killer 2 ΓÇö false premise resolution.\n *\n * The headline case: `demo2` never mentions databases, and the SQLite decision must still go unsound.\n * If it does not, the entire pitch collapses to \"a decision log with extra steps\", because premise\n * invalidation is the only capability no competitor has.\n */\nfunction falsePremiseResolution(corpus: ResolvedCorpus, scored: ScoredRun): DemoKiller {\n  const l2 = scored.invalidation.perPlant.find((entry) => entry.plant === \"L2-premise-falsified\");\n  const fires = l2 !== undefined && l2.testable && l2.flipped.length > 0;\n\n  const detail =\n    l2 === undefined\n      ? \"the L2 plant is not in the corpus at all\"\n      : !l2.testable\n        ? \"the L2 plant's transcripts failed to import, so it was never tested\"\n        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" + l2.expectedUnsound.join(\", \") + \" to go unsound; \" +\n            (l2.notFlipped.length > 0 ? l2.notFlipped.join(\", \") + \" did not\" : \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n\n  return {\n    id: \"false-premise-resolution\",\n    name: \"False premise resolution\",\n    visibleAs:\n      \"The presenter says 'nothing contradicted me, I never said the word database, the world moved and \" +\n      \"the log noticed' ΓÇö and the log has not noticed. There is no recovery from this one, because it is \" +\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence: detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +\n      \"`fixtures/demo-transcript-2.txt`) imported through the UI rather than the corpus, and drive the \" +\n      \"falsification by hand from the Reasoning view. It is a weaker claim ΓÇö a human pointing at the \" +\n      \"premise instead of the transcript implying it ΓÇö and it must be described as such on stage.\",\n  };\n}\n\n/**\n * Killer 3 ΓÇö hypotheticals becoming nodes.\n *\n * \"What if we used Redis?\" appears in the graph as a Redis decision. Every downstream guarantee is then\n * built on something nobody decided, and the moment a judge reads a node aloud the product is finished.\n */\nfunction hypotheticalsAsNodes(scored: ScoredRun): DemoKiller {\n  const modality = scored.modality;\n  const adversarial = modality.byTier.find((entry) => entry.tier === \"adversarial\");\n  const clean = modality.wronglyPromoted.length === 0;\n\n  return {\n    id: \"hypotheticals-as-nodes\",\n    name: \"Hypotheticals becoming nodes\",\n    visibleAs:\n      \"A speculative question appears in the decision graph as a decision. Reading the node aloud is \" +\n      \"enough to end the demo, and the audience will do it without being invited to.\",\n    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length + \" non-decision(s) became nodes out of \" + modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted + \" wrongly promoted of \" + adversarial.expected + \" expected declines\") + \".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +\n      \"nodes still exist in the log ΓÇö nothing is deleted, invariant I1 ΓÇö but they are not on screen, and \" +\n      \"saying 'they are retained but not promoted' is a true and defensible sentence.\",\n  };\n}\n\n/**\n * Killer 4 ΓÇö day-one guard failures.\n *\n * Guards that fail, skip-as-pass, or auto-accept on a freshly imported corpus. The user has not written\n * a line of code against them yet, so a red guard panel on day one reads as a tool that is broken rather\n * than as a tool that found something.\n */\nfunction dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =\n    guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {\n    id: \"day-one-guard-failures\",\n    name: \"Day-one guard failures\",\n    visibleAs:\n      \"The guards panel is red before the user has written any code. A verification layer that fails on \" +\n      \"an empty project teaches the user to ignore it, and an ignored verification layer is worse than \" +\n      \"none because it has already consumed the user's trust.\",\n    passes: violations === 0,\n    evidence:\n      guards.guards + \" guard(s) synthesised across \" + guards.decisionsTotal + \" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) + \"%). Invariant violations: \" + guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" + guards.autoAccepted + \" auto-accepted, \" + guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation:\n      \"Guards are PROPOSED, never auto-installed (Phase 4), so the day-one panel should show proposals \" +\n      \"rather than failures. If it shows failures, the baseline run has evaluated guards against an empty \" +\n      \" virtual project ΓÇö paste a real package.json into the project panel before the demo, or show the \" +\n      \"proposal list instead of the run list.\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The documented failure-mode registry                                       */\n/* -------------------------------------------------------------------------- */\n\nexport interface FailureModeCheck {\n  readonly source: string;\n  readonly mode: string;\n  readonly kind: \"mechanical\" | \"argued\";\n  /** The predicate's result, when `kind` is \"mechanical\". */\n  readonly passes: boolean | null;\n  readonly note: string;\n}\n\n/**\n * Every failure mode documented in the research, with a check or an argument.\n *\n * The `argued` entries are not an escape hatch. Each one states what would be needed to make it\n * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus, scored: ScoredRun, run: RunResult): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Over-retraction ΓÇö a cascade takes more than it should\",\n    scored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\n    scored.cascade.overRetractions + \" over-retraction(s); \" + scored.cascade.survivorsExpected + \" survivor(s) expected.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Under-retraction ΓÇö a cascade stops too early\",\n    scored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\n    scored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) + \" expected flip(s) missed.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Circular justification ΓÇö a decision supports its own premise\",\n    !scored.run.state.decisions.size || !hasCircularLabel(run),\n    hasCircularLabel(run) ? \"at least one node is labelled circular\" : \"no node reached a circular label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n    !scored.run.labels.size || scored.run.labels.size > 0 && !hasUnfoundedLabel(run),\n    hasUnfoundedLabel(run) ? \"at least one node is labelled UNFOUNDED\" : \"no node reached an unfounded label.\"));\n\n  checks.push(mechanical(\"docs/02 ┬º7\", \"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\n    scored.invalidation.outListPopulated > 0,\n    scored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n    \"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n    \"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n    \"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n    \"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Label oscillation ΓÇö the fixpoint does not converge\",\n    \"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n    \"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n    \"has a five-level plant.\"));\n\n  checks.push(argued(\"docs/02 ┬º7\", \"Nogood recorded against nodes that no longer exist\",\n    \"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n    \"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\"));\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Refinement surfaced as a conflict\",\n    scored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\n    scored.falsePositives.refinementVerdicts + \" refinement verdict(s), none expected to interrupt.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Search budget exceeded ΓÇö more than three searches\",\n    scored.groundedness.searchBudgetViolations === 0,\n    scored.groundedness.searchBudgetViolations + \" answer(s) exceeded the \" + 3 + \"-search budget.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Empty answer scored as grounded (0/0 = 1)\",\n    scored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0),\n    scored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Answering a question the corpus cannot answer\",\n    scored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected && scored.groundedness.refusalsExpected > 0,\n    scored.groundedness.refusalsCorrect + \" of \" + scored.groundedness.refusalsExpected + \" unanswerable question(s) refused.\"));\n\n  checks.push(mechanical(\"docs/03 ┬º8\", \"Citation that does not resolve within the run\",\n    citationsResolve(run),\n    citationsResolve(run) ? \"every cited decision id exists in the graph.\" : \"at least one citation points at a decision the graph does not contain.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n    \"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n    \"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n    \"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n    \"delta table.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Embedding drift ΓÇö vectors stale after a decision is edited\",\n    \"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n    \"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n    \"edit-then-query plant exists.\"));\n\n  checks.push(argued(\"docs/03 ┬º8\", \"Pre-emption fires without a stated rejection reason\",\n    \"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n    \"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n    \"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\"));\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A skip counted as a pass\",\n    scored.guards.skippedCountedAsPass === 0,\n    scored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"A guard accepted without a human (invariant I4)\",\n    scored.guards.autoAccepted === 0,\n    scored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"Stale `disabledByDecisionLabel` after a label change\",\n    scored.guards.staleDisabledFlags === 0,\n    scored.guards.staleDisabledFlags + \" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"));\n\n  checks.push(mechanical(\"docs/04 ┬º8\", \"`llm_judge` counted toward compliance\",\n    scored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\n    scored.guards.deterministic + \" deterministic and \" + scored.guards.judged + \" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"A guard that passes on a project that violates its decision\",\n    \"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n    \"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n    \"roadmap work recorded in `docs/LIMITATIONS.md`.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n    \"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n    \"a file tree to scope against, which is the same missing fixture repository as the entry above.\"));\n\n  checks.push(argued(\"docs/04 ┬º8\", \"`falsifiesPremiseId` attributed to the wrong premise\",\n    \"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n    \"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n    \"known premise target, which again needs the fixture repository.\"));\n\n  return checks;\n}\n\nfunction mechanical(source: string, mode: string, passes: boolean, note: string): FailureModeCheck {\n  return { source, mode, kind: \"mechanical\", passes, note };\n}\n\nfunction argued(source: string, mode: string, note: string): FailureModeCheck {\n  return { source, mode, kind: \"argued\", passes: null, note };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicates                                                                 */\n/* -------------------------------------------------------------------------- */\n\nfunction hasCircularLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.reason.kind === \"circular\") return true;\n  return false;\n}\n\nfunction hasUnfoundedLabel(run: RunResult): boolean {\n  for (const labelled of run.labels.values()) if (labelled.label === \"UNFOUNDED\") return true;\n  return false;\n}\n\nfunction refinementRaisedAsConflict(run: RunResult): boolean {\n  /* A refinement verdict is only a failure if it produced a revision proposal. Recorded and left\n   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n\nfunction citationsResolve(run: RunResult): boolean {\n  const ids = new Set<DecisionId>(run.state.decisions.keys());\n\n  for (const entry of run.questions) {\n    if (entry.answer === null) continue;\n    for (const citation of entry.answer.citations) if (!ids.has(citation.decisionId)) return false;\n    for (const claim of entry.answer.claims) {\n      for (const cited of claim.citations) if (!ids.has(cited)) return false;\n    }\n  }\n  return true;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface HardeningReport {\n  readonly killers: readonly DemoKiller[];\n  readonly failureModes: readonly FailureModeCheck[];\n  readonly killersFailing: number;\n  readonly mechanicalFailing: number;\n  readonly mechanicalTotal: number;\n  readonly arguedTotal: number;\n  /** True only when every demo-killer passes and every mechanical check passes. This is gate G6's\n   *  hardening clause, and it is a boolean rather than a percentage because a partially hardened demo is\n   *  not a demo that can be given. */\n  readonly ready: boolean;\n}\n\nexport function harden(corpus: ResolvedCorpus, scored: ScoredRun): HardeningReport {\n  const killers = checkDemoKillers(corpus, scored);\n  const failureModes = checkFailureModes(corpus, scored, scored.run);\n\n  const mechanicalChecks = failureModes.filter((entry) => entry.kind === \"mechanical\");\n\n  return {\n    killers,\n    failureModes,\n    killersFailing: killers.filter((entry) => !entry.passes).length,\n    mechanicalFailing: mechanicalChecks.filter((entry) => entry.passes === false).length,\n    mechanicalTotal: mechanicalChecks.length,\n    arguedTotal: failureModes.length - mechanicalChecks.length,\n    ready:\n      killers.every((entry) => entry.passes) &&\n      mechanicalChecks.every((entry) => entry.passes === true),\n  };\n}\n\nexport function renderHardening(report: HardeningReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready ? \"READY: every demo-killer check passes and every mechanical check passes.\" :\n    \"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n\n  lines.push(\"THE FOUR DEMO-KILLERS (\" + (4 - report.killersFailing) + \"/4 passing)\");\n  lines.push(\"\");\n  for (const killer of report.killers) {\n    lines.push((killer.passes ? \"  PASS  \" : \"  FAIL  \") + killer.name);\n    lines.push(\"          visible as: \" + killer.visibleAs);\n    lines.push(\"          evidence:   \" + killer.evidence);\n    if (!killer.passes) lines.push(\"          on stage:   \" + killer.mitigation);\n    lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES (\" + report.mechanicalTotal + \" mechanical, \" + report.arguedTotal + \" argued)\");\n  lines.push(\"\");\n  lines.push(\"Every failure mode in docs/02 ┬º7, docs/03 ┬º8 and docs/04 ┬º8 appears below. A mode with no\");\n  lines.push(\"check and no argument is the dangerous category ΓÇö it reads as covered and is covered nowhere.\");\n  lines.push(\"\");\n\n  for (const entry of report.failureModes) {\n    const mark = entry.kind === \"argued\" ? \"  ARGUED \" : entry.passes ? \"  pass   \" : \"  FAIL   \";\n    lines.push(mark + \" [\" + entry.source + \"] \" + entry.mode);\n    lines.push(\"           \" + entry.note);\n  }\n\n  lines.push(\"\");\n  lines.push(report.mechanicalFailing + \" of \" + report.mechanicalTotal + \" mechanical checks failing.\");\n  lines.push(report.arguedTotal + \" modes are argued rather than checked; each states what would make it mechanical,\");\n  lines.push(\"and that list is the source of the roadmap in docs/LIMITATIONS.md rather than an invented one.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 16 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 16 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 16 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\rejected-block.ts"},"span":[2402,2415],"sourceCode":"/**\n * \"Rejected ΓÇö do not re-propose\" ΓÇö 5.3.\n *\n * Phase 5 ┬╖ sub-phase 5.3\n * Plan: plan/phase-5-export-compiler.md ┬º5.3\n *\n * ---------------------------------------------------------------------------\n * THE HIGHEST-VALUE BLOCK IN THE FILE, AND THE ONE NO COMPETITOR EMITS\n *\n * Not because Markdown is hard. Because none of them index rejected alternatives first-class, so\n * none of them has the data. A tool that stores decisions and not the things it turned down\n * cannot emit this block at any export quality.\n *\n * What it prevents is the most common and most expensive agent failure there is: an agent, given\n * a fresh context window and no memory of the conversation that produced the decision, proposes\n * Postgres. Again. To the person who rejected Postgres six weeks ago and wrote down why.\n *\n * ---------------------------------------------------------------------------\n * PREMISE STATUS IS WHAT MAKES IT MORE THAN A BLACKLIST\n *\n *   - **Postgres** (WLD-0007) ΓÇö deploy complexity; premise P-0005 no-deploy-infra still IN\n *   - **Next.js**  (WLD-0003) ΓÇö no SSR needed; premise P-0008 scope=hackathon CONTESTED\n *\n * The first line says: this rejection still holds, and here is the condition it rests on. The\n * second says: this rejection is under review, so proposing it is not obviously wrong.\n *\n * A flat blacklist would tell an agent to never mention Next.js even after the hackathon shipped\n * and the premise that ruled it out was falsified. Carrying the premise status turns the block\n * from \"don't say this\" into \"don't say this WHILE THIS HOLDS\" ΓÇö which is the difference between\n * a rule and a decision.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport type { RejectedBlockEntry } from \"@/types/export\";\n\n/**\n * Build the block.\n *\n * Only alternatives with a recorded reason are included. A rejection without a reason is a\n * blacklist entry an agent cannot evaluate, and it ages badly: nobody can later tell whether the\n * reason was obvious or whether there never was one. Phase 1 stored those alternatives anyway;\n * this is where the distinction pays off.\n */\nexport function rejectedBlock(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): readonly RejectedBlockEntry[] {\n  const out: RejectedBlockEntry[] = [];\n\n  for (const decision of state.decisions.values()) {\n    /* A superseded decision's rejections are history. Emitting them would tell an agent not to\n     * propose something the log has since adopted ΓÇö the exact inverse of the block's purpose. */\n    if (decision.status === \"superseded\" || decision.status === \"archived\") continue;\n\n    const label = labels.get(decision.id)?.label ?? decision.label;\n    if (label === \"OUT\") continue;\n\n    const premiseEntries = decisionPremises(state, labels, decision.id);\n\n    for (const alternativeId of decision.alternativeIds) {\n      const alternative = state.alternatives.get(alternativeId);\n      if (alternative === undefined) continue;\n      if (alternative.whyRejected === undefined || alternative.whyRejected.trim().length === 0)\n        continue;\n\n      const contested = premiseEntries.find((entry) => entry.contested);\n\n      out.push({\n        value: alternative.value,\n        decisionId: decision.id,\n        why: alternative.whyRejected.trim(),\n        premiseStatus: renderPremiseStatus(premiseEntries),\n        contested: contested !== undefined,\n      });\n    }\n  }\n\n  /* Contested first: a rejection under review is the one an agent is most likely to be right\n   * about revisiting, and burying it under forty settled ones is how it gets ignored. */\n  return out.sort((a, b) => {\n    if (a.contested !== b.contested) return a.contested ? -1 : 1;\n    return a.decisionId < b.decisionId\n      ? -1\n      : a.decisionId > b.decisionId\n        ? 1\n        : a.value < b.value\n          ? -1\n          : 1;\n  });\n}\n\ninterface PremiseEntry {\n  readonly id: PremiseId;\n  readonly text: string;\n  readonly label: DecisionLabel;\n  readonly contested: boolean;\n}\n\nfunction decisionPremises(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: DecisionId,\n): readonly PremiseEntry[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: PremiseEntry[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n\n      const label = labels.get(premiseId)?.label ?? premise.label;\n\n      out.push({\n        id: premiseId,\n        text: premise.text,\n        label,\n        /* Contested means the premise is neither confirmed nor refuted: the decision rests on\n         * something the log has not settled, so the rejection resting on it is provisional. */\n        contested: label === \"UNKNOWN\",\n      });\n    }\n  }\n\n  return out;\n}\n\nfunction renderPremiseStatus(premises: readonly PremiseEntry[]): string {\n  if (premises.length === 0) {\n    return \"no recorded premise ΓÇö this rejection rests on nothing checkable, so treat it as advisory\";\n  }\n\n  return premises\n    .map(\n      (entry) =>\n        `premise ${entry.id} ${shorten(entry.text)} ${entry.contested ? \"CONTESTED\" : `still ${entry.label}`}`,\n    )\n    .join(\"; \");\n}\n\nfunction shorten(text: string): string {\n  const flat = text.replace(/\\s+/g, \" \").trim();\n  return flat.length <= 34 ? flat : `${flat.slice(0, 31)}...`;\n}\n\n/** The block as Markdown. */\nexport function renderRejectedBlock(entries: readonly RejectedBlockEntry[]): string {\n  if (entries.length === 0) {\n    return [\n      \"## Rejected ΓÇö do not re-propose without superseding the record\",\n      \"\",\n      \"Nothing has been recorded as rejected yet. Rejections are extracted from transcripts and\",\n      \"confirmed on the Review tab; an alternative with no recorded reason is stored but never\",\n      \"emitted here, because a blacklist entry nobody can evaluate ages badly.\",\n    ].join(\"\\n\");\n  }\n\n  const lines = [\"## Rejected ΓÇö do not re-propose without superseding the record\", \"\"];\n\n  for (const entry of entries) {\n    lines.push(\n      `- **${entry.value}** (${entry.decisionId}) ΓÇö ${entry.why}; ${entry.premiseStatus}${entry.contested ? \"  ! UNDER REVIEW\" : \"\"}`,\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\n    \"Proposing one of these is not forbidden ΓÇö it is a SUPERSESSION, and it has a form: record the\",\n    \"new decision, cite the premise that changed, and let the old record be superseded rather than\",\n    \"quietly contradicted in a diff.\",\n  );\n\n  return lines.join(\"\\n\");\n}\n\n/** How many rejections are contested, for the export summary. */\nexport function contestedCount(entries: readonly RejectedBlockEntry[]): number {\n  return entries.filter((entry) => entry.contested).length;\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *function checkSeedHasSqlite(seed: SeedResult): CheckResult {\n  const hit = [...seed.state.decisions.values()].find(\n    (decision) => \n      decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  return hit === undefined\n    ? failed(\n        \"seed-has-sqlite-decision\",\"No SQLite decision in the seed. Beat 1 has nothing to show and every later beat depends on it.\",\n      )\n    : verified(\"seed-has-sqlite-decision\", hit.id + \" ┬╖ \" + hit.statement);\n}function checkSeedHasPremises(seed: SeedResult): CheckResult {\n  const sqlite = [...seed.state.decisions.values()].find(\n    (decision) =>    return failed(\n      \"seed-has-premises\",\n      sqlite.id +\" has no justification linking it to any premise. Beat 1's whole point ΓÇö 'notice what is underneath it' ΓÇö cannot be shown.\",\n    );\n  }  return verified(\n    \"seed-has-premises\",\n    premiseIds.size +\" premise(s) linked: \" +(names.length > 0 ? names.join(\", \") : \"ids resolved but predicates unreadable\"),\n  );\n}\n  if (records.length === 0) {\n    return failed(\"reversal-detected\",\"No contradiction or reversal record in the seed. Beat 3 would show an empty panel.\");\n  }\n  return verified(\n    \"reversal-detected\",\n    records.length +\" record(s): \" +structural +\" structural, \" +(records.length - structural) +\" other gate(s).\",\n  );\n}   * is imported, without the November transcript mentioning databases. */\n  const sqlite = [...seed.state.decisions.values()].filter(\n    (decision) =>decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite.length === 0) return failed(\"l2-unsound\", \"No SQLite decision in the seed.\");\n\n  const unsound = sqlite.filter((decision) => decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n\n  if (unsound.length === 0) {\n    return failed(\n      \"l2-unsound\",\n      \"DEMO-KILLER: the SQLite decision is still \" +sqlite.map((decision) => decision.label).join(\"/\") +\n              \" after the November transcript. Beat 5 is the peak of the demo and it does not land. \" +\n\"Fall back to driving the falsification by hand from the Reasoning view and say so out loud.\",\n    );\n  }\n\n  let outListTotal = 0;\n  for (const justification of seed.state.justifications.values())outListTotal += justification.outList.length;\n\n  return verified(\n    \"l2-unsound\",\n    unsound.map((decision) => decision.id).join(\", \") +\" went unsound. \" +outListTotal +\n\" OUT-list entry/entries in the graph, which is what makes the retraction non-monotonic rather than a supersede.\",\n  );\n}    : failed(\n        \"no-hypothetical-nodes\",\n        \"DEMO-KILLER: \" +\n          hypothetical.length +\" hypothetical decision(s) are labelled IN: \" +\n        hypothetical.map          hypothetical\n            .map((decision) => decision.id + \" (\" + decision.statement.slice(0, 40) + \")\")\n            .join(\"; \") +\n\". Beat 6 shows the graph, and a judge who reads one of these aloud ends the demo.\",\n      );\n}\n  if (guards.length === 0) {\n    return failed(\"guards-proposed-not-failing\",\"No guards synthesised. Beat 7 has nothing to show.\"    return failed(\n      \"guards-proposed-not-failing\",\n      \"DEMO-KILLER: \" +accepted.length +\" guard(s) reached `accepted` with no human in the loop. Invariant I4 says the system proposes and the human disposes.\",\n    );\n  }    status: failing.length === 0 ? \"verified\" : \"manual\",\n    evidence:\n      guards.length +\" guard(s) synthesised, all in `proposed` or `suppressed` lifecycle. \" +\n      failing.length +\" currently failing against the empty virtual project.\",\n    manualStep:\n      failing.length === 0\n        ? \"\"\n        : failing.length +\" guard(s) fail against an empty project. Paste a real package.json into the \" +\n          \"project panel before beat 7, or show the proposal list instead of the run list.\",\n  };    check: \"export-contains-decision\",\n    status: \"manual\",\n    evidence:seed.state.decisions.size +\" decision(s) available to export; \" +seed.state.exports.size +\" export record(s) already in the log.\",\n    manualStep:\n      \"In the Export view, compile CLAUDE.md and confirm three things: (1) the Postgres decision appears \" +    check: \"answer-is-grounded\",\n    status: \"manual\",\n    evidence:\"Asking a question runs the retrieval pipeline over the seeded index, which is built in the browser.\",\n    manualStep:\n      \"In the Ask view, ask 'Why did we choose SQLite over Postgres?' and confirm the answer carries a \" +\n  return decisions > 0 && premises > 0\n    ? verified(\"graph-renders\",decisions +\" decision(s) and \" +premises +\" premise(s): both sides of the bipartition are populated.\")\n    : failed(\" decision(s), \" +\" premise(s). An empty side produces an empty diagram.\");\n}\n\n  lines.push(\"KEYLESS DEMO VERIFICATION\");\n  lines.push(report.verified + \" verified ┬╖ \" + report.manual + \" manual ┬╖ \" + report.failed + \" FAILED\");\n  lines.push(report.demoable ? \"DEMOABLE.\" : \"NOT DEMOABLE ΓÇö a beat will visibly not work.\");\n  lines.push(\"\");  lines.push(\"-\".repeat(70));\n  for (const entry of report.byBeat) {\n    lines.push(String(entry.beat).padEnd(6) +entry.view.padEnd(14) +entry.check.padEnd(32) +entry.status.toUpperCase());\n  }\n  lines.push(\"\");\nexport type { Beat };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":95}},{"diffOp":{"equal":{"range":[51,184]}}},{"diffOp":{"delete":{"range":[184,185]}}},{"diffOp":{"insert":{"range":[185,192]}}},{"diffOp":{"equal":{"range":[192,333]}}},{"diffOp":{"insert":{"range":[333,342]}}},{"diffOp":{"equal":{"range":[342,369]}}},{"diffOp":{"delete":{"range":[184,185]}}},{"diffOp":{"insert":{"range":[333,342]}}},{"diffOp":{"equal":{"range":[369,465]}}},{"diffOp":{"insert":{"range":[465,473]}}},{"diffOp":{"equal":{"range":[473,553]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[553,691]}}},{"diffOp":{"delete":{"range":[184,185]}}},{"diffOp":{"insert":{"range":[333,340]}}},{"diffOp":{"equal":{"range":[192,292]}}},{"equalLines":{"line_count":16}},{"diffOp":{"equal":{"range":[691,754]}}},{"diffOp":{"delete":{"range":[691,692]}}},{"diffOp":{"insert":{"range":[333,342]}}},{"diffOp":{"equal":{"range":[754,893]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[893,958]}}},{"diffOp":{"delete":{"range":[691,692]}}},{"diffOp":{"insert":{"range":[333,340]}}},{"diffOp":{"equal":{"range":[958,982]}}},{"diffOp":{"delete":{"range":[691,692]}}},{"diffOp":{"insert":{"range":[333,340]}}},{"diffOp":{"equal":{"range":[982,1070]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[1070,1119]}}},{"diffOp":{"insert":{"range":[333,340]}}},{"diffOp":{"equal":{"range":[1119,1139]}}},{"diffOp":{"delete":{"range":[691,692]}}},{"diffOp":{"insert":{"range":[333,340]}}},{"diffOp":{"equal":{"range":[1139,1223]}}},{"diffOp":{"insert":{"range":[465,471]}}},{"diffOp":{"equal":{"range":[1223,1230]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[1230,12