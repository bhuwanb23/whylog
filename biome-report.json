ricResult | null {\n  return scored.metrics.find((metric) => metric.id === id) ?? null;\n}\n\n/** The suite as a compact table. Every row carries n beside the value, because a number without a\n *  denominator is not a measurement and this is the shortest form in which the suite gets quoted. */\nexport function renderSuite(scored: ScoredRun): string {\n  const lines: string[] = [];\n\n  lines.push(\"Metric\".padEnd(46) + \"Value\".padStart(9) + \"n\".padStart(7) + \"  Comparator\");\n  lines.push(\"-\".repeat(100));\n\n  for (const metric of scored.metrics) {\n    const comparator =\n      metric.comparator === null ? \"NONE PUBLISHED\" : metric.comparator.source;\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \"/100\"\n      : metric.value.toFixed(3);\n\n    lines.push(metric.name.padEnd(46) + value.padStart(9) + String(metric.n).padStart(7) + \"  \" + comparator);\n  }\n\n  lines.push(\"\");\n  lines.push(\"Lower is better for: false-positive rate. Higher is better for everything else.\");\n  lines.push(\n    metricsWithoutComparator(scored).length + \" of \" + scored.metrics.length +\n    \" metrics have NO published comparator ΓÇö that is the new-territory claim, stated as a count.\",\n  );\n\n  return lines.join(\"\\n\");\n}\n\nexport { METRIC_NAMES };\nexport type { MetricId, MetricResult, Resolver };\nexport { buildResolver } from \"./resolve\";\nexport { MATCH_RULE, align, overlapOf, type Alignment, type AlignedPair, type Span } from \"./match\";\nexport {\n  COMPARATORS,\n  UNUSUAL_METRICS,\n  meanReciprocalRank,\n  precisionAtK,\n  precisionRecall,\n  describeEngineId,\n  type EngineMetric,\n  type PrecisionRecall,\n} from \"./types\";\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metric 5 ΓÇö premise-invalidation recall at L2 (non-monotonic).\n *import type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { plantIsTestable, type Resolver, plantIsTestable } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, type MetricResult, describeEngineId } from \"./types\";\n\nexport interface InvalidationOutcome {}\n\n","ops":[{"diffOp":{"equal":{"range":[0,73]}}},{"equalLines":{"line_count":42}},{"diffOp":{"equal":{"range":[73,183]}}},{"diffOp":{"delete":{"range":[183,200]}}},{"diffOp":{"equal":{"range":[200,213]}}},{"diffOp":{"insert":{"range":[213,230]}}},{"diffOp":{"equal":{"range":[230,287]}}},{"diffOp":{"delete":{"range":[287,305]}}},{"diffOp":{"equal":{"range":[305,322]}}},{"diffOp":{"insert":{"range":[322,340]}}},{"diffOp":{"equal":{"range":[340,398]}}},{"equalLines":{"line_count":87}},{"diffOp":{"equal":{"range":[398,401]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\invalidation.ts"},"span":null,"sourceCode":"/**\n * Metric 5 ΓÇö premise-invalidation recall at L2 (non-monotonic).\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: NONE PUBLISHED. No surveyed system has this component.\n *\n * ---------------------------------------------------------------------------\n * THE HEADLINE RESULT, AND THE REASON THE PRODUCT EXISTS\n *\n * L1 fires when YOU contradict yourself. L2 fires when REALITY does: the decision is never mentioned,\n * its variable is never mentioned, no new statement conflicts with it ΓÇö and it is nonetheless no\n * longer true, because an assumption it rested on stopped holding.\n *\n * The planted case is the product's whole argument in one transcript. `demo2` says there are now four\n * people on the project and two of them edit decisions concurrently. It never says the word database.\n * The SQLite decision from `demo1` excluded concurrent writers, so it becomes unsound ΓÇö and the only\n * reason any system could notice is that it stored the exclusion.\n *\n * Storing the decision is what every competitor does. Storing the `given` is what none of them does,\n * and this metric measures whether storing it actually buys the detection.\n *\n * ---------------------------------------------------------------------------\n * NO INTERVENTION: MEASURED THE HARD WAY ON PURPOSE\n *\n * Unlike the L3 plant, this one carries no harness-applied falsification. The refutation has to be\n * recovered from demo2's own text by extraction, and connected to demo1's premise by the reasoning\n * layer. That is two failure points instead of zero, and the number will be worse for it.\n *\n * It is measured this way because it is the claim being made. An L2 recall computed after the harness\n * hands the system the falsified premise measures the cascade, not the detection ΓÇö and the cascade is\n * already measured by metric 6. Reporting a hand-fed L2 number as evidence for \"the world moved and the\n * log noticed\" would be the one genuinely dishonest number available in this file.\n *\n * ---------------------------------------------------------------------------\n * THE OUT-LIST IS WHAT MAKES THIS NON-MONOTONIC\n *\n * A Doyle SL justification is valid iff every IN-list node is IN AND no OUT-list node is IN. A\n * non-empty OUT-list is the formal signature of non-monotonic reasoning, and it is gate (c). A system\n * with only IN-lists is monotonic: adding information can never retract a conclusion, so it can never\n * notice that the world moved. This metric is therefore also a measurement of whether the OUT-list is\n * populated at all ΓÇö and `outListPopulated` is reported beside the recall for exactly that reason.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { plantIsTestable, type Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface InvalidationOutcome {\n  readonly metric: MetricResult;\n  readonly perPlant: readonly {\n    plant: string;\n    testable: boolean;\n    expectedUnsound: readonly string[];\n    flipped: readonly string[];\n    notFlipped: readonly string[];\n    unresolvable: readonly string[];\n  }[];\n  /** How many decisions in the graph carry a non-empty OUT-list. Zero means the graph is monotonic and\n   *  this metric cannot score above zero for a reason that has nothing to do with detection quality. */\n  readonly outListPopulated: number;\n  readonly decisionsTotal: number;\n  readonly premiseGateRecords: number;\n}\n\nexport function scoreInvalidationRecall(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): InvalidationOutcome {\n  const plants = corpus.plants.filter((plant) => plant.kind === \"L2-premise\");\n\n  const perPlant = plants.map((plant) => {\n    const testable = plantIsTestable(run, plant.transcripts);\n    const flipped: string[] = [];\n    const notFlipped: string[] = [];\n    const unresolvable: string[] = [];\n\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        unresolvable.push(key);\n        continue;\n      }\n\n      /* \"Unsound\" is label OUT or UNFOUNDED. UNKNOWN is not a flip: it means the labeller could not\n       * decide, and counting indecision as detection would let a system pass by refusing to commit. */\n      const labelled = run.labels.get(id);\n      if (labelled !== undefined && (labelled.label === \"OUT\" || labelled.label === \"UNFOUNDED\")) flipped.push(key);\n      else notFlipped.push(key);\n    }\n\n    return { plant: plant.id, testable, expectedUnsound: plant.expectUnsound, flipped, notFlipped, unresolvable };\n  });\n\n  const expected = perPlant.reduce((sum, entry) => sum + entry.expectedUnsound.length, 0);\n  const hit = perPlant.filter((entry) => entry.testable).reduce((sum, entry) => sum + entry.flipped.length, 0);\n  const value = expected === 0 ? 0 : hit / expected;\n\n  let outListPopulated = 0;\n  for (const justification of run.state.justifications.values()) {\n    if (justification.outList.length > 0) outListPopulated += 1;\n  }\n\n  const premiseGateRecords = run.state.contradictions.filter((record) => record.gate === \"premise\").length;\n\n  return {\n    perPlant,\n    outListPopulated,\n    decisionsTotal: run.state.decisions.size,\n    premiseGateRecords,\n    metric: {\n      id: \"invalidation-recall-l2\",\n      name: METRIC_NAMES[\"invalidation-recall-l2\"],\n      value,\n      detail: null,\n      n: expected,\n      perEngine: [{ engine: describeEngineId(engine), value, n: expected, detail: null }],\n      comparator: null, /* no comparator exists; COMPARATORS records that this is the finding */\n      gloss:\n        hit + \" of \" + expected + \" decision(s) that should have gone unsound when their premise was falsified actually did. \" +\n        outListPopulated + \" justification(s) carry a non-empty OUT-list, which is what makes the graph non-monotonic at all. \" +\n        premiseGateRecords + \" premise-gate record(s) were raised.\",\n      honestNote:\n        \"NO PUBLISHED COMPARATOR EXISTS ΓÇö no surveyed system detects that a decision's premise became false without the \" +\n        \"decision being mentioned, so there is no component to compare against and the absence is reported rather than \" +\n        \"filled with a borrowed number. n=\" + expected + \", which is ONE planted case (demo1's SQLite decision falsified by \" +\n        \"demo2). A single case supports the claim that the mechanism fires; it does not support any claim about a RATE, and \" +\n        \"no rate should be quoted from this metric. Measured with NO harness intervention: the refutation must be extracted \" +\n        \"from demo2's text and connected to demo1's premise by the reasoning layer, so a miss here may be an extraction \" +\n        \"failure rather than a reasoning one ΓÇö check premise-extraction before blaming gate (c). If outListPopulated is 0 \" +\n        \"the graph is monotonic and this metric is structurally incapable of scoring, which is a different finding from a \" +\n        \"detection failure and is printed beside the number for that reason.\",\n    },\n  };\n}\n\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\match.ts"},"span":[2856,2861],"sourceCode":"/**\n * Label-to-node alignment ΓÇö the step that decides what every extraction metric means.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * THE MATCHER IS THE METHODOLOGY\n *\n * Precision and recall are only as honest as the rule that decides whether an extracted node IS the\n * labelled one. A lenient rule inflates recall; a strict rule inflates the miss count; either can be\n * tuned until the number looks good, which is why the rule is written down here, in one place, at a\n * fixed threshold, and quoted in every metric's honest note.\n *\n * The rule: two character spans must OVERLAP by at least one character, inside the same transcript.\n * Overlap, not containment, because an extractor that finds the decision but quotes a wider clause\n * has still found the decision. One character, not a ratio, because a ratio threshold is a second\n * tuning knob and this file is trying to have none.\n *\n * Greedy by descending overlap, each side used at most once. Greedy is not optimal ΓÇö the Hungarian\n * algorithm would maximise total overlap ΓÇö but greedy is deterministic, explainable in one sentence,\n * and on spans that rarely compete the two agree. Optimality bought at the cost of explainability is\n * a bad trade in a benchmark whose whole purpose is to be checkable.\n *\n * ---------------------------------------------------------------------------\n * A VARIABLE MISMATCH IS REPORTED, NOT ABSORBED\n *\n * When the spans overlap but the variables disagree, that is not a miss and not a hit: the system\n * found the right sentence and understood it as the wrong kind of decision. Folding it into either\n * count hides the most diagnosable failure the extractor has, so it gets its own counter and its own\n * line in the report.\n * ---------------------------------------------------------------------------\n */\n\nexport interface Span {\n  readonly start: number;\n  readonly end: number;\n}\n\nexport interface AlignedPair<TLabel, TNode> {\n  readonly label: TLabel;\n  readonly node: TNode;\n  readonly overlap: number;\n}\n\nexport interface Alignment<TLabel, TNode> {\n  readonly pairs: readonly AlignedPair<TLabel, TNode>[];\n  readonly missed: readonly TLabel[];\n  readonly spurious: readonly TNode[];\n  readonly truePositives: number;\n  readonly falsePositives: number;\n  readonly falseNegatives: number;\n}\n\nexport function overlapOf(a: Span, b: Span): number {\n  const start = Math.max(a.start, b.start);\n  const end = Math.min(a.end, b.end);\n  return end > start ? end - start : 0;\n}\n\n/**\n * Align two sets greedily by descending overlap.\n *\n * `eligible` decides whether a pair may be aligned at all ΓÇö it is where the same-transcript\n * requirement lives, and where a metric can add a stricter condition without this file knowing about\n * decisions or premises.\n */\nexport function align<TLabel, TNode>(\n  labels: readonly TLabel[],\n  nodes: readonly TNode[],\n  labelSpan: (label: TLabel) => Span,\n  nodeSpan: (node: TNode) => Span,\n  eligible: (label: TLabel, node: TNode) => boolean,\n): Alignment<TLabel, TNode> {\n  const candidates: { li: number; ni: number; overlap: number }[] = [];\n\n  for (let li = 0; li < labels.length; li += 1) {\n    const label = labels[li];\n    if (label === undefined) continue;\n\n    for (let ni = 0; ni < nodes.length; ni += 1) {\n      const node = nodes[ni];\n      if (node === undefined) continue;\n      if (!eligible(label, node)) continue;\n\n      const overlap = overlapOf(labelSpan(label), nodeSpan(node));\n      if (overlap > 0) candidates.push({ li, ni, overlap });\n    }\n  }\n\n  /* Descending overlap, then by index, so ties resolve the same way on every run. Without the index\n   * tiebreak the order of equal-overlap pairs depends on the sort implementation, and a benchmark\n   * whose numbers move between runs is not a benchmark. */\n  candidates.sort((a, b) => b.overlap - a.overlap || a.li - b.li || a.ni - b.ni);\n\n  const usedLabels = new Set<number>();\n  const usedNodes = new Set<number>();\n  const pairs: AlignedPair<TLabel, TNode>[] = [];\n\n  for (const candidate of candidates) {\n    if (usedLabels.has(candidate.li) || usedNodes.has(candidate.ni)) continue;\n    usedLabels.add(candidate.li);\n    usedNodes.add(candidate.ni);\n\n    const label = labels[candidate.li];\n    const node = nodes[candidate.ni];\n    if (label === undefined || node === undefined) continue;\n    pairs.push({ label, node, overlap: candidate.overlap });\n  }\n\n  return {\n    pairs,\n    missed: labels.filter((_, index) => !usedLabels.has(index)),\n    spurious: nodes.filter((_, index) => !usedNodes.has(index)),\n    truePositives: pairs.length,\n    falsePositives: nodes.length - pairs.length,\n    falseNegatives: labels.length - pairs.length,\n  };\n}\n\n/** The matcher's rule, as a sentence. Quoted verbatim in every extraction metric's honest note so a\n *  reader of the report knows which rule produced the number without opening this file. */\nexport const MATCH_RULE =\n  \"spans must overlap by at least one character within the same transcript; aligned greedily by descending overlap, each side used once\";\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metric 6 ΓÇö cascade correctness at L3 (propagation), and metric 7, survivor preservation.\n *  engine: EngineId,\n): CascadeOutcome {\n  const plants = corpus.plants.filter(\n    (plant) => plant.kind === \"L3-cascade\" || plant.kind === \"L2-premise\",\n  );\n\n  const perPlant: PlantOutcome[] = plants.map((plant) => {      plant.falsify === undefined ||\n      plant.falsify.every((step) =>\n        run.interventions.some(\n          (outcome) =>\n            outcome.plant === plant.id && outcome.predicate === step.predicate && outcome.applied,\n        ),\n      );\n  });\n\n  const survivorsExpected = perPlant.reduce((sum, entry) => sum + entry.expectedSurvivors.length,0);\n  const survivorsKept = perPlant.reduce((sum, entry) => sum + entry.survived.length, 0);\n  const overRetractions = perPlant.reduce((sum, entry) => sum + entry.overRetracted.length, 0);      detail: null,\n      n: perPlant.length,\n      perEngine: [{engine: describeEngineId(engine),value: correctnessValue,n: perPlant.length,detail: null}],\n      comparator: null,\n      gloss:\n        correctPlants +\" of \" +perPlant.length +\" plant(s) were FULLY correct ΓÇö every expected flip happened and no \" +\n        \"survivor was retracted. \" +overRetractions +\" over-retraction(s) across \" +survivorsExpected +\" expected survivor(s).\",\n      honestNote:\n        \"Scored as a strict conjunction per plant: a cascade that flips the right nodes AND retracts a survivor scores 0, \" +\n        \"not partial credit, because over-retraction is the failure that destroys trust and partial credit would hide it. \" +\n        \"n=\" +\" plants ΓÇö small enough that this metric is a PASS/FAIL over named cases rather than a \" +\n        \"statistical rate, and it should be quoted as such. A plant whose intervention could not be applied, or whose \" +\n        \"survivor was never extracted, is scored as FAILED rather than skipped: skipping would make the number improve as \" +      detail: null,\n      n: survivorsExpected,\n      perEngine: [value: survivorValue,n: survivorsExpected,],\n      comparator: null,\n      gloss:\n        survivorsExpected === 0\n          ? \"VACUOUS: the corpus expected no survivors in the plants that ran, so 1.0 here means nothing was tested.\"\n          : survivorsKept +\" decision(s) that shared no falsified premise kept their label. \" +\n            overRetractions +\" were retracted anyway.\",\n      honestNote:\n        \"One of the two metrics ┬º7.2 calls unusual, and the one that predicts whether the product survives a real project. \" +\n        \"1.0 is VACUOUS when n=0 and the gloss says so rather than printing a perfect score for an untested property ΓÇö a \" +\n        \"benchmark that reports 100% because it measured nothing is worse than one that reports 40%. n=\" +survivorsExpected +\n        \" survivors, all from the single l03 plant, so this is a check that a specific mechanism does not over-fire, not an \" +\n        \"estimate of an over-retraction RATE. Nobody publishes a comparator because nobody cascades.\",  return decision !== undefined && (decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,100]}}},{"equalLines":{"line_count":74}},{"diffOp":{"equal":{"range":[100,178]}}},{"diffOp":{"insert":{"range":[178,183]}}},{"diffOp":{"equal":{"range":[183,252]}}},{"diffOp":{"insert":{"range":[252,256]}}},{"diffOp":{"equal":{"range":