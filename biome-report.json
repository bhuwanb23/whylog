mise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\n\" + warnings + \" warning-level guard(s) failed \\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"#!/usr/bin/env node\n/*\n * Emitted by the WhyLog export compiler alongside CLAUDE.md / AGENTS.md / DECISIONS.md.      } catch (error) {\n        const out = (error.stdout || error.stderr || \"\").toString().trim().split(\"\\n\")[0] || \"\";\n        return { outcome: \"fail\", evidence: \"`\" + spec.command + \"` exited non-zero\" + (out ? \"`: \" + ${out}`: \"\") };\n      }\n    }\nmain();\n","ops":[{"diffOp":{"equal":{"range":[0,111]}}},{"equalLines":{"line_count":1222}},{"diffOp":{"equal":{"range":[111,326]}}},{"diffOp":{"delete":{"range":[326,327]}}},{"diffOp":{"insert":{"range":[327,328]}}},{"diffOp":{"equal":{"range":[328,330]}}},{"diffOp":{"delete":{"range":[330,334]}}},{"diffOp":{"insert":{"range":[334,336]}}},{"diffOp":{"equal":{"range":[336,339]}}},{"diffOp":{"insert":{"range":[339,341]}}},{"diffOp":{"equal":{"range":[111,112]}}},{"diffOp":{"equal":{"range":[341,363]}}},{"equalLines":{"line_count":92}},{"diffOp":{"equal":{"range":[363,372]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\scripts\\whylog-guards.cjs"},"span":[36313,36323],"sourceCode":"#!/usr/bin/env node\n/*\n * Emitted by the WhyLog export compiler alongside CLAUDE.md / AGENTS.md / DECISIONS.m