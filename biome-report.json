a project with 400 decisions and a rate of 5 per 100 produces twenty interruptions, and twenty is\n * what determines whether the panel stays open. A rate over queries would measure something the user\n * never sees, because they do not query the graph twenty times a day ΓÇö they are interrupted by it.\n *\n * ---------------------------------------------------------------------------\n * WHAT COUNTS AS A FALSE POSITIVE\n *\n * A contradiction record is a false positive when no plant expects it AND its verdict is one the user\n * would experience as an interruption ΓÇö `contradiction` or `reversal`. `refinement` is excluded,\n * because the substrate treats refinement as the overwhelmingly common relationship between related\n * decisions and surfacing it as a conflict is precisely what docs/03 says gets a tool switched off\n * within a day; counting it here would measure the classifier's restraint rather than its errors.\n *\n * Label changes are counted too. A decision that flipped to OUT without any plant expecting it is an\n * interruption of exactly the same kind, and counting only contradiction records would let a system\n * achieve a perfect score by silently retracting decisions instead of reporting conflicts.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface FalsePositiveOutcome {\n  readonly metric: MetricResult;\n  readonly ratePer100: number;\n  readonly decisions: number;\n  readonly unexpectedContradictions: number;\n  readonly unexpectedRetractions: number;\n  readonly refinementVerdicts: number;\n  readonly examples: readonly string[];\n}\n\n/** Verdicts a user experiences as an interruption. `refinement` is deliberately absent. */\nconst INTERRUPTING = new Set([\"contradiction\", \"reversal\"]);\n\nexport function scoreFalsePositives(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): FalsePositiveOutcome {\n  /* Every decision the plants say should be flagged, by key. Anything outside this set is unexpected. */\n  const expected = new Set<string>();\n  for (const plant of corpus.plants) {\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id !== null) expected.add(id);\n    }\n  }\n\n  let unexpectedContradictions = 0;\n  let refinementVerdicts = 0;\n  const examples: string[] = [];\n\n  for (const record of run.state.contradictions) {\n    if (record.verdict === \"refinement\") {\n      refinementVerdicts += 1;\n      continue;\n    }\n    if (!INTERRUPTING.has(record.verdict)) continue;\n\n    /* A record is expected when EITHER side is a node some plant expected to become unsound. Requiring\n     * both would count a genuine detection as a false positive whenever the corpus only labelled one\n     * side of the pair. */\n    const aExpected = expected.has(record.decisionA);\n    const bExpected = record.decisionB !== undefined && expected.has(record.decisionB);\n    if (aExpected || bExpected) continue;\n\n    unexpectedContradictions += 1;\n    if (examples.length < 8) {\n      examples.push(\n        record.gate + \"/\" + record.verdict + \" ┬╖ \" + record.decisionA +\n          (record.decisionB === undefined ? \"\" : \" vs \" + record.decisionB) +\n          \" ┬╖ \" + record.explanation.slice(0, 90),\n      );\n    }\n  }\n\n  let unexpectedRetractions = 0;\n  for (const decision of run.state.decisions.values()) {\n    if (decision.label !== \"OUT\" && decision.label !== \"UNFOUNDED\") continue;\n    if (expected.has(decision.id)) continue;\n\n    unexpectedRetractions += 1;\n    if (examples.length < 8) {\n      examples.push(\"retraction ┬╖ \" + decision.id + \" (\" + decision.variable + \"=\" + decision.value + \") -> \" + decision.label);\n    }\n  }\n\n  const decisions = run.state.decisions.size;\n  const total = unexpectedContradictions + unexpectedRetractions;\n  const ratePer100 = decisions === 0 ? 0 : (total / decisions) * 100;\n\n  return {\n    ratePer100,\n    decisions,\n    unexpectedContradictions,\n    unexpectedRetractions,\n    refinementVerdicts,\n    examples,\n    metric: {\n      id: \"false-positive-rate\",\n      name: METRIC_NAMES[\"false-positive-rate\"],\n      /* Lower is better, which is the opposite of every other metric in the table. The report sorts by\n       * this one ascending and says so; a table where one row's good direction is inverted and nothing\n       * marks it is a table that will be misread. */\n      value: ratePer100,\n      detail: null,\n      n: decisions,\n      perEngine: [{ engine: describeEngineId(engine), value: ratePer100, n: decisions, detail: null }],\n      comparator: COMPARATORS[\"false-positive-rate\"] ?? {\n        source: \"ARGUS (arXiv:2604.10345)\",\n        value: \"FP:FN 13:1 ΓÇö 155 false positives against 12 false negatives on alternatives\",\n      },\n      gloss:\n        ratePer100.toFixed(1) + \" unexpected interruption(s) per 100 decisions (\" + unexpectedContradictions +\n        \" contradiction(s) and \" + unexpectedRetractions + \" unexplained retraction(s) over \" + decisions +\n        \" decisions). \" + refinementVerdicts + \" refinement verdict(s) were correctly NOT surfaced as conflicts.\",\n      honestNote:\n        \"LOWER IS BETTER ΓÇö the only metric in the table whose good direction is inverted. The denominator is decisions in \" +\n        \"the graph, not queries, because that is the quantity a user experiences: they are interrupted by the tool rather \" +\n        \"than polling it. 'Unexpected' means no plant labelled it, so a detection that is CORRECT but unlabelled counts \" +\n        \"against the system ΓÇö this metric is biased pessimistic by construction, and on a corpus of \" + decisions +\n        \" decisions a single unlabelled true positive moves the rate by several points. ARGUS's 13:1 is a ratio over \" +\n        \"alternatives in a different corpus and is cited as the nearest published statement of the same failure, not as a \" +\n        \"like-for-like rate. Refinement verdicts are excluded on purpose: surfacing them is what docs/03 says gets a tool \" +\n        \"switched off, so counting them would measure restraint rather than error.\",\n    },\n  };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Phase 0 ΓÇö the app boots, records, and survives a reload.\n *    const first = parsed.events[0];\n    expect(first).toBeDefined();\n    if (first) first.payload[\"rawChars\"]first.payload.rawChars= 999999;\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));\n  });\n});\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":107}},{"diffOp":{"equal":{"range":[68,152]}}},{"diffOp":{"delete":{"range":[152,177]}}},{"diffOp":{"insert":{"range":[177,199]}}},{"diffOp":{"equal":{"range":[68,69]}}},{"diffOp":{"equal":{"range":[199,272]}}},{"equalLines":{"line_count":23}},{"diffOp":{"equal":{"range":[272,282]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\substrate\\boot-reload.test.ts"},"span":[3568,3578],"sourceCode":"/**\n * Phase 0 ΓÇö the app boots, records, and survives a reload.\n *\n * Plan: plan/phase-0-foundation.md ┬º0.10 acceptance criteria\n *   \"The app boots with an empty log, renders an empty state, and survives a\n *    reload.\"\n *\n * The substrate test (tests/unit/substrate/round-trip.test.ts) proves the LOG\n * round-trips. This proves the APP does: the store reads the log back out of\n * localStorage and rebuilds the state by folding it, which is the path a\n * browser reload actually takes.\n */\n\nimport { beforeEach, describe, expect, it } from \"vitest\";\n\nimport { nowISO } from \"@/lib/format\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { emptyLog } from \"@/substrate/event-log\";\nimport { emptyState } from \"@/substrate/graph-state\";\nimport { STORAGE_KEY } from \"@/substrate/schema\";\nimport type { Actor, ISODateString } from \"@/types/common\";\n\nconst HUMAN: Actor = { kind: \"human\" };\n\n/** Put the store back the way a fresh page load would find it. */\nfunction simulateReload(): void {\n  useWhyLog.setState({\n    log: emptyLog(),\n    state: emptyState(useWhyLog.getState().engineId, nowISO() as ISODateString),\n    status: \"booting\",\n    pristine: true,\n    notices: [],\n    verification: null,\n  });\n  useWhyLog.getState().boot();\n}\n\ndescribe(\"Phase 0 ┬╖ the app boots and survives a reload\", () => {\n  beforeEach(() => {\n    localStorage.clear();\n    simulateReload();\n  });\n\n  it(\"boots empty with nothing in storage\", () => {\n    const state = useWhyLog.getState();\n    expect(state.status).toBe(\"empty\");\n    expect(state.pristine).toBe(true);\n    expect(state.log.events.length).toBe(0);\n    expect(state.state.decisions.size).toBe(0);\n  });\n\n  it(\"records a decision, persists it, and reads it back after a reload\", () => {\n    const before = useWhyLog.getState();\n    expect(before.status).toBe(\"empty\");\n\n    const result = before.record(\n      {\n        type: \"TranscriptImported\",\n        payload: {\n          transcriptId: \"T-0001\" as never,\n          rawChars: 64,\n          engine: before.engineId,\n        },\n        actor: HUMAN,\n        reason: \"pasted a transcript\",\n      },\n      { reason: \"pasted a transcript\" },\n    );\n    expect(result.ok).toBe(true);\n\n    const recorded = useWhyLog.getState();\n    expect(recorded.log.events.length).toBe(1);\n    expect(recorded.status).toBe(\"loaded\");\n\n    // The log is on disk, not just in memory.\n    const stored = localStorage.getItem(STORAGE_KEY);\n    expect(stored).not.toBeNull();\n\n    simulateReload();\n\n    const after = useWhyLog.getState();\n    expect(after.status).toBe(\"loaded\");\n    expect(after.log.events.length).toBe(1);\n    expect(after.log.headHash).toBe(recorded.log.headHash);\n    expect(after.state.events.length).toBe(1);\n  });\n\n  it(\"boots read-only and reports the damage when the chain is broken\", () => {\n    const store = useWhyLog.getState();\n    store.record(\n      {\n        type: \"TranscriptImported\",\n        payload: {\n          transcriptId: \"T-0001\" as never,\n          rawChars: 64,\n          engine: store.engineId,\n        },\n        actor: HUMAN,\n        reason: \"pasted a transcript\",\n      },\n      { reason: \"pasted a transcript\" },\n    );\n\n    // Corrupt the stored log the way a silent edit would: change an event's\n    // payload without touching its hash.\n    const raw = localStorage.getItem(STORAGE_KEY);\n    expect(raw).not.toBeNull();\n    const parsed = JSON.parse(raw as string) as {\n      events: { payload: Record<string, unknown> }[];\n    };\n    const first = parsed.events[0];\n    expect(first).toBeDefined();\n    if (first) first.payload[\"rawChars\"] = 999999;\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));\n\n    simulateReload();\n\n    const after = useWhyLog.getState();\n    expect(after.status).toBe(\"degraded\");\n    expect(after.verification?.valid).toBe(false);\n    expect(after.notices.some((n) => n.tone === \"error\")).toBe(true);\n\n    // And the degraded log is read-only: recording is refused, not silently\n    // extending a chain that no longer proves anything.\n    const refused = after.record(\n      {\n        type: \"TranscriptImported\",\n        payload: {\n          transcriptId: \"T-0002\" as never,\n          rawChars: 1,\n          engine: after.engineId,\n        },\n        actor: HUMAN,\n        reason: \"another transcript\",\n      },\n      { reason: \"another transcript\" },\n    );\n    expect(refused.ok).toBe(false);\n  });\n});\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metric 9 ΓÇö answer groundedness, and whether the system refuses when it should.\n *export const MAX_SEARCHES = 3;\n\nexport function scoreGroundedness(\n  corpus: ResolvedCorpus, run: RunResult,engine: EngineId,\n): GroundednessOutcome {\n  const perQuestion = run.questions.map((entry) => {\n    const answer = entry.answer;\n    const claims = answer === null ? 0 : answer.claims.length;\n    const groundedClaims =\n      answer === null ? 0 : answer.claims.filter((claim) => claim.grounded).length;\n\n    /* 0/0 is not 1. An answer with no claims has demonstrated nothing; scoring it as perfectly      comparator: COMPARATORS[\"answer-groundedness\"] ?? null,\n      gloss:\n        correctVerdicts +\n        \" of \" +perQuestion.length +\" answer(s) carried the verdict the corpus expected. Mean \" +\n        \"groundedness \" +meanGroundedness.toFixed(3) +\" (\" +\n        perQuestion.reduce((sum, entry) => sum + entry.groundedClaims, 0) +\" grounded claim(s) of \" +\n        perQuestion.reduce((sum, entry) => sum + entry.claims, 0) +\"). \" +\n        searchBudgetViolations +\" answer(s) exceeded the \" +MAX_SEARCHES +\"-search budget. Refusals: \" +\n        refusalsCorrect +refusalsExpected +\" correct.\",\n      honestNote:\n        \"The headline is VERDICT ACCURACY, not mean groundedness, because groundedness measures whether an answer's claims \" +\n        \"cite things that exist ΓÇö and a confidently wrong answer can score 1.0 on it. RepoRationale specifies the contract \" +\n        \"but publishes no quantity, so there is nothing to beat and the three clauses are CHECKED instead: search budget, \" +\n        \"citation resolution, refusal. n=\" +\" questions, of which \" +refusalsExpected +\n        \" is deliberately unanswerable and scores as a HIT when the system refuses ΓÇö the only place in this suite where \" +\n        \"producing no output earns the point. An answer with zero claims is scored 0, not 1: 0/0 would reward silence. \" +\n        emptyAnswers +\" empty answer(s) were produced, which should be read against the refusal count before concluding \" +\n        \"anything about restraint.\",\n    },\nexport type { ResolvedCorpus };\n","ops":[{"diffOp":{"equal":{"range":[0,90]}}},{"equalLines":{"line_count":61}},{"diffOp":{"equal":{"range":[90,156]}}},{"diffOp":{"insert":{"range":[156,159]}}},{"diffOp":{"equal":{"range":[159,182]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[156,159]}}},{"diffOp":{"equal":{"range":[183,198]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[156,159]}}},{"diffOp":{"equal":{"range":[198,214]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[216,326]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[326,416]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[416,423]}}},{"diffOp":{"equal":{"range":[423,597]}}},{"equalLines":{"line_count":55}},{"diffOp":{"equal":{"range":[597,697]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[706,714]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[714,734]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[734,821]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[821,850]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[850,932]}}},{"diffOp":{"delete":{"range":[182,183]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[932,1026]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1026,1066]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1066,1094]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1094,1108]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1108,1164]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[706,714]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1164,1182]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1182,1639]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[714,734]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1639,1664]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1664,1954]}}},{"diffOp":{"delete":{"range":[597,598]}}},{"diffOp":{"insert":{"range":[697,706]}}},{"diffOp":{"equal":{"range":[1954,2099]}}},{"equalLines":{"line_count":2}},{"diffOp":{"equal":{"range":[2099,2132]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\groundedness.ts"},"span":null,"sourceCode":"/**\n * Metric 9 ΓÇö answer groundedness, and whether the system refuses when it should.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: RepoRationale ΓÇö specifies the contract, publishes no quantity.\n *\n * ---------------------------------------------------------------------------\n * THE CONTRACT IS THE CONTRIBUTION, SO THE CONTRACT IS WHAT GETS MEASURED\n *\n * RepoRationale's evidence contract has three parts: at most three searches, every citation resolves\n * within the run, and \"insufficient evidence\" is a first-class answer rather than a failure. It\n * publishes no number for any of them, so there is nothing to beat ΓÇö but there is something to CHECK,\n * and checking a contract is a measurement even when the literature never quantified it.\n *\n * Three quantities are reported, one per clause:\n *   1. groundedness ΓÇö |claims with a resolving citation| / |claims|, the number the answer carries\n *   2. search-budget compliance ΓÇö did any answer exceed three searches\n *   3. refusal correctness ΓÇö on the unanswerable question, did it refuse\n *\n * ---------------------------------------------------------------------------\n * REFUSAL IS SCORED AS A HIT, WHICH IS THE UNUSUAL PART\n *\n * Almost every retrieval benchmark treats \"no answer\" as a failure. Under an evidence contract it is the\n * correct output for a question the corpus cannot answer, and a system that answers it anyway has\n * fabricated a claim. So the unanswerable question contributes a HIT when the verdict is\n * INSUFFICIENT_EVIDENCE and a MISS when it is anything else ΓÇö the only metric in this suite where\n * refusing to produce output is what earns the point.\n *\n * ---------------------------------------------------------------------------\n * ZERO CLAIMS IS NOT GROUNDED\n *\n * `0 / 0` would be `1` under naive division, which would score an empty answer as perfectly grounded.\n * Phase 3 settled this explicitly: an answer with no claims has demonstrated nothing and is not\n * grounded. This metric inherits that rule rather than re-deciding it, and reports empty answers as a\n * separate count so a system that refuses everything is visibly distinguishable from one that refuses\n * correctly once.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface GroundednessOutcome {\n  readonly metric: MetricResult;\n  readonly perQuestion: readonly {\n    question: string;\n    verdict: string;\n    expectedVerdict: string;\n    correct: boolean;\n    groundedness: number;\n    claims: number;\n    groundedClaims: number;\n    searches: number;\n    overBudget: boolean;\n    unanswerable: boolean;\n  }[];\n  readonly searchBudgetViolations: number;\n  readonly refusalsCorrect: number;\n  readonly refusalsExpected: number;\n  readonly emptyAnswers: number;\n}\n\nexport const MAX_SEARCHES = 3;\n\nexport function scoreGroundedness(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): GroundednessOutcome {\n  const perQuestion = run.questions.map((entry) => {\n    const answer = entry.answer;\n    const unanswerable = entry.question.relevant.length === 0;\n\n    const claims = answer === null ? 0 : answer.claims.length;\n    const groundedClaims = answer === null ? 0 : answer.claims.filter((claim) => claim.grounded).length;\n\n    /* 0/0 is not 1. An answer with no claims has demonstrated nothing; scoring it as perfectly\n     * grounded would reward silence, and silence is what a system produces when it is broken. */\n    const groundedness = claims === 0 ? 0 : groundedClaims / claims;\n\n    const searches = answer === null ? 0 : answer.trace.searches.length;\n\n    const verdict = answer === null ? \"ERROR\" : answer.verdict;\n    const correct = verdict === entry.question.expectVerdict;\n\n    return {\n      question: entry.question.id,\n      verdict,\n      expectedVerdict: entry.question.expectVerdict,\n      correct,\n      groundedness,\n      claims,\n      groundedClaims,\n      searches,\n      overBudget: searches > MAX_SEARCHES,\n      unanswerable,\n    };\n  });\n\n  const searchBudgetViolations = perQuestion.filter((entry) => entry.overBudget).length;\n  const refusalsExpected = perQuestion.filter((entry) => entry.unanswerable).length;\n  const refusalsCorrect = perQuestion.filter(\n    (entry) => entry.unanswerable && entry.verdict === \"INSUFFICIENT_EVIDENCE\",\n  ).length;\n  const emptyAnswers = perQuestion.filter((entry) => entry.claims === 0).length;\n\n  /* The headline value is VERDICT ACCURACY, not mean groundedness. Groundedness measures the internal\n   * consistency of an answer ΓÇö did its claims cite things that exist ΓÇö and a confidently wrong answer\n   * can score 1.0 on it. Verdict accuracy measures whether the system correctly judged what it knew,\n   * which is the property the evidence contract exists to guarantee. Mean groundedness is reported\n   * beside it in the gloss. */\n  const correctVerdicts = perQuestion.filter((entry) => entry.correct).length;\n  const value = perQuestion.length === 0 ? 0 : correctVerdicts / perQuestion.length;\n\n  const meanGroundedness =\n    perQuestion.length === 0\n      ? 0\n      : perQuestion.reduce((sum, entry) => sum + entry.groundedness, 0) / perQuestion.length;\n\n  return {\n    perQuestion,\n    searchBudgetViolations,\n    refusalsCorrect,\n    refusalsExpected,\n    emptyAnswers,\n    metric: {\n      id: \"answer-groundedness\",\n      name: METRIC_NAMES[\"answer-groundedness\"],\n      value,\n      detail: null,\n      n: perQuestion.length,\n      perEngine: [{ engine: describeEngineId(engine), value, n: perQuestion.length, detail: null }],\n      comparator: COMPARATORS[\"answer-groundedness\"] ?? null,\n      gloss:\n        correctVerdicts + \" of \" + perQuestion.length + \" answer(s) carried the verdict the corpus expected. Mean \" +\n        \"groundedness \" + meanGroundedness.toFixed(3) + \" (\" +\n        perQuestion.reduce((sum, entry) => sum + entry.groundedClaims, 0) + \" grounded claim(s) of \" +\n        perQuestion.reduce((sum, entry) => sum + entry.claims, 0) + \"). \" +\n        searchBudgetViolations + \" answer(s) exceeded the \" + MAX_SEARCHES + \"-search budget. Refusals: \" +\n        refusalsCorrect + \" of \" + refusalsExpected + \" correct.\",\n      honestNote:\n        \"The headline is VERDICT ACCURACY, not mean groundedness, because groundedness measures whether an answer's claims \" +\n        \"cite things that exist ΓÇö and a confidently wrong answer can score 1.0 on it. RepoRationale specifies the contract \" +\n        \"but publishes no quantity, so there is nothing to beat and the three clauses are CHECKED instead: search budget, \" +\n        \"citation resolution, refusal. n=\" + perQuestion.length + \" questions, of which \" + refusalsExpected +\n        \" is deliberately unanswerable and scores as a HIT when the system refuses ΓÇö the only place in this suite where \" +\n        \"producing no output earns the point. An answer with zero claims is scored 0, not 1: 0/0 would reward silence. \" +\n        emptyAnswers + \" empty answer(s) were produced, which should be read against the refusal count before concluding \" +\n        \"anything about restraint.\",\n    },\n  };\n}\n\nexport type { ResolvedCorpus };\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 13 ΓÇö modality precision: of the statements the system DECLINED, how many were correctly declined.\n *      perEngine: [{ engine: describeEngineId(engine), value, n: declines.length, detail: null }],\n      comparator: null,\n      gloss:\n        `${correctlyDeclined + \"} of \" + ${declines.length non-decisions were correctly left out of the graph; \" +\n        wronglyPromoted.lengthbecame nodes anyway.,\n      honestNote:\n        \"This is a PRECISION over declines, not a recall over hypotheticals: the denominator is the statements the corpus \" +  return \"unknown\";\n}\n","ops":[{"diffOp":{"equal":{"range":[0,116]}}},{"equalLines":{"line_count":95}},{"diffOp":{"equal":{"range":[116,250]}}},{"diffOp":{"equal":{"range":[250,259]}}},{"diffOp":{"insert":{"range":[259,262]}}},{"diffOp":{"equal":{"range":[262,279]}}},{"diffOp":{"delete":{"range":[279,283]}}},{"diffOp":{"insert":{"range":[283,284]}}},{"diffOp":{"equal":{"range":[284,288]}}},{"diffOp":{"delete":{"range":[288,292]}}},{"diffOp":{"insert":{"range":[292,294]}}},{"diffOp":{"equal":{"range":[294,309]}}},{"diffOp":{"delete":{"range":[279,283]}}},{"diffOp":{"insert":{"range":[283,284]}}},{"diffOp":{"equal":{"range":[309,362]}}},{"diffOp":{"delete":{"range":[362,374]}}},{"diffOp":{"insert":{"range":[292,294]}}},{"diffOp":{"equal":{"range":[374,396]}}},{"diffOp":{"delete":{"range":[279,281]}}},{"diffOp":{"insert":{"range":[283,284]}}},{"diffOp":{"equal":{"range":[309,310]}}},{"diffOp":{"delete":{"range":[362,364]}}},{"diffOp":{"equal":{"range":[396,416]}}},{"diffOp":{"delete":{"range":[362,363]}}},{"diffOp":{"insert":{"range":[259,260]}}},{"diffOp":{"equal":{"range":[416,561]}}},{"equalLines":{"line_count":13}},{"diffOp":{"equal":{"range":[561,583]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\modality.ts"},"span":[5073,5234],"sourceCode":"/**\n * Metric 13 ΓÇö modality precision: of the statements the system DECLINED, how many were correctly declined.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: none published. ┬º7.2 calls this one of the two unusual metrics.\n *\n * ---------------------------------------------------------------------------\n * THE INVERSE OF THE USUAL QUESTION, AND THE ONE THAT MATTERS HERE\n *\n * Every extraction metric asks \"did you find the things that are there\". This one asks \"did you leave\n * alone the things that are not decisions\". A system that turns \"what if we used Redis?\" into a Redis\n * decision has perfect recall and is unusable, because the graph now contains things nobody decided\n * and every downstream guarantee ΓÇö contradiction detection, cascade, export ΓÇö is built on a lie.\n *\n * It is called precision rather than specificity because that is what it is: of the population the\n * system declined to promote, the fraction it was right to decline. The denominator is the declines,\n * not the hypotheticals, so a system that declines nothing scores zero rather than undefined.\n *\n * ---------------------------------------------------------------------------\n * WHY NOBODY MEASURES IT\n *\n * Because nobody's extractor is allowed to decline. A rationale miner over commit messages has no\n * hypotheticals to decline ΓÇö a commit message does not speculate. Agent dialogue is the first corpus\n * in this literature where speculation, reported speech and rejected proposals outnumber decisions,\n * which is why the metric exists here and not in the surveyed systems. Reporting it as \"no comparator\"\n * is accurate rather than modest.\n *\n * ---------------------------------------------------------------------------\n * THE DEMO-KILLER THIS GUARDS\n *\n * ┬º7.4 names \"hypotheticals becoming nodes\" as one of four demo-killers. This is the number that says\n * whether it happens. It is reported per transcript tier as well as in aggregate, because the\n * adversarial tier is where the failure lives and an aggregate over twelve transcripts can hide a\n * catastrophic 0.0 on three of them behind a good score on nine.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { ResolvedCorpus, ResolvedDecision } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { overlapOf } from \"./match\";\nimport { METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface ModalityOutcome {\n  readonly metric: MetricResult;\n  /** Statements the corpus says must NOT become nodes, and did. Each one is a visible defect. */\n  readonly wronglyPromoted: readonly { label: ResolvedDecision; node: Decision }[];\n  /** Statements the corpus says must not become nodes, and did not. Correct declines. */\n  readonly correctlyDeclined: number;\n  readonly declinesExpected: number;\n  readonly byTier: readonly { tier: string; expected: number; wronglyPromoted: number }[];\n}\n\nexport function scoreModalityPrecision(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): ModalityOutcome {\n  const nodes: Decision[] = [...run.state.decisions.values()];\n  const declines: { label: ResolvedDecision; tier: string }[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    for (const label of transcript.decisions) {\n      if (label.expectNode) continue;\n      declines.push({ label, tier: transcript.tier });\n    }\n  }\n\n  const wronglyPromoted: { label: ResolvedDecision; node: Decision }[] = [];\n\n  for (const entry of declines) {\n    /* A decline is violated when ANY node overlaps the labelled span. Variable agreement is not\n     * required, because the failure mode is not \"found it and mislabelled the variable\" ΓÇö it is \"made\n     * a node out of a sentence that was not a decision\", and such a node may carry any variable. */\n    const hit = nodes.find((node) =>\n      overlapOf(entry.label.span, { start: node.provenance.snippet.start, end: node.provenance.snippet.end }) > 0,\n    );\n    if (hit !== undefined) wronglyPromoted.push({ label: entry.label, node: hit });\n  }\n\n  const correctlyDeclined = declines.length - wronglyPromoted.length;\n  const value = declines.length === 0 ? 1 : correctlyDeclined / declines.length;\n\n  const tiers = [...new Set(corpus.transcripts.map((transcript) => transcript.tier))];\n  const byTier = tiers.map((tier) => {\n    const expected = declines.filter((entry) => entry.tier === tier).length;\n    const wrong = wronglyPromoted.filter((entry) => tierOf(corpus, entry.label) === tier).length;\n    return { tier, expected, wronglyPromoted: wrong };\n  });\n\n  return {\n    wronglyPromoted,\n    correctlyDeclined,\n    declinesExpected: declines.length,\n    byTier,\n    metric: {\n      id: \"modality-precision\",\n      name: METRIC_NAMES[\"modality-precision\"],\n      value,\n      detail: null,\n      n: declines.length,\n      perEngine: [{ engine: describeEngineId(engine), value, n: declines.length, detail: null }],\n      comparator: null,\n      gloss:\n        correctlyDeclined + \" of \" + declines.length + \" non-decisions were correctly left out of the graph; \" +\n        wronglyPromoted.length + \" became nodes anyway.\",\n      honestNote:\n        \"This is a PRECISION over declines, not a recall over hypotheticals: the denominator is the statements the corpus \" +\n        \"marks as must-not-become-nodes, so a system that declines nothing scores 0 rather than undefined. n=\" +\n        declines.length + \", concentrated in the adversarial tier, which is small enough that one violation moves the number \" +\n        \"by several points ΓÇö the per-tier breakdown is printed beside it for that reason. No comparator exists because no \" +\n        \"surveyed extractor operates on a corpus where speculation outnumbers decisions; the absence is a property of the \" +\n        \"literature, not a gap in this measurement.\",\n    },\n  };\n}\n\nfunction tierOf(corpus: ResolvedCorpus, label: ResolvedDecision): string {\n  for (const transcript of corpus.transcripts) {\n    if (transcript.decisions.some((candidate) => candidate === label)) return transcript.tier;\n  }\n  return \"unknown\";\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 13 ΓÇö modality precision: of the statements the system DECLINED, how many were correctly declined.\n *        correctlyDeclined + \" of \" + declines.length + \" non-decisions were correctly left out of the graph; \" +\n        wronglyPromoted.length + \" became nodes anyway.\",\n      honestNote:\n        \"`This is a PRECISION over declines, not a recall over hypotheticals: the denominator is the statements the corpus \" +\n        \"marks as must-not-become-nodes, so a system that declines nothing scores 0 rather than undefined. n=${declines.length + \"}, concentrated in the adversarial tier, which is small enough that one violation moves the number by several points ΓÇö the per-tier breakdown is printed beside it for that reason. No comparator exists because no \"+\n        \"surveyed extractor operates on a corpus where speculation outnumbers decisions; the absence is a property of the literature, not a gap in this measurement.,\n    },\n  };  return \"unknown\";\n}\n","ops":[{"diffOp":{"equal":{"range":[0,116]}}},{"equalLines":{"line_count":98}}