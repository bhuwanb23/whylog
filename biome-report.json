?? \"ablation-report.md\",\n      renderAblationMarkdown(study, baseline === null ? null : baseline.scored),\n    );\n  }\n\n  blank();\n  line(\"A delta is only meaningful against the baseline row. If the baseline threw, nothing below it means anything.\");\n}\n\nfunction renderAblationMarkdown(study: AblationStudy, baseline: ScoredRun | null): string {\n  const parts = [\n    \"# Ablation study\",\n    \"\",\n    \"Corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n      (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",\n    \"delta always means the full system is better. Thresholds were declared in `toggles.ts` before any\",\n    \"configuration was run.\",\n    \"\",\n    \"```\",\n    describeStudy(study),\n    \"\",\n    renderAblationTable(study),\n    \"\",\n    renderPredictionAudit(study),\n    \"```\",\n    \"\",\n  ];\n\n  if (baseline !== null) {\n    parts.push(\"## Baseline metrics\", \"\", \"```\", renderSuite(baseline), \"```\", \"\");\n  }\n\n  return parts.join(\"\\n\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *\nmain().catch((error: unknown) => {\n  process.stderr.write(\"`\\n\" + (${error instanceof Error ? error.stack ?? error.message : String(error)) + \"});\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,114]}}},{"equalLines":{"line_count":76}},{"diffOp":{"equal":{"range":[114,173]}}},{"diffOp":{"delete":{"range":[173,174]}}},{"diffOp":{"insert":{"range":[174,175]}}},{"diffOp":{"equal":{"range":[175,177]}}},{"diffOp":{"delete":{"range":[177,182]}}},{"diffOp":{"insert":{"range":[182,184]}}},{"diffOp":{"equal":{"range":[184,253]}}},{"diffOp":{"delete":{"range":[253,258]}}},{"diffOp":{"insert":{"range":[258,259]}}},{"diffOp":{"equal":{"range":[175,177]}}},{"diffOp":{"delete":{"range":[177,178]}}},{"diffOp":{"insert":{"range":[174,175]}}},{"diffOp":{"equal":{"range":[259,290]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\cli.ts"},"span":[2846,2931],"sourceCode":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * A separate entry point from `ablation/run.ts` on purpose. `run.ts` is imported by `table.ts`, and a\n * module that starts a fifteen-configuration study on import would run the study every time anything\n * read the table renderer. Side effects belong at the edge.\n */\n\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"../cli\";\nimport { renderSuite, type ScoredRun } from \"../metrics\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./run\";\nimport { renderAblationTable, renderPredictionAudit } from \"./table\";\nimport { describePlan, fullPlan } from \"./toggles\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, engineId } = prepare();\n\n  const plan = fullPlan();\n\n  banner(\"Ablation study ΓÇö \" + plan.length + \" configurations\");\n  line(describePlan(plan));\n  blank();\n  line(\"This runs the full corpus once per configuration, sequentially. Configurations are NOT run\");\n  line(\"concurrently: the harness mints ids from a counter and stamps learned time from a clock that\");\n  line(\"advances per call, and interleaving them would make deltas unattributable to the toggles.\");\n\n  const study = await runAblation(resolved, { engineId });\n\n  heading(\"Study\");\n  line(describeStudy(study));\n\n  heading(\"Delta table\");\n  line(renderAblationTable(study));\n\n  heading(\"Prediction audit\");\n  line(renderPredictionAudit(study));\n\n  if (args.has(\"out\")) {\n    const baseline = study.baseline;\n    write(\n      args.get(\"out\") ?? \"ablation-report.md\",\n      renderAblationMarkdown(study, baseline === null ? null : baseline.scored),\n    );\n  }\n\n  blank();\n  line(\"A delta is only meaningful against the baseline row. If the baseline threw, nothing below it means anything.\");\n}\n\nfunction renderAblationMarkdown(study: AblationStudy, baseline: ScoredRun | null): string {\n  const parts = [\n    \"# Ablation study\",\n    \"\",\n    \"Corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n      (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",\n    \"delta always means the full system is better. Thresholds were declared in `toggles.ts` before any\",\n    \"configuration was run.\",\n    \"\",\n    \"```\",\n    describeStudy(study),\n    \"\",\n    renderAblationTable(study),\n    \"\",\n    renderPredictionAudit(study),\n    \"```\",\n    \"\",\n  ];\n\n  if (baseline !== null) {\n    parts.push(\"## Baseline metrics\", \"\", \"```\", renderSuite(baseline), \"```\", \"\");\n  }\n\n  return parts.join(\"\\n\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"../cli\";\nimport { renderSuite, type ScoredRun, renderSuite } from \"../metrics\";\nimport { type AblationStudy, describeStudy, runAblation, type AblationStudy } from \"./run\";\nimport { renderAblationTable, renderPredictionAudit } from \"./table\";\nimport { describePlan, fullPlan } from \"./toggles\";  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,114]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[114,205]}}},{"diffOp":{"delete":{"range":[205,218]}}},{"diffOp":{"equal":{"range":[218,232]}}},{"diffOp":{"insert":{"range":[232,245]}}},{"diffOp":{"equal":{"range":[245,276]}}},{"diffOp":{"insert":{"range":[276,296]}}},{"diffOp":{"equal":{"range":[296,322]}}},{"diffOp":{"delete":{"range":[322,342]}}},{"diffOp":{"equal":{"range":[342,480]}}},{"equalLines":{"line_count":67}},{"diffOp":{"equal":{"range":[480,508]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\cli.ts"},"span":null,"sourceCode":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * A separate entry point from `ablation/run.ts` on purpose. `run.ts` is imported by `table.ts`, and a\n * module that starts a fifteen-configuration study on import would run the study every time anything\n * read the table renderer. Side effects belong at the edge.\n */\n\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"../cli\";\nimport { renderSuite, type ScoredRun } from \"../metrics\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./run\";\nimport { renderAblationTable, renderPredictionAudit } from \"./table\";\nimport { describePlan, fullPlan } from \"./toggles\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, engineId } = prepare();\n\n  const plan = fullPlan();\n\n  banner(\"Ablation study ΓÇö \" + plan.length + \" configurations\");\n  line(describePlan(plan));\n  blank();\n  line(\"This runs the full corpus once per configuration, sequentially. Configurations are NOT run\");\n  line(\"concurrently: the harness mints ids from a counter and stamps learned time from a clock that\");\n  line(\"advances per call, and interleaving them would make deltas unattributable to the toggles.\");\n\n  const study = await runAblation(resolved, { engineId });\n\n  heading(\"Study\");\n  line(describeStudy(study));\n\n  heading(\"Delta table\");\n  line(renderAblationTable(study));\n\n  heading(\"Prediction audit\");\n  line(renderPredictionAudit(study));\n\n  if (args.has(\"out\")) {\n    const baseline = study.baseline;\n    write(\n      args.get(\"out\") ?? \"ablation-report.md\",\n      renderAblationMarkdown(study, baseline === null ? null : baseline.scored),\n    );\n  }\n\n  blank();\n  line(\"A delta is only meaningful against the baseline row. If the baseline threw, nothing below it means anything.\");\n}\n\nfunction renderAblationMarkdown(study: AblationStudy, baseline: ScoredRun | null): string {\n  const parts = [\n    \"# Ablation study\",\n    \"\",\n    \"Corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n      (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",\n    \"delta always means the full system is better. Thresholds were declared in `toggles.ts` before any\",\n    \"configuration was run.\",\n    \"\",\n    \"```\",\n    describeStudy(study),\n    \"\",\n    renderAblationTable(study),\n    \"\",\n    renderPredictionAudit(study),\n    \"```\",\n    \"\",\n  ];\n\n  if (baseline !== null) {\n    parts.push(\"## Baseline metrics\", \"\", \"```\", renderSuite(baseline), \"```\", \"\");\n  }\n\n  return parts.join(\"\\n\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 26 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 26 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 26 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\time-machine\\projection.ts"},"span":[6180,6190],"sourceCode":"/**\n * Bi-temporal replay ΓÇö 6.7.\n *\n * Phase 6 ┬╖ sub-phase 6.7\n * Plan: plan/phase-6-presentation.md ┬º6.7\n *\n * ---------------------------------------------------------------------------\n * THE PAYOFF FOR PHASE 0.3, AND NEARLY FREE\n *\n * The fold is pure and total, so replaying a PREFIX of the log is not a feature to build ΓÇö it is a\n * call to `materializeAsOf` that has been sitting in the substrate since Phase 0. This module is\n * mostly about presenting it honestly.\n *\n * ---------------------------------------------------------------------------\n * TWO SLIDERS, BECAUSE TWO TIMELINES, AND THEY DIVERGE CONSTANTLY\n *\n *   valid time    \"what was true then\"      ΓÇö filter by `isValidAt(window, T)` over a full fold\n *   learned time  \"what did we know then\"   ΓÇö fold only the events with `at <= T`\n *\n * They are not two views of one ordering. In this product's actual workflow they diverge every time:\n * you paste a three-week-old transcript, so the system LEARNS today about a decision MADE on the 3rd.\n * Sliding learned time back to last week hides that decision entirely; sliding valid time back to the\n * 3rd shows it. Both are correct answers to different questions.\n *\n * The plan's risk is \"time machine confuses two timelines\", and the mitigation is to label them\n * explicitly and never show one without naming it. So every rendering in this module carries the\n * phrase \"when it happened\" or \"when we learned\", and the diff strip says which axis it measured\n * along.\n *\n * ---------------------------------------------------------------------------\n * THE DIFF STRIP IS THE PART THAT MAKES IT USEFUL\n *\n * A frozen picture of the past is a curiosity. What changed between then and now ΓÇö decisions added,\n * premises invalidated, labels flipped, reversals ΓÇö is the thing worth looking at, because it is the\n * log's own account of how the project's beliefs moved.\n * ---------------------------------------------------------------------------\n */\n\nimport { type Labelled, type NodeId, label as labelGraph } from \"@/reasoning/labeller\";\nimport { isKnownAt, isValidAt } from \"@/substrate/bi-temporal\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { materializeAsOf } from \"@/substrate/materialize\";\nimport type { DecisionId, EngineId, ISODateString, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\n\nexport type TimeAxis = \"valid\" | \"learned\";\n\nexport const AXIS_LABEL: Readonly<\n  Record<TimeAxis, { short: string; question: string; long: string }>\n> = {\n  valid: {\n    short: \"when it happened\",\n    question: \"What was TRUE at this point?\",\n    long:\n      \"Valid time. Filters the current graph to the nodes whose validity window covers T, so a \" +\n      \"decision made before T and not yet withdrawn is shown, whether or not the system had heard \" +\n      \"of it. This is the axis the timeline, the lattice and the exports all use.\",\n  },\n  learned: {\n    short: \"when we learned\",\n    question: \"What did the system KNOW at this point?\",\n    long:\n      \"Learned time. Replays only the events recorded at or before T, so a transcript pasted today \" +\n      \"about a decision made three weeks ago is invisible until today. This is the axis the audit \" +\n      \"trail uses, because an audit is about the system's reasoning history.\",\n  },\n};\n\n/** The graph as it stood at T on one axis. */\nexport function graphAt(\n  events: readonly AnyEvent[],\n  current: GraphState,\n  at: ISODateString,\n  axis: TimeAxis,\n  engine: EngineId,\n): GraphState {\n  if (axis === \"learned\") {\n    /* A prefix replay. `materializeAsOf` filters on `event.at`, which is learned time ΓÇö exactly the\n     * axis being asked for. */\n    return materializeAsOf(events, at, { engine, now: at });\n  }\n\n  /* Valid time cannot be produced by a prefix fold: the events are in learned order, so cutting by\n   * index would drop a decision made in January but recorded in October. Instead the CURRENT graph\n   * is filtered by validity window, which is the definition of \"true at T\". */\n  return current;\n}\n\n/** The nodes visible at T on the valid-time axis. */\nexport interface VisibleAt {\n  readonly decisions: readonly DecisionId[];\n  readonly premises: readonly PremiseId[];\n  readonly hiddenDecisions: readonly DecisionId[];\n  readonly hiddenPremises: readonly PremiseId[];\n}\n\nexport function visibleAt(state: GraphState, at: ISODateString, axis: TimeAxis): VisibleAt {\n  const decisions: DecisionId[] = [];\n  const premises: PremiseId[] = [];\n  const hiddenDecisions: DecisionId[] = [];\n  const hiddenPremises: PremiseId[] = [];\n\n  for (const decision of state.decisions.values()) {\n    const visible =\n      axis === \"valid\" ? isValidAt(decision.temporal, at) : isKnownAt(decision.temporal, at);\n    if (visible) decisions.push(decision.id);\n    else hiddenDecisions.push(decision.id);\n  }\n\n  for (const premise of state.premises.values()) {\n    const visible =\n      axis === \"valid\" ? isValidAt(premise.temporal, at) : isKnownAt(premise.temporal, at);\n    if (visible) premises.push(premise.id);\n    else hiddenPremises.push(premise.id);\n  }\n\n  return { decisions, premises, hiddenDecisions, hiddenPremises };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The diff strip                                                             */\n/* -------------------------------------------------------------------------- */\n\nexport type DiffKind =\n  | \"decision-added\"\n  | \"premise-invalidated\"\n  | \"label-flipped\"\n  | \"reversal\"\n  | \"guard-failed\";\n\nexport interface DiffEntry {\n  readonly kind: DiffKind;\n  readonly node: string;\n  readonly detail: string;\n}\n\nexport interface TimelineDiff {\n  readonly entries: readonly DiffEntry[];\n  readonly axis: TimeAxis;\n  readonly from: ISODateString;\n  readonly to: ISODateString;\n}\n\n/**\n * What changed between two graphs.\n *\n * `from` is the replayed graph and `to` the current one. Label flips are computed from both\n * labellings, because a label is derived from the graph and comparing the stored fields would miss\n * every flip caused by a change elsewhere.\n */\nexport function diffGraphs(\n  from: GraphState,\n  to: GraphState,\n  axis: TimeAxis,\n  fromAt: ISODateString,\n  toAt: ISODateString,\n): TimelineDiff {\n  const entries: DiffEntry[] = [];\n  const labelsBefore = labelGraph(from).labels;\n  const labelsAfter = labelGraph(to).labels;\n\n  for (const decision of to.decisions.values()) {\n    if (!from.decisions.has(decision.id)) {\n      entries.push({\n        kind: \"decision-added\",\n        node: decision.id,\n        detail: `\"${decision.statement}\" (${decision.variable} = ${decision.value})`,\n      });\n    }\n  }\n\n  for (const premise of to.premises.values()) {\n    const before = from.premises.get(premise.id);\n    if (before !== undefined && before.label !== \"OUT\" && premise.label === \"OUT\") {\n      entries.push({\n        kind: \"premise-invalidated\",\n        node: premise.id,\n        detail: `\"${premise.text}\" went OUT${premise.temporal.reason === undefined ? \"\" : ` ΓÇö ${premise.temporal.reason}`}`,\n      });\n    }\n  }\n\n  for (const [nodeId, labelled] of labelsAfter) {\n    const previous = labelsBefore.get(nodeId);\n    const fromLabel: DecisionLabel = previous?.label ?? \"UNKNOWN\";\n    if (fromLabel === labelled.label) continue;\n\n    entries.push({\n      kind: \"label-flipped\",\n      node: nodeId,\n      detail: `${fromLabel} ΓåÆ ${labelled.label}`,\n    });\n  }\n\n  for (const decision of to.decisions.values()) {\n    const before = from.decisions.get(decision.id);\n    if (before === undefined) continue;\n    if (before.status !== \"superseded\" && decision.status === \"superseded\") {\n      entries.push({\n        kind: \"reversal\",\n        node: decision.id,\n        detail: `\"${decision.statement}\" was superseded by ${decision.edges.supersededBy[0] ?? \"a later decision\"}`,\n      });\n    }\n  }\n\n  for (const guard of to.guards.values()) {\n    const before = from.guards.get(guard.id);\n    if (before?.lastRun?.outcome === \"fail\") continue;\n    if (guard.lastRun?.outcome === \"fail\") {\n      entries.push({ kind: \"guard-failed\", node: guard.id, detail: guard.lastRun.evidence });\n    }\n  }\n\n  return { entries, axis, from: fromAt, to: toAt };\n}\n\nexport const DIFF_KIND_LABEL: Readonly<Record<DiffKind, string>> = {\n  \"decision-added\": \"decisions added\",\n  \"premise-invalidated\": \"premises invalidated\",\n  \"label-flipped\": \"labels flipped\",\n  reversal: \"reversals\",\n  \"guard-failed\": \"guards started failing\",\n};\n\nexport function describeDiff(diff: TimelineDiff): string {\n  const axis = AXIS_LABEL[diff.axis];\n\n  if (diff.entries.length === 0) {\n    return `Nothing changed between ${diff.from.slice(0, 10)} and ${diff.to.slice(0, 10)} on the ${axis.short} axis.`;\n  }\n\n  const counts = new Map<DiffKind, number>();\n  for (const entry of diff.entries) counts.set(entry.kind, (counts.get(entry.kind) ?? 0) + 1);\n\n  const lines = [\n    `Between ${diff.from.slice(0, 10)} and ${diff.to.slice(0, 10)}, measured along ${axis.short} (${axis.question}):`,\n    \"\",\n  ];\n\n  for (const [kind, count] of counts) {\n    lines.push(`  ${String(count).padStart(3)}  ${DIFF_KIND_LABEL[kind]}`);\n  }\n\n  lines.push(\"\");\n  for (const entry of diff.entries.slice(0, 24)) {\n    lines.push(`  ${entry.node.padEnd(10)} ${entry.detail}`);\n  }\n  if (diff.entries.length > 24) lines.push(`  ΓÇª ${diff.entries.length - 24} more`);\n\n  return lines.join(\"\\n\");\n}\n\n/** The slider's bounds, from the log itself. */\nexport function timeRange(\n  events: readonly AnyEvent[],\n  state: GraphState,\n): {\n  earliest: ISODateString;\n  latest: ISODateString;\n} {\n  let earliest: ISODateString | null = null;\n  let latest: ISODateString | null = null;\n\n  const consider = (value: ISODateString): void => {\n    if (value.length === 0) return;\n    if (earliest === null || value < earliest) earliest = value;\n    if (latest === null || value > latest) latest = value;\n  };\n\n  for (const event of events) {\n    consider(event.at);\n    if (event.occurredAt !== undefined) consider(event.occurredAt);\n  }\n\n  for (const decision of state.decisions.values()) {\n    consider(decision.temporal.valid);\n    consider(decision.temporal.learned);\n  }\n\n  return {\n    earliest: earliest ?? (\"\" as ISODateString),\n    latest: latest ?? (\"\" as ISODateString),\n  };\n}\n\nexport type { Labelled, NodeId };\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *  line(describePlan(plan));\n  blank();\n  line(\n    \"This runs the full corpus once per configuration, sequentially. Configurations are NOT run\",\n  );\n  line(\"concurrently: the harness mints ids from a counter and stamps learned time from a clock that\");\n  line(\"advances per call, and interleaving them would make deltas unattributable to the toggles.\");\n\n  blank();\n  line(\"A delta is only meaningful against the baseline row. If the baseline threw, nothing below it means anything.\");\n}\n    \"# Ablation study\",\n    \"\",\n    \"Corpus \" +\n      study.corpusVersion +\" ┬╖ engine \" +study.engine.kind +\n      (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") +\" ┬╖ ran \" +study.ranAt,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? (error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,114]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[114,160]}}},{"diffOp":{"insert":{"range":[160,165]}}},{"diffOp":{"equal":{"range":[165,257]}}},{"diffOp":{"insert":{"range":[257,261]}}},{"diffOp":{"equal":{"range":[261,271]}}},{"diffOp":{"insert":{"range":[160,165]}}},{"diffOp":{"equal":{"range":[271,365]}}},{"diffOp":{"insert":{"range":[257,261]}}},{"diffOp":{"equal":{"range":[365,469]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[469,488]}}},{"diffOp":{"insert":{"range":[160,165]}}},{"diffOp":{"equal":{"range":[488,598]}}},{"diffOp":{"insert":{"range":[257,261]}}},{"diffOp":{"equal":{"range":[598,603]}}},{"equalLines":{"line_count":2}},{"diffOp":{"equal":{"range":[603,650]}}},{"diffOp":{"delete":{"range":[114,115]}}},{"diffOp":{"insert":{"range":[650,657]}}},{"diffOp":{"equal":{"range":[657,678]}}},{"diffOp":{"delete":{"range":[603,604]}}},{"diffOp":{"insert":{"range":[650,657]}}},{"diffOp":{"equal":{"range":[678,693]}}},{"diffOp":{"delete":{"range":[603,604]}}},{"diffOp":{"insert":{"range":[650,657]}}},{"diffOp":{"equal":{"range":[693,784]}}},{"diffOp":{"delete":{"range":[114,115]}}},{"diffOp":{"insert":{"range":[650,657]}}},{"diffOp":{"equal":{"range":[784,796]}}},{"diffOp":{"delete":{"range":[114,115]}}},{"diffOp":{"insert":{"range":[650,657]}}},{"diffOp":{"equal":{"range":[796,925]}}},{"equalLines":{"line_count":19}},{"diffOp":{"equal":{"range":[925,984]}}},{"diffOp":{"insert":{"range":[650,655]}}},{"diffOp":{"equal":{"range":[984,1017]}}},{"diffOp":{"insert":{"range":[1017,1018]}}},{"diffOp":{"equal":{"range":[1018,1046]}}},{"diffOp":{"insert":{"range":[365,366]}}},{"diffOp":{"equal":{"range":[1046,1070]}}},{"diffOp":{"insert":{"range":[257,261]}}},{"diffOp":{"equal":{"range":[1070,1101]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\cli.ts"},"span":null,"sourceCode":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * A separate entry point from `ablation/run.ts` on purpose. `run.ts` is imported by `table.ts`, and a\n * module that starts a fifteen-configuration study on import would run the study every time anything\n * read the table renderer. Side effects belong at the edge.\n */\n\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"../cli\";\nimport { renderSuite, type ScoredRun } from \"../metrics\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./run\";\nimport { renderAblationTable, renderPredictionAudit } from \"./table\";\nimport { describePlan, fullPlan } from \"./toggles\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, engineId } = prepare();\n\n  const plan = fullPlan();\n\n  banner(\"Ablation study ΓÇö \" + plan.length + \" configurations\");\n  line(describePlan(plan));\n  blank();\n  line(\"This runs the full corpus once per configuration, sequentially. Configurations are NOT run\");\n  line(\"concurrently: the harness mints ids from a counter and stamps learned time from a clock that\");\n  line(\"advances per call, and interleaving them would make deltas unattributable to the toggles.\");\n\n  const study = await runAblation(resolved, { engineId });\n\n  heading(\"Study\");\n  line(describeStudy(study));\n\n  heading(\"Delta table\");\n  line(renderAblationTable(study));\n\n  heading(\"Prediction audit\");\n  line(renderPredictionAudit(study));\n\n  if (args.has(\"out\")) {\n    const baseline = study.baseline;\n    write(\n      args.get(\"out\") ?? \"ablation-report.md\",\n      renderAblationMarkdown(study, baseline === null ? null : baseline.scored),\n    );\n  }\n\n  blank();\n  line(\"A delta is only meaningful against the baseline row. If the baseline threw, nothing below it means anything.\");\n}\n\nfunction renderAblationMarkdown(study: AblationStudy, baseline: ScoredRun | null): string {\n  const parts = [\n    \"# Ablation study\",\n    \"\",\n    \"Corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n      (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",\n    \"delta always means the full system is better. Thresholds were declared in `toggles.ts` before any\",\n    \"configuration was run.\",\n    \"\",\n    \"```\",\n    describeStudy(study),\n    \"\",\n    renderAblationTable(study),\n    \"\",\n    renderPredictionAudit(study),\n    \"```\",\n    \"\",\n  ];\n\n  if (baseline !== null) {\n    parts.push(\"## Baseline metrics\", \"\", \"```\", renderSuite(baseline), \"```\", \"\");\n  }\n\n  return parts.join(\"\\n\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation study runner ΓÇö 7.3.\n *        scored: null,\n        run: null,\n        error: error instanceof Error ? `${error.message + \"}\\n\" + (${error.stack ?? \"\")}`: String(error),\n        durationMs: Date.now() - rowStart,\n      });  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,44]}}},{"equalLines":{"line_count":87}},{"diffOp":{"equal":{"range":[44,125]}}},{"diffOp":{"insert":{"range":[125,128]}}},{"diffOp":{"equal":{"range":[128,141]}}},{"diffOp":{"delete":{"range":[141,145]}}},{"diffOp":{"insert":{"range":[145,146]}}},{"diffOp":{"equal":{"range":[146,148]}}},{"diffOp":{"delete":{"range":[148,153]}}},{"diffOp":{"insert":{"range":[153,155]}}},{"diffOp":{"equal":{"range":[155,172]}}},{"diffOp":{"delete":{"range":[172,173]}}},{"diffOp":{"insert":{"range":[173,175]}}},{"diffOp":{"equal":{"range":[141,142]}}},{"diffOp":{"equal":{"range":[175,244]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[244,273]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\run.ts"},"span":[3752,3794],"sourceCode":"/**\n * The ablation study runner ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * ONE CORPUS, ONE ENGINE, FIFTEEN CONFIGURATIONS\n *\n * Every configuration runs the identical corpus through the identical harness. Only the toggles differ.\n * That is the whole method: a delta between two rows is attributable to the switch that differs between\n * them and to nothing else, because nothing else differs.\n *\n * The engine is fixed for the whole study rather than varied per row. Varying both at once would\n * produce a table where a delta could come from either, and ┬º7.2's requirement that per-engine numbers\n * stay separate is satisfied by running the study ONCE PER ENGINE and keeping the two tables apart ΓÇö\n * never by putting two engines in one table.\n *\n * ---------------------------------------------------------------------------\n * FAILURES ARE ROWS, NOT EXCEPTIONS\n *\n * A configuration that throws is recorded with its error and excluded from the delta table, which then\n * prints the exclusion. Aborting the study would leave eleven rows and no indication that a twelfth\n * existed, and a reader would compute deltas against a baseline that may not be the one that ran.\n * ---------------------------------------------------------------------------\n */\n\nimport { createLocalEngine, localEngineId } from \"@/ai/local\";\nimport type { EngineId } from \"@/types/common\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { nowISO } from \"@/lib/format\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport { runConfig, type RunResult } from \"../harness\";\nimport { scoreAll, type ScoredRun } from \"../metrics\";\nimport { fullPlan, type Ablation } from \"./toggles\";\n\nexport interface AblationOutcome {\n  readonly ablation: Ablation;\n  readonly scored: ScoredRun | null;\n  readonly run: RunResult | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface AblationStudy {\n  readonly engine: EngineId;\n  readonly corpusVersion: string;\n  readonly ranAt: string;\n  readonly outcomes: readonly AblationOutcome[];\n  readonly baseline: AblationOutcome | null;\n  /** Configurations that threw. Printed in the table rather than silently absent. */\n  readonly failed: readonly { id: string; error: string }[];\n  readonly totalDurationMs: number;\n}\n\nexport interface StudyOptions {\n  readonly engine?: WhyLogEngine;\n  readonly engineId?: EngineId;\n  readonly plan?: readonly Ablation[];\n}\n\n/**\n * Run the whole study.\n *\n * Sequential, not concurrent. The harness mints ids from a counter and stamps learned time from a clock\n * that advances on every call; running configurations concurrently would interleave those and the deltas\n * would stop being attributable to the toggles. Slower and correct beats faster and uninterpretable.\n */\nexport async function runAblation(corpus: ResolvedCorpus, options: StudyOptions = {}): Promise<AblationStudy> {\n  const engine = options.engine ?? createLocalEngine();\n  const engineId = options.engineId ?? localEngineId();\n  const plan = options.plan ?? fullPlan();\n  const ranAt = nowISO();\n\n  const outcomes: AblationOutcome[] = [];\n  const started = Date.now();\n\n  for (const ablation of plan) {\n    const rowStart = Date.now();\n    try {\n      const run = await runConfig(corpus, {\n        id: ablation.id,\n        engine,\n        engineId,\n        toggles: ablation.toggles,\n        params: ablation.params,\n      });\n      outcomes.push({ ablation, scored: scoreAll(corpus, run, engineId), run, error: null, durationMs: Date.now() - rowStart });\n    } catch (error) {\n      outcomes.push({\n        ablation,\n        scored: null,\n        run: null,\n        error: error instanceof Error ? error.message + \"\\n\" + (error.stack ?? \"\") : String(error),\n        durationMs: Date.now() - rowStart,\n      });\n    }\n  }\n\n  const failed = outcomes\n    .filter((outcome) => outcome.error !== null)\n    .map((outcome) => ({ id: outcome.ablation.id, error: outcome.error ?? \"unknown\" }));\n\n  return {\n    engine: engineId,\n    corpusVersion: corpus.version,\n    ranAt,\n    outcomes,\n    baseline: outcomes.find((outcome) => outcome.ablation.id === \"full\") ?? null,\n    failed,\n    totalDurationMs: Date.now() - started,\n  };\n}\n\n/** The study as a short human-readable summary. Printed before the table so a run that produced no\n *  usable rows says so in the first line rather than in an empty grid. */\nexport function describeStudy(study: AblationStudy): string {\n  const usable = study.outcomes.filter((outcome) => outcome.scored !== null).length;\n  const lines = [\n    \"Ablation study: \" + study.outcomes.length + \" configuration(s), \" + usable + \" produced scores.\",\n    \"Engine: \" + study.engine.kind + (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") +\n      \"  ┬╖  corpus \" + study.corpusVersion + \"  ┬╖  ran \" + study.ranAt,\n    \"Total wall time: \" + (study.totalDurationMs / 1000).toFixed(1) + \"s\",\n  ];\n\n  if (study.baseline === null || study.baseline.scored === null) {\n    lines.push(\"\");\n    lines.push(\"THE BASELINE DID NOT PRODUCE SCORES. No delta in this study is meaningful, because every\");\n    lines.push(\"delta is measured against it. Fix the baseline before reading any row below.\");\n  }\n\n  if (study.failed.length > 0) {\n    lines.push(\"\");\n    lines.push(study.failed.length + \" configuration(s) threw and are EXCLUDED from the delta table:\");\n    for (const entry of study.failed) lines.push(\"  \" + entry.id + \" ┬╖ \" + entry.error.split(\"\\n\")[0]);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"c