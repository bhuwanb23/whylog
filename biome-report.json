l":{"range":[2251,2349]}}},{"diffOp":{"delete":{"range":[1926,1927]}}},{"diffOp":{"insert":{"range":[445,458]}}},{"diffOp":{"equal":{"range":[2349,2755]}}},{"diffOp":{"delete":{"range":[1926,1927]}}},{"diffOp":{"insert":{"range":[445,454]}}},{"diffOp":{"equal":{"range":[2755,3005]}}},{"equalLines":{"line_count":9}},{"diffOp":{"equal":{"range":[3005,3104]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\cascade.ts"},"span":null,"sourceCode":"/**\n * Metric 6 ΓÇö cascade correctness at L3 (propagation), and metric 7, survivor preservation.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: NONE PUBLISHED for either. No surveyed system cascades a retraction at all.\n *\n * ---------------------------------------------------------------------------\n * ONE METRIC, TWO HALVES, AND THE SECOND HALF IS THE ONE THAT MATTERS\n *\n * Cascade correctness is not \"did the right nodes flip\". It is \"did the right nodes flip AND the wrong\n * ones stay put\". A cascade that retracts everything reachable is perfectly correct on the first half\n * and catastrophic in use: the user falsifies one assumption about team size and eleven unrelated\n * decisions vanish from the graph. They will never trust it again, and they will be right not to.\n *\n * So the score is a strict conjunction per plant ΓÇö flips AND survivors ΓÇö and survivor preservation is\n * additionally reported on its own, because it is the number that predicts whether the product\n * survives contact with a real project. ┬º7.2 calls it one of the two unusual metrics; ┬º7.4 names\n * cascade over-retraction as the first of four demo-killers. Both point here.\n *\n * ---------------------------------------------------------------------------\n * THE PLANTED CASE IS BUILT TO DISTINGUISH THE TWO\n *\n * `l03` puts three decisions on deliberately different support:\n *   d1 pooling           rests on single-user ALONE\n *   d2 migration tooling rests on scope ALONE\n *   d3 read replicas     rests on single-user AND no-deploy-infra\n *\n * Falsifying single-user must flip d1, spare d2 entirely, and leave d3 to its remaining support. Three\n * different correct behaviours from one intervention, and each one distinguishes a different wrong\n * implementation: a cascade that flips d2 is following edges rather than justifications; one that flips\n * d3 is treating support as all-or-nothing.\n *\n * ---------------------------------------------------------------------------\n * AN UNRESOLVABLE SURVIVOR IS A FAILURE, NOT A SKIP\n *\n * If the decision that was supposed to survive was never extracted, the survivor cannot be verified and\n * the plant is scored as failed. Skipping it would report a cascade correctness computed only over the\n * plants that happened to extract cleanly ΓÇö a number that improves as extraction gets worse, which is\n * the exact inverse of what a benchmark should do.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { plantIsTestable, type Resolver } from \"./resolve\";\nimport { METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface PlantOutcome {\n  readonly plant: string;\n  readonly testable: boolean;\n  readonly interventionApplied: boolean;\n  readonly expectedFlips: readonly string[];\n  readonly flipped: readonly string[];\n  readonly missedFlips: readonly string[];\n  readonly expectedSurvivors: readonly string[];\n  readonly survived: readonly string[];\n  /** Survivors that were retracted. Each one is an over-retraction ΓÇö the demo-killer. */\n  readonly overRetracted: readonly string[];\n  readonly unresolvable: readonly string[];\n  readonly correct: boolean;\n}\n\nexport interface CascadeOutcome {\n  readonly correctness: MetricResult;\n  readonly survivorship: MetricResult;\n  readonly perPlant: readonly PlantOutcome[];\n  readonly overRetractions: number;\n  readonly survivorsExpected: number;\n}\n\nconst UNSOUND = new Set([\"OUT\", \"UNFOUNDED\"]);\n\nexport function scoreCascade(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): CascadeOutcome {\n  const plants = corpus.plants.filter((plant) => plant.kind === \"L3-cascade\" || plant.kind === \"L2-premise\");\n\n  const perPlant: PlantOutcome[] = plants.map((plant) => {\n    const testable = plantIsTestable(run, plant.transcripts);\n\n    /* An L3 plant is only testable if its intervention actually landed. An L2 plant has no\n     * intervention ΓÇö the falsification must come out of the transcript ΓÇö so it is testable whenever its\n     * transcripts imported. */\n    const interventionApplied =\n      plant.falsify === undefined ||\n      plant.falsify.every((step) =>\n        run.interventions.some((outcome) => outcome.plant === plant.id && outcome.predicate === step.predicate && outcome.applied),\n      );\n\n    const flipped: string[] = [];\n    const missedFlips: string[] = [];\n    const survived: string[] = [];\n    const overRetracted: string[] = [];\n    const unresolvable: string[] = [];\n\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        unresolvable.push(key);\n        continue;\n      }\n      if (isUnsound(run, id)) flipped.push(key);\n      else missedFlips.push(key);\n    }\n\n    for (const key of plant.expectSurvivors) {\n      const id = resolver.decision(key);\n      if (id === null) {\n        /* A survivor that was never extracted cannot be shown to have survived. Counted as unresolved\n         * and the plant fails, per the header: skipping it would reward poor extraction. */\n        unresolvable.push(key);\n        continue;\n      }\n      if (isUnsound(run, id)) overRetracted.push(key);\n      else survived.push(key);\n    }\n\n    const correct =\n      testable &&\n      interventionApplied &&\n      missedFlips.length === 0 &&\n      overRetracted.length === 0 &&\n      unresolvable.length === 0 &&\n      plant.expectUnsound.length + plant.expectSurvivors.length > 0;\n\n    return {\n      plant: plant.id,\n      testable,\n      interventionApplied,\n      expectedFlips: plant.expectUnsound,\n      flipped,\n      missedFlips,\n      expectedSurvivors: plant.expectSurvivors,\n      survived,\n      overRetracted,\n      unresolvable,\n      correct,\n    };\n  });\n\n  const survivorsExpected = perPlant.reduce((sum, entry) => sum + entry.expectedSurvivors.length, 0);\n  const survivorsKept = perPlant.reduce((sum, entry) => sum + entry.survived.length, 0);\n  const overRetractions = perPlant.reduce((sum, entry) => sum + entry.overRetracted.length, 0);\n\n  const correctPlants = perPlant.filter((entry) => entry.correct).length;\n  const correctnessValue = perPlant.length === 0 ? 0 : correctPlants / perPlant.length;\n\n  /* Survivor preservation is 1.0 when no survivors are expected, which is vacuous rather than perfect.\n   * The report must not print it as an achievement, so the gloss says so explicitly. */\n  const survivorValue = survivorsExpected === 0 ? 1 : survivorsKept / survivorsExpected;\n\n  return {\n    perPlant,\n    overRetractions,\n    survivorsExpected,\n    correctness: {\n      id: \"cascade-correctness-l3\",\n      name: METRIC_NAMES[\"cascade-correctness-l3\"],\n      value: correctnessValue,\n      detail: null,\n      n: perPlant.length,\n      perEngine: [{ engine: describeEngineId(engine), value: correctnessValue, n: perPlant.length, detail: null }],\n      comparator: null,\n      gloss:\n        correctPlants + \" of \" + perPlant.length + \" plant(s) were FULLY correct ΓÇö every expected flip happened and no \" +\n        \"survivor was retracted. \" + overRetractions + \" over-retraction(s) across \" + survivorsExpected + \" expected survivor(s).\",\n      honestNote:\n        \"Scored as a strict conjunction per plant: a cascade that flips the right nodes AND retracts a survivor scores 0, \" +\n        \"not partial credit, because over-retraction is the failure that destroys trust and partial credit would hide it. \" +\n        \"n=\" + perPlant.length + \" plants ΓÇö small enough that this metric is a PASS/FAIL over named cases rather than a \" +\n        \"statistical rate, and it should be quoted as such. A plant whose intervention could not be applied, or whose \" +\n        \"survivor was never extracted, is scored as FAILED rather than skipped: skipping would make the number improve as \" +\n        \"extraction worsens. No published comparator exists, because no surveyed system propagates a retraction at all.\",\n    },\n    survivorship: {\n      id: \"survivor-preservation\",\n      name: METRIC_NAMES[\"survivor-preservation\"],\n      value: survivorValue,\n      detail: null,\n      n: survivorsExpected,\n      perEngine: [{ engine: describeEngineId(engine), value: survivorValue, n: survivorsExpected, detail: null }],\n      comparator: null,\n      gloss:\n        survivorsExpected === 0\n          ? \"VACUOUS: the corpus expected no survivors in the plants that ran, so 1.0 here means nothing was tested.\"\n          : survivorsKept + \" of \" + survivorsExpected + \" decision(s) that shared no falsified premise kept their label. \" +\n            overRetractions + \" were retracted anyway.\",\n      honestNote:\n        \"One of the two metrics ┬º7.2 calls unusual, and the one that predicts whether the product survives a real project. \" +\n        \"1.0 is VACUOUS when n=0 and the gloss says so rather than printing a perfect score for an untested property ΓÇö a \" +\n        \"benchmark that reports 100% because it measured nothing is worse than one that reports 40%. n=\" + survivorsExpected +\n        \" survivors, all from the single l03 plant, so this is a check that a specific mechanism does not over-fire, not an \" +\n        \"estimate of an over-retraction RATE. Nobody publishes a comparator because nobody cascades.\",\n    },\n  };\n}\n\nfunction isUnsound(run: RunResult, id: DecisionId): boolean {\n  const labelled = run.labels.get(id);\n  if (labelled !== undefined) return UNSOUND.has(labelled.label);\n\n  const decision = run.state.decisions.get(id);\n  return decision !== undefined && (decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n}\n"},"tags":[],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The metric suite ΓÇö 7.2. Scores one run against the corpus.\n *import type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { scoreAlternativeExtraction, type AlternativeOutcome, scoreAlternativeExtraction } from \"./alternative\";\nimport { scoreCascade, type CascadeOutcome, scoreCascade } from \"./cascade\";\nimport { scoreContradictionRecall, type ContradictionOutcomescoreContradictionRecall } from \"./contradiction\";\nimport { scoreDecisionExtraction, type ExtractionOutcome, scoreDecisionExtraction } from \"./extraction\";\nimport { scoreFalsePositives, type FalsePositiveOutcome, scoreFalsePositives } from \"./false-positive\";\nimport { scoreGroundedness, type GroundednessOutcome, scoreGroundedness } from \"./groundedness\";\nimport { scoreGuards, type GuardOutcomescoreGuards } from \"./guards\";\nimport { scoreInvalidationRecall, type InvalidationOutcome, scoreInvalidationRecall } from \"./invalidation\";\nimport { scoreModalityPrecision, type ModalityOutcome, scoreModalityPrecision } from \"./modality\";\nimport { scorePremiseExtraction, type PremiseOutcome, scorePremiseExtraction } from \"./premise\";\nimport { scoreRetrieval, RetrievalOutcomeResolver, buildResolverretrievalresolve\";\ni