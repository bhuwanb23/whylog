e\n     * contradiction edge. Both paths have to say amber. */\n    expect(TIMELINE_STATUS_COLOUR.UNSOUND).toContain(\"--label-unknown\");\n    expect(TIMELINE_STATUS_COLOUR.CONTESTED).toContain(\"--label-unknown\");\n    expect(STATUS_COLOUR.contested).toBe(\"var(--status-contested)\");\n    const contestedValue = css.match(/--status-contested:\\s*(#[0-9a-fA-F]{6})/);\n    expect(redValues.has(contestedValue![1]!.toLowerCase())).toBe(false);\n\n    /* UNVERIFIED is grey, and drawn hollow: absence of evidence as absence of fill. */\n    expect(TIMELINE_STATUS_COLOUR.UNVERIFIED).toContain(\"--text-faint\");\n\n    /* Red appears for exactly two things: the contradiction edge and the action colour.\n     * NOT for a status or a label - a contested decision is waiting for a human, and red\n     * would say \"error\". The `color-` prefixed names are the Tailwind mirrors of the same\n     * tokens. */\n    const redTokens = new Set(\n      [...css.matchAll(/--([a-z-]+):\\s*(#[0-9a-fA-F]{6})/g)]\n        .filter((m) => redValues.has(m[2]!.toLowerCase()))\n        .map((m) => m[1]!),\n    );\n    for (const token of redTokens) {\n      expect(token).toMatch(/^(color-)?(action|edge-conflict)$/);\n    }\n    expect(redTokens.has(\"edge-conflict\")).toBe(true);\n    expect(redTokens.has(\"action\")).toBe(true);\n\n    /* And no STATUS token is red, in either theme. */\n    for (const match of css.matchAll(/--((?:status|label)-[a-z-]+):\\s*(#[0-9a-fA-F]{6})/g)) {\n      expect(redValues.has(match[2]!.toLowerCase())).toBe(false);\n    }\n\n    /* And the light theme has to define every token the dark theme defines. A token that\n     * exists in one theme and not the other is a bug that only shows up on half the\n     * machines - and the engine badge and the status badge both resolve through them.\n     * The Tailwind `@theme` block is not a theme variant, so only the two `:root` blocks\n     * are compared. */\n    const rootBlocks = [...css.matchAll(/:root\\s*\\{([^}]*)\\}/g)].map((m) => m[1]!);\n    expect(rootBlocks.length).toBe(2);\n    const darkTokens = [...rootBlocks[0]!.matchAll(/^\\s*(--[a-z-]+):/gm)].map((m) => m[1]!);\n    const lightTokens = [...rootBlocks[1]!.matchAll(/^\\s*(--[a-z-]+):/gm)].map((m) => m[1]!);\n    for (const token of darkTokens) {\n      expect(lightTokens).toContain(token);\n    }\n  });\n\n  it(\"every view has an empty state, not a blank page\", async () => {\n    /* The plan: \"Empty state. Not a blank page: a paste target and one sentence explaining\n     * what happens next. First-run is the most common drop-off point in every tool in this\n     * category.\" */\n    localStorage.clear();\n    const { useWhyLog } = await import(\"@/store/whylog\");\n    useWhyLog.getState().boot();\n    useWhyLog.getState().reset();\n\n    render(<HealthView />);\n    const text = document.body.textContent ?? \"\";\n    expect(text.length).toBeGreaterThan(0);\n    expect(text).toMatch(/no log|nothing|import|empty/i);\n  });\n\n  it(\"the engine badge is on the operations that need it\", async () => {\n    const { EngineBadge } = await import(\"@/components/common/EngineBadge\");\n    const { useWhyLog } = await import(\"@/store/whylog\");\n    const state = useWhyLog.getState().state;\n    const decision = [...state.decisions.values()][0];\n    if (!decision) throw new Error(\"no decision\");\n\n    const { container } = render(\n      <DecisionCard\n        state={state}\n        labels={label(state).labels}\n        decisionId={decision.id}\n        entrenchment={entrenchmentOf(state, decision.id, Date.now())}\n      />,\n    );\n    /* The badge names the ENGINE that produced the decision. For the local engine that is\n     * \"LOCAL\", and the badge's title says why that matters: deterministic, offline, no\n     * key, nothing left the browser. The badge lives in the provenance section, which is\n     * collapsed by default, so the section has to be opened. */\n    const toggle = screen.getByText(\"provenance\", { selector: \"span\" });\n    const button = toggle.closest(\"button\");\n    if (button) fireEvent.click(button);\n\n    expect(container.textContent).toContain(\"LOCAL\");\n    expect(container.querySelector('[title*=\"local engine\"]')).not.toBeNull();\n    expect(EngineBadge).toBeDefined();\n  });\n\n  it(\"the settings panel has the controls the plan lists\", () => {\n    render(<SettingsView />);\n\n    /* A settings panel that renders no control is worse than no panel: it teaches the user\n     * that the panel is decorative. */\n    const controls = document.querySelectorAll(\"input, button, select\");\n    expect(controls.length).toBeGreaterThan(0);\n\n    const text = (document.body.textContent ?? \"\").toLowerCase();\n    expect(text).toMatch(/cascade|depth/);\n  });\n\n  it(\"the index staleness is handled, not ignored\", async () => {\n    /* \"index staleness handled\" is on the checklist, and the store reports it. */\n    const { useAsk } = await import(\"@/store/ask\");\n    expect(useAsk.getState().status).toBeDefined();\n    expect(useAsk.getState().artifacts === null || useAsk.getState().artifacts !== null).toBe(true);\n  });\n});\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 29 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 29 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 29 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\reasoning\\assert.ts"},"span":[9309,9329],"sourceCode":"/**\n * The assertion entry point ΓÇö 2.1.\n *\n * Phase 2 ┬╖ sub-phase 2.1\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.1\n *\n * ---------------------------------------------------------------------------\n * ONE FUNCTION, FOUR INPUT KINDS, IDENTICAL DOWNSTREAM BEHAVIOUR\n *\n * Every source of new information enters here:\n *\n *   ┬╖ transcript     ΓÇö a reviewed extraction batch\n *   ┬╖ user-decision  ΓÇö something a human typed in\n *   ┬╖ guard-result   ΓÇö a check that ran against the repo (Phase 4)\n *   ┬╖ repo-scan      ΓÇö an observation about the codebase (Phase 4)\n *\n * The acceptance criterion is not that all four work. It is that **the reasoning code\n * never branches on which one arrived**. `labeller`, `gates`, `backtracking`,\n * `cascade`, `entrenchment`, `adjudication` and `proposals` see a `GraphState` and\n * nothing else. There is no `if (source === \"guard\")` anywhere downstream, and there\n * cannot be, because this module is the only place the source is known.\n *\n * That is what makes a guard failure and a transcript remark EQUIVALENT in the eyes of\n * the reasoner ΓÇö and it is the reason `implementation_cost` can feed entrenchment\n * without a special case. A system that handled guards separately would have two\n * reasoning paths, and only one of them would be tested.\n *\n * ---------------------------------------------------------------------------\n * WHAT IT PRODUCES\n *\n * Event drafts, plus an optional `Newcomer` for the adjudicator. It appends nothing:\n * the store owns `append ΓåÆ fold ΓåÆ persist`, and the cycle has to run on the state\n * AFTER these events are folded, not before. So the orchestration is two batches:\n *\n *   1. assert  ΓåÆ append these drafts ΓåÆ fold ΓåÆ new state\n *   2. revise  ΓåÆ run the cycle over the new state ΓåÆ append its drafts ΓåÆ fold\n *\n * Running the labeller on the pre-assertion state would label the graph as it was\n * before the new information arrived, which is the one thing this module exists to\n * prevent.\n *\n * ---------------------------------------------------------------------------\n * WHAT A GUARD RESULT DOES IN PHASE 2\n *\n * It asserts a PREMISE, with evidence of kind `guard`. It does not emit `GuardFailed`,\n * because guards do not exist yet ΓÇö Phase 4 creates them, and a `GuardFailed` event\n * naming a guard id that was never synthesised would not fold. The observation is the\n * part that matters to the reasoner, and it arrives in the same shape as every other\n * observation. When Phase 4 lands, `GuardFailed` is emitted by the guard runner and\n * this path keeps doing what it does now.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  formatDecisionId,\n  formatEpisodeId,\n  formatJustificationId,\n  formatPremiseId,\n  formatTranscriptId,\n  premiseFingerprint,\n} from \"@/lib/ids\";\nimport { canonicalPredicate, canonicalValueOf, foldKey } from \"@/ontology/canonicalize\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type {\n  Actor,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  PremiseId,\n  SourceSpan,\n  TranscriptId,\n} from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { DecisionOrigin, DecisionVariable, Justification, PremiseType } from \"@/types/domain\";\nimport type { Nogood } from \"@/types/domain\";\nimport type { EventType, NewEvent } from \"@/types/events\";\nimport type { Newcomer } from \"./adjudication\";\nimport { blocksConjunction } from \"./nogoods\";\n\n/* -------------------------------------------------------------------------- */\n/* The four kinds                                                             */\n/* -------------------------------------------------------------------------- */\n\nexport type AssertionSource = \"transcript\" | \"user-decision\" | \"guard-result\" | \"repo-scan\";\n\n/** One premise being asserted or refuted. Shared by all four kinds. */\nexport interface PremiseAssertion {\n  readonly type: PremiseType;\n  /** Namespaced, e.g. \"scale.max_users\". Canonicalised here, not by the caller. */\n  readonly predicate: string;\n  readonly value?: string | number | boolean;\n  /** Natural-language form, e.g. \"the app now has two concurrent editors\". */\n  readonly text: string;\n  /** False means this observation REFUTES the premise rather than supporting it. */\n  readonly supports: boolean;\n  readonly confidence: Confidence;\n  /** Where it came from. Absent for a human typing it in, which is honest: there is\n   *  no span to point at, and inventing one would claim a source that does not exist. */\n  readonly span?: SourceSpan;\n}\n\n/** A decision being asserted. Only `user-decision` and `transcript` carry these. */\nexport interface DecisionAssertion {\n  readonly variable: DecisionVariable;\n  readonly value: string;\n  readonly statement: string;\n  readonly rationale?: string;\n  readonly origin: DecisionOrigin;\n  readonly confidence: Confidence;\n  /** Indices into `premises`, resolved to real ids here. The caller never mints ids. */\n  readonly premiseRefs?: readonly number[];\n  readonly span?: SourceSpan;\n  readonly appliesTo?: readonly string[];\n}\n\nexport type Assertion =\n  | {\n      readonly source: \"transcript\";\n      readonly transcriptId: TranscriptId;\n      readonly premises: readonly PremiseAssertion[];\n      readonly decisions: readonly DecisionAssertion[];\n      readonly occurredAt?: ISODateString;\n    }\n  | {\n      readonly source: \"user-decision\";\n      readonly decision: DecisionAssertion;\n      readonly premises: readonly PremiseAssertion[];\n    }\n  | {\n      readonly source: \"guard-result\";\n      readonly decisionId: DecisionId;\n      readonly passed: boolean;\n      /** What the guard observed. Becomes a premise with evidence of kind `guard`. */\n      readonly observation: PremiseAssertion;\n    }\n  | {\n      readonly source: \"repo-scan\";\n      readonly observations: readonly PremiseAssertion[];\n    };\n\n/* -------------------------------------------------------------------------- */\n/* Context                                                                    */\n/* -------------------------------------------------------------------------- */\n\nexport interface AssertContext {\n  readonly state: GraphState;\n  readonly actor: Actor;\n  readonly engine: EngineId;\n  readonly at: ISODateString;\n  /** Which of the four kinds this is. Carried explicitly rather than inferred from the\n   *  actor: a guard run and a repo scan both arrive as a system actor, and guessing\n   *  between them would put the wrong source in the reason string ΓÇö the one field whose\n   *  entire job is to say where the information came from. */\n  readonly source: AssertionSource;\n  /** Human-authored text needs a transcript to be verbatim FROM. Created on demand\n   *  and labelled as such; see `store/reasoning.ts` for why this is not a shortcut. */\n  readonly humanTranscriptId?: TranscriptId;\n  /** Valid time of the observation, when it is known. A transcript has one; a guard\n   *  result does not, and defaults to `at`. */\n  readonly occurredAt?: ISODateString;\n}\n\n/**\n * An assertion that could not be resolved to a premise node.\n *\n * ┬º2.11: \"Exact predicate match only; ambiguous cases are surfaced for human\n * confirmation rather than guessed.\" ┬º2.5: a false premise resolution produces \"a\n * confident, spectacular, entirely wrong cascade\" ΓÇö so an unresolved or ambiguous match\n * is REPORTED, never acted on.\n */\nexport interface UnresolvedPremise {\n  readonly assertion: PremiseAssertion;\n  readonly kind: \"no-match\" | \"ambiguous\";\n  /** The candidates a human should choose between. Empty for `no-match`. */\n  readonly candidates: readonly PremiseId[];\n  readonly explanation: string;\n}\n\nexport interface AssertionResult {\n  readonly drafts: readonly NewEvent<EventType>[];\n  readonly unresolved: readonly UnresolvedPremise[];\n  /** Set when the assertion is decision-level, so the adjudicator can screen it.\n   *  Premise-only assertions produce no newcomer: there is nothing to screen against\n   *  an incumbent, and inventing one would run adjudication on a premise. */\n  readonly newcomer: Newcomer | null;\n  /**\n   * ┬º2.6 nogood REUSE, checked at the ASSERTION rather than at the proposal.\n   *\n   * Catching it here is strictly better: the warning arrives while the user is still\n   * deciding whether to assert, instead of after the events are in the log and the\n   * proposal has been generated. Non-null means these premises are a conjunction the log\n   * has already recorded as impossible.\n   */\n  readonly reassertsNogood: Nogood | null;\n  readonly summary: string;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The entry point                                                            */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Turn new information into events.\n *\n * The `switch` on `source` is HERE AND NOWHERE ELSE. Each branch produces the same\n * kind of thing ΓÇö premise assertions and, where applicable, decision assertions ΓÇö and\n * the shared tail below turns those into drafts identically. That is the mechanism by\n * which the acceptance criterion holds: the branches differ in what they collect, not\n * in what the reasoner later sees.\n */\nexport function assertNewInformation(\n  assertion: Assertion,\n  context: AssertContext,\n): AssertionResult {\n  const premises: PremiseAssertion[] = [];\n  const decisions: DecisionAssertion[] = [];\n  let newcomer: Newcomer | null = null;\n\n  switch (assertion.source) {\n    case \"transcript\": {\n      premises.push(...assertion.premises);\n      decisions.push(...assertion.decisions);\n      break;\n    }\n\n    case \"user-decision\": {\n      premises.push(...assertion.premises);\n      decisions.push(assertion.decision);\n      break;\n    }\n\n    case \"guard-result\": {\n      /* A guard that FAILED asserts the negation of what the decision assumed. The\n       * observation carries `supports: false` in that case, and the shared tail turns\n       * it into evidence that refutes ΓÇö which is exactly what gate (c) reads. */\n      premises.push({\n        ...assertion.observation,\n        supports: assertion.passed ? assertion.observation.supports : false,\n      });\n      break;\n    }\n\n    case \"repo-scan\": {\n      premises.push(...assertion.observations);\n      break;\n    }\n  }\n\n  /* ---- the shared tail: identical for all four kinds ---- */\n\n  const drafts: NewEvent<EventType>[] = [];\n  const unresolved: UnresolvedPremise[] = [];\n  const mintedPremiseIds: PremiseId[] = [];\n  let premiseNumber = context.state.counters.premises;\n  let justificationNumber = context.state.counters.justifications;\n  let transcriptNumber = context.state.counters.transcripts;\n  let decisionNumber = context.state.counters.decisions;\n  let episodeNumber = context.state.counters.episodes;\n\n  const transcriptId: TranscriptId =\n    transcriptIdFor(assertion, context) ?? nextTranscriptId(context, drafts, ++transcriptNumber);\n\n  /* The premises of ONE assertion belong to ONE episode: they were observed\n   * together, and a premise asserted in isolation has no context to show. The\n   * episode id is minted lazily so an assertion with no premises does not burn\n   * one. */\n  let premiseEpisodeId: EpisodeId | null = null;\n  const episodeIdOf = (): EpisodeId => {\n    if (premiseEpisodeId === null) premiseEpisodeId = formatEpisodeId(++episodeNumber);\n    return premiseEpisodeId;\n  };\n\n  /* A human, a guard or a repo scan is its own authority: what it says is confirmed on\n   * arrival. A transcript is not ΓÇö extracted prose enters as UNKNOWN and waits for\n   * review, because nothing enters the log unreviewed. */\n  const authoritative = assertion.source !== \"transcript\";\n\n  for (const premise of premises) {\n    const resolution = resolvePremise(context.state, premise);\n\n    /* ---- unresolved: report, never guess ---- */\n    if (resolution.kind !== \"resolved\") {\n      if (!premise.supports) {\n        /* Nothing to refute. Creating a premise just to invalidate it would put a node\n         * in the graph whose entire history is \"asserted and immediately killed\", and\n         * gate (c) would fire on a decision that never rested on it. */\n        unresolved.push({\n          assertion: premise,\n          kind: resolution.kind,\n          candidates: resolution.candidates,\n          explanation:\n            resolution.kind === \"ambiguous\"\n              ? `Several premises match ${premise.type}.${premise.predicate}. A refutation aimed at the wrong one produces a spectacular, entirely wrong cascade, so pick the target rather than letting this guess.`\n              : `No premise in the log matches ${premise.type}.${premise.predicate}, so there is nothing to refute. If this was meant to falsify something, the predicate does not match ΓÇö check the type as well, since premises of different types are never the same node however similar their text.`,\n        });\n        continue;\n      }\n\n      /* A new supporting premise with no match. Mint it. */\n      premiseNumber += 1;\n      const premiseId = formatPremiseId(premiseNumber);\n      mintedPremiseIds.push(premiseId);\n      drafts.push(\n        premiseDraft(\n          premise,\n          premiseId,\n          transcriptId,\n          episodeIdOf(),\n          originOf(assertion.source),\n          context,\n        ),\n      );\n\n      /* Confirming it makes it IN, which is what lets an OUT-list exclusion fire:\n       * \"an excluded condition arrived\" only invalidates a justification once the\n       * condition is actually believed. Left UNKNOWN for a transcript. */\n      if (authoritative) drafts.push(confirmDraft(premiseId, premise, context));\n      continue;\n    }\n\n    const existingId = resolution.premiseId;\n\n    /* ---- resolved and REFUTING: this is what invalidates an IN-list premise ---- */\n    if (!premise.supports) {\n      drafts.push(invalidateDraft(existingId, premise, assertion.source, context));\n      continue;\n    }\n\n    /* ---- resolved and SUPPORTING: re-assert on the EXISTING id ----\n     * Invariant I2 ΓÇö premises are shared nodes. `PremiseAsserted` on an existing id\n     * appends evidence and takes the max confidence; minting a second node would halve\n     * the corroboration count on both and leave gate (c) looking at a premise that\n     * nothing rests on. */\n    drafts.push(\n      premiseDraft(\n        premise,\n        existingId,\n        transcriptId,\n        episodeIdOf(),\n        originOf(assertion.source),\n        context,\n      ),\n    );\n    mintedPremiseIds.push(existingId);\n\n    /* If it was UNKNOWN and this source is authoritative, it becomes IN ΓÇö which is the\n     * OUT-list half of gate (c). */\n    const existing = context.state.premises.get(existingId);\n    if (authoritative && existing !== undefined && existing.label !== \"IN\") {\n      drafts.push(confirmDraft(existingId, premise, context));\n    }\n  }\n\n  for (const decision of decisions) {\n    /* Local refs resolve against the premises this assertion touched, in order. */\n    const inList: PremiseId[] = (decision.premiseRefs ?? [])\n      .map((index) => mintedPremiseIds[index])\n      .filter((id): id is PremiseId => id !== undefined);\n\n    const existingDecision = findExistingDecision(context.state, decision);\n    if (existingDecision !== null) {\n      /* Not a new decision ΓÇö the same one, asserted again. Attaching a justification\n       * corroborates rather than duplicating; identity resolution already decided these\n       * are the same node. */\n      justificationNumber += 1;\n      drafts.push(\n        justificationDraft(\n          formatJustificationId(justificationNumber),\n          existingDecision,\n          inList,\n          context,\n        ),\n      );\n      continue;\n    }\n\n    decisionNumber += 1;\n    episodeNumber += 1;\n\n    drafts.push(\n      ...decisionDraft(\n        decision,\n        formatDecisionId(decisionNumber),\n        formatEpisodeId(episodeNumber),\n        inList,\n        transcriptId,\n        context,\n        () => {\n          justificationNumber += 1;\n          return formatJustificationId(justificationNumber);\n        },\n      ),\n    );\n  }\n\n  /* A decision-level assertion becomes a newcomer for the adjudicator. */\n  const source = sourceOf(assertion.source);\n  const firstDecision = decisions[0];\n  if (firstDecision !== undefined) {\n    newcomer = {\n      variable: firstDecision.variable,\n      value: canonicalValueOf(firstDecision.variable, firstDecision.value),\n      text: firstDecision.statement,\n      origin: firstDecision.origin,\n      confidence: firstDecision.confidence,\n      // `source` is optional on the newcomer, and `exactOptionalPropertyTypes`\n      // means the key must be ABSENT rather than present-and-undefined.\n      ...(source === undefined ? {} : { source }),\n    };\n  }\n\n  /* Existing premises named by a decision assertion, plus any premise this assertion\n   * refutes, form the conjunction being asserted. Checked against the recorded nogoods\n   * so the user is warned BEFORE the batch is committed rather than after. */\n  const conjunction = conjunctionOf(context.state, decisions, mintedPremiseIds);\n  const reassertsNogood = blocksConjunction(context.state, conjunction);\n\n  return {\n    drafts,\n    unresolved,\n    newcomer,\n    reassertsNogood,\n    summary: summarise(\n      assertion,\n      drafts,\n      mintedPremiseIds.length,\n      decisions.length,\n      reassertsNogood,\n      unresolved,\n    ),\n  };\n}\n\n/** The premises this assertion would place in the log together. */\nfunction conjunctionOf(\n  state: GraphState,\n  decisions: readonly DecisionAssertion[],\n  minted: readonly PremiseId[],\n): readonly PremiseId[] {\n  const found = new Set<PremiseId>(minted);\n\n  for (const decision of decisions) {\n    const existing = findExistingDecision(state, decision);\n    if (existing === null) continue;\n    for (const justification of state.justifications.values()) {\n      if (justification.consequent !== existing) continue;\n      for (const premiseId of justification.inList) found.add(premiseId);\n    }\n  }\n\n  return [...found];\n}\n\n/* -------------------------------------------------------------------------- */\n/* Drafts                                                                     */\n/* -------------------------------------------------------------------------- */\n\nfunction premiseDraft(\n  premise: PremiseAssertion,\n  premiseId: PremiseId,\n  transcriptId: TranscriptId,\n  episodeId: EpisodeId,\n  origin: DecisionOrigin,\n  context: AssertContext,\n): NewEvent<\"PremiseAsserted\"> {\n  const text = premise.text.trim();\n\n  return {\n    type: \"PremiseAsserted\",\n    payload: {\n      premiseId,\n      transcriptId,\n      episodeId,\n      origin,\n      type: premise.type,\n      predicate: canonicalPredicate(premise.type, premise.predicate),\n      ...(premise.value === undefined ? {} : { value: premise.value }),\n      /* A refuting observation is still a TRUE fact about the world ΓÇö \"there are now\n       * two editors\" is true, and it is what falsifies `single-user`. The polarity\n       * lives in the justification's IN/OUT lists, never in the premise text. */\n      text: premise.supports ? text : `refuted: ${text}`,\n      confidence: premise.confidence,\n      engine: context.engine,\n      snippet: premise.span ?? {\n        transcriptId,\n        start: 0,\n        end: text.length,\n        text,\n      },\n    },\n    actor: context.actor,\n    reason: reasonFor(premise, context),\n    at: context.at,\n  };\n}\n\nfunction justificationDraft(\n  justificationId: JustificationId,\n  consequent: DecisionId,\n  inList: readonly PremiseId[],\n  context: AssertContext,\n): NewEvent<\"JustificationAttached\"> {\n  const justification: Justification = {\n    id: justificationId,\n    consequent,\n    inList,\n    outList: [],\n    informant: informantFor(context),\n    createdAt: context.at,\n  };\n\n  return {\n    type: \"JustificationAttached\",\n    payload: { justificationId, consequent, justification },\n    actor: context.actor,\n    reason: `${consequent} gains an additional justification resting on ${inList.join(\", \")}. Corroboration, not a new decision.`,\n    at: context.at,\n  };\n}\n\nfunction decisionDraft(\n  decision: DecisionAssertion,\n  decisionId: DecisionId,\n  episodeId: EpisodeId,\n  inList: readonly PremiseId[],\n  transcriptId: TranscriptId,\n  context: AssertContext,\n  nextJustificationId: () => JustificationId,\n): readonly NewEvent<EventType>[] {\n  const justificationId = nextJustificationId();\n  const statement = decision.statement.trim();\n\n  const justification: Justification = {\n    id: justificationId,\n    consequent: decisionId,\n    inList,\n    outList: [],\n    informant: informantFor(context),\n    createdAt: context.at,\n  };\n\n  return [\n    {\n      type: \"DecisionProposed\",\n      payload: {\n        decisionId,\n        transcriptId,\n        episodeId,\n        variable: decision.variable,\n        value: canonicalValueOf(decision.variable, decision.value),\n        statement,\n        ...(decision.rationale === undefined ? {} : { rationale: decision.rationale }),\n        origin: decision.origin,\n        modality: \"asserted\",\n        confidence: decision.confidence,\n        engine: context.engine,\n        snippet: decision.span ?? {\n          transcriptId,\n          start: 0,\n          end: statement.length,\n          text: statement,\n        },\n        premiseIds: inList,\n        alternativeIds: [],\n        ...(decision.appliesTo === undefined ? {} : { appliesTo: decision.appliesTo }),\n      },\n      actor: context.actor,\n      reason: `Asserted from ${sourceLabel(context.source)}: ${statement}`,\n      at: context.at,\n      ...(assertionOccurredAt(context) === null\n        ? {}\n        : { occurredAt: assertionOccurredAt(context) as ISODateString }),\n    },\n    {\n      type: \"JustificationAttached\",\n      payload: { justificationId, consequent: decisionId, justification },\n      actor: context.actor,\n      reason:\n        inList.length === 0\n          ? `${decisionId} rests on NO premise. It is an unsupported assertion, and the labeller will report it as such rather than silently marking it IN.`\n          : `${decisionId} rests on ${inList.join(\", \")}.`,\n      at: context.at,\n    },\n  ];\n}\n\n/** Valid time, when the assertion carries it. A transcript knows when the conversation\n *  happened; a guard result happens now. */\nfunction assertionOccurredAt(context: AssertContext): ISODateString | null {\n  return context.occurredAt ?? null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Resolution                                                                 */\n/* -------------------------------------------------------------------------- */\n\nexport type PremiseResolution =\n  | { readonly kind: \"resolved\"; readonly premiseId: PremiseId }\n  | { readonly kind: \"ambiguous\"; readonly candidates: readonly PremiseId[] }\n  | { readonly kind: \"no-match\"; readonly candidates: readonly PremiseId[] };\n\n/**\n * Exact (type, predicate) match, or nothing.\n *\n * ┬º2.5's precision discipline, implemented as a refusal to be clever. Gate (c) fires\n * only on RESOLVED premise identity, and the failure mode of getting this wrong is not\n * a missed detection ΓÇö it is a confident, spectacular, entirely wrong cascade.\n *\n * Two rules that are not negotiable:\n *\n *   ┬╖ Predicates are canonicalised before comparison, so \"max users\" and \"max_users\"\n *     match and \"max user\" does not silently become something else.\n *   ┬╖ Premises of DIFFERENT TYPES never match, however similar their text. \"single user\"\n *     (scale) and \"single sign-on user flow\" (requirement) are different nodes, and a\n *     false merge between them is the exact scenario the identity ladder forbids.\n *\n * A near-match is NOT promoted to a match. It is reported as `no-match` and the\n * candidates are handed to a human, which is what ┬º2.11 means by \"surfaced for human\n * confirmation rather than guessed\".\n */\nexport function resolvePremise(state: GraphState, assertion: PremiseAssertion): PremiseResolution {\n  const canonical = canonicalPredicate(assertion.type, assertion.predicate);\n\n  /* The fold's OWN identity index, keyed by `premiseFingerprint(type, predicate)`.\n   *\n   * Using it rather than scanning `state.premises` is not an optimisation, though it is\n   * one. It is the guarantee that the reasoner and the fold agree about what the same\n   * premise IS. A resolver with its own notion of identity would eventually resolve a\n   * premise the fold considers distinct, and gate (c) would fire on a node nothing\n   * actually rests on ΓÇö the \"confident, spectacular, entirely wrong cascade\" ┬º2.5 warns\n   * about, arriving through the front door instead of through fuzzy matching. */\n  const byFingerprint = state.premiseByFingerprint.get(\n    premiseFingerprint(assertion.type, canonical),\n  );\n\n  if (byFingerprint !== undefined && state.premises.has(byFingerprint)) {\n    return { kind: \"resolved\", premiseId: byFingerprint };\n  }\n\n  /* Not in the index. Enumerate anyway, because the index can lag a node that was\n   * created before canonicalisation settled, and reporting those as candidates is what\n   * turns a silent no-match into a human decision. */\n  const matches: PremiseId[] = [];\n  for (const premise of state.premises.values()) {\n    if (premise.type !== assertion.type) continue;\n    if (premise.predicate !== canonical) continue;\n    matches.push(premise.id);\n  }\n\n  if (matches.length === 1) return { kind: \"resolved\", premiseId: matches[0] as PremiseId };\n  if (matches.length > 1) return { kind: \"ambiguous\", candidates: matches };\n  return { kind: \"no-match\", candidates: [] };\n}\n\n/**\n * Predicates that ALMOST match, for the human-confirmation UI.\n *\n * Deliberately separate from `resolvePremise` and never consulted by it: a resolver\n * that can see near-matches will eventually be tempted to use them, and the whole\n * precision discipline rests on it not being able to.\n */\nexport function nearMatches(\n  state: GraphState,\n  assertion: PremiseAssertion,\n  limit = 5,\n): readonly PremiseId[] {\n  const canonical = canonicalPredicate(assertion.type, assertion.predicate);\n  const wanted = foldKey(canonical.split(\".\").pop() ?? canonical);\n  const out: { id: PremiseId; score: number }[] = [];\n\n  for (const premise of state.premises.values()) {\n    const have = foldKey(premise.predicate.split(\".\").pop() ?? premise.predicate);\n    if (have === wanted) continue;\n    if (!have.includes(wanted) && !wanted.includes(have)) continue;\n    /* Same type scores higher. Cross-type near-matches are shown LAST and labelled,\n     * because they are the ones a human is most likely to accept wrongly. */\n    const score = premise.type === assertion.type ? 1 : 0;\n    out.push({ id: premise.id, score });\n  }\n\n  return out\n    .sort((a, b) => b.score - a.score)\n    .slice(0, limit)\n    .map((entry) => entry.id);\n}\n\n/* -------------------------------------------------------------------------- */\n/* The three premise events                                                   */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Refute an existing premise.\n *\n * This is the event that makes gate (c) fire on the IN-list side: the materialiser sets\n * `label: OUT` and closes the validity window, the labeller propagates, and every\n * decision whose IN-list named it loses support.\n *\n * `invalidatedBy.kind` has three members and a repo scan is not one of them ΓÇö it maps to\n * `\"assertion\"`, which is what it is: an assertion about the world that happens to have\n * come from a scan rather than a conversation.\n */\nfunction invalidateDraft(\n  premiseId: PremiseId,\n  premise: PremiseAssertion,\n  source: AssertionSource,\n  context: AssertContext,\n): NewEvent<\"PremiseInvalidated\"> {\n  const invalidatedBy: PremiseInvalidatedBy =\n    source === \"guard-result\"\n      ? { kind: \"guard\", guardId: PLACEHOLDER_GUARD_ID }\n      : source === \"user-decision\"\n        ? { kind: \"human\" }\n        : { kind: \"assertion\", eventId: PLACEHOLDER_EVENT_ID };\n\n  return {\n    type: \"PremiseInvalidated\",\n    payload: {\n      premiseId,\n      invalidatedBy,\n      ...(premise.span === undefined ? {} : { evidenceSpan: premise.span }),\n      /* A guard's finding is a line of a manifest, not a slice of a\n       * conversation, so there is no span - but the text is the evidence, and\n       * it is what the revision proposal has to quote. */\n      ...(premise.span === undefined ? { evidenceQuote: premise.text } : {}),\n    },\n    actor: context.actor,\n    reason: `${premiseId} is no longer true: \"${premise.text}\" ΓÇö observed by ${sourceLabel(source)}. Every decision resting on it is re-examined, and this event is the record of what falsified it.`,\n    at: context.at,\n    ...(context.occurredAt === undefined ? {} : { occurredAt: context.occurredAt }),\n  };\n}\n\n/**\n * Make a premise IN.\n *\n * Only for sources that are their own authority. Without this, an OUT-list exclusion\n * stays UNKNOWN and gate (c) never fires on it ΓÇö \"an excluded condition arrived\" is only\n * an invalidation once the condition is actually believed.\n */\nfunction confirmDraft(\n  premiseId: PremiseId,\n  premise: PremiseAssertion,\n  context: AssertContext,\n): NewEvent<\"PremiseConfirmed\"> {\n  return {\n    type: \"PremiseConfirmed\",\n    payload: { premiseId },\n    actor: context.actor,\n    reason: `Confirmed by ${context.actor.kind}: \"${premise.text}\". This makes it IN, which is what lets an excluded condition invalidate a justification that ruled it out.`,\n    at: context.at,\n    ...(context.occurredAt === undefined ? {} : { occurredAt: context.occurredAt }),\n  };\n}\n\n/** `PremiseInvalidatedPayload[\"invalidatedBy\"]`, named so the union is readable. */\ntype PremiseInvalidatedBy = NewEvent<\"PremiseInvalidated\">[\"payload\"][\"invalidatedBy\"];\n\n/** Phase 4 mints real guard ids. Until then a guard-sourced invalidation records the\n *  placeholder and the materialiser resolves it to the creating event, exactly as it\n *  does for every other forward reference in this codebase. */\nconst PLACEHOLDER_GUARD_ID = \"WLD-0000.g0\" as GuardId;\n\n/**\n * Is this decision already in the log?\n *\n * Same variable and same canonical value. That is rung 1 of the identity ladder and it\n * is exact enough here: a decision assertion arriving through this entry point has\n * already been canonicalised, and a fuzzy match belongs to the extraction pipeline,\n * which has context this function does not.\n */\nexport function findExistingDecision(\n  state: GraphState,\n  decision: DecisionAssertion,\n): DecisionId | null {\n  const canonical = foldKey(canonicalValueOf(decision.variable, decision.value));\n\n  for (const existing of state.decisions.values()) {\n    if (existing.variable !== decision.variable) continue;\n    if (foldKey(existing.value) === canonical) return existing.id;\n  }\n\n  return null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Transcripts, informants, reasons                                           */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptIdFor(assertion: Assertion, context: AssertContext): TranscriptId | null {\n  if (assertion.source === \"transcript\") return assertion.transcriptId;\n  return context.humanTranscriptId ?? null;\n}\n\n/**\n * Create a transcript to hold human- or machine-authored text.\n *\n * `PremiseAsserted` requires a verbatim snippet from SOME transcript. For text nobody\n * said in a recorded conversation, the honest container is a new transcript labelled\n * with its actual origin ΓÇö not a fabricated span inside the user's real one, which\n * would claim they said something they did not.\n */\nfunction nextTranscriptId(\n  context: AssertContext,\n  drafts: NewEvent<EventType>[],\n  n: number,\n): TranscriptId {\n  const transcriptId = formatTranscriptId(n);\n\n  drafts.unshift({\n    type: \"TranscriptImported\",\n    payload: {\n      transcriptId,\n      rawChars: 0,\n      label: \"asserted outside a transcript\",\n      engine: context.engine,\n    },\n    actor: context.actor,\n    reason:\n      \"Premises asserted by hand, by a guard or by a repo scan have no transcript to be verbatim from. This one exists to hold exactly that text, so every snippet in the log points at something real.\",\n    at: context.at,\n  });\n\n  return transcriptId;\n}\n\nfunction informantFor(context: AssertContext): Justification[\"informant\"] {\n  /* A human informant has no event to point at, and pointing at an unrelated one would\n   * be worse than saying so. */\n  return context.actor.kind === \"human\"\n    ? { kind: \"human\" }\n    : { kind: \"rejustification\", eventId: PLACEHOLDER_EVENT_ID };\n}\n\n/** Resolved to the creating event by the materialiser on fold. */\nconst PLACEHOLDER_EVENT_ID = \"EV-000000-000000\" as EventId;\n\nfunction reasonFor(premise: PremiseAssertion, context: AssertContext): string {\n  const verb = premise.supports ? \"supports\" : \"REFUTES\";\n  return `${verb} ${premise.type}.${canonicalPredicate(premise.type, premise.predicate)}: \"${premise.text}\" ΓÇö observed by ${context.actor.kind}, confidence ${premise.confidence.toFixed(2)}.`;\n}\n\nfunction sourceOf(source: AssertionSource): Newcomer[\"source\"] {\n  switch (source) {\n    case \"transcript\":\n      return \"transcript\";\n    case \"user-decision\":\n      return \"human\";\n    case \"guard-result\":\n      return \"guard\";\n    case \"repo-scan\":\n      return \"repo-scan\";\n  }\n}\n\n/**\n * Who an asserted premise is attributed to.\n *\n * A human typed it or a human said it: `human_stated`. A guard observed it or\n * a scan found it: `agent_inferred`, which is the honest answer ΓÇö a machine\n * reading the world, not a person making a claim.\n */\nfunction originOf(source: AssertionSource): DecisionOrigin {\n  switch (source) {\n    case \"transcript\":\n    case \"user-decision\":\n      return \"human_stated\";\n    case \"guard-result\":\n    case \"repo-scan\":\n      return \"agent_inferred\";\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Summaries                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function sourceLabel(source: AssertionSource): string {\n  switch (source) {\n    case \"transcript\":\n      return \"a reviewed transcript\";\n    case \"user-decision\":\n      return \"a decision you entered by hand\";\n    case \"guard-result\":\n      return \"a guard run\";\n    case \"repo-scan\":\n      return \"a repo scan\";\n  }\n}\n\nfunction summarise(\n  assertion: Assertion,\n  drafts: readonly NewEvent<EventType>[],\n  premiseCount: number,\n  decisionCount: number,\n  reassertsNogood: Nogood | null,\n  unresolved: readonly UnresolvedPremise[],\n): string {\n  const refuting =\n    assertion.source === \"guard-result\" && !assertion.passed\n      ? \" The guard FAILED, so the observation refutes what the decision assumed.\"\n      : \"\";\n\n  const tally = drafts\n    .map((draft) => draft.type)\n    .reduce<Record<string, number>>((accumulator, type) => {\n      accumulator[type] = (accumulator[type] ?? 0) + 1;\n      return accumulator;\n    }, {});\n\n  const parts = Object.entries(tally).map(([type, count]) => `${count} ├ù ${type}`);\n\n  const unresolvedNote =\n    unresolved.length === 0\n      ? \"\"\n      : `${unresolved.length} assertion(s) matched no premise and were NOT acted on ΓÇö see the unresolved list.`;\n\n  const nogoodWarning =\n    reassertsNogood === null\n      ? \"\"\n      : `WARNING: this re-asserts ${reassertsNogood.id}, recorded impossible on ${reassertsNogood.recordedAt.slice(0, 10)}.`;\n\n  return [\n    nogoodWarning,\n    unresolvedNote,\n    `Asserted from ${sourceLabel(assertion.source)}: ${premiseCount} premise(s), ${decisionCount} decision(s).`,\n    parts.length === 0\n      ? \"No events ΓÇö everything was already in the log.\"\n      : `Events: ${parts.join(\", \")}.`,\n    refuting.trim(),\n  ]\n    .filter((part) => part.length > 0)\n    .join(\" \");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Convenience constructors                                                   */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Falsify a premise by predicate.\n *\n * The single most common assertion in the whole product, and the one the G2 demo runs\n * on: \"there are now two users\" against a log built on `single-user`. It is a function\n * rather than a form because Phase 4 calls it from the guard runner with the same\n * arguments, and a demo path that differs from the production path is a demo that\n * proves nothing.\n */\nexport function falsifyPremise(\n  type: PremiseType,\n  predicate: string,\n  observedText: string,\n  _context: AssertContext,\n): Assertion {\n  return {\n    source: \"repo-scan\",\n    observations: [\n      {\n        type,\n        predicate,\n        text: observedText,\n        supports: false,\n        confidence: asConfidence(0.9),\n      },\n    ],\n  };\n}\n\n/** A decision entered by hand, with the premises it rests on. */\nexport function userDecision(\n  decision: DecisionAssertion,\n  premises: readonly PremiseAssertion[] = [],\n): Assertion {\n  return { source: \"user-decision\", decision, premises };\n}\n\n/** A guard's verdict on a decision. Phase 4 calls this. */\nexport function guardResult(\n  decisionId: DecisionId,\n  passed: boolean,\n  observation: PremiseAssertion,\n): Assertion {\n  return { source: \"guard-result\", decisionId, passed, observation };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 62 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 62 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 62 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\retrieval\\candidates.ts"},"span":[4647,4661],"sourceCode":"/**\n * Candidate generation for gate (b) ΓÇö Phase 3 ┬╖ sub-phase 3.6.\n *\n * Plan: plan/phase-3-retrieval.md ┬º3.6\n *       plan/phase-2-truth-maintenance.md ┬º2.5 (gate b)\n *\n * ---------------------------------------------------------------------------\n * WHAT GATE (b) ASKS RETRIEVAL FOR\n *\n * Gate (b) is the semantic gate: find pairs of decisions that MIGHT contradict each other,\n * so the classifier can judge them. It cannot compare every pair ΓÇö that is O(n┬▓) over the\n * whole log and almost all of it is wasted, since two decisions about different variables in\n * different months are not candidates for anything.\n *\n * So retrieval proposes a short list of pairs. `gates/semantic.ts` takes them as\n * `CandidatePair[]` and disposes of them.\n *\n * ---------------------------------------------------------------------------\n * ZERO EMBEDDING CALLS\n *\n * The L1 vectors already exist in the index artifacts ΓÇö they were computed at extraction time\n * and are exactly what a candidate generator needs. This reads them; it never calls\n * `engine.embed`. Gate (b) therefore runs keyless and offline, like the rest of the reasoning\n * layer, and its cost is a pairwise cosine over vectors already in memory.\n *\n * ---------------------------------------------------------------------------\n * SIMILARITY SELECTS, AND IS THEN DISCARDED\n *\n * `CandidatePair.similarity` is carried because the UI shows it and because a reviewer needs\n * to know how the pair was surfaced. It is NEVER a verdict. \"Use Postgres\" and \"don't use\n * Postgres\" are ~0.9 cosine similar, so a threshold on this number is a contradiction\n * detector that fires on agreement ΓÇö which is invariant I3's whole subject.\n *\n * That is also why the pair list is seeded from THREE sources rather than similarity alone:\n *\n *   dense neighbours    pairs close in embedding space\n *   shared premises     pairs resting on the same assumption ΓÇö the gate (c) neighbourhood,\n *                       which is where premise invalidation turns into a conflict\n *   same variable       pairs settling the same slot, whatever their wording ΓÇö the only\n *                       pairs that can be reversals or refinements at all\n *\n * A similarity-only candidate list would miss the third kind whenever the wording differs, and\n * \"we chose SQLite\" vs \"the database is sqlite\" is a plausible pair that embeddings may not\n * rank highly.\n *\n * ---------------------------------------------------------------------------\n * ONLY LIVE DECISIONS ARE CANDIDATES\n *\n * A `proposed` decision never became a belief and a `superseded` one has been withdrawn;\n * neither can contradict a live decision. Filtering here means the classifier's\n * `isClassifiable` guard is never the thing standing between a proposal and a false finding ΓÇö\n * it is a second line of defence, not the only one.\n * ---------------------------------------------------------------------------\n */\n\nimport { cosine } from \"@/lib/cosine\";\nimport type { CandidatePair } from \"@/reasoning/gates/semantic\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { IndexArtifacts } from \"@/types/retrieval\";\nimport { isClassifiable } from \"./contradiction\";\n\n/** How many dense neighbours each decision is compared against. Small on purpose: gate (b)\n *  classifies every pair it is given, and each classification on the LLM path is a model call.\n *  Five neighbours per decision keeps a 200-decision log to a few hundred pairs. */\nexport const NEIGHBOURS_PER_DECISION = 5;\n\n/** Below this cosine two decisions are not dense neighbours. Not a contradiction threshold ΓÇö\n *  a candidate threshold, and a deliberately loose one, because the classifier is what decides\n *  and it costs little to give it one more pair to reject. */\nexport const NEIGHBOUR_FLOOR = 0.35;\n\n/** Hard ceiling on pairs returned, whatever the log size. Without it a large log produces a\n *  pair list long enough to make gate (b) the slowest thing in the app, and a slow gate gets\n *  skipped ΓÇö which is worse than a bounded one. */\nexport const MAX_CANDIDATE_PAIRS = 200;\n\nexport interface CandidateOptions {\n  readonly neighboursPerDecision?: number;\n  readonly neighbourFloor?: number;\n  readonly maxPairs?: number;\n  readonly signal?: AbortSignal;\n}\n\n/**\n * Generate gate (b)'s candidate pairs.\n *\n * Synchronous and allocation-light: it reads vectors already in memory. The `Promise` in\n * gate (b)'s `retrieve` signature is for implementations that DO need to embed; this one\n * does not, and the wrapper in `store/reasoning.ts` adapts it.\n */\nexport function candidatePairs(\n  state: GraphState,\n  artifacts: IndexArtifacts,\n  options?: CandidateOptions,\n): readonly CandidatePair[] {\n  const neighboursPerDecision = options?.neighboursPerDecision ?? NEIGHBOURS_PER_DECISION;\n  const floor = options?.neighbourFloor ?? NEIGHBOUR_FLOOR;\n  const maxPairs = options?.maxPairs ?? MAX_CANDIDATE_PAIRS;\n\n  const live = liveDecisions(state);\n  if (live.length < 2) return [];\n\n  const liveSet = new Set(live.map((id) => id as DecisionId));\n  const pairs = new Map<string, MutablePair>();\n\n  /* ---- source 1: dense neighbours ---- */\n  if (!artifacts.stale) {\n    const vectors = new Map<DecisionId, Float32Array>();\n    for (const entry of artifacts.dense) {\n      if (entry.level !== \"L1\") continue;\n      if (!liveSet.has(entry.decisionId)) continue;\n      vectors.set(entry.decisionId, entry.vector);\n    }\n\n    const ids = [...vectors.keys()];\n\n    for (const a of ids) {\n      const vectorA = vectors.get(a);\n      if (vectorA === undefined) continue;\n\n      const scored: { id: DecisionId; score: number }[] = [];\n      for (const b of ids) {\n        if (a >= b) continue;\n        const vectorB = vectors.get(b);\n        if (vectorB === undefined) continue;\n        const score = cosine(vectorA, vectorB);\n        if (score < floor) continue;\n        scored.push({ id: b, score });\n      }\n\n      scored.sort((x, y) => y.score - x.score);\n\n      for (const neighbour of scored.slice(0, neighboursPerDecision)) {\n        addPair(pairs, a, neighbour.id, neighbour.score, \"dense\");\n      }\n    }\n  }\n\n  /* ---- source 2: shared premises ---- */\n  for (const [premiseId, dependents] of state.premiseToDecisions) {\n    const shared = dependents.filter((id) => liveSet.has(id));\n    if (shared.length < 2) continue;\n\n    for (let i = 0; i < shared.length; i += 1) {\n      for (let j = i + 1; j < shared.length; j += 1) {\n        const a = shared[i];\n        const b = shared[j];\n        if (a === undefined || b === undefined) continue;\n        addPair(pairs, a, b, 0, \"shared-premise\", premiseId);\n      }\n    }\n  }\n\n  /* ---- source 3: same variable ---- */\n  for (const [, decisionIds] of state.byVariable) {\n    const live_ = decisionIds.filter((id) => liveSet.has(id));\n    if (live_.length < 2) continue;\n\n    for (let i = 0; i < live_.length; i += 1) {\n      for (let j = i + 1; j < live_.length; j += 1) {\n        const a = live_[i];\n        const b = live_[j];\n        if (a === undefined || b === undefined) continue;\n        addPair(pairs, a, b, 0, \"same-variable\");\n      }\n    }\n  }\n\n  /* Highest similarity first, then stable by key, so a truncated list keeps the pairs most\n   * likely to be interesting and the run is reproducible. */\n  const ordered = [...pairs.values()].sort((x, y) =>\n    y.similarity === x.similarity\n      ? x.a < y.a\n        ? -1\n        : x.a > y.a\n          ? 1\n          : x.b < y.b\n            ? -1\n            : 1\n      : y.similarity - x.similarity,\n  );\n\n  return ordered.slice(0, maxPairs).map(\n    (pair): CandidatePair => ({\n      a: pair.a,\n      b: pair.b,\n      similarity: pair.similarity,\n      sharedPremises: [...pair.sharedPremises],\n    }),\n  );\n}\n\ninterface MutablePair {\n  readonly a: DecisionId;\n  readonly b: DecisionId;\n  similarity: number;\n  readonly sharedPremises: Set<PremiseId>;\n  readonly via: Set<string>;\n}\n\nfunction addPair(\n  into: Map<string, MutablePair>,\n  rawA: DecisionId,\n  rawB: DecisionId,\n  similarity: number,\n  via: string,\n  premiseId?: PremiseId,\n): void {\n  const a = rawA < rawB ? rawA : rawB;\n  const b = rawA < rawB ? rawB : rawA;\n  const key = `${a}\\u0000${b}`;\n\n  const existing = into.get(key);\n  if (existing === undefined) {\n    into.set(key, {\n      a,\n      b,\n      similarity,\n      sharedPremises: new Set(premiseId === undefined ? [] : [premiseId]),\n      via: new Set([via]),\n    });\n    return;\n  }\n\n  existing.via.add(via);\n  if (similarity > existing.similarity) existing.similarity = similarity;\n  if (premiseId !== undefined) existing.sharedPremises.add(premiseId);\n}\n\n/** Live decisions only. `contested` counts as live: that is the state where a conflict is\n *  awaiting a human call, so it must keep being examined. */\nfunction liveDecisions(state: GraphState): readonly DecisionId[] {\n  const out: DecisionId[] = [];\n  for (const decision of state.decisions.values()) {\n    if (!isClassifiable(decision.status)) continue;\n    out.push(decision.id);\n  }\n  return out;\n}\n\n/** Why a pair is a candidate at all. Printed next to the finding so a reviewer can see that\n *  the pair was surfaced by an exact relation rather than by a similarity score ΓÇö which\n *  matters, because the two have completely different trustworthiness. */\nexport function describeSource(pair: CandidatePair, state: GraphState): string {\n  const a = state.decisions.get(pair.a);\n  const b = state.decisions.get(pair.b);\n  if (a === undefined || b === undefined) return \"candidate\";\n\n  const reasons: string[] = [];\n\n  if (a.variable === b.variable) {\n    reasons.push(\n      `both settle ${a.variable}${a.value === b.value ? ` on \"${a.value}\"` : ` ΓÇö one on \"${a.value}\", one on \"${b.value}\"`}`,\n    );\n  }\n\n  if (pair.sharedPremises.length > 0) {\n    reasons.push(\n      `they share ${pair.sharedPremises.length} premise(s): ${pair.sharedPremises.map((id) => id).join(\", \")}`,\n    );\n  }\n\n  if (pair.similarity > 0) {\n    reasons.push(`embedding similarity ${pair.similarity.toFixed(3)}`);\n  }\n\n  if (reasons.length === 0) return \"candidate\";\n\n  /* The similarity is stated LAST and labelled, because it is the weakest of the three and\n   * the one a reader is most likely to mistake for the reason a contradiction was reported. */\n  return reasons.join(\"; \");\n}\n\nexport function describeCandidatePolicy(): string {\n  return [\n    \"Gate (b) candidates come from three sources, unioned and de-duplicated:\",\n    \"\",\n    `  dense neighbours    cosine >= ${NEIGHBOUR_FLOOR}, top ${NEIGHBOURS_PER_DECISION} per decision, read from the`,\n    \"                      L1 vectors already in the index ΓÇö ZERO embedding calls\",\n    \"  shared premises     pairs resting on the same assumption, wherever similarity puts them\",\n    \"  same variable       pairs settling the same slot, whatever their wording\",\n    \"\",\n    `Ceiling: ${MAX_CANDIDATE_PAIRS} pairs. Only live decisions are candidates ΓÇö a proposal never became a`,\n    \"belief and a superseded decision has been withdrawn, so neither can contradict one.\",\n    \"\",\n    \"The similarity carried on each pair SELECTS it and is then discarded. It is never a\",\n    \"verdict: 'use Postgres' and 'don't use Postgres' are ~0.9 similar, so a threshold on\",\n    \"this number is a contradiction detector that fires on agreement. Invariant I3.\",\n    \"\",\n    \"A similarity-only list would miss the same-variable pairs whenever the wording differs,\",\n    \"which is why there are three sources rather than one.\",\n  ].join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 28 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 28 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 28 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\retrieval\\contradiction.ts"},"span":[5170,5182],"sourceCode":"/**\n * The contradiction classifier ΓÇö 3.6.\n *\n * Phase 3 ┬╖ sub-phase 3.6\n * Plan: plan/phase-3-retrieval.md ┬º3.6\n * Verdict definitions: plan/phase-2-truth-maintenance.md ┬º2.4\n *\n * ---------------------------------------------------------------------------\n * RETRIEVAL PROPOSES, THIS DISPOSES ΓÇö INVARIANT I3\n *\n * \"Use Postgres\" and \"don't use Postgres\" are ~0.9 cosine similar. Embedding models encode\n * TOPIC, not POLARITY. Any code path where a similarity threshold decides a contradiction is\n * a bug, not a tuning problem.\n *\n * So the similarity score is used to SELECT candidates and is then THROWN AWAY. Nothing in\n * this file reads it. The verdict comes from variable, value, polarity and rationale ΓÇö all\n * discrete, all inspectable, none of them a float that drifts when the model changes.\n *\n * That is why `classifyPair` takes two `DecisionSnapshot`s and not a score, and why there is\n * no threshold constant anywhere in this file to tune.\n *\n * ---------------------------------------------------------------------------\n * THE RULE ORDER, AND WHY IT DIFFERS FROM ┬º3.6 AS WRITTEN\n *\n * ┬º3.6 lists five rules and says \"in order\":\n *\n *   1. shared variable + differing canonical value        ΓåÆ reversal\n *   2. negation cue in scope + same variable and value    ΓåÆ contradiction\n *   3. same variable and value + new rationale            ΓåÆ refinement\n *   4. antonym-pair members asserted on the same variable ΓåÆ contradiction\n *   5. otherwise                                          ΓåÆ neutral\n *\n * **Rule 4 is unreachable in that order.** An antonym pair IS a differing canonical value on\n * a shared variable, so rule 1 always fires first and rule 4 can never be reached. But ┬º3.6's\n * own acceptance criterion requires that \"the classifier's five verdicts are individually\n * testable\" ΓÇö and an unreachable rule is not testable.\n *\n * So the antonym test moves to the front, which is also what the semantics want:\n *\n *   1. ANTONYM PAIR on the same variable                  ΓåÆ contradiction\n *      Two declared-mutually-exclusive choices, both live. This is gate (a)'s territory and\n *      it is a genuine conflict, not a change of mind.\n *   2. negation cue in scope + same variable and value    ΓåÆ contradiction\n *      The values AGREE but one statement negates the other ΓÇö the reasoning conflicts even\n *      though the choice does not.\n *   3. shared variable + differing (non-antonym) value    ΓåÆ reversal\n *      A change of direction: \"sqlite\" then \"sqlite with WAL\". Deliberate, superseded, both\n *      retained. Calling this a contradiction would put every refinement in the conflict\n *      queue, which is how the feature gets switched off.\n *   4. same variable and value + new or changed rationale ΓåÆ refinement\n *   5. otherwise                                          ΓåÆ neutral\n *\n * All five are now reachable and individually testable. The deviation is recorded here and in\n * STRUCTURE.md ┬º18.3 rather than silently \"fixed\", because a plan and an implementation that\n * disagree without a note is how the next person reintroduces the bug.\n *\n * ---------------------------------------------------------------------------\n * HYPOTHETICALS PRODUCE NO VERDICT AT ALL\n *\n * ┬º3.6's acceptance criterion. A `proposed` or `hypothetical` decision never became a belief,\n * so it cannot contradict one. Classifying it would report a conflict between something the\n * user decided and something they were thinking aloud about.\n * ---------------------------------------------------------------------------\n */\n\nimport type { ClassificationRequest, DecisionSnapshot } from \"@/ai/types\";\nimport { areAntonyms, canonicalValueOf } from \"@/ontology\";\nimport { foldKey } from \"@/ontology/canonicalize\";\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { DecisionStatus } from \"@/types/domain\";\nimport type { ClassificationResult, ContradictionVerdict } from \"@/types/retrieval\";\nimport { type NegationScopeVerdict, negationBetween } from \"./negation\";\n\n/** Which rule fired. Carried on every verdict because the explanation has to name the rule\n *  that decided it ΓÇö a verdict without its rule is an assertion, not a diagnosis. */\nexport type ClassifierRule =\n  | \"antonym-pair\"\n  | \"negation-scope\"\n  | \"differing-value\"\n  | \"new-rationale\"\n  | \"no-rule\";\n\nexport interface PairVerdict {\n  readonly verdict: ContradictionVerdict;\n  readonly rule: ClassifierRule;\n  readonly explanation: string;\n  readonly confidence: number;\n  readonly negation: NegationScopeVerdict | null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The classifier                                                             */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Classify one pair. Pure, deterministic, engine-independent.\n *\n * This is the canonical rule engine. `ai/local/classify.ts` delegates here for the local\n * path, and the LLM path uses it as the `structuralVerdict` it must explicitly disagree with\n * rather than silently override.\n */\nexport function classifyPair(a: DecisionSnapshot, b: DecisionSnapshot): PairVerdict {\n  const sameVariable = a.variable === b.variable;\n  const canonicalA = canonicalValueOf(a.variable, a.value);\n  const canonicalB = canonicalValueOf(b.variable, b.value);\n  const sameValue = foldKey(canonicalA) === foldKey(canonicalB);\n\n  /* ---- rule 1: antonym pair ---- */\n  if (sameVariable && !sameValue) {\n    const antonym = areAntonyms(a.variable, canonicalA, canonicalB);\n    if (antonym.antonym) {\n      return {\n        verdict: \"contradiction\",\n        rule: \"antonym-pair\",\n        explanation: `Both settle ${a.variable}, one on \"${canonicalA}\" and one on \"${canonicalB}\", and the ontology declares those mutually exclusive. ${antonym.why ?? \"\"}`,\n        confidence: 0.95,\n        negation: null,\n      };\n    }\n  }\n\n  /* ---- rule 2: negation in scope, values agree ---- */\n  if (sameVariable && sameValue) {\n    const negation = negationBetween(\n      a.statement + (a.rationale === undefined ? \"\" : ` ${a.rationale}`),\n      b.statement + (b.rationale === undefined ? \"\" : ` ${b.rationale}`),\n      canonicalA,\n    );\n\n    if (negation.negated) {\n      return {\n        verdict: \"contradiction\",\n        rule: \"negation-scope\",\n        explanation: `Both settle ${a.variable} on \"${canonicalA}\", but one of them negates it within scope (\"${negation.cue}\"). ${negation.reason} The choice agrees and the reasoning does not, which is a contradiction in the justification rather than in the decision.`,\n        confidence: 0.6,\n        negation,\n      };\n    }\n\n    /* ---- rule 4: same variable, same value, new or changed rationale ---- */\n    const rationaleA = (a.rationale ?? \"\").trim();\n    const rationaleB = (b.rationale ?? \"\").trim();\n    const oneAdds = rationaleA.length > 0 !== rationaleB.length > 0;\n    const differs =\n      rationaleA.length > 0 && rationaleB.length > 0 && foldKey(rationaleA) !== foldKey(rationaleB);\n\n    if (oneAdds || differs) {\n      return {\n        verdict: \"refinement\",\n        rule: \"new-rationale\",\n        explanation: `Both settle ${a.variable} on \"${canonicalA}\" and agree. ${\n          oneAdds\n            ? \"One records a reason the other does not, so this is an elaboration ΓÇö merge them so the reason survives.\"\n            : \"They give different reasons for the same choice. Both may be true; merge rather than supersede.\"\n        }`,\n        confidence: 0.55,\n        negation: null,\n      };\n    }\n\n    return {\n      verdict: \"neutral\",\n      rule: \"no-rule\",\n      explanation: `Both settle ${a.variable} on \"${canonicalA}\" with no distinguishing rationale. Nothing to revise ΓÇö this looks like one decision recorded twice.`,\n      confidence: 0.45,\n      negation: null,\n    };\n  }\n\n  /* ---- rule 3: shared variable, differing non-antonym value ---- */\n  if (sameVariable && !sameValue) {\n    const newer = a.validFrom >= b.validFrom ? a : b;\n    const older = newer === a ? b : a;\n\n    return {\n      verdict: \"reversal\",\n      rule: \"differing-value\",\n      explanation: `Both settle ${a.variable}, one on \"${older.value}\" (${older.id}, valid from ${older.validFrom}) and one on \"${newer.value}\" (${newer.id}, valid from ${newer.validFrom}). The values are not a declared antonym pair, so this reads as a change of direction rather than a contradiction: the earlier decision was right under the conditions it was made in, and the later one replaces it.`,\n      confidence: 0.7,\n      negation: null,\n    };\n  }\n\n  /* ---- rule 5 ---- */\n  return {\n    verdict: \"neutral\",\n    rule: \"no-rule\",\n    explanation: `Different variables (${a.variable} and ${b.variable}) and no negation reaching a shared value. Topically related at most; logically compatible.`,\n    confidence: 0.4,\n    negation: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The hypothetical guard ΓÇö ┬º3.6's acceptance criterion                       */\n/* -------------------------------------------------------------------------- */\n\n/**\n * May this decision be classified at all?\n *\n * A `proposed` decision never became a belief, so it cannot contradict one. Neither can a\n * `superseded` or `archived` one against a live decision: the log has already withdrawn it,\n * and reporting a conflict with a belief the system no longer holds would put resolved\n * history back in the conflict queue.\n *\n * `contested` IS classifiable ΓÇö that is precisely the state where a conflict is live and\n * awaiting a human call, so it must keep being visible.\n *\n * This lives here rather than in `ai/local/classify.ts` because `DecisionSnapshot` carries no\n * lifecycle status: whether a decision may be classified is pipeline policy applied before a\n * request is built, not engine behaviour. An engine told \"don't classify this\" would have to\n * invent a verdict to return; never being asked does not.\n */\nexport function isClassifiable(status: DecisionStatus): boolean {\n  return status === \"active\" || status === \"contested\";\n}\n\nexport function explainNotClassifiable(status: DecisionStatus): string {\n  switch (status) {\n    case \"proposed\":\n      return \"It is still a proposal. Nothing was ever believed, so nothing can contradict it.\";\n    case \"superseded\":\n      return \"It has been superseded. The log already withdrew it, so a conflict with it is resolved history, not a live finding.\";\n    case \"archived\":\n      return \"It has been archived. Same reason as superseded: reporting it would put settled history back in the conflict queue.\";\n    case \"active\":\n    case \"contested\":\n      return \"\";\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* M1 / M2 diagnostics                                                        */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Borrowed from arXiv:2506.11005, and surfaced separately because they mean different\n * things and have different remedies.\n *\n *   M1 ΓÇö SIMILAR decisions, CONTRADICTORY rationales ΓåÆ probable misunderstanding.\n *        The decision may be fine; the REASON is broken.\n *   M2 ΓÇö CONTRADICTORY decisions, SIMILAR rationales ΓåÆ probable copy-paste or an\n *        extraction error. A DATA-QUALITY problem, not a reasoning problem.\n *\n * Both need a similarity judgement, which is the one thing invariant I3 forbids this file\n * from making about VERDICTS. Using it for a diagnostic is different in kind: an M1/M2 label\n * never changes what the system does, only how it describes what it found, and a wrong\n * diagnostic is a wrong footnote rather than a wrong retraction.\n */\nexport function diagnose(\n  verdict: ContradictionVerdict,\n  rationaleSimilarity: number,\n): \"M1\" | \"M2\" | null {\n  if (verdict === \"contradiction\" && rationaleSimilarity >= M2_RATIONALE_FLOOR) return \"M2\";\n  if (verdict === \"refinement\" && rationaleSimilarity <= M1_RATIONALE_CEILING) return \"M1\";\n  return null;\n}\n\nexport const M1_RATIONALE_CEILING = 0.35;\nexport const M2_RATIONALE_FLOOR = 0.8;\n\nexport const DIAGNOSTIC_MEANING: Readonly<Record<\"M1\" | \"M2\", string>> = {\n  M1: \"Similar decisions with contradictory rationales ΓÇö probable misunderstanding. The decision may be fine; the reason is broken.\",\n  M2: \"Contradictory decisions with similar rationales ΓÇö probable copy-paste or an extraction error. A data-quality problem, not a reasoning problem.\",\n};\n\n/* -------------------------------------------------------------------------- */\n/* Batch classification                                                       */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Classify every candidate pair retrieval produced.\n *\n * Pairs are de-duplicated by sorted id so a pair retrieved from both directions is judged\n * once, and only pairs where at least one side is `asserted` are judged at all ΓÇö a\n * hypothetical cannot contradict a belief.\n */\nexport function classifyPairs(\n  pairs: readonly { a: DecisionSnapshot; b: DecisionSnapshot }[],\n  engine: EngineId,\n): readonly ClassificationResult[] {\n  const seen = new Set<string>();\n  const out: ClassificationResult[] = [];\n\n  for (const pair of pairs) {\n    const key =\n      pair.a.id < pair.b.id ? `${pair.a.id}\\u0000${pair.b.id}` : `${pair.b.id}\\u0000${pair.a.id}`;\n    if (seen.has(key)) continue;\n    seen.add(key);\n\n    const verdict = classifyPair(pair.a, pair.b);\n\n    /* No similarity is available here, so no diagnostic is claimed. M1/M2 both need a\n     * rationale-similarity judgement; guessing one would print a confident footnote over a\n     * number nobody computed. */\n    const diagnostic = null;\n\n    out.push({\n      verdict: verdict.verdict,\n      gate: \"semantic\",\n      explanation: verdict.explanation,\n      confidence: asConfidence(verdict.confidence),\n      engine,\n      ...(diagnostic === null ? {} : { diagnostic }),\n    });\n  }\n\n  return out;\n}\n\n/** Build the request the engine's `classify` expects, with this classifier's verdict as the\n *  structural answer the model must explicitly disagree with rather than silently override. */\nexport function requestFor(\n  a: DecisionSnapshot,\n  b: DecisionSnapshot,\n  engine: EngineId,\n  sharedPremises?: ClassificationRequest[\"sharedPremises\"],\n): ClassificationRequest {\n  const local = classifyPair(a, b);\n\n  return {\n    decisionA: a,\n    decisionB: b,\n    ...(sharedPremises === undefined ? {} : { sharedPremises }),\n    structuralVerdict: {\n      verdict: local.verdict,\n      gate: \"semantic\",\n      explanation: local.explanation,\n      confidence: asConfidence(local.confidence),\n      engine,\n    },\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeVerdict(verdict: ContradictionVerdict): string {\n  switch (verdict) {\n    case \"contradiction\":\n      return \"CONTRADICTION ΓÇö cannot both hold. Full revision cycle.\";\n    case \"reversal\":\n      return \"REVERSAL ΓÇö the newer deliberately replaces the older on the same variable. Supersede; both retained.\";\n    case \"refinement\":\n      return \"REFINEMENT ΓÇö same variable, same value, added or corrected rationale. Merge; corroboration +1; no label change. This is by far the most common relationship between related decisions, and flagging it as a conflict is how the feature gets switched off.\";\n    case \"premise-invalidation\":\n      return \"PREMISE-INVALIDATION ΓÇö no conflict between the decisions; a shared premise became false. Gate (c) handles this.\";\n    case \"neutral\":\n      return \"NEUTRAL ΓÇö topically related, logically compatible. A `related` edge for the graph view; nothing else.\";\n  }\n}\n\nexport function describeRule(rule: ClassifierRule): string {\n  switch (rule) {\n    case \"antonym-pair\":\n      return \"rule 1 ΓÇö the ontology declares these two values mutually exclusive under this variable\";\n    case \"negation-scope\":\n      return \"rule 2 ΓÇö the values agree but a negation cue falls within scope of the value\";\n    case \"differing-value\":\n      return \"rule 3 ΓÇö same variable, different value, not a declared antonym pair\";\n    case \"new-rationale\":\n      return \"rule 4 ΓÇö same variable and value, with a rationale one side has and the other does not\";\n    case \"no-rule\":\n      return \"rule 5 ΓÇö no rule applies; neutral by default, never by guess\";\n  }\n}\n\n/** The five rules in order, for the health panel. Listing them is what makes the classifier\n *  auditable: there is no threshold to hide behind and no model to appeal to. */\nexport function describeRules(): string {\n  return [\n    \"The contradiction classifier applies five rules in this order and reads no similarity score:\",\n    \"  1. antonym pair on the same variable            ΓåÆ contradiction   (0.95)\",\n    \"  2. negation in scope + same variable and value  ΓåÆ contradiction   (0.60)\",\n    \"  3. same variable + differing value              ΓåÆ reversal        (0.70)\",\n    \"  4. same variable and value + new rationale      ΓåÆ refinement      (0.55)\",\n    \"  5. otherwise                                    ΓåÆ neutral         (0.40)\",\n    \"\",\n    \"┬º3.6 lists rule 4 (antonym pair) fourth, which makes it unreachable: an antonym pair is a\",\n    \"differing value, so rule 3 would always fire first. ┬º3.6 also requires all five verdicts to\",\n    \"be individually testable, so the antonym test is moved to the front. Recorded in\",\n    \"STRUCTURE.md ┬º18.3 rather than silently reconciled.\",\n    \"\",\n    \"Invariant I3: similarity SELECTS candidates and is then discarded. Nothing here reads a\",\n    \"score, and there is no threshold constant in this file to tune.\",\n  ].join(\"\\n\");\n}\n\nexport type { DecisionId };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 44 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 44 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 44 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\retrieval\\citations.ts"},"span":[3444,3458],"sourceCode":"/**\n * Citation expansion ΓÇö 3.9.\n *\n * Phase 3 ┬╖ sub-phase 3.9\n * Plan: plan/phase-3-retrieval.md ┬º3.9\n *\n * ---------------------------------------------------------------------------\n * A CITATION IS AN ARGUMENT, NOT A LINK\n *\n * Every competitor can render \"Source: ADR-0012, 3 Oct\". That is a link. What WhyLog\n * renders is:\n *\n *   WLD-0007 ┬╖ Use SQLite, not Postgres ┬╖ IN\n *     rests on   P-0002 \"single-user desktop app\" (IN)\n *                P-0005 \"no deployment budget\" (IN)\n *     excludes   P-0009 \"concurrent writers\" (OUT)\n *     rejected   postgres ΓÇö \"needs a server process we cannot run\"\n *     guards     1 of 2 passing\n *     provenance transcript T-0001, decided 2026-10-03, learned 2026-10-03, local engine\n *\n * Showing \"rests on P-0002 (IN)\" is qualitatively different from showing a source link, and\n * no competitor can display it because no competitor stores it. The `given` is the product;\n * the citation is where the user goes to check it.\n *\n * ---------------------------------------------------------------------------\n * LABELS ARE LIVE, NOT COPIED\n *\n * The label shown next to each premise is the CURRENT labelled state, taken from the\n * labeller's map, not the value stored on the premise when it was extracted. A citation\n * expansion that showed a stale label would say \"rests on P-0005 (IN)\" for a premise the log\n * has since falsified ΓÇö which is precisely the sentence that must never be printed, because\n * it is the sentence that makes the whole premise mechanism look decorative.\n *\n * Falling back to `premise.label` only when the labeller has no entry for that node keeps a\n * citation renderable during a partial fold, and that case is reported rather than hidden.\n *\n * ---------------------------------------------------------------------------\n * GUARDS ARE COUNTED, NEVER GUESSED\n *\n * A guard that has never run is not passing. `guardsPassing` counts only guards whose\n * `lastRun.outcome === \"pass\"`, and `neverRun` reports the remainder separately, because\n * \"0 of 2 passing\" and \"2 of 2 never run\" are different facts and the first one reads like a\n * failure when the second is merely an absence of evidence. Phase 4 owns running them.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, EngineId } from \"@/types/common\";\nimport type { Decision, DecisionLabel, Premise } from \"@/types/domain\";\nimport type { ExpandedCitation } from \"@/types/retrieval\";\n\nexport interface ExpandedCitationResult extends ExpandedCitation {\n  /** Guards that exist but have never been run. Kept separate from `guardsPassing` so\n   *  \"0 of 2 passing\" is never printed when the truth is \"2 of 2 not yet run\". */\n  readonly guardsNeverRun: number;\n  /** Premises whose label came from the stored value because the labeller had no entry.\n   *  Nonzero means the expansion is showing a possibly stale label, and says so. */\n  readonly labelsFromFallback: number;\n}\n\n/**\n * Expand one citation into the full argument it stands for.\n *\n * Returns null when the decision does not exist in state ΓÇö which cannot happen for a\n * citation that resolved in this run, and is checked anyway because a citation rendered\n * against a deleted node would be the one silent failure this file exists to prevent.\n */\nexport function expandCitation(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: DecisionId,\n  engine: EngineId,\n): ExpandedCitationResult | null {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return null;\n\n  let fallbacks = 0;\n  const label = labels.get(decisionId)?.label ?? decision.label;\n\n  const restsOn: { premise: Premise; label: DecisionLabel }[] = [];\n  const excludes: { premise: Premise; label: DecisionLabel }[] = [];\n  const seenIn = new Set<string>();\n  const seenOut = new Set<string>();\n\n  /* Walk the decision's OWN justification ids rather than scanning every justification in\n   * the log for one whose consequent matches. Same result, O(justifications of this\n   * decision) instead of O(all justifications) ΓÇö and citation expansion happens per hit per\n   * answer, so this is on the hot path of the Ask view. */\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seenIn.has(premiseId)) continue;\n      seenIn.add(premiseId);\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n      const labelled = labels.get(premiseId);\n      if (labelled === undefined) fallbacks += 1;\n      restsOn.push({ premise, label: labelled?.label ?? premise.label });\n    }\n\n    for (const premiseId of justification.outList) {\n      if (seenOut.has(premiseId)) continue;\n      seenOut.add(premiseId);\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n      const labelled = labels.get(premiseId);\n      if (labelled === undefined) fallbacks += 1;\n      excludes.push({ premise, label: labelled?.label ?? premise.label });\n    }\n  }\n\n  const rejected: { value: string; whyRejected?: string }[] = [];\n  for (const alternativeId of decision.alternativeIds) {\n    const alternative = state.alternatives.get(alternativeId);\n    if (alternative === undefined) continue;\n    rejected.push(\n      alternative.whyRejected === undefined\n        ? { value: alternative.value }\n        : { value: alternative.value, whyRejected: alternative.whyRejected },\n    );\n  }\n\n  let guardsPassing = 0;\n  let guardsTotal = 0;\n  let guardsNeverRun = 0;\n  for (const guardId of decision.guardIds) {\n    const guard = state.guards.get(guardId);\n    if (guard === undefined) continue;\n    guardsTotal += 1;\n    if (guard.lifecycle === \"suppressed\") continue;\n    if (guard.lastRun === undefined) guardsNeverRun += 1;\n    else if (guard.lastRun.outcome === \"pass\") guardsPassing += 1;\n  }\n\n  return {\n    decision,\n    label,\n    restsOn,\n    excludes,\n    rejected,\n    guardsPassing,\n    guardsTotal,\n    guardsNeverRun,\n    labelsFromFallback: fallbacks,\n    snippet: decision.provenance.snippet,\n    decidedAt: decision.temporal.valid,\n    learnedAt: decision.temporal.learned,\n    engine: decision.provenance.extractedBy === engine ? engine : decision.provenance.extractedBy,\n  };\n}\n\n/** Expand every citation in an answer, in claim order. Unresolvable ids are dropped here and\n *  counted by the caller ΓÇö the evidence contract already recorded them as unresolved. */\nexport function expandAll(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  ids: readonly DecisionId[],\n  engine: EngineId,\n): { expanded: readonly ExpandedCitationResult[]; missing: readonly DecisionId[] } {\n  const expanded: ExpandedCitationResult[] = [];\n  const missing: DecisionId[] = [];\n  const seen = new Set<DecisionId>();\n\n  for (const id of ids) {\n    if (seen.has(id)) continue;\n    seen.add(id);\n    const result = expandCitation(state, labels, id, engine);\n    if (result === null) missing.push(id);\n    else expanded.push(result);\n  }\n\n  return { expanded, missing };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The expansion as the user reads it.\n *\n * Order is deliberate: what was decided, what it rests on, what it excludes, what was\n * rejected, whether anything checks it, where it came from. A reader who stops after the\n * second line still has the decision and its premises ΓÇö the two things that matter most.\n */\nexport function renderExpansion(expanded: ExpandedCitationResult): string {\n  const lines: string[] = [];\n  const decision = expanded.decision;\n\n  lines.push(\n    `${decision.id} ┬╖ ${decision.statement} ┬╖ ${expanded.label}${decision.status === \"contested\" ? \" (CONTESTED ΓÇö a human call is pending)\" : \"\"}`,\n  );\n\n  if (expanded.restsOn.length === 0) {\n    lines.push(\n      \"  rests on   ΓÇö nothing recorded. This decision has no stated premises, so there is nothing to check it against.\",\n    );\n  } else {\n    lines.push(\n      `  rests on   ${expanded.restsOn.map((entry) => `${entry.premise.id} \"${entry.premise.text}\" (${entry.label})`).join(\"; \")}`,\n    );\n  }\n\n  if (expanded.excludes.length > 0) {\n    lines.push(\n      `  excludes   ${expanded.excludes.map((entry) => `${entry.premise.id} \"${entry.premise.text}\" (${entry.label})`).join(\"; \")}`,\n    );\n    lines.push(\n      \"             If any excluded condition becomes true, this decision is invalidated. That is gate (c).\",\n    );\n  }\n\n  if (expanded.rejected.length > 0) {\n    lines.push(\n      `  rejected   ${expanded.rejected\n        .map(\n          (entry) =>\n            entry.value +\n            (entry.whyRejected === undefined\n              ? \" (no reason recorded)\"\n              : ` ΓÇö \"${entry.whyRejected}\"`),\n        )\n        .join(\"; \")}`,\n    );\n  }\n\n  if (expanded.guardsTotal === 0) {\n    lines.push(\"  guards     none. Nothing automatically checks whether this still holds.\");\n  } else {\n    const neverRun = expanded.guardsNeverRun > 0 ? `, ${expanded.guardsNeverRun} never run` : \"\";\n    lines.push(\n      `  guards     ${expanded.guardsPassing} of ${expanded.guardsTotal} passing${neverRun}.`,\n    );\n  }\n\n  lines.push(\n    `  provenance ${expanded.snippet.transcriptId}, decided ${expanded.decidedAt.slice(0, 10)}, learned ${expanded.learnedAt.slice(0, 10)}, extracted by ${expanded.engine}.`,\n  );\n\n  if (expanded.labelsFromFallback > 0) {\n    lines.push(\n      `  note       ${expanded.labelsFromFallback} premise label(s) came from the stored value because the labeller had no entry for them ΓÇö treat those labels as possibly stale.`,\n    );\n  }\n\n  return lines.join(\"\\n\");\n}\n\n/** One-line form for inline citation markers: \"[WLD-0007 ┬╖ rests on P-0002 (IN), P-0005 (IN)]\". */\nexport function renderInline(expanded: ExpandedCitationResult): string {\n  const premises =\n    expanded.restsOn.length === 0\n      ? \"no premises recorded\"\n      : `rests on ${expanded.restsOn.map((entry) => `${entry.premise.id} (${entry.label})`).join(\", \")}`;\n\n  return `[${expanded.decision.id} ┬╖ ${premises}]`;\n}\n\nexport type { Decision, Premise };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 32 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 32 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 32 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\reasoning\\labeller.ts"},"span":[4426,4431],"sourceCode":"/**\n * The JTMS labeller ΓÇö 2.2.\n *\n * Phase 2 ┬╖ sub-phase 2.2\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.2\n * Research: docs/02 ┬º2 (Doyle 1979), ┬º3 (validity + well-foundedness)\n *\n * ---------------------------------------------------------------------------\n * THE RULE\n *\n * A node is IN iff at least one of its justifications is VALID, and a justification\n * is valid iff **every node in its IN-list is IN and no node in its OUT-list is IN**.\n *\n * That second clause is the whole product. A justification with a non-empty OUT-list\n * is Doyle's NON-MONOTONIC justification, and it is what lets WhyLog notice that a\n * decision stopped being true when nobody contradicted anything: the world satisfied\n * an excluded condition, the justification became invalid, and the decision lost its\n * support.\n *\n * ---------------------------------------------------------------------------\n * WHY WELL-FOUNDEDNESS IS CHECKED AND NOT ASSUMED\n *\n * Doyle's own words: it is \"imprudentΓÇª nodes believed on tenuous circular bases lead\n * to ill-considered actions.\" A justification graph may legally contain G ΓçÆ H ΓçÆ G,\n * and a naive fixpoint labels both IN forever. An LLM extractor WILL produce this ΓÇö\n * it recovers \"we chose X because Y\" and \"we chose Y because X\" from the same\n * conversation without noticing.\n *\n * So a node whose support never reaches a premise is labelled **UNFOUNDED**, which is\n * a data-quality warning and NOT a truth claim. It is never silently IN, because a\n * circularly-supported decision that reads as sound is worse than one that reads as\n * broken: the broken one gets fixed.\n *\n * ---------------------------------------------------------------------------\n * THIS MODULE IS PURE\n *\n * It reads a `GraphState` and returns a label map. It writes nothing and appends no\n * events ΓÇö `revise.ts` decides what to record. A labeller with side effects cannot\n * be iterated to a fixpoint, and cannot be run speculatively to answer \"what would\n * happen if this premise died?\", which is what the proposal preview needs.\n * ---------------------------------------------------------------------------\n */\n\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, JustificationId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport type { Justification } from \"@/types/domain\";\n\nexport type NodeId = DecisionId | PremiseId | JustificationId;\n\n/** A label plus the reason for it. The reason is not decoration: the review UI\n *  shows WHY a node is OUT, naming the specific premise that failed, because\n *  \"unsound\" without a cause is not actionable. */\nexport interface Labelled {\n  readonly label: DecisionLabel;\n  readonly reason: LabelReason;\n}\n\nexport type LabelReason =\n  | { readonly kind: \"valid-justification\"; readonly justificationId: JustificationId }\n  | { readonly kind: \"all-justifications-invalid\"; readonly failedPremiseId: PremiseId | null }\n  | { readonly kind: \"no-justification\" }\n  | { readonly kind: \"circular\"; readonly cycle: readonly NodeId[] }\n  | { readonly kind: \"unfounded\"; readonly reachedOnly: readonly NodeId[] }\n  | { readonly kind: \"asserted-premise\" }\n  | { readonly kind: \"unconfirmed-premise\" }\n  | { readonly kind: \"invalidated\"; readonly at: string };\n\nexport interface LabellingResult {\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  /** Decisions whose label CHANGED against the state that was passed in. This is\n   *  what `revise.ts` turns into `LabelChanged` events, and what makes the audit\n   *  trail per-flip rather than per-run. */\n  readonly changed: readonly {\n    readonly id: DecisionId;\n    readonly from: DecisionLabel;\n    readonly to: DecisionLabel;\n    readonly reason: LabelReason;\n  }[];\n  readonly iterations: number;\n  readonly unfounded: readonly DecisionId[];\n  readonly fixpointReached: boolean;\n}\n\n/** Hard ceiling on fixpoint iterations. The graph is shallow ΓÇö depth rarely exceeds\n *  4 ΓÇö so a label propagation that has not settled in this many passes is cycling,\n *  and cycling is a bug worth surfacing rather than hiding behind a spin. */\nexport const MAX_ITERATIONS = 64;\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function label(state: GraphState): LabellingResult {\n  const labels = new Map<NodeId, Labelled>();\n\n  /* ---- premises are the foundation: they are IN by assertion, not by argument ---- */\n  for (const premise of state.premises.values()) {\n    if (premise.temporal.invalidFrom !== undefined) {\n      labels.set(premise.id, {\n        label: \"OUT\",\n        reason: { kind: \"invalidated\", at: premise.temporal.invalidFrom },\n      });\n      continue;\n    }\n    labels.set(premise.id, {\n      label: premise.label === \"UNKNOWN\" ? \"UNKNOWN\" : premise.label,\n      reason:\n        premise.label === \"UNKNOWN\"\n          ? { kind: \"unconfirmed-premise\" }\n          : { kind: \"asserted-premise\" },\n    });\n  }\n\n  /* ---- decisions start from their stored label and are corrected below ---- */\n  for (const decision of state.decisions.values()) {\n    labels.set(decision.id, { label: decision.label, reason: { kind: \"no-justification\" } });\n  }\n\n  /* ---- well-foundedness first: a circular node can never become IN, and\n         letting the fixpoint see it as a candidate would propagate the cycle ---- */\n  const founded = wellFoundedness(state);\n  for (const [id, problem] of founded.problems) {\n    labels.set(id, {\n      label: \"UNFOUNDED\",\n      reason:\n        problem.kind === \"circular\"\n          ? { kind: \"circular\", cycle: problem.cycle }\n          : { kind: \"unfounded\", reachedOnly: problem.reachedOnly },\n    });\n  }\n\n  /* ---- fixpoint ---- */\n  let iterations = 0;\n  let dirty = true;\n\n  while (dirty && iterations < MAX_ITERATIONS) {\n    dirty = false;\n    iterations += 1;\n\n    for (const decision of state.decisions.values()) {\n      // An UNFOUNDED label is a statement about the SHAPE of the support graph, and\n      // no amount of relabelling its neighbours changes that shape. Overwriting it\n      // here would let a circular decision flicker back to IN on the next pass.\n      if (labels.get(decision.id)?.label === \"UNFOUNDED\") continue;\n      if (decision.status === \"superseded\" || decision.status === \"archived\") continue;\n\n      const next = labelDecision(decision.id, decision.justificationIds, state, labels);\n      const previous = labels.get(decision.id);\n      if (previous === undefined || previous.label !== next.label) {\n        labels.set(decision.id, next);\n        dirty = true;\n      }\n    }\n  }\n\n  /* ---- diff against the stored labels ---- */\n  const changed: LabellingResult[\"changed\"][number][] = [];\n  for (const decision of state.decisions.values()) {\n    const next = labels.get(decision.id);\n    if (next === undefined) continue;\n    if (next.label === decision.label) continue;\n    changed.push({ id: decision.id, from: decision.label, to: next.label, reason: next.reason });\n  }\n\n  const unfounded: DecisionId[] = [];\n  for (const id of founded.problems.keys()) unfounded.push(id as DecisionId);\n\n  return { labels, changed, iterations, unfounded, fixpointReached: !dirty };\n}\n\n/* -------------------------------------------------------------------------- */\n/* One decision                                                               */\n/* -------------------------------------------------------------------------- */\n\nfunction labelDecision(\n  _id: DecisionId,\n  justificationIds: readonly JustificationId[],\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): Labelled {\n  if (justificationIds.length === 0) {\n    // A decision with no justification is not unsound, it is UNVERIFIED. Calling it\n    // OUT would retract every manually recorded decision in the log, and calling it\n    // IN would assert something nothing supports.\n    return { label: \"UNKNOWN\", reason: { kind: \"no-justification\" } };\n  }\n\n  let firstFailure: PremiseId | null = null;\n\n  for (const justificationId of justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    const verdict = validityOf(justification, labels);\n    if (verdict.valid)\n      return { label: \"IN\", reason: { kind: \"valid-justification\", justificationId } };\n    if (firstFailure === null) firstFailure = verdict.failedNode;\n  }\n\n  return {\n    label: \"OUT\",\n    reason: { kind: \"all-justifications-invalid\", failedPremiseId: firstFailure },\n  };\n}\n\nexport interface ValidityVerdict {\n  readonly valid: boolean;\n  /** The specific node that broke it ΓÇö an IN-list member that is not IN, or an\n   *  OUT-list member that IS. Naming it is what makes the failure actionable. */\n  readonly failedNode: PremiseId | null;\n  readonly failedClause: \"in-list\" | \"out-list\" | null;\n  readonly explanation: string;\n}\n\n/**\n * Doyle's SL-justification validity, evaluated against a label map.\n *\n * Exported on its own because gate (c) needs it to say WHICH CLAUSE broke: an\n * IN-list failure means a supporting premise died, an OUT-list failure means an\n * excluded condition arrived. They read completely differently to a user and they\n * imply different revisions, but they invalidate the justification identically.\n */\nexport function validityOf(\n  justification: Justification,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): ValidityVerdict {\n  for (const premiseId of justification.inList) {\n    const entry = labels.get(premiseId);\n    if (entry === undefined || entry.label !== \"IN\") {\n      return {\n        valid: false,\n        failedNode: premiseId,\n        failedClause: \"in-list\",\n        explanation: `${justification.id} requires ${premiseId} to hold, and it is ${entry?.label ?? \"missing from the graph\"}.`,\n      };\n    }\n  }\n\n  for (const premiseId of justification.outList) {\n    const entry = labels.get(premiseId);\n    if (entry !== undefined && entry.label === \"IN\") {\n      return {\n        valid: false,\n        failedNode: premiseId,\n        failedClause: \"out-list\",\n        explanation: `${justification.id} excludes ${premiseId}, and it now holds. Nothing was contradicted ΓÇö the world moved.`,\n      };\n    }\n  }\n\n  return {\n    valid: true,\n    failedNode: null,\n    failedClause: null,\n    explanation: `${justification.id} is valid.`,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Well-foundedness                                                           */\n/* -------------------------------------------------------------------------- */\n\nexport type FoundingProblem =\n  | { readonly kind: \"circular\"; readonly cycle: readonly NodeId[] }\n  | { readonly kind: \"unfounded\"; readonly reachedOnly: readonly NodeId[] };\n\nexport interface WellFoundedness {\n  readonly problems: ReadonlyMap<DecisionId, FoundingProblem>;\n  readonly checked: number;\n}\n\n/**\n * Does every decision's support chain bottom out in a PREMISE?\n *\n * A premise is an assumption: it is IN because somebody observed it, not because\n * something else argued for it. A decision whose support only ever reaches other\n * decisions is believed on an argument with no ground, and Doyle's warning applies\n * directly.\n *\n * Depth-bounded, because the same traversal on a pathological graph could otherwise\n * run for as long as the graph is deep.\n */\nexport function wellFoundedness(state: GraphState): WellFoundedness {\n  const problems = new Map<DecisionId, FoundingProblem>();\n  const grounded = new Set<DecisionId>();\n\n  for (const decision of state.decisions.values()) {\n    if (decision.justificationIds.length === 0) continue;\n    if (problems.has(decision.id) || grounded.has(decision.id)) continue;\n\n    const path: NodeId[] = [];\n    const onPath = new Set<NodeId>();\n    const result = walk(decision.id, state, path, onPath, grounded, 0);\n\n    if (result.kind === \"grounded\") grounded.add(decision.id);\n    else problems.set(decision.id, result.problem);\n  }\n\n  return { problems, checked: state.decisions.size };\n}\n\nconst FOUNDING_DEPTH_CAP = 12;\n\ntype WalkResult =\n  | { readonly kind: \"grounded\" }\n  | { readonly kind: \"problem\"; readonly problem: FoundingProblem };\n\nfunction walk(\n  node: NodeId,\n  state: GraphState,\n  path: NodeId[],\n  onPath: Set<NodeId>,\n  grounded: ReadonlySet<DecisionId>,\n  depth: number,\n): WalkResult {\n  // A premise IS the ground. Reaching one means the chain is founded.\n  if (state.premises.has(node as PremiseId)) return { kind: \"grounded\" };\n\n  if (onPath.has(node)) {\n    const start = path.indexOf(node);\n    return { kind: \"problem\", problem: { kind: \"circular\", cycle: [...path.slice(start), node] } };\n  }\n  if (depth >= FOUNDING_DEPTH_CAP) {\n    return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path] } };\n  }\n  if (grounded.has(node as DecisionId)) return { kind: \"grounded\" };\n\n  const decision = state.decisions.get(node as DecisionId);\n  if (decision === undefined)\n    return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path] } };\n  if (decision.justificationIds.length === 0) {\n    // No justification and not a premise: nothing grounds it.\n    return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path, node] } };\n  }\n\n  path.push(node);\n  onPath.add(node);\n\n  let sawAny = false;\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    // An OUT-list member does not ground anything: it is a condition that must NOT\n    // hold, so reaching one is not evidence for the decision.\n    for (const antecedent of justification.inList) {\n      sawAny = true;\n      const result = walk(antecedent, state, path, onPath, grounded, depth + 1);\n      if (result.kind === \"grounded\") {\n        path.pop();\n        onPath.delete(node);\n        return { kind: \"grounded\" };\n      }\n      if (result.problem.kind === \"circular\") {\n        path.pop();\n        onPath.delete(node);\n        return result;\n      }\n    }\n  }\n\n  path.pop();\n  onPath.delete(node);\n\n  if (!sawAny) return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [node] } };\n  return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path, node] } };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport const LABEL_MEANING: Readonly<Record<DecisionLabel, string>> = {\n  IN: \"Sound ΓÇö at least one justification is valid and well-founded\",\n  OUT: \"Unsound ΓÇö every justification is invalid\",\n  UNKNOWN: \"Unverified ΓÇö nothing has confirmed or refuted the premises\",\n  UNFOUNDED:\n    \"Unfounded ΓÇö the support chain is circular or never reaches a premise. A data-quality warning, not a truth claim\",\n};\n\nexport function describeReason(reason: LabelReason, state: GraphState): string {\n  switch (reason.kind) {\n    case \"valid-justification\":\n      return `${reason.justificationId} is valid: every premise it requires holds and nothing it excludes does.`;\n    case \"all-justifications-invalid\":\n      return reason.failedPremiseId === null\n        ? \"Every justification is invalid.\"\n        : `Every justification is invalid. The first to fail did so on ${reason.failedPremiseId} ΓÇö \"${state.premises.get(reason.failedPremiseId)?.text ?? \"unknown premise\"}\".`;\n    case \"no-justification\":\n      return \"No justification is attached, so nothing supports it and nothing refutes it.\";\n    case \"circular\":\n      return `Circular support: ${reason.cycle.join(\" ΓåÆ \")}. Believed on an argument with no ground.`;\n    case \"unfounded\":\n      return `The support chain never reaches a premise (reached: ${reason.reachedOnly.join(\", \") || \"nothing\"}).`;\n    case \"asserted-premise\":\n      return \"Asserted as a premise.\";\n    case \"unconfirmed-premise\":\n      return \"Neither confirmed nor refuted.\";\n    case \"invalidated\":\n      return `Invalidated at ${reason.at}.`;\n  }\n}\n\nexport function describeLabelling(result: LabellingResult): string {\n  const parts = [\n    `${result.labels.size} nodes labelled in ${result.iterations} iteration${result.iterations === 1 ? \"\" : \"s\"}`,\n  ];\n  if (!result.fixpointReached) {\n    parts.push(\n      `DID NOT REACH A FIXPOINT within ${MAX_ITERATIONS} iterations ΓÇö this is a bug, not a graph property`,\n    );\n  }\n  if (result.changed.length > 0) {\n    parts.push(`${result.changed.length} label${result.changed.length === 1 ? \"\" : \"s\"} changed`);\n  }\n  if (result.unfounded.length > 0) {\n    parts.push(`${result.unfounded.length} UNFOUNDED ΓÇö circular or groundless support`);\n  }\n  return parts.join(\" ┬╖ \");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 18 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 18 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 18 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\reasoning\\labeller.ts"},"span":[12327,12331],"sourceCode":"/**\n * The JTMS labeller ΓÇö 2.2.\n *\n * Phase 2 ┬╖ sub-phase 2.2\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.2\n * Research: docs/02 ┬º2 (Doyle 1979), ┬º3 (validity + well-foundedness)\n *\n * ---------------------------------------------------------------------------\n * THE RULE\n *\n * A node is IN iff at least one of its justifications is VALID, and a justification\n * is valid iff **every node in its IN-list is IN and no node in its OUT-list is IN**.\n *\n * That second clause is the whole product. A justification with a non-empty OUT-list\n * is Doyle's NON-MONOTONIC justification, and it is what lets WhyLog notice that a\n * decision stopped being true when nobody contradicted anything: the world satisfied\n * an excluded condition, the justification became invalid, and the decision lost its\n * support.\n *\n * ---------------------------------------------------------------------------\n * WHY WELL-FOUNDEDNESS IS CHECKED AND NOT ASSUMED\n *\n * Doyle's own words: it is \"imprudentΓÇª nodes believed on tenuous circular bases lead\n * to ill-considered actions.\" A justification graph may legally contain G ΓçÆ H ΓçÆ G,\n * and a naive fixpoint labels both IN forever. An LLM extractor WILL produce this ΓÇö\n * it recovers \"we chose X because Y\" and \"we chose Y because X\" from the same\n * conversation without noticing.\n *\n * So a node whose support never reaches a premise is labelled **UNFOUNDED**, which is\n * a data-quality warning and NOT a truth claim. It is never silently IN, because a\n * circularly-supported decision that reads as sound is worse than one that reads as\n * broken: the broken one gets fixed.\n *\n * ---------------------------------------------------------------------------\n * THIS MODULE IS PURE\n *\n * It reads a `GraphState` and returns a label map. It writes nothing and appends no\n * events ΓÇö `revise.ts` decides what to record. A labeller with side effects cannot\n * be iterated to a fixpoint, and cannot be run speculatively to answer \"what would\n * happen if this premise died?\", which is what the proposal preview needs.\n * ---------------------------------------------------------------------------\n */\n\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, JustificationId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport type { Justification } from \"@/types/domain\";\n\nexport type NodeId = DecisionId | PremiseId | JustificationId;\n\n/** A label plus the reason for it. The reason is not decoration: the review UI\n *  shows WHY a node is OUT, naming the specific premise that failed, because\n *  \"unsound\" without a cause is not actionable. */\nexport interface Labelled {\n  readonly label: DecisionLabel;\n  readonly reason: LabelReason;\n}\n\nexport type LabelReason =\n  | { readonly kind: \"valid-justification\"; readonly justificationId: JustificationId }\n  | { readonly kind: \"all-justifications-invalid\"; readonly failedPremiseId: PremiseId | null }\n  | { readonly kind: \"no-justification\" }\n  | { readonly kind: \"circular\"; readonly cycle: readonly NodeId[] }\n  | { readonly kind: \"unfounded\"; readonly reachedOnly: readonly NodeId[] }\n  | { readonly kind: \"asserted-premise\" }\n  | { readonly kind: \"unconfirmed-premise\" }\n  | { readonly kind: \"invalidated\"; readonly at: string };\n\nexport interface LabellingResult {\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  /** Decisions whose label CHANGED against the state that was passed in. This is\n   *  what `revise.ts` turns into `LabelChanged` events, and what makes the audit\n   *  trail per-flip rather than per-run. */\n  readonly changed: readonly {\n    readonly id: DecisionId;\n    readonly from: DecisionLabel;\n    readonly to: DecisionLabel;\n    readonly reason: LabelReason;\n  }[];\n  readonly iterations: number;\n  readonly unfounded: readonly DecisionId[];\n  readonly fixpointReached: boolean;\n}\n\n/** Hard ceiling on fixpoint iterations. The graph is shallow ΓÇö depth rarely exceeds\n *  4 ΓÇö so a label propagation that has not settled in this many passes is cycling,\n *  and cycling is a bug worth surfacing rather than hiding behind a spin. */\nexport const MAX_ITERATIONS = 64;\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function label(state: GraphState): LabellingResult {\n  const labels = new Map<NodeId, Labelled>();\n\n  /* ---- premises are the foundation: they are IN by assertion, not by argument ---- */\n  for (const premise of state.premises.values()) {\n    if (premise.temporal.invalidFrom !== undefined) {\n      labels.set(premise.id, {\n        label: \"OUT\",\n        reason: { kind: \"invalidated\", at: premise.temporal.invalidFrom },\n      });\n      continue;\n    }\n    labels.set(premise.id, {\n      label: premise.label === \"UNKNOWN\" ? \"UNKNOWN\" : premise.label,\n      reason:\n        premise.label === \"UNKNOWN\"\n          ? { kind: \"unconfirmed-premise\" }\n          : { kind: \"asserted-premise\" },\n    });\n  }\n\n  /* ---- decisions start from their stored label and are corrected below ---- */\n  for (const decision of state.decisions.values()) {\n    labels.set(decision.id, { label: decision.label, reason: { kind: \"no-justification\" } });\n  }\n\n  /* ---- well-foundedness first: a circular node can never become IN, and\n         letting the fixpoint see it as a candidate would propagate the cycle ---- */\n  const founded = wellFoundedness(state);\n  for (const [id, problem] of founded.problems) {\n    labels.set(id, {\n      label: \"UNFOUNDED\",\n      reason:\n        problem.kind === \"circular\"\n          ? { kind: \"circular\", cycle: problem.cycle }\n          : { kind: \"unfounded\", reachedOnly: problem.reachedOnly },\n    });\n  }\n\n  /* ---- fixpoint ---- */\n  let iterations = 0;\n  let dirty = true;\n\n  while (dirty && iterations < MAX_ITERATIONS) {\n    dirty = false;\n    iterations += 1;\n\n    for (const decision of state.decisions.values()) {\n      // An UNFOUNDED label is a statement about the SHAPE of the support graph, and\n      // no amount of relabelling its neighbours changes that shape. Overwriting it\n      // here would let a circular decision flicker back to IN on the next pass.\n      if (labels.get(decision.id)?.label === \"UNFOUNDED\") continue;\n      if (decision.status === \"superseded\" || decision.status === \"archived\") continue;\n\n      const next = labelDecision(decision.id, decision.justificationIds, state, labels);\n      const previous = labels.get(decision.id);\n      if (previous === undefined || previous.label !== next.label) {\n        labels.set(decision.id, next);\n        dirty = true;\n      }\n    }\n  }\n\n  /* ---- diff against the stored labels ---- */\n  const changed: LabellingResult[\"changed\"][number][] = [];\n  for (const decision of state.decisions.values()) {\n    const next = labels.get(decision.id);\n    if (next === undefined) continue;\n    if (next.label === decision.label) continue;\n    changed.push({ id: decision.id, from: decision.label, to: next.label, reason: next.reason });\n  }\n\n  const unfounded: DecisionId[] = [];\n  for (const id of founded.problems.keys()) unfounded.push(id as DecisionId);\n\n  return { labels, changed, iterations, unfounded, fixpointReached: !dirty };\n}\n\n/* -------------------------------------------------------------------------- */\n/* One decision                                                               */\n/* -------------------------------------------------------------------------- */\n\nfunction labelDecision(\n  _id: DecisionId,\n  justificationIds: readonly JustificationId[],\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): Labelled {\n  if (justificationIds.length === 0) {\n    // A decision with no justification is not unsound, it is UNVERIFIED. Calling it\n    // OUT would retract every manually recorded decision in the log, and calling it\n    // IN would assert something nothing supports.\n    return { label: \"UNKNOWN\", reason: { kind: \"no-justification\" } };\n  }\n\n  let firstFailure: PremiseId | null = null;\n\n  for (const justificationId of justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    const verdict = validityOf(justification, labels);\n    if (verdict.valid)\n      return { label: \"IN\", reason: { kind: \"valid-justification\", justificationId } };\n    if (firstFailure === null) firstFailure = verdict.failedNode;\n  }\n\n  return {\n    label: \"OUT\",\n    reason: { kind: \"all-justifications-invalid\", failedPremiseId: firstFailure },\n  };\n}\n\nexport interface ValidityVerdict {\n  readonly valid: boolean;\n  /** The specific node that broke it ΓÇö an IN-list member that is not IN, or an\n   *  OUT-list member that IS. Naming it is what makes the failure actionable. */\n  readonly failedNode: PremiseId | null;\n  readonly failedClause: \"in-list\" | \"out-list\" | null;\n  readonly explanation: string;\n}\n\n/**\n * Doyle's SL-justification validity, evaluated against a label map.\n *\n * Exported on its own because gate (c) needs it to say WHICH CLAUSE broke: an\n * IN-list failure means a supporting premise died, an OUT-list failure means an\n * excluded condition arrived. They read completely differently to a user and they\n * imply different revisions, but they invalidate the justification identically.\n */\nexport function validityOf(\n  justification: Justification,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): ValidityVerdict {\n  for (const premiseId of justification.inList) {\n    const entry = labels.get(premiseId);\n    if (entry === undefined || entry.label !== \"IN\") {\n      return {\n        valid: false,\n        failedNode: premiseId,\n        failedClause: \"in-list\",\n        explanation: `${justification.id} requires ${premiseId} to hold, and it is ${entry?.label ?? \"missing from the graph\"}.`,\n      };\n    }\n  }\n\n  for (const premiseId of justification.outList) {\n    const entry = labels.get(premiseId);\n    if (entry !== undefined && entry.label === \"IN\") {\n      return {\n        valid: false,\n        failedNode: premiseId,\n        failedClause: \"out-list\",\n        explanation: `${justification.id} excludes ${premiseId}, and it now holds. Nothing was contradicted ΓÇö the world moved.`,\n      };\n    }\n  }\n\n  return {\n    valid: true,\n    failedNode: null,\n    failedClause: null,\n    explanation: `${justification.id} is valid.`,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Well-foundedness                                                           */\n/* -------------------------------------------------------------------------- */\n\nexport type FoundingProblem =\n  | { readonly kind: \"circular\"; readonly cycle: readonly NodeId[] }\n  | { readonly kind: \"unfounded\"; readonly reachedOnly: readonly NodeId[] };\n\nexport interface WellFoundedness {\n  readonly problems: ReadonlyMap<DecisionId, FoundingProblem>;\n  readonly checked: number;\n}\n\n/**\n * Does every decision's support chain bottom out in a PREMISE?\n *\n * A premise is an assumption: it is IN because somebody observed it, not because\n * something else argued for it. A decision whose support only ever reaches other\n * decisions is believed on an argument with no ground, and Doyle's warning applies\n * directly.\n *\n * Depth-bounded, because the same traversal on a pathological graph could otherwise\n * run for as long as the graph is deep.\n */\nexport function wellFoundedness(state: GraphState): WellFoundedness {\n  const problems = new Map<DecisionId, FoundingProblem>();\n  const grounded = new Set<DecisionId>();\n\n  for (const decision of state.decisions.values()) {\n    if (decision.justificationIds.length === 0) continue;\n    if (problems.has(decision.id) || grounded.has(decision.id)) continue;\n\n    const path: NodeId[] = [];\n    const onPath = new Set<NodeId>();\n    const result = walk(decision.id, state, path, onPath, grounded, 0);\n\n    if (result.kind === \"grounded\") grounded.add(decision.id);\n    else problems.set(decision.id, result.problem);\n  }\n\n  return { problems, checked: state.decisions.size };\n}\n\nconst FOUNDING_DEPTH_CAP = 12;\n\ntype WalkResult =\n  | { readonly kind: \"grounded\" }\n  | { readonly kind: \"problem\"; readonly problem: FoundingProblem };\n\nfunction walk(\n  node: NodeId,\n  state: GraphState,\n  path: NodeId[],\n  onPath: Set<NodeId>,\n  grounded: ReadonlySet<DecisionId>,\n  depth: number,\n): WalkResult {\n  // A premise IS the ground. Reaching one means the chain is founded.\n  if (state.premises.has(node as PremiseId)) return { kind: \"grounded\" };\n\n  if (onPath.has(node)) {\n    const start = path.indexOf(node);\n    return { kind: \"problem\", problem: { kind: \"circular\", cycle: [...path.slice(start), node] } };\n  }\n  if (depth >= FOUNDING_DEPTH_CAP) {\n    return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path] } };\n  }\n  if (grounded.has(node as DecisionId)) return { kind: \"grounded\" };\n\n  const decision = state.decisions.get(node as DecisionId);\n  if (decision === undefined)\n    return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path] } };\n  if (decision.justificationIds.length === 0) {\n    // No justification and not a premise: nothing grounds it.\n    return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path, node] } };\n  }\n\n  path.push(node);\n  onPath.add(node);\n\n  let sawAny = false;\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    // An OUT-list member does not ground anything: it is a condition that must NOT\n    // hold, so reaching one is not evidence for the decision.\n    for (const antecedent of justification.inList) {\n      sawAny = true;\n      const result = walk(antecedent, state, path, onPath, grounded, depth + 1);\n      if (result.kind === \"grounded\") {\n        path.pop();\n        onPath.delete(node);\n        return { kind: \"grounded\" };\n      }\n      if (result.problem.kind === \"circular\") {\n        path.pop();\n        onPath.delete(node);\n        return result;\n      }\n    }\n  }\n\n  path.pop();\n  onPath.delete(node);\n\n  if (!sawAny) return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [node] } };\n  return { kind: \"problem\", problem: { kind: \"unfounded\", reachedOnly: [...path, node] } };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport const LABEL_MEANING: Readonly<Record<DecisionLabel, string>> = {\n  IN: \"Sound ΓÇö at least one justification is valid and well-founded\",\n  OUT: \"Unsound ΓÇö every justification is invalid\",\n  UNKNOWN: \"Unverified ΓÇö nothing has confirmed or refuted the premises\",\n  UNFOUNDED:\n    \"Unfounded ΓÇö the support chain is circular or never reaches a premise. A data-quality warning, not a truth claim\",\n};\n\nexport function describeReason(reason: LabelReason, state: GraphState): string {\n  switch (reason.kind) {\n    case \"valid-justification\":\n      return `${reason.justificationId} is valid: every premise it requires holds and nothing it excludes does.`;\n    case \"all-justifications-invalid\":\n      return reason.failedPremiseId === null\n        ? \"Every justification is invalid.\"\n        : `Every justification is invalid. The first to fail did so on ${reason.failedPremiseId} ΓÇö \"${state.premises.get(reason.failedPremiseId)?.text ?? \"unknown premise\"}\".`;\n    case \"no-justification\":\n      return \"No justification is attached, so nothing supports it and nothing refutes it.\";\n    case \"circular\":\n      return `Circular support: ${reason.cycle.join(\" ΓåÆ \")}. Believed on an argument with no ground.`;\n    case \"unfounded\":\n      return `The support chain never reaches a premise (reached: ${reason.reachedOnly.join(\", \") || \"nothing\"}).`;\n    case \"asserted-premise\":\n      return \"Asserted as a premise.\";\n    case \"unconfirmed-premise\":\n      return \"Neither confirmed nor refuted.\";\n    case \"invalidated\":\n      return `Invalidated at ${reason.at}.`;\n  }\n}\n\nexport function describeLabelling(result: LabellingResult): string {\n  const parts = [\n    `${result.labels.size} nodes labelled in ${result.iterations} iteration${result.iterations === 1 ? \"\" : \"s\"}`,\n  ];\n  if (!result.fixpointReached) {\n    parts.push(\n      `DID NOT REACH A FIXPOINT within ${MAX_ITERATIONS} iterations ΓÇö this is a bug, not a graph property`,\n    );\n  }\n  if (result.changed.length > 0) {\n    parts.push(`${result.changed.length} label${result.changed.length === 1 ? \"\" : \"s\"} changed`);\n  }\n  if (result.unfounded.length > 0) {\n    parts.push(`${result.unfounded.length} UNFOUNDED ΓÇö circular or groundless support`);\n  }\n  return parts.join(\" ┬╖ \");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 20 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 20 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 20 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\reasoning\\proposals.ts"},"span":[9258,9276],"sourceCode":"/**\n * Revision proposals ΓÇö 2.9.\n *\n * Phase 2 ┬╖ sub-phase 2.9\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.9\n * Docs: docs/02-truth-maintenance-theory.md ┬º4\n *\n * ---------------------------------------------------------------------------\n * SEVEN PARTS, EVERY TIME\n *\n * A proposal that says \"WLD-0001 may be invalid\" is a notification. A proposal that\n * says what failed, what the evidence was, what cannot both hold, what else falls with\n * it, how costly it is to change, what you can do about it, and why the system did not\n * just do it ΓÇö is a diagnosis.\n *\n *   1. WHAT FAILED          the decision and the premise that broke under it\n *   2. THE EVIDENCE         the verbatim quote, its span, its source, its confidence\n *   3. THE NOGOOD           the conjunction that cannot hold\n *   4. THE CASCADE          what else became unsound, and what survived and why\n *   5. ENTRENCHMENT         the arithmetic, with the EE3 cap named\n *   6. ACTIONS              reverse / rejustify / contest ΓÇö always at least one\n *   7. WHY NOT AUTO-APPLIED the standing explanation of invariant I4\n *\n * Part 7 is not boilerplate padding. It is the answer to the question every user asks\n * the first time: \"why didn't you just fix it?\" Veritas auto-retracts, because its\n * inputs are programmatic assertions with declared reliability. Ours are extracted\n * prose, and extracted prose must not be allowed to silently rewrite a considered\n * decision. Saying so every time is cheaper than being wrong once.\n *\n * ---------------------------------------------------------------------------\n * INVARIANT I4 ΓÇö THE SYSTEM PROPOSES, THE HUMAN DISPOSES\n *\n * Nothing in this module produces an event. It produces a `RevisionProposal`, which is\n * a value. Applying one is a separate act with its own event type and its own reason\n * string, performed by the review layer. There is no code path from a gate firing to a\n * log mutation.\n * ---------------------------------------------------------------------------\n */\n\nimport { formatProposalId } from \"@/lib/ids\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { Confidence, DecisionId, EventId, PremiseId, SourceSpan } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { Decision, Premise } from \"@/types/domain\";\nimport type {\n  AdjudicationOutcome,\n  CascadeResult,\n  EntrenchmentBreakdown,\n  NogoodRecord,\n  RevisionAction,\n  RevisionProposal,\n} from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport type { GateFinding } from \"./gates\";\n\n/* -------------------------------------------------------------------------- */\n/* Part 7, written once                                                       */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The standing explanation.\n *\n * Deliberately a constant rather than generated per proposal: it must not vary with\n * confidence, gate, or anything else, because a justification for not acting\n * automatically that changes with the situation is not a principle.\n */\nexport const WHY_NOT_AUTO_APPLIED = [\n  \"Not applied automatically.\",\n  \"This conclusion came from extracted prose, not from a measurement you made.\",\n  \"Extraction is wrong often enough that acting on it silently would corrupt the log ΓÇö\",\n  \"and a log you cannot trust is worth less than no log.\",\n  \"The proposal is recorded either way, so nothing is lost by waiting for you.\",\n].join(\" \");\n\n/* -------------------------------------------------------------------------- */\n/* Inputs                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface ProposalInput {\n  readonly state: GraphState;\n  readonly finding: GateFinding;\n  readonly cascade: CascadeResult;\n  readonly entrenchment: EntrenchmentBreakdown;\n  readonly nogood?: NogoodRecord;\n  readonly adjudication?: AdjudicationOutcome;\n  /** The evidence for the failure. When it came from a guard run or a human, the\n   *  span is absent and `source` says where it came from instead. */\n  readonly evidence: ProposalEvidence;\n  /** The event that records this proposal. Minted by the caller ΓÇö this module never\n   *  creates events. */\n  readonly createdBy: EventId;\n  readonly proposalNumber: number;\n}\n\nexport interface ProposalEvidence {\n  readonly quote: string;\n  readonly span?: SourceSpan;\n  readonly source: \"transcript\" | \"guard\" | \"human\" | \"repo-scan\";\n  readonly confidence: Confidence;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Construction                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Build one proposal.\n *\n * Total: every finding produces a proposal, including findings whose decision has\n * since been retracted and findings with no evidence quote. A finding that produces no\n * proposal is a finding that vanishes, and the user is left wondering why the gate\n * count and the proposal count disagree.\n */\nexport function buildProposal(input: ProposalInput): RevisionProposal {\n  const { state, finding } = input;\n\n  const _decision: Decision | undefined = state.decisions.get(finding.decisionId);\n  const failedPremise: Premise | undefined =\n    finding.premiseId === null ? undefined : state.premises.get(finding.premiseId);\n\n  const failedPremiseId = failedPremise?.id ?? firstInListPremise(state, finding.decisionId);\n  const failedPremiseText =\n    failedPremise?.text ??\n    (failedPremiseId === null\n      ? \"No single premise failed ΓÇö the conflict is between two decisions.\"\n      : (state.premises.get(failedPremiseId)?.text ?? failedPremiseId));\n\n  return {\n    id: formatProposalId(input.proposalNumber),\n    createdAt: input.createdBy,\n\n    /* 1 */\n    unsoundDecisionId: finding.decisionId,\n    failedPremiseId: failedPremiseId ?? (finding.decisionId as unknown as PremiseId),\n    failedPremiseText,\n\n    /* 2 */\n    evidence: {\n      quote: input.evidence.quote,\n      ...(input.evidence.span === undefined ? {} : { span: input.evidence.span }),\n      source: input.evidence.source,\n      confidence: input.evidence.confidence,\n    },\n\n    /* 3 */\n    ...(input.nogood === undefined ? {} : { nogood: input.nogood }),\n\n    /* 4 */\n    cascade: input.cascade,\n\n    /* 5 */\n    entrenchment: input.entrenchment,\n    entrenchmentBand: entrenchmentBand(input.entrenchment.capped),\n\n    /* 6 */\n    availableActions: actionsFor(finding, input.adjudication),\n\n    /* 7 */\n    whyNotAutoApplied: WHY_NOT_AUTO_APPLIED,\n\n    status: \"open\",\n  };\n}\n\n/**\n * Which actions are actually available.\n *\n * Always at least one ΓÇö a proposal with no action is a dead end and reads as a bug.\n * `dismiss` is not listed because it is always available in the UI; listing it here\n * would imply the other three are sometimes not.\n */\nexport function actionsFor(\n  finding: GateFinding,\n  adjudication?: AdjudicationOutcome,\n): readonly RevisionAction[] {\n  const actions: RevisionAction[] = [];\n\n  /* REVERSE ΓÇö there is something to reverse: another decision, or this one. */\n  if (finding.otherDecisionId !== null || finding.gate === \"premise\") actions.push(\"reverse\");\n\n  /* REJUSTIFY ΓÇö the premise is intent-based (a requirement, a team shape) or the\n   * failure is a refinement rather than a reversal. The decision may still be right;\n   * its stated reason is what is stale. */\n  if (finding.gate === \"semantic\" || finding.verdict === \"refinement\") actions.push(\"rejustify\");\n  if (finding.gate === \"premise\" && !actions.includes(\"rejustify\")) actions.push(\"rejustify\");\n\n  /* CONTEST ΓÇö the adjudicator refused a newcomer, or a semantic finding is weak enough\n   * that two readings are defensible. */\n  if (adjudication?.kind === \"reject-newcomer\") actions.push(\"contest\");\n  if (finding.gate === \"semantic\" && finding.diagnostic !== null) actions.push(\"contest\");\n\n  if (actions.length === 0) actions.push(\"rejustify\");\n\n  return actions;\n}\n\nfunction firstInListPremise(state: GraphState, decisionId: DecisionId): PremiseId | null {\n  for (const justification of state.justifications.values()) {\n    if (justification.consequent !== decisionId) continue;\n    const first = justification.inList[0];\n    if (first !== undefined) return first;\n  }\n  return null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Evidence for a finding                                                     */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The quote that supports a proposal, taken from the log rather than composed.\n *\n * For a premise finding the evidence is the premise's own recorded evidence ΓÇö a span\n * from a transcript, a guard result, or a human assertion. For a decision-pair finding\n * there is no single quote, so the evidence is the two decisions' snippets, and the\n * `source` is `transcript` because that is where both came from.\n *\n * The quote is VERBATIM in every case. A proposal whose evidence has been paraphrased\n * cannot be checked, and an unchecked proposal is an assertion, not a diagnosis.\n */\nexport function evidenceForFinding(state: GraphState, finding: GateFinding): ProposalEvidence {\n  if (finding.premiseId !== null) {\n    const premise = state.premises.get(finding.premiseId);\n\n    /* A finding is \"this premise was REFUTED\", so the evidence for it is the\n     * REFUTING observation. A guard failure records the line of the manifest\n     * that falsified the premise, and that line is the evidence - the\n     * transcript span that originally supported the premise is the thing that\n     * turned out to be wrong, not the proof that it was. */\n    const refuting = premise?.evidence.find(\n      (entry) => !entry.supports && entry.quote !== undefined,\n    );\n    if (refuting?.quote !== undefined) {\n      return {\n        quote: refuting.quote,\n        source: refuting.kind,\n        confidence: asConfidence(premise?.confidence ?? 0.5),\n      };\n    }\n\n    const best = premise?.evidence.find((entry) => entry.supports && entry.span !== undefined);\n\n    if (best?.span !== undefined) {\n      return {\n        quote: best.span.text,\n        span: best.span,\n        source: best.kind,\n        confidence: asConfidence(premise?.confidence ?? 0.5),\n      };\n    }\n\n    return {\n      quote: premise?.text ?? finding.explanation,\n      source: \"transcript\",\n      confidence: asConfidence(premise?.confidence ?? 0.4),\n    };\n  }\n\n  const a = state.decisions.get(finding.decisionId);\n  const b =\n    finding.otherDecisionId === null ? undefined : state.decisions.get(finding.otherDecisionId);\n\n  /* A guard failure is evidence ABOUT THE DECISION IT PROTECTS, and the guard\n   * record carries the verbatim line that failed. `GuardRunResult.evidence`\n   * exists to be quoted - \"evidence without a quote is not evidence\" - and for\n   * a drift finding there is no premise to quote, so the decision's own\n   * transcript snippet would be quoted instead: the thing that turned out to\n   * be wrong, rather than the proof that it was.\n   *\n   * An ABSENCE check that fails is the contradiction: the decision excluded\n   * this, and the project contains it. A PRESENCE check that fails is drift:\n   * the decision was not implemented yet. The contradiction is the evidence\n   * worth quoting, so it is preferred. */\n  const failingGuards = [...state.guards.values()].filter(\n    (guard) => guard.decisionId === finding.decisionId && guard.lastRun?.outcome === \"fail\",\n  );\n  const contradicting =\n    failingGuards.find((guard) => guard.spec.kind.endsWith(\"_absent\")) ?? failingGuards[0];\n  if (contradicting?.lastRun?.evidence !== undefined) {\n    return {\n      quote: contradicting.lastRun.evidence,\n      source: \"guard\",\n      confidence: asConfidence(finding.deterministic ? 0.9 : 0.6),\n    };\n  }\n\n  const quote =\n    b === undefined\n      ? (a?.provenance.snippet.text ?? finding.explanation)\n      : [a?.provenance.snippet.text ?? \"\", b.provenance.snippet.text ?? \"\"]\n          .filter((part) => part.length > 0)\n          .join(\"\\nΓÇö\\n\");\n\n  return {\n    quote,\n    ...(a?.provenance.snippet === undefined ? {} : { span: a.provenance.snippet }),\n    source: \"transcript\",\n    confidence: asConfidence(finding.deterministic ? 0.9 : 0.6),\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The proposal as the user reads it: all seven parts, in order, with headings.\n *\n * This is also the shape that goes into `DECISIONS.md` under a \"Contested\" section and\n * into the agent export as a warning block ΓÇö one renderer, three destinations, so the\n * explanation cannot drift between them.\n */\nexport function renderProposal(state: GraphState, proposal: RevisionProposal): string {\n  const decision = state.decisions.get(proposal.unsoundDecisionId);\n  const heading =\n    decision === undefined\n      ? proposal.unsoundDecisionId\n      : `${proposal.unsoundDecisionId} ΓÇö ${decision.statement}`;\n\n  const lines: string[] = [`## ${heading}`, \"\"];\n\n  lines.push(\"### 1. What failed\", proposal.failedPremiseText, \"\");\n\n  lines.push(\n    \"### 2. The evidence\",\n    `> ${proposal.evidence.quote.replace(/\\n/g, \"\\n> \")}`,\n    `Source: ${proposal.evidence.source} ┬╖ confidence ${proposal.evidence.confidence.toFixed(2)}`,\n    proposal.evidence.span === undefined\n      ? \"\"\n      : `Span: ${proposal.evidence.span.transcriptId} @ ${proposal.evidence.span.start}ΓÇô${proposal.evidence.span.end}`,\n    \"\",\n  );\n\n  if (proposal.nogood !== undefined) {\n    lines.push(\"### 3. What cannot both hold\", proposal.nogood.explanation, \"\");\n  } else {\n    lines.push(\"### 3. What cannot both hold\", \"No conjunction recorded for this finding.\", \"\");\n  }\n\n  lines.push(\"### 4. What else it affects\", describeCascadeOf(proposal.cascade), \"\");\n\n  lines.push(\n    \"### 5. How costly is it to change\",\n    `Entrenchment ${proposal.entrenchment.capped.toFixed(2)} ΓÇö ${proposal.entrenchmentBand}`,\n    proposal.entrenchment.ee3CapApplied\n      ? `Capped by its weakest premise (${proposal.entrenchment.weakestPremiseId ?? \"unnamed\"}).`\n      : \"Not capped by any premise.\",\n    proposal.entrenchment.implementationCostUnknown\n      ? \"Implementation cost UNKNOWN ΓÇö no guard exists yet, so nothing was measured.\"\n      : `Implementation cost ${proposal.entrenchment.components.implementationCost.toFixed(2)} ΓÇö measured from guards.`,\n    \"\",\n  );\n\n  lines.push(\n    \"### 6. What you can do\",\n    ...proposal.availableActions.map((action) => `- ${describeAction(action)}`),\n    \"- dismiss ΓÇö record that you considered it and disagreed\",\n    \"\",\n  );\n\n  lines.push(\"### 7. Why this was not applied for you\", proposal.whyNotAutoApplied, \"\");\n\n  return lines.filter((line) => line !== undefined).join(\"\\n\");\n}\n\nfunction describeCascadeOf(cascade: CascadeResult): string {\n  if (cascade.steps.length === 0) return \"Nothing else depended on it.\";\n\n  const parts: string[] = [];\n  if (cascade.flipped.length > 0) {\n    parts.push(`Became unsound: ${cascade.flipped.join(\", \")}.`);\n  }\n  if (cascade.survivors.length > 0) {\n    parts.push(`Kept independent support: ${cascade.survivors.join(\", \")}.`);\n  }\n  if (cascade.truncated) {\n    parts.push(`Stopped at the depth cap with ${cascade.potentiallyAffectedBeyondCap} unexamined.`);\n  }\n  return parts.join(\" \");\n}\n\n/** What each action DOES, in the words the button uses. */\nexport function describeAction(action: RevisionAction): string {\n  switch (action) {\n    case \"reverse\":\n      return \"reverse ΓÇö retract this decision and record the replacement\";\n    case \"rejustify\":\n      return \"rejustify ΓÇö keep the decision, replace the reason it rests on\";\n    case \"contest\":\n      return \"contest ΓÇö hold both, unresolved, and stop treating either as settled\";\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Queues                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** Open proposals, oldest first. The review queue for Phase 2. */\nexport function openProposals(state: GraphState): readonly RevisionProposal[] {\n  const out: RevisionProposal[] = [];\n  for (const proposal of state.proposals.values()) {\n    if (proposal.status === \"open\") out.push(proposal);\n  }\n  return out.sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));\n}\n\n/** Proposals whose band is HIGH ΓÇö the ones that will be hardest to accept, listed\n *  first because they are the ones most likely to be dismissed unread. */\nexport function highEntrenchmentProposals(state: GraphState): readonly RevisionProposal[] {\n  return openProposals(state).filter((proposal) => proposal.entrenchmentBand === \"HIGH\");\n}\n\n/** The next proposal number, from the counter. Never a module-level variable. */\nexport function nextProposalNumber(state: GraphState): number {\n  return state.counters.proposals + 1;\n}\n\nexport function countOpen(state: GraphState): number {\n  return openProposals(state).length;\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 30 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 30 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 30 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\reasoning\\revise.ts"},"span":[8226,8232],"sourceCode":"/**\n * REVISE(newInfo) ΓÇö the nine-step cycle. 2.1\n *\n * Phase 2 ┬╖ sub-phase 2.1\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.1\n * Docs: docs/02-truth-maintenance-theory.md ┬º5\n *\n * ---------------------------------------------------------------------------\n * THE ONLY ENTRY POINT\n *\n * Nothing outside this file calls the labeller, the gates, backtracking, the cascade,\n * the adjudicator or the proposal builder. Every one of them is a pure function that\n * takes the graph and returns a value; this module is the only place that decides the\n * ORDER they run in, and the order is the algorithm.\n *\n * That matters for one concrete reason: running the cascade before backtracking would\n * retract everything downstream of a premise that backtracking would have shown was not\n * the culprit. Running adjudication before detection would screen a newcomer against\n * conflicts the detector has not found yet. The sequence is not a stylistic choice.\n *\n *   1 EXTRACT     what the new information actually says\n *   2 RESOLVE     which existing node it refers to\n *   3 ASSERT      label the graph, find what is now unsound\n *   4 DETECT      gates (a) structural, (b) semantic, (c) premise\n *   5 BACKTRACK   the MINIMAL set of assumptions responsible\n *   6 CASCADE     what else falls, stopping at independent support\n *   7 ADJUDICATE  Hansson screening ΓÇö the newcomer may be REFUSED\n *   8 PROPOSE     seven parts, never auto-applied\n *   9 COMMIT      event drafts, appended by the store, not by us\n *\n * ---------------------------------------------------------------------------\n * STEP 9 DOES NOT WRITE\n *\n * This module returns drafts. The store appends them, because appending is\n * `append ΓåÆ fold ΓåÆ persist` and only the store owns all three. A reasoning module that\n * could write to the log could also write to it out of order, and the hash chain would\n * faithfully record a corrupted sequence.\n *\n * The drafts are ordered: `LabelChanged` first, then detections, then nogoods, then\n * cascades, then proposals. A proposal references the nogood that explains it, and a\n * nogood references the detection that produced it, so the order is not arbitrary ΓÇö it\n * is the order in which each event's referents come into existence.\n *\n * ---------------------------------------------------------------------------\n * IDEMPOTENCE\n *\n * Running REVISE twice over an unchanged log produces NO new events the second time.\n * Labels have already changed, so `changed` is empty. Detections have already been\n * recorded, so they are filtered against the log. Nogoods already exist, so\n * `isDuplicate` blocks them. Proposals already exist for these findings, so they are\n * not raised again.\n *\n * Without this the log fills with repeated identical warnings, and a queue the user\n * has already read looks permanently unread ΓÇö which is how a reasoning system gets\n * switched off.\n * ---------------------------------------------------------------------------\n */\n\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { formatNogoodId } from \"@/lib/ids\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type {\n  Actor,\n  DecisionId,\n  EventId,\n  ISODateString,\n  NogoodId,\n  PremiseId,\n} from \"@/types/common\";\nimport type { Nogood } from \"@/types/domain\";\nimport type { NewEvent } from \"@/types/events\";\nimport type {\n  AdjudicationOutcome,\n  BacktrackResult,\n  CascadeResult,\n  RevisionProposal,\n} from \"@/types/reasoning\";\nimport { type Newcomer, adjudicate, findContradictors } from \"./adjudication\";\nimport { backtrack, describeBacktrack, splitCulprits } from \"./backtracking\";\nimport { MAX_CASCADE_DEPTH, cascade, describeCascade } from \"./cascade\";\nimport { type GuardStatus, describeEntrenchment, entrenchmentOf } from \"./entrenchment\";\nimport { type CandidatePair, type GateFinding, type GateRun, describeRun, runGates } from \"./gates\";\nimport { type Labelled, type LabellingResult, type NodeId, label } from \"./labeller\";\nimport { type NogoodDraft, blocksConjunction, isDuplicate, nogoodForFinding } from \"./nogoods\";\nimport {\n  WHY_NOT_AUTO_APPLIED,\n  buildProposal,\n  evidenceForFinding,\n  renderProposal,\n} from \"./proposals\";\n\n/** One label flip, as the labeller reports it. `revise` turns these into events. */\nexport type LabelChange = LabellingResult[\"changed\"][number];\n\n/* -------------------------------------------------------------------------- */\n/* Input                                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface ReviseInput {\n  readonly state: GraphState;\n  readonly engine: WhyLogEngine;\n  readonly actor: Actor;\n  readonly now: ISODateString;\n  /** Step 1. Absent means \"re-examine what is already in the log\", which is what a\n   *  boot-time run does: gates (a) and (c) can fire on a log nobody has touched. */\n  readonly newcomer?: Newcomer;\n  /** Phase 3. Absent means gate (b) reports itself unavailable. */\n  readonly retrieve?: (state: GraphState) => Promise<readonly CandidatePair[]>;\n  readonly skipSemantic?: boolean;\n  /** Phase 4. Absent means implementation cost is UNKNOWN, never assumed. */\n  readonly guards?: ReadonlyMap<DecisionId, GuardStatus>;\n  /** Phase 6.8. How deep the cascade may follow shared-premise edges. Absent means the module\n   *  default, which keeps `revise` usable by callers that have no settings to offer. */\n  readonly cascadeDepthCap?: number;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Output                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** One finding, fully worked through steps 5-8. This is what the UI renders. */\nexport interface RevisionCase {\n  readonly finding: GateFinding;\n  readonly backtrack: BacktrackResult;\n  readonly cascade: CascadeResult;\n  readonly entrenchment: ReturnType<typeof entrenchmentOf>;\n  readonly nogood: NogoodDraft | null;\n  readonly nogoodId: NogoodId | null;\n  readonly proposal: RevisionProposal;\n  /** Steps 5 and 6 in words. The diagnosis, not a rendering of the data. */\n  readonly narrative: string;\n  /**\n   * ┬º2.6 nogood REUSE: this revision would re-assert a conjunction the log has already\n   * recorded as impossible. Null when it would not.\n   *\n   * Surfaced as a warning rather than a block, because the earlier nogood may itself\n   * have been wrong ΓÇö but a user who is about to re-assert something the system proved\n   * impossible on a known date deserves to be told the date before they click.\n   */\n  readonly reassertsNogood: Nogood | null;\n}\n\nexport interface ReviseResult {\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly labelChanges: readonly LabelChange[];\n  readonly gates: GateRun;\n  readonly cases: readonly RevisionCase[];\n  readonly adjudication:\n    | (AdjudicationOutcome & { readonly considered: readonly DecisionId[] })\n    | null;\n  /** Step 9. Ordered, ready for `appendBatch`. EMPTY on an unchanged log. */\n  readonly eventDrafts: readonly EventDraftAny[];\n  readonly durationMs: number;\n  readonly summary: string;\n}\n\n/** The draft shape `event-log.append` accepts: type, payload, actor, reason. */\nexport type EventDraftAny =\n  | NewEvent<\"LabelChanged\">\n  | NewEvent<\"ContradictionDetected\">\n  | NewEvent<\"PremiseInvalidated\">\n  | NewEvent<\"NogoodRecorded\">\n  | NewEvent<\"CascadePropagated\">\n  | NewEvent<\"RevisionProposed\">;\n\n/**\n * The event id is not known until the log seals it.\n *\n * `event-log.append` mints ids from its own monotonic counter, so any id this module\n * wrote into a payload would be wrong. The materialiser rewrites these placeholders to\n * the creating event on fold ΓÇö the same mechanism `commit.ts` uses for justification\n * informants, and the reason a payload can reference its own event without a cycle.\n */\nconst PLACEHOLDER_EVENT_ID = \"EV-000000-000000\" as EventId;\n\n/* -------------------------------------------------------------------------- */\n/* The cycle                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport async function revise(input: ReviseInput): Promise<ReviseResult> {\n  const started = nowMs();\n  const { state } = input;\n\n  /* ---- 1 EXTRACT + 2 RESOLVE ----\n   * Both happened upstream: `extraction/commit.ts` resolved candidates against the\n   * identity ladder and appended events before this ran. What is left of step 2 here is\n   * the only part that cannot be done at commit time ΓÇö finding which EXISTING decisions\n   * a newcomer contradicts, which needs the graph as it stands after the assert. */\n  const resolvedAgainst =\n    input.newcomer === undefined ? [] : findContradictors(state, input.newcomer);\n\n  /* ---- 3 ASSERT ---- */\n  const labelling = label(state);\n  const labels = labelling.labels;\n\n  /* ---- 4 DETECT ---- */\n  const gates = await runGates(state, labels, {\n    engine: input.engine,\n    ...(input.retrieve === undefined ? {} : { retrieve: input.retrieve }),\n    ...(input.skipSemantic === undefined ? {} : { skipSemantic: input.skipSemantic }),\n  });\n\n  /* ---- 7 ADJUDICATE ----\n   * Before 5 and 6, not after: a REFUSED newcomer produces no backtracking and no\n   * cascade at all, because nothing is being retracted. Screening first is what keeps\n   * a passing remark from triggering a retraction run. */\n  const adjudication =\n    input.newcomer === undefined\n      ? null\n      : adjudicate(state, {\n          newcomer: input.newcomer,\n          now: Date.parse(input.now),\n          ...(input.guards === undefined ? {} : { guards: input.guards }),\n        });\n\n  const refused = adjudication?.kind === \"reject-newcomer\";\n\n  /* ---- 5 BACKTRACK + 6 CASCADE + 8 PROPOSE ---- */\n  const cases: RevisionCase[] = [];\n  const drafts: EventDraftAny[] = [];\n  let nogoodNumber = state.counters.nogoods;\n  let proposalNumber = state.counters.proposals;\n\n  /* Label flips are recorded first: every later event refers to a graph whose labels\n   * have already moved. */\n  for (const change of labelling.changed) {\n    drafts.push(labelChangedDraft(input, change));\n  }\n\n  for (const finding of gates.findings) {\n    if (alreadyRecorded(state, finding)) continue;\n\n    drafts.push(detectionDraft(input, finding));\n\n    if (finding.gate === \"premise\" && finding.premiseId !== null) {\n      drafts.push(premiseInvalidatedDraft(input, finding.premiseId));\n    }\n\n    /* ---- 5 BACKTRACK ---- */\n    const backtrackResult = backtrack(state, labels, finding.decisionId);\n\n    /* ---- ┬º2.6 NOGOOD REUSE ----\n     * Checked BEFORE the proposal is built, so the warning is part of the proposal\n     * rather than a footnote added after the user has already read it. */\n    const reasserts = blocksConjunction(state, backtrackResult.culpritPremises);\n\n    /* ---- 3 (nogood) ---- */\n    const nogoodDraft = nogoodForFinding(state, labels, finding);\n    let nogoodId: NogoodId | null = null;\n\n    if (nogoodDraft !== null && !isDuplicate(state, nogoodDraft)) {\n      nogoodNumber += 1;\n      nogoodId = nextNogoodIdInRun(nogoodNumber);\n      drafts.push(nogoodDraftEvent(input, nogoodId, nogoodDraft));\n    }\n\n    /* ---- 6 CASCADE ----\n     * From the CULPRITS, not from the finding: propagating from the decision would\n     * retract the decision's own dependents on the strength of a conflict that\n     * backtracking may have localised to a single premise. */\n    const retracted = refused ? [] : backtrackResult.culpritPremises;\n    const cascadeResult: CascadeResult =\n      retracted.length === 0\n        ? {\n            steps: [],\n            flipped: [],\n            survivors: [],\n            truncated: false,\n            potentiallyAffectedBeyondCap: 0,\n          }\n        : cascade(\n            state,\n            labels,\n            retracted,\n            /* Threaded from the caller rather than defaulting here. Before this, `cascade()`\n             * accepted a depth cap that no call site ever supplied, so the setting in Settings was\n             * inert end to end and every run used MAX_CASCADE_DEPTH whether the user asked for 2 or\n             * 12. A parameter nobody passes is not a configuration surface. */\n            input.cascadeDepthCap ?? MAX_CASCADE_DEPTH,\n          );\n\n    for (const step of cascadeResult.steps) {\n      drafts.push(cascadeDraft(input, step));\n    }\n\n    /* ---- 5 (entrenchment) ---- */\n    const guardStatus =\n      input.guards === undefined ? undefined : input.guards.get(finding.decisionId);\n    const entrenchment = entrenchmentOf(\n      state,\n      finding.decisionId,\n      Date.parse(input.now),\n      guardStatus,\n    );\n\n    /* ---- 8 PROPOSE ---- */\n    proposalNumber += 1;\n    const proposal = buildProposal({\n      state,\n      finding,\n      cascade: cascadeResult,\n      entrenchment,\n      ...(nogoodId === null || nogoodDraft === null\n        ? {}\n        : {\n            nogood: {\n              id: nogoodId,\n              premiseIds: nogoodDraft.premiseIds,\n              explanation: nogoodDraft.explanation,\n              derivedFrom: PLACEHOLDER_EVENT_ID,\n            },\n          }),\n      ...(adjudication === null ? {} : { adjudication }),\n      evidence: evidenceForFinding(state, finding),\n      createdBy: PLACEHOLDER_EVENT_ID,\n      proposalNumber,\n    });\n\n    cases.push({\n      finding,\n      backtrack: backtrackResult,\n      cascade: cascadeResult,\n      entrenchment,\n      nogood: nogoodDraft,\n      nogoodId,\n      proposal,\n      narrative: narrate(\n        state,\n        finding,\n        backtrackResult,\n        cascadeResult,\n        entrenchment,\n        refused,\n        reasserts,\n      ),\n      reassertsNogood: reasserts,\n    });\n\n    drafts.push(proposalDraft(input, proposal, nogoodId, adjudication));\n  }\n\n  return {\n    labels,\n    labelChanges: labelling.changed,\n    gates,\n    cases,\n    adjudication,\n    eventDrafts: drafts,\n    durationMs: Math.round(nowMs() - started),\n    summary: summarise(input, gates, cases, adjudication, drafts, resolvedAgainst.length),\n  };\n}\n\n/* A single run can mint several nogoods, so the number is threaded explicitly rather\n * than read from a counter this module does not own and must not mutate. */\nfunction nextNogoodIdInRun(n: number): NogoodId {\n  return formatNogoodId(n);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Idempotence                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Has this finding already been recorded?\n *\n * Compared against the log rather than against the in-memory run, because the question\n * is \"does the log already say this?\" ΓÇö and a run that has not been committed yet must\n * not suppress a finding that a PREVIOUS committed run recorded.\n */\nfunction alreadyRecorded(state: GraphState, finding: GateFinding): boolean {\n  for (const detection of state.contradictions) {\n    if (detection.gate !== finding.gate) continue;\n    if (detection.decisionA !== finding.decisionId) continue;\n    if ((detection.decisionB ?? null) !== finding.otherDecisionId) continue;\n    if ((detection.premiseId ?? null) !== finding.premiseId) continue;\n    return true;\n  }\n  return false;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Step 9 ΓÇö the drafts                                                        */\n/* -------------------------------------------------------------------------- */\n\nfunction labelChangedDraft(input: ReviseInput, change: LabelChange): NewEvent<\"LabelChanged\"> {\n  const trigger =\n    change.reason.kind === \"all-justifications-invalid\" ? change.reason.failedPremiseId : null;\n  const invalidJustificationId =\n    change.reason.kind === \"valid-justification\" ? change.reason.justificationId : null;\n\n  return {\n    type: \"LabelChanged\",\n    payload: {\n      nodeId: change.id,\n      from: change.from,\n      to: change.to,\n      ...(invalidJustificationId === null ? {} : { invalidJustificationId }),\n      ...(trigger === null || trigger === undefined ? {} : { triggerPremiseId: trigger }),\n      gate: \"cascade\",\n    },\n    actor: input.actor,\n    reason: `${change.id} moved from ${change.from} to ${change.to}: ${change.reason.kind.replace(/-/g, \" \")}.`,\n    at: input.now,\n  };\n}\n\nfunction detectionDraft(input: ReviseInput, finding: GateFinding): EventDraftAny {\n  if (finding.gate === \"premise\" && finding.premiseId !== null) {\n    return {\n      type: \"ContradictionDetected\",\n      payload: {\n        gate: \"premise\",\n        verdict: finding.verdict,\n        decisionA: finding.decisionId,\n        premiseId: finding.premiseId,\n        explanation: finding.explanation,\n        engine: input.engine.id(),\n      },\n      actor: input.actor,\n      reason: finding.explanation,\n      at: input.now,\n    };\n  }\n\n  return {\n    type: \"ContradictionDetected\",\n    payload: {\n      gate: finding.gate === \"semantic\" ? \"semantic\" : \"structural\",\n      verdict: finding.verdict,\n      decisionA: finding.decisionId,\n      ...(finding.otherDecisionId === null ? {} : { decisionB: finding.otherDecisionId }),\n      explanation: finding.explanation,\n      ...(finding.diagnostic === null ? {} : { diagnostic: finding.diagnostic }),\n      engine: input.engine.id(),\n    },\n    actor: input.actor,\n    reason: finding.explanation,\n    at: input.now,\n  };\n}\n\nfunction premiseInvalidatedDraft(\n  input: ReviseInput,\n  premiseId: PremiseId,\n): NewEvent<\"PremiseInvalidated\"> {\n  return {\n    type: \"PremiseInvalidated\",\n    payload: {\n      premiseId,\n      invalidatedBy: { kind: \"assertion\", eventId: PLACEHOLDER_EVENT_ID },\n    },\n    actor: input.actor,\n    reason: `${premiseId} is no longer true. Every decision resting on it is re-examined; this event is the record that it was, and of what falsified it.`,\n    at: input.now,\n  };\n}\n\nfunction nogoodDraftEvent(\n  input: ReviseInput,\n  nogoodId: NogoodId,\n  draft: NogoodDraft,\n): NewEvent<\"NogoodRecorded\"> {\n  return {\n    type: \"NogoodRecorded\",\n    payload: {\n      nogoodId,\n      premiseIds: draft.premiseIds,\n      derivedFrom: PLACEHOLDER_EVENT_ID,\n    },\n    actor: input.actor,\n    reason: draft.explanation,\n    at: input.now,\n  };\n}\n\nfunction cascadeDraft(\n  input: ReviseInput,\n  step: CascadeResult[\"steps\"][number],\n): NewEvent<\"CascadePropagated\"> {\n  return {\n    type: \"CascadePropagated\",\n    payload: {\n      from: step.from,\n      to: step.to,\n      depth: step.depth,\n      stoppedAtIndependentSupport: step.stoppedAtIndependentSupport,\n    },\n    actor: input.actor,\n    reason: step.stoppedAtIndependentSupport\n      ? `Propagation stopped at ${step.to}: it has an independent justification that does not depend on any retracted premise. Recorded so the absence of a retraction here is visible as a decision, not an oversight.`\n      : `${step.to} became ${step.became} at depth ${step.depth}. ${step.reason}`,\n    at: input.now,\n  };\n}\n\nfunction proposalDraft(\n  input: ReviseInput,\n  proposal: RevisionProposal,\n  nogoodId: NogoodId | null,\n  adjudication: ReviseResult[\"adjudication\"],\n): NewEvent<\"RevisionProposed\"> {\n  return {\n    type: \"RevisionProposed\",\n    payload: {\n      proposalId: proposal.id,\n      unsoundDecisionId: proposal.unsoundDecisionId,\n      failedPremiseId: proposal.failedPremiseId,\n      ...(nogoodId === null ? {} : { nogoodId }),\n      cascade: proposal.cascade.steps\n        .filter((step) => !step.stoppedAtIndependentSupport)\n        .map((step) => ({ decisionId: step.to, became: step.became })),\n      survivors: proposal.cascade.survivors,\n      entrenchment: proposal.entrenchment,\n      evidence: {\n        quote: proposal.evidence.quote,\n        source: proposal.evidence.source,\n        confidence: proposal.evidence.confidence,\n      },\n      ...(adjudication?.kind === \"reject-newcomer\"\n        ? { rejectedNewcomer: { eventId: PLACEHOLDER_EVENT_ID, why: adjudication.why } }\n        : {}),\n      availableActions: proposal.availableActions,\n    },\n    actor: input.actor,\n    reason: `${WHY_NOT_AUTO_APPLIED} Proposed for ${proposal.unsoundDecisionId} instead.`,\n    at: input.now,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The narrative                                                              */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Steps 5, 6 and the refusal, in prose.\n *\n * Not a rendering of the fields ΓÇö the UI renders those. This is the paragraph a user\n * reads first, and it has to answer \"what is wrong and what is the least I have to\n * give up?\" before it answers anything else.\n */\nfunction narrate(\n  state: GraphState,\n  finding: GateFinding,\n  backtrackResult: BacktrackResult,\n  cascadeResult: CascadeResult,\n  entrenchment: ReturnType<typeof entrenchmentOf>,\n  refused: boolean,\n  reasserts: Nogood | null,\n): string {\n  const parts: string[] = [finding.explanation];\n\n  /* First, before the diagnosis: a user about to re-assert a proven-impossible\n   * combination needs to see that before they read anything else. */\n  if (reasserts !== null) {\n    parts.push(\n      `WARNING ΓÇö you are re-asserting a combination this log already found impossible on ${reasserts.recordedAt.slice(0, 10)} (${reasserts.id}). ${reasserts.explanation}`,\n    );\n  }\n\n  if (refused) {\n    parts.push(\n      \"The incoming information was REFUSED by non-prioritized screening, so nothing was retracted and no cascade ran. It is in the Contested queue.\",\n    );\n    return parts.join(\" \");\n  }\n\n  parts.push(describeBacktrack(state, backtrackResult));\n\n  const culprits = splitCulprits(state, backtrackResult.culpritPremises);\n  if (culprits.intentBased.length > 0 && culprits.worldObservable.length === 0) {\n    parts.push(\n      \"Every culprit here expresses intent rather than a state of the world, so no guard can check it. Only you can retract these.\",\n    );\n  }\n\n  parts.push(describeCascade(state, cascadeResult));\n  parts.push(describeEntrenchment(state, finding.decisionId, entrenchment));\n\n  return parts.join(\" \");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Summary                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction summarise(\n  input: ReviseInput,\n  gates: GateRun,\n  cases: readonly RevisionCase[],\n  adjudication: ReviseResult[\"adjudication\"],\n  drafts: readonly EventDraftAny[],\n  contradictors: number,\n): string {\n  const lines: string[] = [`REVISE ΓÇö ${describeRun(gates)}`];\n\n  if (input.newcomer !== undefined) {\n    lines.push(\n      `Newcomer: \"${input.newcomer.text}\" (${input.newcomer.variable} ΓåÆ ${input.newcomer.value}), contradicting ${contradictors} recorded decision(s).`,\n    );\n  }\n\n  if (adjudication !== null && adjudication.kind === \"reject-newcomer\") {\n    lines.push(`Screening: REFUSED. ${adjudication.why}`);\n  } else if (adjudication !== null && adjudication.kind === \"apply\") {\n    lines.push(\n      `Screening: accepted, retracting weakest-first: ${adjudication.retract.join(\", \")}.`,\n    );\n  }\n\n  lines.push(`${cases.length} case(s) worked through backtracking, cascade and entrenchment.`);\n\n  if (drafts.length === 0) {\n    lines.push(\"No events to append ΓÇö this log has already been revised against these findings.\");\n  } else {\n    lines.push(`${drafts.length} event(s) to append, in referent order.`);\n  }\n\n  return lines.join(\"\\n\");\n}\n\n/** The full readable report: summary, then every case with its rendered proposal. */\nexport function renderResult(state: GraphState, result: ReviseResult): string {\n  const blocks: string[] = [result.summary];\n\n  for (const caseOf of result.cases) {\n    blocks.push(\"\", \"---\", \"\", caseOf.narrative, \"\", renderProposal(state, caseOf.proposal));\n  }\n\n  if (result.gates.semantic.available === false) {\n    blocks.push(\"\", \"---\", \"\", `Gate (b) did not run: ${result.gates.semantic.unavailableReason}`);\n  }\n\n  return blocks.join(\"\\n\");\n}\n\n/** How deep the deepest cascade went, for the health panel. */\nexport function deepestCascade(result: ReviseResult): number {\n  return result.cases.reduce(\n    (max, entry) =>\n      Math.max(\n        max,\n        entry.cascade.steps.reduce((inner, step) => Math.max(inner, step.depth), 0),\n      ),\n    0,\n  );\n}\n\nexport { MAX_CASCADE_DEPTH, PLACEHOLDER_EVENT_ID as REVISION_PLACEHOLDER_EVENT_ID };\n\nfunction nowMs(): number {\n  return typeof performance !== \"undefined\" ? performance.now() : Date.now();\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 22 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 22 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 22 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\store\\export.ts"},"span":[4898,4901],"sourceCode":"/**\n * The export store ΓÇö Phase 5.\n *\n * Plan: plan/phase-5-export-compiler.md\n *\n * ---------------------------------------------------------------------------\n * WHAT IT OWNS\n *\n *   the compile       one graph ΓåÆ artifacts, in one pass, plus the events that record it\n *   the target set    all five by default; a builder switching editors should not re-export\n *   the verification  \"check my files\" ΓÇö compare a pasted artifact's stamp against the log\n *   the round trip    plan a merge from a DECISIONS.md, show it, apply it only on confirmation\n *\n * ---------------------------------------------------------------------------\n * A BLOCKED EXPORT IS A RESULT, NOT AN ERROR\n *\n * When the consistency gate blocks, the store keeps the CIF and the explanation and sets\n * `blocked`, rather than throwing or clearing. The user needs to see WHICH two decisions conflict\n * and why ΓÇö an export that fails with \"contradiction detected\" and no pair named is an export that\n * cannot be acted on, and the temptation is to reach for the `includeOut` toggle instead of\n * resolving the conflict.\n *\n * ---------------------------------------------------------------------------\n * VERIFICATION IS READ-ONLY UNTIL IT FINDS SOMETHING\n *\n * Checking a file writes no event when it matches. Only a MISMATCH produces\n * `ExportIntegrityMismatch`, because a log full of \"checked, fine\" entries would bury the one that\n * mattered ΓÇö and the mismatch is the only finding here that says something about the world rather\n * than about the user having clicked a button.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  type CompileResult,\n  type MergePlan,\n  compile,\n  describeBudget,\n  describeCompile,\n  describeExportPhase,\n  describeMergePlan,\n  explainVerification,\n  importedEvent,\n  mismatchPayload,\n  planMerge,\n  verifyStamp,\n} from \"@/export\";\nimport { nowISO } from \"@/lib/format\";\nimport { type Result, err, ok } from \"@/lib/result\";\nimport type { Actor } from \"@/types/common\";\nimport type { DecisionId, ISODateString } from \"@/types/common\";\nimport type { EventType, NewEvent } from \"@/types/events\";\nimport type {\n  CompiledArtifact,\n  ExportTarget,\n  IntegrityStamp,\n  StampVerification,\n} from \"@/types/export\";\nimport { EXPORT_TARGETS, TARGET_FILENAMES } from \"@/types/export\";\nimport { create } from \"zustand\";\nimport { useWhyLog } from \"./whylog\";\n\n/** `system`, not `engine`: compiling a graph into Markdown is deterministic, and stamping it as\n *  an engine act would claim a model produced a file that a fold and five pure functions did. */\nconst EXPORT_ACTOR: Actor = { kind: \"system\" };\n\nexport type ExportStatus = \"idle\" | \"compiling\" | \"failed\";\n\nexport interface CheckResult {\n  readonly path: string;\n  readonly verification: StampVerification;\n  readonly note: string;\n}\n\nexport interface ExportState {\n  readonly status: ExportStatus;\n  readonly error: string | null;\n  readonly result: CompileResult | null;\n  readonly blocked: boolean;\n  readonly blockedExplanation: string | null;\n\n  readonly targets: readonly ExportTarget[];\n  readonly projectName: string;\n  readonly maxLines: number;\n  readonly includeOut: boolean;\n  readonly includeSuperseded: boolean;\n\n  readonly selected: ExportTarget | null;\n  readonly checks: readonly CheckResult[];\n  readonly mergePlan: MergePlan | null;\n  readonly mergeNote: string | null;\n\n  readonly compileAll: () => Promise<Result<number, string>>;\n  readonly toggleTarget: (target: ExportTarget) => void;\n  readonly setProjectName: (name: string) => void;\n  readonly setMaxLines: (lines: number) => void;\n  readonly setIncludeOut: (on: boolean) => void;\n  readonly setIncludeSuperseded: (on: boolean) => void;\n  readonly select: (target: ExportTarget | null) => void;\n  readonly checkFile: (path: string, contents: string) => Result<CheckResult, string>;\n  readonly planImport: (contents: string) => Result<MergePlan, string>;\n  readonly applyImport: () => Promise<Result<number, string>>;\n  readonly clearChecks: () => void;\n}\n\nexport const useExport = create<ExportState>()((set, get) => ({\n  status: \"idle\",\n  error: null,\n  result: null,\n  blocked: false,\n  blockedExplanation: null,\n\n  /* All five by default. Emit-all-at-once is the plan's default and the right one: they are\n   * compiled from one pass, so selecting fewer saves no work, and a builder who switches editors\n   * next month should not have to remember to re-export. */\n  targets: EXPORT_TARGETS,\n  projectName: \"\",\n  maxLines: 200,\n  includeOut: false,\n  includeSuperseded: false,\n\n  selected: null,\n  checks: [],\n  mergePlan: null,\n  mergeNote: null,\n\n  /* ---------------------------------------------------------------------- */\n  /* Compile                                                                */\n  /* ---------------------------------------------------------------------- */\n\n  compileAll: async () => {\n    const whylog = useWhyLog.getState();\n\n    if (whylog.status === \"degraded\") {\n      const message =\n        \"The log is read-only: its hash chain is broken. An export needs to append the events that record it.\";\n      set({ status: \"failed\", error: message });\n      return err(message);\n    }\n\n    if (whylog.state.decisions.size === 0) {\n      const message =\n        \"The log holds no decisions, so there is nothing to compile. Import a transcript first.\";\n      set({ status: \"failed\", error: message });\n      return err(message);\n    }\n\n    if (get().status === \"compiling\") return err(\"An export is already compiling.\");\n\n    set({ status: \"compiling\", error: null });\n\n    try {\n      const result = await compile({\n        state: whylog.state,\n        headHash: whylog.log.headHash,\n        actor: EXPORT_ACTOR,\n        targets: get().targets,\n        maxLines: get().maxLines,\n        includeOut: get().includeOut,\n        includeSuperseded: get().includeSuperseded,\n        ...(get().projectName.trim().length === 0 ? {} : { projectName: get().projectName.trim() }),\n        engineAtGeneration:\n          whylog.engineId.kind +\n          (whylog.engineId.model.length > 0 ? `/${whylog.engineId.model}` : \"\"),\n      });\n\n      /* ---- a blocked export keeps its explanation ---- */\n      if (result.blocked) {\n        set({\n          status: \"idle\",\n          result,\n          blocked: true,\n          blockedExplanation: result.blockedExplanation,\n          error: null,\n        });\n        return err(\n          `Blocked by the pre-export consistency gate. ${result.gate.conflicts.length} conflicting pair(s). Nothing was written ΓÇö see the explanation below.`,\n        );\n      }\n\n      /* ---- commit the events that record the export ---- */\n      if (result.drafts.length > 0) {\n        const committed = whylog.recordBatch(result.drafts, {\n          reason: `Compiled ${result.artifacts.length} export artifact(s) from log head ${result.stamp.headHash.slice(0, 12)} and stamped them, so each file can be tied back to the state that produced it.`,\n          actor: EXPORT_ACTOR,\n          occurredAt: nowISO() as ISODateString,\n        });\n\n        if (!committed.ok) {\n          set({ status: \"failed\", error: committed.error, result, blocked: false });\n          return err(committed.error);\n        }\n      }\n\n      set({ status: \"idle\", result, blocked: false, blockedExplanation: null });\n      return ok(result.artifacts.length);\n    } catch (error) {\n      const message = error instanceof Error ? error.message : String(error);\n      set({ status: \"failed\", error: message });\n      return err(message);\n    }\n  },\n\n  /* ---------------------------------------------------------------------- */\n  /* Options                                                                */\n  /* ---------------------------------------------------------------------- */\n\n  toggleTarget: (target) => {\n    const current = get().targets;\n    set({\n      targets: current.includes(target)\n        ? current.filter((entry) => entry !== target)\n        : [...current, target],\n    });\n  },\n\n  setProjectName: (name) => set({ projectName: name }),\n  setMaxLines: (lines) => set({ maxLines: Math.max(40, Math.min(2000, Math.round(lines) || 200)) }),\n  setIncludeOut: (on) => set({ includeOut: on }),\n  setIncludeSuperseded: (on) => set({ includeSuperseded: on }),\n  select: (target) => set({ selected: target }),\n  clearChecks: () => set({ checks: [] }),\n\n  /* ---------------------------------------------------------------------- */\n  /* Verify a file                                                          */\n  /* ---------------------------------------------------------------------- */\n\n  /**\n   * Compare a pasted artifact against the current log.\n   *\n   * Writes an event only on mismatch. A match is the expected outcome of clicking \"check\" and\n   * recording it would fill the log with non-findings.\n   */\n  checkFile: (path, contents) => {\n    const whylog = useWhyLog.getState();\n    const current = whylog.log.headHash;\n\n    const verification = verifyStamp({ contents, currentHeadHash: current });\n    const note = explainVerification(verification, path);\n    const check: CheckResult = { path, verification, note };\n\n    set({ checks: [...get().checks, check] });\n\n    if (verification.ok) return ok(check);\n\n    const payload = mismatchPayload(path, current, verification);\n    const at = nowISO() as ISODateString;\n    const reason = `A manual check of ${path} found it does not correspond to the current log. Expected head ${payload.expectedHead.slice(0, 12) || \"(empty log)\"}, found ${payload.foundHead === null ? \"no stamp\" : payload.foundHead.slice(0, 12)}. Recorded because an artifact that no longer matches its log is either stale or has been rewritten ΓÇö and an agent reading a rewritten rule is following something nobody decided.`;\n\n    const draft: NewEvent<EventType> = {\n      type: \"ExportIntegrityMismatch\",\n      payload,\n      actor: EXPORT_ACTOR,\n      reason,\n      at,\n      occurredAt: at,\n    };\n\n    const committed = whylog.recordBatch([draft], {\n      reason,\n      actor: EXPORT_ACTOR,\n      occurredAt: at,\n    });\n\n    if (!committed.ok) {\n      return err(`The mismatch was detected but could not be recorded: ${committed.error}`);\n    }\n\n    return ok(check);\n  },\n\n  /* ---------------------------------------------------------------------- */\n  /* Round trip                                                             */\n  /* ---------------------------------------------------------------------- */\n\n  planImport: (contents) => {\n    const whylog = useWhyLog.getState();\n    const plan = planMerge(contents, whylog.state, whylog.log.headHash);\n\n    set({ mergePlan: plan, mergeNote: describeMergePlan(plan) });\n\n    if (plan.refuse) return err(plan.refusalReason ?? \"Refused.\");\n    return ok(plan);\n  },\n\n  /**\n   * Apply a planned merge.\n   *\n   * Only the `LogImported` event is written here. Records resolved as `new` are NOT committed as\n   * decisions: invariant I4 says the system proposes and the human disposes, so they belong in the\n   * review queue, and an import that silently created decisions would be an import that could\n   * rewrite the log from a Markdown file.\n   */\n  applyImport: async () => {\n    const whylog = useWhyLog.getState();\n    const plan = get().mergePlan;\n\n    if (plan === null) return err(\"Plan an import first.\");\n    if (plan.refuse) return err(plan.refusalReason ?? \"This import was refused.\");\n\n    const at = nowISO() as ISODateString;\n    const drafts: NewEvent<EventType>[] = [importedEvent(plan, EXPORT_ACTOR, at)];\n\n    const committed = whylog.recordBatch(drafts, {\n      reason: drafts[0]?.reason ?? \"Imported decisions from an exported DECISIONS.md.\",\n      actor: EXPORT_ACTOR,\n      occurredAt: at,\n    });\n\n    if (!committed.ok) return err(committed.error);\n\n    set({ mergePlan: null, mergeNote: null });\n    return ok(plan.counts.new);\n  },\n}));\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeExportState(state: ExportState): string {\n  const parts = [describeExportPhase()];\n\n  if (state.result !== null) {\n    parts.push(\"\", \"ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ last compile ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\", describeCompile(state.result));\n  }\n\n  return parts.join(\"\\n\");\n}\n\n/** The budget line for whichever artifact is selected. */\nexport function describeSelectedBudget(state: ExportState): string {\n  const artifact = selectedArtifact(state);\n  if (artifact === null) return \"Nothing compiled yet.\";\n\n  return `${artifact.filename}\\n${describeBudget(artifact.budget, artifact.contents.split(\"\\n\").length, Math.round(artifact.contents.length / 4))}`;\n}\n\nexport function selectedArtifact(state: ExportState): CompiledArtifact | null {\n  if (state.result === null) return null;\n  if (state.selected === null) return state.result.artifacts[0] ?? null;\n\n  return state.result.artifacts.find((artifact) => artifact.target === state.selected) ?? null;\n}\n\nexport function describeTarget(target: ExportTarget): string {\n  return TARGET_FILENAMES[target];\n}\n\nexport function describeStamp(stamp: IntegrityStamp): string {\n  return [\n    `Log head           ${stamp.headHash.slice(0, 12)}`,\n    `Generated          ${stamp.generatedAt}`,\n    `Schema             whylog/v${stamp.schemaVersion}`,\n    `Decisions          ${stamp.decisions.total} (IN ${stamp.decisions.inLabel} ┬╖ OUT ${stamp.decisions.out} ┬╖ superseded ${stamp.decisions.superseded})`,\n    `Premises           ${stamp.premises.total} (IN ${stamp.premises.inLabel} ┬╖ OUT ${stamp.premises.out} ┬╖ contested ${stamp.premises.contested})`,\n    `Compliance         ${Math.round(stamp.compliance * 100)}%`,\n    `Coverage           ${Math.round(stamp.verifiableCoverage * 100)}%`,\n    `Guards             ${stamp.guards.passing} passing / ${stamp.guards.failing} failing`,\n    `Engine             ${stamp.engineAtGeneration}`,\n    \"\",\n    \"Auditability, NOT security. The hash is unsalted and the algorithm is in the source, so\",\n    \"anyone can recompute it ΓÇö including an agent that has just rewritten the file and the stamp\",\n    \"along with it. Compare against the log; do not trust the file.\",\n  ].join(\"\\n\");\n}\n\nexport type { DecisionId };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 22 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 22 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 22 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\retrieval\\index.ts"},"span":[5445,5460],"sourceCode":"/**\n * The retrieval pipeline ΓÇö Phase 3's entry point.\n *\n * Phase 3 ┬╖ sub-phases 3.1ΓÇô3.9\n * Plan: plan/phase-3-retrieval.md ┬º3.4, ┬º3.5, ┬º3.7\n * Docs: docs/03-retrieval-and-contradiction.md\n *\n * ---------------------------------------------------------------------------\n * ONE PASS, FIVE LEVELS, IN THIS ORDER\n *\n *   understand the query          variable, canonical value, terms, premises named\n *   L1 dense                      statement embeddings\n *   L2 dense                      HyPE inverted questions, built at extraction time\n *   L3 sparse                     BM25 over all text fields, ontology-aliased terms\n *   L4 structural                 variable / value index ΓÇö PROMOTED, not fused\n *   L5 premise                    premise ΓåÆ dependents ΓÇö PROMOTED, not fused\n *   RRF fusion at k = 60          score-agnostic, so it needs no calibration\n *   rerank                        two-stage; scores against the ORIGINAL query\n *   evidence contract             <= 3 searches, citations resolve in-run, groundedness\n *\n * ---------------------------------------------------------------------------\n * WHY L4 AND L5 ARE PROMOTED RATHER THAN FUSED\n *\n * RRF fuses RANKS. An exact structural match ΓÇö the question names `DATABASE` and the log has\n * a decision settling `DATABASE` ΓÇö is not a rank, it is a fact. Averaging a fact into a\n * statistical consensus lets four levels of weak topical agreement outvote one level of exact\n * evidence, which is precisely backwards: exact evidence outranks statistical evidence.\n *\n * So L4 and L5 matches are held at the front of the candidate order and the reranker is not\n * allowed to demote them (`rerank/index.ts`, `orderWithPromotion`). They still APPEAR in the\n * fusion so their `contributedBy` and `matchedOn` are recorded honestly ΓÇö a promoted hit that\n * also ranked well says so, and one that only matched structurally says that too.\n *\n * ---------------------------------------------------------------------------\n * THE RERANKER SCORES AGAINST THE ORIGINAL QUERY. ALWAYS.\n *\n * `rerank()` takes the query string and nothing else, so scoring against a HyDE hypothetical\n * is not expressible in this API rather than merely discouraged by a comment. HyDE would have\n * the reranker judge relevance to a document nobody wrote and whose errors would then be\n * indistinguishable from the retrieval's. arXiv:2604.01733 found query-time HyDE underperformed\n * vanilla dense outright while hybrid RRF + cross-encoder dominated; `useHyde` defaults to\n * false and the option exists for Phase 7's ablation, not for production.\n *\n * ---------------------------------------------------------------------------\n * DEGRADATION IS REPORTED, NEVER SILENT\n *\n * With no embeddings built, or after an engine change makes them stale, L1 and L2 return\n * nothing and L3/L4/L5 carry the run. That still works ΓÇö BM25 is what makes the keyless system\n * viable ΓÇö but the answer says which levels ran. A user who cannot see that two of five levels\n * were unavailable cannot tell a thin answer from a thin log.\n * ---------------------------------------------------------------------------\n */\n\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { nowISO } from \"@/lib/format\";\nimport { canonicalValueOf } from \"@/ontology\";\nimport { VARIABLE_ORDER, variableKeywords, variableMeta } from \"@/ontology/data/variables\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { queryTerms, stalenessNotice, usableLevels } from \"@/substrate/projections/indexes\";\nimport type { DecisionId, EngineId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel, DecisionVariable } from \"@/types/domain\";\nimport type {\n  Answer,\n  FusedHit,\n  IndexArtifacts,\n  IndexLevel,\n  QueryOptions,\n  RankedHit,\n  RetrievedHit,\n} from \"@/types/retrieval\";\nimport { DEFAULT_QUERY_OPTIONS } from \"@/types/retrieval\";\nimport { TOPICALITY_FLOOR, composeAnswer } from \"./answer\";\nimport { SearchTrace, searchStep } from \"./evidence-contract\";\nimport { type DenseQuery, searchL1 } from \"./index-levels/l1-dense\";\nimport { searchL2 } from \"./index-levels/l2-questions\";\nimport { searchL3 } from \"./index-levels/l3-sparse\";\nimport { type StructuralMatch, searchL4 } from \"./index-levels/l4-structural\";\nimport { type PremiseMatch, expandBySharedPremise, searchL5 } from \"./index-levels/l5-premises\";\nimport { findPreemptions } from \"./preemption\";\nimport { type RerankCandidate, rerank } from \"./rerank\";\nimport { RRF_K, type RankedList, fuse, rank } from \"./rrf\";\n\nexport { RRF_K } from \"./rrf\";\nexport { TOPICALITY_FLOOR } from \"./answer\";\n\n/* -------------------------------------------------------------------------- */\n/* Query understanding                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface UnderstoodQuery {\n  readonly question: string;\n  readonly variable: DecisionVariable | null;\n  readonly value: string | null;\n  readonly terms: readonly string[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly explanation: string;\n}\n\n/**\n * Read the question. No model, no embedding ΓÇö the variable and value are matched against the\n * ontology's own vocabulary, which is the same vocabulary extraction used, so a question\n * phrased in the terms the log was built from resolves exactly.\n */\nexport function understandQuery(state: GraphState, question: string): UnderstoodQuery {\n  const folded = question.toLowerCase();\n  const terms = queryTerms(question);\n\n  let variable: DecisionVariable | null = null;\n  let value: string | null = null;\n  const why: string[] = [];\n\n  /* Value first: a named value implies its variable and is the more specific signal, so it\n   * wins when both are present. `variableKeywords()` is the same keyword table extraction\n   * uses, which is what makes a question phrased in the log's own vocabulary resolve exactly\n   * rather than approximately. */\n  const keywords = variableKeywords();\n\n  outer: for (const slot of VARIABLE_ORDER) {\n    const meta = variableMeta(slot);\n    for (const candidate of meta.commonValues) {\n      const foldedCandidate = candidate.toLowerCase();\n      if (foldedCandidate.length < 3) continue;\n      if (!folded.includes(foldedCandidate)) continue;\n\n      variable = slot;\n      value = canonicalValueOf(slot, candidate);\n      why.push(`\"${candidate}\" is a known ${slot} value`);\n      break outer;\n    }\n  }\n\n  /* Then the variable by its own keywords, for questions that name the slot without a value\n   * (\"what did we decide about the database?\"). */\n  if (variable === null) {\n    for (const [keyword, slots] of keywords) {\n      if (keyword.length < 3 || !folded.includes(keyword)) continue;\n      const slot = slots[0];\n      if (slot === undefined) continue;\n      variable = slot;\n      why.push(`\"${keyword}\" is a ${slot} keyword`);\n      break;\n    }\n  }\n\n  const premiseIds = premisesNamedBy(state, terms);\n  if (premiseIds.length > 0) {\n    why.push(`${premiseIds.length} premise(s) share vocabulary with the question`);\n  }\n\n  if (variable === null)\n    why.push(\"no known variable or value appears in the question, so L4 cannot fire\");\n\n  return {\n    question,\n    variable,\n    value,\n    terms,\n    premiseIds,\n    explanation: `${why.join(\"; \")}.`,\n  };\n}\n\n/**\n * Premises the question appears to name.\n *\n * Requires at least two shared content tokens: a single shared token (\"app\", \"server\", \"cost\")\n * would pull in half the log and turn a precise L5 promotion into noise. Promotions are held\n * at the front of the ranking and cannot be demoted, so a loose match here is more damaging\n * than a missed one.\n */\nexport function premisesNamedBy(state: GraphState, terms: readonly string[]): readonly PremiseId[] {\n  const querySet = new Set(terms.filter((term) => term.length > 2));\n  const out: PremiseId[] = [];\n\n  for (const premise of state.premises.values()) {\n    const tokens = new Set(\n      premise.text\n        .toLowerCase()\n        .split(/[^a-z0-9]+/)\n        .filter((token) => token.length > 2),\n    );\n\n    let shared = 0;\n    for (const token of tokens) {\n      if (querySet.has(token)) shared += 1;\n    }\n\n    if (shared >= MIN_PREMISE_TOKEN_OVERLAP) out.push(premise.id);\n  }\n\n  return out;\n}\n\nexport const MIN_PREMISE_TOKEN_OVERLAP = 2;\n\n/* -------------------------------------------------------------------------- */\n/* Retrieval                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface RetrieveInput {\n  readonly state: GraphState;\n  readonly artifacts: IndexArtifacts;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly engine: WhyLogEngine;\n  readonly question: string;\n  readonly options?: Partial<QueryOptions>;\n  readonly signal?: AbortSignal;\n}\n\nexport interface RetrievalResult {\n  readonly hits: readonly RetrievedHit[];\n  readonly fused: readonly FusedHit[];\n  readonly understood: UnderstoodQuery;\n  readonly levels: readonly IndexLevel[];\n  readonly levelsUnavailable: readonly IndexLevel[];\n  readonly notice: string | null;\n  readonly method: string;\n  readonly durationMs: number;\n}\n\n/**\n * Retrieve and rank. This is the whole of ┬º3.1ΓÇô┬º3.5 in one call.\n *\n * Retrieval PROPOSES. It never classifies a pair and never produces a verdict ΓÇö invariant I3.\n * The scores it returns select candidates for `contradiction.ts`, which then discards them.\n */\n/**\n * Merge the caller's options over the defaults.\n *\n * A plain spread is not enough: `QueryOptions` fields are optional, and\n * spreading an optional over a required default yields `number | undefined` ΓÇö\n * so `options.topK` would be possibly-undefined at every use, even though a\n * default always exists. Resolving each field explicitly keeps the resolved\n * options total, which is what the rest of the retrieval stack assumes.\n */\nfunction resolveQueryOptions(options: QueryOptions | undefined): Required<\n  Pick<QueryOptions, \"topK\" | \"recallK\" | \"rrfK\" | \"useHyde\" | \"includeSuperseded\">\n> & {\n  readonly levels: readonly IndexLevel[] | undefined;\n} {\n  return {\n    topK: options?.topK ?? DEFAULT_QUERY_OPTIONS.topK,\n    recallK: options?.recallK ?? DEFAULT_QUERY_OPTIONS.recallK,\n    rrfK: options?.rrfK ?? DEFAULT_QUERY_OPTIONS.rrfK,\n    useHyde: options?.useHyde ?? DEFAULT_QUERY_OPTIONS.useHyde,\n    includeSuperseded: options?.includeSuperseded ?? DEFAULT_QUERY_OPTIONS.includeSuperseded,\n    levels: options?.levels,\n  };\n}\n\nexport async function retrieve(input: RetrieveInput): Promise<RetrievalResult> {\n  const started = Date.now();\n  const options = resolveQueryOptions(input.options);\n  const understood = understandQuery(input.state, input.question);\n  const levels = usableLevels(input.state);\n  const lists: RankedList[] = [];\n  const perLevelScores = new Map<DecisionId, Map<IndexLevel, number>>();\n\n  /* ---- L1 + L2: dense. One embedding call for the question. ---- */\n  let queryVector: Float32Array | null = null;\n  if (levels.includes(\"L1\") || levels.includes(\"L2\")) {\n    const embedded = await input.engine.embed([understood.question], input.signal);\n    const vector = embedded.vectors[0];\n    if (vector !== undefined) queryVector = vector;\n  }\n\n  if (queryVector !== null) {\n    const denseQuery: DenseQuery = { queryVector, k: options.recallK };\n    const l1 = searchL1(input.artifacts, denseQuery);\n    lists.push({ level: \"L1\", hits: l1 });\n    record(perLevelScores, \"L1\", l1);\n\n    const l2 = searchL2(input.artifacts, queryVector, options.recallK);\n    lists.push({ level: \"L2\", hits: l2 });\n    record(perLevelScores, \"L2\", l2);\n  }\n\n  /* ---- L3: sparse. Carries the keyless system. ---- */\n  const l3 = searchL3(input.artifacts, understood.terms, options.recallK);\n  lists.push({ level: \"L3\", hits: l3 });\n  record(perLevelScores, \"L3\", l3);\n\n  /* ---- L4 + L5: exact evidence, promoted rather than fused. ---- */\n  const structural = searchL4(input.artifacts, understood.variable, understood.value);\n  const premiseMatches = searchL5(\n    input.artifacts,\n    understood.premiseIds,\n    \"query-named\",\n    (id) => input.state.premises.get(id)?.text ?? id,\n  );\n\n  const l4Ranked = asRanked(\"L4\", structural);\n  const l5Ranked = asRanked(\"L5\", premiseMatches);\n  lists.push({ level: \"L4\", hits: l4Ranked });\n  lists.push({ level: \"L5\", hits: l5Ranked });\n  record(perLevelScores, \"L4\", l4Ranked);\n  record(perLevelScores, \"L5\", l5Ranked);\n\n  /* ---- fuse ---- */\n  const fused = fuse(lists, options.rrfK);\n\n  const promotedIds = new Set<DecisionId>([\n    ...structural.map((match) => match.decisionId),\n    ...premiseMatches.map((match) => match.decisionId),\n  ]);\n\n  /* ---- build rerank candidates ---- */\n  const candidates: RerankCandidate[] = fused.map((hit) => ({\n    decisionId: hit.decisionId,\n    denseScore: denseScoreOf(perLevelScores, hit.decisionId),\n    sparseScore: scoreOf(perLevelScores, hit.decisionId, \"L3\"),\n    sparseRank: rankOf(lists, \"L3\", hit.decisionId),\n    structural: structural.find((match) => match.decisionId === hit.decisionId) ?? null,\n    premise: premiseMatches.find((match) => match.decisionId === hit.decisionId) ?? null,\n    promoted: promotedIds.has(hit.decisionId),\n  }));\n\n  /* Promoted candidates the fusion never surfaced ΓÇö an exact match with no lexical or dense\n   * agreement at all. It still belongs in the order; losing it would lose the one result that\n   * is certain. */\n  for (const id of promotedIds) {\n    if (candidates.some((candidate) => candidate.decisionId === id)) continue;\n    candidates.push({\n      decisionId: id,\n      denseScore: null,\n      sparseScore: 0,\n      sparseRank: 0,\n      structural: structural.find((match) => match.decisionId === id) ?? null,\n      premise: premiseMatches.find((match) => match.decisionId === id) ?? null,\n      promoted: true,\n    });\n  }\n\n  /* ---- rerank: second stage, against the ORIGINAL query ---- */\n  const ranked = await rerank({\n    query: understood.question,\n    candidates,\n    artifacts: input.artifacts,\n    state: input.state,\n    engine: input.engine,\n    queryTerms: understood.terms,\n    queryPremises: understood.premiseIds,\n    topK: options.topK,\n    now: Date.now(),\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n\n  const scoredBy = new Map(ranked.scored.map((entry) => [entry.candidate.decisionId, entry]));\n  const rrfBy = new Map(fused.map((hit) => [hit.decisionId, hit]));\n\n  const hits: RetrievedHit[] = [];\n  for (const [index, decisionId] of ranked.order.entries()) {\n    if (!options.includeSuperseded) {\n      const decision = input.state.decisions.get(decisionId);\n      if (\n        decision !== undefined &&\n        (decision.status === \"superseded\" || decision.status === \"archived\")\n      )\n        continue;\n    }\n\n    const decision = input.state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    const fusedHit = rrfBy.get(decisionId);\n    const scored = scoredBy.get(decisionId);\n\n    hits.push({\n      decisionId,\n      decision,\n      finalScore: scored?.total ?? fusedHit?.rrf ?? 0,\n      rrf: fusedHit?.rrf ?? 0,\n      ...(scored === undefined ? {} : { rerankScore: scored.total }),\n      matchedOn:\n        fusedHit === undefined\n          ? promotedLevelsOf(structural, premiseMatches, decisionId)\n          : [...fusedHit.contributedBy],\n      promoted: promotedIds.has(decisionId),\n    });\n\n    if (index >= options.topK) break;\n  }\n\n  const unavailable = ([\"L1\", \"L2\"] as const).filter((level) => !levels.includes(level));\n\n  return {\n    hits,\n    fused,\n    understood,\n    levels,\n    levelsUnavailable: unavailable,\n    notice: stalenessNotice(input.state),\n    method: ranked.method,\n    durationMs: Date.now() - started,\n  };\n}\n\nfunction record(\n  into: Map<DecisionId, Map<IndexLevel, number>>,\n  level: IndexLevel,\n  hits: readonly RankedHit[],\n): void {\n  for (const hit of hits) {\n    const existing = into.get(hit.decisionId);\n    if (existing === undefined) into.set(hit.decisionId, new Map([[level, hit.score]]));\n    else existing.set(level, hit.score);\n  }\n}\n\nfunction scoreOf(\n  scores: Map<DecisionId, Map<IndexLevel, number>>,\n  id: DecisionId,\n  level: IndexLevel,\n): number {\n  return scores.get(id)?.get(level) ?? 0;\n}\n\nfunction denseScoreOf(\n  scores: Map<DecisionId, Map<IndexLevel, number>>,\n  id: DecisionId,\n): number | null {\n  const entry = scores.get(id);\n  if (entry === undefined) return null;\n  const l1 = entry.get(\"L1\");\n  const l2 = entry.get(\"L2\");\n  if (l1 === undefined && l2 === undefined) return null;\n  /* The better of the two: L2 matches the question someone WOULD ask about this decision,\n   * L1 matches its statement. Which one is closer depends on how the user phrased it, and\n   * taking the max lets either win without a calibration constant between them. */\n  return Math.max(l1 ?? Number.NEGATIVE_INFINITY, l2 ?? Number.NEGATIVE_INFINITY);\n}\n\nfunction rankOf(lists: readonly RankedList[], level: IndexLevel, id: DecisionId): number {\n  const list = lists.find((entry) => entry.level === level);\n  return list?.hits.find((hit) => hit.decisionId === id)?.rank ?? 0;\n}\n\n/** L4/L5 matches carry no score of their own ΓÇö an exact match is not a graded one. They enter\n *  the fusion at rank order of specificity (value matches before variable matches, which the\n *  search functions already produce) and are promoted regardless of score. */\nfunction asRanked(\n  level: IndexLevel,\n  matches: readonly { decisionId: DecisionId }[],\n): readonly RankedHit[] {\n  return rank(\n    level,\n    matches.map((match, index) => ({ id: match.decisionId, score: matches.length - index })),\n  );\n}\n\nfunction promotedLevelsOf(\n  structural: readonly StructuralMatch[],\n  premises: readonly PremiseMatch[],\n  id: DecisionId,\n): readonly IndexLevel[] {\n  const out: IndexLevel[] = [];\n  if (structural.some((match) => match.decisionId === id)) out.push(\"L4\");\n  if (premises.some((match) => match.decisionId === id)) out.push(\"L5\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Ask ΓÇö retrieval plus the evidence contract                                 */\n/* -------------------------------------------------------------------------- */\n\nexport interface AskInput extends RetrieveInput {\n  readonly engineId: EngineId;\n  readonly forceLocalRerank?: boolean;\n}\n\n/**\n * Answer a question under the evidence contract.\n *\n * At most three searches, each with a distinct purpose, each recorded:\n *\n *   1. THE QUESTION as asked ΓÇö all five levels, fused and reranked.\n *   2. EXPANSION BY SHARED PREMISE ΓÇö only if search 1 was thin. Decisions resting on the same\n *      premises as search 1's hits answer many questions that the question's own vocabulary\n *      does not match, because they share the `given` rather than the wording.\n *   3. PREMISE QUESTIONS ΓÇö only if still thin. HyPE's inverted questions rephrased as the\n *      query, catching a decision recorded in different words from the ones asked.\n *\n * The budget is what makes refusal reachable. Without it, \"not found\" always means \"have not\n * looked hard enough yet\", and a system that can always look again never has to say it does\n * not know.\n */\nexport async function ask(input: AskInput): Promise<Answer> {\n  const trace = new SearchTrace();\n  const answeredAt = nowISO();\n\n  /* ---- search 1 ---- */\n  const first = await retrieve(input);\n  trace.note(first.hits.map((hit) => hit.decisionId));\n  const recorded1 = trace.record(\n    searchStep(\n      first.understood.question,\n      first.levels,\n      first.hits.length,\n      first.hits[0]?.finalScore ?? 0,\n      `The question as asked, over all five levels. ${first.understood.explanation}`,\n    ),\n  );\n\n  let hits = first.hits;\n\n  /* ---- search 2: expansion by shared premise, only when thin ---- */\n  if (recorded1 && isThin(hits)) {\n    const seeds = hits.map((hit) => hit.decisionId);\n    const expanded = seeds.length === 0 ? [] : expandBySharedPremise(input.artifacts, seeds);\n\n    const before = new Set(seeds);\n    const added = expanded.filter((id) => !before.has(id));\n    trace.note(added);\n\n    const recorded2 = trace.record(\n      searchStep(\n        `decisions sharing a premise with: ${seeds.join(\", \")}`,\n        [\"L5\"],\n        added.length,\n        0,\n        added.length === 0\n          ? \"Search 1 was thin, so the run expanded along shared premises. Nothing new came back ΓÇö no other decision rests on the same assumptions as these.\"\n          : \"Search 1 was thin, so the run expanded along shared premises: decisions resting on the same `given` often answer a question whose wording does not match.\",\n      ),\n    );\n\n    if (added.length > 0) {\n      const merged: RetrievedHit[] = [...hits];\n      for (const decisionId of added) {\n        const decision = input.state.decisions.get(decisionId);\n        if (decision === undefined) continue;\n        merged.push({\n          decisionId,\n          decision,\n          /* Scored at the topicality floor rather than at a computed value. A shared-premise\n           * expansion is an EXACT relation ΓÇö same `given` ΓÇö so it is promoted, and giving it a\n           * fabricated numeric score would imply a ranking nobody computed. */\n          finalScore: TOPICALITY_FLOOR,\n          rrf: 0,\n          matchedOn: [\"L5\"],\n          promoted: true,\n        });\n      }\n      hits = merged;\n    }\n\n    /* ---- search 3: HyPE questions as the query, only when still thin ---- */\n    if (recorded2 && isThin(hits)) {\n      const questionHits = await searchByPremiseQuestions(input, hits, trace);\n      if (questionHits.length > 0) hits = [...hits, ...questionHits];\n    }\n  }\n\n  /* ---- pre-emption: checked on every ask, not only on thin ones ---- */\n  const preemptions = findPreemptions(\n    input.state,\n    input.labels,\n    input.question,\n    first.understood.terms,\n  );\n\n  /* ---- compose under the contract ---- */\n  const labels = new Map<DecisionId, DecisionLabel>();\n  for (const hit of hits) {\n    labels.set(hit.decisionId, input.labels.get(hit.decisionId)?.label ?? hit.decision.label);\n  }\n\n  const premisesOf = new Map<DecisionId, readonly string[]>();\n  for (const hit of hits) {\n    premisesOf.set(hit.decisionId, premiseLines(input.state, input.labels, hit.decisionId));\n  }\n\n  return composeAnswer({\n    question: input.question,\n    retrieved: hits,\n    engine: input.engine,\n    engineId: input.engineId,\n    trace,\n    labels,\n    premisesOf,\n    preemptions,\n    logSize: input.state.decisions.size,\n    answeredAt,\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n}\n\n/** Thin means too few hits to answer from. Two is the floor: one decision can be quoted, but\n *  a single hit gives the reader nothing to compare it against and no way to notice that the\n *  retrieval missed the decision that actually matters. */\nexport function isThin(hits: readonly RetrievedHit[]): boolean {\n  return hits.filter((hit) => hit.promoted || hit.finalScore >= TOPICALITY_FLOOR).length < 2;\n}\n\nasync function searchByPremiseQuestions(\n  input: AskInput,\n  current: readonly RetrievedHit[],\n  trace: SearchTrace,\n): Promise<readonly RetrievedHit[]> {\n  /* Re-query with the questions the log itself would ask about the premises already in play.\n   * This is HyPE's inverted-question index used from the other direction: instead of matching\n   * a question to a decision's questions, match the decision's questions to the corpus. */\n  const seed = premisesOfHits(input.state, current);\n  const questionText = seed\n    .map((id) => input.state.premises.get(id)?.text ?? \"\")\n    .filter((text) => text.length > 0)\n    .join(\" \");\n\n  if (questionText.length === 0) {\n    trace.markBoundedOut();\n    return [];\n  }\n\n  const terms = queryTerms(questionText);\n  const l3 = searchL3(input.artifacts, terms, DEFAULT_QUERY_OPTIONS.recallK);\n\n  const before = new Set(current.map((hit) => hit.decisionId));\n  const added: RetrievedHit[] = [];\n  const notedIds: DecisionId[] = [];\n\n  for (const hit of l3) {\n    if (before.has(hit.decisionId)) continue;\n    const decision = input.state.decisions.get(hit.decisionId);\n    if (decision === undefined) continue;\n    before.add(hit.decisionId);\n    notedIds.push(hit.decisionId);\n    added.push({\n      decisionId: hit.decisionId,\n      decision,\n      finalScore: hit.score,\n      rrf: 0,\n      matchedOn: [\"L3\"],\n      promoted: false,\n    });\n  }\n\n  trace.note(notedIds);\n  trace.record(\n    searchStep(\n      questionText.slice(0, 120),\n      [\"L3\"],\n      added.length,\n      added[0]?.finalScore ?? 0,\n      added.length === 0\n        ? \"Still thin, so the run re-queried with the premises' own vocabulary. Nothing further came back ΓÇö this is the last search the contract allows, and the answer will say so.\"\n        : \"Still thin, so the run re-queried with the premises' own vocabulary rather than the question's wording.\",\n    ),\n  );\n\n  return added;\n}\n\n/** One pass over the fold's own premise ΓåÆ decisions index, not a scan per hit. */\nfunction premisesOfHits(state: GraphState, hits: readonly RetrievedHit[]): readonly PremiseId[] {\n  const wanted = new Set(hits.map((hit) => hit.decisionId));\n  const out = new Set<PremiseId>();\n\n  for (const [premiseId, dependents] of state.premiseToDecisions) {\n    if (dependents.some((id) => wanted.has(id))) out.add(premiseId);\n  }\n\n  return [...out];\n}\n\n/** The premises as the composer will quote them: id, text, LIVE label. */\nfunction premiseLines(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: DecisionId,\n): readonly string[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: string[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n      const label = labels.get(premiseId)?.label ?? premise.label;\n      out.push(`${premiseId} \"${premise.text}\" (${label})`);\n    }\n  }\n\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeRetrieval(result: RetrievalResult): string {\n  const lines = [\n    `Levels available: ${result.levels.join(\", \")}${result.levelsUnavailable.length > 0 ? `  (unavailable: ${result.levelsUnavailable.join(\", \")})` : \"\"}`,\n    `Query read as: ${result.understood.explanation}`,\n    `Fusion: RRF at k = ${RRF_K} ΓÇö ranks only, so no score calibration between levels.`,\n    `Rerank: ${result.method}, scored against the ORIGINAL query.`,\n    `Candidates: ${result.fused.length} fused ΓåÆ ${result.hits.length} returned.`,\n    `Took ${result.durationMs} ms.`,\n  ];\n\n  if (result.notice !== null) lines.push(`Note: ${result.notice}`);\n\n  return lines.join(\"\\n\");\n}\n\nexport function describePipeline(): string {\n  return [\n    \"Retrieval pipeline ΓÇö five levels, fused, then reranked, then bound:\",\n    \"\",\n    \"  L1 dense       statement embeddings\",\n    \"  L2 dense       HyPE inverted questions, generated at extraction time, zero extra LLM calls\",\n    \"  L3 sparse      BM25 over all text fields, ontology-aliased terms ΓÇö carries the keyless system\",\n    \"  L4 structural  variable / value index ΓÇö PROMOTED, not fused\",\n    \"  L5 premise     premise ΓåÆ dependents ΓÇö PROMOTED, not fused\",\n    \"\",\n    \"L4 and L5 are promoted rather than fused because an exact match is a FACT, not a rank.\",\n    \"Averaging a fact into a statistical consensus lets four levels of weak topical agreement\",\n    \"outvote one level of exact evidence, which is backwards. The reranker cannot demote them.\",\n    \"\",\n    `Fusion is RRF at k = ${RRF_K}. It reads ranks and never scores, so it needs no`,\n    \"calibration between a cosine in [-1,1] and a BM25 score with no upper bound.\",\n    \"\",\n    \"The reranker scores against the ORIGINAL QUERY. `rerank()` takes the query string and\",\n    \"nothing else, so scoring against a HyDE hypothetical is not expressible here rather than\",\n    \"merely discouraged by a comment.\",\n    \"\",\n    \"Retrieval PROPOSES; it never classifies. Invariant I3: no score produced here decides a\",\n    \"contradiction ΓÇö the classifier in ./contradiction.ts reads no score at all.\",\n  ].join(\"\\n\");\n}\n\nexport { composeAnswer, describeComposition } from \"./answer\";\nexport { groundednessOf, describeThresholds } from \"./groundedness\";\nexport {\n  MAX_SEARCHES,\n  SearchTrace,\n  describeContract,\n  resolveCitations,\n} from \"./evidence-contract\";\nexport {\n  classifyPair,\n  classifyPairs,\n  isClassifiable,\n  describeRules,\n  describeVerdict as describeContradictionVerdict,\n  requestFor,\n} from \"./contradiction\";\nexport { findPreemptions, renderPreemption, countPreemptions } from \"./preemption\";\nexport { expandCitation, expandAll, renderExpansion, renderInline } from \"./citations\";\nexport { buildIndex, describeBuild, type BuildReport } from \"./build-index\";\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 29 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 29 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 29 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\retrieval\\index.ts"},"span":[10602,10610],"sourceCode":"/**\n * The retrieval pipeline ΓÇö Phase 3's entry point.\n *\n * Phase 3 ┬╖ sub-phases 3.1ΓÇô3.9\n * Plan: plan/phase-3-retrieval.md ┬º3.4, ┬º3.5, ┬º3.7\n * Docs: docs/03-retrieval-and-contradiction.md\n *\n * ---------------------------------------------------------------------------\n * ONE PASS, FIVE LEVELS, IN THIS ORDER\n *\n *   understand the query          variable, canonical value, terms, premises named\n *   L1 dense                      statement embeddings\n *   L2 dense                      HyPE inverted questions, built at extraction time\n *   L3 sparse                     BM25 over all text fields, ontology-aliased terms\n *   L4 structural                 variable / value index ΓÇö PROMOTED, not fused\n *   L5 premise                    premise ΓåÆ dependents ΓÇö PROMOTED, not fused\n *   RRF fusion at k = 60          score-agnostic, so it needs no calibration\n *   rerank                        two-stage; scores against the ORIGINAL query\n *   evidence contract             <= 3 searches, citations resolve in-run, groundedness\n *\n * ---------------------------------------------------------------------------\n * WHY L4 AND L5 ARE PROMOTED RATHER THAN FUSED\n *\n * RRF fuses RANKS. An exact structural match ΓÇö the question names `DATABASE` and the log has\n * a decision settling `DATABASE` ΓÇö is not a rank, it is a fact. Averaging a fact into a\n * statistical consensus lets four levels of weak topical agreement outvote one level of exact\n * evidence, which is precisely backwards: exact evidence outranks statistical evidence.\n *\n * So L4 and L5 matches are held at the front of the candidate order and the reranker is not\n * allowed to demote them (`rerank/index.ts`, `orderWithPromotion`). They still APPEAR in the\n * fusion so their `contributedBy` and `matchedOn` are recorded honestly ΓÇö a promoted hit that\n * also ranked well says so, and one that only matched structurally says that too.\n *\n * ---------------------------------------------------------------------------\n * THE RERANKER SCORES AGAINST THE ORIGINAL QUERY. ALWAYS.\n *\n * `rerank()` takes the query string and nothing else, so scoring against a HyDE hypothetical\n * is not expressible in this API rather than merely discouraged by a comment. HyDE would have\n * the reranker judge relevance to a document nobody wrote and whose errors would then be\n * indistinguishable from the retrieval's. arXiv:2604.01733 found query-time HyDE underperformed\n * vanilla dense outright while hybrid RRF + cross-encoder dominated; `useHyde` defaults to\n * false and the option exists for Phase 7's ablation, not for production.\n *\n * ---------------------------------------------------------------------------\n * DEGRADATION IS REPORTED, NEVER SILENT\n *\n * With no embeddings built, or after an engine change makes them stale, L1 and L2 return\n * nothing and L3/L4/L5 carry the run. That still works ΓÇö BM25 is what makes the keyless system\n * viable ΓÇö but the answer says which levels ran. A user who cannot see that two of five levels\n * were unavailable cannot tell a thin answer from a thin log.\n * ---------------------------------------------------------------------------\n */\n\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { nowISO } from \"@/lib/format\";\nimport { canonicalValueOf } from \"@/ontology\";\nimport { VARIABLE_ORDER, variableKeywords, variableMeta } from \"@/ontology/data/variables\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { queryTerms, stalenessNotice, usableLevels } from \"@/substrate/projections/indexes\";\nimport type { DecisionId, EngineId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel, DecisionVariable } from \"@/types/domain\";\nimport type {\n  Answer,\n  FusedHit,\n  IndexArtifacts,\n  IndexLevel,\n  QueryOptions,\n  RankedHit,\n  RetrievedHit,\n} from \"@/types/retrieval\";\nimport { DEFAULT_QUERY_OPTIONS } from \"@/types/retrieval\";\nimport { TOPICALITY_FLOOR, composeAnswer } from \"./answer\";\nimport { SearchTrace, searchStep } from \"./evidence-contract\";\nimport { type DenseQuery, searchL1 } from \"./index-levels/l1-dense\";\nimport { searchL2 } from \"./index-levels/l2-questions\";\nimport { searchL3 } from \"./index-levels/l3-sparse\";\nimport { type StructuralMatch, searchL4 } from \"./index-levels/l4-structural\";\nimport { type PremiseMatch, expandBySharedPremise, searchL5 } from \"./index-levels/l5-premises\";\nimport { findPreemptions } from \"./preemption\";\nimport { type RerankCandidate, rerank } from \"./rerank\";\nimport { RRF_K, type RankedList, fuse, rank } from \"./rrf\";\n\nexport { RRF_K } from \"./rrf\";\nexport { TOPICALITY_FLOOR } from \"./answer\";\n\n/* -------------------------------------------------------------------------- */\n/* Query understanding                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface UnderstoodQuery {\n  readonly question: string;\n  readonly variable: DecisionVariable | null;\n  readonly value: string | null;\n  readonly terms: readonly string[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly explanation: string;\n}\n\n/**\n * Read the question. No model, no embedding ΓÇö the variable and value are matched against the\n * ontology's own vocabulary, which is the same vocabulary extraction used, so a question\n * phrased in the terms the log was built from resolves exactly.\n */\nexport function understandQuery(state: GraphState, question: string): UnderstoodQuery {\n  const folded = question.toLowerCase();\n  const terms = queryTerms(question);\n\n  let variable: DecisionVariable | null = null;\n  let value: string | null = null;\n  const why: string[] = [];\n\n  /* Value first: a named value implies its variable and is the more specific signal, so it\n   * wins when both are present. `variableKeywords()` is the same keyword table extraction\n   * uses, which is what makes a question phrased in the log's own vocabulary resolve exactly\n   * rather than approximately. */\n  const keywords = variableKeywords();\n\n  outer: for (const slot of VARIABLE_ORDER) {\n    const meta = variableMeta(slot);\n    for (const candidate of meta.commonValues) {\n      const foldedCandidate = candidate.toLowerCase();\n      if (foldedCandidate.length < 3) continue;\n      if (!folded.includes(foldedCandidate)) continue;\n\n      variable = slot;\n      value = canonicalValueOf(slot, candidate);\n      why.push(`\"${candidate}\" is a known ${slot} value`);\n      break outer;\n    }\n  }\n\n  /* Then the variable by its own keywords, for questions that name the slot without a value\n   * (\"what did we decide about the database?\"). */\n  if (variable === null) {\n    for (const [keyword, slots] of keywords) {\n      if (keyword.length < 3 || !folded.includes(keyword)) continue;\n      const slot = slots[0];\n      if (slot === undefined) continue;\n      variable = slot;\n      why.push(`\"${keyword}\" is a ${slot} keyword`);\n      break;\n    }\n  }\n\n  const premiseIds = premisesNamedBy(state, terms);\n  if (premiseIds.length > 0) {\n    why.push(`${premiseIds.length} premise(s) share vocabulary with the question`);\n  }\n\n  if (variable === null)\n    why.push(\"no known variable or value appears in the question, so L4 cannot fire\");\n\n  return {\n    question,\n    variable,\n    value,\n    terms,\n    premiseIds,\n    explanation: `${why.join(\"; \")}.`,\n  };\n}\n\n/**\n * Premises the question appears to name.\n *\n * Requires at least two shared content tokens: a single shared token (\"app\", \"server\", \"cost\")\n * would pull in half the log and turn a precise L5 promotion into noise. Promotions are held\n * at the front of the ranking and cannot be demoted, so a loose match here is more damaging\n * than a missed one.\n */\nexport function premisesNamedBy(state: GraphState, terms: readonly string[]): readonly PremiseId[] {\n  const querySet = new Set(terms.filter((term) => term.length > 2));\n  const out: PremiseId[] = [];\n\n  for (const premise of state.premises.values()) {\n    const tokens = new Set(\n      premise.text\n        .toLowerCase()\n        .split(/[^a-z0-9]+/)\n        .filter((token) => token.length > 2),\n    );\n\n    let shared = 0;\n    for (const token of tokens) {\n      if (querySet.has(token)) shared += 1;\n    }\n\n    if (shared >= MIN_PREMISE_TOKEN_OVERLAP) out.push(premise.id);\n  }\n\n  return out;\n}\n\nexport const MIN_PREMISE_TOKEN_OVERLAP = 2;\n\n/* -------------------------------------------------------------------------- */\n/* Retrieval                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface RetrieveInput {\n  readonly state: GraphState;\n  readonly artifacts: IndexArtifacts;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly engine: WhyLogEngine;\n  readonly question: string;\n  readonly options?: Partial<QueryOptions>;\n  readonly signal?: AbortSignal;\n}\n\nexport interface RetrievalResult {\n  readonly hits: readonly RetrievedHit[];\n  readonly fused: readonly FusedHit[];\n  readonly understood: UnderstoodQuery;\n  readonly levels: readonly IndexLevel[];\n  readonly levelsUnavailable: readonly IndexLevel[];\n  readonly notice: string | null;\n  readonly method: string;\n  readonly durationMs: number;\n}\n\n/**\n * Retrieve and rank. This is the whole of ┬º3.1ΓÇô┬º3.5 in one call.\n *\n * Retrieval PROPOSES. It never classifies a pair and never produces a verdict ΓÇö invariant I3.\n * The scores it returns select candidates for `contradiction.ts`, which then discards them.\n */\n/**\n * Merge the caller's options over the defaults.\n *\n * A plain spread is not enough: `QueryOptions` fields are optional, and\n * spreading an optional over a required default yields `number | undefined` ΓÇö\n * so `options.topK` would be possibly-undefined at every use, even though a\n * default always exists. Resolving each field explicitly keeps the resolved\n * options total, which is what the rest of the retrieval stack assumes.\n */\nfunction resolveQueryOptions(options: QueryOptions | undefined): Required<\n  Pick<QueryOptions, \"topK\" | \"recallK\" | \"rrfK\" | \"useHyde\" | \"includeSuperseded\">\n> & {\n  readonly levels: readonly IndexLevel[] | undefined;\n} {\n  return {\n    topK: options?.topK ?? DEFAULT_QUERY_OPTIONS.topK,\n    recallK: options?.recallK ?? DEFAULT_QUERY_OPTIONS.recallK,\n    rrfK: options?.rrfK ?? DEFAULT_QUERY_OPTIONS.rrfK,\n    useHyde: options?.useHyde ?? DEFAULT_QUERY_OPTIONS.useHyde,\n    includeSuperseded: options?.includeSuperseded ?? DEFAULT_QUERY_OPTIONS.includeSuperseded,\n    levels: options?.levels,\n  };\n}\n\nexport async function retrieve(input: RetrieveInput): Promise<RetrievalResult> {\n  const started = Date.now();\n  const options = resolveQueryOptions(input.options);\n  const understood = understandQuery(input.state, input.question);\n  const levels = usableLevels(input.state);\n  const lists: RankedList[] = [];\n  const perLevelScores = new Map<DecisionId, Map<IndexLevel, number>>();\n\n  /* ---- L1 + L2: dense. One embedding call for the question. ---- */\n  let queryVector: Float32Array | null = null;\n  if (levels.includes(\"L1\") || levels.includes(\"L2\")) {\n    const embedded = await input.engine.embed([understood.question], input.signal);\n    const vector = embedded.vectors[0];\n    if (vector !== undefined) queryVector = vector;\n  }\n\n  if (queryVector !== null) {\n    const denseQuery: DenseQuery = { queryVector, k: options.recallK };\n    const l1 = searchL1(input.artifacts, denseQuery);\n    lists.push({ level: \"L1\", hits: l1 });\n    record(perLevelScores, \"L1\", l1);\n\n    const l2 = searchL2(input.artifacts, queryVector, options.recallK);\n    lists.push({ level: \"L2\", hits: l2 });\n    record(perLevelScores, \"L2\", l2);\n  }\n\n  /* ---- L3: sparse. Carries the keyless system. ---- */\n  const l3 = searchL3(input.artifacts, understood.terms, options.recallK);\n  lists.push({ level: \"L3\", hits: l3 });\n  record(perLevelScores, \"L3\", l3);\n\n  /* ---- L4 + L5: exact evidence, promoted rather than fused. ---- */\n  const structural = searchL4(input.artifacts, understood.variable, understood.value);\n  const premiseMatches = searchL5(\n    input.artifacts,\n    understood.premiseIds,\n    \"query-named\",\n    (id) => input.state.premises.get(id)?.text ?? id,\n  );\n\n  const l4Ranked = asRanked(\"L4\", structural);\n  const l5Ranked = asRanked(\"L5\", premiseMatches);\n  lists.push({ level: \"L4\", hits: l4Ranked });\n  lists.push({ level: \"L5\", hits: l5Ranked });\n  record(perLevelScores, \"L4\", l4Ranked);\n  record(perLevelScores, \"L5\", l5Ranked);\n\n  /* ---- fuse ---- */\n  const fused = fuse(lists, options.rrfK);\n\n  const promotedIds = new Set<DecisionId>([\n    ...structural.map((match) => match.decisionId),\n    ...premiseMatches.map((match) => match.decisionId),\n  ]);\n\n  /* ---- build rerank candidates ---- */\n  const candidates: RerankCandidate[] = fused.map((hit) => ({\n    decisionId: hit.decisionId,\n    denseScore: denseScoreOf(perLevelScores, hit.decisionId),\n    sparseScore: scoreOf(perLevelScores, hit.decisionId, \"L3\"),\n    sparseRank: rankOf(lists, \"L3\", hit.decisionId),\n    structural: structural.find((match) => match.decisionId === hit.decisionId) ?? null,\n    premise: premiseMatches.find((match) => match.decisionId === hit.decisionId) ?? null,\n    promoted: promotedIds.has(hit.decisionId),\n  }));\n\n  /* Promoted candidates the fusion never surfaced ΓÇö an exact match with no lexical or dense\n   * agreement at all. It still belongs in the order; losing it would lose the one result that\n   * is certain. */\n  for (const id of promotedIds) {\n    if (candidates.some((candidate) => candidate.decisionId === id)) continue;\n    candidates.push({\n      decisionId: id,\n      denseScore: null,\n      sparseScore: 0,\n      sparseRank: 0,\n      structural: structural.find((match) => match.decisionId === id) ?? null,\n      premise: premiseMatches.find((match) => match.decisionId === id) ?? null,\n      promoted: true,\n    });\n  }\n\n  /* ---- rerank: second stage, against the ORIGINAL query ---- */\n  const ranked = await rerank({\n    query: understood.question,\n    candidates,\n    artifacts: input.artifacts,\n    state: input.state,\n    engine: input.engine,\n    queryTerms: understood.terms,\n    queryPremises: understood.premiseIds,\n    topK: options.topK,\n    now: Date.now(),\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n\n  const scoredBy = new Map(ranked.scored.map((entry) => [entry.candidate.decisionId, entry]));\n  const rrfBy = new Map(fused.map((hit) => [hit.decisionId, hit]));\n\n  const hits: RetrievedHit[] = [];\n  for (const [index, decisionId] of ranked.order.entries()) {\n    if (!options.includeSuperseded) {\n      const decision = input.state.decisions.get(decisionId);\n      if (\n        decision !== undefined &&\n        (decision.status === \"superseded\" || decision.status === \"archived\")\n      )\n        continue;\n    }\n\n    const decision = input.state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    const fusedHit = rrfBy.get(decisionId);\n    const scored = scoredBy.get(decisionId);\n\n    hits.push({\n      decisionId,\n      decision,\n      finalScore: scored?.total ?? fusedHit?.rrf ?? 0,\n      rrf: fusedHit?.rrf ?? 0,\n      ...(scored === undefined ? {} : { rerankScore: scored.total }),\n      matchedOn:\n        fusedHit === undefined\n          ? promotedLevelsOf(structural, premiseMatches, decisionId)\n          : [...fusedHit.contributedBy],\n      promoted: promotedIds.has(decisionId),\n    });\n\n    if (index >= options.topK) break;\n  }\n\n  const unavailable = ([\"L1\", \"L2\"] as const).filter((level) => !levels.includes(level));\n\n  return {\n    hits,\n    fused,\n    understood,\n    levels,\n    levelsUnavailable: unavailable,\n    notice: stalenessNotice(input.state),\n    method: ranked.method,\n    durationMs: Date.now() - started,\n  };\n}\n\nfunction record(\n  into: Map<DecisionId, Map<IndexLevel, number>>,\n  level: IndexLevel,\n  hits: readonly RankedHit[],\n): void {\n  for (const hit of hits) {\n    const existing = into.get(hit.decisionId);\n    if (existing === undefined) into.set(hit.decisionId, new Map([[level, hit.score]]));\n    else existing.set(level, hit.score);\n  }\n}\n\nfunction scoreOf(\n  scores: Map<DecisionId, Map<IndexLevel, number>>,\n  id: DecisionId,\n  level: IndexLevel,\n): number {\n  return scores.get(id)?.get(level) ?? 0;\n}\n\nfunction denseScoreOf(\n  scores: Map<DecisionId, Map<IndexLevel, number>>,\n  id: DecisionId,\n): number | null {\n  const entry = scores.get(id);\n  if (entry === undefined) return null;\n  const l1 = entry.get(\"L1\");\n  const l2 = entry.get(\"L2\");\n  if (l1 === undefined && l2 === undefined) return null;\n  /* The better of the two: L2 matches the question someone WOULD ask about this decision,\n   * L1 matches its statement. Which one is closer depends on how the user phrased it, and\n   * taking the max lets either win without a calibration constant between them. */\n  return Math.max(l1 ?? Number.NEGATIVE_INFINITY, l2 ?? Number.NEGATIVE_INFINITY);\n}\n\nfunction rankOf(lists: readonly RankedList[], level: IndexLevel, id: DecisionId): number {\n  const list = lists.find((entry) => entry.level === level);\n  return list?.hits.find((hit) => hit.decisionId === id)?.rank ?? 0;\n}\n\n/** L4/L5 matches carry no score of their own ΓÇö an exact match is not a graded one. They enter\n *  the fusion at rank order of specificity (value matches before variable matches, which the\n *  search functions already produce) and are promoted regardless of score. */\nfunction asRanked(\n  level: IndexLevel,\n  matches: readonly { decisionId: DecisionId }[],\n): readonly RankedHit[] {\n  return rank(\n    level,\n    matches.map((match, index) => ({ id: match.decisionId, score: matches.length - index })),\n  );\n}\n\nfunction promotedLevelsOf(\n  structural: readonly StructuralMatch[],\n  premises: readonly PremiseMatch[],\n  id: DecisionId,\n): readonly IndexLevel[] {\n  const out: IndexLevel[] = [];\n  if (structural.some((match) => match.decisionId === id)) out.push(\"L4\");\n  if (premises.some((match) => match.decisionId === id)) out.push(\"L5\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Ask ΓÇö retrieval plus the evidence contract                                 */\n/* -------------------------------------------------------------------------- */\n\nexport interface AskInput extends RetrieveInput {\n  readonly engineId: EngineId;\n  readonly forceLocalRerank?: boolean;\n}\n\n/**\n * Answer a question under the evidence contract.\n *\n * At most three searches, each with a distinct purpose, each recorded:\n *\n *   1. THE QUESTION as asked ΓÇö all five levels, fused and reranked.\n *   2. EXPANSION BY SHARED PREMISE ΓÇö only if search 1 was thin. Decisions resting on the same\n *      premises as search 1's hits answer many questions that the question's own vocabulary\n *      does not match, because they share the `given` rather than the wording.\n *   3. PREMISE QUESTIONS ΓÇö only if still thin. HyPE's inverted questions rephrased as the\n *      query, catching a decision recorded in different words from the ones asked.\n *\n * The budget is what makes refusal reachable. Without it, \"not found\" always means \"have not\n * looked hard enough yet\", and a system that can always look again never has to say it does\n * not know.\n */\nexport async function ask(input: AskInput): Promise<Answer> {\n  const trace = new SearchTrace();\n  const answeredAt = nowISO();\n\n  /* ---- search 1 ---- */\n  const first = await retrieve(input);\n  trace.note(first.hits.map((hit) => hit.decisionId));\n  const recorded1 = trace.record(\n    searchStep(\n      first.understood.question,\n      first.levels,\n      first.hits.length,\n      first.hits[0]?.finalScore ?? 0,\n      `The question as asked, over all five levels. ${first.understood.explanation}`,\n    ),\n  );\n\n  let hits = first.hits;\n\n  /* ---- search 2: expansion by shared premise, only when thin ---- */\n  if (recorded1 && isThin(hits)) {\n    const seeds = hits.map((hit) => hit.decisionId);\n    const expanded = seeds.length === 0 ? [] : expandBySharedPremise(input.artifacts, seeds);\n\n    const before = new Set(seeds);\n    const added = expanded.filter((id) => !before.has(id));\n    trace.note(added);\n\n    const recorded2 = trace.record(\n      searchStep(\n        `decisions sharing a premise with: ${seeds.join(\", \")}`,\n        [\"L5\"],\n        added.length,\n        0,\n        added.length === 0\n          ? \"Search 1 was thin, so the run expanded along shared premises. Nothing new came back ΓÇö no other decision rests on the same assumptions as these.\"\n          : \"Search 1 was thin, so the run expanded along shared premises: decisions resting on the same `given` often answer a question whose wording does not match.\",\n      ),\n    );\n\n    if (added.length > 0) {\n      const merged: RetrievedHit[] = [...hits];\n      for (const decisionId of added) {\n        const decision = input.state.decisions.get(decisionId);\n        if (decision === undefined) continue;\n        merged.push({\n          decisionId,\n          decision,\n          /* Scored at the topicality floor rather than at a computed value. A shared-premise\n           * expansion is an EXACT relation ΓÇö same `given` ΓÇö so it is promoted, and giving it a\n           * fabricated numeric score would imply a ranking nobody computed. */\n          finalScore: TOPICALITY_FLOOR,\n          rrf: 0,\n          matchedOn: [\"L5\"],\n          promoted: true,\n        });\n      }\n      hits = merged;\n    }\n\n    /* ---- search 3: HyPE questions as the query, only when still thin ---- */\n    if (recorded2 && isThin(hits)) {\n      const questionHits = await searchByPremiseQuestions(input, hits, trace);\n      if (questionHits.length > 0) hits = [...hits, ...questionHits];\n    }\n  }\n\n  /* ---- pre-emption: checked on every ask, not only on thin ones ---- */\n  const preemptions = findPreemptions(\n    input.state,\n    input.labels,\n    input.question,\n    first.understood.terms,\n  );\n\n  /* ---- compose under the contract ---- */\n  const labels = new Map<DecisionId, DecisionLabel>();\n  for (const hit of hits) {\n    labels.set(hit.decisionId, input.labels.get(hit.decisionId)?.label ?? hit.decision.label);\n  }\n\n  const premisesOf = new Map<DecisionId, readonly string[]>();\n  for (const hit of hits) {\n    premisesOf.set(hit.decisionId, premiseLines(input.state, input.labels, hit.decisionId));\n  }\n\n  return composeAnswer({\n    question: input.question,\n    retrieved: hits,\n    engine: input.engine,\n    engineId: input.engineId,\n    trace,\n    labels,\n    premisesOf,\n    preemptions,\n    logSize: input.state.decisions.size,\n    answeredAt,\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n}\n\n/** Thin means too few hits to answer from. Two is the floor: one decision can be quoted, but\n *  a single hit gives the reader nothing to compare it against and no way to notice that the\n *  retrieval missed the decision that actually matters. */\nexport function isThin(hits: readonly RetrievedHit[]): boolean {\n  return hits.filter((hit) => hit.promoted || hit.finalScore >= TOPICALITY_FLOOR).length < 2;\n}\n\nasync function searchByPremiseQuestions(\n  input: AskInput,\n  current: readonly RetrievedHit[],\n  trace: SearchTrace,\n): Promise<readonly RetrievedHit[]> {\n  /* Re-query with the questions the log itself would ask about the premises already in play.\n   * This is HyPE's inverted-question index used from the other direction: instead of matching\n   * a question to a decision's questions, match the decision's questions to the corpus. */\n  const seed = premisesOfHits(input.state, current);\n  const questionText = seed\n    .map((id) => input.state.premises.get(id)?.text ?? \"\")\n    .filter((text) => text.length > 0)\n    .join(\" \");\n\n  if (questionText.length === 0) {\n    trace.markBoundedOut();\n    return [];\n  }\n\n  const terms = queryTerms(questionText);\n  const l3 = searchL3(input.artifacts, terms, DEFAULT_QUERY_OPTIONS.recallK);\n\n  const before = new Set(current.map((hit) => hit.decisionId));\n  const added: RetrievedHit[] = [];\n  const notedIds: DecisionId[] = [];\n\n  for (const hit of l3) {\n    if (before.has(hit.decisionId)) continue;\n    const decision = input.state.decisions.get(hit.decisionId);\n    if (decision === undefined) continue;\n    before.add(hit.decisionId);\n    notedIds.push(hit.decisionId);\n    added.push({\n      decisionId: hit.decisionId,\n      decision,\n      finalScore: hit.score,\n      rrf: 0,\n      matchedOn: [\"L3\"],\n      promoted: false,\n    });\n  }\n\n  trace.note(notedIds);\n  trace.record(\n    searchStep(\n      questionText.slice(0, 120),\n      [\"L3\"],\n      added.length,\n      added[0]?.finalScore ?? 0,\n      added.length === 0\n        ? \"Still thin, so the run re-queried with the premises' own vocabulary. Nothing further came back ΓÇö this is the last search the contract allows, and the answer will say so.\"\n        : \"Still thin, so the run re-queried with the premises' own vocabulary rather than the question's wording.\",\n    ),\n  );\n\n  return added;\n}\n\n/** One pass over the fold's own premise ΓåÆ decisions index, not a scan per hit. */\nfunction premisesOfHits(state: GraphState, hits: readonly RetrievedHit[]): readonly PremiseId[] {\n  const wanted = new Set(hits.map((hit) => hit.decisionId));\n  const out = new Set<PremiseId>();\n\n  for (const [premiseId, dependents] of state.premiseToDecisions) {\n    if (dependents.some((id) => wanted.has(id))) out.add(premiseId);\n  }\n\n  return [...out];\n}\n\n/** The premises as the composer will quote them: id, text, LIVE label. */\nfunction premiseLines(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: DecisionId,\n): readonly string[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: string[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n      const label = labels.get(premiseId)?.label ?? premise.label;\n      out.push(`${premiseId} \"${premise.text}\" (${label})`);\n    }\n  }\n\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeRetrieval(result: RetrievalResult): string {\n  const lines = [\n    `Levels available: ${result.levels.join(\", \")}${result.levelsUnavailable.length > 0 ? `  (unavailable: ${result.levelsUnavailable.join(\", \")})` : \"\"}`,\n    `Query read as: ${result.understood.explanation}`,\n    `Fusion: RRF at k = ${RRF_K} ΓÇö ranks only, so no score calibration between levels.`,\n    `Rerank: ${result.method}, scored against the ORIGINAL query.`,\n    `Candidates: ${result.fused.length} fused ΓåÆ ${result.hits.length} returned.`,\n    `Took ${result.durationMs} ms.`,\n  ];\n\n  if (result.notice !== null) lines.push(`Note: ${result.notice}`);\n\n  return lines.join(\"\\n\");\n}\n\nexport function describePipeline(): string {\n  return [\n    \"Retrieval pipeline ΓÇö five levels, fused, then reranked, then bound:\",\n    \"\",\n    \"  L1 dense       statement embeddings\",\n    \"  L2 dense       HyPE inverted questions, generated at extraction time, zero extra LLM calls\",\n    \"  L3 sparse      BM25 over all text fields, ontology-aliased terms ΓÇö carries the keyless system\",\n    \"  L4 structural  variable / value index ΓÇö PROMOTED, not fused\",\n    \"  L5 premise     premise ΓåÆ dependents ΓÇö PROMOTED, not fused\",\n    \"\",\n    \"L4 and L5 are promoted rather than fused because an exact match is a FACT, not a rank.\",\n    \"Averaging a fact into a statistical consensus lets four levels of weak topical agreement\",\n    \"outvote one level of exact evidence, which is backwards. The reranker cannot demote them.\",\n    \"\",\n    `Fusion is RRF at k = ${RRF_K}. It reads ranks and never scores, so it needs no`,\n    \"calibration between a cosine in [-1,1] and a BM25 score with no upper bound.\",\n    \"\",\n    \"The reranker scores against the ORIGINAL QUERY. `rerank()` takes the query string and\",\n    \"nothing else, so scoring against a HyDE hypothetical is not expressible here rather than\",\n    \"merely discouraged by a comment.\",\n    \"\",\n    \"Retrieval PROPOSES; it never classifies. Invariant I3: no score produced here decides a\",\n    \"contradiction ΓÇö the classifier in ./contradiction.ts reads no score at all.\",\n  ].join(\"\\n\");\n}\n\nexport { composeAnswer, describeComposition } from \"./answer\";\nexport { groundednessOf, describeThresholds } from \"./groundedness\";\nexport {\n  MAX_SEARCHES,\n  SearchTrace,\n  describeContract,\n  resolveCitations,\n} from \"./evidence-contract\";\nexport {\n  classifyPair,\n  classifyPairs,\n  isClassifiable,\n  describeRules,\n  describeVerdict as describeContradictionVerdict,\n  requestFor,\n} from \"./contradiction\";\nexport { findPreemptions, renderPreemption, countPreemptions } from \"./preemption\";\nexport { expandCitation, expandAll, renderExpansion, renderInline } from \"./citations\";\nexport { buildIndex, describeBuild, type BuildReport } from \"./build-index\";\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 26 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 26 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 26 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\retrieval\\index.ts"},"span":[19317,19320],"sourceCode":"/**\n * The retrieval pipeline ΓÇö Phase 3's entry point.\n *\n * Phase 3 ┬╖ sub-phases 3.1ΓÇô3.9\n * Plan: plan/phase-3-retrieval.md ┬º3.4, ┬º3.5, ┬º3.7\n * Docs: docs/03-retrieval-and-contradiction.md\n *\n * ---------------------------------------------------------------------------\n * ONE PASS, FIVE LEVELS, IN THIS ORDER\n *\n *   understand the query          variable, canonical value, terms, premises named\n *   L1 dense                      statement embeddings\n *   L2 dense                      HyPE inverted questions, built at extraction time\n *   L3 sparse                     BM25 over all text fields, ontology-aliased terms\n *   L4 structural                 variable / value index ΓÇö PROMOTED, not fused\n *   L5 premise                    premise ΓåÆ dependents ΓÇö PROMOTED, not fused\n *   RRF fusion at k = 60          score-agnostic, so it needs no calibration\n *   rerank                        two-stage; scores against the ORIGINAL query\n *   evidence contract             <= 3 searches, citations resolve in-run, groundedness\n *\n * ---------------------------------------------------------------------------\n * WHY L4 AND L5 ARE PROMOTED RATHER THAN FUSED\n *\n * RRF fuses RANKS. An exact structural match ΓÇö the question names `DATABASE` and the log has\n * a decision settling `DATABASE` ΓÇö is not a rank, it is a fact. Averaging a fact into a\n * statistical consensus lets four levels of weak topical agreement outvote one level of exact\n * evidence, which is precisely backwards: exact evidence outranks statistical evidence.\n *\n * So L4 and L5 matches are held at the front of the candidate order and the reranker is not\n * allowed to demote them (`rerank/index.ts`, `orderWithPromotion`). They still APPEAR in the\n * fusion so their `contributedBy` and `matchedOn` are recorded honestly ΓÇö a promoted hit that\n * also ranked well says so, and one that only matched structurally says that too.\n *\n * ---------------------------------------------------------------------------\n * THE RERANKER SCORES AGAINST THE ORIGINAL QUERY. ALWAYS.\n *\n * `rerank()` takes the query string and nothing else, so scoring against a HyDE hypothetical\n * is not expressible in this API rather than merely discouraged by a comment. HyDE would have\n * the reranker judge relevance to a document nobody wrote and whose errors would then be\n * indistinguishable from the retrieval's. arXiv:2604.01733 found query-time HyDE underperformed\n * vanilla dense outright while hybrid RRF + cross-encoder dominated; `useHyde` defaults to\n * false and the option exists for Phase 7's ablation, not for production.\n *\n * ---------------------------------------------------------------------------\n * DEGRADATION IS REPORTED, NEVER SILENT\n *\n * With no embeddings built, or after an engine change makes them stale, L1 and L2 return\n * nothing and L3/L4/L5 carry the run. That still works ΓÇö BM25 is what makes the keyless system\n * viable ΓÇö but the answer says which levels ran. A user who cannot see that two of five levels\n * were unavailable cannot tell a thin answer from a thin log.\n * ---------------------------------------------------------------------------\n */\n\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { nowISO } from \"@/lib/format\";\nimport { canonicalValueOf } from \"@/ontology\";\nimport { VARIABLE_ORDER, variableKeywords, variableMeta } from \"@/ontology/data/variables\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { queryTerms, stalenessNotice, usableLevels } from \"@/substrate/projections/indexes\";\nimport type { DecisionId, EngineId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel, DecisionVariable } from \"@/types/domain\";\nimport type {\n  Answer,\n  FusedHit,\n  IndexArtifacts,\n  IndexLevel,\n  QueryOptions,\n  RankedHit,\n  RetrievedHit,\n} from \"@/types/retrieval\";\nimport { DEFAULT_QUERY_OPTIONS } from \"@/types/retrieval\";\nimport { TOPICALITY_FLOOR, composeAnswer } from \"./answer\";\nimport { SearchTrace, searchStep } from \"./evidence-contract\";\nimport { type DenseQuery, searchL1 } from \"./index-levels/l1-dense\";\nimport { searchL2 } from \"./index-levels/l2-questions\";\nimport { searchL3 } from \"./index-levels/l3-sparse\";\nimport { type StructuralMatch, searchL4 } from \"./index-levels/l4-structural\";\nimport { type PremiseMatch, expandBySharedPremise, searchL5 } from \"./index-levels/l5-premises\";\nimport { findPreemptions } from \"./preemption\";\nimport { type RerankCandidate, rerank } from \"./rerank\";\nimport { RRF_K, type RankedList, fuse, rank } from \"./rrf\";\n\nexport { RRF_K } from \"./rrf\";\nexport { TOPICALITY_FLOOR } from \"./answer\";\n\n/* -------------------------------------------------------------------------- */\n/* Query understanding                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface UnderstoodQuery {\n  readonly question: string;\n  readonly variable: DecisionVariable | null;\n  readonly value: string | null;\n  readonly terms: readonly string[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly explanation: string;\n}\n\n/**\n * Read the question. No model, no embedding ΓÇö the variable and value are matched against the\n * ontology's own vocabulary, which is the same vocabulary extraction used, so a question\n * phrased in the terms the log was built from resolves exactly.\n */\nexport function understandQuery(state: GraphState, question: string): UnderstoodQuery {\n  const folded = question.toLowerCase();\n  const terms = queryTerms(question);\n\n  let variable: DecisionVariable | null = null;\n  let value: string | null = null;\n  const why: string[] = [];\n\n  /* Value first: a named value implies its variable and is the more specific signal, so it\n   * wins when both are present. `variableKeywords()` is the same keyword table extraction\n   * uses, which is what makes a question phrased in the log's own vocabulary resolve exactly\n   * rather than approximately. */\n  const keywords = variableKeywords();\n\n  outer: for (const slot of VARIABLE_ORDER) {\n    const meta = variableMeta(slot);\n    for (const candidate of meta.commonValues) {\n      const foldedCandidate = candidate.toLowerCase();\n      if (foldedCandidate.length < 3) continue;\n      if (!folded.includes(foldedCandidate)) continue;\n\n      variable = slot;\n      value = canonicalValueOf(slot, candidate);\n      why.push(`\"${candidate}\" is a known ${slot} value`);\n      break outer;\n    }\n  }\n\n  /* Then the variable by its own keywords, for questions that name the slot without a value\n   * (\"what did we decide about the database?\"). */\n  if (variable === null) {\n    for (const [keyword, slots] of keywords) {\n      if (keyword.length < 3 || !folded.includes(keyword)) continue;\n      const slot = slots[0];\n      if (slot === undefined) continue;\n      variable = slot;\n      why.push(`\"${keyword}\" is a ${slot} keyword`);\n      break;\n    }\n  }\n\n  const premiseIds = premisesNamedBy(state, terms);\n  if (premiseIds.length > 0) {\n    why.push(`${premiseIds.length} premise(s) share vocabulary with the question`);\n  }\n\n  if (variable === null)\n    why.push(\"no known variable or value appears in the question, so L4 cannot fire\");\n\n  return {\n    question,\n    variable,\n    value,\n    terms,\n    premiseIds,\n    explanation: `${why.join(\"; \")}.`,\n  };\n}\n\n/**\n * Premises the question appears to name.\n *\n * Requires at least two shared content tokens: a single shared token (\"app\", \"server\", \"cost\")\n * would pull in half the log and turn a precise L5 promotion into noise. Promotions are held\n * at the front of the ranking and cannot be demoted, so a loose match here is more damaging\n * than a missed one.\n */\nexport function premisesNamedBy(state: GraphState, terms: readonly string[]): readonly PremiseId[] {\n  const querySet = new Set(terms.filter((term) => term.length > 2));\n  const out: PremiseId[] = [];\n\n  for (const premise of state.premises.values()) {\n    const tokens = new Set(\n      premise.text\n        .toLowerCase()\n        .split(/[^a-z0-9]+/)\n        .filter((token) => token.length > 2),\n    );\n\n    let shared = 0;\n    for (const token of tokens) {\n      if (querySet.has(token)) shared += 1;\n    }\n\n    if (shared >= MIN_PREMISE_TOKEN_OVERLAP) out.push(premise.id);\n  }\n\n  return out;\n}\n\nexport const MIN_PREMISE_TOKEN_OVERLAP = 2;\n\n/* -------------------------------------------------------------------------- */\n/* Retrieval                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport interface RetrieveInput {\n  readonly state: GraphState;\n  readonly artifacts: IndexArtifacts;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly engine: WhyLogEngine;\n  readonly question: string;\n  readonly options?: Partial<QueryOptions>;\n  readonly signal?: AbortSignal;\n}\n\nexport interface RetrievalResult {\n  readonly hits: readonly RetrievedHit[];\n  readonly fused: readonly FusedHit[];\n  readonly understood: UnderstoodQuery;\n  readonly levels: readonly IndexLevel[];\n  readonly levelsUnavailable: readonly IndexLevel[];\n  readonly notice: string | null;\n  readonly method: string;\n  readonly durationMs: number;\n}\n\n/**\n * Retrieve and rank. This is the whole of ┬º3.1ΓÇô┬º3.5 in one call.\n *\n * Retrieval PROPOSES. It never classifies a pair and never produces a verdict ΓÇö invariant I3.\n * The scores it returns select candidates for `contradiction.ts`, which then discards them.\n */\n/**\n * Merge the caller's options over the defaults.\n *\n * A plain spread is not enough: `QueryOptions` fields are optional, and\n * spreading an optional over a required default yields `number | undefined` ΓÇö\n * so `options.topK` would be possibly-undefined at every use, even though a\n * default always exists. Resolving each field explicitly keeps the resolved\n * options total, which is what the rest of the retrieval stack assumes.\n */\nfunction resolveQueryOptions(options: QueryOptions | undefined): Required<\n  Pick<QueryOptions, \"topK\" | \"recallK\" | \"rrfK\" | \"useHyde\" | \"includeSuperseded\">\n> & {\n  readonly levels: readonly IndexLevel[] | undefined;\n} {\n  return {\n    topK: options?.topK ?? DEFAULT_QUERY_OPTIONS.topK,\n    recallK: options?.recallK ?? DEFAULT_QUERY_OPTIONS.recallK,\n    rrfK: options?.rrfK ?? DEFAULT_QUERY_OPTIONS.rrfK,\n    useHyde: options?.useHyde ?? DEFAULT_QUERY_OPTIONS.useHyde,\n    includeSuperseded: options?.includeSuperseded ?? DEFAULT_QUERY_OPTIONS.includeSuperseded,\n    levels: options?.levels,\n  };\n}\n\nexport async function retrieve(input: RetrieveInput): Promise<RetrievalResult> {\n  const started = Date.now();\n  const options = resolveQueryOptions(input.options);\n  const understood = understandQuery(input.state, input.question);\n  const levels = usableLevels(input.state);\n  const lists: RankedList[] = [];\n  const perLevelScores = new Map<DecisionId, Map<IndexLevel, number>>();\n\n  /* ---- L1 + L2: dense. One embedding call for the question. ---- */\n  let queryVector: Float32Array | null = null;\n  if (levels.includes(\"L1\") || levels.includes(\"L2\")) {\n    const embedded = await input.engine.embed([understood.question], input.signal);\n    const vector = embedded.vectors[0];\n    if (vector !== undefined) queryVector = vector;\n  }\n\n  if (queryVector !== null) {\n    const denseQuery: DenseQuery = { queryVector, k: options.recallK };\n    const l1 = searchL1(input.artifacts, denseQuery);\n    lists.push({ level: \"L1\", hits: l1 });\n    record(perLevelScores, \"L1\", l1);\n\n    const l2 = searchL2(input.artifacts, queryVector, options.recallK);\n    lists.push({ level: \"L2\", hits: l2 });\n    record(perLevelScores, \"L2\", l2);\n  }\n\n  /* ---- L3: sparse. Carries the keyless system. ---- */\n  const l3 = searchL3(input.artifacts, understood.terms, options.recallK);\n  lists.push({ level: \"L3\", hits: l3 });\n  record(perLevelScores, \"L3\", l3);\n\n  /* ---- L4 + L5: exact evidence, promoted rather than fused. ---- */\n  const structural = searchL4(input.artifacts, understood.variable, understood.value);\n  const premiseMatches = searchL5(\n    input.artifacts,\n    understood.premiseIds,\n    \"query-named\",\n    (id) => input.state.premises.get(id)?.text ?? id,\n  );\n\n  const l4Ranked = asRanked(\"L4\", structural);\n  const l5Ranked = asRanked(\"L5\", premiseMatches);\n  lists.push({ level: \"L4\", hits: l4Ranked });\n  lists.push({ level: \"L5\", hits: l5Ranked });\n  record(perLevelScores, \"L4\", l4Ranked);\n  record(perLevelScores, \"L5\", l5Ranked);\n\n  /* ---- fuse ---- */\n  const fused = fuse(lists, options.rrfK);\n\n  const promotedIds = new Set<DecisionId>([\n    ...structural.map((match) => match.decisionId),\n    ...premiseMatches.map((match) => match.decisionId),\n  ]);\n\n  /* ---- build rerank candidates ---- */\n  const candidates: RerankCandidate[] = fused.map((hit) => ({\n    decisionId: hit.decisionId,\n    denseScore: denseScoreOf(perLevelScores, hit.decisionId),\n    sparseScore: scoreOf(perLevelScores, hit.decisionId, \"L3\"),\n    sparseRank: rankOf(lists, \"L3\", hit.decisionId),\n    structural: structural.find((match) => match.decisionId === hit.decisionId) ?? null,\n    premise: premiseMatches.find((match) => match.decisionId === hit.decisionId) ?? null,\n    promoted: promotedIds.has(hit.decisionId),\n  }));\n\n  /* Promoted candidates the fusion never surfaced ΓÇö an exact match with no lexical or dense\n   * agreement at all. It still belongs in the order; losing it would lose the one result that\n   * is certain. */\n  for (const id of promotedIds) {\n    if (candidates.some((candidate) => candidate.decisionId === id)) continue;\n    candidates.push({\n      decisionId: id,\n      denseScore: null,\n      sparseScore: 0,\n      sparseRank: 0,\n      structural: structural.find((match) => match.decisionId === id) ?? null,\n      premise: premiseMatches.find((match) => match.decisionId === id) ?? null,\n      promoted: true,\n    });\n  }\n\n  /* ---- rerank: second stage, against the ORIGINAL query ---- */\n  const ranked = await rerank({\n    query: understood.question,\n    candidates,\n    artifacts: input.artifacts,\n    state: input.state,\n    engine: input.engine,\n    queryTerms: understood.terms,\n    queryPremises: understood.premiseIds,\n    topK: options.topK,\n    now: Date.now(),\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n\n  const scoredBy = new Map(ranked.scored.map((entry) => [entry.candidate.decisionId, entry]));\n  const rrfBy = new Map(fused.map((hit) => [hit.decisionId, hit]));\n\n  const hits: RetrievedHit[] = [];\n  for (const [index, decisionId] of ranked.order.entries()) {\n    if (!options.includeSuperseded) {\n      const decision = input.state.decisions.get(decisionId);\n      if (\n        decision !== undefined &&\n        (decision.status === \"superseded\" || decision.status === \"archived\")\n      )\n        continue;\n    }\n\n    const decision = input.state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    const fusedHit = rrfBy.get(decisionId);\n    const scored = scoredBy.get(decisionId);\n\n    hits.push({\n      decisionId,\n      decision,\n      finalScore: scored?.total ?? fusedHit?.rrf ?? 0,\n      rrf: fusedHit?.rrf ?? 0,\n      ...(scored === undefined ? {} : { rerankScore: scored.total }),\n      matchedOn:\n        fusedHit === undefined\n          ? promotedLevelsOf(structural, premiseMatches, decisionId)\n          : [...fusedHit.contributedBy],\n      promoted: promotedIds.has(decisionId),\n    });\n\n    if (index >= options.topK) break;\n  }\n\n  const unavailable = ([\"L1\", \"L2\"] as const).filter((level) => !levels.includes(level));\n\n  return {\n    hits,\n    fused,\n    understood,\n    levels,\n    levelsUnavailable: unavailable,\n    notice: stalenessNotice(input.state),\n    method: ranked.method,\n    durationMs: Date.now() - started,\n  };\n}\n\nfunction record(\n  into: Map<DecisionId, Map<IndexLevel, number>>,\n  level: IndexLevel,\n  hits: readonly RankedHit[],\n): void {\n  for (const hit of hits) {\n    const existing = into.get(hit.decisionId);\n    if (existing === undefined) into.set(hit.decisionId, new Map([[level, hit.score]]));\n    else existing.set(level, hit.score);\n  }\n}\n\nfunction scoreOf(\n  scores: Map<DecisionId, Map<IndexLevel, number>>,\n  id: DecisionId,\n  level: IndexLevel,\n): number {\n  return scores.get(id)?.get(level) ?? 0;\n}\n\nfunction denseScoreOf(\n  scores: Map<DecisionId, Map<IndexLevel, number>>,\n  id: DecisionId,\n): number | null {\n  const entry = scores.get(id);\n  if (entry === undefined) return null;\n  const l1 = entry.get(\"L1\");\n  const l2 = entry.get(\"L2\");\n  if (l1 === undefined && l2 === undefined) return null;\n  /* The better of the two: L2 matches the question someone WOULD ask about this decision,\n   * L1 matches its statement. Which one is closer depends on how the user phrased it, and\n   * taking the max lets either win without a calibration constant between them. */\n  return Math.max(l1 ?? Number.NEGATIVE_INFINITY, l2 ?? Number.NEGATIVE_INFINITY);\n}\n\nfunction rankOf(lists: readonly RankedList[], level: IndexLevel, id: DecisionId): number {\n  const list = lists.find((entry) => entry.level === level);\n  return list?.hits.find((hit) => hit.decisionId === id)?.rank ?? 0;\n}\n\n/** L4/L5 matches carry no score of their own ΓÇö an exact match is not a graded one. They enter\n *  the fusion at rank order of specificity (value matches before variable matches, which the\n *  search functions already produce) and are promoted regardless of score. */\nfunction asRanked(\n  level: IndexLevel,\n  matches: readonly { decisionId: DecisionId }[],\n): readonly RankedHit[] {\n  return rank(\n    level,\n    matches.map((match, index) => ({ id: match.decisionId, score: matches.length - index })),\n  );\n}\n\nfunction promotedLevelsOf(\n  structural: readonly StructuralMatch[],\n  premises: readonly PremiseMatch[],\n  id: DecisionId,\n): readonly IndexLevel[] {\n  const out: IndexLevel[] = [];\n  if (structural.some((match) => match.decisionId === id)) out.push(\"L4\");\n  if (premises.some((match) => match.decisionId === id)) out.push(\"L5\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Ask ΓÇö retrieval plus the evidence contract                                 */\n/* -------------------------------------------------------------------------- */\n\nexport interface AskInput extends RetrieveInput {\n  readonly engineId: EngineId;\n  readonly forceLocalRerank?: boolean;\n}\n\n/**\n * Answer a question under the evidence contract.\n *\n * At most three searches, each with a distinct purpose, each recorded:\n *\n *   1. THE QUESTION as asked ΓÇö all five levels, fused and reranked.\n *   2. EXPANSION BY SHARED PREMISE ΓÇö only if search 1 was thin. Decisions resting on the same\n *      premises as search 1's hits answer many questions that the question's own vocabulary\n *      does not match, because they share the `given` rather than the wording.\n *   3. PREMISE QUESTIONS ΓÇö only if still thin. HyPE's inverted questions rephrased as the\n *      query, catching a decision recorded in different words from the ones asked.\n *\n * The budget is what makes refusal reachable. Without it, \"not found\" always means \"have not\n * looked hard enough yet\", and a system that can always look again never has to say it does\n * not know.\n */\nexport async function ask(input: AskInput): Promise<Answer> {\n  const trace = new SearchTrace();\n  const answeredAt = nowISO();\n\n  /* ---- search 1 ---- */\n  const first = await retrieve(input);\n  trace.note(first.hits.map((hit) => hit.decisionId));\n  const recorded1 = trace.record(\n    searchStep(\n      first.understood.question,\n      first.levels,\n      first.hits.length,\n      first.hits[0]?.finalScore ?? 0,\n      `The question as asked, over all five levels. ${first.understood.explanation}`,\n    ),\n  );\n\n  let hits = first.hits;\n\n  /* ---- search 2: expansion by shared premise, only when thin ---- */\n  if (recorded1 && isThin(hits)) {\n    const seeds = hits.map((hit) => hit.decisionId);\n    const expanded = seeds.length === 0 ? [] : expandBySharedPremise(input.artifacts, seeds);\n\n    const before = new Set(seeds);\n    const added = expanded.filter((id) => !before.has(id));\n    trace.note(added);\n\n    const recorded2 = trace.record(\n      searchStep(\n        `decisions sharing a premise with: ${seeds.join(\", \")}`,\n        [\"L5\"],\n        added.length,\n        0,\n        added.length === 0\n          ? \"Search 1 was thin, so the run expanded along shared premises. Nothing new came back ΓÇö no other decision rests on the same assumptions as these.\"\n          : \"Search 1 was thin, so the run expanded along shared premises: decisions resting on the same `given` often answer a question whose wording does not match.\",\n      ),\n    );\n\n    if (added.length > 0) {\n      const merged: RetrievedHit[] = [...hits];\n      for (const decisionId of added) {\n        const decision = input.state.decisions.get(decisionId);\n        if (decision === undefined) continue;\n        merged.push({\n          decisionId,\n          decision,\n          /* Scored at the topicality floor rather than at a computed value. A shared-premise\n           * expansion is an EXACT relation ΓÇö same `given` ΓÇö so it is promoted, and giving it a\n           * fabricated numeric score would imply a ranking nobody computed. */\n          finalScore: TOPICALITY_FLOOR,\n          rrf: 0,\n          matchedOn: [\"L5\"],\n          promoted: true,\n        });\n      }\n      hits = merged;\n    }\n\n    /* ---- search 3: HyPE questions as the query, only when still thin ---- */\n    if (recorded2 && isThin(hits)) {\n      const questionHits = await searchByPremiseQuestions(input, hits, trace);\n      if (questionHits.length > 0) hits = [...hits, ...questionHits];\n    }\n  }\n\n  /* ---- pre-emption: checked on every ask, not only on thin ones ---- */\n  const preemptions = findPreemptions(\n    input.state,\n    input.labels,\n    input.question,\n    first.understood.terms,\n  );\n\n  /* ---- compose under the contract ---- */\n  const labels = new Map<DecisionId, DecisionLabel>();\n  for (const hit of hits) {\n    labels.set(hit.decisionId, input.labels.get(hit.decisionId)?.label ?? hit.decision.label);\n  }\n\n  const premisesOf = new Map<DecisionId, readonly string[]>();\n  for (const hit of hits) {\n    premisesOf.set(hit.decisionId, premiseLines(input.state, input.labels, hit.decisionId));\n  }\n\n  return composeAnswer({\n    question: input.question,\n    retrieved: hits,\n    engine: input.engine,\n    engineId: input.engineId,\n    trace,\n    labels,\n    premisesOf,\n    preemptions,\n    logSize: input.state.decisions.size,\n    answeredAt,\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n}\n\n/** Thin means too few hits to answer from. Two is the floor: one decision can be quoted, but\n *  a single hit gives the reader nothing to compare it against and no way to notice that the\n *  retrieval missed the decision that actually matters. */\nexport function isThin(hits: readonly RetrievedHit[]): boolean {\n  return hits.filter((hit) => hit.promoted || hit.finalScore >= TOPICALITY_FLOOR).length < 2;\n}\n\nasync function searchByPremiseQuestions(\n  input: AskInput,\n  current: readonly RetrievedHit[],\n  trace: SearchTrace,\n): Promise<readonly RetrievedHit[]> {\n  /* Re-query with the questions the log itself would ask about the premises already in play.\n   * This is HyPE's inverted-question index used from the other direction: instead of matching\n   * a question to a decision's questions, match the decision's questions to the corpus. */\n  const seed = premisesOfHits(input.state, current);\n  const questionText = seed\n    .map((id) => input.state.premises.get(id)?.text ?? \"\")\n    .filter((text) => text.length > 0)\n    .join(\" \");\n\n  if (questionText.length === 0) {\n    trace.markBoundedOut();\n    return [];\n  }\n\n  const terms = queryTerms(questionText);\n  const l3 = searchL3(input.artifacts, terms, DEFAULT_QUERY_OPTIONS.recallK);\n\n  const before = new Set(current.map((hit) => hit.decisionId));\n  const added: RetrievedHit[] = [];\n  const notedIds: DecisionId[] = [];\n\n  for (const hit of l3) {\n    if (before.has(hit.decisionId)) continue;\n    const decision = input.state.decisions.get(hit.decisionId);\n    if (decision === undefined) continue;\n    before.add(hit.decisionId);\n    notedIds.push(hit.decisionId);\n    added.push({\n      decisionId: hit.decisionId,\n      decision,\n      finalScore: hit.score,\n      rrf: 0,\n      matchedOn: [\"L3\"],\n      promoted: false,\n    });\n  }\n\n  trace.note(notedIds);\n  trace.record(\n    searchStep(\n      questionText.slice(0, 120),\n      [\"L3\"],\n      added.length,\n      added[0]?.finalScore ?? 0,\n      added.length === 0\n        ? \"Still thin, so the run re-queried with the premises' own vocabulary. Nothing further came back ΓÇö this is the last search the contract allows, and the answer will say so.\"\n        : \"Still thin, so the run re-queried with the premises' own vocabulary rather than the question's wording.\",\n    ),\n  );\n\n  return added;\n}\n\n/** One pass over the fold's own premise ΓåÆ decisions index, not a scan per hit. */\nfunction premisesOfHits(state: GraphState, hits: readonly RetrievedHit[]): readonly PremiseId[] {\n  const wanted = new Set(hits.map((hit) => hit.decisionId));\n  const out = new Set<PremiseId>();\n\n  for (const [premiseId, dependents] of state.premiseToDecisions) {\n    if (dependents.some((id) => wanted.has(id))) out.add(premiseId);\n  }\n\n  return [...out];\n}\n\n/** The premises as the composer will quote them: id, text, LIVE label. */\nfunction premiseLines(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: DecisionId,\n): readonly string[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: string[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n      const label = labels.get(premiseId)?.label ?? premise.label;\n      out.push(`${premiseId} \"${premise.text}\" (${label})`);\n    }\n  }\n\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeRetrieval(result: RetrievalResult): string {\n  const lines = [\n    `Levels available: ${result.levels.join(\", \")}${result.levelsUnavailable.length > 0 ? `  (unavailable: ${result.levelsUnavailable.join(\", \")})` : \"\"}`,\n    `Query read as: ${result.understood.explanation}`,\n    `Fusion: RRF at k = ${RRF_K} ΓÇö ranks only, so no score calibration between levels.`,\n    `Rerank: ${result.method}, scored against the ORIGINAL query.`,\n    `Candidates: ${result.fused.length} fused ΓåÆ ${result.hits.length} returned.`,\n    `Took ${result.durationMs} ms.`,\n  ];\n\n  if (result.notice !== null) lines.push(`Note: ${result.notice}`);\n\n  return lines.join(\"\\n\");\n}\n\nexport function describePipeline(): string {\n  return [\n    \"Retrieval pipeline ΓÇö five levels, fused, then reranked, then bound:\",\n    \"\",\n    \"  L1 dense       statement embeddings\",\n    \"  L2 dense       HyPE inverted questions, generated at extraction time, zero extra LLM calls\",\n    \"  L3 sparse      BM25 over all text fields, ontology-aliased terms ΓÇö carries the keyless system\",\n    \"  L4 structural  variable / value index ΓÇö PROMOTED, not fused\",\n    \"  L5 premise     premise ΓåÆ dependents ΓÇö PROMOTED, not fused\",\n    \"\",\n    \"L4 and L5 are promoted rather than fused because an exact match is a FACT, not a rank.\",\n    \"Averaging a fact into a statistical consensus lets four levels of weak topical agreement\",\n    \"outvote one level of exact evidence, which is backwards. The reranker cannot demote them.\",\n    \"\",\n    `Fusion is RRF at k = ${RRF_K}. It reads ranks and never scores, so it needs no`,\n    \"calibration between a cosine in [-1,1] and a BM25 score with no upper bound.\",\n    \"\",\n    \"The reranker scores against the ORIGINAL QUERY. `rerank()` takes the query string and\",\n    \"nothing else, so scoring against a HyDE hypothetical is not expressible here rather than\",\n    \"merely discouraged by a comment.\",\n    \"\",\n    \"Retrieval PROPOSES; it never classifies. Invariant I3: no score produced here decides a\",\n    \"contradiction ΓÇö the classifier in ./contradiction.ts reads no score at all.\",\n  ].join(\"\\n\");\n}\n\nexport { composeAnswer, describeComposition } from \"./answer\";\nexport { groundednessOf, describeThresholds } from \"./groundedness\";\nexport {\n  MAX_SEARCHES,\n  SearchTrace,\n  describeContract,\n  resolveCitations,\n} from \"./evidence-contract\";\nexport {\n  classifyPair,\n  classifyPairs,\n  isClassifiable,\n  describeRules,\n  describeVerdict as describeContradictionVerdict,\n  requestFor,\n} from \"./contradiction\";\nexport { findPreemptions, renderPreemption, countPreemptions } from \"./preemption\";\nexport { expandCitation, expandAll, renderExpansion, renderInline } from \"./citations\";\nexport { buildIndex, describeBuild, type BuildReport } from \"./build-index\";\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 16 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 16 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 16 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\store\\extraction.ts"},"span":[4595,4598],"sourceCode":"/**\n * The extraction slice: import ΓåÆ review ΓåÆ commit.\n *\n * Phase 1 ┬╖ sub-phase 1.10 + 1.9\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.9, ┬º1.10\n *\n * ---------------------------------------------------------------------------\n * THIS SLICE DOES NOT TOUCH THE LOG\n *\n * Importing a transcript runs the pipeline and produces a QUEUE. Nothing is written\n * to the graph until `commit()` succeeds, and `commit()` delegates to\n * `useWhyLog.recordBatch` ΓÇö the only route into the log. Keeping the two stores\n * separate is what makes \"nothing enters the log unreviewed\" structurally true\n * rather than a convention: this slice physically cannot append a decision.\n *\n * It writes exactly one event of its own, at import time: `TranscriptImported`.\n * That is not an extraction result, it is a record that a document entered the\n * system, and it should survive even if every candidate in it is discarded.\n *\n * ---------------------------------------------------------------------------\n * THE QUEUE SURVIVES A RELOAD\n *\n * Persisted to `whylog:review:v1` alongside the log. An extraction that took ten\n * seconds and a review that took five minutes are both lost on an accidental\n * refresh otherwise, and \"survives reload\" is an acceptance criterion that should\n * apply to work in progress and not only to committed state.\n *\n * What is persisted is the QUEUE plus enough of the run to commit it. The\n * normalised transcript is persisted too, because `commit()` needs the offset map\n * to be identical to the one that made the snippets ΓÇö re-normalising would be\n * identical in practice and unprovable in principle.\n * ---------------------------------------------------------------------------\n */\n\nimport { getEngine } from \"@/ai/engine\";\nimport {\n  type CommitPreview,\n  DEFAULT_REVIEW_OPTIONS,\n  type ReviewItem,\n  type ReviewQueueOptions,\n  applyAction,\n  approve,\n  commitReview,\n  describeCommit,\n  describeFailure,\n  describeQueue,\n  discard,\n  filterQueue,\n  previewCommit,\n  queueFromRun,\n  sortQueue,\n  summariseQueue,\n} from \"@/extraction\";\nimport { type PipelineFailure, runExtraction } from \"@/extraction/pipeline\";\nimport type { ExtractionRun, ResolvedCandidate, ReviewAction } from \"@/extraction/types\";\nimport { nowISO } from \"@/lib/format\";\nimport { formatTranscriptId } from \"@/lib/ids\";\nimport { type Result, err, ok } from \"@/lib/result\";\nimport type { EngineId, ISODateString } from \"@/types/common\";\nimport { create } from \"zustand\";\nimport { useWhyLog } from \"./whylog\";\n\nconst REVIEW_KEY = \"whylog:review:v1\";\n\nexport type ExtractionStatus = \"idle\" | \"running\" | \"reviewing\" | \"committing\" | \"error\";\n\nexport interface ExtractionState {\n  readonly status: ExtractionStatus;\n  readonly run: ExtractionRun | null;\n  readonly queue: readonly ResolvedCandidate[];\n  readonly options: ReviewQueueOptions;\n  readonly error: string | null;\n  /** The last commit's preview, kept after the commit so the toast can quote it. */\n  readonly lastPreview: CommitPreview | null;\n  readonly lastSummary: string | null;\n\n  /* --- derived, recomputed on read so the queue and the filters cannot drift --- */\n  readonly items: () => readonly ReviewItem[];\n  readonly visible: () => readonly ReviewItem[];\n  readonly summary: () => ReturnType<typeof summariseQueue>;\n  readonly preview: () => CommitPreview;\n\n  /* --- actions --- */\n  readonly importText: (raw: string, label?: string) => Promise<Result<number, string>>;\n  readonly act: (key: string, action: ReviewAction) => void;\n  readonly actOnVisible: (action: ReviewAction) => void;\n  readonly approveAllExpanded: () => void;\n  readonly discardAllCollapsed: () => void;\n  readonly discardUnreviewed: () => void;\n  readonly setOptions: (patch: Partial<ReviewQueueOptions>) => void;\n  readonly commit: () => Result<number, string>;\n  readonly clear: () => void;\n  readonly restore: () => void;\n}\n\nexport const useExtraction = create<ExtractionState>()((set, get) => ({\n  status: \"idle\",\n  run: null,\n  queue: [],\n  options: DEFAULT_REVIEW_OPTIONS,\n  error: null,\n  lastPreview: null,\n  lastSummary: null,\n\n  /* ---------------- derived ---------------- */\n\n  items: () => {\n    const { run, queue } = get();\n    if (run === null) return [];\n    return queueFromRun(run, queue);\n  },\n\n  visible: () => {\n    const { options } = get();\n    return sortQueue(filterQueue(get().items(), options), options.sort);\n  },\n\n  summary: () => summariseQueue(get().items()),\n\n  preview: () => previewCommit(get().queue, get().run?.discarded ?? []),\n\n  /* ---------------- import ---------------- */\n\n  importText: async (raw, label) => {\n    const whylog = useWhyLog.getState();\n\n    if (whylog.status === \"degraded\") {\n      const message =\n        \"The log is read-only: its hash chain is broken. Nothing can be imported until it is restored.\";\n      set({ status: \"error\", error: message });\n      return err(message);\n    }\n    if (raw.trim().length === 0) {\n      set({ status: \"error\", error: \"Nothing was pasted.\" });\n      return err(\"Nothing was pasted.\");\n    }\n\n    const active = whylog.engine ?? getEngine();\n    const transcriptId = formatTranscriptId(whylog.state.counters.transcripts + 1);\n    const at = nowISO() as ISODateString;\n\n    set({ status: \"running\", error: null });\n\n    /* The transcript is a document that entered the system, whatever the\n     * extraction makes of it. Recorded before the pipeline runs so a crash\n     * mid-extraction still leaves a trace of the import. */\n    const imported = whylog.record(\n      {\n        type: \"TranscriptImported\",\n        payload: {\n          transcriptId,\n          rawChars: raw.length,\n          ...(label === undefined || label.trim().length === 0 ? {} : { label: label.trim() }),\n          engine: active.id,\n        },\n      },\n      {\n        reason: `Imported a ${raw.length.toLocaleString(\"en-IN\")}-character transcript for extraction.`,\n        occurredAt: at,\n      },\n    );\n    if (!imported.ok) {\n      set({ status: \"error\", error: imported.error });\n      return err(imported.error);\n    }\n\n    // `occurredAt` is deliberately NOT passed: the normaliser recovers it from the\n    // transcript's own header (\"Started: Oct 3, 14:22\") and sets `timeUncertain`\n    // when it cannot. Passing the import time here would stamp every decision with\n    // the moment of import and silently destroy the bi-temporal split (0.3) for the\n    // whole pipeline ΓÇö which is exactly the failure the two clocks exist to prevent.\n    const outcome = await runExtraction(\n      {\n        transcriptId,\n        raw,\n        ...(label === undefined ? {} : { label }),\n      },\n      {\n        engine: active.engine,\n        engineId: active.id as EngineId,\n        state: useWhyLog.getState().state,\n        voting: active.config.voting ? { runs: 3, temperature: 0.2 } : { runs: 1, temperature: 0 },\n      },\n    );\n\n    if (!outcome.ok) {\n      const message = failureMessage(outcome.failure);\n      set({ status: \"error\", error: message });\n      return err(message);\n    }\n\n    const queue = outcome.outcome.queue;\n    set({\n      status: \"reviewing\",\n      run: outcome.outcome.run,\n      queue,\n      error: null,\n      options: DEFAULT_REVIEW_OPTIONS,\n    });\n    persist(get());\n\n    return ok(queue.length);\n  },\n\n  /* ---------------- review ---------------- */\n\n  act: (key, action) => {\n    const queue = get().queue.map((item) => (item.key === key ? applyAction(item, action) : item));\n    set({ queue });\n    persist(get());\n  },\n\n  actOnVisible: (action) => {\n    const visible = new Set(\n      get()\n        .visible()\n        .map((item) => item.key),\n    );\n    const queue = get().queue.map((item) =>\n      visible.has(item.key) && item.action === null ? applyAction(item, action) : item,\n    );\n    set({ queue });\n    persist(get());\n  },\n\n  approveAllExpanded: () => {\n    // `viaBulk: true`, so the fold keeps every one of them at UNKNOWN. Ten\n    // decisions promoted to IN by a single click is how a machine inference ends up\n    // driving a cascade, so the fast path is fast without being authoritative.\n    const expanded = new Set(\n      get()\n        .items()\n        .filter((item) => item.expanded && item.action === null)\n        .map((item) => item.key),\n    );\n    const queue = get().queue.map((item) =>\n      expanded.has(item.key) ? applyAction(item, approve(true)) : item,\n    );\n    set({ queue });\n    persist(get());\n  },\n\n  discardAllCollapsed: () => {\n    const collapsed = new Set(\n      get()\n        .items()\n        .filter((item) => !item.expanded && item.action === null)\n        .map((item) => item.key),\n    );\n    const queue = get().queue.map((item) =>\n      collapsed.has(item.key)\n        ? applyAction(item, discard(\"collapsed and discarded in bulk\"))\n        : item,\n    );\n    set({ queue });\n    persist(get());\n  },\n\n  discardUnreviewed: () => {\n    const queue = get().queue.map((item) =>\n      item.action === null ? applyAction(item, discard(\"left unreviewed\")) : item,\n    );\n    set({ queue });\n    persist(get());\n  },\n\n  setOptions: (patch) => {\n    set({ options: { ...get().options, ...patch } });\n  },\n\n  /* ---------------- commit ---------------- */\n\n  commit: () => {\n    const { run, queue } = get();\n    if (run === null) return err(\"There is no extraction to commit.\");\n\n    const whylog = useWhyLog.getState();\n    if (whylog.status === \"degraded\") return err(\"The log is read-only: its hash chain is broken.\");\n\n    set({ status: \"committing\" });\n\n    const built = commitReview(\n      {\n        transcriptId: run.transcriptId,\n        engine: run.engine,\n        occurredAt: run.normalized.occurredAt,\n        items: queue,\n        machineDiscards: run.discarded.map((d) => ({\n          kind: d.kind,\n          discardedBy: d.discardedBy === \"human\" ? \"duplicate\" : d.discardedBy,\n          rawText: d.rawText,\n          confidence: d.confidence,\n        })),\n      },\n      whylog.state,\n    );\n\n    if (!built.ok) {\n      const message = describeFailure(built);\n      set({ status: \"reviewing\", error: message });\n      return err(message);\n    }\n\n    const preview = previewCommit(queue, run.discarded);\n    const appended = whylog.recordBatch(built.drafts, {\n      reason: `Committed a reviewed extraction from ${run.transcriptId}: ${describeCountsOf(built.counts)}.`,\n      occurredAt: run.normalized.occurredAt,\n    });\n\n    if (!appended.ok) {\n      set({ status: \"reviewing\", error: appended.error });\n      return err(appended.error);\n    }\n\n    set({\n      status: \"idle\",\n      run: null,\n      queue: [],\n      error: null,\n      lastPreview: preview,\n      lastSummary: describeCommit(preview, 0),\n    });\n    clearPersisted();\n\n    return ok(appended.value.length);\n  },\n\n  clear: () => {\n    set({ status: \"idle\", run: null, queue: [], error: null, options: DEFAULT_REVIEW_OPTIONS });\n    clearPersisted();\n  },\n\n  restore: () => {\n    if (get().run !== null) return;\n    const stored = readPersisted();\n    if (stored === null) return;\n    set({ status: \"reviewing\", run: stored.run, queue: stored.queue });\n  },\n}));\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction failureMessage(failure: PipelineFailure): string {\n  switch (failure.kind) {\n    case \"empty-input\":\n      return \"The transcript was empty after trimming.\";\n    case \"no-turns\":\n      return \"No speaker turns were found. WhyLog needs a transcript with recognisable turns ΓÇö paste the conversation, not a summary of it.\";\n    case \"engine-unsupported\":\n      return \"The active engine does not support extraction. Switch to the local engine in Settings.\";\n    case \"engine-error\":\n      return `The engine failed: ${failure.message}`;\n    case \"cancelled\":\n      return \"Extraction was cancelled.\";\n    default:\n      return \"Extraction failed.\";\n  }\n}\n\nfunction describeCountsOf(counts: { decisions: number; premises: number; events: number }): string {\n  return `${counts.decisions} decisions, ${counts.premises} premises, ${counts.events} events`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Persistence                                                                */\n/* -------------------------------------------------------------------------- */\n\ninterface Persisted {\n  readonly run: ExtractionRun;\n  readonly queue: readonly ResolvedCandidate[];\n  readonly savedAt: ISODateString;\n}\n\nfunction persist(state: ExtractionState): void {\n  if (state.run === null) return;\n  try {\n    const payload: Persisted = {\n      run: state.run,\n      queue: state.queue,\n      savedAt: nowISO() as ISODateString,\n    };\n    localStorage.setItem(REVIEW_KEY, JSON.stringify(payload));\n  } catch {\n    // A review that cannot be persisted is still a review. Failing loudly here\n    // would interrupt the user's work over something that only matters on reload.\n  }\n}\n\nfunction readPersisted(): Persisted | null {\n  try {\n    const raw = localStorage.getItem(REVIEW_KEY);\n    if (raw === null) return null;\n    const parsed = JSON.parse(raw) as Persisted;\n    if (parsed.run === undefined || parsed.queue === undefined) return null;\n    return parsed;\n  } catch {\n    return null;\n  }\n}\n\nfunction clearPersisted(): void {\n  try {\n    localStorage.removeItem(REVIEW_KEY);\n  } catch {\n    /* nothing to do */\n  }\n}\n\n/** Is there an unfinished review waiting? Read at boot so the app can offer to\n *  resume it rather than silently dropping five minutes of work. */\nexport function hasPendingReview(): boolean {\n  return readPersisted() !== null;\n}\n\n/** How old the pending review is, for the resume prompt. */\nexport function pendingReviewAge(): string | null {\n  const stored = readPersisted();\n  return stored === null ? null : stored.savedAt;\n}\n\nexport { REVIEW_KEY, describeQueue };\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The append-only log.\n *          if (typeof item === \"object\" && item !== null) {\n            const inner = item as Record<string, unknown>;\n            if (inner[\"decisionId\"]inner.decisionId=== nodeId || inner[\"premiseId\"] === nodeId) return true;\n          }\n        }  return fallback;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,30]}}},{"equalLines":{"line_count":317}},{"diffOp":{"equal":{"range":[30,164]}}},{"diffOp":{"delete":{"range":[164,183]}}},{"diffOp":{"insert":{"range":[183,199]}}},{"diffOp":{"equal":{"range":[30,31]}}},{"diffOp":{"equal":{"range":[199,278]}}},{"equalLines":{"line_count":78}},{"diffOp":{"equal":{"range":[278,299]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\event-log.ts"},"span":[10630,10642],"sourceCode":"/**\n * The append-only log.\n *\n * Phase 0 ┬╖ sub-phase 0.1\n * Plan: plan/phase-0-foundation.md ┬º0.1\n *\n * ---------------------------------------------------------------------------\n * INVARIANT I1 ΓÇö NOTHING IS DELETED, EVERYTHING IS AN EVENT\n *\n * This module exposes `append` and `load`. It does not expose `set`, `update`,\n * `remove`, `splice`, `clear` or `truncate`, and there is no code path by which\n * a caller can obtain a mutable reference to the stored array. The absence of a\n * mutation API is the enforcement; a lint rule or a code review is not.\n *\n * The one operation that looks like removal ΓÇö rejecting a decision, deleting a\n * guard, superseding a premise ΓÇö is an APPEND of a closing event. The node stays\n * in every projection with its interval shown.\n * ---------------------------------------------------------------------------\n */\n\nimport { formatEventId } from \"@/lib/ids\";\nimport type { Actor, EngineId, EventId, ISODateString } from \"@/types/common\";\nimport type {\n  AnyEvent,\n  DomainEvent,\n  EventPayloadMap,\n  EventType,\n  NewEvent,\n  ValidationResult,\n} from \"@/types/events\";\nimport { type ValidationContext, validateEvent } from \"./event-validation\";\nimport {\n  type ChainVerification,\n  GENESIS_HASH,\n  hashEvent,\n  linkHash,\n  verifyChain,\n} from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The log                                                                    */\n/* -------------------------------------------------------------------------- */\n\nexport interface EventLog {\n  /** Sealed, hash-chained, in learned-time order. */\n  readonly events: readonly AnyEvent[];\n  readonly headHash: string;\n  readonly lastEventId: EventId | null;\n  /** Learned time of the last event; the monotonicity floor for the next one. */\n  readonly lastAt: ISODateString | null;\n  readonly schemaVersion: number;\n}\n\nexport function emptyLog(): EventLog {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    lastAt: null,\n    schemaVersion: SCHEMA_VERSION,\n  };\n}\n\n/** Rebuild a log handle from a stored or imported array. Verifies the chain and\n *  reports ΓÇö it does not silently accept a broken one. */\nexport function loadLog(\n  events: readonly AnyEvent[],\n  schemaVersion: number = SCHEMA_VERSION,\n): { log: EventLog; verification: ChainVerification } {\n  const verification = verifyChain(events);\n  const last = events.at(-1);\n  return {\n    log: {\n      events,\n      headHash: verification.headHash,\n      lastEventId: last?.id ?? null,\n      lastAt: last?.at ?? null,\n      schemaVersion,\n    },\n    verification,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Appending                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport type AppendOutcome<T extends EventType> =\n  | { readonly ok: true; readonly log: EventLog; readonly event: AnyEvent }\n  | {\n      readonly ok: false;\n      readonly log: EventLog;\n      readonly validation: ValidationResult;\n      readonly attempted: T;\n    };\n\nexport interface AppendContext {\n  readonly now: ISODateString;\n  readonly actor: Actor;\n  /** Valid time. Defaults to `now`; set it when importing history. */\n  readonly occurredAt?: ISODateString;\n  readonly reason: string;\n}\n\n/**\n * The event as the caller supplies it: type, payload, actor, reason, and the two\n * clocks. `id`, `prevHash` and `schemaVersion` are minted here ΓÇö a caller that\n * could choose its own `prevHash` could fork the chain.\n */\nexport type EventDraft<T extends EventType> = Omit<NewEvent<T>, \"at\" | \"occurredAt\"> & {\n  readonly at?: ISODateString;\n  readonly occurredAt?: ISODateString;\n};\n\nfunction mintId(log: EventLog, at: ISODateString): EventId {\n  // Time-ordered and unique within a millisecond via the sequence counter. The\n  // counter is the log length, which is monotonic because the log only grows.\n  return formatEventId(Date.parse(at) || 0, log.events.length + 1);\n}\n\nfunction seal<T extends EventType>(\n  log: EventLog,\n  draft: EventDraft<T>,\n  context: AppendContext,\n): AnyEvent {\n  const at = draft.at ?? context.now;\n  const occurredAt = draft.occurredAt ?? context.occurredAt ?? at;\n\n  const linked = {\n    id: mintId(log, at),\n    type: draft.type,\n    at,\n    occurredAt,\n    actor: draft.actor ?? context.actor,\n    payload: draft.payload,\n    reason: draft.reason ?? context.reason,\n    prevHash: log.headHash,\n    schemaVersion: log.schemaVersion,\n  } as unknown as DomainEvent<T, EventPayloadMap[T]>;\n\n  // The content hash rides with the event so that an edit is reported AT the\n  // edited event, not at the next one. It is computed over the content only,\n  // so it survives a re-link onto a different chain.\n  return { ...linked, selfHash: hashEvent(linked) } as AnyEvent;\n}\n\nfunction contextFor(log: EventLog): ValidationContext {\n  // `knownIds` is left null on the append path: ids are minted here from a\n  // monotonic counter, so a collision would mean the counter broke, and scanning\n  // ten thousand ids on every append to prove otherwise is the wrong trade.\n  // Imports DO scan, because those ids came from somewhere else.\n  return {\n    expectedPrevHash: log.headHash,\n    lastLearnedAt: log.lastAt,\n    knownIds: null,\n  };\n}\n\n/**\n * Validate, seal and append one event.\n *\n * On failure the log is returned UNCHANGED. There is no partial append: a log\n * that can be half-written cannot be reasoned about, and the fold would have to\n * guess.\n */\nexport function append<T extends EventType>(\n  log: EventLog,\n  draft: EventDraft<T>,\n  context: AppendContext,\n): AppendOutcome<T> {\n  const event = seal(log, draft, context);\n  const validation = validateEvent(event, contextFor(log));\n\n  if (!validation.ok) {\n    return { ok: false, log, validation, attempted: draft.type };\n  }\n\n  return {\n    ok: true,\n    log: {\n      events: [...log.events, event],\n      headHash: linkHash(log.headHash, event),\n      lastEventId: event.id,\n      lastAt: event.at,\n      schemaVersion: log.schemaVersion,\n    },\n    event,\n  };\n}\n\n/**\n * Append a batch, all-or-nothing.\n *\n * Used by the extraction commit path (Phase 1.10), where a decision and its\n * premises, alternatives and justification must land together or not at all. A\n * half-committed extraction produces a decision resting on premises that do not\n * exist, which the fold would have to label UNFOUNDED.\n */\nexport function appendBatch(\n  log: EventLog,\n  drafts: readonly { draft: EventDraft<EventType>; context: AppendContext }[],\n):\n  | { ok: true; log: EventLog; events: AnyEvent[] }\n  | { ok: false; log: EventLog; validation: ValidationResult; failedAt: number } {\n  let current = log;\n  const sealed: AnyEvent[] = [];\n\n  for (let i = 0; i < drafts.length; i += 1) {\n    const entry = drafts[i];\n    if (!entry) continue;\n    const outcome = append(current, entry.draft, entry.context);\n    if (!outcome.ok) {\n      return { ok: false, log, validation: outcome.validation, failedAt: i };\n    }\n    current = outcome.log;\n    sealed.push(outcome.event);\n  }\n\n  return { ok: true, log: current, events: sealed };\n}\n\n/**\n * Append events that are ALREADY sealed ΓÇö the import path.\n *\n * Skips id minting and re-linking, because an imported event's `prevHash` is part\n * of its identity and rewriting it would change the head hash the export was\n * stamped with. The chain is verified by the caller before this is reached; see\n * src/substrate/portability.ts.\n */\nexport function appendSealed(log: EventLog, events: readonly AnyEvent[]): EventLog {\n  if (events.length === 0) return log;\n\n  let head = log.headHash;\n  let lastEventId = log.lastEventId;\n  let lastAt = log.lastAt;\n  let schemaVersion = log.schemaVersion;\n\n  for (const event of events) {\n    head = linkHash(head, event);\n    lastEventId = event.id;\n    if (lastAt === null || event.at > lastAt) lastAt = event.at;\n    schemaVersion = Math.max(schemaVersion, event.schemaVersion ?? schemaVersion);\n  }\n\n  return {\n    events: [...log.events, ...events],\n    headHash: head,\n    lastEventId,\n    lastAt,\n    schemaVersion,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reading                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/** Iterate in log order. The only sanctioned way to walk the log. */\nexport function* iterate(log: EventLog): Generator<AnyEvent> {\n  for (const event of log.events) yield event;\n}\n\n/** Filter by type, preserving log order. */\nexport function eventsOfType<T extends EventType>(log: EventLog, type: T): readonly AnyEvent[] {\n  return log.events.filter((e): e is Extract<AnyEvent, { type: T }> => e.type === type);\n}\n\n/**\n * Every event touching a given node id, in learned-time order.\n *\n * This is the audit trail for one node, and it is complete by construction ΓÇö\n * nothing about a node can change without an event, and nothing can be removed\n * from the log.\n *\n * Implemented as a structural walk over known id-bearing payload keys rather than\n * a substring search of the serialised payload: a substring scan would match an\n * id appearing inside a free-text `reason`, which would put unrelated events in\n * a node's history and quietly destroy the one view that has to be exact.\n */\nconst ID_BEARING_KEYS = [\n  \"decisionId\",\n  \"premiseId\",\n  \"justificationId\",\n  \"guardId\",\n  \"nogoodId\",\n  \"proposalId\",\n  \"transcriptId\",\n  \"episodeId\",\n  \"alternativeId\",\n  \"exportId\",\n  \"nodeId\",\n  \"consequent\",\n  \"unsoundDecisionId\",\n  \"failedPremiseId\",\n  \"newPremiseId\",\n  \"newJustificationId\",\n  \"overriddenDecisionId\",\n  \"oldDecisionId\",\n  \"newDecisionId\",\n  \"decisionA\",\n  \"decisionB\",\n  \"from\",\n  \"to\",\n] as const;\n\nexport function historyOf(log: EventLog, nodeId: string): readonly AnyEvent[] {\n  const mentions = (payload: unknown): boolean => {\n    if (typeof payload !== \"object\" || payload === null) return false;\n    const record = payload as Record<string, unknown>;\n\n    for (const key of ID_BEARING_KEYS) {\n      if (record[key] === nodeId) return true;\n    }\n\n    // Array-valued references: inList, outList, premiseIds, guardIds, cascade.\n    for (const value of Object.values(record)) {\n      if (Array.isArray(value)) {\n        for (const item of value) {\n          if (item === nodeId) return true;\n          if (typeof item === \"object\" && item !== null) {\n            const inner = item as Record<string, unknown>;\n            if (inner[\"decisionId\"] === nodeId || inner[\"premiseId\"] === nodeId) return true;\n          }\n        }\n      }\n    }\n\n    return false;\n  };\n\n  return log.events.filter((e) => mentions(e.payload));\n}\n\n/** The last N events, newest first. For the activity strip. */\nexport function recent(log: EventLog, count: number): readonly AnyEvent[] {\n  return log.events.slice(Math.max(0, log.events.length - count)).reverse();\n}\n\n/** Events learned within a window. Inclusive of `from`, exclusive of `to`. */\nexport function learnedBetween(\n  log: EventLog,\n  from: ISODateString,\n  to: ISODateString,\n): readonly AnyEvent[] {\n  return log.events.filter((e) => e.at >= from && e.at < to);\n}\n\n/** Events whose VALID time falls in a window. Different question, different\n *  answer ΓÇö see src/substrate/bi-temporal.ts. */\nexport function occurredBetween(\n  log: EventLog,\n  from: ISODateString,\n  to: ISODateString,\n): readonly AnyEvent[] {\n  return log.events.filter((e) => e.occurredAt >= from && e.occurredAt < to);\n}\n\n/** Who did what. Counts per actor kind, for the agency ledger (Phase 6.4). */\nexport function actorTally(log: EventLog): Readonly<Record<string, number>> {\n  const out: Record<string, number> = {};\n  for (const event of log.events) {\n    const key = describeActor(event.actor);\n    out[key] = (out[key] ?? 0) + 1;\n  }\n  return out;\n}\n\nexport function describeActor(actor: Actor): string {\n  switch (actor.kind) {\n    case \"human\":\n      return \"human\";\n    case \"engine\":\n      return `engine:${actor.engine.kind}:${actor.engine.model}`;\n    case \"guard\":\n      return `guard:${actor.guardId}`;\n    case \"system\":\n      return \"system\";\n    default:\n      return \"unknown\";\n  }\n}\n\n/** Tally per event type ΓÇö the shape of a log at a glance. */\nexport function typeTally(log: EventLog): Readonly<Record<string, number>> {\n  const out: Record<string, number> = {};\n  for (const event of log.events) {\n    out[event.type] = (out[event.type] ?? 0) + 1;\n  }\n  return out;\n}\n\n/** Verify the whole chain. Called on load and on import (sub-phase 0.5). */\nexport function verify(log: EventLog): ChainVerification {\n  return verifyChain(log.events);\n}\n\n/** The engine recorded on the most recent `EngineSwitched`, or a default. */\nexport function currentEngine(log: EventLog, fallback: EngineId): EngineId {\n  for (let i = log.events.length - 1; i >= 0; i -= 1) {\n    const event = log.events[i];\n    if (event && event.type === \"EngineSwitched\") return event.payload.to;\n  }\n  return fallback;\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The append-only log.\n *          if (typeof item === \"object\" && item !== null) {\n            const inner = item as Record<string, unknown>;\n            if (inner[\"decisionId\"] === nodeId || inner[\"premiseId\"]inner.premiseId=== nodeId) return true;\n          }\n        }  return fallback;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,30]}}},{"equalLines":{"line_count":317}},{"diffOp":{"equal":{"range":[30,198]}}},{"diffOp":{"delete":{"range":[198,216]}}},{"diffOp":{"insert":{"range":[216,231]}}},{"diffOp":{"equal":{"range":[30,31]}}},{"diffOp":{"equal":{"range":[231,277]}}},{"equalLines":{"line_count":78}},{"diffOp":{"equal":{"range":[277,298]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\event-log.ts"},"span":[10664,10675],"sourceCode":"/**\n * The append-only log.\n *\n * Phase 0 ┬╖ sub-phase 0.1\n * Plan: plan/phase-0-foundation.md ┬º0.1\n *\n * ---------------------------------------------------------------------------\n * INVARIANT I1 ΓÇö NOTHING IS DELETED, EVERYTHING IS AN EVENT\n *\n * This module exposes `append` and `load`. It does not expose `set`, `update`,\n * `remove`, `splice`, `clear` or `truncate`, and there is no code path by which\n * a caller can obtain a mutable reference to the stored array. The absence of a\n * mutation API is the enforcement; a lint rule or a code review is not.\n *\n * The one operation that looks like removal ΓÇö rejecting a decision, deleting a\n * guard, superseding a premise ΓÇö is an APPEND of a closing event. The node stays\n * in every projection with its interval shown.\n * ---------------------------------------------------------------------------\n */\n\nimport { formatEventId } from \"@/lib/ids\";\nimport type { Actor, EngineId, EventId, ISODateString } from \"@/types/common\";\nimport type {\n  AnyEvent,\n  DomainEvent,\n  EventPayloadMap,\n  EventType,\n  NewEvent,\n  ValidationResult,\n} from \"@/types/events\";\nimport { type ValidationContext, validateEvent } from \"./event-validation\";\nimport {\n  type ChainVerification,\n  GENESIS_HASH,\n  hashEvent,\n  linkHash,\n  verifyChain,\n} from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The log                                                                    */\n/* -------------------------------------------------------------------------- */\n\nexport interface EventLog {\n  /** Sealed, hash-chained, in learned-time order. */\n  readonly events: readonly AnyEvent[];\n  readonly headHash: string;\n  readonly lastEventId: EventId | null;\n  /** Learned time of the last event; the monotonicity floor for the next one. */\n  readonly lastAt: ISODateString | null;\n  readonly schemaVersion: number;\n}\n\nexport function emptyLog(): EventLog {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    lastAt: null,\n    schemaVersion: SCHEMA_VERSION,\n  };\n}\n\n/** Rebuild a log handle from a stored or imported array. Verifies the chain and\n *  reports ΓÇö it does not silently accept a broken one. */\nexport function loadLog(\n  events: readonly AnyEvent[],\n  schemaVersion: number = SCHEMA_VERSION,\n): { log: EventLog; verification: ChainVerification } {\n  const verification = verifyChain(events);\n  const last = events.at(-1);\n  return {\n    log: {\n      events,\n      headHash: verification.headHash,\n      lastEventId: last?.id ?? null,\n      lastAt: last?.at ?? null,\n      schemaVersion,\n    },\n    verification,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Appending                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport type AppendOutcome<T extends EventType> =\n  | { readonly ok: true; readonly log: EventLog; readonly event: AnyEvent }\n  | {\n      readonly ok: false;\n      readonly log: EventLog;\n      readonly validation: ValidationResult;\n      readonly attempted: T;\n    };\n\nexport interface AppendContext {\n  readonly now: ISODateString;\n  readonly actor: Actor;\n  /** Valid time. Defaults to `now`; set it when importing history. */\n  readonly occurredAt?: ISODateString;\n  readonly reason: string;\n}\n\n/**\n * The event as the caller supplies it: type, payload, actor, reason, and the two\n * clocks. `id`, `prevHash` and `schemaVersion` are minted here ΓÇö a caller that\n * could choose its own `prevHash` could fork the chain.\n */\nexport type EventDraft<T extends EventType> = Omit<NewEvent<T>, \"at\" | \"occurredAt\"> & {\n  readonly at?: ISODateString;\n  readonly occurredAt?: ISODateString;\n};\n\nfunction mintId(log: EventLog, at: ISODateString): EventId {\n  // Time-ordered and unique within a millisecond via the sequence counter. The\n  // counter is the log length, which is monotonic because the log only grows.\n  return formatEventId(Date.parse(at) || 0, log.events.length + 1);\n}\n\nfunction seal<T extends EventType>(\n  log: EventLog,\n  draft: EventDraft<T>,\n  context: AppendContext,\n): AnyEvent {\n  const at = draft.at ?? context.now;\n  const occurredAt = draft.occurredAt ?? context.occurredAt ?? at;\n\n  const linked = {\n    id: mintId(log, at),\n    type: draft.type,\n    at,\n    occurredAt,\n    actor: draft.actor ?? context.actor,\n    payload: draft.payload,\n    reason: