sert":{"range":[374,387]}}},{"diffOp":{"equal":{"range":[186,187]}}},{"diffOp":{"insert":{"range":[387,398]}}},{"diffOp":{"equal":{"range":[398,415]}}},{"diffOp":{"delete":{"range":[333,339]}}},{"diffOp":{"insert":{"range":[327,333]}}},{"diffOp":{"equal":{"range":[415,448]}}},{"equalLines":{"line_count":92}},{"diffOp":{"equal":{"range":[448,464]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\cli.ts"},"span":null,"sourceCode":"/**\n * Shared CLI plumbing for the three eval entry points.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * Kept apart from the scoring modules on purpose. `metrics/*` and `ablation/*` are pure: they take a\n * corpus and a run and return numbers, with no process, no filesystem and no console. Only this file\n * and the three entry points touch the outside world, which is what makes the suite importable from the\n * browser build later without dragging Node's `process` into a Vite bundle.\n */\n\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { dirname, resolve as resolvePath } from \"node:path\";\nimport { createLocalEngine, localEngineId } from \"@/ai/local\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { EngineId } from \"@/types/common\";\nimport { corpus, CORPUS_ROOT } from \"./corpus/data\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad, loadCorpus, type LoadReport } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\n\nexport interface CliContext {\n  readonly corpus: ResolvedCorpus;\n  readonly load: LoadReport;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n}\n\n/**\n * Load the corpus and pick an engine.\n *\n * Exits non-zero when labels fail to resolve. A corpus with unresolved quotes produces metrics whose\n * denominators are wrong for a reason invisible in the output, and continuing would publish numbers that\n * look fine and are not. Stopping is the only behaviour that keeps the report trustworthy.\n */\nexport function prepare(): CliContext {\n  const load = loadCorpus(corpus, CORPUS_ROOT);\n\n  banner(\"DecisionMemEval \" + corpus.version);\n  line(describeCorpus(corpus));\n  blank();\n  line(describeLoad(load));\n\n  if (load.missingFiles.length > 0) {\n    blank();\n    line(\"ABORTING: \" + load.missingFiles.length + \" transcript file(s) are missing from disk.\");\n    line(\"A metric computed over a partial corpus is not a smaller metric, it is a different one.\");\n    process.exitCode = 1;\n    throw new Error(\"missing transcript files\");\n  }\n\n  if (load.unresolved.length > 0) {\n    blank();\n    line(\"ABORTING: \" + load.unresolved.length + \" label(s) quote text that is not in their transcript.\");\n    line(\"Fix the corpus before scoring. The quotes are the ground truth; a quote that does not match is\");\n    line(\"a ground truth that does not exist, and every recall number computed against it is wrong.\");\n    process.exitCode = 1;\n    throw new Error(\"unresolved corpus labels\");\n  }\n\n  /* The local engine, always. The whole benchmark runs keyless by design: a number that requires an API\n   * key to reproduce is not a number a judge can check, and ┬º7.5 lists keyless verification as a demo\n   * requirement for the same reason. */\n  return { corpus: load.corpus, load, engine: createLocalEngine(), engineId: localEngineId() };\n}\n\nexport function banner(text: string): void {\n  const rule = \"=\".repeat(Math.max(text.length, 78));\n  process.stdout.write(\"\\n\" + rule + \"\\n\" + text + \"\\n\" + rule + \"\\n\");\n}\n\nexport function heading(text: string): void {\n  process.stdout.write(\"\\n--- \" + text + \" \" + \"-\".repeat(Math.max(0, 72 - text.length)) + \"\\n\");\n}\n\nexport function line(text: string): void {\n  process.stdout.write(text + \"\\n\");\n}\n\nexport function blank(): void {\n  process.stdout.write(\"\\n\");\n}\n\nexport function write(filePath: string, contents: string): void {\n  const absolute = resolvePath(process.cwd(), filePath);\n  mkdirSync(dirname(absolute), { recursive: true });\n  writeFileSync(absolute, contents, \"utf8\");\n  line(\"wrote \" + filePath + \" (\" + contents.length.toLocaleString(\"en-US\") + \" bytes)\");\n}\n\n/** A `--flag value` reader. Unknown flags are reported rather than ignored, because a typo'd flag that\n *  silently falls back to a default produces a run the operator believes was configured differently. */\nexport function readArgs(argv: readonly string[]): Map<string, string> {\n  const out = new Map<string, string>();\n\n  for (let i = 0; i < argv.length; i += 1) {\n    const token = argv[i];\n    if (token === undefined || !token.startsWith(\"--\")) continue;\n\n    const key = token.slice(2);\n    const next = argv[i + 1];\n    if (next !== undefined && !next.startsWith(\"--\")) {\n      out.set(key, next);\n      i += 1;\n    } else {\n      out.set(key, \"true\");\n    }\n  }\n\n  const known = new Set([\"out\", \"json\", \"engine\", \"only\", \"quick\"]);\n  for (const key of out.keys()) {\n    if (!known.has(key)) line(\"note: unknown flag --\" + key + \" ignored (known: \" + [...known].join(\", \") + \")\");\n  }\n\n  return out;\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 114 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 114 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 114 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\graph\\LatticeLayout.ts"},"span":[5054,5067],"sourceCode":"/**\n * The lattice layout ΓÇö 6.6.\n *\n * Phase 6 ┬╖ sub-phase 6.6\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * ---------------------------------------------------------------------------\n * POSITIONING ONLY, AND DELIBERATELY NOT A FORCE LAYOUT\n *\n * The plan's implementation note allows a force-layout library \"for positioning only\". This uses\n * none, for a reason that matters more than aesthetics: **a force layout is not reproducible.**\n * Node positions would settle differently on each render, so two screenshots of the same log would\n * differ, a cascade animation would move nodes the user is trying to watch, and \"the lattice at\n * time T\" in the time machine would not look like the lattice they remember.\n *\n * A deterministic column layout gives the same picture every time. That is what makes the visual\n * usable as evidence rather than decoration.\n *\n * ---------------------------------------------------------------------------\n * THE BIPARTITE STRUCTURE IS THE LAYOUT, NOT AN ANNOTATION\n *\n * Premises occupy the top band, in COLUMNS BY TYPE, in `PREMISE_COLUMN_ORDER`. Decisions hang\n * below as leaves, positioned at the BARYCENTRE of the premises they rest on.\n *\n * Two consequences, both intended:\n *\n *   1. The two kinds never share a row, so the graph reads as bipartite without any label saying\n *      so ΓÇö which is the point of giving premises circles and decisions rounded squares.\n *   2. Barycentre placement minimises edge crossing for free. A decision resting on `scale` and\n *      `deployment` sits between those two columns, so its edges are short and do not cross the\n *      whole diagram.\n *\n * ---------------------------------------------------------------------------\n * THE ANTI-HAIRBALL RULES ARE APPLIED HERE, BEFORE RENDERING\n *\n * Filtering at render time means the layout still reserves space for what is hidden, leaving gaps\n * that look like missing data. Doing it here means the layout is computed over what will actually\n * be drawn:\n *\n *   ┬╖ premises with a SINGLE dependent decision are collapsed into that decision's card\n *   ┬╖ superseded and archived decisions are dropped unless explicitly requested\n *   ┬╖ `related` edges are dropped unless requested ΓÇö they are topical, never structural, and\n *     drawing them is how a lattice becomes a hairball\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { PREMISE_COLUMN_ORDER, PREMISE_RING } from \"@/theme\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { DecisionLabel, PremiseType } from \"@/types/domain\";\n\n/* -------------------------------------------------------------------------- */\n/* Geometry                                                                   */\n/* -------------------------------------------------------------------------- */\n\nexport const COLUMN_WIDTH = 168;\nexport const PREMISE_ROW_HEIGHT = 74;\nexport const DECISION_ROW_HEIGHT = 62;\nexport const TOP_MARGIN = 56;\nexport const PREMISE_BAND_HEIGHT = 4;\nexport const LEFT_MARGIN = 24;\n\nexport type LatticeNodeKind = \"premise\" | \"decision\";\n\nexport interface LatticeNode {\n  readonly id: NodeId;\n  readonly kind: LatticeNodeKind;\n  readonly x: number;\n  readonly y: number;\n  readonly label: DecisionLabel;\n  readonly text: string;\n  readonly column: PremiseType | null;\n  /** Premises only: how many decisions hang off this one. Drives the radius, so load-bearing\n   *  nodes LOOK load-bearing. */\n  readonly dependents: number;\n  /** Decisions only: premises collapsed into this card rather than drawn as nodes. */\n  readonly collapsedPremises: readonly PremiseId[];\n}\n\nexport type LatticeEdgeKind = \"supports\" | \"excludes\" | \"depends-on\" | \"supersedes\" | \"conflicts\";\n\nexport interface LatticeEdge {\n  readonly from: NodeId;\n  readonly to: NodeId;\n  readonly kind: LatticeEdgeKind;\n}\n\nexport interface LatticeLayout {\n  readonly nodes: ReadonlyMap<NodeId, LatticeNode>;\n  readonly edges: readonly LatticeEdge[];\n  readonly width: number;\n  readonly height: number;\n  /** Column headers, in draw order, with the x of their centre. */\n  readonly columns: readonly { type: PremiseType; x: number; count: number }[];\n  readonly premiseCount: number;\n  readonly decisionCount: number;\n  readonly collapsedPremiseCount: number;\n  readonly droppedDecisionCount: number;\n}\n\nexport interface LayoutOptions {\n  readonly includeSuperseded?: boolean;\n  readonly includeRelated?: boolean;\n  /** Restrict to one cascade: only these decisions and the premises feeding them are laid out.\n   *  The plan's rule ΓÇö render ONE cascade at a time, never the whole graph unfiltered. */\n  readonly focus?: readonly NodeId[];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The layout                                                                 */\n/* -------------------------------------------------------------------------- */\n\nexport function layoutLattice(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  options?: LayoutOptions,\n): LatticeLayout {\n  const includeSuperseded = options?.includeSuperseded ?? false;\n  const includeRelated = options?.includeRelated ?? false;\n  const focus = options?.focus === undefined ? null : new Set(options.focus);\n\n  /* ---- 1. which decisions are in ---- */\n  const decisions: DecisionId[] = [];\n  let droppedDecisions = 0;\n\n  for (const decision of state.decisions.values()) {\n    if (decision.status === \"superseded\" || decision.status === \"archived\") {\n      droppedDecisions += 1;\n      if (!includeSuperseded) continue;\n    }\n    if (focus !== null && !focus.has(decision.id)) continue;\n    decisions.push(decision.id);\n  }\n\n  /* ---- 2. premise ΓåÆ decisions, restricted to those decisions ---- */\n  const supports = new Map<PremiseId, DecisionId[]>();\n  const excludes = new Map<PremiseId, DecisionId[]>();\n\n  for (const decisionId of decisions) {\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    for (const justificationId of decision.justificationIds) {\n      const justification = state.justifications.get(justificationId);\n      if (justification === undefined) continue;\n\n      for (const premiseId of justification.inList) {\n        const list = supports.get(premiseId);\n        if (list === undefined) supports.set(premiseId, [decisionId]);\n        else if (!list.includes(decisionId)) list.push(decisionId);\n      }\n\n      for (const premiseId of justification.outList) {\n        const list = excludes.get(premiseId);\n        if (list === undefined) excludes.set(premiseId, [decisionId]);\n        else if (!list.includes(decisionId)) list.push(decisionId);\n      }\n    }\n  }\n\n  /* ---- 3. collapse single-dependent premises into their decision ----\n   * A premise supporting exactly one decision adds a node and an edge to say something the\n   * decision's card already says. Collapsing it is the difference between a lattice and a\n   * hairball, and it is why the shared premises ΓÇö the load-bearing ones ΓÇö are what remains\n   * visible. */\n  const collapsed = new Map<DecisionId, PremiseId[]>();\n  const drawnPremises: PremiseId[] = [];\n  let collapsedCount = 0;\n\n  const allPremiseIds = new Set<PremiseId>([...supports.keys(), ...excludes.keys()]);\n\n  for (const premiseId of allPremiseIds) {\n    const inList = supports.get(premiseId) ?? [];\n    const outList = excludes.get(premiseId) ?? [];\n    const total = new Set([...inList, ...outList]).size;\n\n    if (total === 1) {\n      const only = inList[0] ?? outList[0];\n      if (only !== undefined) {\n        const existing = collapsed.get(only);\n        if (existing === undefined) collapsed.set(only, [premiseId]);\n        else existing.push(premiseId);\n        collapsedCount += 1;\n        continue;\n      }\n    }\n\n    drawnPremises.push(premiseId);\n  }\n\n  /* ---- 4. premise positions: columns by type, stacked within a column ---- */\n  const nodes = new Map<NodeId, LatticeNode>();\n  const columnOf = new Map<PremiseType, PremiseId[]>();\n\n  for (const premiseId of drawnPremises) {\n    const premise = state.premises.get(premiseId);\n    if (premise === undefined) continue;\n\n    const type = columnKey(premise.type);\n    const list = columnOf.get(type);\n    if (list === undefined) columnOf.set(type, [premiseId]);\n    else list.push(premiseId);\n  }\n\n  /* Columns appear in the fixed order from theme.ts, so the picture is stable across renders and\n   * screenshots. Empty columns are skipped rather than drawn as gaps. */\n  const orderedTypes: PremiseType[] = [];\n  for (const type of PREMISE_COLUMN_ORDER) {\n    if ((columnOf.get(type) ?? []).length > 0) orderedTypes.push(type);\n  }\n  for (const type of columnOf.keys()) {\n    if (!orderedTypes.includes(type)) orderedTypes.push(type);\n  }\n\n  const premiseX = new Map<PremiseId, number>();\n  let maxRows = 0;\n\n  orderedTypes.forEach((type, columnIndex) => {\n    const members = columnOf.get(type) ?? [];\n    /* Sorted by dependent count descending, so the most load-bearing premise in a column is at the\n     * top where the eye lands first. Ties break by id for determinism. */\n    const sorted = [...members].sort((a, b) => {\n      const byCount = dependentCount(a, b, supports, excludes);\n      return byCount !== 0 ? byCount : a < b ? -1 : 1;\n    });\n\n    maxRows = Math.max(maxRows, sorted.length);\n\n    sorted.forEach((premiseId, row) => {\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) return;\n\n      const x = LEFT_MARGIN + columnIndex * COLUMN_WIDTH + COLUMN_WIDTH / 2;\n      const y = TOP_MARGIN + row * PREMISE_ROW_HEIGHT;\n      premiseX.set(premiseId, x);\n\n      nodes.set(premiseId, {\n        id: premiseId,\n        kind: \"premise\",\n        x,\n        y,\n        label: labels.get(premiseId)?.label ?? premise.label,\n        text: premise.text,\n        column: type,\n        dependents: new Set([\n          ...(supports.get(premiseId) ?? []),\n          ...(excludes.get(premiseId) ?? []),\n        ]).size,\n        collapsedPremises: [],\n      });\n    });\n  });\n\n  /* ---- 5. decision positions: barycentre of the premises they rest on ---- */\n  const decisionY =\n    TOP_MARGIN +\n    Math.max(1, maxRows) * PREMISE_ROW_HEIGHT +\n    PREMISE_BAND_HEIGHT * PREMISE_ROW_HEIGHT;\n\n  const positioned = decisions\n    .map((decisionId) => {\n      const feeding = [\n        ...feedingPremises(decisionId, supports),\n        ...feedingPremises(decisionId, excludes),\n      ]\n        .filter((premiseId) => premiseX.has(premiseId))\n        .map((premiseId) => premiseX.get(premiseId) as number);\n\n      const barycentre =\n        feeding.length === 0\n          ? null\n          : feeding.reduce((total, value) => total + value, 0) / feeding.length;\n\n      return { decisionId, barycentre };\n    })\n    /* Decisions with no drawn premise go last, to the right: they are the unverifiable ones, and\n     * clustering them together makes the gap visible instead of scattering it through the diagram. */\n    .sort((a, b) => {\n      if (a.barycentre === null && b.barycentre === null)\n        return a.decisionId < b.decisionId ? -1 : 1;\n      if (a.barycentre === null) return 1;\n      if (b.barycentre === null) return -1;\n      return a.barycentre - b.barycentre || (a.decisionId < b.decisionId ? -1 : 1);\n    });\n\n  /* Barycentre placement can put two decisions at the same x. Spreading them by index within a\n   * tolerance keeps edges short without letting nodes overlap. */\n  const decisionX = new Map<DecisionId, number>();\n  let cursor = LEFT_MARGIN + COLUMN_WIDTH / 2;\n\n  positioned.forEach((entry, index) => {\n    const target =\n      entry.barycentre ??\n      LEFT_MARGIN + Math.max(1, orderedTypes.length) * COLUMN_WIDTH + COLUMN_WIDTH / 2 + index * 40;\n    const x = Math.max(cursor, target);\n    cursor = x + 120;\n    decisionX.set(entry.decisionId, x);\n\n    const decision = state.decisions.get(entry.decisionId);\n    if (decision === undefined) return;\n\n    nodes.set(entry.decisionId, {\n      id: entry.decisionId,\n      kind: \"decision\",\n      x,\n      y: decisionY,\n      label: labels.get(entry.decisionId)?.label ?? decision.label,\n      text: decision.statement,\n      column: null,\n      dependents: 0,\n      collapsedPremises: collapsed.get(entry.decisionId) ?? [],\n    });\n  });\n\n  /* ---- 6. edges ---- */\n  const edges: LatticeEdge[] = [];\n\n  for (const [premiseId, decisionIds] of supports) {\n    if (!nodes.has(premiseId)) continue;\n    for (const decisionId of decisionIds) {\n      if (!nodes.has(decisionId)) continue;\n      edges.push({ from: premiseId, to: decisionId, kind: \"supports\" });\n    }\n  }\n\n  for (const [premiseId, decisionIds] of excludes) {\n    if (!nodes.has(premiseId)) continue;\n    for (const decisionId of decisionIds) {\n      if (!nodes.has(decisionId)) continue;\n      edges.push({ from: premiseId, to: decisionId, kind: \"excludes\" });\n    }\n  }\n\n  for (const decisionId of decisions) {\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    for (const other of decision.edges.dependsOn) {\n      if (nodes.has(other)) edges.push({ from: decisionId, to: other, kind: \"depends-on\" });\n    }\n    for (const other of decision.edges.supersedes) {\n      if (nodes.has(other)) edges.push({ from: decisionId, to: other, kind: \"supersedes\" });\n    }\n    for (const other of decision.edges.conflictsWith) {\n      if (nodes.has(other)) edges.push({ from: decisionId, to: other, kind: \"conflicts\" });\n    }\n    if (includeRelated) {\n      for (const other of decision.edges.related) {\n        if (nodes.has(other)) edges.push({ from: decisionId, to: other, kind: \"depends-on\" });\n      }\n    }\n  }\n\n  const columns = orderedTypes.map((type, index) => ({\n    type,\n    x: LEFT_MARGIN + index * COLUMN_WIDTH + COLUMN_WIDTH / 2,\n    count: (columnOf.get(type) ?? []).length,\n  }));\n\n  const width = LEFT_MARGIN * 2 + Math.max(1, orderedTypes.length) * COLUMN_WIDTH;\n  const height = decisionY + DECISION_ROW_HEIGHT * 2;\n\n  return {\n    nodes,\n    edges,\n    width,\n    height,\n    columns,\n    premiseCount: drawnPremises.length,\n    decisionCount: decisions.length,\n    collapsedPremiseCount: collapsedCount,\n    droppedDecisionCount: includeSuperseded ? 0 : droppedDecisions,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction columnKey(type: PremiseType): PremiseType {\n  return (PREMISE_COLUMN_ORDER as readonly string[]).includes(type) ? type : \"requirement\";\n}\n\nfunction dependentCount(\n  a: PremiseId,\n  b: PremiseId,\n  supports: ReadonlyMap<PremiseId, DecisionId[]>,\n  excludes: ReadonlyMap<PremiseId, DecisionId[]>,\n): number {\n  const countA = new Set([...(supports.get(a) ?? []), ...(excludes.get(a) ?? [])]).size;\n  const countB = new Set([...(supports.get(b) ?? []), ...(excludes.get(b) ?? [])]).size;\n  return countB - countA;\n}\n\nfunction* feedingPremises(\n  decisionId: DecisionId,\n  index: ReadonlyMap<PremiseId, DecisionId[]>,\n): Generator<PremiseId> {\n  for (const [premiseId, decisionIds] of index) {\n    if (decisionIds.includes(decisionId)) yield premiseId;\n  }\n}\n\n/** The ring style for a premise type: solid when the world could falsify it, dashed when only a\n *  human can. Drawn on the node, so the difference between a guardable assumption and an intent is\n *  visible without reading a tooltip. */\nexport function ringFor(type: PremiseType | null): \"solid\" | \"dashed\" {\n  if (type === null) return \"solid\";\n  return PREMISE_RING[type] === \"dashed\" ? \"dashed\" : \"solid\";\n}\n\n/** Premise radius from dependent count. Load-bearing nodes look load-bearing ΓÇö the plan's own\n *  words, and the reason the lattice reads at a glance rather than needing a legend. */\nexport function radiusFor(dependents: number): number {\n  return Math.min(22, 9 + dependents * 3);\n}\n\nexport function describeLayout(layout: LatticeLayout): string {\n  return [\n    `${layout.premiseCount} premise node(s) in ${layout.columns.length} type column(s), ${layout.decisionCount} decision(s) below.`,\n    layout.collapsedPremiseCount > 0\n      ? `${layout.collapsedPremiseCount} premise(s) collapsed into their decision's card ΓÇö a premise supporting exactly one decision adds a node and an edge to say what the card already says.`\n      : \"No premises collapsed.\",\n    layout.droppedDecisionCount > 0\n      ? `${layout.droppedDecisionCount} superseded/archived decision(s) hidden. Toggle to show them.`\n      : \"\",\n    `${layout.edges.length} edge(s).`,\n    \"\",\n    \"Layout is DETERMINISTIC, not a force simulation: columns by premise type, decisions at the\",\n    \"barycentre of the premises they rest on. A force layout settles differently on each render, so\",\n    \"two screenshots of the same log would differ and a cascade animation would move the nodes you\",\n    \"are trying to watch. Same picture every time is what makes this usable as evidence.\",\n  ]\n    .filter((line) => line !== \"\")\n    .join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 28 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 28 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 28 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\graph\\PremiseLattice.tsx"},"span":[4160,4174],"sourceCode":"/**\n * The premise lattice ΓÇö 6.6. Γÿà THE SIGNATURE VISUAL\n *\n * Phase 6 ┬╖ sub-phase 6.6\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * ---------------------------------------------------------------------------\n * NOT A DECISION GRAPH\n *\n * A decision graph ΓÇö what `ai-memory` ships ΓÇö shows decisions linked to decisions. This is\n * BIPARTITE: assumptions are the load-bearing nodes, in columns by type across the top, and\n * decisions hang below them as leaves.\n *\n * Nobody in the category has that picture, because nobody stores that structure. It is not a\n * rendering choice layered over the same data; it is the data. A tool that records \"we chose SQLite\"\n * can draw a node. Only a tool that also records \"given single-user, given no deploy infra, and\n * never if concurrent writers\" can draw this ΓÇö and the picture is the entire argument for why\n * storing the `given` matters.\n *\n * ---------------------------------------------------------------------------\n * THE CASCADE ANIMATION IS THE MONEY SHOT, AND IT IS REAL\n *\n * Click a premise ΓåÆ every decision resting on it highlights ΓåÆ falsify it ΓåÆ labels flip in sequence,\n * edges turn, survivors stay put. Ten seconds of animation communicates the concept better than any\n * paragraph.\n *\n * It animates a REAL cascade: `planCascade` diffs the labels before the falsification against the\n * labels after the reasoning cycle ran. Nothing is simulated. If the cascade stopped because a\n * decision had independent support, the animation shows it stopping there ΓÇö which is the whole\n * point, and exactly the behaviour a simulated cascade would get wrong by showing everything flip.\n *\n * ---------------------------------------------------------------------------\n * RENDERED AS PLAIN SVG, NO LAYOUT LIBRARY\n *\n * The plan allows a force-layout library \"for positioning only\" and this uses none, because a force\n * layout is not reproducible: positions would settle differently each render, so two screenshots of\n * one log would differ and the animation would move the nodes being watched. `LatticeLayout` is\n * deterministic ΓÇö columns by type, decisions at the barycentre of their premises ΓÇö so the same log\n * always draws the same picture. Plain SVG keeps edges, labels and the animation fully controllable.\n *\n * ---------------------------------------------------------------------------\n * THE ANTI-HAIRBALL RULES ARE NOT OPTIONAL EXTRAS\n *\n * A lattice of 40 decisions with every premise drawn is unreadable, and an unreadable signature\n * visual is worse than none. So: one cascade at a time, superseded and `related` edges faded by\n * default behind a toggle, and single-dependent premises collapsed into their decision's card. All\n * three are applied in the LAYOUT, before rendering, so hidden nodes leave no gaps that look like\n * missing data.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  type Labelled,\n  type NodeId,\n  describeReason,\n  label as labelGraph,\n} from \"@/reasoning/labeller\";\nimport { assertPremiseFalsified } from \"@/store/reasoning\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { LABEL_COLOUR } from \"@/theme\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport { type ReactElement, useCallback, useEffect, useMemo, useRef, useState } from \"react\";\nimport {\n  type CascadeAnimationPlan,\n  FLIP_INTERVAL_MS,\n  SETTLE_MS,\n  isPremiseId,\n  planCascade,\n  revealedAt,\n  stepAt,\n} from \"./CascadeAnimation\";\nimport { DecisionNode } from \"./DecisionNode\";\nimport { EdgeLegend, LatticeEdgeView } from \"./LatticeEdge\";\nimport { type Highlight, dependentsOf } from \"./LatticeHighlight\";\nimport {\n  type LatticeLayout,\n  type LayoutOptions,\n  describeLayout,\n  layoutLattice,\n} from \"./LatticeLayout\";\nimport { PremiseNode } from \"./PremiseNode\";\n\nexport interface PremiseLatticeProps {\n  readonly state: GraphState;\n  readonly includeSuperseded?: boolean;\n  readonly includeRelated?: boolean;\n  readonly focus?: readonly NodeId[];\n  readonly onSelect?: (id: NodeId) => void;\n  readonly height?: number;\n}\n\nexport function PremiseLattice(props: PremiseLatticeProps): ReactElement {\n  const labels = useMemo(() => labelGraph(props.state).labels, [props.state]);\n  const [selected, setSelected] = useState<NodeId | null>(null);\n  const [plan, setPlan] = useState<CascadeAnimationPlan | null>(null);\n  const [elapsed, setElapsed] = useState(0);\n  const [busy, setBusy] = useState<string | null>(null);\n  const [showHidden, setShowHidden] = useState(false);\n  const [falsifyFor, setFalsifyFor] = useState<PremiseId | null>(null);\n  const [observation, setObservation] = useState(\"\");\n  const [note, setNote] = useState<string | null>(null);\n\n  const beforeRef = useRef<ReadonlyMap<NodeId, Labelled> | null>(null);\n  const timerRef = useRef<number | null>(null);\n\n  const layout: LatticeLayout = useMemo(() => {\n    const options: LayoutOptions = {\n      includeSuperseded: props.includeSuperseded ?? showHidden,\n      includeRelated: props.includeRelated ?? showHidden,\n      ...(props.focus === undefined ? {} : { focus: props.focus }),\n    };\n    return layoutLattice(props.state, labels, options);\n  }, [props.state, labels, props.includeSuperseded, props.includeRelated, props.focus, showHidden]);\n\n  const highlight: Highlight = useMemo(\n    () =>\n      selected === null\n        ? { origin: null, nodes: new Set(), edges: new Set() }\n        : dependentsOf(props.state, layout, selected),\n    [selected, props.state, layout],\n  );\n\n  /* ---- the animation clock ---- */\n  useEffect(() => {\n    if (plan === null) return;\n\n    const started = Date.now();\n    timerRef.current = window.setInterval(() => {\n      const now = Date.now() - started;\n      setElapsed(now);\n      if (now >= plan.totalMs) {\n        if (timerRef.current !== null) window.clearInterval(timerRef.current);\n        timerRef.current = null;\n      }\n    }, 60);\n\n    return () => {\n      if (timerRef.current !== null) window.clearInterval(timerRef.current);\n      timerRef.current = null;\n    };\n  }, [plan]);\n\n  const revealed = useMemo(\n    () => (plan === null ? new Set<NodeId>() : revealedAt(plan, elapsed)),\n    [plan, elapsed],\n  );\n  const currentStep = plan === null ? null : stepAt(plan, elapsed);\n\n  const select = useCallback(\n    (id: string) => {\n      const nodeId = id as NodeId;\n      setSelected((previous) => (previous === nodeId ? null : nodeId));\n      props.onSelect?.(nodeId);\n    },\n    [props],\n  );\n\n  /** Falsify the selected premise and animate what the reasoning layer actually does to it. */\n  const falsify = async (premiseId: PremiseId): Promise<void> => {\n    const text = observation.trim();\n    if (text.length === 0) {\n      setNote(\n        \"Say what you observed. A falsification with no observation is an opinion, and the log records observations.\",\n      );\n      return;\n    }\n\n    setBusy(premiseId);\n    setNote(null);\n\n    /* Snapshot BEFORE. The animation is a diff, and a diff needs both sides. */\n    beforeRef.current = labelGraph(currentGraph()).labels;\n\n    const outcome = await assertPremiseFalsified(premiseId, text);\n    setBusy(null);\n\n    if (!outcome.ok) {\n      setNote(outcome.error);\n      beforeRef.current = null;\n      return;\n    }\n\n    const before = beforeRef.current;\n    beforeRef.current = null;\n    if (before === null) return;\n\n    /* Re-read the graph AFTER the cycle ran. The animation shows what happened, not what was\n     * expected to happen. */\n    const graphAfter = currentGraph();\n    const after = labelGraph(graphAfter);\n\n    const radius = blastRadius(graphAfter, premiseId);\n    /* `describeReason` needs the graph to name the premise that failed, so it is called with the\n     * AFTER graph ΓÇö the reasons describe the world the cascade produced, not the one it started\n     * from. */\n    const next = planCascade(before, after.labels, premiseId, radius, (_node, _label, reason) =>\n      describeReason(reason, graphAfter),\n    );\n\n    setPlan(next);\n    setElapsed(0);\n    setObservation(\"\");\n    setFalsifyFor(null);\n    setNote(\n      next.steps.length === 0\n        ? `Falsified ${premiseId}. Nothing flipped: ${\n            next.survivors.length > 0\n              ? `${next.survivors.length} node(s) were in the blast radius and every one survived, because each has support that does not depend on this premise.`\n              : \"nothing depended on it.\"\n          }`\n        : `Falsified ${premiseId}. ${next.steps.length} label(s) flipped and ${next.survivors.length} survived. The animation shows the real diff, not a simulation.`,\n    );\n  };\n\n  const selectedPremise =\n    selected !== null && isPremiseId(selected) ? (selected as PremiseId) : null;\n  const selectedNode = selected === null ? null : layout.nodes.get(selected);\n\n  return (\n    <div>\n      <div\n        style={{\n          display: \"flex\",\n          gap: 10,\n          alignItems: \"center\",\n          flexWrap: \"wrap\",\n          marginBottom: 10,\n        }}\n      >\n        <EdgeLegend />\n        <label className=\"faint\" style={{ fontSize: 11, marginLeft: \"auto\" }}>\n          <input\n            type=\"checkbox\"\n            checked={showHidden}\n            onChange={(event) => setShowHidden(event.target.checked)}\n          />{\" \"}\n          show superseded and topical edges\n        </label>\n      </div>\n\n      <div\n        style={{\n          overflowX: \"auto\",\n          border: \"1px solid var(--border)\",\n          borderRadius: 6,\n          background: \"var(--surface-sunken)\",\n        }}\n      >\n        <svg\n          width={Math.max(layout.width, 480)}\n          height={props.height ?? Math.max(320, layout.height)}\n          role=\"img\"\n          aria-label=\"Premise lattice: assumptions as load-bearing nodes, decisions hanging below them\"\n        >\n          {/* column headers */}\n          {layout.columns.map((column) => (\n            <g key={column.type} transform={`translate(${column.x},26)`}>\n              <text\n                textAnchor=\"middle\"\n                className=\"mono\"\n                style={{ fontSize: 10, fill: \"var(--text-faint)\", letterSpacing: 0.6 }}\n              >\n                {column.type.toUpperCase()}\n              </text>\n              <text\n                textAnchor=\"middle\"\n                dy={12}\n                className=\"mono\"\n                style={{ fontSize: 9, fill: \"var(--text-faint)\" }}\n              >\n                {column.count}\n              </text>\n            </g>\n          ))}\n\n          {/* the band separator: premises above, decisions below. The bipartite structure is\n              drawn, not merely implied. */}\n          <line\n            x1={0}\n            x2={Math.max(layout.width, 480)}\n            y1={bandY(layout)}\n            y2={bandY(layout)}\n            stroke=\"var(--border)\"\n            strokeDasharray=\"3 5\"\n          />\n          <text\n            x={8}\n            y={bandY(layout) - 6}\n            className=\"mono\"\n            style={{ fontSize: 9, fill: \"var(--text-faint)\" }}\n          >\n            PREMISES ΓÇö the assumptions\n          </text>\n          <text\n            x={8}\n            y={bandY(layout) + 14}\n            className=\"mono\"\n            style={{ fontSize: 9, fill: \"var(--text-faint)\" }}\n          >\n            DECISIONS ΓÇö what hangs off them\n          </text>\n\n          {/* edges first, so nodes draw on top */}\n          {layout.edges.map((edge) => {\n            const from = layout.nodes.get(edge.from);\n            const to = layout.nodes.get(edge.to);\n            if (from === undefined || to === undefined) return null;\n\n            const key = `${edge.from}\\u0000${edge.to}\\u0000${edge.kind}`;\n            const isHighlighted = highlight.edges.has(key);\n\n            /* An edge turns red when the node it feeds has flipped in this animation. Red means an\n             * action is available, and a decision that just lost its support is exactly that. */\n            const turnedRed = revealed.has(edge.to) && currentStep !== null;\n\n            return (\n              <LatticeEdgeView\n                key={key}\n                edge={edge}\n                from={from}\n                to={to}\n                highlighted={isHighlighted}\n                dimmed={\n                  selected !== null &&\n                  !isHighlighted &&\n                  !highlight.nodes.has(edge.from) &&\n                  !highlight.nodes.has(edge.to)\n                }\n                turnedRed={turnedRed}\n              />\n            );\n          })}\n\n          {/* premise nodes */}\n          {[...layout.nodes.values()]\n            .filter((node) => node.kind === \"premise\")\n            .map((node) => {\n              const premise = props.state.premises.get(node.id as PremiseId);\n              if (premise === undefined) return null;\n\n              return (\n                <PremiseNode\n                  key={node.id}\n                  node={node}\n                  predicate={premise.predicate}\n                  type={premise.type}\n                  selected={selected === node.id}\n                  highlighted={highlight.nodes.has(node.id)}\n                  dimmed={selected !== null && !highlight.nodes.has(node.id)}\n                  flipping={currentStep !== null && currentStep.node === node.id}\n                  onSelect={select}\n                />\n              );\n            })}\n\n          {/* decision nodes */}\n          {[...layout.nodes.values()]\n            .filter((node) => node.kind === \"decision\")\n            .map((node) => {\n              const decision = props.state.decisions.get(node.id as DecisionId);\n              if (decision === undefined) return null;\n\n              return (\n                <DecisionNode\n                  key={node.id}\n                  node={node}\n                  status={decision.status}\n                  selected={selected === node.id}\n                  highlighted={highlight.nodes.has(node.id)}\n                  dimmed={selected !== null && !highlight.nodes.has(node.id)}\n                  flipping={currentStep !== null && currentStep.node === node.id}\n                  onSelect={select}\n                />\n              );\n            })}\n        </svg>\n      </div>\n\n      <pre\n        className=\"mono faint\"\n        style={{ whiteSpace: \"pre-wrap\", margin: \"8px 0 0\", fontSize: 10 }}\n      >\n        {describeLayout(layout)}\n      </pre>\n\n      {/* ---- the cascade, live ---- */}\n      {currentStep !== null ? (\n        <div\n          className=\"notice notice-info\"\n          style={{\n            marginTop: 10,\n            borderLeft: `3px solid ${LABEL_COLOUR[currentStep.to]}`,\n            fontSize: 12,\n          }}\n        >\n          <strong>\n            {currentStep.node}: {currentStep.from} ΓåÆ {currentStep.to}\n          </strong>{\" \"}\n          ({currentStep.order + 1} of {plan?.steps.length ?? 0})\n          <div className=\"dim\" style={{ marginTop: 4 }}>\n            {currentStep.reason}\n          </div>\n        </div>\n      ) : null}\n\n      {plan !== null && elapsed >= plan.totalMs ? (\n        <div className=\"notice notice-info\" style={{ marginTop: 10, fontSize: 12 }}>\n          Cascade settled. {plan.steps.length} label(s) flipped, {plan.survivors.length} survived.\n          {plan.survivors.length > 0 ? (\n            <ul style={{ margin: \"6px 0 0\", paddingLeft: 18 }}>\n              {plan.survivors.map((survivor) => (\n                <li key={survivor.node}>\n                  <span className=\"mono\">{survivor.node}</span> ΓÇö {survivor.reason}\n                </li>\n              ))}\n            </ul>\n          ) : null}\n        </div>\n      ) : null}\n\n      {note !== null ? (\n        <div className=\"notice notice-info\" style={{ marginTop: 10, fontSize: 12 }}>\n          {note}\n        </div>\n      ) : null}\n\n      {/* ---- the selected node, and the falsify composer ---- */}\n      {selectedNode !== undefined && selectedNode !== null ? (\n        <div style={{ marginTop: 12, borderTop: \"1px solid var(--border)\", paddingTop: 10 }}>\n          <div style={{ fontSize: 12 }}>\n            <span className=\"mono faint\">{selectedNode.id}</span>{\" \"}\n            <span className=\"badge\" style={{ color: LABEL_COLOUR[selectedNode.label] }}>\n              {selectedNode.label}\n            </span>{\" \"}\n            {selectedNode.text}\n          </div>\n\n          {selectedNode.kind === \"premise\" ? (\n            <div className=\"dim\" style={{ fontSize: 11, marginTop: 6 }}>\n              {selectedNode.dependents} decision(s) rest on this premise. Falsifying it puts every\n              one of them in play ΓÇö and the ones with independent support will survive, which is the\n              difference between a truth-maintenance system and a house of cards.\n            </div>\n          ) : (\n            <div className=\"dim\" style={{ fontSize: 11, marginTop: 6 }}>\n              {selectedNode.collapsedPremises.length > 0\n                ? `${selectedNode.collapsedPremises.length} premise(s) collapsed into this card: ${selectedNode.collapsedPremises.join(\", \")}. A premise supporting exactly one decision adds a node and an edge to say what the card already says.`\n                : \"Every premise this decision rests on is drawn above it.\"}\n            </div>\n          )}\n\n          {selectedPremise !== null ? (\n            <div style={{ marginTop: 10 }}>\n              {falsifyFor === selectedPremise ? (\n                <div\n                  style={{ display: \"flex\", gap: 8, alignItems: \"flex-start\", flexWrap: \"wrap\" }}\n                >\n                  <textarea\n                    value={observation}\n                    rows={2}\n                    onChange={(event) => setObservation(event.target.value)}\n                    placeholder='what you observed, e.g. \"there are four of us on it now and two edit decisions at the same time\"'\n                    style={{ flex: 1, minWidth: 260, fontSize: 12 }}\n                  />\n                  <button\n                    type=\"button\"\n                    className=\"badge\"\n                    disabled={busy !== null}\n                    onClick={() => void falsify(selectedPremise)}\n                  >\n                    {busy === selectedPremise ? \"Running the cycleΓÇª\" : \"Falsify and watch\"}\n                  </button>\n                  <button type=\"button\" className=\"badge faint\" onClick={() => setFalsifyFor(null)}>\n                    cancel\n                  </button>\n                </div>\n              ) : (\n                <button\n                  type=\"button\"\n                  className=\"badge\"\n                  onClick={() => setFalsifyFor(selectedPremise)}\n                >\n                  Falsify this premise\n                </button>\n              )}\n\n              <div className=\"faint\" style={{ fontSize: 11, marginTop: 6 }}>\n                This runs the real Phase 2 cycle ΓÇö assertion, labelling, backtracking, cascade,\n                entrenchment, adjudication ΓÇö and animates the label diff it produces. It appends\n                events, so it is not a preview.\n              </div>\n            </div>\n          ) : null}\n        </div>\n      ) : (\n        <div className=\"faint\" style={{ marginTop: 10, fontSize: 11 }}>\n          Click a premise to see everything resting on it. Click a decision to see what holds it up.\n        </div>\n      )}\n    </div>\n  );\n}\n\n/** The y of the band separator, derived from the layout rather than hardcoded so it tracks the\n *  premise column depth. */\nfunction bandY(layout: LatticeLayout): number {\n  const decisionYs = [...layout.nodes.values()]\n    .filter((node) => node.kind === \"decision\")\n    .map((node) => node.y);\n  const premiseYs = [...layout.nodes.values()]\n    .filter((node) => node.kind === \"premise\")\n    .map((node) => node.y);\n\n  const lowestPremise = premiseYs.length === 0 ? 56 : Math.max(...premiseYs);\n  const highestDecision = decisionYs.length === 0 ? lowestPremise + 90 : Math.min(...decisionYs);\n\n  return (lowestPremise + highestDecision) / 2;\n}\n\n/** Every node the cascade could reach from this premise. Passed to `planCascade` as the blast\n *  radius so survivors can be named ΓÇö a survivor is only meaningful against the set it survived. */\nfunction blastRadius(state: GraphState, premiseId: PremiseId): readonly NodeId[] {\n  const out: NodeId[] = [premiseId];\n  const direct = state.premiseToDecisions.get(premiseId) ?? [];\n\n  for (const decisionId of direct) {\n    out.push(decisionId);\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n    for (const dependent of decision.edges.dependsOn) out.push(dependent);\n    for (const dependent of decision.edges.sharesPremiseWith) out.push(dependent);\n  }\n\n  return [...new Set(out)];\n}\n\n/**\n * The CURRENT graph, read at call time rather than captured from props.\n *\n * The falsification mutates the log through the store, so `props.state` is the graph from before the\n * cycle ran. Animating against that would show the labels the viewer already saw ΓÇö the opposite of\n * the point. Reading through the store at call time is what makes the animation a diff of reality\n * rather than a diff of a snapshot.\n */\nfunction currentGraph(): GraphState {\n  return useWhyLog.getState().state;\n}\n\nexport { FLIP_INTERVAL_MS, SETTLE_MS };\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * `npm run demo:verify` ΓÇö build the seed, verify every beat, run the dry runs.\n *  const seed = await buildSeed();\n  line(\n    \"built in \" +\n      (seed.durationMs / 1000).toFixed(1) +\"s ┬╖ \" +seed.decisions +\" decisions ┬╖ \" +\n          seed.premises +\" premises ┬╖ engine \" +seed.engineId.kind,\n  );\n  for (const warning of seed.warnings) line(\"  warning: \" + warning);    line(\"Pass --force to run the dry runs anyway.\");\n    process.exitCode = 1;\n    if (args.has(\"out\"))write(args.get(\"out\") ?? \"demo-verification.md\", renderVerification(report));\n    return;\n  }    write(\n      args.get(\"out\") ?? \"demo-verification.md\",\n      [\n        \"# Demo verification\",\"\",\"```\",renderScript(),renderVerification(report),renderDryRuns(dry),,\n      ].join(\"\\n\"),\n    );\n  }\n\n  blank();\n  line(dry.passed ? \"DEMO IS READY.\" : \"DEMO IS NOT READY ΓÇö see the divergences and failures above.\");\n  if (!dry.passed) process.exitCode = 1;\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,88]}}},{"equalLines":{"line_count":33}},{"diffOp":{"equal":{"range":[88,147]}}},{"diffOp":{"delete":{"range":[88,89]}}},{"diffOp":{"insert":{"range":[147,154]}}},{"diffOp":{"equal":{"range":[154,191]}}},{"diffOp":{"delete":{"range":[88,89]}}},{"diffOp":{"insert":{"range":[147,154]}}},{"diffOp":{"equal":{"range":[191,200]}}},{"diffOp":{"delete":{"range":[88,89]}}},{"diffOp":{"insert":{"range":[147,154]}}},{"diffOp":{"equal":{"range":