\n}\n\n/* -------------------------------------------------------------------------- */\n/* The two explanations                                                       */\n/* -------------------------------------------------------------------------- */\n\n/**\n * An IN-list premise died: the reason is gone.\n *\n * Wording matters here. \"Premise P-0002 is no longer IN\" is a statement about the\n * system; \"the assumption that it is a single-user tool no longer holds\" is a\n * statement about the project. Only the second one tells the user what to do.\n */\nfunction inListExplanation(\n  premiseId: PremiseId,\n  premiseText: string,\n  decisionId: DecisionId,\n  statement?: string,\n): string {\n  return [\n    `${decisionId}${statement === undefined ? \"\" : ` ΓÇö \"${statement}\"`} rests on ${premiseId}: \"${premiseText}\".`,\n    \"That assumption no longer holds, so the decision has lost its reason.\",\n    \"Nothing contradicted the decision; one of the things it was true GIVEN has stopped being true.\",\n  ].join(\" \");\n}\n\n/**\n * An OUT-list condition arrived: the thing assumed away happened.\n *\n * This is the sentence no other tool can produce, and it is worth getting right ΓÇö\n * it is the moment the product earns its existence.\n */\nfunction outListExplanation(\n  premiseId: PremiseId,\n  premiseText: string,\n  decisionId: DecisionId,\n  statement?: string,\n): string {\n  return [\n    `${decisionId}${statement === undefined ? \"\" : ` ΓÇö \"${statement}\"`} was made on the condition that ${premiseId} would NOT happen: \"${premiseText}\".`,\n    \"That condition has now been met.\",\n    \"Nobody contradicted the decision and nothing was reversed ΓÇö the world moved into the space the decision assumed would stay empty.\",\n  ].join(\" \");\n}\n\n/* -------------------------------------------------------------------------- */\n/* What a single new assertion would invalidate                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Preview: if this premise became IN, what would break?\n *\n * Used by the review UI BEFORE a commit, so the user can see the blast radius of the\n * premise they are about to accept. It is also the only way to answer \"what would\n * happen ifΓÇª\" without writing anything, which is what makes the labeller's purity\n * worth the extra parameter threading.\n */\nexport function previewInvalidation(\n  state: GraphState,\n  premiseId: PremiseId,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): readonly PremiseInvalidation[] {\n  const simulated = new Map<NodeId, Labelled>(labels);\n  simulated.set(premiseId, { label: \"IN\", reason: { kind: \"asserted-premise\" } });\n\n  const out: PremiseInvalidation[] = [];\n\n  for (const decisionId of state.premiseToDecisions.get(premiseId) ?? []) {\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    for (const justificationId of decision.justificationIds) {\n      const justification = state.justifications.get(justificationId);\n      if (justification === undefined) continue;\n\n      const verdict = validityOf(justification, simulated);\n      if (verdict.valid || verdict.failedNode === null || verdict.failedClause === null) continue;\n      if (verdict.failedNode !== premiseId) continue;\n\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n\n      out.push({\n        gate: \"premise\",\n        verdict: \"premise-invalidation\",\n        premiseId,\n        justificationId,\n        decisionId,\n        clause: verdict.failedClause,\n        premiseText: premise.text,\n        decisionStatement: decision.statement,\n        explanation:\n          verdict.failedClause === \"out-list\"\n            ? outListExplanation(premiseId, premise.text, decisionId, decision.statement)\n            : inListExplanation(premiseId, premise.text, decisionId, decision.statement),\n      });\n    }\n  }\n\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/** How many decisions rest on each premise. The premise with the highest count is\n *  the one whose invalidation would hurt most, and it is worth showing BEFORE it\n *  fails rather than after. */\nexport function loadBearingPremises(\n  state: GraphState,\n  limit = 5,\n): readonly { premiseId: PremiseId; decisions: number; text: string; label: DecisionLabel }[] {\n  const out: { premiseId: PremiseId; decisions: number; text: string; label: DecisionLabel }[] = [];\n\n  for (const [premiseId, decisions] of state.premiseToDecisions) {\n    const premise = state.premises.get(premiseId);\n    if (premise === undefined) continue;\n    out.push({ premiseId, decisions: decisions.length, text: premise.text, label: premise.label });\n  }\n\n  return out\n    .sort((a, b) => b.decisions - a.decisions || a.premiseId.localeCompare(b.premiseId))\n    .slice(0, limit);\n}\n\nexport function describeResult(result: GateCResult): string {\n  if (result.invalidations.length === 0) {\n    return `no premise invalidations ΓÇö all ${result.checked} justifications still hold`;\n  }\n\n  const outList = result.invalidations.filter((i) => i.clause === \"out-list\").length;\n  const inList = result.invalidations.length - outList;\n\n  return [\n    `${result.invalidations.length} broken justification${result.invalidations.length === 1 ? \"\" : \"s\"}`,\n    `${inList} because a supporting premise died`,\n    `${outList} because an excluded condition arrived`,\n    `${result.becameUnsound.length} decision${result.becameUnsound.length === 1 ? \"\" : \"s\"} lost all support`,\n    `${result.triggeringPremises.length} premise${result.triggeringPremises.length === 1 ? \"\" : \"s\"} triggered it`,\n  ].join(\" ┬╖ \");\n}\n\n/**\n * The sentence that explains why this gate exists.\n *\n * Shown in the health panel and in the proposal footer, because gate (c) is the\n * claim the whole product rests on and it should be stated in words a user can\n * check against their own week.\n */\nexport function describeGate(): string {\n  return [\n    \"Gate (c) does not look for contradictions.\",\n    \"It looks for decisions whose assumptions stopped holding ΓÇö the case where nobody said anything inconsistent and the decision became wrong anyway.\",\n    \"It can only fire on a decision that was recorded WITH its premises, which is why Phase 1 recovers them and why every extracted premise goes through review.\",\n  ].join(\" \");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 41 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 41 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 41 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\reasoning\\gates\\structural.ts"},"span":[3407,3423],"sourceCode":"/**\n * Gate (a) ΓÇö structural contradiction. 2.3.\n *\n * Phase 2 ┬╖ sub-phase 2.3\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.3\n * Research: docs/03 ┬º4 (three-gate detector), docs/02 ┬º4\n *\n * ---------------------------------------------------------------------------\n * THE CREDIBILITY ANCHOR\n *\n * This gate needs no model, no network, no threshold and no judgement. When somebody\n * asks \"isn't this just an LLM wrapper?\", the answer is that the most important\n * contradiction in the demo fires from a hash lookup and a date comparison.\n *\n * It is also the gate that works when everything else is degraded: no key, a stale\n * index, an embedding model that changed. Determinism is not a limitation here, it\n * is the feature.\n *\n * ---------------------------------------------------------------------------\n * THE LOAD-BEARING FACT BEHIND IT\n *\n * \"use Postgres\" and \"don't use Postgres\" are ~0.9 cosine similar (docs/03). A\n * negation changes almost nothing in vector space, so embeddings CANNOT detect\n * contradiction ΓÇö they detect topical similarity. Gate (a) fires precisely where\n * retrieval is blind, which is why it runs first and never consults a vector.\n *\n * ---------------------------------------------------------------------------\n * PRECISION DISCIPLINE\n *\n * Structural hits are high-precision and low-recall: they fire only when both\n * decisions resolved to the same ontology variable. NEVER widen this gate with fuzzy\n * matching to improve recall ΓÇö that is gate (b)'s job, and mixing them destroys the\n * one detector whose false-positive rate is provably zero. A user who learns that\n * \"contradiction\" sometimes means \"these two seemed related\" stops reading the\n * warnings, and then the real one is missed too.\n * ---------------------------------------------------------------------------\n */\n\nimport { canonicalValueOf } from \"@/ontology/canonicalize\";\nimport { areAntonyms } from \"@/ontology/data/antonyms\";\nimport { overlaps } from \"@/substrate/bi-temporal\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, ValidityWindow } from \"@/types/common\";\nimport type { DecisionVariable } from \"@/types/domain\";\nimport type { ContradictionVerdict } from \"@/types/retrieval\";\n\nexport interface StructuralHit {\n  readonly gate: \"structural\";\n  readonly verdict: ContradictionVerdict;\n  readonly decisionA: DecisionId;\n  readonly decisionB: DecisionId;\n  readonly variable: DecisionVariable;\n  readonly valueA: string;\n  readonly valueB: string;\n  /** Which of the two rules fired. Shown verbatim, so the user is told the RULE\n   *  rather than shown a similarity score they cannot argue with. */\n  readonly via: \"different-value\" | \"antonym-pair\";\n  readonly explanation: string;\n  readonly why: string | null;\n}\n\n/**\n * Every structural contradiction among LIVE, IN-labelled decisions.\n *\n * Two rules, and a pair may satisfy both:\n *\n *   1. same variable, different canonical value ΓÇö two live answers to one question\n *   2. both values are a declared antonym pair ΓÇö the table says why they cannot\n *      coexist, which is a better explanation than \"they differ\"\n *\n * Superseded and archived decisions are excluded. Reversing a decision is not\n * contradicting it: the log keeps both, linked by `supersedes`, and flagging every\n * reversal would put the whole supersession mechanism in the conflict queue.\n */\nexport function detectStructural(state: GraphState): readonly StructuralHit[] {\n  const hits: StructuralHit[] = [];\n  const seen = new Set<string>();\n\n  for (const [variable, ids] of state.byVariable) {\n    const live = ids\n      .map((id) => state.decisions.get(id))\n      .filter(\n        (decision) =>\n          decision !== undefined &&\n          decision.label === \"IN\" &&\n          decision.status !== \"superseded\" &&\n          decision.status !== \"archived\",\n      );\n\n    for (let i = 0; i < live.length; i += 1) {\n      for (let j = i + 1; j < live.length; j += 1) {\n        const a = live[i];\n        const b = live[j];\n        if (a === undefined || b === undefined) continue;\n\n        const canonicalA = canonicalValueOf(variable, a.value);\n        const canonicalB = canonicalValueOf(variable, b.value);\n        if (canonicalA === canonicalB) continue;\n\n        // A reversal is recorded as a supersession, not as a contradiction. If the\n        // graph already links them, this pair has been adjudicated once and the\n        // answer was \"the later one wins\".\n        if (a.edges.supersedes.includes(b.id) || b.edges.supersedes.includes(a.id)) continue;\n\n        // Overlapping VALIDITY WINDOWS are part of the rule, not a refinement. Two\n        // decisions that were true at different times are a history, not a conflict,\n        // and firing on a history is how a detector learns to cry wolf.\n        if (!overlaps(a.temporal, b.temporal)) continue;\n\n        const key = pairKey(a.id, b.id);\n        if (seen.has(key)) continue;\n        seen.add(key);\n\n        const antonym = areAntonyms(variable, canonicalA, canonicalB);\n        const why = antonym.antonym ? antonym.why : null;\n\n        hits.push({\n          gate: \"structural\",\n          verdict: \"contradiction\",\n          decisionA: a.id,\n          decisionB: b.id,\n          variable,\n          valueA: canonicalA,\n          valueB: canonicalB,\n          via: antonym.antonym ? \"antonym-pair\" : \"different-value\",\n          explanation: antonym.antonym\n            ? `${a.id} and ${b.id} are both live and IN on ${variable}, and \"${canonicalA}\" and \"${canonicalB}\" are a declared antonym pair. ${why ?? \"\"}`.trim()\n            : `${a.id} and ${b.id} are both live and IN on ${variable} with different values: \"${canonicalA}\" and \"${canonicalB}\". One question, two current answers.`,\n          why,\n        });\n      }\n    }\n  }\n\n  return hits;\n}\n\n/** Placeholder standing in for the decision that does not exist yet. `wouldContradict`\n *  runs BEFORE a commit, so there is no id to name; a sentinel keeps the hit shape\n *  identical to a real one and the review UI can render both with one component. */\nexport const NEWCOMER_ID = \"WLD-NEW\" as DecisionId;\n\n/** Stable regardless of argument order, so a pair is never reported twice. */\nexport function pairKey(a: DecisionId, b: DecisionId): string {\n  return a < b ? `${a}\\u0000${b}` : `${b}\\u0000${a}`;\n}\n\n/**\n * Would asserting this value contradict something already live?\n *\n * Called BEFORE a commit rather than after, which is what lets the review UI say\n * \"this contradicts WLD-0003\" at the moment the user is deciding whether to keep an\n * extracted decision. Detecting it afterwards is still correct, but by then the node\n * exists and retracting it is a bigger act than refusing it.\n */\nexport function wouldContradict(\n  state: GraphState,\n  variable: DecisionVariable,\n  value: string,\n  window?: ValidityWindow,\n): readonly StructuralHit[] {\n  const canonical = variable === \"OTHER\" ? value : canonicalValueOf(variable, value);\n  const ids = state.byVariable.get(variable) ?? [];\n  const hits: StructuralHit[] = [];\n\n  for (const id of ids) {\n    const existing = state.decisions.get(id);\n    if (existing === undefined) continue;\n    if (existing.label !== \"IN\") continue;\n    if (existing.status === \"superseded\" || existing.status === \"archived\") continue;\n\n    const existingCanonical = canonicalValueOf(variable, existing.value);\n    if (existingCanonical === canonical) continue;\n    if (window !== undefined && !overlaps(existing.temporal, window)) continue;\n\n    const antonym = areAntonyms(variable, canonical, existingCanonical);\n    hits.push({\n      gate: \"structural\",\n      verdict: \"contradiction\",\n      decisionA: id,\n      decisionB: NEWCOMER_ID,\n      variable,\n      valueA: existingCanonical,\n      valueB: canonical,\n      via: antonym.antonym ? \"antonym-pair\" : \"different-value\",\n      explanation: antonym.antonym\n        ? `A new ${variable} decision of \"${canonical}\" contradicts ${id} (\"${existingCanonical}\"): ${antonym.why}`\n        : `A new ${variable} decision of \"${canonical}\" contradicts ${id}, which is live and IN with \"${existingCanonical}\".`,\n      why: null,\n    });\n  }\n\n  return hits;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeHits(hits: readonly StructuralHit[]): string {\n  if (hits.length === 0)\n    return \"no structural contradictions ΓÇö no two live decisions answer the same question differently\";\n  const antonyms = hits.filter((hit) => hit.via === \"antonym-pair\").length;\n  return [\n    `${hits.length} structural contradiction${hits.length === 1 ? \"\" : \"s\"}`,\n    antonyms > 0 ? `${antonyms} from the antonym table` : \"none from the antonym table\",\n    `${hits.length - antonyms} from same-variable-different-value`,\n    \"detected with no model, no network and no threshold\",\n  ].join(\" ┬╖ \");\n}\n\n/**\n * What this gate CANNOT see, stated plainly.\n *\n * Shown in the health panel because a detector whose blind spots are invisible is a\n * detector that will be over-trusted. Gate (a) only fires when both decisions\n * resolved to the same ontology variable ΓÇö so a contradiction between a DATABASE\n * decision and an ARCHITECTURE decision that implies it is gate (b)'s problem, and\n * until Phase 3 exists it is nobody's problem.\n */\nexport function describeBlindSpots(): string {\n  return [\n    \"Requires both decisions to resolve to the SAME ontology variable.\",\n    \"Cannot see a contradiction implied across variables (a DATABASE choice that rules out an ARCHITECTURE choice).\",\n    \"Cannot see two decisions that are compatible in words and incompatible in effect.\",\n    \"Those are gate (b), which needs Phase 3's retrieval stack.\",\n  ].join(\" \");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 19 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 19 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 19 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\s