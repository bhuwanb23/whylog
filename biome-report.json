: \"P-0025\",\n        \"text\": \"Quick-log ΓåÆ \\\"Actually let's switch to Postgres, we need concurrent writes\",\n        \"label\": \"IN\"\n      },\n      {\n        \"id\": \"P-0026\",\n        \"text\": \"the UI is throwaway for the demo\",\n        \"label\": \"IN\"\n      },\n      {\n        \"id\": \"P-0027\",\n        \"text\": \"reasoning: dozens of decisions, sub-ms scan, no infra\",\n        \"label\": \"IN\"\n      },\n      {\n        \"id\": \"P-0028\",\n        \"text\": \"Quick-log ΓåÆ \\\"Actually let's switch to Postgres, we need concurrent writes\",\n        \"label\": \"IN\"\n      },\n      {\n        \"id\": \"P-0029\",\n        \"text\": \"how many decisions are we talking about realistically\",\n        \"label\": \"IN\"\n      }\n    ],\n    \"rejected\": [\n      {\n        \"value\": \"ui\",\n        \"whyRejected\": null\n      }\n    ],\n    \"appliesTo\": []\n  }\n];\n\n\n/* ---------------------------------------------------------------- project -- */\n\nfunction readManifest() {\n  try {\n    const raw = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\"));\n    return {\n      dependencies: raw.dependencies || {},\n      devDependencies: raw.devDependencies || {},\n    };\n  } catch {\n    return { dependencies: {}, devDependencies: {} };\n  }\n}\n\nfunction listFiles(dir, out) {\n  out = out || [];\n  let entries;\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    if (entry.name === \"node_modules\" || entry.name === \".git\") continue;\n    const full = path.join(dir, entry.name);\n    if (entry.isDirectory()) listFiles(full, out);\n    else out.push(full.split(path.sep).join(\"/\"));\n  }\n  return out;\n}\n\nfunction readFile(p) {\n  try {\n    return fs.readFileSync(p, \"utf8\");\n  } catch {\n    return undefined;\n  }\n}\n\n/* -------------------------------------------------------------------- glob -- */\n/* Transcribed from src/lib/glob.ts so results match the in-browser run.      */\n\nfunction globToRegExpSource(glob) {\n  let out = \"\";\n  for (let i = 0; i < glob.length; i += 1) {\n    const c = glob[i];\n    if (c === \"*\") {\n      if (glob[i + 1] === \"*\") {\n        if (glob[i + 2] === \"/\") { out += \"(?:.*/)?\"; i += 2; }\n        else { out += \".*\"; i += 1; }\n      } else out += \"[^/]*\";\n    } else if (c === \"?\") out += \"[^/]\";\n    else if (c === \".\") out += \"\\\\.\";\n    else if (\"+^${}|()[]\".includes(c)) out += \"\\\\\" + c;\n    else out += c;\n  }\n  return out;\n}\n\nfunction matchesGlob(p, glob) {\n  return new RegExp(\"^\" + globToRegExpSource(glob) + \"$\").test(p);\n}\n\n/* Word boundaries ON by default: a bare substring match on \"pg\" hits \"pgp\",   */\n/* \"pgsql-tools\" and any passing mention in a comment.                        */\nfunction compilePattern(pattern, wordBoundary, caseSensitive) {\n  const escaped = pattern.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n  const source = wordBoundary === false ? escaped : \"\\\\b\" + escaped + \"\\\\b\";\n  return new RegExp(source, caseSensitive ? \"g\" : \"gi\");\n}\n\nfunction findMatchInText(text, pattern, wordBoundary, caseSensitive) {\n  const re = compilePattern(pattern, wordBoundary, caseSensitive);\n  const lines = text.split(\"\\n\");\n  for (let i = 0; i < lines.length; i += 1) {\n    re.lastIndex = 0;\n    if (re.test(lines[i])) return { line: i + 1, text: lines[i].trim() };\n  }\n  return null;\n}\n\n/* ---------------------------------------------------------------- evaluate -- */\n\nfunction evaluate(guard, project) {\n  const spec = guard.spec;\n\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\": {\n      /* Same asymmetry as the browser: an ABSENCE check covers devDependencies, because a\n       * rejected package installed for tooling is still installed. A PRESENCE check does not,\n       * because a build-only dependency does not mean the decision was implemented. */\n      const includeDev = spec.includeDev === undefined\n        ? spec.kind === \"dependency_absent\"\n        : spec.includeDev;\n\n      const inRuntime = project.dependencies[spec.package];\n      const inDev = includeDev ? project.devDependencies[spec.package] : undefined;\n      const version = inRuntime !== undefined ? inRuntime : inDev;\n      const where = inRuntime !== undefined ? \"dependencies\" : \"devDependencies\";\n\n      if (spec.kind === \"dependency_present\") {\n        return version === undefined\n          ? { outcome: \"fail\", evidence: '\"' + spec.package + '\" is not in package.json' + (includeDev ? \" (checked dependencies and devDependencies)\" : \" (checked dependencies only)\") }\n          : { outcome: \"pass\", evidence: '\"' + spec.package + '\": \"' + version + '\" is present in ' + where };\n      }\n      return version !== undefined\n        ? { outcome: \"fail\", evidence: '\"' + spec.package + '\": \"' + version + '\" found in package.json ' + where }\n        : { outcome: \"pass\", evidence: '\"' + spec.package + '\" does not appear in package.json' };\n    }\n\n    case \"path_glob_exists\":\n    case \"path_glob_absent\": {\n      const matches = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (spec.kind === \"path_glob_exists\") {\n        return matches.length === 0\n          ? { outcome: \"fail\", evidence: \"No file matches `\" + spec.glob + \"` among \" + project.files.length + \" path(s)\" }\n          : { outcome: \"pass\", evidence: matches.length + \" file(s) match `\" + spec.glob + \"`: \" + matches.slice(0, 6).join(\", \") };\n      }\n      return matches.length > 0\n        ? { outcome: \"fail\", evidence: matches.length + \" file(s) match `\" + spec.glob + \"` but none should: \" + matches.slice(0, 6).join(\", \") }\n        : { outcome: \"pass\", evidence: \"No file matches `\" + spec.glob + \"`\" };\n    }\n\n    case \"string_in_files\":\n    case \"string_absent_in_files\": {\n      const scoped = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (scoped.length === 0) {\n        return { outcome: \"skip\", evidence: \"no file matches the scope `\" + spec.glob + \"`\" };\n      }\n      const wordBoundary = spec.wordBoundary === undefined ? true : spec.wordBoundary;\n      const caseSensitive = spec.caseSensitive === undefined ? false : spec.caseSensitive;\n\n      for (const file of scoped) {\n        const text = readFile(file);\n        if (text === undefined) continue;\n        const hit = findMatchInText(text, spec.pattern, wordBoundary, caseSensitive);\n        if (hit === null) continue;\n\n        const where = file + \":\" + hit.line;\n        const quoted = JSON.stringify(hit.text.length > 160 ? hit.text.slice(0, 157) + \"...\" : hit.text);\n        if (spec.kind === \"string_absent_in_files\") {\n          return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n        }\n        return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n      }\n\n      if (spec.kind === \"string_in_files\") {\n        return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching `\" + spec.glob + \"`\" };\n      }\n      return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching `\" + spec.glob + \"`\" };\n    }\n\n    case \"command_exit_zero\": {\n      /* CI has a shell, which the browser does not. This is the one kind whose result can\n       * legitimately differ between the two targets, and it is environment-dependent by\n       * nature ΓÇö which is why it is never `blocking` by default. */\n      try {\n        const { execSync } = require(\"node:child_process\");\n        execSync(spec.command, { stdio: \"pipe\", cwd: spec.cwd || \".\" });\n        return { outcome: \"pass\", evidence: \"`\" + spec.command + \"` exited 0\" };\n      } catch (error) {\n        const out = (error.stdout || error.stderr || \"\").toString().trim().split(\"\\n\")[0] || \"\";\n        return { outcome: \"fail\", evidence: \"`\" + spec.command + \"` exited non-zero\" + (out ? \": \" + out : \"\") };\n      }\n    }\n\n    default:\n      return { outcome: \"skip\", evidence: \"kind \" + spec.kind + \" cannot run in CI without a model\" };\n  }\n}\n\n/* ----------------------------------------------------------------- report -- */\n/* The failure message is the product. It does the job of an ADR, a code-review */\n/* comment and an onboarding document, at the moment it is useful.             */\n\nfunction reportFailure(guard, result) {\n  const lines = [];\n  lines.push(\"\");\n  lines.push(\"\\x1b[31m\\u2717 \" + guard.decisionId + \" \\u2014 \" + guard.statement + \"\\x1b[0m\");\n  lines.push(\"  Guard \" + guard.id + \" (\" + guard.kind + \": \" + guard.target + \") FAILED  [\" + guard.severity + \"]\");\n  lines.push(\"  Evidence: \" + result.evidence);\n  lines.push(\"  Why this check verifies that decision: \" + guard.rationale);\n\n  const premises = guard.restsOn.length === 0\n    ? \"nothing recorded\"\n    : guard.restsOn.map((p) => p.id + \" \" + p.text + \" (\" + p.label + \")\").join(\", \");\n  lines.push(\"  Decided: \" + guard.decidedAt + \" \\u00b7 Rests on: \" + premises);\n\n  if (guard.restsOn.length === 0) {\n    lines.push(\"    (no recorded premise, so nothing can falsify it \\u2014 a gap worth filling in WhyLog)\");\n  }\n\n  for (const alt of guard.rejected) {\n    lines.push(\"  Rejected alternative \" + alt.value + (alt.whyRejected ? \" \\u2014 reason: \\\"\" + alt.whyRejected + \"\\\"\" : \" \\u2014 no reason recorded\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"  \\u2192 Is this a deliberate reversal?   Record it in WhyLog so the log stops claiming otherwise.\");\n  lines.push(\"  \\u2192 Or is this drift?                Undo the change: \" + undoHint(guard));\n  return lines.join(\"\\n\");\n}\n\nfunction undoHint(guard) {\n  switch (guard.kind) {\n    case \"dependency_absent\": return \"remove the \\\"\" + guard.target + \"\\\" dependency.\";\n    case \"dependency_present\": return \"install \\\"\" + guard.target + \"\\\", or record the decision that replaced it.\";\n    case \"path_glob_absent\": return \"remove the file(s) matching \\\"\" + guard.target + \"\\\".\";\n    case \"path_glob_exists\": return \"restore the file(s) matching \\\"\" + guard.target + \"\\\".\";\n    case \"string_absent_in_files\": return \"remove \\\"\" + guard.target + \"\\\" from the files in scope.\";\n    case \"string_in_files\": return \"add \\\"\" + guard.target + \"\\\" where the decision expects it.\";\n    default: return \"see the guard's rationale above.\";\n  }\n}\n\n/* -------------------------------------------------------------------- main -- */\n\nfunction main() {\n  const manifest = readManifest();\n  const files = listFiles(\".\");\n  const project = { dependencies: manifest.dependencies, devDependencies: manifest.devDependencies, files: files };\n\n  console.log(\"WhyLog decision guards \\u00b7 \" + GUARDS.length + \" guard(s) \\u00b7 \" + files.length + \" file(s) scanned\");\n\n  let blocking = 0;\n  let warnings = 0;\n  let passed = 0;\n  let skipped = 0;\n\n  for (const guard of GUARDS) {\n    const result = evaluate(guard, project);\n\n    if (result.outcome === \"pass\") { passed += 1; continue; }\n    if (result.outcome === \"skip\") {\n      skipped += 1;\n      console.log(\"\\x1b[33m\\u2013 \" + guard.id + \" SKIPPED\\x1b[0m (\" + guard.kind + \": \" + guard.target + \") \\u2014 \" + result.evidence);\n      continue;\n    }\n\n    if (guard.severity === \"blocking\") blocking += 1;\n    else warnings += 1;\n\n    console.log(reportFailure(guard, result));\n  }\n\n  console.log(\"\");\n  console.log(\"  passed \" + passed + \" \\u00b7 failed \" + (blocking + warnings) + \" (\" + blocking + \" blocking, \" + warnings + \" warning) \\u00b7 skipped \" + skipped);\n\n  if (blocking > 0) {\n    console.log(\"\\n\\x1b[31m\" + blocking + \" blocking decision guard(s) failed.\\x1b[0m\");\n    console.log(\"Each failure above names the decision, the premise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\n\" + warnings + \" warning-level guard(s) failed \\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 18 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 18 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 18 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\chunking.ts"},"span":[3167,3177],"sourceCode":"/**\n * Chunking ΓÇö 1.1.\n *\n * Phase 1 ┬╖ sub-phase 1.1\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.1\n *\n * ---------------------------------------------------------------------------\n * CHUNK AT ~12k CHARACTERS ON SPEAKER-TURN BOUNDARIES, NEVER MID-SENTENCE\n *\n * Chunking exists for the LLM path: one call per chunk. But it runs on BOTH paths,\n * because the local recognisers also process an episode at a time and a chunk is\n * what bounds the episode search. Keeping the two paths on the same chunking means\n * Phase 7's ablation compares engines rather than windowing strategies.\n *\n * Two rules do the work:\n *\n *   ΓÇó A boundary may only fall BETWEEN turns. Acceptance criterion 1.1 says so\n *     directly, and the reason is the SQLite episode: it spans four turns, and a\n *     chunk that cut through it would hand the recogniser a premise in one chunk\n *     and the decision it supports in the next.\n *\n *   ΓÇó Consecutive chunks OVERLAP BY ONE TURN. That overlap is what keeps a\n *     negotiated decision from being split: the last turn of chunk N is the first\n *     turn of chunk N+1, so an episode that straddles the boundary is whole in at\n *     least one of them. Duplicates created by the overlap are removed by entity\n *     resolution (1.7), which is exactly what that stage is for.\n *\n * ---------------------------------------------------------------------------\n * THE OVERSIZED TURN\n *\n * A single turn longer than the budget cannot be split on a turn boundary, because\n * there is only one. It becomes a chunk of its own, over budget, and is reported\n * in `oversized`. Splitting it mid-sentence would break the rule that protects the\n * episode; letting it through whole costs tokens but loses nothing.\n * ---------------------------------------------------------------------------\n */\n\nimport type { NormalizedTurn } from \"./types\";\n\nexport const DEFAULT_CHUNK_CHARS = 12_000;\n\n/** Never emit a chunk smaller than this unless the transcript is smaller.\n *  Tiny chunks mean tiny episodes and tiny episodes lose the negotiation. */\nconst MIN_CHUNK_CHARS = 1_500;\n\nexport interface Chunk {\n  readonly index: number;\n  readonly turns: readonly NormalizedTurn[];\n  /** Bounds in the RAW input, so a chunk can be highlighted in the review pane. */\n  readonly rawRange: readonly [start: number, end: number];\n  /** The concatenated turn bodies ΓÇö what an engine is sent. */\n  readonly text: string;\n  readonly chars: number;\n  /** True when the first turn also ended the previous chunk. The recogniser uses\n   *  this to avoid reporting the same decision twice. */\n  readonly overlapsPrevious: boolean;\n  /** True when one turn alone exceeded the budget. */\n  readonly oversized: boolean;\n}\n\nexport interface ChunkingResult {\n  readonly chunks: readonly Chunk[];\n  readonly budget: number;\n  readonly oversizedTurns: number;\n}\n\n/**\n * Split normalised turns into overlapping chunks.\n *\n * @param budget target characters per chunk. A soft ceiling: the chunker stops\n *               ADDING turns once it is exceeded, so a chunk may overshoot by\n *               one turn's length rather than cutting a turn in half.\n */\nexport function chunkTurns(\n  turns: readonly NormalizedTurn[],\n  budget: number = DEFAULT_CHUNK_CHARS,\n): ChunkingResult {\n  if (turns.length === 0) {\n    return { chunks: [], budget, oversizedTurns: 0 };\n  }\n\n  const chunks: Chunk[] = [];\n  let oversizedTurns = 0;\n  let start = 0;\n\n  while (start < turns.length) {\n    let end = start; // exclusive\n    let chars = 0;\n\n    // Always take at least one turn, so an oversized turn still produces a chunk\n    // rather than an infinite loop.\n    const first = turns[start];\n    if (first !== undefined) {\n      chars += first.text.length;\n      if (chars > budget) oversizedTurns += 1;\n      end = start + 1;\n    }\n\n    while (end < turns.length) {\n      const next = turns[end];\n      if (next === undefined) break;\n      if (chars + next.text.length > budget && chars >= MIN_CHUNK_CHARS) break;\n      chars += next.text.length;\n      end += 1;\n    }\n\n    chunks.push(buildChunk(chunks.length, turns, start, end, chunks.length > 0));\n    if (end >= turns.length) break;\n\n    // One turn of overlap. `end - 1` is safe because `end > start` always holds:\n    // the loop above takes at least one turn.\n    start = Math.max(start + 1, end - 1);\n  }\n\n  return { chunks, budget, oversizedTurns };\n}\n\nfunction buildChunk(\n  index: number,\n  turns: readonly NormalizedTurn[],\n  start: number,\n  end: number,\n  overlapsPrevious: boolean,\n): Chunk {\n  const slice = turns.slice(start, end);\n  const text = slice.map((t) => t.text).join(\"\\n\\n\");\n\n  const first = slice[0];\n  const last = slice[slice.length - 1];\n  const rawStart = first?.rawStart ?? 0;\n  const rawEnd = last?.rawEnd ?? rawStart;\n\n  const oversized = slice.length === 1 && (first?.text.length ?? 0) > DEFAULT_CHUNK_CHARS;\n\n  return {\n    index,\n    turns: slice,\n    rawRange: [rawStart, rawEnd],\n    text,\n    chars: text.length,\n    overlapsPrevious,\n    oversized,\n  };\n}\n\n/**\n * Which chunk a turn belongs to.\n *\n * With overlap a turn can belong to two chunks; the FIRST is returned, because\n * that is the chunk whose recogniser will report it. Used by `pipeline.ts` to\n * deduplicate candidates from the overlap region.\n */\nexport function chunkOfTurn(chunks: readonly Chunk[], turnIndex: number): Chunk | null {\n  for (const chunk of chunks) {\n    if (chunk.turns.some((t) => t.index === turnIndex)) return chunk;\n  }\n  return null;\n}\n\n/** Turns that appear in more than one chunk. Reported so the user can see why an\n *  extraction produced more candidates than the transcript seems to contain. */\nexport function overlappedTurnIndexes(chunks: readonly Chunk[]): readonly number[] {\n  const seen = new Map<number, number>();\n  for (const chunk of chunks) {\n    for (const turn of chunk.turns) {\n      seen.set(turn.index, (seen.get(turn.index) ?? 0) + 1);\n    }\n  }\n  return [...seen.entries()]\n    .filter(([, count]) => count > 1)\n    .map(([index]) => index)\n    .sort((a, b) => a - b);\n}\n\nexport function describeChunking(result: ChunkingResult): string {\n  const parts = [`${result.chunks.length} chunk${result.chunks.length === 1 ? \"\" : \"s\"}`];\n  parts.push(`budget ${Math.round(result.budget / 1000)}k chars`);\n  if (result.oversizedTurns > 0) {\n    parts.push(\n      `${result.oversizedTurns} turn${result.oversizedTurns === 1 ? \"\" : \"s\"} over budget ΓÇö sent whole rather than split mid-sentence`,\n    );\n  }\n  return parts.join(\" ┬╖ \");\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The hardening pass ΓÇö 7.4.\n *      n === 0\n        ? \"VACUOUS: no survivors were expected in any plant that ran, so over-retraction is UNTESTED rather than absent.\"\n        : over +\n          \" over-retraction(s) across \" +n +\" expected survivor(s); survivor preservation \" +value.toFixed(3) +\".\",\n    mitigation:\n      \"Set cascade depth to 1 in Settings before the demo. It trades the three-level plant for a \" +        : l2.flipped.length > 0\n          ? l2.flipped.join(\", \") + \" went unsound as expected\"\n          : \"expected \" +\n            l2.expectedUnsound.join(\", \") +\" to go unsound; \" +\n            (l2.notFlipped.length > 0\n              ? l2.notFlipped.join(\", \") + \" did not\": \"none were resolvable\") +\n            (l2.unresolvable.length > 0 ? \"; unresolvable: \" + l2.unresolvable.join(\", \") : \"\");\n      \"the claim the whole demo is built around.\",\n    passes: fires,\n    evidence:detail + \". Non-empty OUT-lists in the graph: \" + scored.invalidation.outListPopulated + \".\",\n    mitigation:\n      \"Fall back to the scripted fixture pair (`fixtures/demo-transcript.txt` then \" +    passes: clean,\n    evidence:\n      modality.wronglyPromoted.length +\" non-decision(s) became nodes out of \" +modality.declinesExpected +\n      \" labelled declines. Adversarial tier: \" +\n      (adversarial === undefined\n        ? \"not present in the corpus\"\n        : adversarial.wronglyPromoted +\" wrongly promoted of \" +adversarial.expected +\" expected declines\") +\".\",\n    mitigation:\n      \"Filter the graph view to origin=human and modality=asserted before showing it. The hypothetical \" +function dayOneGuardFailures(scored: ScoredRun): DemoKiller {\n  const guards = scored.guards;\n  const violations =guards.skippedCountedAsPass + guards.autoAccepted + guards.staleDisabledFlags;\n\n  return {    passes: violations === 0,\n    evidence:\n      guards.guards +\" guard(s) synthesised across \" +guards.decisionsTotal +\" decisions (\" +\n      (guards.synthesisRate * 100).toFixed(0) +\"%). Invariant violations: \" +guards.skippedCountedAsPass +\n      \" skip(s) counted as pass, \" +guards.autoAccepted +\" auto-accepted, \" +guards.staleDisabledFlags +\n      \" stale disabled flag(s). All three must be zero.\",\n    mitigation: * mechanical, which is how the roadmap in `docs/LIMITATIONS.md` is derived rather than invented.\n */\nexport function checkFailureModes(corpus: ResolvedCorpus,scored: ScoredRun,run: RunResult,\n): readonly FailureModeCheck[] {\n  const checks: FailureModeCheck[] = [];\n\n  /* ---- docs/02 ┬º7: truth-maintenance failure modes ---- */\n  checks.push(mechanical(\"docs/02 ┬º7\",\"Over-retraction ΓÇö a cascade takes more than it should\",\nscored.cascade.overRetractions === 0 && scored.cascade.survivorsExpected > 0,\nscored.cascade.overRetractions +\" over-retraction(s); \" +scored.cascade.survivorsExpected +\" survivor(s) expected.\",\n    );\n\n  checks.push(\"Under-retraction ΓÇö a cascade stops too early\",\nscored.cascade.perPlant.every((entry) => !entry.testable || entry.missedFlips.length === 0),\nscored.cascade.perPlant.map((entry) => entry.missedFlips.length).reduce((a, b) => a + b, 0) +\" expected flip(s) missed.\"\"Circular justification ΓÇö a decision supports its own premise\",\n!scored.run.state.decisions.size || !hasCircularLabel(run),\nhasCircularLabel(run)? \"at least one node is labelled circular\": \"no node reached a circular label.\"\"Unfounded belief ΓÇö a node IN with no path to an asserted premise\",\n!scored.run.labels.size || (scored.run.labels.size > 0 && !hasUnfoundedLabel(run)hasUnfoundedLabel(run)? \"at least one node is labelled UNFOUNDED\": \"no node reached an unfounded label.\"\"Monotonic graph ΓÇö no OUT-lists, so nothing can be retracted\",\nscored.invalidation.outListPopulated > 0,\nscored.invalidation.outListPopulated + \" justification(s) carry a non-empty OUT-list.\"argued(\"Entrenchment miscalibration ΓÇö the wrong belief is contracted first\",\n\"Entrenchment weights are declared in `reasoning/entrenchment.ts` and the ablation measures whether \" +\n\"removing the ordering raises the false-positive rate. It does NOT measure whether the weights are \" +\n\"right, because that needs a corpus with ground-truth entrenchment, which no public corpus has. \" +\n\"Making it mechanical needs hand-labelled entrenchment rankings per decision.\"\"Label oscillation ΓÇö the fixpoint does not converge\",\n\"`reasoning/labeller.ts` caps iterations and reports `fixpointReached`. Checking it needs a graph \" +\n\"deep enough to oscillate, and the corpus's deepest plant is three levels. Mechanical once the corpus \" +\n\"has a five-level plant.\"\"Nogood recorded against nodes that no longer exist\",\n\"Nogoods reference premise ids; a nogood whose premises were never extracted is dead weight rather \" +\n\"than a failure, and the corpus plants no nogoods at all. Mechanical once a nogood plant exists.\");\n\n  /* ---- docs/03 ┬º8: retrieval and contradiction failure modes ---- */\n  checks.push(\"docs/03 ┬º8\",\"Refinement surfaced as a conflict\",\nscored.falsePositives.refinementVerdicts >= 0 && !refinementRaisedAsConflict(run),\nscored.falsePositives.refinementVerdicts +\" refinement verdict(s), none expected to interrupt.\"\"Search budget exceeded ΓÇö more than three searches\",\nscored.groundedness.searchBudgetViolations === 0,\nscored.groundedness.searchBudgetViolations +\" answer(s) exceeded the \" +3 +\"-search budget.\"\"Empty answer scored as grounded (0/0 = 1)\",\nscored.groundedness.perQuestion.every((entry) => entry.claims > 0 || entry.groundedness === 0,\n      ),\nscored.groundedness.emptyAnswers + \" empty answer(s), all scored 0 rather than 1.\"\"Answering a question the corpus cannot answer\",\nscored.groundedness.refusalsCorrect === scored.groundedness.refusalsExpected &&scored.groundedness.refusalsExpected > 0,\nscored.groundedness.refusalsCorrect +\" of \" +scored.groundedness.refusalsExpected +\" unanswerable question(s) refused.\"\"Citation that does not resolve within the run\",\ncitationsResolve(run),\n? \"every cited decision id exists in the graph.\": \"at least one citation points at a decision the graph does not contain.\"\"Negation missed ΓÇö 'not Postgres' read as a decision for Postgres\",\n\"The ablation covers this: removing negation cues should damage decision-extraction precision by at \" +\n\"least 0.2. It is argued rather than mechanical HERE because the baseline run cannot distinguish a \" +\n\"correctly negated extraction from a lucky one; only the ablated pair can, and that lives in the \" +\n\"delta table.\"\"Embedding drift ΓÇö vectors stale after a decision is edited\",\n\"`retrieval/build-index.ts` hashes decision text and re-embeds on change. Checking it needs an edit \" +\n\"event in the corpus followed by a retrieval query, and the corpus has no edits. Mechanical once an \" +\n\"edit-then-query plant exists.\"\"Pre-emption fires without a stated rejection reason\",\n\"Phase 3 requires `whyRejected` AND `confirmedByHuman` before an alternative enters the pre-emption \" +\n\"index, and the harness never acts as a human, so the index should be empty throughout. That is \" +\n\"argued from the code path rather than checked, because an empty index cannot be observed to misfire.\");\n\n  /* ---- docs/04 ┬º8: guard failure modes ---- */\n  checks.push(\"docs/04 ┬º8\",\"A skip counted as a pass\",\nscored.guards.skippedCountedAsPass === 0,\nscored.guards.skippedCountedAsPass + \" skip(s) counted as a pass; must be 0.\"\"A guard accepted without a human (invariant I4)\",\nscored.guards.autoAccepted === 0,\nscored.guards.autoAccepted + \" guard(s) auto-accepted; must be 0.\"\"Stale `disabledByDecisionLabel` after a label change\",\nscored.guards.staleDisabledFlags === 0,\nscored.guards.staleDisabledFlags +\" stale flag(s); must be 0. This is a regression check on a bug Phase 6 found and fixed.\"\"`llm_judge` counted toward compliance\",\nscored.guards.judged >= 0 && scored.guards.determinismShare <= 1,\nscored.guards.deterministic +\" deterministic and \" +scored.guards.judged +\" judged guard(s); Phase 4 excludes judged guards from compliance by filtering on `isDeterministic`.\"\"A guard that passes on a project that violates its decision\",\n\"This is guard precision, and it is NOT MEASURED: a transcript corpus contains no repository state, \" +\n\"so no violation can be seeded. Mechanical once a fixture repository ships beside the corpus ΓÇö \" +\n\"roadmap work recorded in `docs/LIMITATIONS.md`.\"\"Guard scoped too broadly ΓÇö fires on files the decision does not govern\",\n\"Scoping comes from `appliesTo` globs and the decision's variable. Checking over-broad scoping needs \" +\n\"a file tree to scope against, which is the same missing fixture repository as the entry above.\"\"`falsifiesPremiseId` attributed to the wrong premise\",\n\"Phase 4 attributes a falsification only when EXACTLY ONE premise matches, so ambiguity is resolved \" +\n\"by refusing rather than guessing. Checking the guess would require planting a guard failure with a \" +\n\"known premise target, which again needs the fixture repository.\");\n\n  return checks;   * alone, it is the correct behaviour: related decisions that add rationale to each other are the\n   * commonest relationship in a real log and surfacing them as conflicts is what gets a tool uninstalled. */\n  return run.state.contradictions.some((record) => record.verdict === \"refinement\" && record.resolution === \"accepted\");\n}\n  lines.push(\"HARDENING PASS ΓÇö 7.4\");\n  lines.push(\"\");\n  lines.push(report.ready? \"READY: every demo-killer check passes and every mechanical check passes.\"\"NOT READY: see the failures below. A partially hardened demo is not a demo that can be given.\");\n  lines.push(\"\");\n  }\n\n  lines.push(\"DOCUMENTED FAILURE MODES