ssed \" + passed + \" \\u00b7 failed \" + (blocking + warnings) + \" (\" + blocking + \" blocking, \" + warnings + \" warning) \\u00b7 skipped \" + skipped);\n\n  if (blocking > 0) {\n    console.log(\"\\n\\x1b[31m\" + blocking + \" blocking decision guard(s) failed.\\x1b[0m\");\n    console.log(\"Each failure above names the decision, the premise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\n\" + warnings + \" warning-level guard(s) failed \\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"#!/usr/bin/env node\n/**\n * WhyLog decision guards ΓÇö generated. Do not edit by hand.    ? \"nothing recorded\"\n    : guard.restsOn.map((p) => p.id + \" \" + p.text + \" (\" + p.label + \")\").join(\", \");\n  lines.push(\"`  Decided: \" +${guard.decidedAt + \"} \\u00b7 Rests on: \" + premises}`);\n\n  if (guard.restsOn.length === 0) {\nmain();\n","ops":[{"diffOp":{"equal":{"range":[0,85]}}},{"equalLines":{"line_count":202}},{"diffOp":{"equal":{"range":[85,210]}}},{"diffOp":{"delete":{"range":[210,211]}}},{"diffOp":{"insert":{"range":[211,212]}}},{"diffOp":{"equal":{"range":[212,222]}}},{"diffOp":{"delete":{"range":[222,226]}}},{"diffOp":{"equal":{"range":[212,213]}}},{"diffOp":{"insert":{"range":[226,228]}}},{"diffOp":{"equal":{"range":[228,243]}}},{"diffOp":{"delete":{"range":[243,247]}}},{"diffOp":{"insert":{"range":[247,248]}}},{"diffOp":{"equal":{