tring(f.contradictions).padStart(8) + String(f.justifications).padStart(6) +\n      (\"  \" + v.verified + \"/\" + v.manual + \"/\" + v.failed).padEnd(26) +\n      (f.durationMs / 1000).toFixed(1),\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\"Timings are shown but NOT compared: they vary with machine load, and treating a slow run as\");\n  lines.push(\"non-determinism teaches the presenter to ignore this report.\");\n\n  if (report.divergences.length > 0) {\n    lines.push(\"\");\n    lines.push(\"DIVERGENCES (\" + report.divergences.length + \"):\");\n    for (const divergence of report.divergences) lines.push(\"  \" + divergence);\n  } else {\n    lines.push(\"\");\n    lines.push(\"No divergences. Runs 2 and 3 started from whatever run 1 left in storage and produced\");\n    lines.push(\"identical node counts, identical labels and identical ids.\");\n  }\n\n  const warnings = report.runs.flatMap((run) => run.warnings.map((warning) => \"run \" + run.n + \": \" + warning));\n  if (warnings.length > 0) {\n    lines.push(\"\");\n    lines.push(\"WARNINGS:\");\n    for (const warning of [...new Set(warnings)]) lines.push(\"  \" + warning);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Three consecutive dry runs ΓÇö 7.5.\n *  const lines: string[] = [];\n\n  lines.push(\"`DRY RUNS ΓÇö \" + ${report.runs.length + \"} consecutive, no reset between them);\n  lines.push(report.passed ? \"PASSED: deterministic and demoable across all runs.\"