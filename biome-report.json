-------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"`  below floor   \" + ${belowFloor.length + \"}   (moved less than NOISE_FLOOR.toFixed(2) ΓÇö too small to interpret on 12 transcripts));\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":264}},{"diffOp":{"equal":{"range":[68,187]}}},{"diffOp":{"delete":{"range":[187,188]}}},{"diffOp":{"insert":{"range":[188,189]}}},{"diffOp":{"equal":{"range":[189,205]}}},{"diffOp":{"delete":{"range":[205,209]}}},{"diffOp":{"insert":{"range":[209,211]}}},{"diffOp":{"equal":{"range":[211,228]}}},{"diffOp":{"delete":{"range":[228,232]}}},{"diffOp":{"insert":{"range":[232,233]}}},{"diffOp":{"equal":{"range":[233,253]}}},{"diffOp":{"delete":{"range":[205,209]}}},{"diffOp":{"insert":{"range":[209,211]}}},{"diffOp":{"equal":{"range":[253,275]}}},{"diffOp":{"delete":{"range":[228,232]}}},{"diffOp":{"insert":{"range":[232,233]}}},{"diffOp":{"equal":{"range":[275,321]}}},{"diffOp":{"delete":{"range":[205,206]}}},{"diffOp":{"insert":{"range":[188,189]}}},{"diffOp":{"equal":{"range":[321,433]}}},{"equalLines":{"line_count":55}},{"diffOp":{"equal":{"range":[433,469]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[11151,11290],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"`  untestable    \" + ${untestable.length + \"}   (no denominator in either run));\n  lines.push(\"\");\n\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":265}},{"diffOp":{"equal":{"range":[68,289]}}},{"diffOp":{"delete":{"range":[289,290]}}},{"diffOp":{"insert":{"range":[290,291]}}},{"diffOp":{"equal":{"range":[291,307]}}},{"diffOp":{"delete":{"range":[307,311]}}},{"diffOp":{"insert":{"range":[311,313]}}},{"diffOp":{"equal":{"range":[313,330]}}},{"diffOp":{"delete":{"range":[330,334]}}},{"diffOp":{"insert":{"range":[334,335]}}},{"diffOp":{"equal":{"range":[335,368]}}},{"diffOp":{"delete":{"range":[307,308]}}},{"diffOp":{"insert":{"range":[290,291]}}},{"diffOp":{"equal":{"range":[368,389]}}},{"equalLines":{"line_count":54}},{"diffOp":{"equal":{"range":[389,425]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[11306,11382],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"`\" + ${entry.row.ablation.id + \"} ┬╖ entry.row.ablation.label}`);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":278}},{"diffOp":{"equal":{"range":[68,142]}}},{"diffOp":{"delete":{"range":[142,143]}}},{"diffOp":{"insert":{"range":[143,144]}}},{"diffOp":{"equal":{"range":[68,70]}}},{"diffOp":{"delete":{"range":[144,148]}}},{"diffOp":{"insert":{"range":[148,150]}}},{"diffOp":{"equal":{"range":[150,171]}}},{"diffOp":{"delete":{"range":[171,175]}}},{"diffOp":{"insert":{"range":[175,176]}}},{"diffOp":{"equal":{"range":[176,180]}}},{"diffOp":{"delete":{"range":[144,148]}}},{"diffOp":{"insert":{"range":[148,150]}}},{"diffOp":{"equal":{"range":[180,204]}}},{"diffOp":{"insert":{"range":[204,206]}}},{"diffOp":{"equal":{"range":[206,337]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[337,373]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[12115,12179],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"`    Predicted: \" + ${entry.row.ablation.predicts}`);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":279}},{"diffOp":{"equal":{"range":[68,206]}}},{"diffOp":{"delete":{"range":[206,207]}}},{"diffOp":{"insert":{"range":[207,208]}}},{"diffOp":{"equal":{"range":[208,223]}}},{"diffOp":{"delete":{"range":[223,227]}}},{"diffOp":{"insert":{"range":[227,229]}}},{"diffOp":{"equal":{"range":[229,256]}}},{"diffOp":{"insert":{"range":[256,258]}}},{"diffOp":{"equal":{"range":[258,455]}}},{"equalLines":{"line_count":40}},{"diffOp":{"equal":{"range":[455,491]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[12199,12246],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"`    Observed:  \" + ${entry.verdict.sentence}`);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":280}},{"diffOp":{"equal":{"range":[68,236]}}},{"diffOp":{"delete":{"range":[236,237]}}},{"diffOp":{"insert":{"range":[237,238]}}},{"diffOp":{"equal":{"range":[238,253]}}},{"diffOp":{"delete":{"range":[253,257]}}},{"diffOp":{"insert":{"range":[257,259]}}},{"diffOp":{"equal":{"range":[259,281]}}},{"diffOp":{"insert":{"range":[281,283]}}},{"diffOp":{"equal":{"range":[283,440]}}},{"equalLines":{"line_count":39}},{"diffOp":{"equal":{"range":[440,476]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[12266,12308],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"`    Baseline \" +${entry.verdict.baselineValue.toFixed(3) + \"} -> ablated \" + entry.verdict.ablatedValue.toFixed(3)}`);\n      lines.push(\"\");\n    }\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":281}},{"diffOp":{"equal":{"range":[68,214]}}},{"diffOp":{"delete":{"range":[214,215]}}},{"diffOp":{"insert":{"range":[215,216]}}},{"diffOp":{"equal":{"range":[216,228]}}},{"diffOp":{"delete":{"range":[228,232]}}},{"diffOp":{"equal":{"range":[216,217]}}},{"diffOp":{"insert":{"range":[232,234]}}},{"diffOp":{"equal":{"range":[234,272]}}},{"diffOp":{"delete":{"range":[272,276]}}},{"diffOp":{"insert":{"range":[276,277]}}},{"diffOp":{"equal":{"range":[277,289]}}},{"diffOp":{"delete":{"range":[289,293]}}},{"diffOp":{"insert":{"range":[232,234]}}},{"diffOp":{"equal":{"range":[293,330]}}},{"diffOp":{"insert":{"range":[330,332]}}},{"diffOp":{"equal":{"range":[332,362]}}},{"equalLines":{"line_count":38}},{"diffOp":{"equal":{"range":[362,398]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[12328,12441],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"`\" + ${entry.row.ablation.id.padEnd(30) + \"}entry.verdict.sentence}`);\n    }\n    lines.push(\"\");\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":289}},{"diffOp":{"equal":{"range":[68,210]}}},{"diffOp":{"delete":{"range":[210,211]}}},{"diffOp":{"insert":{"range":[211,212]}}},{"diffOp":{"equal":{"range":[68,70]}}},{"diffOp":{"delete":{"range":[212,216]}}},{"diffOp":{"insert":{"range":[216,218]}}},{"diffOp":{"equal":{"range":[218,250]}}},{"diffOp":{"delete":{"range":[250,254]}}},{"diffOp":{"insert":{"range":[254,255]}}},{"diffOp":{"equal":{"range":[250,251]}}},{"diffOp":{"delete":{"range":[212,216]}}},{"diffOp":{"insert":{"range":[216,218]}}},{"diffOp":{"equal":{"range":[255,277]}}},{"diffOp":{"insert":{"range":[277,279]}}},{"diffOp":{"equal":{"range":[279,307]}}},{"equalLines":{"line_count":30}},{"diffOp":{"equal":{"range":[307,343]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[12649,12719],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"`\" + ${entry.row.ablation.id.padEnd(30) + \"}entry.verdict.metric}`);\n    }\n    lines.push(\"\");\nexport type { DeltaRow as Delta };\n","ops":[{"diffOp":{"equal":{"range":[0,68]}}},{"equalLines":{"line_count":297}},{"diffOp":{"equal":{"range":[68,247]}}},{"diffOp":{"delete":{"range":[247,248]}}},{"diffOp":{"insert":{"range":[248,249]}}},{"diffOp":{"equal":{"range":[68,70]}}},{"diffOp":{"delete":{"range":[249,253]}}},{"diffOp":{"insert":{"range":[253,255]}}},{"diffOp":{"equal":{"range":[255,287]}}},{"diffOp":{"delete":{"range":[287,291]}}},{"diffOp":{"insert":{"range":[291,292]}}},{"diffOp":{"equal":{"range":[287,288]}}},{"diffOp":{"delete":{"range":[249,253]}}},{"diffOp":{"insert":{"range":[253,255]}}},{"diffOp":{"equal":{"range":[292,312]}}},{"diffOp":{"insert":{"range":[312,314]}}},{"diffOp":{"equal":{"range":[314,342]}}},{"equalLines":{"line_count":22}},{"diffOp":{"equal":{"range":[342,378]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\ablation\\table.ts"},"span":[12963,13031],"sourceCode":"/**\n * The ablation delta table and the prediction audit ΓÇö 7.3.\n *\n * Phase 7 ┬╖ sub-phase 7.3\n *\n * ---------------------------------------------------------------------------\n * REPRODUCIBLE MEANS THE TABLE CARRIES ITS OWN INPUTS\n *\n * Every table printed here names the corpus version, the engine and the run timestamp. A delta table\n * without them is a set of numbers nobody can regenerate, and ┬º7.3 asks for a reproducible table rather\n * than merely a table.\n *\n * ---------------------------------------------------------------------------\n * THE PREDICTION AUDIT IS THE POINT OF THE ABLATION\n *\n * A delta on its own says \"removing X changed Y\". It does not say whether that was expected. The audit\n * compares each observed delta against the threshold declared in `EXPECTED_DAMAGE` BEFORE the run and\n * classifies it:\n *\n *   CONFIRMED   the component moved the metric it was claimed to move, by at least the threshold\n *   FALSIFIED   the component was claimed to move a metric and did not ΓÇö it is not earning its place\n *   UNTESTABLE  the metric never had a denominator in either run, so no comparison is possible\n *   BELOW FLOOR moved, but by less than the noise floor, which on twelve transcripts is not evidence\n *\n * ┬º7.3 requires at least one falsified hypothesis reported honestly. That requirement cannot be met by\n * looking for something to confess after the fact; it is met by declaring thresholds in advance and\n * printing whatever the comparison produces. If nothing is falsified, the audit says so and the honest\n * reading is that the predictions were too timid ΓÇö which is itself worth reporting, because a suite of\n * predictions that cannot fail is not a suite of hypotheses.\n * ---------------------------------------------------------------------------\n */\n\nimport type { MetricId, MetricResult } from \"../metrics/types\";\nimport { METRIC_NAMES } from \"../metrics/types\";\nimport { NOISE_FLOOR, type Ablation } from \"./toggles\";\nimport type { AblationStudy } from \"./run\";\n\nexport interface DeltaRow {\n  readonly ablation: Ablation;\n  readonly subsystem: string;\n  readonly deltas: Readonly<Record<string, number>>;\n  readonly verdicts: readonly PredictionVerdict[];\n  readonly usable: boolean;\n}\n\nexport type VerdictKind = \"confirmed\" | \"falsified\" | \"untestable\" | \"below-floor\" | \"no-prediction\";\n\nexport interface PredictionVerdict {\n  readonly metric: string;\n  readonly kind: VerdictKind;\n  readonly threshold: number;\n  readonly delta: number;\n  readonly baselineValue: number;\n  readonly ablatedValue: number;\n  readonly sentence: string;\n}\n\n/** Metrics the table reports on. Chosen before the run: the ones a component could plausibly move. */\nexport const TABLE_METRICS: readonly MetricId[] = [\n  \"decision-extraction\",\n  \"premise-extraction\",\n  \"alternative-precision\",\n  \"modality-precision\",\n  \"contradiction-recall-l1\",\n  \"invalidation-recall-l2\",\n  \"cascade-correctness-l3\",\n  \"survivor-preservation\",\n  \"false-positive-rate\",\n  \"answer-groundedness\",\n  \"retrieval-precision\",\n  \"retrieval-mrr\",\n];\n\n/** `false-positive-rate` is the one metric where LOWER is better, so its deltas are sign-flipped before\n *  comparison. Without this, a toggle that REDUCES false positives would be audited as having damaged\n *  the metric, and the audit would recommend keeping a component that makes the product worse. */\nconst LOWER_IS_BETTER = new Set<MetricId>([\"false-positive-rate\"]);\n\nexport function buildDeltaRows(study: AblationStudy): readonly DeltaRow[] {\n  const baseline = study.baseline;\n  if (baseline === null || baseline.scored === null) return [];\n\n  const baselineValues = valuesOf(baseline.scored.metrics);\n\n  return study.outcomes\n    .filter((outcome) => outcome.ablation.id !== \"full\")\n    .map((outcome) => {\n      if (outcome.scored === null) {\n        return { ablation: outcome.ablation, subsystem: outcome.ablation.subsystem, deltas: {}, verdicts: [], usable: false };\n      }\n\n      const values = valuesOf(outcome.scored.metrics);\n      const deltas: Record<string, number> = {};\n\n      for (const id of TABLE_METRICS) {\n        const before = baselineValues[id];\n        const after = values[id];\n        if (before === undefined || after === undefined) continue;\n        deltas[id] = LOWER_IS_BETTER.has(id) ? before - after : after - before;\n      }\n\n      return {\n        ablation: outcome.ablation,\n        subsystem: outcome.ablation.subsystem,\n        deltas,\n        verdicts: audit(outcome.ablation, deltas, baselineValues, values),\n        usable: true,\n      };\n    });\n}\n\nfunction audit(\n  ablation: Ablation,\n  deltas: Readonly<Record<string, number>>,\n  baselineValues: Readonly<Record<string, number>>,\n  ablatedValues: Readonly<Record<string, number>>,\n): readonly PredictionVerdict[] {\n  if (ablation.expectsDamage.length === 0) {\n    return [{\n      metric: \"(none declared)\",\n      kind: \"no-prediction\",\n      threshold: 0,\n      delta: 0,\n      baselineValue: 0,\n      ablatedValue: 0,\n      sentence:\n        \"No damage was predicted for this switch, so no hypothesis was at risk. \" +\n        (ablation.id === \"no-voting\"\n          ? \"The local engine reports voting as unsupported and the pipeline ignores the option, so this switch is UNMEASURABLE keyless ΓÇö predicting a movement here would be predicting a bug.\"\n          : \"Reported for completeness; a switch with no prediction cannot be falsified and should not be counted as a confirmed design choice.\"),\n    }];\n  }\n\n  return ablation.expectsDamage.map((expectation) => {\n    const delta = deltas[expectation.metric] ?? Number.NaN;\n    const baselineValue = baselineValues[expectation.metric] ?? Number.NaN;\n    const ablatedValue = ablatedValues[expectation.metric] ?? Number.NaN;\n\n    const untestable =\n      Number.isNaN(delta) || (baselineValue === 0 && ablatedValue === 0);\n\n    if (untestable) {\n      return {\n        metric: expectation.metric,\n        kind: \"untestable\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta: Number.isNaN(delta) ? 0 : delta,\n        baselineValue: Number.isNaN(baselineValue) ? 0 : baselineValue,\n        ablatedValue: Number.isNaN(ablatedValue) ? 0 : ablatedValue,\n        sentence:\n          \"The metric had no denominator in either run, so nothing could be compared. This is not a \" +\n          \"confirmed prediction and must not be read as one ΓÇö an untested component is not a working component.\",\n      };\n    }\n\n    if (delta >= expectation.threshold) {\n      return {\n        metric: expectation.metric,\n        kind: \"confirmed\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", at or above the declared threshold of \" + expectation.threshold.toFixed(2) +\n          \". The component earns its place on this corpus.\",\n      };\n    }\n\n    if (Math.abs(delta) < NOISE_FLOOR) {\n      return {\n        metric: expectation.metric,\n        kind: \"below-floor\" as VerdictKind,\n        threshold: expectation.threshold,\n        delta,\n        baselineValue,\n        ablatedValue,\n        sentence:\n          \"Removing it moved \" + name(expectation.metric) + \" by \" + signed(delta) +\n          \", below the \" + NOISE_FLOOR.toFixed(2) + \" noise floor for a twelve-transcript corpus. \" +\n          \"This is not evidence the component is useless ΓÇö it is evidence the corpus is too small to \" +\n          \"tell, and those are different claims.\",\n      };\n    }\n\n    return {\n      metric: expectation.metric,\n      kind: \"falsified\" as VerdictKind,\n      threshold: expectation.threshold,\n      delta,\n      baselineValue,\n      ablatedValue,\n      sentence:\n        \"PREDICTION FALSIFIED. Removing this component moved \" + name(expectation.metric) + \" by \" +\n        signed(delta) + \" against a declared threshold of \" + expectation.threshold.toFixed(2) +\n        \". On this corpus the component does not do what the architecture claims it does ΓÇö either it is \" +\n        \"not load-bearing, or the corpus does not exercise the case it was built for, and distinguishing \" +\n        \"those needs more transcripts rather than more argument.\",\n    };\n  });\n}\n\nfunction valuesOf(metrics: readonly MetricResult[]): Record<string, number> {\n  const out: Record<string, number> = {};\n  for (const metric of metrics) out[metric.id] = metric.value;\n  return out;\n}\n\nfunction name(id: string): string {\n  return METRIC_NAMES[id as MetricId] ?? id;\n}\n\nfunction signed(value: number): string {\n  return (value >= 0 ? \"+\" : \"\") + value.toFixed(3);\n}\n\n/** The delta table as fixed-width text. Deltas are SIGNED and sign-flipped for false-positive rate, so\n *  a positive number always means \"the full system is better\". */\nexport function renderAblationTable(study: AblationStudy): string {\n  const rows = buildDeltaRows(study);\n  const lines: string[] = [];\n\n  lines.push(\"ABLATION DELTA TABLE\");\n  lines.push(\"corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n    (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt);\n  lines.push(\"Every number is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that POSITIVE ALWAYS MEANS THE FULL SYSTEM IS BETTER.\");\n  lines.push(\"\");\n\n  const header = \"Switch\".padEnd(30) + TABLE_METRICS.map((id) => shortName(id).padStart(11)).join(\"\");\n  lines.push(header);\n  lines.push(\"-\".repeat(header.length));\n\n  for (const row of rows) {\n    if (!row.usable) {\n      lines.push(row.ablation.id.padEnd(30) + \"  THREW ΓÇö excluded from the table\");\n      continue;\n    }\n    const cells = TABLE_METRICS.map((id) => {\n      const delta = row.deltas[id];\n      return (delta === undefined ? \"┬╖\" : signed(delta)).padStart(11);\n    });\n    lines.push(row.ablation.id.padEnd(30) + cells.join(\"\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"┬╖ = metric not produced by that configuration. A column of ┬╖ is a configuration that never exercised the component,\");\n  lines.push(\"    which is a different finding from a column of +0.000.\");\n\n  return lines.join(\"\\n\");\n}\n\n/** The prediction audit. This is where ┬º7.3's \"at least one hypothesis falsified and reported honestly\"\n *  is either satisfied or visibly not. */\nexport function renderPredictionAudit(study: AblationStudy): string {\n  const rows = buildDeltaRows(study).filter((row) => row.usable);\n  const lines: string[] = [];\n\n  const all = rows.flatMap((row) => row.verdicts.map((verdict) => ({ row, verdict })));\n  const falsified = all.filter((entry) => entry.verdict.kind === \"falsified\");\n  const confirmed = all.filter((entry) => entry.verdict.kind === \"confirmed\");\n  const untestable = all.filter((entry) => entry.verdict.kind === \"untestable\");\n  const belowFloor = all.filter((entry) => entry.verdict.kind === \"below-floor\");\n\n  lines.push(\"PREDICTION AUDIT\");\n  lines.push(\"Thresholds were declared in src/eval/ablation/toggles.ts BEFORE any configuration was run.\");\n  lines.push(\"\");\n  lines.push(\"  confirmed     \" + confirmed.length);\n  lines.push(\"  FALSIFIED     \" + falsified.length);\n  lines.push(\"  below floor   \" + belowFloor.length + \"   (moved less than \" + NOISE_FLOOR.toFixed(2) + \" ΓÇö too small to interpret on 12 transcripts)\");\n  lines.push(\"  untestable    \" + untestable.length + \"   (no denominator in either run)\");\n  lines.push(\"\");\n\n  if (falsified.length === 0) {\n    lines.push(\"NOTHING WAS FALSIFIED. ┬º7.3 requires at least one falsified hypothesis reported honestly, and this run\");\n    lines.push(\"does not have one. The honest reading is that the declared thresholds were too timid to be at risk, not\");\n    lines.push(\"that every architectural claim survived contact with measurement. A prediction that cannot fail is a\");\n    lines.push(\"description, and a study made only of those has not tested the architecture.\");\n    lines.push(\"\");\n  } else {\n    lines.push(\"FALSIFIED PREDICTIONS ΓÇö reported in full, with the threshold that was declared beforehand:\");\n    lines.push(\"\");\n    for (const entry of falsified) {\n      lines.push(\"  \" + entry.row.ablation.id + \" ┬╖ \" + entry.row.ablation.label);\n      lines.push(\"    Predicted: \" + entry.row.ablation.predicts);\n      lines.push(\"    Observed:  \" + entry.verdict.sentence);\n      lines.push(\"    Baseline \" + entry.verdict.baselineValue.toFixed(3) + \" -> ablated \" + entry.verdict.ablatedValue.toFixed(3));\n      lines.push(\"\");\n    }\n  }\n\n  if (confirmed.length > 0) {\n    lines.push(\"CONFIRMED ΓÇö the component moved the metric it was claimed to move:\");\n    for (const entry of confirmed) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.sentence);\n    }\n    lines.push(\"\");\n  }\n\n  if (untestable.length > 0) {\n    lines.push(\"UNTESTABLE ΓÇö recorded rather than quietly dropped, because an untested component is not a working one:\");\n    for (const entry of untestable) {\n      lines.push(\"  \" + entry.row.ablation.id.padEnd(30) + \" \" + entry.verdict.metric);\n    }\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction shortName(id: MetricId): string {\n  const map: Record<string, string> = {\n    \"decision-extraction\": \"decisions\",\n    \"premise-extraction\": \"premises\",\n    \"alternative-precision\": \"alterns\",\n    \"modality-precision\": \"modality\",\n    \"contradiction-recall-l1\": \"L1\",\n    \"invalidation-recall-l2\": \"L2\",\n    \"cascade-correctness-l3\": \"L3\",\n    \"survivor-preservation\": \"survivor\",\n    \"false-positive-rate\": \"FP/100\",\n    \"answer-groundedness\": \"grounded\",\n    \"retrieval-precision\": \"P@5\",\n    \"retrieval-mrr\": \"MRR\",\n  };\n  return map[id] ?? id.slice(0, 10);\n}\n\nexport type { DeltaRow as Delta };\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{