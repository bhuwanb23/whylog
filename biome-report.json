onfig.test.json"},"span":[487,503],"sourceCode":"{\n  \"extends\": \"./tsconfig.app.json\",\n  \"compilerOptions\": {\n    /* The tests run in node, not in a browser: they read the fixture from disk with `node:fs`\n     * and resolve paths with `node:path` and `process.cwd()`. The app project deliberately does\n     * NOT have node types, so that browser code cannot reach for `process` by accident. Giving\n     * the tests their own project is what lets both be right at the same time. */\n    \"types\": [\"node\", \"vite/client\"]\n  },\n  \"include\": [\"src\", \"tests\"]\n}\n"},"tags":[],"source":null},{"category":"parse","severity":"error","description":"End of file expected","message":[{"elements":[],"content":"End of file expected"}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Use an array for a sequence of values: `[1, 2]`"}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tsconfig.test.json"},"span":[504,505],"sourceCode":"{\n  \"extends\": \"./tsconfig.app.json\",\n  \"compilerOptions\": {\n    /* The tests run in node, not in a browser: they read the fixture from disk with `node:fs`\n     * and resolve paths with `node:path` and `process.cwd()`. The app project deliberately does\n     * NOT have node types, so that browser code cannot reach for `process` by accident. Giving\n     * the tests their own project is what lets both be right at the same time. */\n    \"types\": [\"node\", \"vite/client\"]\n  },\n  \"include\": [\"src\", \"tests\"]\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Code formatting aborted due to parsing errors. To format code with errors, enable the 'formatter.formatWithErrors' option.","message":[{"elements":[],"content":"Code formatting aborted due to parsing errors. To format code with errors, enable the 'formatter.formatWithErrors' option."}],"advices":{"advices":[]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tsconfig.test.json"},"span":null,"sourceCode":null},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 67 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 67 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 67 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\App.tsx"},"span":[4072,4075],"sourceCode":"/**\n * The shell.\n *\n * Phase 0 ┬╖ sub-phase 0.10 ΓÇö boots empty, renders, survives reload\n * Extended by Phase 6 into the six-view product.\n *\n * ---------------------------------------------------------------------------\n * THE MODE BADGE IS IN THE HEADER, ALWAYS VISIBLE\n *\n * Not in Settings, not in a tooltip on the results. Which engine is running is the\n * first thing a user needs to know, because it determines whether their transcript\n * left the browser. A badge you have to go looking for is a badge that gets\n * misread, and \"badged, never mixed\" is worth nothing if the badge is hidden.\n * ---------------------------------------------------------------------------\n */\n\nimport { type KeybindAction, describeKeybinds, useKeybinds } from \"@/components/common\";\nimport { useExtraction } from \"@/store/extraction\";\nimport { persistenceAvailable, useWhyLog } from \"@/store/whylog\";\nimport { MODE_BADGE } from \"@/theme\";\nimport { AskView } from \"@/views/AskView\";\nimport { ExportView } from \"@/views/ExportView\";\nimport { FoundationView } from \"@/views/FoundationView\";\nimport { GraphView } from \"@/views/GraphView\";\nimport { GuardsView } from \"@/views/GuardsView\";\nimport { HealthView } from \"@/views/HealthView\";\nimport { ReasoningView } from \"@/views/ReasoningView\";\nimport { ReviewView } from \"@/views/ReviewView\";\nimport { SettingsView } from \"@/views/SettingsView\";\nimport { TimeMachineView } from \"@/views/TimeMachineView\";\nimport { TimelineView } from \"@/views/TimelineView\";\nimport { type ReactElement, useEffect, useState } from \"react\";\n/* Bundled rather than fetched: the sandboxed preview has no network, and ┬º6.9 requires the demo to\n * be one click from a cold start. */\nimport demoTranscript from \"../fixtures/demo-transcript.txt?raw\";\n\ntype ViewId =\n  | \"review\"\n  | \"reasoning\"\n  | \"foundation\"\n  | \"timeline\"\n  | \"graph\"\n  | \"ask\"\n  | \"guards\"\n  | \"export\"\n  | \"time-machine\"\n  | \"health\"\n  | \"settings\";\n\nconst VIEWS: readonly { id: ViewId; label: string; phase: string }[] = [\n  // FIRST, and the default view: gate G1 is \"a messy transcript becomes reviewed,\n  // structured, persisted decisions with premises\". A product whose entry point is\n  // an empty graph is a product nobody reaches the point of.\n  { id: \"review\", label: \"Import & review\", phase: \"1\" },\n  // SECOND, because gate G2 ΓÇö \"it reasons\" ΓÇö is the critical gate. Everything after it\n  // is a surface over a reasoning engine; without this view there is no way to see the\n  // thing the whole project is actually about.\n  { id: \"reasoning\", label: \"Reasoning\", phase: \"2\" },\n  { id: \"foundation\", label: \"Foundation\", phase: \"0\" },\n  { id: \"timeline\", label: \"Timeline\", phase: \"6.1\" },\n  // 6.6 ΓÇö the signature visual. Bipartite: assumptions are the load-bearing nodes and decisions\n  // hang off them. Nobody in the category has this picture, because nobody stores that structure.\n  { id: \"graph\", label: \"Lattice\", phase: \"6.6\" },\n  // `conflict` is deliberately ABSENT. ┬º6.5's seven-part revision proposal surface is already\n  // rendered by ReasoningView, which Phase 2 built as the gate-G2 surface. A second Conflict view\n  // would be a second implementation of one screen ΓÇö the same duplication this codebase keeps\n  // removing ΓÇö and the two would drift apart about what a proposal says.\n  { id: \"time-machine\", label: \"Time machine\", phase: \"6.7\" },\n  // THIRD: gate G3 ΓÇö \"it answers\". Retrieval, the evidence contract and the Ask surface all\n  // land in Phase 3, so the view belongs to it rather than to the presentation phase that\n  // originally held the slot.\n  { id: \"ask\", label: \"Ask\", phase: \"3\" },\n  // Gate G4 ΓÇö \"it verifies\". Synthesis, the interpreter, the metrics and the feedback loop all\n  // land in Phase 4.\n  { id: \"guards\", label: \"Guards\", phase: \"4\" },\n  // Gate G5 ΓÇö \"it closes the loop\". The compiler, the gate and the stamp all land in Phase 5.\n  { id: \"export\", label: \"Export\", phase: \"5\" },\n  { id: \"health\", label: \"Health\", phase: \"6.4\" },\n  { id: \"settings\", label: \"Settings\", phase: \"6.8\" },\n];\n\nexport function App(): ReactElement {\n  const status = useWhyLog((s) => s.status);\n  const engine = useWhyLog((s) => s.engine);\n  const state = useWhyLog((s) => s.state);\n  const [view, setView] = useState<ViewId>(\"review\");\n\n  // StrictMode mounts twice in development; boot is idempotent so this only\n  // matters if the store was reset between mounts.\n  useEffect(() => {\n    if (status === \"booting\") useWhyLog.getState().boot();\n  }, [status]);\n\n  const mode = modeOf(engine?.id.kind, state.index.stale);\n\n  /**\n   * Load the demo fixture and land on the review queue.\n   *\n   * ┬º6.9: \"the demo path must be one click from a cold start.\" A judge will not paste their own\n   * transcript, and if the fixture is not one click away the product is never seen. It goes through\n   * `importText`, which is the same entry point a real paste uses ΓÇö so the demo exercises extraction,\n   * resolution and the review queue rather than a pre-seeded state that skips them.\n   */\n  const loadDemo = (): void => {\n    setView(\"review\");\n    void useExtraction.getState().importText(demoTranscript, \"demo-transcript\");\n  };\n\n  /* ---- 6.9 keyboard ---- */\n  const keybinds: readonly KeybindAction[] = [\n    { key: \"k\", meta: true, label: \"ask the log\", run: () => setView(\"ask\") },\n    { key: \"n\", label: \"quick-log a decision\", run: () => setView(\"timeline\") },\n    { key: \"p\", label: \"paste a transcript\", run: () => setView(\"review\") },\n    { key: \"g\", label: \"the premise lattice\", run: () => setView(\"graph\") },\n    { key: \"Escape\", label: \"back to the timeline\", run: () => setView(\"timeline\") },\n  ];\n\n  useKeybinds(keybinds);\n\n  return (\n    <div className=\"shell\">\n      <header className=\"shell-header\">\n        <div>\n          <strong style={{ fontSize: 15, letterSpacing: \"-0.01em\" }}>WhyLog</strong>\n          <span className=\"faint\" style={{ marginLeft: 8, fontSize: 12 }}>\n            decision truth maintenance\n          </span>\n        </div>\n\n        <nav className=\"nav\" aria-label=\"Views\">\n          {VIEWS.map((entry) => (\n            <button\n              key={entry.id}\n              type=\"button\"\n              className=\"nav-item\"\n              aria-current={view === entry.id ? \"page\" : undefined}\n              onClick={() => setView(entry.id)}\n              title={`Phase ${entry.phase}`}\n            >\n              {entry.label}\n            </button>\n          ))}\n        </nav>\n\n        <div style={{ marginLeft: \"auto\", display: \"flex\", gap: 8, alignItems: \"center\" }}>\n          <ModeBadge mode={mode} />\n          <ChainBadge status={status} />\n          {state.decisions.size === 0 ? (\n            <button\n              type=\"button\"\n              className=\"badge\"\n              onClick={loadDemo}\n              title=\"Load fixtures/demo-transcript.txt and extract it ΓÇö the same path a real paste takes.\"\n            >\n              load demo\n            </button>\n          ) : null}\n          <span className=\"faint\" style={{ fontSize: 10 }} title={describeKeybinds(keybinds)}>\n            ΓîÿK ask ┬╖ N log ┬╖ P paste ┬╖ G lattice\n          </span>\n        </div>\n      </header>\n\n      <main className=\"shell-main\">\n        {view === \"review\" ? (\n          <ReviewView />\n        ) : view === \"reasoning\" ? (\n          <ReasoningView />\n        ) : view === \"foundation\" ? (\n          <FoundationView />\n        ) : view === \"ask\" ? (\n          <AskView />\n        ) : view === \"guards\" ? (\n          <GuardsView />\n        ) : view === \"export\" ? (\n          <ExportView />\n        ) : view === \"timeline\" ? (\n          <TimelineView />\n        ) : view === \"graph\" ? (\n          <GraphView />\n        ) : view === \"time-machine\" ? (\n          <TimeMachineView />\n        ) : view === \"health\" ? (\n          <HealthView />\n        ) : view === \"settings\" ? (\n          <SettingsView />\n        ) : (\n          <NotYet view={VIEWS.find((v) => v.id === view)} />\n        )}\n      </main>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Badges                                                                     */\n/* -------------------------------------------------------------------------- */\n\nfunction ModeBadge({ mode }: { mode: keyof typeof MODE_BADGE }): ReactElement {\n  const config = MODE_BADGE[mode];\n  return (\n    <span className=\"badge\" title={config.meaning} style={{ color: config.colour }}>\n      <span aria-hidden=\"true\">ΓùÅ</span>\n      {config.label}\n    </span>\n  );\n}\n\nfunction modeOf(\n  engineKind: \"local\" | \"llm\" | undefined,\n  indexStale: boolean,\n): keyof typeof MODE_BADGE {\n  if (engineKind === undefined) return \"unavailable\";\n  if (indexStale) return \"stale\";\n  return engineKind === \"llm\" ? \"llm\" : \"local\";\n}\n\nfunction ChainBadge({ status }: { status: string }): ReactElement {\n  if (!persistenceAvailable()) {\n    return (\n      <span\n        className=\"badge\"\n        style={{ color: \"var(--label-unknown)\" }}\n        title=\"This browser will not remember the log across a reload ΓÇö private mode, a sandboxed frame, or storage is blocked. Export to a file to keep it.\"\n      >\n        memory only\n      </span>\n    );\n  }\n  if (status === \"degraded\") {\n    return (\n      <span\n        className=\"badge\"\n        style={{ color: \"var(--action)\" }}\n        title=\"The hash chain failed verification on load. The log is read-only.\"\n      >\n        chain broken\n      </span>\n    );\n  }\n  return (\n    <span className=\"badge faint\" title=\"The append-only hash chain verified on load.\">\n      chain ok\n    </span>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Placeholder for views that arrive in Phase 6                               */\n/* -------------------------------------------------------------------------- */\n\nfunction NotYet({ view }: { view: { label: string; phase: string } | undefined }): ReactElement {\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">{view?.label ?? \"View\"}</h2>\n      <p className=\"dim\">\n        This view arrives in Phase {view?.phase ?? \"6\"}. The substrate underneath it ΓÇö the\n        append-only log, the fold, the bi-temporal projections and the hash chain ΓÇö is built and is\n        what the Foundation view reports on.\n      </p>\n    </section>\n  );\n}\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\n      \"ES2023\", \"DOM\",\"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"types\": [\"node\"],\n    \"paths\": {\n      \"@/*\": [\n        \"./src/*\"]\n    },\n    \"baseUrl\": \".\",    \"verbatimModuleSyntax\": true\n  },\n  \"include\": [\"vite.config.ts\",\"vitest.config.ts\",\"scripts/**/*.ts\",\"src/eval/**/*.ts\"]\n}\n","ops":[{"diffOp":{"equal":{"range":[0,61]}}},{"diffOp":{"delete":{"range":[61,68]}}},{"diffOp":{"equal":{"range":[68,77]}}},{"diffOp":{"delete":{"range":[61,68]}}},{"diffOp":{"insert":{"range":[77,78]}}},{"diffOp":{"equal":{"range":[78,84]}}},{"diffOp":{"delete":{"range":[61,68]}}},{"diffOp":{"insert":{"range":[77,78]}}},{"diffOp":{"equal":{"range":[84,98]}}},{"diffOp":{"delete":{"range":[61,66]}}},{"diffOp":{"equal":{"range":[98,159]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[159,234]}}},{"diffOp":{"delete":{"range":[61,68]}}},{"diffOp":{"equal":{"range":[234,240]}}},{"diffOp":{"delete":{"range":[61,66]}}},{"diffOp":{"equal":{"range":[240,272]}}},{"diffOp":{"delete":{"range":[272,281]}}},{"diffOp":{"equal":{"range":[281,290]}}},{"diffOp":{"delete":{"range":[272,279]}}},{"diffOp":{"equal":{"range":[290,318]}}},{"equalLines":{"line_count":6}},{"diffOp":{"equal":{"range":[318,370]}}},{"diffOp":{"delete":{"range":[272,277]}}},{"diffOp":{"equal":{"range":[370,387]}}},{"diffOp":{"delete":{"range":[272,277]}}},{"diffOp":{"insert":{"range":[159,160]}}},{"diffOp":{"equal":{"range":[387,406]}}},{"diffOp":{"delete":{"range":[272,277]}}},{"diffOp":{"insert":{"range":[318,319]}}},{"diffOp":{"equal":{"range":[406,424]}}},{"diffOp":{"delete":{"range":[272,277]}}},{"diffOp":{"insert":{"range":[318,319]}}},{"diffOp":{"equal":{"range":[424,442]}}},{"diffOp":{"delete":{"range":[272,275]}}},{"diffOp":{"equal":{"range":[442,446]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tsconfig.node.json"},"span":null,"sourceCode":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"lib\": [\n      \"ES2023\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"allowSyntheticDefaultImports\": true,\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"types\": [\n      \"node\"\n    ],\n    \"paths\": {\n      \"@/*\": [\n        \"./src/*\"\n      ]\n    },\n    \"baseUrl\": \".\",\n    \"noUncheckedIndexedAccess\": true,\n    \"exactOptionalPropertyTypes\": true,\n    \"noImplicitOverride\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"noPropertyAccessFromIndexSignature\": true,\n    \"forceConsistentCasingInFileNames\": true,\n    \"verbatimModuleSyntax\": true\n  },\n  \"include\": [\n    \"vite.config.ts\",\n    \"vitest.config.ts\",\n    \"scripts/**/*.ts\",\n    \"src/eval/**/*.ts\"\n  ]\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\local\\negation.ts"},"span":[6900,6910],"sourceCode":"/**\n * Polarity and negation scope ΓÇö 1.3, component 3.\n *\n * Phase 1 ┬╖ sub-phase 1.3\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.3\n *\n * ---------------------------------------------------------------------------\n * WHY POLARITY IS ITS OWN PROBLEM\n *\n * A cue tells you a decision is PRESENT. It does not tell you which way it points.\n * \"instead of Postgres\" mentions Postgres and REJECTS it; \"going with Postgres\"\n * mentions Postgres and ACCEPTS it. Rationale Miner found negation explicit in\n * only 12% of rationale sentences (docs/05), so polarity has to come from the\n * cue's own direction as often as from a negation word ΓÇö and when both are\n * present they can disagree.\n *\n * Getting this backwards is the worst available extraction error, worse than\n * missing the decision entirely: a polarity flip records the REJECTED option as\n * the chosen one, and every downstream layer ΓÇö contradiction detection, export,\n * guard synthesis ΓÇö then reasons correctly from a false premise.\n *\n * ---------------------------------------------------------------------------\n * THE RULE WHEN CUE AND NEGATION DISAGREE\n *\n * A negation word INSIDE THE SCOPE WINDOW flips the cue's direction. \"not going\n * with Postgres\" is ΓêÆPostgres, not +Postgres.\n *\n * But a negation OUTSIDE the window does not: \"we're not a big team, so going with\n * SQLite\" is +SQLite, and the \"not\" belongs to the PREMISE. That is what the\n * scope window is for, and why it is capped at 6 tokens or the clause boundary,\n * whichever comes first.\n * ---------------------------------------------------------------------------\n */\n\nimport type { CueHit } from \"@/extraction/cue-scan\";\nimport { tokenise } from \"@/lib/text\";\nimport type { CueDirection } from \"@/ontology/data/decision-cues\";\n\n/** +X means X is chosen. ΓêÆX means X is refused and belongs in\n *  `RejectedAlternative`. */\nexport type Polarity = \"positive\" | \"negative\";\n\nexport interface PolarityEvidence {\n  readonly polarity: Polarity;\n  /** What decided it, so a wrong call is diagnosable. */\n  readonly via: \"cue-direction\" | \"negation-flip\" | \"verb-pattern\" | \"default\";\n  readonly marker: string | null;\n  /** The tokens the negation search covered. */\n  readonly scope: readonly string[];\n}\n\n/**\n * Negation scope window, in tokens.\n *\n * Six because it covers \"not really going with X\", \"don't think we should use X\"\n * and \"no, we're not switching to X\" while stopping before the next clause in\n * almost every real transcript. The clause boundary is a hard stop regardless: a\n * negation separated from the cue by a full stop is a negation of something else.\n */\nexport const NEGATION_SCOPE_TOKENS = 6;\n\nconst NEGATIONS: readonly string[] = [\n  \"not\",\n  \"no\",\n  \"never\",\n  \"neither\",\n  \"nor\",\n  \"without\",\n  \"avoid\",\n  \"avoiding\",\n  \"skip\",\n  \"skipping\",\n  \"skipped\",\n  \"drop\",\n  \"dropping\",\n  \"dropped\",\n  \"dont\",\n  \"don't\",\n  \"doesnt\",\n  \"doesn't\",\n  \"didnt\",\n  \"didn't\",\n  \"wont\",\n  \"won't\",\n  \"cant\",\n  \"can't\",\n  \"cannot\",\n  \"couldnt\",\n  \"couldn't\",\n  \"shouldnt\",\n  \"shouldn't\",\n  \"isnt\",\n  \"isn't\",\n  \"arent\",\n  \"aren't\",\n  \"wasnt\",\n  \"wasn't\",\n  \"hardly\",\n  \"barely\",\n  \"rather\",\n  \"instead\",\n];\n\n/** Verb patterns that carry polarity independent of any cue. Checked when the cue\n *  direction is `neutral`. */\nconst POSITIVE_VERBS: readonly RegExp[] = [\n  /\\b(?:switch(?:ed|ing)?|mov(?:e|ed|ing)|migrat(?:e|ed|ing)|go|going|went|upgrade[ds]?)\\s+to\\b/i,\n  /\\b(?:adopt|adopting|adopted|embrace|embracing)\\b/i,\n  /\\b(?:use|using|used|pick|picked|choose|chose|chosen|select|selected|take|took)\\b/i,\n  /\\b(?:go|going|went)\\s+with\\b/i,\n  /\\bstick(?:ing|s)?\\s+with\\b/i,\n  /\\bkeep(?:ing)?\\b/i,\n  /\\bstandardis(?:e|ing)\\s+on\\b/i,\n  /\\bstandardiz(?:e|ing)\\s+on\\b/i,\n  /\\bsettled\\s+on\\b/i,\n  /\\blanded\\s+on\\b/i,\n];\n\nconst NEGATIVE_VERBS: readonly RegExp[] = [\n  /\\b(?:drop|dropped|dropping|ditch|ditched|ditching|dump|dumped)\\b/i,\n  /\\bstop(?:ped|ping)?\\s+using\\b/i,\n  /\\b(?:remove|removed|removing|delete[ds]?|deleting|kill|killed|killing)\\b/i,\n  /\\brevert(?:ed|ing)?\\b/i,\n  /\\b(?:rule|ruled|ruling)\\s+out\\b/i,\n  /\\b(?:reject|rejected|rejecting|decline[ds]?|veto(?:ed)?|scrap(?:ped)?)\\b/i,\n  /\\bno\\s+longer\\b/i,\n  /\\b(?:give|gave|giving)\\s+up\\s+on\\b/i,\n  /\\bwalk(?:ed|ing)?\\s+back\\b/i,\n  /\\bback(?:ing)?\\s+out\\b/i,\n];\n\n/* -------------------------------------------------------------------------- */\n/* Scope                                                                      */\n/* -------------------------------------------------------------------------- */\n\nconst CLAUSE_BREAK = /[.!?\\n;]/;\n\n/**\n * The tokens between the start of the cue's clause and the end of the cue phrase.\n *\n * This is the ONLY region a negation may flip polarity from. Extending it past the\n * clause boundary is how \"we're not a big team, so going with SQLite\" becomes\n * ΓêÆSQLite.\n */\nexport function negationScope(text: string, hit: CueHit): readonly string[] {\n  const clauseStart = clauseStartBefore(text, hit.start);\n  const window = text.slice(clauseStart, hit.end);\n  const tokens = tokenise(window);\n\n  // Keep the tokens closest to the cue: if the clause is long, the negation that\n  // matters is the one adjacent to the verb, not the one four clauses back.\n  return tokens.slice(Math.max(0, tokens.length - NEGATION_SCOPE_TOKENS));\n}\n\n/** A short window AFTER the cue, for the \"X, not Y\" construction where the\n *  rejection follows the choice: \"going with SQLite, not Postgres\". */\nexport function trailingScope(text: string, hit: CueHit, tokens = 8): readonly string[] {\n  let end = hit.end;\n  while (end < text.length && !CLAUSE_BREAK.test(text[end] ?? \"\")) end += 1;\n  return tokenise(text.slice(hit.end, Math.min(end, text.length))).slice(0, tokens);\n}\n\nfunction clauseStartBefore(text: string, from: number): number {\n  for (let i = Math.min(from, text.length) - 1; i >= 0; i -= 1) {\n    const ch = text[i] ?? \"\";\n    if (CLAUSE_BREAK.test(ch)) return i + 1;\n    // A comma also bounds the window, but only when it follows a conjunction ΓÇö\n    // \"single file, synchronous API\" is one thought, while \"not a big team, so\"\n    // is two.\n    if (\n      ch === \",\" &&\n      /\\b(?:so|because|since|but|and so)\\s*$/i.test(text.slice(Math.max(0, i - 24), i))\n    ) {\n      return i + 1;\n    }\n  }\n  return 0;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Polarity                                                                   */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Which way does the value attached to this cue point?\n *\n * @param text  the turn or episode body\n * @param hit   the cue\n * @param value the value text the cue attaches to, when already extracted. Lets\n *              the verb patterns be checked against the phrase that actually\n *              carries the verb (\"switch to Postgres\") rather than the whole turn.\n */\nexport function polarityOf(text: string, hit: CueHit, value?: string): PolarityEvidence {\n  const scope = negationScope(text, hit);\n  const negated = findNegation(scope);\n\n  /* ---- 1. the cue's own direction ---- */\n  if (hit.direction === \"accept\" || hit.direction === \"reject\") {\n    const base: Polarity = hit.direction === \"accept\" ? \"positive\" : \"negative\";\n    if (negated === null) {\n      return { polarity: base, via: \"cue-direction\", marker: hit.phrase, scope };\n    }\n    // A negated accept is a reject, and a negated reject is an accept. Double\n    // negation is rare enough in transcripts that one flip is the right model.\n    return {\n      polarity: base === \"positive\" ? \"negative\" : \"positive\",\n      via: \"negation-flip\",\n      marker: negated,\n      scope,\n    };\n  }\n\n  /* ---- 2. pivot: \"X instead of Y\" accepts X and rejects Y ---- */\n  if (hit.direction === \"pivot\") {\n    return {\n      polarity: negated === null ? \"positive\" : \"negative\",\n      via: negated === null ? \"cue-direction\" : \"negation-flip\",\n      marker: negated ?? hit.phrase,\n      scope,\n    };\n  }\n\n  /* ---- 3. neutral cue: the verb decides ---- */\n  const verbText = value !== undefined && value.length > 0 ? `${hit.phrase} ${value}` : hit.phrase;\n  const positive = POSITIVE_VERBS.some((pattern) => pattern.test(verbText));\n  const negative = NEGATIVE_VERBS.some((pattern) => pattern.test(verbText));\n\n  if (negative && !positive)\n    return { polarity: \"negative\", via: \"verb-pattern\", marker: verbText, scope };\n  if (positive && !negative)\n    return { polarity: \"positive\", via: \"verb-pattern\", marker: verbText, scope };\n\n  if (negated !== null)\n    return { polarity: \"negative\", via: \"negation-flip\", marker: negated, scope };\n\n  // No evidence either way. DEFAULT POSITIVE: a decision cue with no polarity\n  // signal is far more often a commitment than a refusal, and the review UI shows\n  // the `via: \"default\"` marker so the guess is visible.\n  return { polarity: \"positive\", via: \"default\", marker: null, scope };\n}\n\nfunction findNegation(scope: readonly string[]): string | null {\n  const set = new Set(NEGATIONS);\n  for (let i = scope.length - 1; i >= 0; i -= 1) {\n    const token = scope[i];\n    if (token !== undefined && set.has(token)) return token;\n  }\n  return null;\n}\n\n/** Is this token a negation? Exported for the premise extractor, where\n *  \"no concurrent writers\" is an OUT-list condition rather than a polarity flip. */\nexport function isNegation(token: string): boolean {\n  return NEGATIONS.includes(token.toLowerCase());\n}\n\n/**\n * The cue inventory, exported.\n *\n * Phase 2 kept this list inside `ai/local/classify.ts`; Phase 3 collapsed that file into a\n * thin delegate over `retrieval/contradiction.ts` (one rule engine, not two that can\n * disagree ΓÇö the Phase 2 audit's gap 3). The vocabulary is a NEGATION concern, so it moved\n * here with the rest of the negation machinery rather than staying behind in a file that no\n * longer implements any rules.\n *\n * Exported because the health panel prints it: the cue list is the classifier's entire\n * polarity vocabulary, and a list the user cannot read is a list they cannot audit.\n */\nexport const NEGATION_CUES: readonly string[] = NEGATIONS;\n\n/**\n * The value REJECTED by an \"X, not Y\" construction.\n *\n * \"going with SQLite, not Postgres\" ΓåÆ \"postgres\". This is the highest-precision\n * alternative source available on the local path, because the rejection is\n * syntactically explicit rather than inferred.\n */\nexport function rejectedAfterCue(text: string, hit: CueHit): string | null {\n  const trailing = text.slice(hit.end, hit.end + 90);\n  const match =\n    /(?:^|[\\s,])(?:not|rather than|instead of|over|no)\\s+([A-Za-z0-9@/._+-]+(?:\\s+[A-Za-z0-9@/._+-]+)?)/i.exec(\n      trailing,\n    );\n  return match?.[1]?.trim() ?? null;\n}\n\nexport const POLARITY_EXPLANATIONS: Readonly<Record<PolarityEvidence[\"via\"], string>> = {\n  \"cue-direction\": \"the cue phrase itself carries the direction\",\n  \"negation-flip\": \"a negation inside the cue's clause reversed it\",\n  \"verb-pattern\": \"the verb decided, because the cue was direction-neutral\",\n  default: \"no polarity evidence ΓÇö defaulted to chosen, which the review can correct\",\n};\n\nexport function describePolarity(evidence: PolarityEvidence): string {\n  const marker = evidence.marker === null ? \"\" : ` (\"${evidence.marker}\")`;\n  return `${evidence.polarity === \"positive\" ? \"CHOSEN\" : \"REFUSED\"}${marker} ΓÇö ${POLARITY_EXPLANATIONS[evidence.via]}`;\n}\n\n/** Which cue directions exist, for the review UI's legend. */\nexport function describeDirection(direction: CueDirection): string {\n  switch (direction) {\n    case \"accept\":\n      return \"the value after this cue is chosen\";\n    case \"reject\":\n      return \"the value after this cue is refused\";\n    case \"pivot\":\n      return '\"X instead of Y\" ΓÇö accepts X, refuses Y';\n    case \"neutral\":\n      return \"a decision is present; direction comes from the verb or a negation\";\n  }\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"]record.kind!== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\nexport { SYSTEM_PROMPT };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":379}},{"diffOp":{"equal":{"range":[51,188]}}},{"diffOp":{"delete":{"range":[188,202]}}},{"diffOp":{"insert":{"range":[202,213]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[213,334]}}},{"equalLines":{"line_count":108}},{"diffOp":{"equal":{"range":[334,361]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[15547,15553],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"]record.rationale=== \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\nexport { SYSTEM_PROMPT };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":387}},{"diffOp":{"equal":{"range":[51,152]}}},{"diffOp":{"delete":{"range":[152,171]}}},{"diffOp":{"insert":{"range":[171,187]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[187,333]}}},{"equalLines":{"line_count":100}},{"diffOp":{"equal":{"range":[333,360]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[16065,16076],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"]record.rationale: \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\nexport { SYSTEM_PROMPT };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":387}},{"diffOp":{"equal":{"range":[51,187]}}},{"diffOp":{"delete":{"range":[187,206]}}},{"diffOp":{"insert":{"range":[206,222]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[222,333]}}},{"equalLines":{"line_count":100}},{"diffOp":{"equal":{"range":[333,360]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[16100,16111],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"]record.severity=== \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\nexport { SYSTEM_PROMPT };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":388}},{"diffOp":{"equal":{"range":[51,214]}}},{"diffOp":{"delete":{"range":[214,232]}}},{"diffOp":{"insert":{"range":[232,247]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[247,349]}}},{"equalLines":{"line_count":99}},{"diffOp":{"equal":{"range":[349,376]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[16144,16154],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"]record.confidence=== \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\nexport { SYSTEM_PROMPT };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":391}},{"diffOp":{"equal":{"range":[51,130]}}},{"diffOp":{"delete":{"range":[130,150]}}},{"diffOp":{"insert":{"range":[150,167]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[167,250]}}},{"equalLines":{"line_count":96}},{"diffOp":{"equal":{"range":[250,277]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[16283,16295],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"]record.confidence: 0.4,\n        ),\n        requiresReview: true,\nexport { SYSTEM_PROMPT };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":391}},{"diffOp":{"equal":{"range":[51,166]}}},{"diffOp":{"delete":{"range":[166,186]}}},{"diffOp":{"insert":{"range":[186,203]}}},{"diffOp":{"equal":{"range":[51,52]}}},{"diffOp":{"equal":{"range":[203,250]}}},{"equalLines":{"line_count":96}},{"diffOp":{"equal":{"range":[250,277]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[16319,16331],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 27 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 27 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 27 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\llm\\index.ts"},"span":[14777,14796],"sourceCode":"/**\n * The LLM engine ΓÇö 1.10, the second path.\n *\n * Phase 1 ┬╖ sub-phase 1.10\n *\n * ---------------------------------------------------------------------------\n * IT IS NOT A FALLBACK\n *\n * The local engine is the default because it is keyless, deterministic and private.\n * This engine exists because it recovers premises the cue table cannot see: a model\n * can read \"it's one person, one machine, one log\" and return `scale.single_user`,\n * while a lexicon needs the phrase to contain a cue.\n *\n * What it costs: tokens, latency, non-reproducibility, and the transcript leaving\n * the browser. All four are shown in the mode badge and in Settings, because an\n * engine switch that is not visible is a privacy incident.\n *\n * ---------------------------------------------------------------------------\n * NOTHING IT RETURNS IS TRUSTED\n *\n * Every snippet goes through `snippet-validation.ts` before it reaches the review,\n * every variable through `resolveVariable`, every premise type through the closed\n * set. A model that invents a variable produces an OTHER decision; a model that\n * paraphrases a quote produces an item with no span and a collapsed tier. The\n * pipeline downstream is identical to the local path, which is the point of the\n * seam: adding an engine must not add a code path.\n * ---------------------------------------------------------------------------\n */\n\nimport { validate } from \"@/guards/synth/llm\";\n/* `performanceSafeNow` was called in six places in this file but declared only in\n * ../local/index.ts, where it is private ΓÇö so none of those calls resolved. It now lives in\n * lib/format.ts as `monotonicNow` and is aliased here to keep the call sites unchanged. */\nimport { monotonicNow as performanceSafeNow } from \"@/lib/format\";\nimport type { EngineId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\n/* `ProposedGuard` is the shape a synthesis returns, and `validate` is the guard that stops a\n * hallucinated spec reaching a guard record: it switches on `kind`, rebuilds the spec field by\n * field, and returns null for anything that does not fit. Nothing is repaired, because a repaired\n * spec is a check nobody proposed and could evaluate to `pass` ΓÇö the most dangerous result a\n * guard can give. */\nimport type { ProposedGuard } from \"@/types/guards\";\nimport type { ClassificationResult } from \"@/types/retrieval\";\nimport {\n  DEFAULT_MODELS,\n  type EngineConfig,\n  LOCAL_DIMENSIONS,\n  type ProviderId,\n  readConfig,\n} from \"../config\";\nimport { EngineError, unsupportedError } from \"../errors\";\nimport { embedBatch } from \"../local/embed\";\nimport {\n  type LlmAlternative,\n  type LlmDecision,\n  type LlmDiscard,\n  type LlmExtraction,\n  type LlmPremise,\n  SYSTEM_PROMPT,\n  needsChunking,\n  userPrompt,\n} from \"../prompts/extraction\";\nimport { type ChatMessage, chat } from \"../providers/openai-compatible\";\nimport { registerEngine } from \"../registry\";\nimport {\n  type ClassificationRequest,\n  type CompositionRequest,\n  type CompositionResult,\n  type EmbeddingResult,\n  type EngineCapabilities,\n  type ExtractionRequest,\n  type ExtractionResult,\n  type GuardSynthesisRequest,\n  type GuardSynthesisResult,\n  type RerankRequest,\n  type RerankResult,\n  type WhyLogEngine,\n  llmCapabilities,\n} from \"../types\";\nimport { readExtraction, splitForPrompt, toExtractionResult } from \"./parse\";\n\nexport interface LlmEngineOptions {\n  readonly config: EngineConfig;\n  readonly id: EngineId;\n}\n\nexport function createLlmEngine(options: LlmEngineOptions): WhyLogEngine {\n  const { config, id } = options;\n  const provider = config.provider as Exclude<ProviderId, \"local\">;\n\n  const requireKey = (): string => {\n    if (config.apiKey === null || config.apiKey.length === 0) {\n      throw new EngineError(\n        \"no-key\",\n        \"No API key is saved. Add one in Settings, or switch to the local engine.\",\n        {\n          engine: id.model,\n        },\n      );\n    }\n    return config.apiKey;\n  };\n\n  return {\n    id: (): EngineId => id,\n\n    dimensions: LOCAL_DIMENSIONS,\n\n    capabilities: (): EngineCapabilities => llmCapabilities(config.model),\n\n    /* ---------------- extraction ---------------- */\n\n    extract: async (request: ExtractionRequest): Promise<ExtractionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      if (request.signal?.aborted) {\n        throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n      }\n\n      const raw = request.text;\n      const pieces = needsChunking(raw) ? splitForPrompt(raw, request.transcriptId) : [raw];\n\n      let promptTokens = 0;\n      let completionTokens = 0;\n      /* The accumulator is built from MUTABLE arrays and assembled once at the end.\n       * `LlmExtraction` declares its arrays readonly, so pushing into a value of\n       * that type is a type error - and the fix is to accumulate locally, not to\n       * weaken the published shape. */\n      const decisions: LlmDecision[] = [];\n      const premises: LlmPremise[] = [];\n      const alternatives: LlmAlternative[] = [];\n      const discarded: LlmDiscard[] = [];\n\n      for (const piece of pieces) {\n        if (request.signal?.aborted) {\n          throw new EngineError(\"cancelled\", \"Cancelled mid-extraction.\", { engine: id.model });\n        }\n\n        const messages: ChatMessage[] = [\n          { role: \"system\", content: SYSTEM_PROMPT },\n          { role: \"user\", content: userPrompt(piece) },\n        ];\n\n        const response = await chat(provider, apiKey, {\n          model: config.model,\n          messages,\n          // Low but not zero: three-run voting needs the runs to disagree\n          // somewhere, and at temperature 0 they would not.\n          temperature: config.voting ? 0.2 : 0.1,\n          json: true,\n          ...(request.signal === undefined ? {} : { signal: request.signal }),\n        });\n\n        promptTokens += response.promptTokens;\n        completionTokens += response.completionTokens;\n\n        const parsed = readExtraction(response.text, id.model);\n        decisions.push(...parsed.decisions);\n        premises.push(...parsed.premises);\n        alternatives.push(...parsed.alternatives);\n        discarded.push(...parsed.discarded);\n      }\n\n      const merged: LlmExtraction = { decisions, premises, alternatives, discarded };\n      return toExtractionResult(\n        merged,\n        request,\n        id,\n        performanceSafeNow() - started,\n        promptTokens,\n        completionTokens,\n      );\n    },\n\n    /* ---------------- classification: Phase 2 ---------------- */\n\n    classify: async (request: ClassificationRequest): Promise<ClassificationResult> => {\n      // The structural gate's answer is returned unchanged: a table lookup that says\n      // two IN-labelled values are antonyms is not something a model should be asked\n      // to reconsider, and asking it invites a second opinion that contradicts the\n      // first without evidence.\n      if (request.structuralVerdict !== undefined) return request.structuralVerdict;\n\n      // Phase 2 adds the semantic classifier here. `neutral` means \"no opinion\",\n      // which the gate composes with the structural verdict rather than overriding.\n      return {\n        verdict: \"neutral\",\n        gate: \"semantic\",\n        explanation: \"The semantic classifier arrives in Phase 2; no model opinion is offered yet.\",\n        confidence: asConfidence(0.2),\n        engine: id,\n      };\n    },\n\n    /* ---------------- embedding: always local ---------------- */\n\n    /**\n     * Embeddings are the LOCAL vectoriser even on the LLM path.\n     *\n     * Anthropic has no first-party embedding model, so a provider-dependent\n     * embedding would make the index unreadable after an engine switch. Hashing\n     * tokens into 512 dimensions is weaker than a trained embedder and it is stable,\n     * reproducible and free ΓÇö and `embeddingEngineIdOf` exists precisely so the\n     * index can be tagged with what actually built it.\n     */\n    embed: async (texts: readonly string[], signal?: AbortSignal): Promise<EmbeddingResult> => {\n      const started = performanceSafeNow();\n      if (signal?.aborted) throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: id.model });\n\n      const vectors = embedBatch(texts);\n      return {\n        vectors,\n        dimensions: LOCAL_DIMENSIONS,\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    rerank: async (_request: RerankRequest): Promise<RerankResult> => {\n      // A reranker is one of the two things a key actually buys, and it arrives in\n      // Phase 3. Throwing is the backstop for a caller that ignored the capability\n      // flag: a \"reranker\" that returns its input unchanged is indistinguishable\n      // from one that is broken.\n      throw unsupportedError(\"reranking\", id.model);\n    },\n\n    /* ---------------- composition: Phase 3 ---------------- */\n\n    compose: async (request: CompositionRequest): Promise<CompositionResult> => {\n      const started = performanceSafeNow();\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You write a section of a decision record from supplied facts. Cite only the decision ids you were given. Do not add facts that are not in the material; if the material does not support the section, say so in one sentence.\",\n          },\n          { role: \"user\", content: compositionPrompt(request) },\n        ],\n        temperature: 0.2,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      return {\n        text: response.text.trim(),\n        citedDecisionIds: request.material.map((fact) => fact.decisionId),\n        engine: id,\n        durationMs: performanceSafeNow() - started,\n      };\n    },\n\n    /* ---------------- guards: Phase 4 ---------------- */\n\n    /**\n     * Guard synthesis, for the decisions the templates miss.\n     *\n     * The model is asked for strict JSON and every proposal is validated before it is returned:\n     * unknown kind, empty package, empty glob or empty pattern is dropped rather than repaired.\n     * A repaired spec is a check nobody proposed, and a guard that silently evaluates something\n     * other than what was asked for can return `pass` ΓÇö the most dangerous result it could give.\n     *\n     * Everything from here is marked `requiresReview` and capped in confidence by\n     * `guards/synth/llm.ts`. A model-proposed guard is never `blocking` until a human reads it,\n     * because blocking fails a build and a guess should not be able to do that.\n     */\n    synthesizeGuards: async (request: GuardSynthesisRequest): Promise<GuardSynthesisResult> => {\n      /* No `started` clock here: `GuardSynthesisResult` carries no duration, and measuring one\n       * nothing reads would be a number with no consumer. */\n      const apiKey = requireKey();\n\n      const response = await chat(provider, apiKey, {\n        model: config.model,\n        messages: [\n          {\n            role: \"system\",\n            content:\n              \"You compile an architectural decision into machine-checkable guards. Reply with ONLY a JSON array. Each element has: kind (one of dependency_present, dependency_absent, path_glob_exists, path_glob_absent, string_in_files, string_absent_in_files, command_exit_zero, llm_judge); the fields that kind needs (package, or glob, or pattern+glob, or command, or rubric+scopeGlobs); severity (blocking|warning); rationale (one sentence saying WHY this check verifies that decision, naming the decision id). Prefer deterministic kinds; use llm_judge only if nothing else can express the decision. Propose at most 3. If you cannot describe what a violation looks like, reply with [].\",\n          },\n          { role: \"user\", content: guardSynthesisPrompt(request) },\n        ],\n        temperature: 0.1,\n        ...(request.signal === undefined ? {} : { signal: request.signal }),\n      });\n\n      const parsed = parseGuardProposals(response.text);\n\n      if (parsed.length === 0) {\n        return {\n          guards: [],\n          // Stated rather than omitted: a decision with no synthesizable guard is\n          // marked unverifiable and SHOWN, because a compliance score computed only\n          // over the decisions that happened to be checkable flatters itself.\n          unverifiableReason: `The model proposed no check for ${request.variable} = ${request.value}, which means it could not describe what a violation would look like. That is the literature's own test for an unverifiable decision, and it is reported rather than filled in with a guess.`,\n          engine: id,\n        };\n      }\n\n      const guards: ProposedGuard[] = [];\n      for (const proposal of parsed) {\n        const validated = validate(proposal);\n        if (validated === null) continue;\n        guards.push({ ...validated, generatedBy: \"llm\", requiresReview: true });\n      }\n\n      return {\n        guards,\n        ...(guards.length > 0\n          ? {}\n          : {\n              unverifiableReason: `The model proposed ${parsed.length} guard(s) but none survived validation ΓÇö each had an unknown kind or an empty package, glob or pattern. Nothing was repaired, because a repaired spec is a check nobody proposed.`,\n            }),\n        engine: id,\n      };\n    },\n  };\n}\n\nfunction guardSynthesisPrompt(request: GuardSynthesisRequest): string {\n  const lines = [\n    `Decision ${request.decisionId}: ${request.statement}`,\n    `Variable: ${request.variable}`,\n    `Chosen value: ${request.value}`,\n  ];\n\n  if (request.appliesTo.length > 0)\n    lines.push(`Governs these paths: ${request.appliesTo.join(\", \")}`);\n\n  if (request.premises.length > 0) {\n    lines.push(\"Rests on:\");\n    for (const premise of request.premises) lines.push(`  - ${premise.id} ${premise.text}`);\n  }\n\n  const rejected = request.rejected ?? [];\n  if (rejected.length > 0) {\n    lines.push(\n      \"Rejected alternatives (each is a guard waiting to happen ΓÇö the thing turned down should be absent):\",\n    );\n    for (const entry of rejected) {\n      lines.push(\n        `  - ${entry.value}${entry.whyRejected === undefined ? \"\" : ` ΓÇö \"${entry.whyRejected}\"`}`,\n      );\n    }\n  }\n\n  lines.push(\"\", \"Reply with the JSON array only.\");\n  return lines.join(\"\\n\");\n}\n\n/**\n * Pull a JSON array of proposals out of a model response.\n *\n * Tolerates the three shapes models actually return: bare JSON, JSON in a ```json fence, and\n * JSON with prose around it. Anything that cannot be parsed yields an empty list, which the\n * caller turns into an `unverifiableReason` ΓÇö a parse failure is reported, never papered over\n * with a plausible-looking guard.\n */\nfunction parseGuardProposals(text: string): readonly ProposedGuard[] {\n  const candidates: string[] = [];\n\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/.exec(text);\n  if (fenced?.[1] !== undefined) candidates.push(fenced[1]);\n  candidates.push(text);\n\n  const bracketed = /\\[[\\s\\S]*\\]/.exec(text);\n  if (bracketed?.[0] !== undefined) candidates.push(bracketed[0]);\n\n  for (const candidate of candidates) {\n    let value: unknown;\n    try {\n      value = JSON.parse(candidate.trim());\n    } catch {\n      continue;\n    }\n\n    if (!Array.isArray(value)) continue;\n\n    const out: ProposedGuard[] = [];\n    for (const entry of value) {\n      if (entry === null || typeof entry !== \"object\") continue;\n      const record = entry as Record<string, unknown>;\n      if (typeof record[\"kind\"] !== \"string\") continue;\n\n      /* The whole record is passed through as the spec, because which fields a spec has depends\n       * on `kind` and this function does not know the kind yet. `validate` is what narrows it:\n       * it switches on `kind`, rebuilds the spec field by field with the right type, and returns\n       * null for anything that does not fit. Nothing reaches a guard unvalidated. */\n      out.push({\n        spec: record as unknown as ProposedGuard[\"spec\"],\n        rationale: typeof record[\"rationale\"] === \"string\" ? record[\"rationale\"] : \"\",\n        severity: record[\"severity\"] === \"blocking\" ? \"blocking\" : \"warning\",\n        generatedBy: \"llm\",\n        confidence: asConfidence(\n          typeof record[\"confidence\"] === \"number\" ? record[\"confidence\"] : 0.4,\n        ),\n        requiresReview: true,\n      });\n    }\n\n    if (out.length > 0) return out;\n  }\n\n  return [];\n}\n\nfunction compositionPrompt(request: CompositionRequest): string {\n  // Each fact carries its label and its premises, because a composition that\n  // quotes a decision without the conditions it rests on is exactly the export an\n  // agent will obey after those conditions stop holding.\n  const material = request.material\n    .map((fact) => {\n      const premises = fact.premises.length > 0 ? ` [given: ${fact.premises.join(\"; \")}]` : \"\";\n      const rationale =\n        fact.rationale !== undefined && fact.rationale.length > 0\n          ? ` ΓÇö because ${fact.rationale}`\n          : \"\";\n      return `- ${fact.decisionId} (${fact.label}): ${fact.statement}${premises}${rationale}`;\n    })\n    .join(\"\\n\");\n\n  return [\n    `Write the \"${request.kind}\" section.`,\n    request.question !== undefined && request.question.length > 0\n      ? `Question: ${request.question}`\n      : \"\",\n    request.maxLengthChars !== undefined ? `At most ${request.maxLengthChars} characters.` : \"\",\n    \"\",\n    \"MATERIAL:\",\n    material,\n  ]\n    .filter((line) => line.length > 0)\n    .join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Registration                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The three LLM providers, registered on import alongside `local`.\n *\n * `available: true` means the ENGINE EXISTS, not that it can be used: whether a key\n * is present changes per provider and per moment, and registration happens once at\n * import. Settings reads `providerWithKey()` for the live answer, so a greyed row\n * says \"no key saved\" rather than \"not installed\" ΓÇö and `requiresKey: true` makes\n * `createEngine` throw `no-key` BEFORE the factory runs, which is what turns \"asked\n * for an LLM with no key\" into the visible fallback in `resolveEngine` rather than\n * a failed request.\n */\nconst LLM_PROVIDERS: readonly { id: Exclude<ProviderId, \"local\">; label: string }[] = [\n  { id: \"anthropic\", label: \"Anthropic (Claude)\" },\n  { id: \"openai\", label: \"OpenAI\" },\n  { id: \"openrouter\", label: \"OpenRouter\" },\n];\n\nfor (const entry of LLM_PROVIDERS) {\n  registerEngine({\n    id: entry.id,\n    label: `${entry.label} ΓÇö ${DEFAULT_MODELS[entry.id]}`,\n    factory: (options) => {\n      const id: EngineId = { kind: \"llm\", model: options.model };\n      return createLlmEngine({\n        id,\n        config: {\n          provider: entry.id,\n          model: options.model,\n          apiKey: options.apiKey,\n          wantsLlmWithoutKey: options.apiKey === null,\n          voting: options.voting,\n          questionGeneration: options.questionGeneration,\n          localDimensions: options.dimensions,\n        },\n      });\n    },\n    requiresKey: true,\n    available: true,\n  });\n}\n\n/**\n * The provider a saved key belongs to, or null.\n *\n * `src/ai/config.ts` stores ONE key, not one per provider, because the key is\n * whatever the user last saved and a second one would have to be a second secret to\n * keep out of the log, the store and every export. So at most one LLM row is\n * selectable at a time, and Settings says which.\n */\nexport function providerWithKey(): ProviderId | null {\n  const config = readConfig();\n  if (config.apiKey === null || config.apiKey.length === 0) return null;\n  return config.provider === \"local\" ? null : config.provider;\n}\n\nexport { SYSTEM_PROMPT };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 22 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 22 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 22 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\local\\value-phrase.ts"},"span":[7761,7771],"sourceCode":"/**\n * Value-phrase extraction and the known-value lexicon ΓÇö 1.3, component 2.\n *\n * Phase 1 ┬╖ sub-phase 1.3\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.3\n *\n * STRUCTURE.md ┬º5 calls this file `lexicon.ts` and describes it as \"synonym\n * folding ΓÇö the file that decides whether the local path feels intelligent\".\n * Synonym folding proper already exists and is better placed: it is\n * `src/ontology/canonicalize.ts`, backed by ~560 aliases authored in Phase 0.7.\n * What is genuinely local-only, and lives here, is the other half of the job:\n *\n *   1. finding WHICH WORDS in a clause are the value at all ΓÇö \"going with SQLite\n *      with better-sqlite3 instead of Postgres\" has three nouns and one of them is\n *      the decision;\n *   2. ranking candidate values by how much the ontology knows about them, so the\n *      extractor prefers a recognised technology over a generic English noun.\n *\n * ---------------------------------------------------------------------------\n * THE RANKING IS THE WHOLE TRICK\n *\n * A value the alias table claims is almost always the decision. A value that is\n * merely tech-shaped (`kebab-case`, `dotted`, `CamelCase`) is a decent guess. A\n * bare common noun is a last resort and should usually mean the extraction failed,\n * which is why it scores low enough to land in the collapsed review tier rather\n * than being silently asserted.\n * ---------------------------------------------------------------------------\n */\n\nimport { STOPWORDS, tokenise } from \"@/lib/text\";\nimport { canonicalValueOf, foldKey, variableFromValue } from \"@/ontology/canonicalize\";\nimport { ALIASES, GLOBAL_ALIASES, canonicalToVariables } from \"@/ontology/data/aliases\";\nimport { VARIABLE_META } from \"@/ontology/data/variables\";\nimport { DECISION_VARIABLES, type DecisionVariable } from \"@/types/domain\";\n\nexport type ValueStrength = \"known\" | \"scoped-known\" | \"tech-shaped\" | \"bare\";\n\nexport interface ValueCandidate {\n  /** Verbatim from the text, so the snippet still resolves. */\n  readonly surface: string;\n  /** Alias-folded. This is what goes on the node. */\n  readonly canonical: string;\n  /** Best variable for it, or null when the ontology has no opinion. */\n  readonly variable: DecisionVariable | null;\n  readonly strength: ValueStrength;\n  readonly score: number;\n  readonly start: number;\n  readonly end: number;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The lexicon                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * folded value ΓåÆ the variables that claim it. Built once at module load.\n *\n * Seeded from `canonicalToVariables()` (aliases.ts) so the canonical direction is\n * defined in exactly one place, then extended with the ALIAS direction and with\n * `commonValues`, neither of which that function covers.\n */\nconst CLAIMED_BY: ReadonlyMap<string, readonly DecisionVariable[]> = buildClaimIndex();\n\nfunction buildClaimIndex(): ReadonlyMap<string, readonly DecisionVariable[]> {\n  const index = new Map<string, DecisionVariable[]>();\n\n  const claim = (value: string, variable: DecisionVariable): void => {\n    const key = foldKey(value);\n    if (key.length === 0) return;\n    const existing = index.get(key);\n    if (existing === undefined) {\n      index.set(key, [variable]);\n      return;\n    }\n    if (!existing.includes(variable)) existing.push(variable);\n  };\n\n  for (const [canonical, variables] of canonicalToVariables()) {\n    for (const variable of variables) claim(canonical, variable);\n  }\n\n  for (const variable of DECISION_VARIABLES) {\n    for (const alias of Object.keys(ALIASES[variable])) claim(alias, variable);\n    for (const value of VARIABLE_META[variable].commonValues) claim(value, variable);\n  }\n\n  return index;\n}\n\n/** Every value the ontology knows, for the review UI's autocomplete. */\nexport function knownValues(): readonly string[] {\n  return [...new Set([...ALIASES_LIST, ...GLOBAL_LIST])].sort();\n}\n\nconst ALIASES_LIST: readonly string[] = Object.values(ALIASES).flatMap((table) =>\n  Object.values(table),\n);\nconst GLOBAL_LIST: readonly string[] = Object.values(GLOBAL_ALIASES);\n\n/** Which variables claim this value. Empty means the ontology has never heard of\n *  it, which is a real signal rather than a missing one. */\nexport function variablesFor(value: string): readonly DecisionVariable[] {\n  return CLAIMED_BY.get(foldKey(value)) ?? [];\n}\n\n/** How many values the lexicon covers. Reported in the health panel: a lexicon\n *  that stops growing is a lexicon that has stopped matching new transcripts. */\nexport function lexiconSize(): number {\n  return CLAIMED_BY.size;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Phrase extraction                                                          */\n/* -------------------------------------------------------------------------- */\n\nconst VALUE_CHAR = /[A-Za-z0-9@/._+\\-#]/;\n/** Words that may appear INSIDE a value (\"Tailwind CSS\", \"GitHub Actions\") but\n *  never START one. */\nconst INNER_WORDS = new Set([\n  \"css\",\n  \"actions\",\n  \"cloud\",\n  \"code\",\n  \"studio\",\n  \"server\",\n  \"db\",\n  \"js\",\n  \"ui\",\n  \"kit\",\n  \"engine\",\n  \"api\",\n]);\n/** Words that END a value: a conjunction or a preposition is the start of the\n *  next thought. */\nconst TRAILING_STOP = new Set([\n  \"and\",\n  \"or\",\n  \"but\",\n  \"so\",\n  \"because\",\n  \"since\",\n  \"for\",\n  \"with\",\n  \"without\",\n  \"instead\",\n  \"rather\",\n  \"over\",\n  \"not\",\n  \"no\",\n  \"the\",\n  \"a\",\n  \"an\",\n  \"to\",\n  \"in\",\n  \"on\",\n  \"as\",\n  \"by\",\n  \"from\",\n  \"then\",\n  \"also\",\n  \"just\",\n  \"really\",\n  \"actually\",\n]);\nconst LEADING_STOP = new Set([\n  \"the\",\n  \"a\",\n  \"an\",\n  \"some\",\n  \"any\",\n  \"this\",\n  \"that\",\n  \"using\",\n  \"use\",\n  \"go\",\n  \"going\",\n  \"with\",\n  \"to\",\n  \"switch\",\n  \"switching\",\n  \"move\",\n  \"moving\",\n  \"migrate\",\n  \"migrating\",\n  \"adopt\",\n  \"pick\",\n  \"picked\",\n  \"choose\",\n  \"chose\",\n  \"keep\",\n  \"sticking\",\n  \"stick\",\n]);\n\n/**\n * The value phrase that follows a cue.\n *\n * @param text      the turn or episode body\n * @param from      index to start reading at ΓÇö normally the end of the cue phrase\n * @param maxChars  hard cap; a value phrase longer than this is a sentence the\n *                  extractor mistook for a noun phrase\n */\nexport function valueAfter(text: string, from: number, maxChars = 60): string | null {\n  const window = text.slice(from, from + maxChars);\n  const phrase = takePhrase(window);\n  return phrase.length === 0 ? null : phrase.trim();\n}\n\n/**\n * The value phrase that PRECEDES a cue, for \"SQLite it is\" / \"SQLite, decided\".\n *\n * Read backwards from the cue and reversed, because `takePhrase` is written\n * forwards and two phrase extractors would drift.\n */\nexport function valueBefore(text: string, until: number, maxChars = 60): string | null {\n  const start = Math.max(0, until - maxChars);\n  const window = text.slice(start, until);\n\n  // Take the LAST phrase in the window, which is the one adjacent to the cue.\n  const tokens = window.split(/(\\s+)/);\n  let end = tokens.length;\n  while (end > 0) {\n    const piece = (tokens[end - 1] ?? \"\").trim();\n    if (piece.length > 0) break;\n    end -= 1;\n  }\n\n  let begin = end;\n  while (begin > 0) {\n    const piece = (tokens[begin - 1] ?? \"\").trim();\n    if (piece.length === 0) {\n      begin -= 1;\n      continue;\n    }\n    const lower = piece.toLowerCase().replace(/[^\\w]/g, \"\");\n    if (TRAILING_STOP.has(lower) || LEADING_STOP.has(lower) || STOPWORDS.has(lower)) break;\n    if (!VALUE_CHAR.test(piece)) break;\n    begin -= 1;\n  }\n\n  const phrase = tokens.slice(begin, end).join(\"\").trim();\n  return phrase.length === 0 ? null : phrase;\n}\n\n/** Read a value phrase forward from the start of `window`. */\nfunction takePhrase(window: string): string {\n  // Skip leading whitespace, stopwords and the cue's own verb, so that\n  // \"going with the SQLite file\" yields \"sqlite file\" rather than \"with\".\n  let i = 0;\n  for (;;) {\n    const match = /^\\s*([A-Za-z]+)(?![\\w.-])/.exec(window.slice(i));\n    if (match === null) break;\n    const word = match[1] ?? \"\";\n    const lower = word.toLowerCase();\n    if (!LEADING_STOP.has(lower) && !STOPWORDS.has(lower)) break;\n    i += match[0].length;\n  }\n\n  const words: string[] = [];\n  let cursor = i;\n\n  while (cursor < window.length) {\n    const rest = window.slice(cursor);\n    const match = /^\\s*([A-Za-z0-9@/._+\\-#']+)/.exec(rest);\n    if (match === null) break;\n\n    const raw = match[1] ?? \"\";\n    const clean = raw.replace(/[,.;:!?'\"()]+$/g, \"\");\n    if (clean.length === 0) break;\n\n    const lower = clean.toLowerCase();\n    if (words.length > 0 && (TRAILING_STOP.has(lower) || STOPWORDS.has(lower))) break;\n    if (words.length > 0 && !INNER_WORDS.has(lower) && !/[.\\-@/#]/.test(clean) && !isKnown(lower))\n      break;\n    if (words.length >= 4) break;\n\n    words.push(clean);\n    cursor += match[0].length - (raw.length - clean.length);\n  }\n\n  return words.join(\" \");\n}\n\nfunction isKnown(value: string): boolean {\n  return CLAIMED_BY.has(foldKey(value));\n}\n\n/* -------------------------------------------------------------------------- */\n/* Ranking                                                                    */\n/* -------------------------------------------------------------------------- */\n\nconst STRENGTH_SCORE: Readonly<Record<ValueStrength, number>> = {\n  known: 0.95,\n  \"scoped-known\": 0.8,\n  \"tech-shaped\": 0.55,\n  bare: 0.25,\n};\n\n/**\n * Rank every candidate value in a clause.\n *\n * Called with the cue's context window rather than the whole episode: a value\n * mentioned three sentences away is not the value this decision is about.\n */\nexport function rankValues(\n  text: string,\n  start: number,\n  end: number,\n  hintVariable?: DecisionVariable | null,\n): readonly ValueCandidate[] {\n  const window = text.slice(start, end);\n  const candidates: ValueCandidate[] = [];\n  const seen = new Set<string>();\n\n  for (const match of window.matchAll(/[A-Za-z0-9][A-Za-z0-9@/._+\\-#']*/g)) {\n    const surface = match[0].replace(/[,.;:!?'\"()]+$/g, \"\");\n    if (surface.length < 2) continue;\n\n    const lower = surface.toLowerCase();\n    if (STOPWORDS.has(lower) || TRAILING_STOP.has(lower) || LEADING_STOP.has(lower)) continue;\n\n    // Multi-word values are joined greedily: \"Tailwind CSS\" must not arrive as two\n    // candidates, one of which (\"css\") is a real technology and therefore a\n    // plausible wrong answer.\n    const extended = extendWithInnerWords(window, match.index ?? 0, surface);\n    const key = foldKey(extended);\n    if (seen.has(key)) continue;\n    seen.add(key);\n\n    const at = start + (match.index ?? 0);\n    candidates.push(scoreCandidate(extended, at, at + extended.length, hintVariable ?? null));\n  }\n\n  return candidates.sort((a, b) => b.score - a.score || a.start - b.start);\n}\n\nfunction extendWithInnerWords(window: string, at: number, surface: string): string {\n  let phrase = surface;\n  let cursor = at + surface.length;\n\n  for (;;) {\n    const match = /^\\s+([A-Za-z]+)/.exec(window.slice(cursor));\n    if (match === null) break;\n    const word = match[1] ?? \"\";\n    if (!INNER_WORDS.has(word.toLowerCase())) break;\n    phrase = `${phrase} ${word}`;\n    cursor += match[0].length;\n  }\n  return phrase;\n}\n\nfunction scoreCandidate(\n  surface: string,\n  start: number,\n  end: number,\n  hintVariable: DecisionVariable | null,\n): ValueCandidate {\n  const key = foldKey(surface);\n  const claimedBy = CLAIMED_BY.get(key) ?? [];\n  const guess = variableFromValue(surface);\n  const variable = hintVariable ?? guess?.variable ?? claimedBy[0] ?? null;\n\n  let strength: ValueStrength;\n  if (claimedBy.length > 0 && hintVariable !== null && claimedBy.includes(hintVariable)) {\n    strength = \"scoped-known\";\n  } else if (claimedBy.length > 0 || guess !== null) {\n    strength = \"known\";\n  } else if (isTechShaped(surface)) {\n    strength = \"tech-shaped\";\n  } else {\n    strength = \"bare\";\n  }\n\n  let score = STRENGTH_SCORE[strength];\n  if (hintVariable !== null && variable === hintVariable) score += 0.05;\n  if (claimedBy.length > 1) score -= 0.15; // ambiguous across slots: \"local\", \"none\"\n  if (surface.length <= 3 && strength === \"bare\") score -= 0.1; // \"db\", \"ui\", \"api\"\n\n  return {\n    surface,\n    canonical: variable === null ? key : canonicalValueOf(variable, surface),\n    variable,\n    strength,\n    score: Math.max(0, Math.min(1, score)),\n    start,\n    end,\n  };\n}\n\n/** Looks like a product or package name rather than an English word. */\nexport function isTechShaped(surface: string): boolean {\n  if (/[.@/#]/.test(surface)) return true;\n  if (/^[a-z0-9]+(?:-[a-z0-9]+)+$/i.test(surface)) return true; // kebab-case\n  if (/^[A-Z][a-z]+[A-Z]/.test(surface)) return true; // CamelCase\n  if (/\\d/.test(surface) && /[a-z]/i.test(surface)) return true; // \"es2022\", \"s3\"\n  if (/^[A-Z]{2,}$/.test(surface)) return true; // \"SQL\", \"ORM\"\n  return false;\n}\n\n/**\n * Values in a clause that are KNOWN but were not the chosen one.\n *\n * Feeds 1.5: \"going with SQLite instead of Postgres\" has two known values and the\n * cue direction says which is which. Restricting rejected-alternative recovery to\n * values the ontology recognises is what keeps its precision above the published\n * 15.4% ΓÇö an unknown noun rejected for unknown reasons is not worth pre-empting\n * on.\n */\nexport function knownValuesIn(text: string, start: number, end: number): readonly ValueCandidate[] {\n  return rankValues(text, start, end, null).filter(\n    (c) => c.strength === \"known\" || c.strength === \"scoped-known\",\n  );\n}\n\nexport function describeStrength(strength: ValueStrength): string {\n  switch (strength) {\n    case \"known\":\n      return \"the ontology's alias table claims this value\";\n    case \"scoped-known\":\n      return \"claimed by the alias table AND scoped to the variable under negotiation\";\n    case \"tech-shaped\":\n      return \"looks like a product name, but the ontology does not know it ΓÇö worth adding\";\n    case \"bare\":\n      return \"an ordinary word; probably not the value, review before accepting\";\n  }\n}\n\n/** Tokens that are values rather than prose, for callers that already tokenised. */\nexport function valueTokens(text: string): readonly string[] {\n  return tokenise(text).filter((token) => isTechShaped(token) || isKnown(token));\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 26 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 26 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 26 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\common\\Keybind.tsx"},"span":[2624,2627],"sourceCode":"/**\n * Keyboard ΓÇö 6.9.\n *\n * Phase 6 ┬╖ sub-phase 6.9\n * Plan: plan/phase-6-presentation.md ┬º6.9\n *\n * ---------------------------------------------------------------------------\n * FOUR BINDINGS, AND WHY THESE FOUR\n *\n *   ΓîÿK / Ctrl+K   ask          the product's primary verb, and the binding muscle memory already\n *                              knows from every other tool\n *   N             quick log    for someone mid-flow who just made a decision and does not want to\n *                              lose it ΓÇö ten seconds, no transcript\n *   P             paste        the entry point; first-run drop-off is the most common failure in\n *                              this category and the paste target should be one keystroke away\n *   Esc           dismiss      close whatever is open, without hunting for the button\n *\n * Nothing else is bound. A keyboard scheme with thirty bindings is one nobody learns, and the four\n * above cover the four actions that account for almost all use.\n *\n * ---------------------------------------------------------------------------\n * BINDINGS NEVER FIRE WHILE TYPING\n *\n * Every one of these is a single letter except ΓîÿK, and a single-letter binding that fires inside a\n * text field makes the product unusable ΓÇö you cannot type the word \"no\" into a search box without\n * being navigated twice. So the handler checks the event target and bails on any editable element.\n *\n * This is the bug that makes keyboard support feel broken rather than helpful, and it is invisible\n * until someone tries to type.\n * ---------------------------------------------------------------------------\n */\n\nimport { type ReactElement, useEffect } from \"react\";\n\nexport interface KeybindAction {\n  readonly key: string;\n  readonly meta?: boolean;\n  readonly label: string;\n  readonly run: () => void;\n}\n\n/** Is the event target an editable element? Covers inputs, textareas, selects and anything\n *  contenteditable, which is what a paste target usually is. */\nexport function isTypingTarget(target: EventTarget | null): boolean {\n  if (target === null || typeof target !== \"object\") return false;\n\n  const element = target as HTMLElement;\n  const tag = element.tagName;\n\n  if (tag === \"INPUT\" || tag === \"TEXTAREA\" || tag === \"SELECT\") return true;\n  if (element.isContentEditable === true) return true;\n\n  return false;\n}\n\n/**\n * Install the bindings.\n *\n * Returns nothing and cleans up on unmount, so it can be called once at the app root.\n */\nexport function useKeybinds(actions: readonly KeybindAction[]): void {\n  useEffect(() => {\n    const handler = (event: KeyboardEvent): void => {\n      /* Esc always works, including inside a text field ΓÇö dismissing a modal while typing into it\n       * is exactly when you want to dismiss it. */\n      if (event.key === \"Escape\") {\n        const dismiss = actions.find((action) => action.key === \"Escape\");\n        if (dismiss !== undefined) {\n          dismiss.run();\n          return;\n        }\n      }\n\n      if (isTypingTarget(event.target)) return;\n\n      for (const action of actions) {\n        if (action.key === \"Escape\") continue;\n\n        const wantsMeta = action.meta === true;\n        const hasMeta = event.metaKey || event.ctrlKey;\n        if (wantsMeta !== hasMeta) continue;\n\n        if (event.key.toLowerCase() !== action.key.toLowerCase()) continue;\n\n        event.preventDefault();\n        action.run();\n        return;\n      }\n    };\n\n    window.addEventListener(\"keydown\", handler);\n    return () => window.removeEventListener(\"keydown\", handler);\n  }, [actions]);\n}\n\n/** The bindings, as a printable list. Rendered in the settings view and the first-run state,\n *  because a keyboard scheme nobody can look up is a keyboard scheme nobody uses. */\nexport function describeKeybinds(actions: readonly KeybindAction[]): string {\n  return actions\n    .map((action) => {\n      const key =\n        action.meta === true\n          ? `Γîÿ/Ctrl + ${action.key}`\n          : action.key === \"Escape\"\n            ? \"Esc\"\n            : action.key;\n      return key.padEnd(12) + action.label;\n    })\n    .join(\"\\\\n\");\n}\n\n/** A hint chip, rendered beside a button that also has a binding, so the binding is discoverable\n *  from the thing it acts on rather than only from a reference panel. */\nexport function KeyHint({ binding }: { binding: string }): ReactElement {\n  return (\n    <kbd\n      className=\"mono faint\"\n      style={{\n        fontSize: 9,\n        border: \"1px solid var(--border-strong)\",\n        borderRadius: 3,\n        padding: \"1px 4px\",\n        marginLeft: 6,\n        background: \"var(--surface-sunken)\",\n      }}\n    >\n      {binding}\n    </kbd>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 20 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 20 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 20 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\decision\\PremiseList.tsx"},"span":[1991,2005],"sourceCode":"/**\n * RESTS ON / EXCLUDES ΓÇö 6.2. Γÿà one of the three sections no competitor has.\n *\n * Phase 6 ┬╖ sub-phase 6.2\n * Plan: plan/phase-6-presentation.md ┬º6.2\n *\n * ---------------------------------------------------------------------------\n * LIVE LABELS, NOT THE LABEL STORED AT EXTRACTION TIME\n *\n * The label beside each premise is read from the labeller's current map. Rendering\n * `premise.label` instead would show \"P-0005 no-deploy-infra (IN)\" for a premise the log has since\n * falsified ΓÇö which is precisely the sentence that must never appear, because it makes the entire\n * premise mechanism look decorative. The card is where a user checks whether a decision still holds,\n * and a stale label there is worse than no label.\n *\n * ---------------------------------------------------------------------------\n * EXCLUDES IS NOT A FOOTNOTE\n *\n * A non-empty OUT-list is what makes a justification NON-MONOTONIC, and it is what gate (c) fires\n * on. Most tools that record assumptions record only what must be TRUE; recording what must NOT be\n * true is the part that lets the system notice the world changing in the other direction. So\n * EXCLUDES gets its own block, its own dashed treatment, and its own sentence explaining that if any\n * of it becomes true the decision is invalidated.\n * ---------------------------------------------------------------------------\n */\n\nimport { isWorldObservable } from \"@/ontology\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { LABEL_COLOUR, LABEL_MEANING } from \"@/theme\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { ReactElement } from \"react\";\nimport { LabelBadge } from \"../common/StatusBadge\";\n\nexport interface PremiseEntry {\n  readonly id: PremiseId;\n  readonly text: string;\n  readonly predicate: string;\n  readonly type: string;\n  readonly label: Labelled[\"label\"];\n  readonly observable: boolean;\n}\n\nexport function premiseEntries(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: DecisionId,\n): { restsOn: readonly PremiseEntry[]; excludes: readonly PremiseEntry[] } {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return { restsOn: [], excludes: [] };\n\n  const restsOn: PremiseEntry[] = [];\n  const excludes: PremiseEntry[] = [];\n  const seenIn = new Set<PremiseId>();\n  const seenOut = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seenIn.has(premiseId)) continue;\n      seenIn.add(premiseId);\n      const entry = entryFor(state, labels, premiseId);\n      if (entry !== null) restsOn.push(entry);\n    }\n\n    for (const premiseId of justification.outList) {\n      if (seenOut.has(premiseId)) continue;\n      seenOut.add(premiseId);\n      const entry = entryFor(state, labels, premiseId);\n      if (entry !== null) excludes.push(entry);\n    }\n  }\n\n  return { restsOn, excludes };\n}\n\nfunction entryFor(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  premiseId: PremiseId,\n): PremiseEntry | null {\n  const premise = state.premises.get(premiseId);\n  if (premise === undefined) return null;\n\n  return {\n    id: premiseId,\n    text: premise.text,\n    predicate: premise.predicate,\n    type: premise.type,\n    /* Live label first; the stored one only if the labeller has no entry, which happens during a\n     * partial fold and is reported rather than hidden. */\n    label: labels.get(premiseId)?.label ?? premise.label,\n    observable: isWorldObservable(premise.type),\n  };\n}\n\nexport function PremiseList({\n  restsOn,\n  excludes,\n  onSelectPremise,\n}: {\n  restsOn: readonly PremiseEntry[];\n  excludes: readonly PremiseEntry[];\n  onSelectPremise?: ((id: PremiseId) => void) | undefined;\n}): ReactElement {\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 10 }}>\n      <div>\n        <SectionLabel>rests on</SectionLabel>\n\n        {restsOn.length === 0 ? (\n          <div className=\"notice notice-warning\" style={{ fontSize: 12, marginTop: 6 }}>\n            Nothing recorded. This decision has no stated premises, so nothing can falsify it and\n            nothing would tell you when to stop believing it ΓÇö a gap in the log, not a decision that\n            needs no assumptions.\n          </div>\n        ) : (\n          <ul\n            style={{\n              margin: \"6px 0 0\",\n              paddingLeft: 0,\n              listStyle: \"none\",\n              display: \"flex\",\n              flexDirection: \"column\",\n              gap: 5,\n            }}\n          >\n            {restsOn.map((entry) => (\n              <PremiseRow key={entry.id} entry={entry} kind=\"in\" onSelect={onSelectPremise} />\n            ))}\n          </ul>\n        )}\n      </div>\n\n      {excludes.length > 0 ? (\n        <div>\n          <SectionLabel>excludes</SectionLabel>\n          <div className=\"dim\" style={{ fontSize: 11, marginTop: 2 }}>\n            If any of these becomes true, the decision is invalidated. A non-empty exclusion list is\n            what makes this justification non-monotonic, and it is what gate (c) watches.\n          </div>\n          <ul\n            style={{\n              margin: \"6px 0 0\",\n              paddingLeft: 0,\n              listStyle: \"none\",\n              display: \"flex\",\n              flexDirection: \"column\",\n              gap: 5,\n            }}\n          >\n            {excludes.map((entry) => (\n              <PremiseRow key={entry.id} entry={entry} kind=\"out\" onSelect={onSelectPremise} />\n            ))}\n          </ul>\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nfunction PremiseRow({\n  entry,\n  kind,\n  onSelect,\n}: {\n  entry: PremiseEntry;\n  kind: \"in\" | \"out\";\n  onSelect?: ((id: PremiseId) => void) | undefined;\n}): ReactElement {\n  const stale = entry.label === \"OUT\" && kind === \"in\";\n\n  return (\n    <li style={{ display: \"flex\", gap: 8, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n      <span\n        className=\"mono\"\n        style={{\n          fontSize: 11,\n          color: kind === \"out\" ? \"var(--label-unknown)\" : \"var(--text-faint)\",\n        }}\n      >\n        {kind === \"in\" ? \"Γ£ô\" : \"Γ£ù\"} {entry.id}\n      </span>\n\n      <button\n        type=\"button\"\n        className=\"mono faint\"\n        style={{ fontSize: 10, border: \"none\", background: \"none\", cursor: \"pointer\", padding: 0 }}\n        onClick={() => onSelect?.(entry.id)}\n        title=\"Show this premise in the lattice\"\n      >\n        {entry.type}.{entry.predicate}\n      </button>\n\n      <span style={{ fontSize: 12 }}>{entry.text}</span>\n\n      <LabelBadge label={entry.label} />\n\n      <span\n        className=\"faint mono\"\n        style={{ fontSize: 9 }}\n        title={\n          entry.observable\n            ? \"WORLD-OBSERVABLE ΓÇö a guard or a repo scan could falsify this without anyone telling the system.\"\n            : \"INTENT-BASED ΓÇö only a human can retract this. No guard can check it.\"\n        }\n      >\n        {entry.observable ? \"observable\" : \"intent\"}\n      </span>\n\n      {stale ? (\n        <span style={{ fontSize: 11, color: \"var(--edge-conflict)\" }} title={LABEL_MEANING.OUT}>\n          ! this premise is OUT ΓÇö the decision rests on something the log has falsified\n        </span>\n      ) : null}\n    </li>\n  );\n}\n\nfunction SectionLabel({ children }: { children: string }): ReactElement {\n  return (\n    <div\n      className=\"faint mono\"\n      style={{ fontSize: 10, letterSpacing: 0.7, textTransform: \"uppercase\" }}\n    >\n      {children}\n    </div>\n  );\n}\n\nexport { SectionLabel };\nexport { LABEL_COLOUR };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 19 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 19 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 19 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\graph\\DecisionGraph.tsx"},"span":[4433,4436],"sourceCode":"/**\n * The decision graph ΓÇö 6.6. Supersession chains.\n *\n * Phase 6 ┬╖ sub-phase 6.6\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * ---------------------------------------------------------------------------\n * THIS IS THE PICTURE EVERY COMPETITOR SHIPS, AND IT IS KEPT ANYWAY\n *\n * `ai-memory` draws decisions linked to decisions. That view is not wrong ΓÇö it answers \"what\n * replaced what?\", which is a real question and one the lattice answers badly, because supersession\n * is an edge between two leaves and the lattice puts leaves in a row.\n *\n * So this is a second view over the same graph, not a fallback: the lattice shows what holds a\n * decision UP, this shows what a decision was REPLACED BY. Both are needed and neither subsumes the\n * other.\n *\n * ---------------------------------------------------------------------------\n * CHAINS, NOT A GRAPH\n *\n * Rendered as chains by variable, because supersession is linear in practice: a variable holds one\n * live decision at a time, and its history is a sequence. Drawing it as a general graph would\n * produce a tangle of one-node-per-event with no more information than a list gives, and a list is\n * readable.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { LABEL_COLOUR, LABEL_MEANING } from \"@/theme\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { DecisionVariable } from \"@/types/domain\";\nimport type { ReactElement } from \"react\";\nimport { LabelBadge, StatusBadge } from \"../common/StatusBadge\";\n\nexport interface SupersessionChain {\n  readonly variable: DecisionVariable;\n  /** Oldest first, ending with the live decision. */\n  readonly decisions: readonly DecisionId[];\n  readonly live: DecisionId | null;\n}\n\n/** Chains by variable, oldest first. */\nexport function chainsOf(state: GraphState): readonly SupersessionChain[] {\n  const out: SupersessionChain[] = [];\n\n  for (const [variable, decisionIds] of state.byVariable) {\n    if (decisionIds.length < 2) continue;\n\n    /* Ordered by VALID time, which is the ordering rule for everything displayed: a pasted\n     * historical transcript would otherwise put a three-week-old decision at the end of its own\n     * chain because it was learned last. */\n    const sorted = [...decisionIds].sort((a, b) => {\n      const decisionA = state.decisions.get(a);\n      const decisionB = state.decisions.get(b);\n      const atA = decisionA?.temporal.valid ?? \"\";\n      const atB = decisionB?.temporal.valid ?? \"\";\n      return atA === atB ? (a < b ? -1 : 1) : atA < atB ? -1 : 1;\n    });\n\n    const live =\n      sorted.find((id) => {\n        const decision = state.decisions.get(id);\n        return (\n          decision !== undefined &&\n          decision.status !== \"superseded\" &&\n          decision.status !== \"archived\"\n        );\n      }) ?? null;\n\n    out.push({ variable, decisions: sorted, live });\n  }\n\n  /* Longest chain first: a variable that has been reversed four times is the interesting one, and\n   * it is also the one most likely to harbour an unreconciled contradiction. */\n  return out.sort(\n    (a, b) => b.decisions.length - a.decisions.length || (a.variable < b.variable ? -1 : 1),\n  );\n}\n\nexport function DecisionGraph({\n  state,\n  labels,\n  onSelect,\n}: {\n  state: GraphState;\n  labels: ReadonlyMap<NodeId, Labelled>;\n  onSelect?: (id: DecisionId) => void;\n}): ReactElement {\n  const chains = chainsOf(state);\n\n  if (chains.length === 0) {\n    return (\n      <div className=\"dim\" style={{ fontSize: 12 }}>\n        No variable has more than one decision yet, so there are no supersession chains. A chain\n        appears the first time a decision is reversed ΓÇö which is the moment this view becomes the\n        useful one, because \"what replaced what, and why\" is a question the lattice answers badly.\n      </div>\n    );\n  }\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 14 }}>\n      {chains.map((chain) => (\n        <div key={chain.variable}>\n          <div className=\"faint mono\" style={{ fontSize: 11, marginBottom: 6, letterSpacing: 0.6 }}>\n            {chain.variable} ┬╖ {chain.decisions.length} decision(s)\n          </div>\n\n          <div style={{ display: \"flex\", gap: 6, alignItems: \"stretch\", flexWrap: \"wrap\" }}>\n            {chain.decisions.map((decisionId, index) => {\n              const decision = state.decisions.get(decisionId);\n              if (decision === undefined) return null;\n\n              const nodeLabel = labels.get(decisionId)?.label ?? decision.label;\n              const isLive = chain.live === decisionId;\n\n              return (\n                <div key={decisionId} style={{ display: \"flex\", alignItems: \"center\", gap: 6 }}>\n                  {index > 0 ? (\n                    <span className=\"mono faint\" style={{ fontSize: 12 }} title=\"superseded by\">\n                      ΓåÆ\n                    </span>\n                  ) : null}\n\n                  <button\n                    type=\"button\"\n                    onClick={() => onSelect?.(decisionId)}\n                    title={LABEL_MEANING[nodeLabel]}\n                    style={{\n                      textAlign: \"left\",\n                      border: `1px solid ${isLive ? LABEL_COLOUR[nodeLabel] : \"var(--border-strong)\"}`,\n                      borderLeft: `3px solid ${LABEL_COLOUR[nodeLabel]}`,\n                      borderRadius: 4,\n                      padding: \"6px 9px\",\n                      background: isLive ? \"var(--surface-raised)\" : \"transparent\",\n                      opacity: isLive ? 1 : 0.62,\n                      cursor: \"pointer\",\n                      minWidth: 170,\n                    }}\n                  >\n                    <div className=\"mono faint\" style={{ fontSize: 10 }}>\n                      {decisionId} ┬╖ {decision.temporal.valid.slice(0, 10)}\n                    </div>\n                    <div\n                      style={{\n                        fontSize: 12,\n                        marginTop: 2,\n                        textDecoration: isLive ? \"none\" : \"line-through\",\n                      }}\n                    >\n                      {decision.statement}\n                    </div>\n                    <div style={{ display: \"flex\", gap: 5, marginTop: 4 }}>\n                      <LabelBadge label={nodeLabel} />\n                      <StatusBadge status={decision.status} />\n                    </div>\n                  </button>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      ))}\n\n      <div className=\"faint\" style={{ fontSize: 11 }}>\n        Ordered by VALID time, not learned time: a pasted historical transcript would otherwise put\n        a three-week-old decision at the end of its own chain because it was learned last.\n        Struck-through entries are superseded ΓÇö retained as history, never hidden, and excluded from\n        agent exports by default.\n      </div>\n    </div>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 19 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 19 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 19 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\graph\\LatticeHighlight.ts"},"span":[2808,2823],"sourceCode":"/**\n * Lattice highlighting ΓÇö 6.6.\n *\n * Phase 6 ┬╖ sub-phase 6.6\n *\n * ---------------------------------------------------------------------------\n * \"RENDER ONE CASCADE AT A TIME; NEVER THE WHOLE GRAPH UNFILTERED\"\n *\n * Selecting a node computes the set that matters for it and dims everything else. That is the\n * anti-hairball rule applied to INTERACTION rather than to layout: the layout drops what should\n * never be drawn, and highlighting drops what should not be looked at right now.\n *\n * Dimming rather than hiding, deliberately. A node that disappears when you click its neighbour\n * makes the diagram feel unstable, and the viewer loses the spatial memory of where things were. A\n * node that fades keeps its position and its context, and the eye tracks what changed.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { LatticeLayout } from \"./LatticeLayout\";\n\nexport interface Highlight {\n  /** The node that was clicked, or null when nothing is selected. */\n  readonly origin: NodeId | null;\n  /** Every node that stays at full opacity. */\n  readonly nodes: ReadonlySet<NodeId>;\n  /** Every edge that stays at full opacity, keyed `from\\u0000to\\u0000kind`. */\n  readonly edges: ReadonlySet<string>;\n}\n\nexport const NO_HIGHLIGHT: Highlight = { origin: null, nodes: new Set(), edges: new Set() };\n\nexport function edgeKey(from: NodeId, to: NodeId, kind: string): string {\n  return `${from}\\u0000${to}\\u0000${kind}`;\n}\n\n/**\n * What matters for this node.\n *\n * For a PREMISE: every decision resting on it, transitively through `depends-on` ΓÇö which is exactly\n * the cascade's blast radius, so clicking a premise previews what falsifying it would touch.\n *\n * For a DECISION: every premise holding it up, plus the decisions it depends on and the ones that\n * share its premises. Reading upward answers \"what would have to change for this to stop being\n * true?\", which is the question the whole product exists to answer.\n */\nexport function dependentsOf(state: GraphState, layout: LatticeLayout, origin: NodeId): Highlight {\n  const nodes = new Set<NodeId>([origin]);\n  const edges = new Set<string>();\n\n  if (isPremise(origin)) {\n    collectDownward(state, layout, origin as PremiseId, nodes, edges, new Set());\n  } else {\n    collectUpward(state, layout, origin as DecisionId, nodes, edges);\n  }\n\n  return { origin, nodes, edges };\n}\n\n/** Premise ΓåÆ decisions ΓåÆ their dependents, transitively. Depth-capped, because a cycle in\n *  `dependsOn` would otherwise loop forever and a highlight that hangs the tab is worse than one\n *  that is incomplete. */\nfunction collectDownward(\n  state: GraphState,\n  layout: LatticeLayout,\n  premiseId: PremiseId,\n  nodes: Set<NodeId>,\n  edges: Set<string>,\n  visited: Set<NodeId>,\n  depth = 0,\n): void {\n  if (depth > MAX_HIGHLIGHT_DEPTH) return;\n\n  const direct = state.premiseToDecisions.get(premiseId) ?? [];\n\n  for (const decisionId of direct) {\n    if (!layout.nodes.has(decisionId)) continue;\n\n    nodes.add(decisionId);\n    edges.add(edgeKey(premiseId, decisionId, \"supports\"));\n    edges.add(edgeKey(premiseId, decisionId, \"excludes\"));\n\n    if (visited.has(decisionId)) continue;\n    visited.add(decisionId);\n\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    /* `dependsOn` and `sharesPremiseWith` are the two edges the cascade is allowed to follow. The\n     * highlight follows exactly those and no others, so what you see lit up is what a falsification\n     * would actually reach ΓÇö not a superset that overstates the blast radius. */\n    for (const next of decision.edges.dependsOn) {\n      if (!layout.nodes.has(next)) continue;\n      nodes.add(next);\n      edges.add(edgeKey(decisionId, next, \"depends-on\"));\n    }\n\n    for (const next of decision.edges.sharesPremiseWith) {\n      if (!layout.nodes.has(next)) continue;\n      nodes.add(next);\n    }\n  }\n}\n\n/** Decision ΓåÆ the premises holding it up, and the decisions it depends on. */\nfunction collectUpward(\n  state: GraphState,\n  layout: LatticeLayout,\n  decisionId: DecisionId,\n  nodes: Set<NodeId>,\n  edges: Set<string>,\n): void {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return;\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (!layout.nodes.has(premiseId)) continue;\n      nodes.add(premiseId);\n      edges.add(edgeKey(premiseId, decisionId, \"supports\"));\n    }\n\n    for (const premiseId of justification.outList) {\n      if (!layout.nodes.has(premiseId)) continue;\n      nodes.add(premiseId);\n      edges.add(edgeKey(premiseId, decisionId, \"excludes\"));\n    }\n  }\n\n  for (const next of decision.edges.dependsOn) {\n    if (!layout.nodes.has(next)) continue;\n    nodes.add(next);\n    edges.add(edgeKey(decisionId, next, \"depends-on\"));\n  }\n\n  for (const next of decision.edges.conflictsWith) {\n    if (!layout.nodes.has(next)) continue;\n    nodes.add(next);\n    edges.add(edgeKey(decisionId, next, \"conflicts\"));\n  }\n\n  for (const next of decision.edges.supersedes) {\n    if (!layout.nodes.has(next)) continue;\n    nodes.add(next);\n    edges.add(edgeKey(decisionId, next, \"supersedes\"));\n  }\n}\n\n/** Same depth cap as the cascade: 4. Matching it is deliberate ΓÇö a highlight that reaches deeper\n *  than the cascade would show nodes lit up that a real falsification could never touch, which is\n *  the highlight lying about the mechanism. */\nexport const MAX_HIGHLIGHT_DEPTH = 4;\n\nexport function isPremise(id: NodeId): boolean {\n  return id.startsWith(\"P-\");\n}\n\nexport type { Labelled };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 23 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 23 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 23 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\graph\\LatticeHighlight.ts"},"span":[4196,4209],"sourceCode":"/**\n * Lattice highlighting ΓÇö 6.6.\n *\n * Phase 6 ┬╖ sub-phase 6.6\n *\n * ---------------------------------------------------------------------------\n * \"RENDER ONE CASCADE AT A TIME; NEVER THE WHOLE GRAPH UNFILTERED\"\n *\n * Selecting a node computes the set that matters for it and dims everything else. That is the\n * anti-hairball rule applied to INTERACTION rather than to layout: the layout drops what should\n * never be drawn, and highlighting drops what should not be looked at right now.\n *\n * Dimming rather than hiding, deliberately. A node that disappears when you click its neighbour\n * makes the diagram feel unstable, and the viewer loses the spatial memory of where things were. A\n * node that fades keeps its position and its context, and the eye tracks what changed.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { LatticeLayout } from \"./LatticeLayout\";\n\nexport interface Highlight {\n  /** The node that was clicked, or null when nothing is selected. */\n  readonly origin: NodeId | null;\n  /** Every node that stays at full opacity. */\n  readonly nodes: ReadonlySet<NodeId>;\n  /** Every edge that stays at full opacity, keyed `from\\u0000to\\u0000kind`. */\n  readonly edges: ReadonlySet<string>;\n}\n\nexport const NO_HIGHLIGHT: Highlight = { origin: null, nodes: new Set(), edges: new Set() };\n\nexport function edgeKey(from: NodeId, to: NodeId, kind: string): string {\n  return `${from}\\u0000${to}\\u0000${kind}`;\n}\n\n/**\n * What matters for this node.\n *\n * For a PREMISE: every decision resting on it, transitively through `depends-on` ΓÇö which is exactly\n * the cascade's blast radius, so clicking a premise previews what falsifying it would touch.\n *\n * For a DECISION: every premise holding it up, plus the decisions it depends on and the ones that\n * share its premises. Reading upward answers \"what would have to change for this to stop being\n * true?\", which is the question the whole product exists to answer.\n */\nexport function dependentsOf(state: GraphState, layout: LatticeLayout, origin: NodeId): Highlight {\n  const nodes = new Set<NodeId>([origin]);\n  const edges = new Set<string>();\n\n  if (isPremise(origin)) {\n    collectDownward(state, layout, origin as PremiseId, nodes, edges, new Set());\n  } else {\n    collectUpward(state, layout, origin as DecisionId, nodes, edges);\n  }\n\n  return { origin, nodes, edges };\n}\n\n/** Premise ΓåÆ decisions ΓåÆ their dependents, transitively. Depth-capped, because a cycle in\n *  `dependsOn` would otherwise loop forever and a highlight that hangs the tab is worse than one\n *  that is incomplete. */\nfunction collectDownward(\n  state: GraphState,\n  layout: LatticeLayout,\n  premiseId: PremiseId,\n  nodes: Set<NodeId>,\n  edges: Set<string>,\n  visited: Set<NodeId>,\n  depth = 0,\n): void {\n  if (depth > MAX_HIGHLIGHT_DEPTH) return;\n\n  const direct = state.premiseToDecisions.get(premiseId) ?? [];\n\n  for (const decisionId of direct) {\n    if (!layout.nodes.has(decisionId)) continue;\n\n    nodes.add(decisionId);\n    edges.add(edgeKey(premiseId, decisionId, \"supports\"));\n    edges.add(edgeKey(premiseId, decisionId, \"excludes\"));\n\n    if (visited.has(decisionId)) continue;\n    visited.add(decisionId);\n\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    /* `dependsOn` and `sharesPremiseWith` are the two edges the cascade is allowed to follow. The\n     * highlight follows exactly those and no others, so what you see lit up is what a falsification\n     * would actually reach ΓÇö not a superset that overstates the blast radius. */\n    for (const next of decision.edges.dependsOn) {\n      if (!layout.nodes.has(next)) continue;\n      nodes.add(next);\n      edges.add(edgeKey(decisionId, next, \"depends-on\"));\n    }\n\n    for (const next of decision.edges.sharesPremiseWith) {\n      if (!layout.nodes.has(next)) continue;\n      nodes.add(next);\n    }\n  }\n}\n\n/** Decision ΓåÆ the premises holding it up, and the decisions it depends on. */\nfunction collectUpward(\n  state: GraphState,\n  layout: LatticeLayout,\n  decisionId: DecisionId,\n  nodes: Set<NodeId>,\n  edges: Set<string>,\n): void {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return;\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (!layout.nodes.has(premiseId)) continue;\n      nodes.add(premiseId);\n      edges.add(edgeKey(premiseId, decisionId, \"supports\"));\n    }\n\n    for (const premiseId of justification.outList) {\n      if (!layout.nodes.has(premiseId)) continue;\n      nodes.add(premiseId);\n      edges.add(edgeKey(premiseId, decisionId, \"excludes\"));\n    }\n  }\n\n  for (const next of decision.edges.dependsOn) {\n    if (!layout.nodes.has(next)) continue;\n    nodes.add(next);\n    edges.add(edgeKey(decisionId, next, \"depends-on\"));\n  }\n\n  for (const next of decision.edges.conflictsWith) {\n    if (!layout.nodes.has(next)) continue;\n    nodes.add(next);\n    edges.add(edgeKey(decisionId, next, \"conflicts\"));\n  }\n\n  for (const next of decision.edges.supersedes) {\n    if (!layout.nodes.has(next)) continue;\n    nodes.add(next);\n    edges.add(edgeKey(decisionId, next, \"supersedes\"));\n  }\n}\n\n/** Same depth cap as the cascade: 4. Matching it is deliberate ΓÇö a highlight that reaches deeper\n *  than the cascade would show nodes lit up that a real falsification could never touch, which is\n *  the highlight lying about the mechanism. */\nexport const MAX_HIGHLIGHT_DEPTH = 4;\n\nexport function isPremise(id: NodeId): boolean {\n  return id.startsWith(\"P-\");\n}\n\nexport type { Labelled };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 24 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 24 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 24 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\components\\decision\\sections.tsx"},"span":[8149,8152],"sourceCode":"/**\n * The remaining decision-card sections ΓÇö 6.2.\n *\n * Phase 6 ┬╖ sub-phase 6.2\n *\n * Five small sections in one file. They are grouped because each is under twenty lines of markup and\n * each reads one field off the decision: splitting them into five files would make the card's\n * structure harder to see, not easier, and the plan's density risk is about the rendered card rather\n * than the file count.\n *\n * The three sections no competitor has ΓÇö RESTS ON / EXCLUDES, ENTRENCHMENT and ACCEPTED DOWNSIDE ΓÇö\n * are the ones with their own files, because each carries an argument worth stating at length.\n */\n\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { EDGE_STYLE } from \"@/theme\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { GuardSpec } from \"@/types/guards\";\nimport type { ReactElement } from \"react\";\nimport { SectionLabel } from \"./PremiseList\";\n\n/* -------------------------------------------------------------------------- */\n/* Y-statement                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * \"In the context of Γƒ¿premisesΓƒ⌐, facing Γƒ¿concernΓƒ⌐, we decided for Γƒ¿valueΓƒ⌐ to achieve Γƒ¿qualityΓƒ⌐,\n *  accepting Γƒ¿downsideΓƒ⌐.\"\n *\n * Rendered verbatim when Phase 1 recovered it. When it did not, the card falls back to the short\n * imperative statement rather than synthesising a Y-statement from parts ΓÇö a generated one would read\n * as though someone had said it, and the whole provenance discipline exists to prevent exactly that.\n */\nexport function YStatement({ decision }: { decision: Decision }): ReactElement | null {\n  if (decision.yStatement === undefined || decision.yStatement.trim().length === 0) return null;\n\n  return (\n    <p style={{ margin: \"8px 0 0\", fontSize: 13, lineHeight: 1.6 }}>\n      {decision.yStatement}\n      <span className=\"faint mono\" style={{ fontSize: 9, marginLeft: 8 }}>\n        Y-statement\n      </span>\n    </p>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rejected alternatives                                                      */\n/* -------------------------------------------------------------------------- */\n\n/** The rejected alternatives, with the reason each was turned down. An alternative with no recorded\n *  reason is shown as having none, rather than omitted: the absence is information, because it means\n *  the rejection cannot pre-empt a repeat question and cannot appear in the export's\n *  do-not-re-propose block. */\nexport function AlternativeList({\n  state,\n  decision,\n}: { state: GraphState; decision: Decision }): ReactElement {\n  const alternatives = decision.alternativeIds\n    .map((id) => state.alternatives.get(id))\n    .filter((entry) => entry !== undefined);\n\n  if (alternatives.length === 0) {\n    return (\n      <div>\n        <SectionLabel>rejected</SectionLabel>\n        <div className=\"dim\" style={{ fontSize: 12, marginTop: 4 }}>\n          Nothing recorded as rejected. Without alternatives the log can say what was chosen but not\n          what was turned down ΓÇö which is the half that stops the next person, or the next agent,\n          proposing it again.\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div>\n      <SectionLabel>rejected</SectionLabel>\n      <ul\n        style={{\n          margin: \"6px 0 0\",\n          paddingLeft: 18,\n          display: \"flex\",\n          flexDirection: \"column\",\n          gap: 4,\n        }}\n      >\n        {alternatives.map((alternative) => (\n          <li key={alternative.id} style={{ fontSize: 12 }}>\n            <strong>{alternative.value}</strong>\n            {alternative.whyRejected === undefined ? (\n              <span\n                className=\"faint\"\n                style={{ marginLeft: 8 }}\n                title=\"A rejection with no reason cannot pre-empt a repeat question and is excluded from the export's do-not-re-propose block.\"\n              >\n                ΓÇö no reason recorded\n              </span>\n            ) : (\n              <span className=\"dim\" style={{ marginLeft: 8 }}>\n                ΓÇö ΓÇ£{alternative.whyRejected}ΓÇ¥\n              </span>\n            )}\n            {!alternative.confirmedByHuman ? (\n              <span\n                className=\"faint mono\"\n                style={{ fontSize: 9, marginLeft: 8 }}\n                title=\"Alternatives need explicit human confirmation before entering the pre-emption index. At 15.4% extraction precision, an unconfirmed inferred rejection is more likely wrong than right.\"\n              >\n                unconfirmed\n              </span>\n            ) : null}\n          </li>\n        ))}\n      </ul>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Accepted downside                                                          */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The third section no competitor has.\n *\n * Nobody stores the downside they knowingly accepted, and it is precisely what a future you needs\n * when the downside arrives. \"Single-writer limit; migration needed if multi-user\" turns a surprise\n * into a scheduled event ΓÇö the second user shows up, the card already said this would happen, and the\n * response is a supersession rather than a discovery.\n */\nexport function AcceptedDownside({ decision }: { decision: Decision }): ReactElement | null {\n  if (decision.acceptedDownside === undefined || decision.acceptedDownside.trim().length === 0)\n    return null;\n\n  return (\n    <div>\n      <SectionLabel>accepted downside</SectionLabel>\n      <div\n        style={{\n          marginTop: 4,\n          padding: \"6px 10px\",\n          borderLeft: \"2px solid var(--label-unknown)\",\n          fontSize: 12,\n        }}\n        title=\"Nobody stores the downside they knowingly accepted, and it is precisely what a future you needs when the downside arrives. This turns a surprise into a scheduled event.\"\n      >\n        {decision.acceptedDownside}\n      </div>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Guards                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport function GuardSummary({\n  state,\n  decision,\n}: { state: GraphState; decision: Decision }): ReactElement {\n  const guards = decision.guardIds\n    .map((id) => state.guards.get(id))\n    .filter((guard) => guard !== undefined && guard.lifecycle !== \"deleted\");\n\n  const passing = guards.filter((guard) => guard?.lastRun?.outcome === \"pass\").length;\n  const failing = guards.filter((guard) => guard?.lastRun?.outcome === \"fail\").length;\n  const accepted = guards.filter((guard) => guard?.lifecycle === \"accepted\").length;\n\n  return (\n    <div>\n      <SectionLabel>guards</SectionLabel>\n\n      {guards.length === 0 ? (\n        <div className=\"notice notice-warning\" style={{ fontSize: 12, marginTop: 6 }}>\n          None. Nothing automatically checks whether this decision still holds ΓÇö it is recorded\n          because it is believed, not because it is enforced. Synthesise guards on the Guards tab.\n        </div>\n      ) : (\n        <>\n          <div style={{ fontSize: 12, marginTop: 4 }}>\n            <strong style={{ color: failing > 0 ? \"var(--edge-conflict)\" : \"var(--label-in)\" }}>\n              {passing}/{accepted} passing\n            </strong>\n            {failing > 0 ? (\n              <span style={{ color: \"var(--edge-conflict)\" }}> ┬╖ {failing} FAILING</span>\n            ) : null}\n            {guards.length - accepted > 0 ? (\n              <span className=\"faint\"> ┬╖ {guards.length - accepted} not yet accepted</span>\n            ) : null}\n          </div>\n\n          <ul\n            style={{\n              margin: \"6px 0 0\",\n              paddingLeft: 18,\n              display: \"flex\",\n              flexDirection: \"column\",\n              gap: 3,\n            }}\n          >\n            {guards.map((guard) => {\n              if (guard === undefined) return null;\n              const outcome = guard.lastRun?.outcome ?? \"never run\";\n              const mark = outcome === \"pass\" ? \"Γ£ô\" : outcome === \"fail\" ? \"Γ£ù\" : \"ΓÇô\";\n              const colour =\n                outcome === \"pass\"\n                  ? \"var(--label-in)\"\n                  : outcome === \"fail\"\n                    ? \"var(--edge-conflict)\"\n                    : \"var(--text-faint)\";\n\n              return (\n                <li key={guard.id} style={{ fontSize: 11.5 }}>\n                  <span className=\"mono\" style={{ color: colour }}>\n                    {mark}\n                  </span>{\" \"}\n                  <span className=\"mono faint\">{guard.id}</span>{\" \"}\n                  <span className=\"mono\">{guard.spec.kind}</span>{\" \"}\n                  <span className=\"dim\">{guardTarget(guard.spec)}</span>{\" \"}\n                  <span\n                    className=\"badge\"\n                    style={{\n                      color:\n                        guard.severity === \"blocking\"\n                          ? \"var(--edge-conflict)\"\n                          : \"var(--label-unknown)\",\n                    }}\n                  >\n                    {guard.severity}\n                  </span>{\" \"}\n                  <span className=\"badge faint\">{guard.lifecycle}</span>\n                  {guard.disabledByDecisionLabel ? (\n                    <span className=\"faint\" style={{ fontSize: 10 }}>\n                      {\" \"}\n                      disabled ΓÇö decision not IN\n                    </span>\n                  ) : null}\n                </li>\n              );\n            })}\n          </ul>\n        </>\n      )}\n    </div>\n  );\n}\n\n/** What the guard actually checks, in one short phrase. Switched over the spec union rather than\n *  reached into with a cast, so adding a ninth guard kind produces a compile error here instead of\n *  rendering \"undefined\" into the card. */\nfunction guardTarget(spec: GuardSpec): string {\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\":\n      return spec.package;\n    case \"path_glob_exists\":\n    case \"path_glob_absent\":\n      return spec.glob;\n    case \"string_in_files\":\n    case \"string_absent_in_files\":\n      return `${JSON.stringify(spec.pattern)} in ${spec.glob}`;\n    case \"command_exit_zero\":\n      return spec.command;\n    case \"llm_judge\":\n      return `rubric over ${spec.scopeGlobs.join(\", \")}`;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Relations                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/** The five edge kinds, each with the style the lattice gives it, so the card and the picture agree\n *  about what a relationship means. */\nexport function RelationList({\n  state,\n  decision,\n}: { state: GraphState; decision: Decision }): ReactElement {\n  const groups: { kind: keyof Decision[\"edges\"]; label: string; ids: readonly DecisionId[] }[] = [\n    { kind: \"dependsOn\", label: \"depends on\", ids: decision.edges.dependsOn },\n    { kind: \"sharesPremiseWith\", label: \"shares a premise\", ids: decision.edges.sharesPremiseWith },\n    { kind: \"supersedes\", label: \"supersedes\", ids: decision.edges.supersedes },\n    { kind: \"supersededBy\", label: \"superseded by\", ids: decision.edges.supersededBy },\n    { kind: \"conflictsWith\", label: \"conflicts with\", ids: decision.edges.conflictsWith },\n    { kind: \"related\", label: \"related\", ids: decision.edges.related },\n  ];\n\n  const present = groups.filter((group) => group.ids.length > 0);\n\n  if (present.length === 0) {\n    return (\n      <div>\n        <SectionLabel>relates to</SectionLabel>\n        <div className=\"dim\" style={{ fontSize: 12, marginTop: 4 }}>\n          Nothing. This decision shares no premise with another, depends on nothing and supersedes\n          nothing ΓÇö so falsifying any other premise cannot reach it, and it cannot reach anything\n          else.\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div>\n      <SectionLabel>relates to</SectionLabel>\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 4, marginTop: 6 }}>\n        {present.map((group) => {\n          const style = EDGE_STYLE[group.kind];\n          return (\n            <div\n              key={group.kind}\n              style={{ display: \"flex\", gap: 8, alignItems: \"baseline\", fontSize: 12 }}\n            >\n              <svg width=\"24\" height=\"8\" aria-hidden=\"true\" style={{ flexShrink: 0 }}>\n                <line\n                  x1=\"0\"\n                  y1=\"4\"\n                  x2=\"24\"\n                  y2=\"4\"\n                  stroke={style.stroke}\n                  strokeWidth={style.width}\n                  strokeDasharray={style.dash}\n                />\n              </svg>\n              <span className=\"faint\" style={{ fontSize: 11, minWidth: 110 }} title={style.label}>\n                {group.label}\n              </span>\n              <span className=\"mono\">\n                {group.ids.map((id) => state.decisions.get(id)?.id ?? id).join(\", \")}\n              </span>\n            </div>\n          );\n        })}\n      </div>\n      <div className=\"faint\" style={{ fontSize: 10, marginTop: 6 }}>\n        Edge styles match the premise lattice exactly, so a relationship means the same thing in\n        both views. `conflicts` is the only red: red means an action is available.\n      </div>\n    </div>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * One HTTP client for every provider.\n *    max_tokens: request.maxTokens ?? DEFAULT_MAX_TOKENS,\n  };\n  if (request.json === true && provider === \"openai\") {\n    body[\"response_format\"]body.response_format= { type: \"json_object\" };\n  }\n  return body;  });\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":165}},{"diffOp":{"equal":{"range":[45,162]}}},{"diffOp":{"equal":{"range":[162,167]}}},{"diffOp":{"delete":{"range":[167,190]}}},{"diffOp":{"insert":{"range":[190,210]}}},{"diffOp":{"equal":{"range":[45,46]}}},{"diffOp":{"equal":{"range":[210,255]}}},{"equalLines":{"line_count":161}},{"diffOp":{"equal":{"range":[255,263]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\ai\\providers\\openai-compatible.ts"},"span":[5971,5988],"sourceCode":"/**\n * One HTTP client for every provider.\n *\n * Phase 1 ┬╖ sub-phase 1.10 (the LLM path)\n *\n * ---------------------------------------------------------------------------\n * WHY ONE FILE AND NOT THREE\n *\n * OpenAI and OpenRouter speak the same dialect (`/chat/completions`, a `messages`\n * array, `content` strings). Anthropic speaks a near-dialect (`/messages`, a\n * `system` field, content blocks). Three provider modules would be three copies of\n * the retry policy, three copies of the timeout, and three places where the API key\n * is read ΓÇö and the key handling is the part that must not have variants.\n *\n * So: one client, one request shape, two response adapters.\n *\n * ---------------------------------------------------------------------------\n * THE KEY NEVER APPEARS IN AN ERROR\n *\n * `EngineError.details` is rendered into a notice the user can screenshot. The\n * Authorization header is never put in `details`, and a response body is truncated\n * before it is quoted, because a provider that echoes the request back would echo\n * the key with it.\n * ---------------------------------------------------------------------------\n */\n\nimport type { ProviderId } from \"../config\";\nimport {\n  EngineError,\n  fromResponse,\n  malformedOutputError,\n  networkError,\n  retryPolicy,\n} from \"../errors\";\n\nexport interface ChatMessage {\n  readonly role: \"system\" | \"user\" | \"assistant\";\n  readonly content: string;\n}\n\nexport interface ChatRequest {\n  readonly model: string;\n  readonly messages: readonly ChatMessage[];\n  readonly temperature?: number;\n  readonly maxTokens?: number;\n  readonly signal?: AbortSignal;\n  /** Ask for JSON. Providers that support a structured-output mode use it; the rest\n   *  get the instruction in the prompt and are parsed defensively. */\n  readonly json?: boolean;\n}\n\nexport interface ChatResponse {\n  readonly text: string;\n  readonly promptTokens: number;\n  readonly completionTokens: number;\n  readonly model: string;\n}\n\nconst ENDPOINTS: Readonly<Record<Exclude<ProviderId, \"local\">, string>> = {\n  openai: \"https://api.openai.com/v1/chat/completions\",\n  openrouter: \"https://openrouter.ai/api/v1/chat/completions\",\n  anthropic: \"https://api.anthropic.com/v1/messages\",\n};\n\nconst ANTHROPIC_VERSION = \"2023-06-01\";\nconst DEFAULT_TIMEOUT_MS = 90_000;\nconst DEFAULT_MAX_TOKENS = 4_096;\n/** Response bodies are quoted in error notices. A provider that echoes the request\n *  would echo several kilobytes, so the quote is capped. */\nconst MAX_QUOTED_BODY = 400;\n\n/* -------------------------------------------------------------------------- */\n/* The call                                                                   */\n/* -------------------------------------------------------------------------- */\n\n/**\n * One chat completion, with retries.\n *\n * Retries only what `retryPolicy` says is retryable ΓÇö rate limit, timeout, network,\n * malformed output. A 401 is not retried: three failed attempts with a bad key is\n * three chances for the provider to lock the account.\n */\nexport async function chat(\n  provider: Exclude<ProviderId, \"local\">,\n  apiKey: string,\n  request: ChatRequest,\n): Promise<ChatResponse> {\n  let attempt = 0;\n\n  for (;;) {\n    attempt += 1;\n    try {\n      return await once(provider, apiKey, request);\n    } catch (error) {\n      if (!(error instanceof EngineError)) throw error;\n      if (request.signal?.aborted) throw error;\n\n      const policy = retryPolicy(error);\n      if (!policy.retry || attempt > policy.attempts) throw error;\n\n      await sleep(policy.delayMs * attempt, request.signal);\n    }\n  }\n}\n\nasync function once(\n  provider: Exclude<ProviderId, \"local\">,\n  apiKey: string,\n  request: ChatRequest,\n): Promise<ChatResponse> {\n  if (request.signal?.aborted) {\n    throw new EngineError(\"cancelled\", \"Cancelled before the request was sent.\", {\n      engine: request.model,\n    });\n  }\n\n  const url = ENDPOINTS[provider];\n  const body = provider === \"anthropic\" ? anthropicBody(request) : openaiBody(provider, request);\n\n  const controller = new AbortController();\n  const timeout = setTimeout(() => controller.abort(), DEFAULT_TIMEOUT_MS);\n  const onAbort = (): void => controller.abort();\n  request.signal?.addEventListener(\"abort\", onAbort, { once: true });\n\n  try {\n    const response = await fetch(url, {\n      method: \"POST\",\n      headers: headers(provider, apiKey, request),\n      body: JSON.stringify(body),\n      signal: controller.signal,\n    });\n\n    const text = await response.text();\n    if (!response.ok)\n      throw fromResponse(response.status, text.slice(0, MAX_QUOTED_BODY), request.model);\n\n    return provider === \"anthropic\"\n      ? readAnthropic(text, request.model)\n      : readOpenAi(text, request.model);\n  } catch (error) {\n    if (error instanceof EngineError) throw error;\n    if (controller.signal.aborted && request.signal?.aborted) {\n      throw new EngineError(\"cancelled\", \"Cancelled.\", { engine: request.model });\n    }\n    if (controller.signal.aborted) {\n      throw new EngineError(\"timeout\", `No response within ${DEFAULT_TIMEOUT_MS / 1000}s.`, {\n        engine: request.model,\n      });\n    }\n    throw networkError(error, request.model);\n  } finally {\n    clearTimeout(timeout);\n    request.signal?.removeEventListener(\"abort\", onAbort);\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Request bodies                                                             */\n/* -------------------------------------------------------------------------- */\n\nfunction openaiBody(\n  provider: Exclude<ProviderId, \"local\">,\n  request: ChatRequest,\n): Record<string, unknown> {\n  const body: Record<string, unknown> = {\n    model: request.model,\n    messages: request.messages.map((message) => ({ role: message.role, content: message.content })),\n    temperature: request.temperature ?? 0.2,\n    max_tokens: request.maxTokens ?? DEFAULT_MAX_TOKENS,\n  };\n  if (request.json === true && provider === \"openai\") {\n    body[\"response_format\"] = { type: \"json_object\" };\n  }\n  return body;\n}\n\nfunction anthropicBody(request: ChatRequest): Record<string, unknown> {\n  const system = request.messages\n    .filter((message) => message.role === \"system\")\n    .map((message) => message.content)\n    .join(\"\\n\\n\");\n\n  return {\n    model: request.model,\n    ...(system.length === 0 ? {} : { system }),\n    messages: request.messages\n      .filter((message) => message.role !== \"system\")\n      .map((message) => ({ role: message.role, content: message.content })),\n    temperature: request.temperature ?? 0.2,\n    max_tokens: request.maxTokens ?? DEFAULT_MAX_TOKENS,\n  };\n}\n\nfunction headers(\n  provider: Exclude<ProviderId, \"local\">,\n  apiKey: string,\n  request: ChatRequest,\n): Record<string, string> {\n  const base: Record<string, string> = { \"content-type\": \"application/json\" };\n\n  if (provider === \"anthropic\") {\n    base[\"x-api-key\"] = apiKey;\n    base[\"anthropic-version\"] = ANTHROPIC_VERSION;\n    // Required for browser calls; without it the preflight fails and the error\n    // looks like a network failure rather than a missing header.\n    base[\"anthropic-dangerous-direct-browser-access\"] = \"true\";\n    return base;\n  }\n\n  base[\"authorization\"] = `Bearer ${apiKey}`;\n  if (provider === \"openrouter\") {\n    base[\"http-referer\"] = \"https://github.com/whylog\";\n    base[\"x-title\"] = \"WhyLog\";\n  }\n  void request;\n  return base;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Response adapters                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction readOpenAi(raw: string, model: string): ChatResponse {\n  const parsed = parseJson(raw, model);\n  const choice = Array.isArray(parsed[\"choices\"])\n    ? (parsed[\"choices\"][0] as Record<string, unknown>)\n    : undefined;\n  const message = choice?.[\"message\"] as Record<string, unknown> | undefined;\n  const text = typeof message?.[\"content\"] === \"string\" ? message[\"content\"] : \"\";\n\n  if (text.length === 0) throw malformedOutputError(raw.slice(0, MAX_QUOTED_BODY), model);\n\n  const usage = parsed[\"usage\"] as Record<string, unknown> | undefined;\n  return {\n    text,\n    promptTokens: numberOf(usage?.[\"prompt_tokens\"]),\n    completionTokens: numberOf(usage?.[\"completion_tokens\"]),\n    model: typeof parsed[\"model\"] === \"string\" ? parsed[\"model\"] : model,\n  };\n}\n\nfunction readAnthropic(raw: string, model: string): ChatResponse {\n  const parsed = parseJson(raw, model);\n  const blocks = Array.isArray(parsed[\"content\"])\n    ? (parsed[\"content\"] as readonly Record<string, unknown>[])\n    : [];\n  const text = blocks\n    .filter((block) => block[\"type\"] === \"text\" && typeof block[\"text\"] === \"string\")\n    .map((block) => block[\"text\"] as string)\n    .join(\"\");\n\n  if (text.length === 0) throw malformedOutputError(raw.slice(0, MAX_QUOTED_BODY), model);\n\n  const usage = parsed[\"usage\"] as Record<string, unknown> | undefined;\n  return {\n    text,\n    promptTokens: numberOf(usage?.[\"input_tokens\"]),\n    completionTokens: numberOf(usage?.[\"output_tokens\"]),\n    model: typeof parsed[\"model\"] === \"string\" ? parsed[\"model\"] : model,\n  };\n}\n\nfunction parseJson(raw: string, model: string): Record<string, unknown> {\n  try {\n    const parsed = JSON.parse(raw) as unknown;\n    if (parsed === null || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n      throw new Error(\"not an object\");\n    }\n    return parsed as Record<string, unknown>;\n  } catch {\n    throw fromResponse(\n      502,\n      `Provider returned something that is not JSON: ${raw.slice(0, 120)}`,\n      model,\n    );\n  }\n}\n\nfunction numberOf(value: unknown): number {\n  return typeof value === \"number\" && Number.isFinite(value) ? value : 0;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Extracting JSON from a model that wrapped it in prose                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Pull the JSON object out of a completion.\n *\n * Models wrap JSON in ```json fences, in a sentence, or in both, whatever the\n * prompt says. Refusing to parse anything but a bare object would turn a correct\n * extraction into a `malformed-output` error, and the retry would probably produce\n * the same wrapping ΓÇö so the fence is stripped and the outermost braces are found.\n */\nexport function extractJson(text: string, model: string): Record<string, unknown> {\n  const fenced = /```(?:json)?\\s*([\\s\\S]*?)```/i.exec(text);\n  const candidate = fenced?.[1] ?? text;\n\n  const start = candidate.indexOf(\"{\");\n  const end = candidate.lastIndexOf(\"}\");\n  if (start < 0 || end <= start) throw malformedOutputError(text.slice(0, MAX_QUOTED_BODY), model);\n\n  try {\n    const parsed = JSON.parse(candidate.slice(start, end + 1)) as unknown;\n    if (parsed === null || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n      throw new Error(\"not an object\");\n    }\n    return parsed as Record<string, unknown>;\n  } catch (error) {\n    throw malformedOutputError(\n      candidate.slice(start, Math.min(end + 1, start + MAX_QUOTED_BODY)),\n      model,\n      error,\n    );\n  }\n}\n\nfunction sleep(ms: number, signal?: AbortSignal): Promise<void> {\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => {\n      signal?.removeEventListener(\"abort\", onAbort);\n      resolve();\n    }, ms);\n\n    const onAbort = (): void => {\n      clearTimeout(timer);\n      reject(new EngineError(\"cancelled\", \"Cancelled while waiting to retry.\", { engine: \"llm\" }));\n    };\n\n    if (signal?.aborted) {\n      clearTimeout(timer);\n      onAbort();\n      return;\n    }\n    signal?.addEventListener(\"abort\", onAbort, { once: true });\n  });\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * One HTTP client for every provider.\n *    base[\"anthropic-dangerous-direct-browser-access\"] = \"true\";\n    return base;\n  }\n\n  base[\"authorization\"]base.authorization= `Bearer ${apiKey}`;\n  if (provider === \"openrouter\") {\n    base[\"http-referer\"] = \"https://github.com/whylog\";  });\n}\n","ops":[{"diffOp":{"equal":{"range":[0,45]}}},{"equalLines":{"line_count":202}},{"diffOp":{"equal":{"range":[45,129]}}},{"diffOp":{"equal":{"range":[129,133]}}},{"d