ejection: { reason: \"not-a-whylog-file\", detail: \"the file is not a JSON object\" },\n    };\n  }\n\n  const candidate = parsed as Record<string, unknown>;\n  if (!Array.isArray(candidate[\"events\"])) {\n    return {\n      ok: false,\n      rejection: {\n        reason: \"not-a-whylog-file\",\n        detail: \"no `events` array ΓÇö a WhyLog file carries events, not a materialised graph\",\n      },\n    };\n  }\n\n  const version =\n    typeof candidate[\"schemaVersion\"] === \"number\" ? candidate[\"schemaVersion\"] : SCHEMA_VERSION;\n\n  if (version > SCHEMA_VERSION) {\n    return { ok: false, rejection: { reason: \"newer-schema\", version } };\n  }\n  if (!canLoad(version)) {\n    return { ok: false, rejection: { reason: \"unsupported-schema\", version } };\n  }\n\n  /* ---- coerce every event, refusing the file on the first bad one ---- */\n  const coerced: AnyEvent[] = [];\n  for (let i = 0; i < candidate[\"events\"].length; i += 1) {\n    const result = coerceEvent(candidate[\"events\"][i]);\n    if (!result.ok) {\n      return {\n        ok: false,\n        rejection: { reason: \"malformed-event\", index: i, detail: result.reason },\n      };\n    }\n    coerced.push(result.event);\n  }\n\n  /* ---- migrate if needed. Migrations APPEND events; they never rewrite. ---- */\n  const migration = migrateEvents(coerced, version);\n  if (!migration.ok) {\n    return {\n      ok: false,\n      rejection: { reason: \"unsupported-schema\", version },\n    };\n  }\n\n  /* ---- verify the chain over the WHOLE file ---- */\n  const verification = verifyChain(migration.events);\n  if (!verification.valid) {\n    return { ok: false, rejection: { reason: \"chain-broken\", verification } };\n  }\n\n  const declaredHead = typeof candidate[\"headHash\"] === \"string\" ? candidate[\"headHash\"] : null;\n  if (declaredHead !== null && declaredHead !== verification.headHash) {\n    return {\n      ok: false,\n      rejection: {\n        reason: \"head-hash-mismatch\",\n        expected: declaredHead,\n        found: verification.headHash,\n      },\n    };\n  }\n\n  /* ---- deduplicate against the local log ---- */\n  const fresh: AnyEvent[] = [];\n  let duplicates = 0;\n\n  for (const event of migration.events) {\n    if (options.existingIds?.has(event.id)) {\n      duplicates += 1;\n      continue;\n    }\n    fresh.push(event);\n  }\n\n  // An imported file may itself carry a migration event; those are new by id and\n  // are appended like any other.\n  const withMigrations = [...fresh, ...migration.appended];\n\n  return {\n    ok: true,\n    outcome: {\n      newEvents: withMigrations,\n      duplicates,\n      totalInFile: migration.events.length,\n      headHashAfter: verification.headHash,\n      migratedFrom: version === SCHEMA_VERSION ? null : version,\n      schemaVersion: SCHEMA_VERSION,\n    },\n  };\n}\n\n/**\n * Re-seal imported events onto the LOCAL chain.\n *\n * An imported file's `prevHash` values point at ITS genesis. Appending them to a\n * non-empty local log would fork the chain, so the events are re-linked from the\n * local head. Their `id`s ΓÇö and therefore their deduplication behaviour ΓÇö are\n * preserved, which is what keeps double-import idempotent across a re-seal.\n *\n * The consequence is worth stating plainly: the local head hash after an import\n * is NOT the imported file's head hash, unless the local log was empty. The\n * round-trip guarantee (export -> import -> identical head) is about a file\n * travelling into an EMPTY log, or back into the log it came from.\n */\nexport function reseal(events: readonly AnyEvent[], localHeadHash: string): readonly AnyEvent[] {\n  const out: AnyEvent[] = [];\n  let prev = localHeadHash === \"\" ? GENESIS_HASH : localHeadHash;\n\n  for (const event of events) {\n    const resealed = { ...event, prevHash: prev } as AnyEvent;\n    out.push(resealed);\n    // Recomputed with the same link function the log uses, so the caller can\n    // verify the result without knowing the algorithm.\n    prev = linkOf(prev, resealed);\n  }\n\n  return out;\n}\n\nfunction linkOf(prev: string, event: AnyEvent): string {\n  return linkHash(prev, event);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeRejection(rejection: ImportRejection): string {\n  switch (rejection.reason) {\n    case \"not-json\":\n      return `That file is not valid JSON. ${rejection.detail}`;\n    case \"not-a-whylog-file\":\n      return `That is not a WhyLog log. ${rejection.detail}`;\n    case \"newer-schema\":\n      return `This file was written by a newer WhyLog (schema v${rejection.version}; this build reads v${SCHEMA_VERSION}). Update the app before importing.`;\n    case \"unsupported-schema\":\n      return `No migration path exists from schema v${rejection.version}.`;\n    case \"malformed-event\":\n      return `Event ${rejection.index + 1} is malformed: ${rejection.detail}. The file was not imported.`;\n    case \"chain-broken\":\n      return `The hash chain in this file is broken at event ${\n        (rejection.verification.firstBadIndex ?? 0) + 1\n      } of ${rejection.verification.eventCount}. It was refused rather than repaired: a log whose history can be rewritten cannot prove anything.`;\n    case \"head-hash-mismatch\":\n      return `The file's declared head hash (${rejection.expected.slice(0, 12)}ΓÇª) does not match its contents (${rejection.found.slice(0, 12)}ΓÇª). It has been edited or truncated.`;\n    default:\n      return \"Import failed.\";\n  }\n}\n\nexport function describeImportOutcome(outcome: ImportOutcome): string {\n  const parts = [\n    `${outcome.newEvents.length} new event${outcome.newEvents.length === 1 ? \"\" : \"s\"}`,\n  ];\n  if (outcome.duplicates > 0) {\n    parts.push(`${outcome.duplicates} already present (skipped)`);\n  }\n  if (outcome.migratedFrom !== null) {\n    parts.push(`migrated from schema v${outcome.migratedFrom}`);\n  }\n  return parts.join(\", \");\n}\n\n/** Stats for the export file, computed from a folded state. Kept here so the\n *  exporter cannot forget a field. */\nexport function statsFromCounts(counts: {\n  events: number;\n  decisions: number;\n  premises: number;\n  guards: number;\n  transcripts: number;\n}): PortableStats {\n  return counts;\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 19 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 19 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 19 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\portability.ts"},"span":[6672,6681],"sourceCode":"/**\n * Portability: export and import EVENTS, never state.\n *\n * Phase 0 ┬╖ sub-phase 0.6\n * Plan: plan/phase-0-foundation.md ┬º0.6\n *\n * ---------------------------------------------------------------------------\n * THE ONE RULE\n *\n * The portable artifact is the EVENT LOG. Not the graph, not the projections, not\n * the embeddings.\n *\n * Exporting state would freeze a derived cache into the wire format, and every\n * future change to a projection would become a breaking change to every file\n * anybody has on disk. Exporting events means an old file replays through the\n * current fold and picks up every improvement automatically ΓÇö which is the only\n * versioning story that survives a hackathon, let alone a product.\n *\n * ---------------------------------------------------------------------------\n * THE ROUND-TRIP GUARANTEE\n *\n *   export(log) -> import(json) -> identical head hash\n *\n * It holds because the hash chain is computed over `canonicalJson`, which sorts\n * object keys. Key insertion order therefore cannot change a hash, and a file\n * that travelled through JSON.stringify and JSON.parse comes back byte-identical\n * in the places that matter.\n *\n * ---------------------------------------------------------------------------\n * IMPORT IS A MERGE, NOT A REPLACE\n *\n * Events already present ΓÇö by id ΓÇö are skipped. The acceptance test is the sharp\n * one: IMPORT THE SAME FILE TWICE AND ZERO NEW NODES APPEAR. That works because\n * duplicate events are rejected here, and because identity resolution\n * (src/substrate/identity.ts) rejects duplicate nodes one layer up.\n *\n * A broken chain is REFUSED, not repaired. Repairing means rewriting history,\n * and a log whose history can be rewritten cannot prove anything.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { type Result, err, ok } from \"@/lib/result\";\nimport type { EngineId, EventId, ISODateString } from \"@/types/common\";\nimport type { AnyEvent } from \"@/types/events\";\nimport {\n  type ChainVerification,\n  GENESIS_HASH,\n  coerceEvent,\n  linkHash,\n  verifyChain,\n} from \"./hash-chain\";\nimport { SCHEMA_VERSION, canLoad, migrateEvents } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The wire format                                                            */\n/* -------------------------------------------------------------------------- */\n\nexport interface PortableStats {\n  readonly events: number;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly guards: number;\n  readonly transcripts: number;\n}\n\nexport interface PortableLog {\n  /** Bumped by src/substrate/schema.ts. An importer refuses a NEWER file rather\n   *  than guessing at it. */\n  readonly schemaVersion: number;\n  /** The whole log, in learned-time order, each event carrying its `prevHash`. */\n  readonly events: readonly AnyEvent[];\n  /** Head hash of `events`. Verified on import; a mismatch means the file was\n   *  edited or truncated in transit. */\n  readonly headHash: string;\n  readonly exportedAt: ISODateString;\n  readonly stats: PortableStats;\n  /** Which engine was active at export. Informational: the index is NOT in this\n   *  file, because vectors are derived data (sub-phase 0.8). */\n  readonly engine: EngineId;\n}\n\n/** What the file is called. Stable and boring, so a teammate recognises it. */\nexport const EXPORT_FILENAME = \"whylog.json\";\n\nexport const MAGIC = \"whylog/log\" as const;\nexport const FORMAT_VERSION = 1;\n\n/* -------------------------------------------------------------------------- */\n/* Export                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport function exportLog(\n  events: readonly AnyEvent[],\n  headHash: string,\n  stats: PortableStats,\n  engine: EngineId,\n  at: ISODateString = nowISO(),\n): Result<PortableLog, string> {\n  if (events.length > 0) {\n    const verification = verifyChain(events);\n    if (!verification.valid) {\n      // Refusing to export a broken chain is the point: the file is the artifact\n      // other people will trust, and a stamp on a broken log is a lie.\n      return err(\n        `Cannot export: the hash chain is broken at event ${\n          (verification.firstBadIndex ?? 0) + 1\n        }. ${verification.violations[0]?.message ?? \"\"}`,\n      );\n    }\n    if (verification.headHash !== headHash) {\n      return err(\n        `Cannot export: the stored head hash (${headHash.slice(0, 12)}ΓÇª) does not match the recomputed one (${verification.headHash.slice(0, 12)}ΓÇª).`,\n      );\n    }\n  }\n\n  return ok({\n    schemaVersion: SCHEMA_VERSION,\n    events,\n    headHash,\n    exportedAt: at,\n    stats,\n    engine,\n  });\n}\n\nexport function serializeLog(log: PortableLog): string {\n  return JSON.stringify(log, null, 2);\n}\n\n/** A single-line variant for clipboard copies and for the CI integrity check,\n *  where whitespace is noise. */\nexport function serializeCompact(log: PortableLog): string {\n  return JSON.stringify(log);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Import                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport type ImportRejection =\n  | { readonly reason: \"not-json\"; readonly detail: string }\n  | { readonly reason: \"not-a-whylog-file\"; readonly detail: string }\n  | { readonly reason: \"newer-schema\"; readonly version: number }\n  | { readonly reason: \"unsupported-schema\"; readonly version: number }\n  | { readonly reason: \"malformed-event\"; readonly index: number; readonly detail: string }\n  | { readonly reason: \"chain-broken\"; readonly verification: ChainVerification }\n  | { readonly reason: \"head-hash-mismatch\"; readonly expected: string; readonly found: string };\n\nexport interface ImportOutcome {\n  /** Events to append, already sealed and already deduplicated. */\n  readonly newEvents: readonly AnyEvent[];\n  /** Events skipped because the log already contains them. */\n  readonly duplicates: number;\n  readonly totalInFile: number;\n  readonly headHashAfter: string;\n  readonly migratedFrom: number | null;\n  readonly schemaVersion: number;\n}\n\nexport type ImportResult =\n  | { readonly ok: true; readonly outcome: ImportOutcome }\n  | { readonly ok: false; readonly rejection: ImportRejection };\n\n/**\n * Parse, verify and merge an imported file.\n *\n * `existingIds` is the set of ids already in the local log; pass null to accept\n * everything (used when importing into an empty log).\n */\nexport function importLog(\n  raw: string,\n  options: {\n    readonly existingIds: ReadonlySet<EventId> | null;\n    readonly existingHeadHash: string;\n  },\n): ImportResult {\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(raw);\n  } catch (error) {\n    return { ok: false, rejection: { reason: \"not-json\", detail: String(error) } };\n  }\n\n  if (typeof parsed !== \"object\" || parsed === null) {\n    return {\n      ok: false,\n      rejection: { reason: \"not-a-whylog-file\", detail: \"the file is not a JSON object\" },\n    };\n  }\n\n  const candidate = parsed as Record<string, unknown>;\n  if (!Array.isArray(candidate[\"events\"])) {\n    return {\n      ok: false,\n      rejection: {\n        reason: \"not-a-whylog-file\",\n        detail: \"no `events` array ΓÇö a WhyLog file carries events, not a materialised graph\",\n      },\n    };\n  }\n\n  const version =\n    typeof candidate[\"schemaVersion\"] === \"number\" ? candidate[\"schemaVersion\"] : SCHEMA_VERSION;\n\n  if (version > SCHEMA_VERSION) {\n    return { ok: false, rejection: { reason: \"newer-schema\", version } };\n  }\n  if (!canLoad(version)) {\n    return { ok: false, rejection: { reason: \"unsupported-schema\", version } };\n  }\n\n  /* ---- coerce every event, refusing the file on the first bad one ---- */\n  const coerced: AnyEvent[] = [];\n  for (let i = 0; i < candidate[\"events\"].length; i += 1) {\n    const result = coerceEvent(candidate[\"events\"][i]);\n    if (!result.ok) {\n      return {\n        ok: false,\n        rejection: { reason: \"malformed-event\", index: i, detail: result.reason },\n      };\n    }\n    coerced.push(result.event);\n  }\n\n  /* ---- migrate if needed. Migrations APPEND events; they never rewrite. ---- */\n  const migration = migrateEvents(coerced, version);\n  if (!migration.ok) {\n    return {\n      ok: false,\n      rejection: { reason: \"unsupported-schema\", version },\n    };\n  }\n\n  /* ---- verify the chain over the WHOLE file ---- */\n  const verification = verifyChain(migration.events);\n  if (!verification.valid) {\n    return { ok: false, rejection: { reason: \"chain-broken\", verification } };\n  }\n\n  const declaredHead = typeof candidate[\"headHash\"] === \"string\" ? candidate[\"headHash\"] : null;\n  if (declaredHead !== null && declaredHead !== verification.headHash) {\n    return {\n      ok: false,\n      rejection: {\n        reason: \"head-hash-mismatch\",\n        expected: declaredHead,\n        found: verification.headHash,\n      },\n    };\n  }\n\n  /* ---- deduplicate against the local log ---- */\n  const fresh: AnyEvent[] = [];\n  let duplicates = 0;\n\n  for (const event of migration.events) {\n    if (options.existingIds?.has(event.id)) {\n      duplicates += 1;\n      continue;\n    }\n    fresh.push(event);\n  }\n\n  // An imported file may itself carry a migration event; those are new by id and\n  // are appended like any other.\n  const withMigrations = [...fresh, ...migration.appended];\n\n  return {\n    ok: true,\n    outcome: {\n      newEvents: withMigrations,\n      duplicates,\n      totalInFile: migration.events.length,\n      headHashAfter: verification.headHash,\n      migratedFrom: version === SCHEMA_VERSION ? null : version,\n      schemaVersion: SCHEMA_VERSION,\n    },\n  };\n}\n\n/**\n * Re-seal imported events onto the LOCAL chain.\n *\n * An imported file's `prevHash` values point at ITS genesis. Appending them to a\n * non-empty local log would fork the chain, so the events are re-linked from the\n * local head. Their `id`s ΓÇö and therefore their deduplication behaviour ΓÇö are\n * preserved, which is what keeps double-import idempotent across a re-seal.\n *\n * The consequence is worth stating plainly: the local head hash after an import\n * is NOT the imported file's head hash, unless the local log was empty. The\n * round-trip guarantee (export -> import -> identical head) is about a file\n * travelling into an EMPTY log, or back into the log it came from.\n */\nexport function reseal(events: readonly AnyEvent[], localHeadHash: string): readonly AnyEvent[] {\n  const out: AnyEvent[] = [];\n  let prev = localHeadHash === \"\" ? GENESIS_HASH : localHeadHash;\n\n  for (const event of events) {\n    const resealed = { ...event, prevHash: prev } as AnyEvent;\n    out.push(resealed);\n    // Recomputed with the same link function the log uses, so the caller can\n    // verify the result without knowing the algorithm.\n    prev = linkOf(prev, resealed);\n  }\n\n  return out;\n}\n\nfunction linkOf(prev: string, event: AnyEvent): string {\n  return linkHash(prev, event);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeRejection(rejection: ImportRejection): string {\n  switch (rejection.reason) {\n    case \"not-json\":\n      return `That file is not valid JSON. ${rejection.detail}`;\n    case \"not-a-whylog-file\":\n      return `That is not a WhyLog log. ${rejection.detail}`;\n    case \"newer-schema\":\n      return `This file was written by a newer WhyLog (schema v${rejection.version}; this build reads v${SCHEMA_VERSION}). Update the app before importing.`;\n    case \"unsupported-schema\":\n      return `No migration path exists from schema v${rejection.version}.`;\n    case \"malformed-event\":\n      return `Event ${rejection.index + 1} is malformed: ${rejection.detail}. The file was not imported.`;\n    case \"chain-broken\":\n      return `The hash chain in this file is broken at event ${\n        (rejection.verification.firstBadIndex ?? 0) + 1\n      } of ${rejection.verification.eventCount}. It was refused rather than repaired: a log whose history can be rewritten cannot prove anything.`;\n    case \"head-hash-mismatch\":\n      return `The file's declared head hash (${rejection.expected.slice(0, 12)}ΓÇª) does not match its contents (${rejection.found.slice(0, 12)}ΓÇª). It has been edited or truncated.`;\n    default:\n      return \"Import failed.\";\n  }\n}\n\nexport function describeImportOutcome(outcome: ImportOutcome): string {\n  const parts = [\n    `${outcome.newEvents.length} new event${outcome.newEvents.length === 1 ? \"\" : \"s\"}`,\n  ];\n  if (outcome.duplicates > 0) {\n    parts.push(`${outcome.duplicates} already present (skipped)`);\n  }\n  if (outcome.migratedFrom !== null) {\n    parts.push(`migrated from schema v${outcome.migratedFrom}`);\n  }\n  return parts.join(\", \");\n}\n\n/** Stats for the export file, computed from a folded state. Kept here so the\n *  exporter cannot forget a field. */\nexport function statsFromCounts(counts: {\n  events: number;\n  decisions: number;\n  premises: number;\n  guards: number;\n  transcripts: number;\n}): PortableStats {\n  return counts;\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 20 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 20 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 20 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\projections\\premises.ts"},"span":[4859,4869],"sourceCode":"/**\n * Premise projection.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n *\n * ---------------------------------------------------------------------------\n * INVARIANT I2 ΓÇö PREMISES ARE SHARED NODES\n *\n * A premise is not a property of a decision. \"It's one person, one machine, one\n * log\" is ONE node that three decisions rest on, and when it dies all three are\n * affected at once. That sharing is the entire mechanism behind the cascade, and\n * it is why this projection is indexed premise -> decisions rather than the other\n * way round.\n *\n * The read side here is where gate (c) looks: which premises are world-observable\n * and therefore falsifiable by a guard, and which decisions would fall if one of\n * them died.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, ISODateString, PremiseId } from \"@/types/common\";\nimport { type Decision, type Premise, type PremiseType, isWorldObservable } from \"@/types/domain\";\nimport { byIdAsc, byTemporalValidDesc, compare, isOpen } from \"../bi-temporal\";\nimport type { GraphState } from \"../graph-state\";\n\nconst BY_VALID_TIME = compare(byTemporalValidDesc, byIdAsc);\n\nexport function getPremise(state: GraphState, id: PremiseId): Premise | null {\n  return state.premises.get(id) ?? null;\n}\n\nexport function allPremises(state: GraphState): readonly Premise[] {\n  return [...state.premises.values()].sort(BY_VALID_TIME);\n}\n\nexport function openPremises(state: GraphState): readonly Premise[] {\n  return allPremises(state).filter((p) => isOpen(p.temporal));\n}\n\n/** Invalidated premises, newest death first. This is the \"reality moved\" list,\n *  and it is the view that makes WhyLog different from a memory tool: it shows\n *  what stopped being true, not just what was said. */\nexport function deadPremises(state: GraphState): readonly Premise[] {\n  return allPremises(state)\n    .filter((p) => !isOpen(p.temporal))\n    .sort((a, b) => {\n      const ai = a.temporal.invalidFrom ?? \"\";\n      const bi = b.temporal.invalidFrom ?? \"\";\n      if (ai === bi) return 0;\n      return ai < bi ? 1 : -1;\n    });\n}\n\nexport function premisesByType(state: GraphState, type: PremiseType): readonly Premise[] {\n  return allPremises(state).filter((p) => p.type === type);\n}\n\n/**\n * Premises a guard or repo scan could falsify.\n *\n * Phase 4 only synthesises guards for these. There is no point checking `budget`:\n * no file in the repository records it, so any check would either always pass\n * (useless) or always fail (noise).\n */\nexport function worldObservablePremises(state: GraphState): readonly Premise[] {\n  return openPremises(state).filter((p) => isWorldObservable(p.type));\n}\n\n/** Premises only a human can retract. Shown in the review UI with an explicit\n *  \"is this still true?\" prompt, because nothing else will ever tell us. */\nexport function intentBasedPremises(state: GraphState): readonly Premise[] {\n  return openPremises(state).filter((p) => !isWorldObservable(p.type));\n}\n\n/** Premises still awaiting confirmation. */\nexport function pendingPremises(state: GraphState): readonly Premise[] {\n  const out: Premise[] = [];\n  for (const id of state.pendingPremises) {\n    const premise = state.premises.get(id);\n    if (premise) out.push(premise);\n  }\n  return out.sort(BY_VALID_TIME);\n}\n\n/**\n * Load-bearing premises: those that more than one decision rests on.\n *\n * Sorted by blast radius. This is the list to review first, because invalidating\n * the top entry changes the most, and it is the honest answer to \"which of my\n * assumptions matter?\".\n */\nexport function loadBearingPremises(state: GraphState): readonly {\n  premise: Premise;\n  decisions: readonly DecisionId[];\n}[] {\n  const out: { premise: Premise; decisions: readonly DecisionId[] }[] = [];\n\n  for (const [premiseId, decisionIds] of state.premiseToDecisions) {\n    if (decisionIds.length < 2) continue;\n    const premise = state.premises.get(premiseId);\n    if (!premise || !isOpen(premise.temporal)) continue;\n    out.push({ premise, decisions: decisionIds });\n  }\n\n  out.sort((a, b) => b.decisions.length - a.decisions.length || byIdAsc(a.premise, b.premise));\n  return out;\n}\n\n/** Decisions resting on a premise. O(1) lookup, materialised by the fold. */\nexport function dependentsOf(state: GraphState, premiseId: PremiseId): readonly DecisionId[] {\n  return state.premiseToDecisions.get(premiseId) ?? [];\n}\n\nexport function dependentDecisions(state: GraphState, premiseId: PremiseId): readonly Decision[] {\n  const out: Decision[] = [];\n  for (const id of dependentsOf(state, premiseId)) {\n    const decision = state.decisions.get(id);\n    if (decision) out.push(decision);\n  }\n  return out.sort(BY_VALID_TIME);\n}\n\n/** Premises a decision rests on, split the way Doyle's justification does.\n *  The OUT-list is the excluded condition, and it is the half nobody extracts. */\nexport function premisesOf(\n  state: GraphState,\n  decisionId: DecisionId,\n): { inList: readonly Premise[]; outList: readonly Premise[] } {\n  const inList: Premise[] = [];\n  const outList: Premise[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of state.decisions.get(decisionId)?.justificationIds ?? []) {\n    const justification = state.justifications.get(justificationId);\n    if (!justification) continue;\n\n    for (const id of justification.inList) {\n      if (seen.has(id)) continue;\n      seen.add(id);\n      const premise = state.premises.get(id);\n      if (premise) inList.push(premise);\n    }\n    for (const id of justification.outList) {\n      if (seen.has(id)) continue;\n      seen.add(id);\n      const premise = state.premises.get(id);\n      if (premise) outList.push(premise);\n    }\n  }\n\n  return {\n    inList: inList.sort(byIdAsc),\n    outList: outList.sort(byIdAsc),\n  };\n}\n\n/** Premises with more than one independent observation. Corroboration is the\n *  term in entrenchment that a single transcript cannot inflate. */\nexport function corroboratedPremises(state: GraphState, minReferences = 2): readonly Premise[] {\n  return allPremises(state).filter(\n    (p) => (state.premiseToDecisions.get(p.id)?.length ?? 0) >= minReferences,\n  );\n}\n\n/** Premises whose evidence disagrees with itself ΓÇö one observation supporting and\n *  one refuting. The system's own uncertainty, surfaced rather than averaged\n *  away. */\nexport function contestedPremises(state: GraphState): readonly Premise[] {\n  return allPremises(state).filter((p) => {\n    let supporting = 0;\n    let refuting = 0;\n    for (const evidence of p.evidence) {\n      if (evidence.supports) supporting += 1;\n      else refuting += 1;\n    }\n    return supporting > 0 && refuting > 0;\n  });\n}\n\n/** What was true at a given VALID time. */\nexport function premisesAsOf(state: GraphState, at: ISODateString): readonly Premise[] {\n  return allPremises(state).filter((p) => {\n    if (p.temporal.valid > at) return false;\n    if (p.temporal.invalidFrom !== undefined && p.temporal.invalidFrom <= at) return false;\n    return true;\n  });\n}\n\nexport function describePremise(premise: Premise): string {\n  const value = premise.value === undefined ? \"\" : ` = ${String(premise.value)}`;\n  return `${premise.id} [${premise.label}] ${premise.predicate}${value} ΓÇö \"${premise.text}\"`;\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Schema versioning and migration.\n *export function readSchemaVersion(raw: unknown, fallback: number): number {\n  if (typeof raw !== \"object\" || raw === null) return fallback;\n  const value = (raw as Record<string, unknown>)[\".schemaVersion\"];\n  return typeof value === \"number\" && Number.isInteger(value) ? value : fallback;\n}\n","ops":[{"diffOp":{"equal":{"range":[0,42]}}},{"equalLines":{"line_count":167}},{"diffOp":{"equal":{"range":[42,198]}}},{"diffOp":{"equal":{"range":[198,230]}}},{"diffOp":{"delete":{"range":[230,232]}}},{"diffOp":{"insert":{"range":[232,233]}}},{"diffOp":{"equal":{"range":[233,246]}}},{"diffOp":{"delete":{"range":[246,248]}}},{"diffOp":{"equal":{"range":[248,334]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\schema.ts"},"span":[5502,5517],"sourceCode":"/**\n * Schema versioning and migration.\n *\n * Phase 0 ┬╖ sub-phase 0.6\n * Plan: plan/phase-0-foundation.md ┬º0.6\n *\n * ---------------------------------------------------------------------------\n * THE POLICY\n *\n * Migrations never rewrite history. A migration is itself an EVENT\n * (`SchemaMigrated`) appended to the log, carrying the from/to versions. That\n * keeps the hash chain intact across an upgrade ΓÇö rewriting old events would\n * invalidate every hash after the change, which would destroy the one property\n * the chain exists to provide.\n *\n * Consequence: `applyEvent` must tolerate OLD payload shapes forever. Every\n * projector reads defensively. That cost is deliberate and is the price of an\n * append-only log that outlives its schema.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport type { AnyEvent } from \"@/types/events\";\n\n/** Current schema version. Bump when a payload shape changes incompatibly. */\nexport const SCHEMA_VERSION = 1;\n\n/** Every version this build knows how to read. */\nexport const KNOWN_SCHEMA_VERSIONS: readonly number[] = [1];\n\n/** Persistence key. Versioned in the KEY as well, so a v2 build can coexist\n *  with a v1 install in the same browser during development. */\nexport const STORAGE_KEY = \"whylog:v1\";\n\n/** Key for the derived embedding index, which is deliberately NOT in the log. */\nexport const INDEX_STORAGE_KEY = \"whylog:index:v1\";\n\n/** Key for engine configuration (API keys live here and nowhere else). */\nexport const CONFIG_STORAGE_KEY = \"whylog:config:v1\";\n\nexport type MigrationStep = (events: readonly AnyEvent[]) => readonly AnyEvent[];\n\nexport interface Migration {\n  readonly from: number;\n  readonly to: number;\n  readonly description: string;\n  /** Transform the event array. Must NOT alter existing events in place ΓÇö\n   *  return a new array, appending any new events at the end. */\n  readonly migrate: MigrationStep;\n}\n\n/**\n * The migration table. Empty at v1 by design: there is nothing to migrate yet,\n * and an empty table is the honest state. Each entry must be pure and must be\n * accompanied by a fixture in tests/integration (Phase 0.6).\n */\nexport const MIGRATIONS: readonly Migration[] = [];\n\nexport interface MigrationOutcome {\n  readonly ok: boolean;\n  readonly fromVersion: number;\n  readonly toVersion: number;\n  readonly events: readonly AnyEvent[];\n  /** Migration events to append, in order. */\n  readonly appended: readonly AnyEvent[];\n  readonly reason?: string;\n}\n\n/** Latest version reachable from `from` by following the table. */\nexport function reachableVersion(from: number): number {\n  let current = from;\n  const visited = new Set<number>([current]);\n\n  for (;;) {\n    const step = MIGRATIONS.find((m) => m.from === current);\n    if (!step) break;\n    if (visited.has(step.to)) break; // cycle guard\n    visited.add(step.to);\n    current = step.to;\n  }\n\n  return current;\n}\n\n/** Can a log at `version` be loaded by this build? */\nexport function canLoad(version: number): boolean {\n  if (KNOWN_SCHEMA_VERSIONS.includes(version)) return true;\n  return reachableVersion(version) === SCHEMA_VERSION;\n}\n\n/**\n * Migrate an imported event array up to the current schema.\n *\n * Returns the transformed events plus the `SchemaMigrated` payloads to append.\n * The CALLER appends them, because appending requires sealing with the current\n * head hash and only the event log knows that.\n */\nexport function migrateEvents(events: readonly AnyEvent[], fromVersion: number): MigrationOutcome {\n  if (fromVersion === SCHEMA_VERSION) {\n    return {\n      ok: true,\n      fromVersion,\n      toVersion: SCHEMA_VERSION,\n      events,\n      appended: [],\n    };\n  }\n\n  if (fromVersion > SCHEMA_VERSION) {\n    return {\n      ok: false,\n      fromVersion,\n      toVersion: SCHEMA_VERSION,\n      events,\n      appended: [],\n      reason: `This log was written by a newer version of WhyLog (schema v${fromVersion}). Update the app before importing.`,\n    };\n  }\n\n  let current = events;\n  let version = fromVersion;\n  const appended: AnyEvent[] = [];\n  const visited = new Set<number>([version]);\n\n  while (version < SCHEMA_VERSION) {\n    const step = MIGRATIONS.find((m) => m.from === version);\n    if (!step) {\n      return {\n        ok: false,\n        fromVersion,\n        toVersion: SCHEMA_VERSION,\n        events: current,\n        appended,\n        reason: `No migration path from schema v${version} to v${SCHEMA_VERSION}.`,\n      };\n    }\n    if (visited.has(step.to)) {\n      return {\n        ok: false,\n        fromVersion,\n        toVersion: SCHEMA_VERSION,\n        events: current,\n        appended,\n        reason: `Migration cycle detected at schema v${version}.`,\n      };\n    }\n    visited.add(step.to);\n\n    current = step.migrate(current);\n    version = step.to;\n  }\n\n  return { ok: true, fromVersion, toVersion: version, events: current, appended };\n}\n\n/** Build the `SchemaMigrated` payload for a completed upgrade. */\nexport function schemaMigratedPayload(\n  from: number,\n  to: number,\n  description: string,\n): {\n  fromVersion: number;\n  toVersion: number;\n  description: string;\n  at: string;\n} {\n  return { fromVersion: from, toVersion: to, description, at: nowISO() };\n}\n\n/** Read a schema version off an untyped imported object. */\nexport function readSchemaVersion(raw: unknown, fallback: number): number {\n  if (typeof raw !== \"object\" || raw === null) return fallback;\n  const value = (raw as Record<string, unknown>)[\"schemaVersion\"];\n  return typeof value === \"number\" && Number.isInteger(value) ? value : fallback;\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\theme.ts"},"span":[6451,6471],"sourceCode":"/**\n * The visual language.\n *\n * Phase 6 ┬╖ authored in Phase 0 so every component reads one source\n * Plan: plan/phase-6-presentation.md ┬º6.0\n *\n * ---------------------------------------------------------------------------\n * THE RULE: COLOUR ENCODES EPISTEMIC STATUS, NEVER SEVERITY\n *\n * A red badge in most tools means \"bad\". In WhyLog it would be ambiguous, because\n * three different things need to look different and none of them is an error:\n *\n *   IN          the decision is supported by at least one valid justification\n *   OUT         every justification failed ΓÇö RETRACTED, not wrong, not deleted\n *   UNKNOWN     the premises are neither confirmed nor refuted\n *   UNFOUNDED   a DATA-QUALITY warning: the justification chain never reaches a\n *               premise. Not a truth claim, and it must not look like one.\n *\n * So: green for supported, slate for retracted (present, closed, at rest ΓÇö not\n * alarming), amber for unknown, and a distinct violet for unfounded, because\n * \"we could not ground this\" is a different kind of statement from \"we are not\n * sure yet\". Red is reserved for ONE thing: a decision that is currently being\n * contradicted or is drifting, i.e. an action is available.\n *\n * Anything that recolours a label by \"importance\" breaks this file's contract.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionLabel, DecisionStatus } from \"@/types/domain\";\n\nexport const LABEL_COLOUR: Readonly<Record<DecisionLabel, string>> = {\n  IN: \"var(--label-in)\",\n  OUT: \"var(--label-out)\",\n  UNKNOWN: \"var(--label-unknown)\",\n  UNFOUNDED: \"var(--label-unfounded)\",\n};\n\nexport const LABEL_BACKGROUND: Readonly<Record<DecisionLabel, string>> = {\n  IN: \"var(--label-in-bg)\",\n  OUT: \"var(--label-out-bg)\",\n  UNKNOWN: \"var(--label-unknown-bg)\",\n  UNFOUNDED: \"var(--label-unfounded-bg)\",\n};\n\nexport const LABEL_MEANING: Readonly<Record<DecisionLabel, string>> = {\n  IN: \"Supported ΓÇö at least one justification is valid. IN does not mean TRUE; it means the decision currently rests on something.\",\n  OUT: \"Retracted ΓÇö every justification failed. Kept, never deleted, and still searchable.\",\n  UNKNOWN: \"Unresolved ΓÇö the premises are neither confirmed nor refuted.\",\n  UNFOUNDED:\n    \"Data-quality warning ΓÇö the justification chain never reaches a premise node. Not a claim that the decision is wrong.\",\n};\n\nexport const STATUS_COLOUR: Readonly<Record<DecisionStatus, string>> = {\n  proposed: \"var(--status-proposed)\",\n  active: \"var(--status-active)\",\n  contested: \"var(--status-contested)\",\n  superseded: \"var(--status-superseded)\",\n  archived: \"var(--status-archived)\",\n};\n\nexport const STATUS_MEANING: Readonly<Record<DecisionStatus, string>> = {\n  proposed: \"Extracted, awaiting your review. Not yet part of the graph's conclusions.\",\n  active: \"Approved and live.\",\n  contested:\n    \"Screened out by non-prioritized revision: the new information could not outrank what it contradicts. Waiting for you, never silently applied.\",\n  superseded:\n    \"Replaced by a later decision on the same variable. Excluded from exports by default.\",\n  archived: \"Rejected or closed out. Retained for the audit trail.\",\n};\n\n/** The four edge kinds the lattice draws, in four different styles. A cascade\n *  path and a conflict must never look alike: one propagates, one does not. */\nexport const EDGE_STYLE = {\n  sharesPremiseWith: {\n    stroke: \"var(--edge-cascade)\",\n    width: 2,\n    dash: \"\",\n    label: \"shares a premise ΓÇö CASCADE PATH\",\n  },\n  dependsOn: {\n    stroke: \"var(--edge-cascade)\",\n    width: 2,\n    dash: \"\",\n    label: \"depends on ΓÇö CASCADE PATH\",\n  },\n  conflictsWith: {\n    stroke: \"var(--edge-conflict)\",\n    width: 1.5,\n    dash: \"5 3\",\n    label: \"conflicts ΓÇö never a cascade path\",\n  },\n  supersedes: { stroke: \"var(--edge-supersede)\", width: 1.5, dash: \"2 3\", label: \"supersedes\" },\n  supersededBy: {\n    stroke: \"var(--edge-supersede)\",\n    width: 1.5,\n    dash: \"2 3\",\n    label: \"superseded by\",\n  },\n  related: {\n    stroke: \"var(--edge-related)\",\n    width: 1,\n    dash: \"1 4\",\n    label: \"topically related ΓÇö logically compatible\",\n  },\n} as const;\n\n/** Premise-type columns in the lattice. Fixed order so the layout is stable\n *  across renders and screenshots. */\nexport const PREMISE_COLUMN_ORDER = [\n  \"scale\",\n  \"deployment\",\n  \"capability\",\n  \"external\",\n  \"team\",\n  \"budget\",\n  \"time\",\n  \"requirement\",\n] as const;\n\n/** World-observable types are drawn with a solid ring (a guard could check them);\n *  intent-based types with a dashed one (only a human can retract them). */\nexport const PREMISE_RING: Readonly<Record<string, string>> = {\n  scale: \"solid\",\n  deployment: \"solid\",\n  capability: \"solid\",\n  external: \"solid\",\n  team: \"dashed\",\n  budget: \"dashed\",\n  time: \"dashed\",\n  requirement: \"dashed\",\n};\n\n/** The mode badge. It says what is running BEFORE you act, not after. */\nexport const MODE_BADGE = {\n  local: {\n    label: \"local engine\",\n    colour: \"var(--mode-local)\",\n    meaning: \"Deterministic, offline, no API key. Nothing leaves this browser.\",\n  },\n  llm: {\n    label: \"llm engine\",\n    colour: \"var(--mode-llm)\",\n    meaning:\n      \"Your transcript is sent to the configured provider. Every produced node is stamped with this engine.\",\n  },\n  stale: {\n    label: \"index stale\",\n    colour: \"var(--mode-stale)\",\n    meaning:\n      \"Semantic retrieval is disabled: the stored vectors came from a different embedding space.\",\n  },\n  unavailable: {\n    label: \"no engine\",\n    colour: \"var(--mode-stale)\",\n    meaning: \"No engine could be constructed. The log, graph and exports still work.\",\n  },\n} as const;\n\n/** Confidence is drawn as a bar, never as a colour. A low-confidence extraction\n *  is not \"red\"; it is short, and the review UI is built around rejecting it fast\n *  because false positives outnumber false negatives roughly 13:1. */\nexport function confidenceWidth(confidence: number): string {\n  return `${Math.round(Math.max(0, Math.min(1, confidence)) * 100)}%`;\n}\n\nexport const CONFIDENCE_TIERS = [\n  { min: 0.85, label: \"high\", action: \"pre-expanded in the review queue\" },\n  { min: 0.6, label: \"medium\", action: \"collapsed, one click to expand\" },\n  { min: 0, label: \"low\", action: \"grouped, reject-all in one click\" },\n] as const;\n\nexport function confidenceTier(confidence: number): (typeof CONFIDENCE_TIERS)[number] {\n  return CONFIDENCE_TIERS.find((tier) => confidence >= tier.min) ?? CONFIDENCE_TIERS[2]!;\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 18 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 18 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 18 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\HealthView.tsx"},"span":[2212,2222],"sourceCode":"/**\n * The health view ΓÇö 6.4.\n *\n * Phase 6 ┬╖ sub-phase 6.4\n * Plan: plan/phase-6-presentation.md ┬º6.4\n *\n * ---------------------------------------------------------------------------\n * SIX NUMBERS THAT SAY WHETHER THE LOG IS TRUSTWORTHY\n *\n * Each has a one-line plain-language gloss, because a metric without a gloss is a number the user\n * cannot act on and eventually stops reading. The glosses are written as sentences a person would\n * say, not as definitions ΓÇö \"your codebase has quietly stopped believing 3 of your 12 decisions\"\n * rather than \"compliance = 0.75\".\n *\n * ---------------------------------------------------------------------------\n * THE AGENCY RATIO IS THE ONE NOBODY ELSE CAN COMPUTE\n *\n * It needs origin classification, which needs Phase 1 to have distinguished `human_stated` from\n * `agent_proposed` from `agent_inferred` on every node. No tool that does not classify decision\n * origin can produce it, and it is a small, sticky, genuinely interesting number: \"you have\n * overridden your agent 4 times in 19 decisions.\"\n *\n * ---------------------------------------------------------------------------\n * PAIRS THAT MUST NOT BE SHOWN APART\n *\n * Compliance without coverage flatters itself ΓÇö a log with one passing guard scores 100%. Soundness\n * without compliance misses that the code has drifted from a log that still supports itself. So the\n * six are rendered as a set with their denominators visible, and the two guard metrics share a card.\n * ---------------------------------------------------------------------------\n */\n\nimport { EmptyState } from \"@/components/common\";\nimport {\n  compliance as complianceOf,\n  coverage as coverageOf,\n  describeDrift,\n  deterministicRatio,\n  driftAge,\n  evaluatedFromState,\n  soundness as soundnessOf,\n} from \"@/guards\";\nimport { bar } from \"@/guards/metrics/compliance\";\nimport { type Labelled, type NodeId, label as labelGraph } from \"@/reasoning/labeller\";\nimport { useExport } from \"@/store/export\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId } from \"@/types/common\";\nimport { type ReactElement, useMemo } from \"react\";\n\nexport function HealthView(): ReactElement {\n  const whylog = useWhyLog();\n  const exportStore = useExport();\n\n  const labels = useMemo(() => labelGraph(whylog.state).labels, [whylog.state]);\n\n  const metrics = useMemo(() => {\n    const evaluated = evaluatedFromState(whylog.state);\n    const guardToDecision = new Map<string, DecisionId>();\n    for (const guard of whylog.state.guards.values())\n      guardToDecision.set(guard.id, guard.decisionId);\n\n    return {\n      compliance: complianceOf(evaluated, labels, guardToDecision),\n      coverage: coverageOf(whylog.state, labels, []),\n      soundness: soundnessOf(whylog.state, labels),\n      drift: driftAge(whylog.state, Date.now()),\n      ratio: deterministicRatio(whylog.state),\n    };\n  }, [whylog.state, labels]);\n\n  const agency = useMemo(() => agencyRatio(whylog.state), [whylog.state]);\n  const contention = useMemo(() => premiseContention(whylog.state, labels), [whylog.state, labels]);\n\n  if (whylog.state.decisions.size === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Health</h2>\n        <EmptyState\n          title=\"No log to assess\"\n          what=\"These six numbers describe whether a decision log is trustworthy. With no decisions there is nothing to measure, and every metric would read as a misleading zero.\"\n          action=\"Import a transcript on the Import & review tab. The demo fixture is enough to see all six compute.\"\n        />\n      </section>\n    );\n  }\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 16 }}>\n      <section className=\"card\">\n        <h2 className=\"card-title\">Six numbers</h2>\n\n        <MetricRow\n          name=\"Decision Compliance\"\n          value={metrics.compliance.score}\n          fraction={`${metrics.compliance.compliant} / ${metrics.compliance.denominator}`}\n          gloss={\n            metrics.compliance.denominator === 0\n              ? \"Nothing to measure yet: no IN decision has an accepted deterministic guard. Synthesise and accept guards and this becomes the headline number.\"\n              : metrics.compliance.denominator - metrics.compliance.compliant === 0\n                ? \"Every checkable decision holds. The code still does what the log says it does.\"\n                : `Your codebase has quietly stopped believing ${metrics.compliance.denominator - metrics.compliance.compliant} of ${metrics.compliance.denominator} checkable decisions.`\n          }\n        />\n\n        <MetricRow\n          name=\"Verifiable Coverage\"\n          value={metrics.coverage.score}\n          fraction={`${metrics.coverage.covered} / ${metrics.coverage.inDecisions}`}\n          gloss={\n            metrics.coverage.score < 0.5\n              ? \"Most of the log is unfalsifiable prose ΓÇö nothing would tell you if these decisions stopped holding. Shown next to compliance on purpose: compliance without coverage is a score that flatters itself.\"\n              : `${\n                  metrics.coverage.inDecisions - metrics.coverage.covered\n                } IN decision(s) have no accepted guard.`\n          }\n        />\n\n        <MetricRow\n          name=\"Log Soundness\"\n          value={metrics.soundness.score}\n          fraction={`${metrics.soundness.inCount} / ${metrics.soundness.denominator}`}\n          gloss={\n            \"How much of what you believe is still supported by its premises. The truth-maintenance counterpart to compliance: a log can be perfectly compliant and unsound ΓÇö every guard passing while half the decisions rest on premises that went OUT.\"\n          }\n        />\n\n        <MetricRow\n          name=\"Premise Contention\"\n          value={contention.score}\n          fraction={`${contention.contested + contention.out} / ${contention.total}`}\n          gloss={\n            contention.contested + contention.out === 0\n              ? \"No premise is contested or falsified. The ground has not shifted since these decisions were made.\"\n              : `How much of the ground has shifted: ${contention.contested} contested and ${contention.out} falsified premise(s). Each one is a decision that may no longer be justified.`\n          }\n          inverted\n        />\n\n        <MetricRow\n          name=\"Agency Ratio\"\n          value={agency.score}\n          fraction={`${agency.overridden} overridden / ${agency.total}`}\n          gloss={agency.gloss}\n        />\n\n        <MetricRow\n          name=\"Drift Age (worst)\"\n          value={metrics.drift.worstDays === 0 ? 0 : Math.min(1, metrics.drift.worstDays / 30)}\n          fraction={\n            metrics.drift.worst === null\n              ? \"none\"\n              : `${metrics.drift.worstDays} days ┬╖ ${metrics.drift.worst.decisionId}`\n          }\n          gloss={\n            metrics.drift.worst === null\n              ? \"No unresolved guard failures, so nothing is drifting.\"\n              : \"How long you have been ignoring a disagreement between the log and the code. A failure left for 30 days is a decision you no longer hold.\"\n          }\n          inverted\n        />\n\n        <MetricRow\n          name=\"Deterministic Ratio\"\n          value={metrics.ratio.score}\n          fraction={`${metrics.ratio.deterministic} / ${metrics.ratio.total}`}\n          gloss={\n            metrics.ratio.total === 0\n              ? \"No accepted guards yet.\"\n              : \"How much of your verification is trustworthy without a model. At 100% the whole loop ΓÇö synthesis, evaluation, compliance, drift and the revision a failure triggers ΓÇö runs keyless and reproduces exactly. This is the direct answer to 'is this an LLM wrapper?'.\"\n          }\n        />\n      </section>\n\n      <section className=\"card\">\n        <h2 className=\"card-title\">Drift</h2>\n        <pre className=\"mono dim\" style={{ whiteSpace: \"pre-wrap\", margin: 0, fontSize: 11.5 }}>\n          {describeDrift(metrics.drift)}\n        </pre>\n      </section>\n\n      <section className=\"card\">\n        <h2 className=\"card-title\">Integrity</h2>\n\n        <div style={{ display: \"flex\", flexDirection: \"column\", gap: 8, fontSize: 12 }}>\n          <IntegrityRow\n            ok={whylog.status !== \"degraded\"}\n            label=\"Hash chain\"\n            detail={\n              whylog.status === \"degraded\"\n                ? \"BROKEN ΓÇö the log is read-only. Every event is chained to its predecessor, so a broken chain means an event was altered or removed, and nothing appended since can be trusted.\"\n                : `Verified. ${whylog.log.events.length} event(s), head ${whylog.log.headHash.slice(0, 12) || \"empty\"}. Every event is chained to its predecessor, so an alteration anywhere downstream invalidates the head.`\n            }\n          />\n\n          <IntegrityRow\n            ok={whylog.verification === null || whylog.verification.valid}\n            label=\"Last verification\"\n            detail={\n              whylog.verification === null\n                ? \"Not run since boot.\"\n                : whylog.verification.valid\n                  ? \"Chain verified at boot.\"\n                  : \"Chain verification FAILED at boot ΓÇö see the Foundation view.\"\n            }\n          />\n\n          <IntegrityRow\n            ok={exportStore.checks.every((check) => check.verification.ok)}\n            label=\"Export stamps\"\n            detail={\n              exportStore.checks.length === 0\n                ? \"No exported file has been checked against the log. Paste one on the Export tab to find out whether it still corresponds ΓÇö auditability, not security.\"\n                : `${exportStore.checks.filter((check) => !check.verification.ok).length} of ${exportStore.checks.length} checked file(s) do not match the current log head.`\n            }\n          />\n\n          <IntegrityRow\n            ok={!whylog.state.index.stale}\n            label=\"Semantic index\"\n            detail={\n              whylog.state.index.stale\n                ? \"STALE ΓÇö the stored vectors came from a different embedding space, so semantic retrieval is disabled until you rebuild. Cosine similarity across embedding spaces is meaningless, which is why staleness is detected rather than ignored.\"\n                : `Current. ${whylog.state.index.levels.join(\", \")} available.`\n            }\n          />\n        </div>\n      </section>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Metrics                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction MetricRow({\n  name,\n  value,\n  fraction,\n  gloss,\n  inverted = false,\n}: {\n  name: string;\n  value: number;\n  fraction: string;\n  gloss: string;\n  /** True for metrics where HIGH is bad ΓÇö contention and drift age. The bar then fills toward the\n   *  bad end, so a long bar always means \"look at this\" regardless of which metric it is. */\n  inverted?: boolean;\n}): ReactElement {\n  const clamped = Math.max(0, Math.min(1, value));\n\n  return (\n    <div style={{ borderTop: \"1px solid var(--border)\", padding: \"10px 0\" }}>\n      <div style={{ display: \"flex\", gap: 10, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n        <strong style={{ fontSize: 12.5, minWidth: 170 }}>{name}</strong>\n        <span\n          className=\"mono\"\n          style={{ fontSize: 12, letterSpacing: 1, color: barColour(clamped, inverted) }}\n        >\n          {bar(clamped)}\n        </span>\n        <span className=\"mono\" style={{ fontSize: 12 }}>\n          {(clamped * 100).toFixed(0).padStart(3)}%\n        </span>\n        <span className=\"mono faint\" style={{ fontSize: 11 }}>\n          {fraction}\n        </span>\n      </div>\n      <div className=\"dim\" style={{ fontSize: 11.5, marginTop: 5, maxWidth: 780 }}>\n        {gloss}\n      </div>\n    </div>\n  );\n}\n\nfunction barColour(value: number, inverted: boolean): string {\n  const bad = inverted ? value : 1 - value;\n  if (bad > 0.5) return \"var(--edge-conflict)\";\n  if (bad > 0.2) return \"var(--label-unknown)\";\n  return \"var(--label-in)\";\n}\n\nfunction IntegrityRow({\n  ok,\n  label,\n  detail,\n}: { ok: boolean; label: string; detail: string }): ReactElement {\n  return (\n    <div style={{ display: \"flex\", gap: 10, alignItems: \"baseline\" }}>\n      <span\n        className=\"mono\"\n        style={{ color: ok ? \"var(--label-in)\" : \"var(--edge-conflict)\", flexShrink: 0 }}\n      >\n        {ok ? \"Γ£ô\" : \"Γ£ù\"}\n      </span>\n      <span style={{ minWidth: 130, flexShrink: 0 }}>{label}</span>\n      <span className=\"dim\" style={{ fontSize: 11.5 }}>\n        {detail}\n      </span>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The two metrics with no existing implementation                            */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Premise contention: how much of the ground has shifted.\n *\n * Contested (UNKNOWN) and falsified (OUT) premises both count, because both mean a decision's\n * footing has moved ΓÇö one because it was never settled, the other because it settled the wrong way.\n */\nexport function premiseContention(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n): { score: number; contested: number; out: number; total: number } {\n  let contested = 0;\n  let out = 0;\n  let total = 0;\n\n  for (const premise of state.premises.values()) {\n    total += 1;\n    const nodeLabel = labels.get(premise.id)?.label ?? premise.label;\n    if (nodeLabel === \"UNKNOWN\") contested += 1;\n    else if (nodeLabel === \"OUT\") out += 1;\n  }\n\n  return { score: total === 0 ? 0 : (contested + out) / total, contested, out, total };\n}\n\n/**\n * The agency ratio ΓÇö how often you override your agent versus adopt its proposals.\n *\n * Computed from `provenance.origin`, which Phase 1 classifies on every node. This is the metric\n * nobody else can produce, because nobody else distinguishes a decision a human stated from one an\n * agent proposed and a human accepted from one an agent inferred and nobody checked.\n */\nexport function agencyRatio(state: GraphState): {\n  score: number;\n  overridden: number;\n  humanStated: number;\n  agentProposed: number;\n  agentInferred: number;\n  total: number;\n  gloss: string;\n} {\n  let humanStated = 0;\n  let humanOverride = 0;\n  let agentProposed = 0;\n  let agentInferred = 0;\n  let total = 0;\n\n  for (const decision of state.decisions.values()) {\n    if (decision.status === \"archived\") continue;\n    total += 1;\n\n    /* Exhaustive on purpose: there is no `default` branch, so a fifth `DecisionOrigin` is a\n     * compile error rather than a decision that is counted in `total` but in none of the four\n     * buckets. A `default: break` is how \"agent_proposed\" ΓÇö which is not an origin ΓÇö sat here\n     * for a while, silently zeroing the numerator of the agency ratio. */\n    switch (decision.provenance.origin) {\n      case \"human_stated\":\n        humanStated += 1;\n        break;\n      case \"human_override\":\n        humanOverride += 1;\n        break;\n      case \"agent_proposed_human_accepted\":\n        agentProposed += 1;\n        break;\n      case \"agent_inferred\":\n        agentInferred += 1;\n        break;\n    }\n  }\n\n  const agentSourced = agentProposed + agentInferred;\n  const score = agentSourced === 0 ? 0 : humanOverride / Math.max(1, agentSourced + humanOverride);\n\n  const gloss =\n    total === 0\n      ? \"No decisions yet.\"\n      : agentSourced === 0\n        ? `Every one of your ${total} decision(s) was stated by you, so there is nothing to measure agency against. This metric becomes interesting the first time an agent proposes something.`\n        : `You have overridden your agent ${humanOverride} time(s) out of ${agentSourced + humanOverride} agent-sourced decision(s). ${agentProposed} proposed and accepted, ${agentInferred} inferred and never checked, ${humanStated} stated by you outright. Nobody who does not classify decision origin can compute this.`;\n\n  return {\n    score,\n    overridden: humanOverride,\n    humanStated,\n    agentProposed,\n    agentInferred,\n    total,\n    gloss,\n  };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 30 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 30 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 30 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\ReviewView.tsx"},"span":[3531,3534],"sourceCode":"/**\n * The review view ΓÇö gate G1's interface.\n *\n * Phase 1 ┬╖ sub-phase 1.9\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.9\n *\n * ---------------------------------------------------------------------------\n * THE DESIGN CONSTRAINT IS A RATIO, NOT A TASTE\n *\n * ARGUS measured 155 false positives against 12 false negatives ΓÇö 13:1\n * (docs/05 ┬º4). So this screen is optimised for FAST REJECTION:\n *\n *   ΓÇó low-tier items render COLLAPSED, one line, one click to discard\n *   ΓÇó alternatives are collapsed at every tier (published precision 15.4%)\n *   ΓÇó derived OUT-list premises are collapsed and labelled, because they are\n *     inferences rather than quotes\n *   ΓÇó `Shift+D` discards everything collapsed in one action\n *   ΓÇó the commit preview names the conflicts before the batch is written\n *\n * Acceptance is still one key, but it is not the thing the layout is built around.\n * A review surface that made saying yes easy and saying no tedious would produce a\n * log full of machine guesses, and then the cascade would fire on all of them.\n *\n * ---------------------------------------------------------------------------\n * COLOUR ENCODES EPISTEMIC STATUS, NEVER SEVERITY\n *\n * The tier colours are the confidence tiers. Red is used for exactly one thing: an\n * action is available. A conflict is not \"red because it is bad\" ΓÇö it is marked\n * because there is something for the user to do about it.\n * ---------------------------------------------------------------------------\n */\n\nimport { ImportForm } from \"@/components/review/ImportForm\";\nimport { ReviewRow } from \"@/components/review/ReviewRow\";\nimport { TIER_COLOUR } from \"@/components/review/tier-colour\";\nimport {\n  REVIEW_FILTERS,\n  approve,\n  contest,\n  describeCommit,\n  describeKeys,\n  describeMergeTargets,\n  describeQueue,\n  discard,\n  summariseCommit,\n} from \"@/extraction\";\nimport { useExtraction } from \"@/store/extraction\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { type ReactElement, useEffect, useState } from \"react\";\n\nexport function ReviewView(): ReactElement {\n  const status = useExtraction((s) => s.status);\n  const error = useExtraction((s) => s.error);\n  const options = useExtraction((s) => s.options);\n  const setOptions = useExtraction((s) => s.setOptions);\n  const importText = useExtraction((s) => s.importText);\n  const commit = useExtraction((s) => s.commit);\n  const clear = useExtraction((s) => s.clear);\n  const restore = useExtraction((s) => s.restore);\n  const lastSummary = useExtraction((s) => s.lastSummary);\n  const degraded = useWhyLog((s) => s.status === \"degraded\");\n\n  const items = useExtraction((s) => s.visible());\n  const summary = useExtraction((s) => s.summary());\n  const preview = useExtraction((s) => s.preview());\n\n  const [selected, setSelected] = useState<string | null>(null);\n  const [editing, setEditing] = useState<string | null>(null);\n  const [confirming, setConfirming] = useState(false);\n  const [paste, setPaste] = useState(\"\");\n  const [label, setLabel] = useState(\"\");\n  const [busy, setBusy] = useState<string | null>(null);\n\n  // An unfinished review survives a reload; offering it is the difference between\n  // \"the app remembers\" and \"the app lost five minutes of my work\".\n  useEffect(() => {\n    restore();\n  }, [restore]);\n\n  useEffect(() => {\n    if (selected === null && items.length > 0) setSelected(items[0]?.key ?? null);\n  }, [items, selected]);\n\n  /* ---- keyboard: j/k/a/d/e/c ---- */\n  useEffect(() => {\n    const onKey = (event: KeyboardEvent): void => {\n      const target = event.target as HTMLElement | null;\n      if (target !== null && (target.tagName === \"TEXTAREA\" || target.tagName === \"INPUT\")) return;\n      if (items.length === 0) return;\n\n      const index = items.findIndex((item) => item.key === selected);\n      const act = useExtraction.getState().act;\n\n      switch (event.key) {\n        case \"j\":\n          setSelected(items[Math.min(items.length - 1, index + 1)]?.key ?? selected);\n          break;\n        case \"k\":\n          setSelected(items[Math.max(0, index - 1)]?.key ?? selected);\n          break;\n        case \"a\":\n          if (selected !== null) act(selected, approve(event.shiftKey));\n          break;\n        case \"d\":\n          if (selected !== null) act(selected, discard(\"discarded from the keyboard\"));\n          break;\n        case \"c\":\n          if (selected !== null) act(selected, contest(\"not sure yet ΓÇö parked\"));\n          break;\n        case \"e\":\n          setEditing(selected);\n          break;\n        case \"Enter\":\n          if (selected !== null) {\n            act(selected, approve(false));\n            setSelected(items[Math.min(items.length - 1, index + 1)]?.key ?? null);\n          }\n          break;\n        case \"Escape\":\n          setEditing(null);\n          setConfirming(false);\n          break;\n        default:\n          return;\n      }\n      event.preventDefault();\n    };\n\n    window.addEventListener(\"keydown\", onKey);\n    return () => window.removeEventListener(\"keydown\", onKey);\n  }, [items, selected]);\n\n  const unreviewed = summary.total - summary.reviewed;\n\n  /* ---------------- nothing imported yet ---------------- */\n  if (status === \"idle\" && summary.total === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Import a transcript</h2>\n        <p className=\"faint\" style={{ maxWidth: 620, lineHeight: 1.6 }}>\n          Paste a conversation with an AI coding agent. WhyLog reads it locally ΓÇö nothing is sent\n          anywhere unless you add an API key in Settings ΓÇö and proposes decisions, the premises they\n          rest on, and what was rejected. Nothing enters the log until you review it.\n        </p>\n\n        {lastSummary !== null && (\n          <p className=\"notice notice-info\" style={{ marginTop: 12 }}>\n            {lastSummary}\n          </p>\n        )}\n        {error !== null && <p className=\"notice notice-error\">{error}</p>}\n\n        <ImportForm\n          paste={paste}\n          label={label}\n          busy={busy}\n          degraded={degraded}\n          onPaste={setPaste}\n          onLabel={setLabel}\n          onImport={async () => {\n            setBusy(\"ExtractingΓÇª\");\n            const result = await importText(\n              paste,\n              label.trim().length > 0 ? label.trim() : undefined,\n            );\n            setBusy(null);\n            if (result.ok) {\n              setPaste(\"\");\n              setLabel(\"\");\n            }\n          }}\n        />\n\n        <details style={{ marginTop: 20 }}>\n          <summary className=\"faint\">Keyboard</summary>\n          <p className=\"mono faint\" style={{ fontSize: 12, marginTop: 8 }}>\n            {describeKeys()}\n          </p>\n        </details>\n      </section>\n    );\n  }\n\n  /* ---------------- the queue ---------------- */\n  return (\n    <div style={{ display: \"grid\", gap: 16 }}>\n      <header className=\"card\" style={{ padding: \"14px 18px\" }}>\n        <div style={{ display: \"flex\", gap: 12, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n          <strong>Review</strong>\n          <span className=\"faint\" style={{ fontSize: 13 }}>\n            {describeQueue(summary)}\n          </span>\n          {status === \"committing\" && <span className=\"faint\">committingΓÇª</span>}\n        </div>\n\n        <div style={{ display: \"flex\", gap: 6, marginTop: 10, flexWrap: \"wrap\" }}>\n          {REVIEW_FILTERS.map((filter) => (\n            <button\n              key={filter.id}\n              type=\"button\"\n              className=\"nav-item\"\n              aria-pressed={options.filter === filter.id}\n              style={options.filter === filter.id ? { borderColor: TIER_COLOUR.medium } : undefined}\n              onClick={() => setOptions({ filter: filter.id })}\n            >\n              {filter.label}\n            </button>\n          ))}\n          <span style={{ flex: 1 }} />\n          <input\n            className=\"mono\"\n            value={options.search}\n            onChange={(event) => setOptions({ search: event.target.value })}\n            placeholder=\"filterΓÇª\"\n            aria-label=\"Filter the queue\"\n            style={{ fontSize: 12, padding: \"4px 8px\", minWidth: 140 }}\n          />\n        </div>\n\n        {error !== null && (\n          <p className=\"notice notice-error\" style={{ marginTop: 10 }}>\n            {error}\n          </p>\n        )}\n      </header>\n\n      {items.map((item) => (\n        <ReviewRow\n          key={item.key}\n          item={item}\n          selected={item.key === selected}\n          editing={item.key === editing}\n          onSelect={() => setSelected(item.key)}\n          onCloseEdit={() => setEditing(null)}\n        />\n      ))}\n\n      {items.length === 0 && <p className=\"card faint\">Nothing matches this filter.</p>}\n\n      <footer className=\"card\" style={{ padding: \"14px 18px\", display: \"grid\", gap: 10 }}>\n        <div className=\"mono faint\" style={{ fontSize: 12, whiteSpace: \"pre-line\" }}>\n          {describeCommit(preview, unreviewed)}\n        </div>\n\n        {preview.mergeTargets.length > 0 && (\n          <div className=\"faint\" style={{ fontSize: 12 }}>\n            Merges onto: {describeMergeTargets(preview)}\n          </div>\n        )}\n\n        <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n          <button type=\"button\" onClick={() => useExtraction.getState().approveAllExpanded()}>\n            Approve all expanded <span className=\"faint\">(bulk ΓÇö stays UNKNOWN)</span>\n          </button>\n          <button type=\"button\" onClick={() => useExtraction.getState().discardAllCollapsed()}>\n            Discard all collapsed\n          </button>\n          {unreviewed > 0 && (\n            <button type=\"button\" onClick={() => useExtraction.getState().discardUnreviewed()}>\n              Discard the {unreviewed} unreviewed\n            </button>\n          )}\n          <span style={{ flex: 1 }} />\n          <button type=\"button\" className=\"faint\" onClick={clear}>\n            Throw this run away\n          </button>\n          {confirming ? (\n            <>\n              <button type=\"button\" onClick={() => setConfirming(false)}>\n                Back\n              </button>\n              <button\n                type=\"button\"\n                style={{ borderColor: TIER_COLOUR.high }}\n                onClick={() => {\n                  const result = commit();\n                  setConfirming(false);\n                  if (!result.ok) useExtraction.setState({ error: result.error });\n                }}\n              >\n                Yes ΓÇö append {preview.events} events\n              </button>\n            </>\n          ) : (\n            <button\n              type=\"button\"\n              onClick={() => setConfirming(true)}\n              disabled={preview.events <= 1}\n            >\n              Commit ({summariseCommit(preview)})\n            </button>\n          )}\n        </div>\n      </footer>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* One row                                                                    */\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Gate G4 ΓÇö \"it verifies\".\n *\n    const project = useGuards.getState().project;\n    expect(project.dependencies[\"pg\"]project.dependencies.pg).toBe(\"^8.11.3\");\n    expect(project.dependencies[\"next\"]).toBe(\"^15.1.0\");\n    expect(useWhyLog.getState().state.decisions.size).toBeGreaterThan(0);  });\n});\n","ops":[{"diffOp":{"equal":{"range":[0,36]}}},{"equalLines":{"line_count":118}},{"diffOp":{"equal":{"range":[36,98]}}},{"diffOp":{"delete":{"range":[98,124]}}},{"diffOp":{"insert":{"range":[124,147]}}},{"diffOp":{"equal":{"range":[147,297]}}},{"equalLines":{"line_count":88}},{"diffOp":{"equal":{"range":[297,307]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\integration\\gate-g4.test.ts"},"span":[4332,4336],"sourceCode":"/**\n * Gate G4 ΓÇö \"it verifies\".\n *\n * Plan: plan/OVERVIEW.md ┬º5.2\n *   \"G4 - It verifies | P4 | Can a decision be proven wrong by the code, deterministically?\n *    | Paste a `package.json` containing `pg` -> guard fails -> compliance drops ->\n *      gate (a) fires with no model involved\"\n *\n * The point of this gate is the DETERMINISM. The manifest says the project\n * depends on `pg`; the log says the project chose SQLite and not Postgres; the\n * ontology says those two values are mutually exclusive. No embedding, no\n * threshold, no model is consulted at any step.\n */\n\nimport { readFileSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\nimport { beforeEach, describe, expect, it } from \"vitest\";\n\nimport { createLocalEngine } from \"@/ai/local\";\nimport { commitReview } from \"@/extraction/commit\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { applyAction, approve } from \"@/extraction/review/actions\";\nimport { useGuards } from \"@/store/guards\";\nimport { useReasoning } from \"@/store/reasoning\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { type TranscriptId, asISO } from \"@/types/common\";\nimport { isDeterministic } from \"@/types/guards\";\n\nconst FIXTURE = resolve(process.cwd(), \"fixtures\", \"demo-transcript.txt\");\nconst ENGINE_ID = { kind: \"local\", model: \"cue-extractor-v1\" } as const;\nconst NOW = asISO(\"2026-10-03T15:00:00.000Z\");\n\n/** The manifest G4 specifies: a project that depends on `pg`. */\nconst MANIFEST = JSON.stringify(\n  {\n    name: \"demo\",\n    version: \"1.0.0\",\n    dependencies: { pg: \"^8.11.3\", next: \"^15.1.0\" },\n  },\n  null,\n  2,\n);\n\n/** Paste the transcript, review it, commit it. */\nasync function buildLog() {\n  const raw = readFileSync(FIXTURE, \"utf-8\");\n  const engine = createLocalEngine();\n\n  const run = await runExtraction(\n    { transcriptId: \"T-0001\" as TranscriptId, raw, occurredAt: NOW },\n    { engine, engineId: ENGINE_ID, state: useWhyLog.getState().state },\n  );\n  if (!run.ok) throw new Error(`extraction failed: ${run.failure.kind}`);\n\n  const reviewed = run.outcome.queue.map((candidate) => applyAction(candidate, approve(false)));\n  const committed = commitReview(\n    {\n      transcriptId: \"T-0001\" as TranscriptId,\n      engine: ENGINE_ID,\n      occurredAt: NOW,\n      items: reviewed,\n      machineDiscards: [],\n    },\n    useWhyLog.getState().state,\n  );\n  if (!committed.ok) throw new Error(\"commit failed\");\n\n  const recorded = useWhyLog.getState().recordBatch(committed.drafts, {\n    reason: \"Reviewed and approved: the Oct-3 transcript.\",\n    actor: { kind: \"human\" },\n    occurredAt: NOW,\n  });\n  if (!recorded.ok) throw new Error(`record failed: ${recorded.error}`);\n\n  return useWhyLog.getState().state;\n}\n\n/** The whole G4 loop: paste, synthesise, accept in bulk, run. */\nasync function runG4() {\n  await buildLog();\n\n  useGuards.getState().loadProject({ manifest: MANIFEST });\n  const parse = useGuards.getState().parse;\n\n  /* The manifest alone is not a whole project, and the parser says so. These\n   * are notices, not failures: path guards SKIP and string guards SKIP, and a\n   * skip is never a pass. The design point is that they are REPORTED. */\n  expect(parse?.notices.length ?? 0).toBeGreaterThan(0);\n  expect((parse?.notices ?? []).join(\"\\n\")).toContain(\"SKIP\");\n\n  const synthesised = await useGuards.getState().synthesise({ templatesOnly: true });\n  expect(synthesised.ok).toBe(true);\n\n  /* Bulk-accept. The gate tests the loop, not the review. */\n  const proposed = [...useWhyLog.getState().state.guards.values()].filter(\n    (guard) => guard.lifecycle === \"proposed\",\n  );\n  for (const guard of proposed) {\n    const accepted = useGuards.getState().accept(guard.id);\n    expect(accepted.ok).toBe(true);\n  }\n\n  const ran = await useGuards.getState().run();\n  expect(ran.ok).toBe(true);\n\n  return {\n    state: useWhyLog.getState().state,\n    guards: useGuards.getState(),\n    proposals: [...useWhyLog.getState().state.proposals.values()],\n  };\n}\n\ndescribe(\"Gate G4 ΓÇö it verifies\", () => {\n  beforeEach(() => {\n    localStorage.clear();\n    useWhyLog.getState().boot();\n  });\n\n  it(\"the manifest is parsed and the project is built\", async () => {\n    await buildLog();\n    useGuards.getState().loadProject({ manifest: MANIFEST });\n\n    const project = useGuards.getState().project;\n    expect(project.dependencies[\"pg\"]).toBe(\"^8.11.3\");\n    expect(project.dependencies[\"next\"]).toBe(\"^15.1.0\");\n    expect(useWhyLog.getState().state.decisions.size).toBeGreaterThan(0);\n  });\n\n  it(\"guards are synthesised from the log's decisions, with no model\", async () => {\n    await buildLog();\n    useGuards.getState().loadProject({ manifest: MANIFEST });\n\n    const synthesised = await useGuards.getState().synthesise({ templatesOnly: true });\n    expect(synthesised.ok).toBe(true);\n\n    const guards = [...useWhyLog.getState().state.guards.values()];\n    expect(guards.length).toBeGreaterThan(0);\n\n    // Every guard came from a template, and every one is deterministic.\n    for (const guard of guards) {\n      expect(guard.generatedBy).toBe(\"template\");\n      expect(isDeterministic(guard.spec.kind)).toBe(true);\n    }\n  });\n\n  it(\"a guard FAILS against the manifest, and compliance drops\", async () => {\n    const { guards } = await runG4();\n\n    // At least one guard failed.\n    const failures = guards.lastEvaluated.filter((entry) => entry.result.outcome === \"fail\");\n    expect(failures.length).toBeGreaterThan(0);\n\n    // The failing guard is the one that says `pg` must be absent while the\n    // decision \"use sqlite, not postgres\" is IN.\n    const quoted = failures.map((entry) => JSON.stringify(entry.result));\n    expect(quoted.join(\"\\n\")).toContain(\"pg\");\n\n    // Compliance is not 1: something the log believes is not what the code does.\n    const compliance = guards.metricsResult?.compliance;\n    expect(compliance).toBeDefined();\n    expect(compliance?.score ?? 1).toBeLessThan(1);\n  });\n\n  it(\"gate (a) fires: a revision proposal whose evidence quotes the manifest\", async () => {\n    const { proposals } = await runG4();\n\n    expect(proposals.length).toBeGreaterThan(0);\n\n    // The evidence is a VERBATIM quote of the manifest line, not a paraphrase.\n    const withManifest = proposals.filter((p) => p.evidence.source === \"guard\");\n    expect(withManifest.length).toBeGreaterThan(0);\n    expect(withManifest.some((p) => p.evidence.quote.includes(\"pg\"))).toBe(true);\n\n    // The proposal is about a decision the log holds, and it is not auto-applied.\n    for (const proposal of withManifest) {\n      expect(proposal.unsoundDecisionId).toMatch(/^WLD-/);\n      expect(proposal.availableActions.length).toBeGreaterThan(0);\n    }\n  });\n\n  it(\"the DATABASE decision is contradicted by the manifest line, verbatim\", async () => {\n    const { proposals, state } = await runG4();\n\n    /* The log says \"use SQLite, not Postgres\". The manifest says the project\n     * depends on `pg`, which is the Postgres driver. The exclusion guard fails,\n     * and the proposal's evidence has to be the line that failed - the same\n     * line, character for character, because a paraphrased quote is not a\n     * quote. */\n    const quoting = proposals.filter((p) => p.evidence.quote.includes('\"pg\": \"^8.11.3\"'));\n    expect(quoting.length).toBeGreaterThan(0);\n    expect(quoting.every((p) => p.evidence.source === \"guard\")).toBe(true);\n\n    // And the decision it contradicts is a DATABASE one.\n    const contradicted = quoting[0]?.unsoundDecisionId;\n    expect(contradicted).toBeDefined();\n    const decision = contradicted === undefined ? undefined : state.decisions.get(contradicted);\n    expect(decision?.variable).toBe(\"DATABASE\");\n    expect(decision?.statement.toLowerCase()).toContain(\"sqlite\");\n  });\n\n  it(\"the loop went through the same door a transcript uses\", async () => {\n    await runG4();\n\n    // The reasoning store ran, and the guard failures entered it as assertions.\n    const reasoning = useReasoning.getState();\n    expect(reasoning.status === \"idle\" || reasoning.status === \"done\").toBe(true);\n\n    // The proposal carries the entrenchment breakdown, which now reads\n    // implementation_cost from the guards rather than from a constant.\n    const proposals = [...useWhyLog.getState().state.proposals.values()];\n    for (const proposal of proposals) {\n      expect(proposal.entrenchment).toBeDefined();\n      expect(Object.keys(proposal.entrenchment.components).length).toBeGreaterThan(0);\n    }\n  });\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Gate G4 ΓÇö \"it verifies\".\n *    const project = useGuards.getState().project;\n    expect(project.dependencies[\"pg\"]).toBe(\"^8.11.3\");\n    expect(project.dependencies[\"next\"]project.dependencies.next).toBe(\"^15.1.0\");\n    expect(useWhyLog.getState().state.decisions.size).toBeGreaterThan(0);\n  });  });\n});\n","ops":[{"diffOp":{"equal":{"range":[0,36]}}},{"equalLines":{"line_count":119}},{"diffOp":{"equal":{"range":[36,153]}}},{"diffOp":{"delete":{"range":[153,181]}}},{"diffOp":{"insert":{"range":[181,206]}}},{"diffOp":{"equal":{"range":[206,304]}}},{"equalLines":{"line_count":87}},{"diffOp":{"equal":{"range":[304,314]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\integration\\gate-g4.test.ts"},"span":[4388,4394],"sourceCode":"/**\n * Gate G4 ΓÇö \"it verifies\".\n *\n * Plan: plan/OVERVIEW.md ┬º5.2\n *   \"G4 - It verifies | P4 | Can a decision be proven wrong by the code, deterministically?\n *    | Paste a `package.json` containing `pg` -> guard fails -> compliance drops ->\n *      gate (a) fires with no model involved\"\n *\n * The point of this gate is the DETERMINISM. The manifest says the project\n * depends on `pg`; the log says the project chose SQLite and not Postgres; the\n * ontology says those two values are mutually exclusive. No embedding, no\n * threshold, no model is consulted at any step.\n */\n\nimport { readFileSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\nimport { beforeEach, describe, expect, it } from \"vitest\";\n\nimport { createLocalEngine } from \"@/ai/local\";\nimport { commitReview } from \"@/extraction/commit\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { applyAction, approve } from \"@/extraction/review/actions\";\nimport { useGuards } from \"@/store/guards\";\nimport { useReasoning } from \"@/store/reasoning\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { type TranscriptId, asISO } from \"@/types/common\";\nimport { isDeterministic } from \"@/types/guards\";\n\nconst FIXTURE = resolve(process.cwd(), \"fixtures\", \"demo-transcript.txt\");\nconst ENGINE_ID = { kind: \"local\", model: \"cue-extractor-v1\" } as const;\nconst NOW = asISO(\"2026-10-03T15:00:00.000Z\");\n\n/** The manifest G4 specifies: a project that depends on `pg`. */\nconst MANIFEST = JSON.stringify(\n  {\n    name: \"demo\",\n    version: \"1.0.0\",\n    dependencies: { pg: \"^8.11.3\", next: \"^15.1.0\" },\n  },\n  null,\n  2,\n);\n\n/** Paste the transcript, review it, commit it. */\nasync function buildLog() {\n  const raw = readFileSync(FIXTURE, \"utf-8\");\n  const engine = createLocalEngine();\n\n  const run = await runExtraction(\n    { transcriptId: \"T-0001\" as TranscriptId, raw, occurredAt: NOW },\n    { engine, engineId: ENGINE_ID, state: useWhyLog.getState().state },\n  );\n  if (!run.ok) throw new Error(`extraction failed: ${run.failure.kind}`);\n\n  const reviewed = run.outcome.queue.map((candidate) => applyAction(candidate, approve(false)));\n  const committed = commitReview(\n    {\n      transcriptId: \"T-0001\" as TranscriptId,\n      engine: ENGINE_ID,\n      occurredAt: NOW,\n      items: reviewed,\n      machineDiscards: [],\n    },\n    useWhyLog.getState().state,\n  );\n  if (!committed.ok) throw new Error(\"commit failed\");\n\n  const recorded = useWhyLog.getState().recordBatch(committed.drafts, {\n    reason: \"Reviewed and approved: the Oct-3 transcript.\",\n    actor: { kind: \"human\" },\n    occurredAt: NOW,\n  });\n  if (!recorded.ok) throw new Error(`record failed: ${recorded.error}`);\n\n  return useWhyLog.getState().state;\n}\n\n/** The whole G4 loop: paste, synthesise, accept in bulk, run. */\nasync function runG4() {\n  await buildLog();\n\n  useGuards.getState().loadProject({ manifest: MANIFEST });\n  const parse = useGuards.getState().parse;\n\n  /* The manifest alone is not a whole project, and the parser says so. These\n   * are notices, not failures: path guards SKIP and string guards SKIP, and a\n   * skip is never a pass. The design point is that they are REPORTED. */\n  expect(parse?.notices.length ?? 0).toBeGreaterThan(0);\n  expect((parse?.notices ?? []).join(\"\\n\")).toContain(\"SKIP\");\n\n  const synthesised = await useGuards.getState().synthesise({ templatesOnly: true });\n  expect(synthesised.ok).toBe(true);\n\n  /* Bulk-accept. The gate tests the loop, not the review. */\n  const proposed = [...useWhyLog.getState().state.guards.values()].filter(\n    (guard) => guard.lifecycle === \"proposed\",\n  );\n  for (const guard of proposed) {\n    const accepted = useGuards.getState().accept(guard.id);\n    expect(accepted.ok).toBe(true);\n  }\n\n  const ran = await useGuards.getState().run();\n  expect(ran.ok).toBe(true);\n\n  return {\n    state: useWhyLog.getState().state,\n    guards: useGuards.getState(),\n    proposals: [...useWhyLog.getState().state.proposals.values()],\n  };\n}\n\ndescribe(\"Gate G4 ΓÇö it verifies\", () => {\n  beforeEach(() => {\n    localStorage.clear();\n    useWhyLog.getState().boot();\n  });\n\n  it(\"the manifest is parsed and the project is built\", async () => {\n    await buildLog();\n    useGuards.getState().loadProject({ manifest: MANIFEST });\n\n    const project = useGuards.getState().project;\n    expect(project.dependencies[\"pg\"]).toBe(\"^8.11.3\");\n    expect(project.dependencies[\"next\"]).toBe(\"^15.1.0\");\n    expect(useWhyLog.getState().state.decisions.size).toBeGreaterThan(0);\n  });\n\n  it(\"guards are synthesised from the log's decisions, with no model\", async () => {\n    await buildLog();\n    useGuards.getState().loadProject({ manifest: MANIFEST });\n\n    const synthesised = await useGuards.getState().synthesise({ templatesOnly: true });\n    expect(synthesised.ok).toBe(true);\n\n    const guards = [...useWhyLog.getState().state.guards.values()];\n    expect(guards.length).toBeGreaterThan(0);\n\n    // Every guard came from a template, and every one is deterministic.\n    for (const guard of guards) {\n      expect(guard.generatedBy).toBe(\"template\");\n      expect(isDeterministic(guard.spec.kind)).toBe(true);\n    }\n  });\n\n  it(\"a guard FAILS against the manifest, and compliance drops\", async () => {\n    const { guards } = await runG4();\n\n    // At least one guard failed.\n    const failures = guards.lastEvaluated.filter((entry) => entry.result.outcome === \"fail\");\n    expect(failures.length).toBeGreaterThan(0);\n\n    // The failing guard is the one that says `pg` must be absent while the\n    // decision \"use sqlite, not postgres\" is IN.\n    const quoted = failures.map((entry) => JSON.stringify(entry.result));\n    expect(quoted.join(\"\\n\")).toContain(\"pg\");\n\n    // Compliance is not 1: something the log believes is not what the code does.\n    const compliance = guards.metricsResult?.compliance;\n    expect(compliance).toBeDefined();\n    expect(compliance?.score ?? 1).toBeLessThan(1);\n  });\n\n  it(\"gate (a) fires: a revision proposal whose evidence quotes the manifest\", async () => {\n    const { proposals } = await runG4();\n\n    expect(proposals.length).toBeGreaterThan(0);\n\n    // The evidence is a VERBATIM quote of the manifest line, not a paraphrase.\n    const withManifest = proposals.filter((p) => p.evidence.source === \"guard\");\n    expect(withManifest.length).toBeGreaterThan(0);\n    expect(withManifest.some((p) => p.evidence.quote.includes(\"pg\"))).toBe(true);\n\n    // The proposal is about a decision the log holds, and it is not auto-applied.\n    for (const proposal of withManifest) {\n      expect(proposal.unsoundDecisionId).toMatch(/^WLD-/);\n      expect(proposal.availableActions.length).toBeGreaterThan(0);\n    }\n  });\n\n  it(\"the DATABASE decision is contradicted by the manifest line, verbatim\", async () => {\n    const { proposals, state } = await runG4();\n\n    /* The log says \"use SQLite, not Postgres\". The manifest says the project\n     * depends on `pg`, which is the Postgres driver. The exclusion guard fails,\n     * and the proposal's evidence has to be the line that failed - the same\n     * line, character for character, because a paraphrased quote is not a\n     * quote. */\n    const quoting = proposals.filter((p) => p.evidence.quote.includes('\"pg\": \"^8.11.3\"'));\n    expect(quoting.length).toBeGreaterThan(0);\n    expect(quoting.every((p) => p.evidence.source === \"guard\")).toBe(true);\n\n    // And the decision it contradicts is a DATABASE one.\n    const contradicted = quoting[0]?.unsoundDecisionId;\n    expect(contradicted).toBeDefined();\n    const decision = contradicted === undefined ? undefined : state.decisions.get(contradicted);\n    expect(decision?.variable).toBe(\"DATABASE\");\n    expect(decision?.statement.toLowerCase()).toContain(\"sqlite\");\n  });\n\n  it(\"the loop went through the same door a transcript uses\", async () => {\n    await runG4();\n\n    // The reasoning store ran, and the guard failures entered it as assertions.\n    const reasoning = useReasoning.getState();\n    expect(reasoning.status === \"idle\" || reasoning.status === \"done\").toBe(true);\n\n    // The proposal carries the entrenchment breakdown, which now reads\n    // implementation_cost from the guards rather than from a constant.\n    const proposals = [...useWhyLog.getState().state.proposals.values()];\n    for (const proposal of proposals) {\n      expect(proposal.entrenchment).toBeDefined();\n      expect(Object.keys(proposal.entrenchment.components).length).toBeGreaterThan(0);\n    }\n  });\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\TimelineView.tsx"},"span":[15441,15448],"sourceCode":"/**\n * The timeline view ΓÇö 6.1.\n *\n * Phase 6 ┬╖ sub-phase 6.1\n * Plan: plan/phase-6-presentation.md ┬º6.1\n *\n * ---------------------------------------------------------------------------\n * ORDERED BY VALID TIME, NEVER BY LEARNED TIME\n *\n * Otherwise a pasted historical transcript appears at the top: you import a three-week-old\n * conversation and every decision in it jumps to \"just now\", which destroys the one thing a timeline\n * is for. Valid time is when it became true in the world; learned time is when WhyLog heard about it.\n * The timeline shows the first, the audit trail shows the second, and both are labelled wherever they\n * appear.\n *\n * ---------------------------------------------------------------------------\n * SEARCH IS THE PHASE 3 STACK, NOT A STRING MATCH\n *\n * Typing in the search box runs the real retrieval pipeline ΓÇö five index levels, RRF fusion,\n * reranking ΓÇö over the query, and the list re-orders by relevance rather than filtering by substring.\n * A decision phrased \"we're going with sqlite\" is found by searching \"database choice\" only because\n * the retrieval stack is doing the work; a `includes()` filter would not find it and the box would\n * feel broken.\n *\n * It runs through `retrieveOnly` rather than `ask`, because the timeline wants the ranking and not\n * prose ΓÇö composing an answer for every keystroke would be slow and would put an answer where a list\n * belongs.\n *\n * ---------------------------------------------------------------------------\n * QUICK LOG GOES THROUGH THE SAME DOOR AS EVERYTHING ELSE\n *\n * ┬º6.1's criterion: a Quick Log entry enters the same `REVISE()` cycle as an extracted one. It calls\n * `assertUserDecision`, which is the same `assertNewInformation` entry point a transcript uses ΓÇö so a\n * hand-typed decision that contradicts an existing one produces the same gates, the same adjudication\n * and the same proposal as one that arrived by extraction. There is no fast path, and a fast path\n * would be a second reasoning route that nobody exercises.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  EmptyState,\n  FirstRunState,\n  StatusLegend,\n  TimelineStatusBadge,\n  timelineStatusOf,\n} from \"@/components/common\";\nimport type { TimelineStatus } from \"@/components/common\";\nimport { DecisionCard } from \"@/components/decision\";\nimport { guardStatusMap } from \"@/guards\";\nimport { VARIABLES } from \"@/ontology\";\nimport { entrenchmentOf } from \"@/reasoning/entrenchment\";\nimport { type Labelled, type NodeId, label as labelGraph } from \"@/reasoning/labeller\";\nimport { type RetrievalResult, retrieveOnly, useAsk } from \"@/store/ask\";\nimport { assertUserDecision } from \"@/store/reasoning\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { DecisionVariable } from \"@/types/domain\";\nimport { type ReactElement, useEffect, useMemo, useState } from \"react\";\n\ninterface Filters {\n  variable: DecisionVariable | \"all\";\n  status: TimelineStatus | \"all\";\n  origin: string;\n  engine: string;\n  from: string;\n  to: string;\n  transcript: string;\n}\n\nconst NO_FILTERS: Filters = {\n  variable: \"all\",\n  status: \"all\",\n  origin: \"all\",\n  engine: \"all\",\n  from: \"\",\n  to: \"\",\n  transcript: \"all\",\n};\n\nexport function TimelineView(): ReactElement {\n  const whylog = useWhyLog();\n  const ask = useAsk();\n  const [filters, setFilters] = useState<Filters>(NO_FILTERS);\n  const [query, setQuery] = useState(\"\");\n  const [results, setResults] = useState<RetrievalResult | null>(null);\n  const [searching, setSearching] = useState(false);\n  const [selected, setSelected] = useState<DecisionId | null>(null);\n  const [quickLog, setQuickLog] = useState(false);\n\n  const labels = useMemo(() => labelGraph(whylog.state).labels, [whylog.state]);\n  const guards = useMemo(() => guardStatusMap(whylog.state), [whylog.state]);\n\n  /* ---- search-as-you-type over the Phase 3 stack, debounced ---- */\n  useEffect(() => {\n    const trimmed = query.trim();\n\n    if (trimmed.length < 2) {\n      setResults(null);\n      setSearching(false);\n      return;\n    }\n\n    setSearching(true);\n    const handle = window.setTimeout(() => {\n      void (async () => {\n        const artifacts = await ask.ensureIndex();\n        if (artifacts === null) {\n          setSearching(false);\n          return;\n        }\n        const outcome = await retrieveOnly(whylog.state, artifacts, trimmed);\n        setResults(outcome);\n        setSearching(false);\n      })();\n    }, 260);\n\n    return () => window.clearTimeout(handle);\n  }, [query, whylog.state, ask]);\n\n  const rows = useMemo(() => {\n    /* Search order wins when there is a search: relevance is the point of running the real\n     * retrieval stack, and re-sorting its output by date would discard the ranking. */\n    const ordered: DecisionId[] =\n      results !== null && results.hits.length > 0\n        ? results.hits.map((hit) => hit.decisionId)\n        : [...whylog.state.decisions.values()]\n            .sort((a, b) => byValidTime(a.temporal.valid, b.temporal.valid, a.id, b.id))\n            .map((decision) => decision.id);\n\n    return ordered.filter((id) => matches(whylog.state, labels, id, filters));\n  }, [results, whylog.state, labels, filters]);\n\n  if (whylog.state.decisions.size === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Timeline</h2>\n        <FirstRunState onPaste={() => setQuickLog(true)} onDemo={() => setQuickLog(true)} />\n      </section>\n    );\n  }\n\n  const selectedDecision = selected === null ? null : whylog.state.decisions.get(selected);\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 16 }}>\n      <section className=\"card\">\n        <h2 className=\"card-title\">\n          Timeline\n          <span className=\"faint\" style={{ marginLeft: 10, fontSize: 11, fontWeight: 400 }}>\n            {rows.length} of {whylog.state.decisions.size} decision(s)\n          </span>\n        </h2>\n\n        <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n          Ordered by <strong>valid time</strong> ΓÇö when each decision became true in the world, not\n          when WhyLog learned about it. Paste a three-week-old transcript and its decisions land\n          where they belong rather than at the top.\n        </p>\n\n        <div style={{ display: \"flex\", gap: 8, alignItems: \"center\", flexWrap: \"wrap\" }}>\n          <input\n            value={query}\n            onChange={(event) => setQuery(event.target.value)}\n            placeholder=\"search ΓÇö runs the real retrieval stack: five levels, RRF, reranked\"\n            style={{ flex: 1, minWidth: 240, fontSize: 12 }}\n            aria-label=\"Search decisions\"\n          />\n          {searching ? (\n            <span className=\"faint mono\" style={{ fontSize: 11 }}>\n              searchingΓÇª\n            </span>\n          ) : null}\n          <button\n            type=\"button\"\n            className=\"badge\"\n            onClick={() => setQuickLog((previous) => !previous)}\n          >\n            {quickLog ? \"close quick log\" : \"Quick log (N)\"}\n          </button>\n        </div>\n\n        {results !== null ? (\n          <div className=\"faint\" style={{ fontSize: 11, marginTop: 6 }}>\n            Ranked by relevance, not date ΓÇö that is what running the retrieval stack buys. Levels\n            available: {results.levels.join(\", \")}\n            {results.levelsUnavailable.length > 0\n              ? ` (unavailable: ${results.levelsUnavailable.join(\", \")})`\n              : \"\"}{\" \"}\n            ┬╖ method {results.method} ┬╖ {results.durationMs} ms.\n          </div>\n        ) : null}\n\n        <div style={{ marginTop: 12 }}>\n          <StatusLegend />\n        </div>\n      </section>\n\n      {quickLog ? <QuickLog onDone={() => setQuickLog(false)} /> : null}\n\n      <section className=\"card\">\n        <FilterBar filters={filters} onChange={setFilters} state={whylog.state} />\n      </section>\n\n      <section className=\"card\">\n        <h2 className=\"card-title\">Decisions</h2>\n\n        {rows.length === 0 ? (\n          <EmptyState\n            title=\"Nothing matches those filters\"\n            what={`The log holds ${whylog.state.decisions.size} decision(s) and none of them satisfy the current filters or search.`}\n            action=\"Clear the filters to see the whole timeline.\"\n            onAction={() => {\n              setFilters(NO_FILTERS);\n              setQuery(\"\");\n            }}\n            actionLabel=\"Clear filters\"\n          />\n        ) : (\n          <div style={{ display: \"flex\", flexDirection: \"column\", gap: 2 }}>\n            {rows.map((id) => (\n              <TimelineRow\n                key={id}\n                decisionId={id}\n                labels={labels}\n                selected={selected === id}\n                onSelect={() => setSelected((previous) => (previous === id ? null : id))}\n                rank={results !== null ? rankOf(results, id) : null}\n              />\n            ))}\n          </div>\n        )}\n      </section>\n\n      {selectedDecision !== undefined && selectedDecision !== null && selected !== null ? (\n        <section className=\"card\">\n          <h2 className=\"card-title\">Decision card</h2>\n          <DecisionCard\n            state={whylog.state}\n            labels={labels}\n            decisionId={selected}\n            entrenchment={entrenchmentOf(whylog.state, selected, Date.now(), guards.get(selected))}\n            onSelectPremise={() => undefined}\n          />\n        </section>\n      ) : null}\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The row                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction TimelineRow({\n  decisionId,\n  labels,\n  selected,\n  onSelect,\n  rank,\n}: {\n  decisionId: DecisionId;\n  labels: ReadonlyMap<NodeId, Labelled>;\n  selected: boolean;\n  onSelect: () => void;\n  rank: number | null;\n}): ReactElement {\n  const whylog = useWhyLog();\n  const decision = whylog.state.decisions.get(decisionId);\n\n  if (decision === undefined) return <span />;\n\n  const nodeLabel = labels.get(decisionId)?.label ?? decision.label;\n\n  return (\n    <button\n      type=\"button\"\n      onClick={onSelect}\n      style={{\n        display: \"flex\",\n        gap: 10,\n        alignItems: \"baseline\",\n        width: \"100%\",\n        textAlign: \"left\",\n        border: \"none\",\n        borderBottom: \"1px solid var(--border)\",\n        background: selected ? \"var(--surface-raised)\" : \"transparent\",\n        padding: \"8px 6px\",\n        cursor: \"pointer\",\n      }}\n    >\n      <span className=\"mono faint\" style={{ fontSize: 11, width: 74, flexShrink: 0 }}>\n        {decision.temporal.valid.slice(0, 10)}\n      </span>\n\n      <span className=\"mono faint\" style={{ fontSize: 10, width: 62, flexShrink: 0 }}>\n        {decisionId}\n      </span>\n\n      <span style={{ fontSize: 12.5, flex: 1 }}>{decision.statement}</span>\n\n      {rank !== null ? (\n        <span\n          className=\"mono faint\"\n          style={{ fontSize: 10 }}\n          title=\"Relevance rank from the retrieval stack\"\n        >\n          #{rank + 1}\n        </span>\n      ) : null}\n\n      <span className=\"mono faint\" style={{ fontSize: 10 }}>\n        {decision.variable}\n      </span>\n\n      <TimelineStatusBadge status={timelineStatusOf(nodeLabel, decision.status)} />\n    </button>\n  );\n}\n\nfunction rankOf(results: RetrievalResult, id: DecisionId): number | null {\n  const index = results.hits.findIndex((hit) => hit.decisionId === id);\n  return index < 0 ? null : index;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Filters                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction FilterBar({\n  filters,\n  onChange,\n  state,\n}: {\n  filters: Filters;\n  onChange: (next: Filters) => void;\n  state: GraphState;\n}): ReactElement {\n  const origins = useMemo(() => {\n    const set = new Set<string>([\"all\"]);\n    for (const decision of state.decisions.values()) set.add(decision.provenance.origin);\n    return [...set];\n  }, [state]);\n\n  const engines = useMemo(() => {\n    const set = new Set<string>([\"all\"]);\n    for (const decision of state.decisions.values()) set.add(decision.provenance.extractedBy.kind);\n    return [...set];\n  }, [state]);\n\n  const transcripts = useMemo(() => {\n    const set = new Set<string>([\"all\"]);\n    for (const decision of state.decisions.values())\n      set.add(decision.provenance.snippet.transcriptId);\n    return [...set];\n  }, [state]);\n\n  const set = (patch: Partial<Filters>): void => onChange({ ...filters, ...patch });\n\n  return (\n    <div>\n      <h2 className=\"card-title\">Filters</h2>\n      <div\n        style={{ display: \"flex\", gap: 10, flexWrap: \"wrap\", alignItems: \"center\", fontSize: 12 }}\n      >\n        <Select\n          label=\"variable\"\n          value={filters.variable}\n          onChange={(value) => set({ variable: value as Filters[\"variable\"] })}\n          options={[\"all\", ...VARIABLES]}\n        />\n        <Select\n          label=\"status\"\n          value={filters.status}\n          onChange={(value) => set({ status: value as Filters[\"status\"] })}\n          options={[\n            \"all\",\n            \"SOUND\",\n            \"UNSOUND\",\n            \"UNVERIFIED\",\n            \"UNFOUNDED\",\n            \"CONTESTED\",\n            \"SUPERSEDED\",\n          ]}\n        />\n        <Select\n          label=\"origin\"\n          value={filters.origin}\n          onChange={(value) => set({ origin: value })}\n          options={origins}\n        />\n        <Select\n          label=\"engine\"\n          value={filters.engine}\n          onChange={(value) => set({ engine: value })}\n          options={engines}\n        />\n        <Select\n          label=\"transcript\"\n          value={filters.transcript}\n          onChange={(value) => set({ transcript: value })}\n          options={transcripts}\n        />\n\n        <label className=\"faint\" style={{ fontSize: 11 }}>\n          from{\" \"}\n          <input\n            type=\"date\"\n            value={filters.from}\n            onChange={(event) => set({ from: event.target.value })}\n            style={{ fontSize: 11, marginLeft: 4 }}\n          />\n        </label>\n        <label className=\"faint\" style={{ fontSize: 11 }}>\n          to{\" \"}\n          <input\n            type=\"date\"\n            value={filters.to}\n            onChange={(event) => set({ to: event.target.value })}\n            style={{ fontSize: 11, marginLeft: 4 }}\n          />\n        </label>\n\n        <button type=\"button\" className=\"badge faint\" onClick={() => onChange(NO_FILTERS)}>\n          reset\n        </button>\n      </div>\n    </div>\n  );\n}\n\nfunction Select({\n  label,\n  value,\n  onChange,\n  options,\n}: {\n  label: string;\n  value: string;\n  onChange: (next: string) => void;\n  options: readonly string[];\n}): ReactElement {\n  return (\n    <label className=\"faint\" style={{ fontSize: 11 }}>\n      {label}{\" \"}\n      <select\n        value={value}\n        onChange={(event) => onChange(event.target.value)}\n        style={{ fontSize: 11, marginLeft: 4 }}\n      >\n        {options.map((option) => (\n          <option key={option} value={option}>\n            {option}\n          </option>\n        ))}\n      </select>\n    </label>\n  );\n}\n\nfunction matches(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  id: DecisionId,\n  filters: Filters,\n): boolean {\n  const decision = state.decisions.get(id);\n  if (decision === undefined) return false;\n\n  if (filters.variable !== \"all\" && decision.variable !== filters.variable) return false;\n  if (filters.origin !== \"all\" && decision.provenance.origin !== filters.origin) return false;\n  if (filters.engine !== \"all\" && decision.provenance.extractedBy.kind !== filters.engine)\n    return false;\n  if (\n    filters.transcript !== \"all\" &&\n    decision.provenance.snippet.transcriptId !== filters.transcript\n  )\n    return false;\n  if (filters.from.length > 0 && decision.temporal.valid.slice(0, 10) < filters.from) return false;\n  if (filters.to.length > 0 && decision.temporal.valid.slice(0, 10) > filters.to) return false;\n\n  if (filters.status !== \"all\") {\n    const nodeLabel = labels.get(id)?.label ?? decision.label;\n    if (timelineStatusOf(nodeLabel, decision.status) !== filters.status) return false;\n  }\n\n  return true;\n}\n\nfunction byValidTime(validA: string, validB: string, idA: string, idB: string): number {\n  /* Descending by valid time ΓÇö newest first, as a timeline reads. Ties break by id so the order is\n   * stable across renders: a list that re-shuffles when nothing changed looks broken. */\n  if (validA === validB) return idA < idB ? -1 : idA > idB ? 1 : 0;\n  return validA > validB ? -1 : 1;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Quick log                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * A ten-second manual entry for someone mid-flow.\n *\n * It skips EXTRACTION ΓÇö there is no transcript to read ΓÇö but not resolution and not revision. The\n * entry goes through `assertUserDecision`, which is the same assertion entry point a transcript uses,\n * so a hand-typed decision that contradicts an existing one produces the same gates, the same\n * adjudication and the same proposal.\n *\n * A reason is mandatory and the function refuses without one, because a hand-entered decision's\n * reason is the only provenance it will ever have: there is no snippet to point at.\n */\nfunction QuickLog({ onDone }: { onDone: () => void }): ReactElement {\n  const [variable, setVariable] = useState<DecisionVariable>(\"OTHER\");\n  const [value, setValue] = useState(\"\");\n  const [statement, setStatement] = useState(\"\");\n  const [reason, setReason] = useState(\"\");\n  const [busy, setBusy] = useState(false);\n  const [note, setNote] = useState<string | null>(null);\n\n  const submit = async (): Promise<void> => {\n    setBusy(true);\n    setNote(null);\n\n    const outcome = await assertUserDecision(\n      variable,\n      value.trim(),\n      statement.trim(),\n      reason.trim(),\n    );\n\n    setBusy(false);\n\n    if (!outcome.ok) {\n      setNote(outcome.error);\n      return;\n    }\n\n    setNote(outcome.value);\n    setValue(\"\");\n    setStatement(\"\");\n    setReason(\"\");\n    onDone();\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Quick log</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        For a decision you just made and do not want to lose. It skips extraction ΓÇö there is no\n        transcript ΓÇö but it goes through the same <span className=\"mono\">REVISE()</span> cycle as an\n        extracted one, so it is checked against what the log already holds.\n      </p>\n\n      <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\", alignItems: \"flex-end\" }}>\n        <label className=\"faint\" style={{ fontSize: 11 }}>\n          variable\n          <select\n            value={variable}\n            onChange={(event) => setVariable(event.target.value as DecisionVariable)}\n            style={{ display: \"block\", fontSize: 12, marginTop: 3 }}\n          >\n            {VARIABLES.map((option) => (\n              <option key={option} value={option}>\n                {option}\n              </option>\n            ))}\n          </select>\n        </label>\n\n        <label className=\"faint\" style={{ fontSize: 11 }}>\n          value\n          <input\n            value={value}\n            onChange={(event) => setValue(event.target.value)}\n            placeholder=\"sqlite\"\n            style={{ display: \"block\", fontSize: 12, marginTop: 3 }}\n          />\n        </label>\n      </div>\n\n      <input\n        value={statement}\n        onChange={(event) => setStatement(event.target.value)}\n        placeholder=\"Use SQLite, not Postgres\"\n        style={{ width: \"100%\", fontSize: 12, marginTop: 8 }}\n      />\n\n      <input\n        value={reason}\n        onChange={(event) => setReason(event.target.value)}\n        placeholder=\"why ΓÇö required; this is the only provenance a hand-entered decision will ever have\"\n        style={{ width: \"100%\", fontSize: 12, marginTop: 8 }}\n      />\n\n      <div style={{ display: \"flex\", gap: 8, marginTop: 10 }}>\n        <button\n          type=\"button\"\n          className=\"badge\"\n          disabled={busy || statement.trim().length === 0 || value.trim().length === 0}\n          onClick={() => void submit()}\n        >\n          {busy ? \"Running the cycleΓÇª\" : \"Record it\"}\n        </button>\n        <button type=\"button\" className=\"badge faint\" onClick={onDone}>\n          cancel\n        </button>\n      </div>\n\n      {note !== null ? (\n        <div className=\"notice notice-info\" style={{ marginTop: 10, fontSize: 12 }}>\n          {note}\n        </div>\n      ) : null}\n    </section>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 29 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 29 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 29 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\GuardsView.tsx"},"span":[17077,17087],"sourceCode":"/**\n * The Guards view ΓÇö 4.7, and the surface for gate G4.\n *\n * Phase 4 ┬╖ sub-phases 4.2ΓÇô4.7\n * Plan: plan/phase-4-executable-guards.md\n *\n * ---------------------------------------------------------------------------\n * THE FIVE THINGS THIS VIEW HAS TO MAKE VISIBLE\n *\n *   1. what the guards were COMPILED FROM ΓÇö the decision, its rejected alternatives and its\n *      globs. A guard whose origin you cannot see is a lint rule.\n *   2. that nothing runs until a human accepts it ΓÇö the proposed list is the default state.\n *   3. WHY each guard is disabled or skipped, every time. A disabled guard with no explanation\n *      reads as a broken one, and a skip that looks like a pass is the failure mode that makes\n *      a compliance score meaningless.\n *   4. the five metrics together. Compliance without coverage is a number that flatters itself:\n *      a log with one passing guard scores 100%.\n *   5. the unverifiable decisions. Silence is never the answer ΓÇö they are the ones most likely\n *      to drift, because nothing would tell you if they did.\n *\n * ---------------------------------------------------------------------------\n * COLOUR ENCODES EPISTEMIC STATUS, NEVER SEVERITY\n *\n * The house rule from Phase 0. A `blocking` failure is not redder than a `warning` one because\n * it is more important ΓÇö it is marked differently because it fails the build. And an\n * unverifiable decision is not an error: it is an honest gap, rendered as a gap.\n *\n * ---------------------------------------------------------------------------\n * GATE G4 IS A BUTTON\n *\n * \"Pasting a package.json containing `pg` drops compliance and fires a structural contradiction\n * with no model involved.\" That is checkable in one click here, and a gate the user has to\n * reconstruct from the plan is a gate that does not get run.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  GUARDS_PER_DECISION_CAP,\n  describeFeedbackLoop,\n  describeReviewPolicy,\n  describeTaxonomy,\n  renderDashboard,\n} from \"@/guards\";\nimport type { EvaluatedGuard } from \"@/guards\";\nimport { label } from \"@/reasoning/labeller\";\nimport { describeGuardStore, overCapDecisions, useGuards } from \"@/store/guards\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { LABEL_COLOUR, LABEL_MEANING } from \"@/theme\";\nimport type { DecisionId, GuardId } from \"@/types/common\";\nimport type { GuardSeverity, GuardSpec } from \"@/types/guards\";\nimport { type ReactElement, useMemo, useState } from \"react\";\n\n/* -------------------------------------------------------------------------- */\n/* Gate G4                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The manifest G4 is defined by.\n *\n * It contains `pg` and `next` ΓÇö one violating a DATABASE decision that rejected Postgres, one\n * violating a FRAMEWORK decision that chose Vite. Pasting it into a log holding the demo\n * fixture's decisions must drop compliance and fire a structural contradiction, with no model\n * involved at any point: the guard is a dependency lookup, the contradiction is an ontology\n * antonym check, and the proposal comes from the deterministic reasoning cycle.\n */\nconst G4_MANIFEST = `{\n  \"name\": \"whylog-demo\",\n  \"version\": \"0.1.0\",\n  \"dependencies\": {\n    \"better-sqlite3\": \"^11.3.0\",\n    \"pg\": \"^8.11.3\",\n    \"react\": \"^18.3.1\"\n  },\n  \"devDependencies\": {\n    \"next\": \"^15.1.0\",\n    \"vite\": \"^6.0.0\",\n    \"typescript\": \"^5.6.0\"\n  }\n}`;\n\nconst G4_LISTING = `src/db/schema.ts\nsrc/db/client.ts\nsrc/main.tsx\npackage.json\nvite.config.ts\nnext.config.js`;\n\n/* -------------------------------------------------------------------------- */\n/* The view                                                                   */\n/* -------------------------------------------------------------------------- */\n\nexport function GuardsView(): ReactElement {\n  const whylog = useWhyLog();\n  const guards = useGuards();\n  const [showReference, setShowReference] = useState(false);\n\n  /* No `labels` binding here. Each row derives the label it needs from the labeller itself, so a\n   * snapshot held at the top of the view could disagree with the one a row computes after a\n   * mutation ΓÇö two readings of one fact is how a stale label reaches the screen. */\n  const decisionCount = whylog.state.decisions.size;\n  const guardCount = whylog.state.guards.size;\n  const over = useMemo(() => overCapDecisions(whylog.state), [whylog.state]);\n\n  const busy = guards.status === \"running\" || guards.status === \"synthesising\";\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 16 }}>\n      <section className=\"card\">\n        <h2 className=\"card-title\">Executable decision guards</h2>\n\n        <p className=\"dim\" style={{ margin: \"0 0 12px\" }}>\n          Every important architectural decision should have a corresponding fitness function ΓÇö but\n          in every workflow the literature surveys, a human writes the check by hand, because nobody\n          has the decision in a structured enough form to generate from. Phase 1 produced that form,\n          so the checks here are <strong>compiled from your decisions</strong>, not written for\n          them. {decisionCount} decision(s), {guardCount} guard record(s).\n        </p>\n\n        {decisionCount === 0 ? (\n          <div className=\"notice notice-info\">\n            The log is empty. Import a transcript on the Import &amp; review tab first ΓÇö guards are\n            compiled from decisions, so there is nothing to compile yet.\n          </div>\n        ) : null}\n\n        <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n          <button\n            type=\"button\"\n            className=\"badge\"\n            disabled={busy || decisionCount === 0}\n            onClick={() => void guards.synthesise({ templatesOnly: true })}\n          >\n            {guards.status === \"synthesising\" ? \"CompilingΓÇª\" : \"Synthesise guards (keyless)\"}\n          </button>\n\n          <button type=\"button\" className=\"badge\" disabled={busy} onClick={() => void guards.run()}>\n            {guards.status === \"running\" ? \"RunningΓÇª\" : \"Run accepted guards\"}\n          </button>\n\n          <button\n            type=\"button\"\n            className=\"badge\"\n            disabled={busy || guards.lastRunAt === null}\n            onClick={() => guards.freeze()}\n          >\n            Freeze baseline\n          </button>\n\n          <button\n            type=\"button\"\n            className=\"badge\"\n            style={{ marginLeft: \"auto\" }}\n            onClick={() => setShowReference((previous) => !previous)}\n          >\n            {showReference ? \"Hide reference\" : \"Reference\"}\n          </button>\n        </div>\n\n        {guards.error !== null ? (\n          <div className=\"notice notice-warning\" style={{ marginTop: 12 }}>\n            {guards.error}\n          </div>\n        ) : null}\n\n        {guards.lastRunSummary !== null ? (\n          <div className=\"notice notice-info\" style={{ marginTop: 12 }}>\n            {guards.lastRunSummary}\n          </div>\n        ) : null}\n\n        {over.length > 0 ? (\n          <div className=\"notice notice-warning\" style={{ marginTop: 12 }}>\n            {over.length} decision(s) have more than the cap of {GUARDS_PER_DECISION_CAP} guards:{\" \"}\n            {over.map((entry) => `${entry.decisionId} (+${entry.over})`).join(\", \")}. The cap ranks\n            by determinism, so the least trustworthy kinds are the ones to remove.\n          </div>\n        ) : null}\n      </section>\n\n      <GateG4Card />\n\n      {guards.metricsResult !== null ? <DashboardCard /> : null}\n\n      <RunResultsCard evaluated={guards.lastEvaluated} />\n\n      <ProjectCard />\n\n      <ReviewCard />\n\n      <UnverifiableCard />\n\n      <CiExportCard />\n\n      {showReference ? <ReferenceCard /> : null}\n\n      <section className=\"card\">\n        <h2 className=\"card-title\">Store state</h2>\n        <pre className=\"mono\" style={{ whiteSpace: \"pre-wrap\", margin: 0, fontSize: 11 }}>\n          {describeGuardStore(guards)}\n        </pre>\n      </section>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Gate G4                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction GateG4Card(): ReactElement {\n  const guards = useGuards();\n  const whylog = useWhyLog();\n  const [done, setDone] = useState<string | null>(null);\n\n  const runGate = async (): Promise<void> => {\n    const steps: string[] = [];\n\n    guards.loadProject({ manifest: G4_MANIFEST, listing: G4_LISTING });\n    steps.push('1. Pasted a package.json containing \"pg\": \"^8.11.3\" and \"next\": \"^15.1.0\".');\n\n    const synthesised = await guards.synthesise({ templatesOnly: true });\n    steps.push(\n      synthesised.ok\n        ? `2. Compiled ${synthesised.value} guard(s) from the log's decisions ΓÇö templates only, no model consulted.`\n        : `2. Synthesis failed: ${synthesised.error}`,\n    );\n\n    /* Accept everything the templates produced, so the run has something to evaluate. In normal\n     * use this is a human reading each one; the gate does it in bulk because the gate is testing\n     * the LOOP, not the review. */\n    const accepted = acceptAllProposed();\n    steps.push(\n      `3. Accepted ${accepted} proposed guard(s) in bulk ΓÇö the gate tests the loop, not the review.`,\n    );\n\n    const ran = await guards.run();\n    steps.push(\n      ran.ok\n        ? `4. Ran the guards. ${ran.value} failure(s) entered REVISE() as evidence, through the same entry point a transcript uses.`\n        : `4. Run failed: ${ran.error}`,\n    );\n\n    steps.push(\n      \"5. Check below: compliance must have DROPPED, and the Reasoning tab must show a proposal whose evidence quotes the manifest line verbatim. No model was involved at any step ΓÇö the guard is a dependency lookup, the contradiction is an ontology antonym check.\",\n    );\n\n    steps.push(\n      `Decisions in log: ${whylog.state.decisions.size}. Guards: ${whylog.state.guards.size}.`,\n    );\n\n    setDone(steps.join(\"\\n\"));\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Gate G4 ΓÇö it verifies</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        Pastes a <span className=\"mono\">package.json</span> containing{\" \"}\n        <span className=\"mono\">pg</span>, compiles guards from the log's decisions, accepts them,\n        and runs them. The gate passes if compliance drops <em>and</em> a structural contradiction\n        fires ΓÇö deterministically, with no model involved at any step.\n      </p>\n\n      <button\n        type=\"button\"\n        className=\"badge\"\n        disabled={guards.status === \"running\" || guards.status === \"synthesising\"}\n        onClick={() => void runGate()}\n      >\n        Run gate G4\n      </button>\n\n      {done !== null ? (\n        <pre className=\"mono\" style={{ whiteSpace: \"pre-wrap\", margin: \"10px 0 0\", fontSize: 11 }}>\n          {done}\n        </pre>\n      ) : null}\n    </section>\n  );\n}\n\n/** Accept every proposed guard. Lives here rather than in the store because bulk-accepting is a\n *  gate-running convenience, not a product action: in normal use each guard is read first, and\n *  offering a bulk button in the review list would undermine the one rule that keeps a\n *  synthesised guard from failing on day one. */\nfunction acceptAllProposed(): number {\n  const whylog = useWhyLog.getState();\n  const guards = useGuards.getState();\n  let count = 0;\n\n  for (const guard of whylog.state.guards.values()) {\n    if (guard.lifecycle !== \"proposed\") continue;\n    if (guards.accept(guard.id).ok) count += 1;\n  }\n\n  return count;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dashboard                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction DashboardCard(): ReactElement {\n  const guards = useGuards();\n  const result = guards.metricsResult;\n\n  if (result === null) return <span />;\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Compliance dashboard</h2>\n\n      <pre\n        className=\"mono\"\n        style={{ whiteSpace: \"pre-wrap\", margin: \"0 0 12px\", fontSize: 12, lineHeight: 1.7 }}\n      >\n        {renderDashboard(result)}\n      </pre>\n\n      <div className=\"notice notice-info\" style={{ fontSize: 12 }}>\n        Compliance is computed over <strong>deterministic guards only</strong>. A judged verdict\n        cannot reach the quotient, because a score that moved when the model changed would not be a\n        measurement of the codebase. Compliance and coverage are never shown apart: a log with one\n        passing guard scores 100% compliance, so the headline number flatters itself without the\n        denominator beside it.\n      </div>\n\n      {result.compliance.baselinedOnly.length > 0 ? (\n        <div className=\"notice notice-warning\" style={{ marginTop: 10, fontSize: 12 }}>\n          {result.compliance.baselinedOnly.length} decision(s) fail only on violations the baseline\n          already knew about:{\" \"}\n          <span className=\"mono\">{result.compliance.baselinedOnly.join(\", \")}</span>. These are\n          recorded and listed, but they are not drift, and they do not fire revision proposals ΓÇö\n          firing one for a violation that predates the guard would fill the queue with things you\n          already know about.\n        </div>\n      ) : null}\n\n      {result.drift.worst !== null ? (\n        <div style={{ marginTop: 10, fontSize: 12 }}>\n          <strong>Drift age:</strong> {result.drift.worstDays} day(s) on{\" \"}\n          <span className=\"mono\">{result.drift.worst.decisionId}</span>. A failure ignored for 30\n          days is a decision you no longer hold ΓÇö either reverse it in the log or fix the code.\n        </div>\n      ) : null}\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Run results                                                                */\n/* -------------------------------------------------------------------------- */\n\nfunction RunResultsCard({ evaluated }: { evaluated: readonly EvaluatedGuard[] }): ReactElement {\n  const [showPassing, setShowPassing] = useState(false);\n\n  if (evaluated.length === 0) return <span />;\n\n  const failures = evaluated.filter((entry) => entry.result.outcome === \"fail\");\n  const skips = evaluated.filter((entry) => entry.skipped);\n  const passes = evaluated.filter((entry) => entry.result.outcome === \"pass\");\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">\n        Last run ┬╖ {failures.length} failing ┬╖ {skips.length} skipped ┬╖ {passes.length} passing\n      </h2>\n\n      {failures.length === 0 && skips.length === 0 ? (\n        <div className=\"notice notice-info\">\n          Every accepted guard passed. The code still does what the log says it does.\n        </div>\n      ) : null}\n\n      {failures.map((entry) => (\n        <FailureRow key={entry.guard.id} entry={entry} />\n      ))}\n\n      {skips.length > 0 ? (\n        <div style={{ marginTop: 12 }}>\n          <div className=\"faint\" style={{ fontSize: 11, marginBottom: 6 }}>\n            SKIPPED ΓÇö a skip is never a pass. Each says what data was missing.\n          </div>\n          {skips.map((entry) => (\n            <div key={entry.guard.id} className=\"dim\" style={{ fontSize: 12, marginBottom: 4 }}>\n              <span className=\"mono\">{entry.guard.id}</span> ({entry.guard.spec.kind}) ΓÇö{\" \"}\n              {entry.skipReason}\n            </div>\n          ))}\n        </div>\n      ) : null}\n\n      {passes.length > 0 ? (\n        <div style={{ marginTop: 12 }}>\n          <button\n            type=\"button\"\n            className=\"badge\"\n            onClick={() => setShowPassing((previous) => !previous)}\n          >\n            {showPassing ? \"Hide\" : \"Show\"} {passes.length} passing\n          </button>\n          <div className=\"faint\" style={{ fontSize: 11, marginTop: 4 }}>\n            Passing guards collapse into a count by default (┬º4.7): a list of green checks is noise\n            that hides the one red line.\n          </div>\n\n          {showPassing ? (\n            <ul style={{ margin: \"8px 0 0\", paddingLeft: 18 }}>\n              {passes.map((entry) => (\n                <li key={entry.guard.id} className=\"dim\" style={{ fontSize: 12 }}>\n                  <span className=\"mono\">{entry.guard.id}</span> ({entry.guard.spec.kind}) ΓÇö{\" \"}\n                  {entry.result.evidence}\n                </li>\n              ))}\n            </ul>\n          ) : null}\n        </div>\n      ) : null}\n    </section>\n  );\n}\n\n/**\n * The failure message is the product.\n *\n * It does the job of an ADR, a code-review comment and an onboarding document, at the exact\n * moment it is useful ΓÇö the moment someone has just installed the thing you turned down six\n * weeks ago and has no idea you turned it down.\n */\nfunction FailureRow({ entry }: { entry: EvaluatedGuard }): ReactElement {\n  const guards = useGuards();\n  const whylog = useWhyLog();\n  const [reason, setReason] = useState(\"\");\n\n  const decision = whylog.state.decisions.get(entry.guard.decisionId);\n  const labels = useMemo(() => label(whylog.state).labels, [whylog.state]);\n\n  const premises: { id: string; text: string; label: string }[] = [];\n  if (decision !== undefined) {\n    for (const justificationId of decision.justificationIds) {\n      const justification = whylog.state.justifications.get(justificationId);\n      if (justification === undefined) continue;\n      for (const premiseId of justification.inList) {\n        const premise = whylog.state.premises.get(premiseId);\n        if (premise === undefined) continue;\n        premises.push({\n          id: premiseId,\n          text: premise.text,\n          label: labels.get(premiseId)?.label ?? premise.label,\n        });\n      }\n    }\n  }\n\n  const rejected: { value: string; whyRejected?: string }[] = [];\n  if (decision !== undefined) {\n    for (const alternativeId of decision.alternativeIds) {\n      const alternative = whylog.state.alternatives.get(alternativeId);\n      if (alternative === undefined) continue;\n      rejected.push(\n        alternative.whyRejected === undefined\n          ? { value: alternative.value }\n          : { value: alternative.value, whyRejected: alternative.whyRejected },\n      );\n    }\n  }\n\n  return (\n    <div\n      style={{\n        borderLeft: `3px solid ${entry.guard.severity === \"blocking\" ? \"var(--label-out)\" : \"var(--label-unknown)\"}`,\n        padding: \"10px 12px\",\n        marginBottom: 10,\n        background: `color-mix(in srgb, ${entry.guard.severity === \"blocking\" ? \"var(--label-out)\" : \"var(--label-unknown)\"} 7%, transparent)`,\n      }}\n    >\n      <div style={{ fontSize: 13, fontWeight: 600 }}>\n        Γ£ù {entry.guard.decisionId} ΓÇö {decision?.statement ?? \"(decision not in log)\"}\n      </div>\n\n      <div className=\"mono\" style={{ fontSize: 11, marginTop: 4 }}>\n        Guard {entry.guard.id} ({entry.guard.spec.kind}) FAILED ┬╖ {entry.guard.severity}\n        {entry.newViolation ? \"\" : \" ┬╖ BASELINED (not new drift)\"}\n      </div>\n\n      <div style={{ fontSize: 12, marginTop: 6 }}>\n        <strong>Evidence:</strong> <span className=\"mono\">{entry.result.evidence}</span>\n      </div>\n\n      <div className=\"dim\" style={{ fontSize: 12, marginTop: 4 }}>\n        <strong>Why this check verifies that decision:</strong> {entry.guard.rationale}\n      </div>\n\n      <div className=\"dim\" style={{ fontSize: 12, marginTop: 4 }}>\n        Decided: {decision?.temporal.valid.slice(0, 10) ?? \"unknown\"} ┬╖ Rests on:{\" \"}\n        {premises.length === 0\n          ? \"nothing recorded ΓÇö so nothing can falsify it, which is a gap worth filling\"\n          : premises.map((p) => `${p.id} ${p.text} (${p.label})`).join(\", \")}\n      </div>\n\n      {rejected.map((alt) => (\n        <div className=\"dim\" key={alt.value} style={{ fontSize: 12, marginTop: 2 }}>\n          Rejected alternative {alt.value}\n          {alt.whyRejected === undefined\n            ? \" ΓÇö no reason recorded\"\n            : ` ΓÇö reason: \"${alt.whyRejected}\"`}\n        </div>\n      ))}\n\n      <div style={{ marginTop: 10, fontSize: 12 }}>\n        <div>ΓåÆ Is this a deliberate reversal? Record it, so the log stops claiming otherwise.</div>\n        <div>ΓåÆ Or is this drift? Undo the change, or suppress this guard with a reason.</div>\n      </div>\n\n      <div\n        style={{ display: \"flex\", gap: 8, marginTop: 10, alignItems: \"center\", flexWrap: \"wrap\" }}\n      >\n        <button\n          type=\"button\"\n          className=\"badge\"\n          onClick={() => {\n            const outcome = guards.suppress(entry.guard.id, reason);\n            if (!outcome.ok) setReason(\"\");\n          }}\n        >\n          Suppress\n        </button>\n        <input\n          value={reason}\n          onChange={(event) => setReason(event.target.value)}\n          placeholder=\"reason (required ΓÇö silencing a failing check needs a justification)\"\n          style={{ flex: 1, minWidth: 220, fontSize: 12 }}\n        />\n        <button\n          type=\"button\"\n          className=\"badge\"\n          onClick={() => guards.removeFromBaseline(entry.guard.id)}\n        >\n          Remove from baseline\n        </button>\n      </div>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The virtual project                                                        */\n/* -------------------------------------------------------------------------- */\n\nfunction ProjectCard(): ReactElement {\n  const guards = useGuards();\n  const [manifest, setManifest] = useState(\"\");\n  const [listing, setListing] = useState(\"\");\n  const [contents, setContents] = useState(\"\");\n\n  const apply = (): void => {\n    guards.loadProject({\n      ...(manifest.trim().length === 0 ? {} : { manifest }),\n      ...(listing.trim().length === 0 ? {} : { listing }),\n      ...(contents.trim().length === 0 ? {} : { contents }),\n    });\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">The virtual project</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        Guards have to run somewhere, and there is no shell or filesystem here. Paste what your\n        project looks like and the six deterministic kinds evaluate against it in memory ΓÇö real\n        logic, real data, no network. This is the designed default, not a compromise: the only thing\n        missing is automatic file discovery, which is a repo-connection concern.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 10 }}>\n        <Field\n          title=\"package.json ΓÇö or just its dependencies\"\n          hint=\"Enables dependency_present / dependency_absent, the two most reliable kinds.\"\n          value={manifest}\n          onChange={setManifest}\n          rows={6}\n        />\n        <Field\n          title=\"File listing ΓÇö `git ls-files`, `find . -type f` or `tree`\"\n          hint=\"Enables the path guards. Without it they SKIP rather than pass: absence of evidence is not evidence of absence.\"\n          value={listing}\n          onChange={setListing}\n          rows={5}\n        />\n        <Field\n          title=\"File contents (optional)\"\n          hint={\n            \"Separate files with a header line like `--- src/db/schema.ts ---`. Enables the string guards.\"\n          }\n          value={contents}\n          onChange={setContents}\n          rows={5}\n        />\n      </div>\n\n      <button type=\"button\" className=\"badge\" style={{ marginTop: 10 }} onClick={apply}>\n        Load project\n      </button>\n\n      {guards.parse !== null ? (\n        <div style={{ marginTop: 12 }}>\n          <div className=\"metric-grid\">\n            <Metric label=\"dependencies\" value={guards.parse.dependenciesParsed} />\n            <Metric label=\"dev deps\" value={guards.parse.devDependenciesParsed} />\n            <Metric label=\"files\" value={guards.parse.filesParsed} />\n            <Metric label=\"with contents\" value={guards.parse.contentsParsed} />\n          </div>\n\n          {guards.parse.notices.map((notice) => (\n            <div key={notice} className=\"dim\" style={{ fontSize: 11, marginTop: 6 }}>\n              ┬╖ {notice}\n            </div>\n          ))}\n\n          {guards.parse.unparsed.length > 0 ? (\n            <div className=\"notice notice-warning\" style={{ marginTop: 10, fontSize: 12 }}>\n              {guards.parse.unparsed.length} line(s) could not be interpreted and were KEPT rather\n              than dropped ΓÇö a parse that silently ignores a line produces a project missing a file,\n              and a missing file makes a path guard fail for a reason that has nothing to do with\n              the codebase.\n              <pre\n                className=\"mono\"\n                style={{ whiteSpace: \"pre-wrap\", margin: \"6px 0 0\", fontSize: 11 }}\n              >\n                {guards.parse.unparsed.slice(0, 8).join(\"\\n\")}\n                {guards.parse.unparsed.length > 8\n                  ? `\\nΓÇª ${guards.parse.unparsed.length - 8} more`\n                  : \"\"}\n              </pre>\n            </div>\n          ) : null}\n        </div>\n      ) : null}\n    </section>\n  );\n}\n\n/** The prop is `title`, not `label`: this file imports `label` from the labeller, and shadowing\n *  it inside a component would make `{label(...)}` mean something different two lines apart. */\nfunction Field({\n  title,\n  hint,\n  value,\n  onChange,\n  rows,\n}: {\n  title: string;\n  hint: string;\n  value: string;\n  onChange: (next: string) => void;\n  rows: number;\n}): ReactElement {\n  return (\n    <div>\n      <div className=\"faint\" style={{ fontSize: 11, marginBottom: 3 }}>\n        {title}\n      </div>\n      <textarea\n        className=\"mono\"\n        value={value}\n        rows={rows}\n        onChange={(event) => onChange(event.target.value)}\n        style={{ width: \"100%\", fontSize: 11, resize: \"vertical\" }}\n      />\n      <div className=\"faint\" style={{ fontSize: 10, marginTop: 2 }}>\n        {hint}\n      </div>\n    </div>\n  );\n}\n\nfunction Metric({ label, value }: { label: string; value: number }): ReactElement {\n  return (\n    <div className=\"metric\">\n      <div className=\"metric-label\">{label}</div>\n      <div className=\"metric-value\">{value}</div>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Review                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** Takes no labels prop: each row derives the label it needs from the labeller itself, so a\n *  snapshot passed down from the parent could disagree with the one the row computes after a\n *  mutation. Two readings of one fact is how a stale label reaches the screen. */\nfunction ReviewCard(): ReactElement {\n  const whylog = useWhyLog();\n  const _guards = useGuards();\n\n  const decisions = [...whylog.state.decisions.values()].filter(\n    (decision) => decision.status !== \"superseded\" && decision.status !== \"archived\",\n  );\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Guard review</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        No guard runs until it is accepted. A synthesised guard that fails on day one is worse than\n        no guard, because it teaches you to ignore the panel ΓÇö and a panel that gets ignored stops\n        being verification.\n      </p>\n\n      {decisions.length === 0 ? (\n        <div className=\"faint\" style={{ fontSize: 12 }}>\n          No decisions yet.\n        </div>\n      ) : null}\n\n      {decisions.map((decision) => (\n        <DecisionGuardRow key={decision.id} decisionId={decision.id} />\n      ))}\n\n      <pre\n        className=\"mono dim\"\n        style={{ whiteSpace: \"pre-wrap\", margin: \"12px 0 0\", fontSize: 11 }}\n      >\n        {describeReviewPolicy()}\n      </pre>\n    </section>\n  );\n}\n\nfunction DecisionGuardRow({ decisionId }: { decisionId: DecisionId }): ReactElement {\n  const whylog = useWhyLog();\n  const guards = useGuards();\n  const [editing, setEditing] = useState<GuardId | null>(null);\n\n  const group = guards.groupFor(decisionId);\n  const decision = whylog.state.decisions.get(decisionId);\n  const decisionLabel =\n    label(whylog.state).labels.get(decisionId)?.label ?? decision?.label ?? \"UNKNOWN\";\n\n  if (group.guards.length === 0) return <span />;\n\n  return (\n    <div style={{ borderTop: \"1px solid var(--edge-soft, #333)\", padding: \"10px 0\" }}>\n      <div style={{ display: \"flex\", gap: 8, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n        <span\n          className=\"badge\"\n          title={LABEL_MEANING[decisionLabel as keyof typeof LABEL_MEANING] ?? \"\"}\n          style={{ color: LABEL_COLOUR[decisionLabel as keyof typeof LABEL_COLOUR] ?? \"inherit\" }}\n        >\n          {decisionLabel}\n        </span>\n        <span className=\"mono\" style={{ fontSize: 12 }}>\n          {decisionId}\n        </span>\n        <span style={{ fontSize: 13, fontWeight: 600 }}>{decision?.statement}</span>\n        <span className=\"faint\" style={{ fontSize: 11, marginLeft: \"auto\" }}>\n          {group.proposed.length} proposed ┬╖ {group.accepted.length} accepted ┬╖{\" \"}\n          {group.suppressed.length} suppressed\n        </span>\n      </div>\n\n      {group.disabledByLabel ? (\n        <div className=\"notice notice-warning\" style={{ marginTop: 8, fontSize: 12 }}>\n          This decision is not labelled IN, so its guards are disabled and will not run. Guards\n          inherit their decision's label: a reversed or unsupported decision must stop nagging. They\n          re-enable automatically if the decision returns to IN.\n        </div>\n      ) : null}\n\n      {group.guards.map((guard) => {\n        const disabled = guards.disabledReason(guard.id);\n\n        return (\n          <div\n            key={guard.id}\n            style={{\n              marginTop: 8,\n              paddingLeft: 10,\n              borderLeft: \"2px solid var(--edge-soft, #444)\",\n            }}\n          >\n            <div style={{ display: \"flex\", gap: 6, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n              <span className=\"mono\" style={{ fontSize: 11 }}>\n                {guard.id}\n              </span>\n              <span className=\"badge\">{guard.spec.kind}</span>\n              <span\n                className=\"badge\"\n                style={{\n                  color:\n                    guard.severity === \"blocking\" ? \"var(--label-out)\" : \"var(--label-unknown)\",\n                }}\n              >\n                {guard.severity}\n              </span>\n              <span className=\"badge\">{guard.lifecycle}</span>\n              <span className=\"faint\" style={{ fontSize: 11 }}>\n                by {guard.generatedBy}\n              </span>\n              {guard.lastRun !== undefined ? (\n                <span className=\"faint mono\" style={{ fontSize: 11 }}>\n                  last run: {guard.lastRun.outcome}\n                </span>\n              ) : null}\n            </div>\n\n            <div className=\"mono\" style={{ fontSize: 11, marginTop: 3 }}>\n              {describeSpec(guard.spec)}\n            </div>\n\n            <div className=\"dim\" style={{ fontSize: 12, marginTop: 3 }}>\n              {guard.rationale}\n            </div>\n\n            {disabled !== null ? (\n              <div className=\"faint\" style={{ fontSize: 11, marginTop: 3 }}>\n                ΓÅ╕ {disabled}\n              </div>\n            ) : null}\n\n            {guard.suppressionReason !== undefined ? (\n              <div className=\"faint\" style={{ fontSize: 11, marginTop: 3 }}>\n                Suppressed: {guard.suppressionReason}\n              </div>\n            ) : null}\n\n            <div style={{ display: \"flex\", gap: 6, marginTop: 6, flexWrap: \"wrap\" }}>\n              {guard.lifecycle === \"proposed\" ? (\n                <button type=\"button\" className=\"badge\" onClick={() => guards.accept(guard.id)}>\n                  Accept\n                </button>\n              ) : null}\n\n              {guard.lifecycle !== \"deleted\" ? (\n                <>\n                  <button type=\"button\" className=\"badge\" onClick={() => setEditing(guard.id)}>\n                    {editing === guard.id ? \"Close editor\" : \"Edit\"}\n                  </button>\n                  <button\n                    type=\"button\"\n                    className=\"badge\"\n                    onClick={() => guards.remove(guard.id, \"\")}\n                  >\n                    Delete\n                  </button>\n                </>\n              ) : null}\n            </div>\n\n            {editing === guard.id ? (\n              <EditForm\n                guardId={guard.id}\n                spec={guard.spec}\n                rationale={guard.rationale}\n                severity={guard.severity}\n                onDone={() => setEditing(null)}\n              />\n            ) : null}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\nfunction EditForm({\n  guardId,\n  spec,\n  rationale,\n  severity,\n  onDone,\n}: {\n  guardId: GuardId;\n  spec: GuardSpec;\n  rationale: string;\n  severity: GuardSeverity;\n  onDone: () => void;\n}): ReactElement {\n  const guards = useGuards();\n  const [text, setText] = useState(specToJson(spec));\n  const [why, setWhy] = useState(rationale);\n  const [level, setLevel] = useState<GuardSeverity>(severity);\n  const [error, setError] = useState<string | null>(null);\n\n  const save = (): void => {\n    let parsed: unknown;\n    try {\n      parsed = JSON.parse(text);\n    } catch {\n      setError(\"That is not valid JSON.\");\n      return;\n    }\n\n    if (parsed === null || typeof parsed !== \"object\") {\n      setError(\"The spec must be a JSON object.\");\n      return;\n    }\n\n    const candidate = parsed as GuardSpec;\n    if (typeof candidate.kind !== \"string\") {\n      setError('The spec needs a \"kind\" ΓÇö one of the eight in the taxonomy.');\n      return;\n    }\n\n    const outcome = guards.edit(guardId, candidate, why, level);\n    if (!outcome.ok) {\n      setError(outcome.error);\n      return;\n    }\n\n    setError(null);\n    onDone();\n  };\n\n  return (\n    <div style={{ marginTop: 8 }}>\n      <div className=\"notice notice-warning\" style={{ fontSize: 11 }}>\n        Editing is <strong>delete + re-synthesise</strong>, recorded as two events. The closed\n        vocabulary has no edit event, and adding one would let a spec change without a record of the\n        spec it replaced ΓÇö a guard quietly weakened after it started failing would be\n        indistinguishable from one that was fixed. The replacement is PROPOSED again: an edit does\n        not inherit acceptance, because that would activate a check nobody reviewed.\n      </div>\n\n      <textarea\n        className=\"mono\"\n        value={text}\n        rows={5}\n        onChange={(event) => setText(event.target.value)}\n        style={{ width: \"100%\", fontSize: 11, marginTop: 8 }}\n      />\n\n      <input\n        value={why}\n        onChange={(event) => setWhy(event.target.value)}\n        placeholder=\"rationale ΓÇö mandatory; a guard without one is indistinguishable from a lint rule\"\n        style={{ width: \"100%\", fontSize: 12, marginTop: 6 }}\n      />\n\n      <div style={{ display: \"flex\", gap: 8, marginTop: 6, alignItems: \"center\" }}>\n        <select\n          value={level}\n          onChange={(event) => setLevel(event.target.value as GuardSeverity)}\n          style={{ fontSize: 12 }}\n        >\n          <option value=\"blocking\">blocking ΓÇö fails the build</option>\n          <option value=\"warning\">warning ΓÇö advisory</option>\n        </select>\n\n        <button type=\"button\" className=\"badge\" onClick={save}>\n          Save as new guard\n        </button>\n      </div>\n\n      {error !== null ? (\n        <div className=\"notice notice-error\" style={{ marginTop: 6, fontSize: 12 }}>\n          {error}\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nfunction specToJson(spec: GuardSpec): string {\n  return JSON.stringify(spec, null, 2);\n}\n\nfunction describeSpec(spec: GuardSpec): string {\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\":\n      return spec.package + (spec.includeDev === true ? \" (including devDependencies)\" : \"\");\n    case \"path_glob_exists\":\n    case \"path_glob_absent\":\n      return spec.glob;\n    case \"string_in_files\":\n    case \"string_absent_in_files\":\n      return `${JSON.stringify(spec.pattern)} within ${spec.glob}${spec.wordBoundary === false ? \", no word boundary\" : \", word-boundary matched\"}`;\n    case \"command_exit_zero\":\n      return spec.command;\n    case \"llm_judge\":\n      return `rubric over ${spec.scopeGlobs.join(\", \")}`;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Unverifiable                                                               */\n/* -------------------------------------------------------------------------- */\n\nfunction UnverifiableCard(): ReactElement {\n  const guards = useGuards();\n\n  if (guards.unverifiable.length === 0) return <span />;\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Unverifiable ┬╖ {guards.unverifiable.length} decision(s)</h2>\n\n      <div className=\"notice notice-warning\" style={{ fontSize: 12 }}>\n        No guard could be compiled for these. They are SHOWN, never silently skipped: the\n        literature's own test is whether you can describe what a violation looks like, and for these\n        you cannot yet. Unverifiable decisions are exactly the ones most likely to drift, because\n        nothing would tell you if they did ΓÇö and a compliance score computed only over the decisions\n        that happened to be checkable is a score that flatters itself.\n      </div>\n\n      <ul style={{ margin: \"10px 0 0\", paddingLeft: 18 }}>\n        {guards.unverifiable.map((entry) => (\n          <li key={entry.decisionId} style={{ fontSize: 12, marginBottom: 6 }}>\n            <span className=\"mono\">{entry.decisionId}</span> ΓÇö {entry.reason}\n          </li>\n        ))}\n      </ul>\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* CI export                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction CiExportCard(): ReactElement {\n  const guards = useGuards();\n  const [output, setOutput] = useState<{\n    runner: string;\n    workflow: string;\n    summary: string;\n  } | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [which, setWhich] = useState<\"runner\" | \"workflow\">(\"runner\");\n\n  const generate = (): void => {\n    const result = guards.exportForCi();\n    if (!result.ok) {\n      setError(result.error);\n      setOutput(null);\n      return;\n    }\n    setError(null);\n    setOutput(result.value);\n  };\n\n  const download = (): void => {\n    if (output === null) return;\n\n    const name = which === \"runner\" ? \"guards.cjs\" : \"decision-guards.yml\";\n    const text = which === \"runner\" ? output.runner : output.workflow;\n    const blob = new Blob([text], { type: \"text/plain\" });\n    const url = URL.createObjectURL(blob);\n    const anchor = document.createElement(\"a\");\n    anchor.href = url;\n    anchor.download = name;\n    anchor.click();\n    URL.revokeObjectURL(url);\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">CI export</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        A standalone Node runner (standard library only ΓÇö no install step) and a GitHub Actions\n        workflow. The exported runner evaluates the same six predicates as the interpreter here, and\n        the guard set is serialised as data rather than regenerated, so the two cannot drift apart\n        by having been written twice.\n      </p>\n\n      <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n        <button type=\"button\" className=\"badge\" onClick={generate}>\n          Generate\n        </button>\n\n        {output !== null ? (\n          <>\n            <button type=\"button\" className=\"badge\" onClick={() => setWhich(\"runner\")}>\n              {which === \"runner\" ? \"ΓÇó guards.cjs\" : \"guards.cjs\"}\n            </button>\n            <button type=\"button\" className=\"badge\" onClick={() => setWhich(\"workflow\")}>\n              {which === \"workflow\" ? \"ΓÇó decision-guards.yml\" : \"decision-guards.yml\"}\n            </button>\n            <button type=\"button\" className=\"badge\" onClick={download}>\n              Download\n            </button>\n          </>\n        ) : null}\n      </div>\n\n      {error !== null ? (\n        <div className=\"notice notice-warning\" style={{ marginTop: 10, fontSize: 12 }}>\n          {error}\n        </div>\n      ) : null}\n\n      {output !== null ? (\n        <>\n          <pre\n            className=\"mono dim\"\n            style={{ whiteSpace: \"pre-wrap\", margin: \"10px 0 0\", fontSize: 11 }}\n          >\n            {output.summary}\n          </pre>\n          <pre\n            className=\"mono\"\n            style={{\n              whiteSpace: \"pre-wrap\",\n              margin: \"10px 0 0\",\n              fontSize: 10,\n              maxHeight: 320,\n              overflow: \"auto\",\n              borderTop: \"1px solid var(--edge-soft, #333)\",\n              paddingTop: 8,\n            }}\n          >\n            {which === \"runner\" ? output.runner : output.workflow}\n          </pre>\n        </>\n      ) : null}\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reference                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction ReferenceCard(): ReactElement {\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Reference</h2>\n\n      <Block title=\"The eight guard kinds\" body={describeTaxonomy()} />\n      <Block title=\"Guards as evidence ΓÇö the feedback loop\" body={describeFeedbackLoop()} />\n      <Block title=\"Review policy\" body={describeReviewPolicy()} />\n    </section>\n  );\n}\n\nfunction Block({ title, body }: { title: string; body: string }): ReactElement {\n  return (\n    <div style={{ marginBottom: 14 }}>\n      <h3 style={{ margin: \"0 0 6px\", fontSize: 13 }}>{title}</h3>\n      <pre className=\"mono dim\" style={{ whiteSpace: \"pre-wrap\", margin: 0, fontSize: 11 }}>\n        {body}\n      </pre>\n    </div>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\GuardsView.tsx"},"span":[29880,29883],"sourceCode":"/**\n * The Guards view ΓÇö 4.7, and the surface for gate G4.\n *\n * Phase 4 ┬╖ sub-phases 4.2ΓÇô4.7\n * Plan: plan/phase-4-executable-guards.md\n *\n * ---------------------------------------------------------------------------\n * THE FIVE THINGS THIS VIEW HAS TO MAKE VISIBLE\n *\n *   1. what the guards were COMPILED FROM ΓÇö the decision, its rejected alternatives and its\n *      globs. A guard whose origin you cannot see is a lint rule.\n *   2. that nothing runs until a human accepts it ΓÇö the proposed list is the default state.\n *   3. WHY each guard is disabled or skipped, every time. A disabled guard with no explanation\n *      reads as a broken one, and a skip that looks like a pass is the failure mode that makes\n *      a compliance score meaningless.\n *   4. the five metrics together. Compliance without coverage is a number that flatters itself:\n *      a log with one passing guard scores 100%.\n *   5. the unverifiable decisions. Silence is never the answer ΓÇö they are the ones most likely\n *      to drift, because nothing would tell you if they did.\n *\n * ---------------------------------------------------------------------------\n * COLOUR ENCODES EPISTEMIC STATUS, NEVER SEVERITY\n *\n * The house rule from Phase 0. A `blocking` failure is not redder than a `warning` one because\n * it is more important ΓÇö it is marked differently because it fails the build. And an\n * unverifiable decision is not an error: it is an honest gap, rendered as a gap.\n *\n * ---------------------------------------------------------------------------\n * GATE G4 IS A BUTTON\n *\n * \"Pasting a package.json containing `pg` drops compliance and fires a structural contradiction\n * with no model involved.\" That is checkable in one click here, and a gate the user has to\n * reconstruct from the plan is a gate that does not get run.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  GUARDS_PER_DECISION_CAP,\n  describeFeedbackLoop,\n  describeReviewPolicy,\n  describeTaxonomy,\n  renderDashboard,\n} from \"@/guards\";\nimport type { EvaluatedGuard } from \"@/guards\";\nimport { label } from \"@/reasoning/labeller\";\nimport { describeGuardStore, overCapDecisions, useGuards } from \"@/store/guards\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { LABEL_COLOUR, LABEL_MEANING } from \"@/theme\";\nimport type { DecisionId, GuardId } from \"@/types/common\";\nimport type { GuardSeverity, GuardSpec } from \"@/types/guards\";\nimport { type ReactElement, useMemo, useState } from \"react\";\n\n/* -------------------------------------------------------------------------- */\n/* Gate G4                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The manifest G4 is defined by.\n *\n * It contains `pg` and `next` ΓÇö one violating a DATABASE decision that rejected Postgres, one\n * violating a FRAMEWORK decision that chose Vite. Pasting it into a log holding the demo\n * fixture's decisions must drop compliance and fire a structural contradiction, with no model\n * involved at any point: the guard is a dependency lookup, the contradiction is an ontology\n * antonym check, and the proposal comes from the deterministic reasoning cycle.\n */\nconst G4_MANIFEST = `{\n  \"name\": \"whylog-demo\",\n  \"version\": \"0.1.0\",\n  \"dependencies\": {\n    \"better-sqlite3\": \"^11.3.0\",\n    \"pg\": \"^8.11.3\",\n    \"react\": \"^18.3.1\"\n  },\n  \"devDependencies\": {\n    \"next\": \"^15.1.0\",\n    \"vite\": \"^6.0.0\",\n    \"typescript\": \"^5.6.0\"\n  }\n}`;\n\nconst G4_LISTING = `src/db/schema.ts\nsrc/db/client.ts\nsrc/main.tsx\npackage.json\nvite.config.ts\nnext.config.js`;\n\n/* -------------------------------------------------------------------------- */\n/* The view                                                                   */\n/* -------------------------------------------------------------------------- */\n\nexport function GuardsView(): ReactElement {\n  const whylog = useWhyLog();\n  const guards = useGuards();\n  const [showReference, setShowReference] = useState(false);\n\n  /* No `labels` binding here. Each row derives the label it needs from the labeller itself, so a\n   * snapshot held at the top of the view could disagree with the one a row computes after a\n   * mutation ΓÇö two readings of one fact is how a stale label reaches the screen. */\n  const decisionCount = whylog.state.decisions.size;\n  const guardCount = whylog.state.guards.size;\n  const over = useMemo(() => overCapDecisions(whylog.state), [whylog.state]);\n\n  const busy = guards.status === \"running\" || guards.status === \"synthesising\";\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 16 }}>\n      <section className=\"card\">\n        <h2 className=\"card-title\">Executable decision guards</h2>\n\n        <p className=\"dim\" style={{ margin: \"0 0 12px\" }}>\n          Every important architectural decision should have a corresponding fitness function ΓÇö but\n          in every workflow the literature surveys, a human writes the check by hand, because nobody\n          has the decision in a structured enough form to generate from. Phase 1 produced that form,\n          so the checks here are <strong>compiled from your decisions</strong>, not written for\n          them. {decisionCount} decision(s), {guardCount} guard record(s).\n        </p>\n\n        {decisionCount === 0 ? (\n          <div className=\"notice notice-info\">\n            The log is empty. Import a transcript on the Import &amp; review tab first ΓÇö guards are\n            compiled from decisions, so there is nothing to compile yet.\n          </div>\n        ) : null}\n\n        <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n          <button\n            type=\"button\"\n            className=\"badge\"\n            disabled={busy || decisionCount === 0}\n            onClick={() => void guards.synthesise({ templatesOnly: true })}\n          >\n            {guards.status === \"synthesising\" ? \"CompilingΓÇª\" : \"Synthesise guards (keyless)\"}\n          </button>\n\n          <button type=\"button\" className=\"badge\" disabled={busy} onClick={() => void guards.run()}>\n            {guards.status === \"running\" ? \"RunningΓÇª\" : \"Run accepted guards\"}\n          </button>\n\n          <button\n            type=\"button\"\n            className=\"badge\"\n            disabled={busy || guards.lastRunAt === null}\n            onClick={() => guards.freeze()}\n          >\n            Freeze baseline\n          </button>\n\n          <button\n            type=\"button\"\n            className=\"badge\"\n            style={{ marginLeft: \"auto\" }}\n            onClick={() => setShowReference((previous) => !previous)}\n          >\n            {showReference ? \"Hide reference\" : \"Reference\"}\n          </button>\n        </div>\n\n        {guards.error !== null ? (\n          <div className=\"notice notice-warning\" style={{ marginTop: 12 }}>\n            {guards.error}\n          </div>\n        ) : null}\n\n        {guards.lastRunSummary !== null ? (\n          <div className=\"notice notice-info\" style={{ marginTop: 12 }}>\n            {guards.lastRunSummary}\n          </div>\n        ) : null}\n\n        {over.length > 0 ? (\n          <div className=\"notice notice-warning\" style={{ marginTop: 12 }}>\n            {over.length} decision(s) have more than the cap of {GUARDS_PER_DECISION_CAP} guards:{\" \"}\n            {over.map((entry) => `${entry.decisionId} (+${entry.over})`).join(\", \")}. The cap ranks\n            by determinism, so the least trustworthy kinds are the ones to remove.\n          </div>\n        ) : null}\n      </section>\n\n      <GateG4Card />\n\n      {guards.metricsResult !== null ? <DashboardCard /> : null}\n\n      <RunResultsCard evaluated={guards.lastEvaluated} />\n\n      <ProjectCard />\n\n      <ReviewCard />\n\n      <UnverifiableCard />\n\n      <CiExportCard />\n\n      {showReference ? <ReferenceCard /> : null}\n\n      <section className=\"card\">\n        <h2 className=\"card-title\">Store state</h2>\n        <pre className=\"mono\" style={{ whiteSpace: \"pre-wrap\", margin: 0, fontSize: 11 }}>\n          {describeGuardStore(guards)}\n        </pre>\n      </section>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Gate G4                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction GateG4Card(): ReactElement {\n  const guards = useGuards();\n  const whylog = useWhyLog();\n  const [done, setDone] = useState<string | null>(null);\n\n  const runGate = async (): Promise<void> => {\n    const steps: string[] = [];\n\n    guards.loadProject({ manifest: G4_MANIFEST, listing: G4_LISTING });\n    steps.push('1. Pasted a package.json containing \"pg\": \"^8.11.3\" and \"next\": \"^15.1.0\".');\n\n    const synthesised = await guards.synthesise({ templatesOnly: true });\n    steps.push(\n      synthesised.ok\n        ? `2. Compiled ${synthesised.value} guard(s) from the log's decisions ΓÇö templates only, no model consulted.`\n        : `2. Synthesis failed: ${synthesised.error}`,\n    );\n\n    /* Accept everything the templates produced, so the run has something to evaluate. In normal\n     * use this is a human reading each one; the gate does it in bulk because the gate is testing\n     * the LOOP, not the review. */\n    const accepted = acceptAllProposed();\n    steps.push(\n      `3. Accepted ${accepted} proposed guard(s) in bulk ΓÇö the gate tests the loop, not the review.`,\n    );\n\n    const ran = await guards.run();\n    steps.push(\n      ran.ok\n        ? `4. Ran the guards. ${ran.value} failure(s) entered REVISE() as evidence, through the same entry point a transcript uses.`\n        : `4. Run failed: ${ran.error}`,\n    );\n\n    steps.push(\n      \"5. Check below: compliance must have DROPPED, and the Reasoning tab must show a proposal whose evidence quotes the manifest line verbatim. No model was involved at any step ΓÇö the guard is a dependency lookup, the contradiction is an ontology antonym check.\",\n    );\n\n    steps.push(\n      `Decisions in log: ${whylog.state.decisions.size}. Guards: ${whylog.state.guards.size}.`,\n    );\n\n    setDone(steps.join(\"\\n\"));\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Gate G4 ΓÇö it verifies</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        Pastes a <span className=\"mono\">package.json</span> containing{\" \"}\n        <span className=\"mono\">pg</span>, compiles guards from the log's decisions, accepts them,\n        and runs them. The gate passes if compliance drops <em>and</em> a structural contradiction\n        fires ΓÇö deterministically, with no model involved at any step.\n      </p>\n\n      <button\n        type=\"button\"\n        className=\"badge\"\n        disabled={guards.status === \"running\" || guards.status === \"synthesising\"}\n        onClick={() => void runGate()}\n      >\n        Run gate G4\n      </button>\n\n      {done !== null ? (\n        <pre className=\"mono\" style={{ whiteSpace: \"pre-wrap\", margin: \"10px 0 0\", fontSize: 11 }}>\n          {done}\n        </pre>\n      ) : null}\n    </section>\n  );\n}\n\n/** Accept every proposed guard. Lives here rather than in the store because bulk-accepting is a\n *  gate-running convenience, not a product action: in normal use each guard is read first, and\n *  offering a bulk button in the review list would undermine the one rule that keeps a\n *  synthesised guard from failing on day one. */\nfunction acceptAllProposed(): number {\n  const whylog = useWhyLog.getState();\n  const guards = useGuards.getState();\n  let count = 0;\n\n  for (const guard of whylog.state.guards.values()) {\n    if (guard.lifecycle !== \"proposed\") continue;\n    if (guards.accept(guard.id).ok) count += 1;\n  }\n\n  return count;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dashboard                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction DashboardCard(): ReactElement {\n  const guards = useGuards();\n  const result = guards.metricsResult;\n\n  if (result === null) return <span />;\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Compliance dashboard</h2>\n\n      <pre\n        className=\"mono\"\n        style={{ whiteSpace: \"pre-wrap\", margin: \"0 0 12px\", fontSize: 12, lineHeight: 1.7 }}\n      >\n        {renderDashboard(result)}\n      </pre>\n\n      <div className=\"notice notice-info\" style={{ fontSize: 12 }}>\n        Compliance is computed over <strong>deterministic guards only</strong>. A judged verdict\n        cannot reach the quotient, because a score that moved when the model changed would not be a\n        measurement of the codebase. Compliance and coverage are never shown apart: a log with one\n        passing guard scores 100% compliance, so the headline number flatters itself without the\n        denominator beside it.\n      </div>\n\n      {result.compliance.baselinedOnly.length > 0 ? (\n        <div className=\"notice notice-warning\" style={{ marginTop: 10, fontSize: 12 }}>\n          {result.compliance.baselinedOnly.length} decision(s) fail only on violations the baseline\n          already knew about:{\" \"}\n          <span className=\"mono\">{result.compliance.baselinedOnly.join(\", \")}</span>. These are\n          recorded and listed, but they are not drift, and they do not fire revision proposals ΓÇö\n          firing one for a violation that predates the guard would fill the queue with things you\n          already know about.\n        </div>\n      ) : null}\n\n      {result.drift.worst !== null ? (\n        <div style={{ marginTop: 10, fontSize: 12 }}>\n          <strong>Drift age:</strong> {result.drift.worstDays} day(s) on{\" \"}\n          <span className=\"mono\">{result.drift.worst.decisionId}</span>. A failure ignored for 30\n          days is a decision you no longer hold ΓÇö either reverse it in the log or fix the code.\n        </div>\n      ) : null}\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Run results                                                                */\n/* -------------------------------------------------------------------------- */\n\nfunction RunResultsCard({ evaluated }: { evaluated: readonly EvaluatedGuard[] }): ReactElement {\n  const [showPassing, setShowPassing] = useState(false);\n\n  if (evaluated.length === 0) return <span />;\n\n  const failures = evaluated.filter((entry) => entry.result.outcome === \"fail\");\n  const skips = evaluated.filter((entry) => entry.skipped);\n  const passes = evaluated.filter((entry) => entry.result.outcome === \"pass\");\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">\n        Last run ┬╖ {failures.length} failing ┬╖ {skips.length} skipped ┬╖ {passes.length} passing\n      </h2>\n\n      {failures.length === 0 && skips.length === 0 ? (\n        <div className=\"notice notice-info\">\n          Every accepted guard passed. The code still does what the log says it does.\n        </div>\n      ) : null}\n\n      {failures.map((entry) => (\n        <FailureRow key={entry.guard.id} entry={entry} />\n      ))}\n\n      {skips.length > 0 ? (\n        <div style={{ marginTop: 12 }}>\n          <div className=\"faint\" style={{ fontSize: 11, marginBottom: 6 }}>\n            SKIPPED ΓÇö a skip is never a pass. Each says what data was missing.\n          </div>\n          {skips.map((entry) => (\n            <div key={entry.guard.id} className=\"dim\" style={{ fontSize: 12, marginBottom: 4 }}>\n              <span className=\"mono\">{entry.guard.id}</span> ({entry.guard.spec.kind}) ΓÇö{\" \"}\n              {entry.skipReason}\n            </div>\n          ))}\n        </div>\n      ) : null}\n\n      {passes.length > 0 ? (\n        <div style={{ marginTop: 12 }}>\n          <button\n            type=\"button\"\n            className=\"badge\"\n            onClick={() => setShowPassing((previous) => !previous)}\n          >\n            {showPassing ? \"Hide\" : \"Show\"} {passes.length} passing\n          </button>\n          <div className=\"faint\" style={{ fontSize: 11, marginTop: 4 }}>\n            Passing guards collapse into a count by default (┬º4.7): a list of green checks is noise\n            that hides the one red line.\n          </div>\n\n          {showPassing ? (\n            <ul style={{ margin: \"8px 0 0\", paddingLeft: 18 }}>\n              {passes.map((entry) => (\n                <li key={entry.guard.id} className=\"dim\" style={{ fontSize: 12 }}>\n                  <span className=\"mono\">{entry.guard.id}</span> ({entry.guard.spec.kind}) ΓÇö{\" \"}\n                  {entry.result.evidence}\n                </li>\n              ))}\n            </ul>\n          ) : null}\n        </div>\n      ) : null}\n    </section>\n  );\n}\n\n/**\n * The failure message is the product.\n *\n * It does the job of an ADR, a code-review comment and an onboarding document, at the exact\n * moment it is useful ΓÇö the moment someone has just installed the thing you turned down six\n * weeks ago and has no idea you turned it down.\n */\nfunction FailureRow({ entry }: { entry: EvaluatedGuard }): ReactElement {\n  const guards = useGuards();\n  const whylog = useWhyLog();\n  const [reason, setReason] = useState(\"\");\n\n  const decision = whylog.state.decisions.get(entry.guard.decisionId);\n  const labels = useMemo(() => label(whylog.state).labels, [whylog.state]);\n\n  const premises: { id: string; text: string; label: string }[] = [];\n  if (decision !== undefined) {\n    for (const justificationId of decision.justificationIds) {\n      const justification = whylog.state.justifications.get(justificationId);\n      if (justification === undefined) continue;\n      for (const premiseId of justification.inList) {\n        const premise = whylog.state.premises.get(premiseId);\n        if (premise === undefined) continue;\n        premises.push({\n          id: premiseId,\n          text: premise.text,\n          label: labels.get(premiseId)?.label ?? premise.label,\n        });\n      }\n    }\n  }\n\n  const rejected: { value: string; whyRejected?: string }[] = [];\n  if (decision !== undefined) {\n    for (const alternativeId of decision.alternativeIds) {\n      const alternative = whylog.state.alternatives.get(alternativeId);\n      if (alternative === undefined) continue;\n      rejected.push(\n        alternative.whyRejected === undefined\n          ? { value: alternative.value }\n          : { value: alternative.value, whyRejected: alternative.whyRejected },\n      );\n    }\n  }\n\n  return (\n    <div\n      style={{\n        borderLeft: `3px solid ${entry.guard.severity === \"blocking\" ? \"var(--label-out)\" : \"var(--label-unknown)\"}`,\n        padding: \"10px 12px\",\n        marginBottom: 10,\n        background: `color-mix(in srgb, ${entry.guard.severity === \"blocking\" ? \"var(--label-out)\" : \"var(--label-unknown)\"} 7%, transparent)`,\n      }}\n    >\n      <div style={{ fontSize: 13, fontWeight: 600 }}>\n        Γ£ù {entry.guard.decisionId} ΓÇö {decision?.statement ?? \"(decision not in log)\"}\n      </div>\n\n      <div className=\"mono\" style={{ fontSize: 11, marginTop: 4 }}>\n        Guard {entry.guard.id} ({entry.guard.spec.kind}) FAILED ┬╖ {entry.guard.severity}\n        {entry.newViolation ? \"\" : \" ┬╖ BASELINED (not new drift)\"}\n      </div>\n\n      <div style={{ fontSize: 12, marginTop: 6 }}>\n        <strong>Evidence:</strong> <span className=\"mono\">{entry.result.evidence}</span>\n      </div>\n\n      <div className=\"dim\" style={{ fontSize: 12, marginTop: 4 }}>\n        <strong>Why this check verifies that decision:</strong> {entry.guard.rationale}\n      </div>\n\n      <div className=\"dim\" style={{ fontSize: 12, marginTop: 4 }}>\n        Decided: {decision?.temporal.valid.slice(0, 10) ?? \"unknown\"} ┬╖ Rests on:{\" \"}\n        {premises.length === 0\n          ? \"nothing recorded ΓÇö so nothing can falsify it, which is a gap worth filling\"\n          : premises.map((p) => `${p.id} ${p.text} (${p.label})`).join(\", \")}\n      </div>\n\n      {rejected.map((alt) => (\n        <div className=\"dim\" key={alt.value} style={{ fontSize: 12, marginTop: 2 }}>\n          Rejected alternative {alt.value}\n          {alt.whyRejected === undefined\n            ? \" ΓÇö no reason recorded\"\n            : ` ΓÇö reason: \"${alt.whyRejected}\"`}\n        </div>\n      ))}\n\n      <div style={{ marginTop: 10, fontSize: 12 }}>\n        <div>ΓåÆ Is this a deliberate reversal? Record it, so the log stops claiming otherwise.</div>\n        <div>ΓåÆ Or is this drift? Undo the change, or suppress this guard with a reason.</div>\n      </div>\n\n      <div\n        style={{ display: \"flex\", gap: 8, marginTop: 10, alignItems: \"center\", flexWrap: \"wrap\" }}\n      >\n        <button\n          type=\"button\"\n          className=\"badge\"\n          onClick={() => {\n            const outcome = guards.suppress(entry.guard.id, reason);\n            if (!outcome.ok) setReason(\"\");\n          }}\n        >\n          Suppress\n        </button>\n        <input\n          value={reason}\n          onChange={(event) => setReason(event.target.value)}\n          placeholder=\"reason (required ΓÇö silencing a failing check needs a justification)\"\n          style={{ flex: 1, minWidth: 220, fontSize: 12 }}\n        />\n        <button\n          type=\"button\"\n          className=\"badge\"\n          onClick={() => guards.removeFromBaseline(entry.guard.id)}\n        >\n          Remove from baseline\n        </button>\n      </div>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The virtual project                                                        */\n/* -------------------------------------------------------------------------- */\n\nfunction ProjectCard(): ReactElement {\n  const guards = useGuards();\n  const [manifest, setManifest] = useState(\"\");\n  const [listing, setListing] = useState(\"\");\n  const [contents, setContents] = useState(\"\");\n\n  const apply = (): void => {\n    guards.loadProject({\n      ...(manifest.trim().length === 0 ? {} : { manifest }),\n      ...(listing.trim().length === 0 ? {} : { listing }),\n      ...(contents.trim().length === 0 ? {} : { contents }),\n    });\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">The virtual project</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        Guards have to run somewhere, and there is no shell or filesystem here. Paste what your\n        project looks like and the six deterministic kinds evaluate against it in memory ΓÇö real\n        logic, real data, no network. This is the designed default, not a compromise: the only thing\n        missing is automatic file discovery, which is a repo-connection concern.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 10 }}>\n        <Field\n          title=\"package.json ΓÇö or just its dependencies\"\n          hint=\"Enables dependency_present / dependency_absent, the two most reliable kinds.\"\n          value={manifest}\n          onChange={setManifest}\n          rows={6}\n        />\n        <Field\n          title=\"File listing ΓÇö `git ls-files`, `find . -type f` or `tree`\"\n          hint=\"Enables the path guards. Without it they SKIP rather than pass: absence of evidence is not evidence of absence.\"\n          value={listing}\n          onChange={setListing}\n          rows={5}\n        />\n        <Field\n          title=\"File contents (optional)\"\n          hint={\n            \"Separate files with a header line like `--- src/db/schema.ts ---`. Enables the string guards.\"\n          }\n          value={contents}\n          onChange={setContents}\n          rows={5}\n        />\n      </div>\n\n      <button type=\"button\" className=\"badge\" style={{ marginTop: 10 }} onClick={apply}>\n        Load project\n      </button>\n\n      {guards.parse !== null ? (\n        <div style={{ marginTop: 12 }}>\n          <div className=\"metric-grid\">\n            <Metric label=\"dependencies\" value={guards.parse.dependenciesParsed} />\n            <Metric label=\"dev deps\" value={guards.parse.devDependenciesParsed} />\n            <Metric label=\"files\" value={guards.parse.filesParsed} />\n            <Metric label=\"with contents\" value={guards.parse.contentsParsed} />\n          </div>\n\n          {guards.parse.notices.map((notice) => (\n            <div key={notice} className=\"dim\" style={{ fontSize: 11, marginTop: 6 }}>\n              ┬╖ {notice}\n            </div>\n          ))}\n\n          {guards.parse.unparsed.length > 0 ? (\n            <div className=\"notice notice-warning\" style={{ marginTop: 10, fontSize: 12 }}>\n              {guards.parse.unparsed.length} line(s) could not be interpreted and were KEPT rather\n              than dropped ΓÇö a parse that silently ignores a line produces a project missing a file,\n              and a missing file makes a path guard fail for a reason that has nothing to do with\n              the codebase.\n              <pre\n                className=\"mono\"\n                style={{ whiteSpace: \"pre-wrap\", margin: \"6px 0 0\", fontSize: 11 }}\n              >\n                {guards.parse.unparsed.slice(0, 8).join(\"\\n\")}\n                {guards.parse.unparsed.length > 8\n                  ? `\\nΓÇª ${guards.parse.unparsed.length - 8} more`\n                  : \"\"}\n              </pre>\n            </div>\n          ) : null}\n        </div>\n      ) : null}\n    </section>\n  );\n}\n\n/** The prop is `title`, not `label`: this file imports `label` from the labeller, and shadowing\n *  it inside a component would make `{label(...)}` mean something different two lines apart. */\nfunction Field({\n  title,\n  hint,\n  value,\n  onChange,\n  rows,\n}: {\n  title: string;\n  hint: string;\n  value: string;\n  onChange: (next: string) => void;\n  rows: number;\n}): ReactElement {\n  return (\n    <div>\n      <div className=\"faint\" style={{ fontSize: 11, marginBottom: 3 }}>\n        {title}\n      </div>\n      <textarea\n        className=\"mono\"\n        value={value}\n        rows={rows}\n        onChange={(event) => onChange(event.target.value)}\n        style={{ width: \"100%\", fontSize: 11, resize: \"vertical\" }}\n      />\n      <div className=\"faint\" style={{ fontSize: 10, marginTop: 2 }}>\n        {hint}\n      </div>\n    </div>\n  );\n}\n\nfunction Metric({ label, value }: { label: string; value: number }): ReactElement {\n  return (\n    <div className=\"metric\">\n      <div className=\"metric-label\">{label}</div>\n      <div className=\"metric-value\">{value}</div>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Review                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** Takes no labels prop: each row derives the label it needs from the labeller itself, so a\n *  snapshot passed down from the parent could disagree with the one the row computes after a\n *  mutation. Two readings of one fact is how a stale label reaches the screen. */\nfunction ReviewCard(): ReactElement {\n  const whylog = useWhyLog();\n  const _guards = useGuards();\n\n  const decisions = [...whylog.state.decisions.values()].filter(\n    (decision) => decision.status !== \"superseded\" && decision.status !== \"archived\",\n  );\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Guard review</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        No guard runs until it is accepted. A synthesised guard that fails on day one is worse than\n        no guard, because it teaches you to ignore the panel ΓÇö and a panel that gets ignored stops\n        being verification.\n      </p>\n\n      {decisions.length === 0 ? (\n        <div className=\"faint\" style={{ fontSize: 12 }}>\n          No decisions yet.\n        </div>\n      ) : null}\n\n      {decisions.map((decision) => (\n        <DecisionGuardRow key={decision.id} decisionId={decision.id} />\n      ))}\n\n      <pre\n        className=\"mono dim\"\n        style={{ whiteSpace: \"pre-wrap\", margin: \"12px 0 0\", fontSize: 11 }}\n      >\n        {describeReviewPolicy()}\n      </pre>\n    </section>\n  );\n}\n\nfunction DecisionGuardRow({ decisionId }: { decisionId: DecisionId }): ReactElement {\n  const whylog = useWhyLog();\n  const guards = useGuards();\n  const [editing, setEditing] = useState<GuardId | null>(null);\n\n  const group = guards.groupFor(decisionId);\n  const decision = whylog.state.decisions.get(decisionId);\n  const decisionLabel =\n    label(whylog.state).labels.get(decisionId)?.label ?? decision?.label ?? \"UNKNOWN\";\n\n  if (group.guards.length === 0) return <span />;\n\n  return (\n    <div style={{ borderTop: \"1px solid var(--edge-soft, #333)\", padding: \"10px 0\" }}>\n      <div style={{ display: \"flex\", gap: 8, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n        <span\n          className=\"badge\"\n          title={LABEL_MEANING[decisionLabel as keyof typeof LABEL_MEANING] ?? \"\"}\n          style={{ color: LABEL_COLOUR[decisionLabel as keyof typeof LABEL_COLOUR] ?? \"inherit\" }}\n        >\n          {decisionLabel}\n        </span>\n        <span className=\"mono\" style={{ fontSize: 12 }}>\n          {decisionId}\n        </span>\n        <span style={{ fontSize: 13, fontWeight: 600 }}>{decision?.statement}</span>\n        <span className=\"faint\" style={{ fontSize: 11, marginLeft: \"auto\" }}>\n          {group.proposed.length} proposed ┬╖ {group.accepted.length} accepted ┬╖{\" \"}\n          {group.suppressed.length} suppressed\n        </span>\n      </div>\n\n      {group.disabledByLabel ? (\n        <div className=\"notice notice-warning\" style={{ marginTop: 8, fontSize: 12 }}>\n          This decision is not labelled IN, so its guards are disabled and will not run. Guards\n          inherit their decision's label: a reversed or unsupported decision must stop nagging. They\n          re-enable automatically if the decision returns to IN.\n        </div>\n      ) : null}\n\n      {group.guards.map((guard) => {\n        const disabled = guards.disabledReason(guard.id);\n\n        return (\n          <div\n            key={guard.id}\n            style={{\n              marginTop: 8,\n              paddingLeft: 10,\n              borderLeft: \"2px solid var(--edge-soft, #444)\",\n            }}\n          >\n            <div style={{ display: \"flex\", gap: 6, alignItems: \"baseline\", flexWrap: \"wrap\" }}>\n              <span className=\"mono\" style={{ fontSize: 11 }}>\n                {guard.id}\n              </span>\n              <span className=\"badge\">{guard.spec.kind}</span>\n              <span\n                className=\"badge\"\n                style={{\n                  color:\n                    guard.severity === \"blocking\" ? \"var(--label-out)\" : \"var(--label-unknown)\",\n                }}\n              >\n                {guard.severity}\n              </span>\n              <span className=\"badge\">{guard.lifecycle}</span>\n              <span className=\"faint\" style={{ fontSize: 11 }}>\n                by {guard.generatedBy}\n              </span>\n              {guard.lastRun !== undefined ? (\n                <span className=\"faint mono\" style={{ fontSize: 11 }}>\n                  last run: {guard.lastRun.outcome}\n                </span>\n              ) : null}\n            </div>\n\n            <div className=\"mono\" style={{ fontSize: 11, marginTop: 3 }}>\n              {describeSpec(guard.spec)}\n            </div>\n\n            <div className=\"dim\" style={{ fontSize: 12, marginTop: 3 }}>\n              {guard.rationale}\n            </div>\n\n            {disabled !== null ? (\n              <div className=\"faint\" style={{ fontSize: 11, marginTop: 3 }}>\n                ΓÅ╕ {disabled}\n              </div>\n            ) : null}\n\n            {guard.suppressionReason !== undefined ? (\n              <div className=\"faint\" style={{ fontSize: 11, marginTop: 3 }}>\n                Suppressed: {guard.suppressionReason}\n              </div>\n            ) : null}\n\n            <div style={{ display: \"flex\", gap: 6, marginTop: 6, flexWrap: \"wrap\" }}>\n              {guard.lifecycle === \"proposed\" ? (\n                <button type=\"button\" className=\"badge\" onClick={() => guards.accept(guard.id)}>\n                  Accept\n                </button>\n              ) : null}\n\n              {guard.lifecycle !== \"deleted\" ? (\n                <>\n                  <button type=\"button\" className=\"badge\" onClick={() => setEditing(guard.id)}>\n                    {editing === guard.id ? \"Close editor\" : \"Edit\"}\n                  </button>\n                  <button\n                    type=\"button\"\n                    className=\"badge\"\n                    onClick={() => guards.remove(guard.id, \"\")}\n                  >\n                    Delete\n                  </button>\n                </>\n              ) : null}\n            </div>\n\n            {editing === guard.id ? (\n              <EditForm\n                guardId={guard.id}\n                spec={guard.spec}\n                rationale={guard.rationale}\n                severity={guard.severity}\n                onDone={() => setEditing(null)}\n              />\n            ) : null}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\nfunction EditForm({\n  guardId,\n  spec,\n  rationale,\n  severity,\n  onDone,\n}: {\n  guardId: GuardId;\n  spec: GuardSpec;\n  rationale: string;\n  severity: GuardSeverity;\n  onDone: () => void;\n}): ReactElement {\n  const guards = useGuards();\n  const [text, setText] = useState(specToJson(spec));\n  const [why, setWhy] = useState(rationale);\n  const [level, setLevel] = useState<GuardSeverity>(severity);\n  const [error, setError] = useState<string | null>(null);\n\n  const save = (): void => {\n    let parsed: unknown;\n    try {\n      parsed = JSON.parse(text);\n    } catch {\n      setError(\"That is not valid JSON.\");\n      return;\n    }\n\n    if (parsed === null || typeof parsed !== \"object\") {\n      setError(\"The spec must be a JSON object.\");\n      return;\n    }\n\n    const candidate = parsed as GuardSpec;\n    if (typeof candidate.kind !== \"string\") {\n      setError('The spec needs a \"kind\" ΓÇö one of the eight in the taxonomy.');\n      return;\n    }\n\n    const outcome = guards.edit(guardId, candidate, why, level);\n    if (!outcome.ok) {\n      setError(outcome.error);\n      return;\n    }\n\n    setError(null);\n    onDone();\n  };\n\n  return (\n    <div style={{ marginTop: 8 }}>\n      <div className=\"notice notice-warning\" style={{ fontSize: 11 }}>\n        Editing is <strong>delete + re-synthesise</strong>, recorded as two events. The closed\n        vocabulary has no edit event, and adding one would let a spec change without a record of the\n        spec it replaced ΓÇö a guard quietly weakened after it started failing would be\n        indistinguishable from one that was fixed. The replacement is PROPOSED again: an edit does\n        not inherit acceptance, because that would activate a check nobody reviewed.\n      </div>\n\n      <textarea\n        className=\"mono\"\n        value={text}\n        rows={5}\n        onChange={(event) => setText(event.target.value)}\n        style={{ width: \"100%\", fontSize: 11, marginTop: 8 }}\n      />\n\n      <input\n        value={why}\n        onChange={(event) => setWhy(event.target.value)}\n        placeholder=\"rationale ΓÇö mandatory; a guard without one is indistinguishable from a lint rule\"\n        style={{ width: \"100%\", fontSize: 12, marginTop: 6 }}\n      />\n\n      <div style={{ display: \"flex\", gap: 8, marginTop: 6, alignItems: \"center\" }}>\n        <select\n          value={level}\n          onChange={(event) => setLevel(event.target.value as GuardSeverity)}\n          style={{ fontSize: 12 }}\n        >\n          <option value=\"blocking\">blocking ΓÇö fails the build</option>\n          <option value=\"warning\">warning ΓÇö advisory</option>\n        </select>\n\n        <button type=\"button\" className=\"badge\" onClick={save}>\n          Save as new guard\n        </button>\n      </div>\n\n      {error !== null ? (\n        <div className=\"notice notice-error\" style={{ marginTop: 6, fontSize: 12 }}>\n          {error}\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nfunction specToJson(spec: GuardSpec): string {\n  return JSON.stringify(spec, null, 2);\n}\n\nfunction describeSpec(spec: GuardSpec): string {\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\":\n      return spec.package + (spec.includeDev === true ? \" (including devDependencies)\" : \"\");\n    case \"path_glob_exists\":\n    case \"path_glob_absent\":\n      return spec.glob;\n    case \"string_in_files\":\n    case \"string_absent_in_files\":\n      return `${JSON.stringify(spec.pattern)} within ${spec.glob}${spec.wordBoundary === false ? \", no word boundary\" : \", word-boundary matched\"}`;\n    case \"command_exit_zero\":\n      return spec.command;\n    case \"llm_judge\":\n      return `rubric over ${spec.scopeGlobs.join(\", \")}`;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Unverifiable                                                               */\n/* -------------------------------------------------------------------------- */\n\nfunction UnverifiableCard(): ReactElement {\n  const guards = useGuards();\n\n  if (guards.unverifiable.length === 0) return <span />;\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Unverifiable ┬╖ {guards.unverifiable.length} decision(s)</h2>\n\n      <div className=\"notice notice-warning\" style={{ fontSize: 12 }}>\n        No guard could be compiled for these. They are SHOWN, never silently skipped: the\n        literature's own test is whether you can describe what a violation looks like, and for these\n        you cannot yet. Unverifiable decisions are exactly the ones most likely to drift, because\n        nothing would tell you if they did ΓÇö and a compliance score computed only over the decisions\n        that happened to be checkable is a score that flatters itself.\n      </div>\n\n      <ul style={{ margin: \"10px 0 0\", paddingLeft: 18 }}>\n        {guards.unverifiable.map((entry) => (\n          <li key={entry.decisionId} style={{ fontSize: 12, marginBottom: 6 }}>\n            <span className=\"mono\">{entry.decisionId}</span> ΓÇö {entry.reason}\n          </li>\n        ))}\n      </ul>\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* CI export                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction CiExportCard(): ReactElement {\n  const guards = useGuards();\n  const [output, setOutput] = useState<{\n    runner: string;\n    workflow: string;\n    summary: string;\n  } | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [which, setWhich] = useState<\"runner\" | \"workflow\">(\"runner\");\n\n  const generate = (): void => {\n    const result = guards.exportForCi();\n    if (!result.ok) {\n      setError(result.error);\n      setOutput(null);\n      return;\n    }\n    setError(null);\n    setOutput(result.value);\n  };\n\n  const download = (): void => {\n    if (output === null) return;\n\n    const name = which === \"runner\" ? \"guards.cjs\" : \"decision-guards.yml\";\n    const text = which === \"runner\" ? output.runner : output.workflow;\n    const blob = new Blob([text], { type: \"text/plain\" });\n    const url = URL.createObjectURL(blob);\n    const anchor = document.createElement(\"a\");\n    anchor.href = url;\n    anchor.download = name;\n    anchor.click();\n    URL.revokeObjectURL(url);\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">CI export</h2>\n\n      <p className=\"dim\" style={{ margin: \"0 0 10px\", fontSize: 12 }}>\n        A standalone Node runner (standard library only ΓÇö no install step) and a GitHub Actions\n        workflow. The exported runner evaluates the same six predicates as the interpreter here, and\n        the guard set is serialised as data rather than regenerated, so the two cannot drift apart\n        by having been written twice.\n      </p>\n\n      <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n        <button type=\"button\" className=\"badge\" onClick={generate}>\n          Generate\n        </button>\n\n        {output !== null ? (\n          <>\n            <button type=\"button\" className=\"badge\" onClick={() => setWhich(\"runner\")}>\n              {which === \"runner\" ? \"ΓÇó guards.cjs\" : \"guards.cjs\"}\n            </button>\n            <button type=\"button\" className=\"badge\" onClick={() => setWhich(\"workflow\")}>\n              {which === \"workflow\" ? \"ΓÇó decision-guards.yml\" : \"decision-guards.yml\"}\n            </button>\n            <button type=\"button\" className=\"badge\" onClick={download}>\n              Download\n            </button>\n          </>\n        ) : null}\n      </div>\n\n      {error !== null ? (\n        <div className=\"notice notice-warning\" style={{ marginTop: 10, fontSize: 12 }}>\n          {error}\n        </div>\n      ) : null}\n\n      {output !== null ? (\n        <>\n          <pre\n            className=\"mono dim\"\n            style={{ whiteSpace: \"pre-wrap\", margin: \"10px 0 0\", fontSize: 11 }}\n          >\n            {output.summary}\n          </pre>\n          <pre\n            className=\"mono\"\n            style={{\n              whiteSpace: \"pre-wrap\",\n              margin: \"10px 0 0\",\n              fontSize: 10,\n              maxHeight: 320,\n              overflow: \"auto\",\n              borderTop: \"1px solid var(--edge-soft, #333)\",\n              paddingTop: 8,\n            }}\n          >\n            {which === \"runner\" ? output.runner : output.workflow}\n          </pre>\n        </>\n      ) : null}\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reference                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction ReferenceCard(): ReactElement {\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Reference</h2>\n\n      <Block title=\"The eight guard kinds\" body={describeTaxonomy()} />\n      <Block title=\"Guards as evidence ΓÇö the feedback loop\" body={describeFeedbackLoop()} />\n      <Block title=\"Review policy\" body={describeReviewPolicy()} />\n    </section>\n  );\n}\n\nfunction Block({ title, body }: { title: string; body: string }): ReactElement {\n  return (\n    <div style={{ marginBottom: 14 }}>\n      <h3 style={{ margin: \"0 0 6px\", fontSize: 13 }}>{title}</h3>\n      <pre className=\"mono dim\" style={{ whiteSpace: \"pre-wrap\", margin: 0, fontSize: 11 }}>\n        {body}\n      </pre>\n    </div>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 18 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 18 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 18 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\ReasoningView.tsx"},"span":[2954,2967],"sourceCode":"/**\n * The reasoning view ΓÇö gate G2: \"it reasons\".\n *\n * Phase 2 ┬╖ the demo surface for sub-phases 2.1ΓÇô2.10\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.11\n *\n * ---------------------------------------------------------------------------\n * WHAT G2 HAS TO SHOW\n *\n * Not that a graph exists. That a change in one place MOVES a belief somewhere else,\n * through a chain the user can read, and that the system stopped short of acting on it.\n *\n * Three things on screen, in this order, because this is the order the argument runs:\n *\n *   1. THE FINDING      what is unsound, and which gate said so\n *   2. THE DIAGNOSIS    backtracking ΓåÆ nogood ΓåÆ cascade ΓåÆ entrenchment, as prose\n *   3. THE PROPOSAL     seven parts, with buttons that require a reason\n *\n * Plus the two things that make it credible rather than impressive:\n *\n *   ┬╖ GATE AVAILABILITY, always visible. Gate (b) is unavailable until Phase 3, and\n *     saying so on screen is the difference between a demo and a claim.\n *   ┬╖ THE AUDIT TRAIL, on demand. \"Why do you believe this?\" answered as a chain\n *     ordered by LEARNED time, with the weak link named.\n *\n * ---------------------------------------------------------------------------\n * COLOUR ENCODES EPISTEMIC STATUS, NEVER SEVERITY\n *\n * IN is green, OUT is grey, UNKNOWN amber, UNFOUNDED violet ΓÇö the same four colours\n * used everywhere else in the product. Red is reserved for \"an action is available\",\n * which is why the proposal buttons are the only red things here. A finding is not an\n * error; it is information about the state of a belief.\n * ---------------------------------------------------------------------------\n */\n\nimport { PREMISE_TYPES_CLOSED, VARIABLES, isWorldObservable } from \"@/ontology\";\nimport {\n  type Newcomer,\n  type RevisionCase,\n  auditDecision,\n  chronologicalOrder,\n  describeAction,\n  describeAvailability,\n  describeRun,\n  renderTrail,\n  renderWeakest,\n} from \"@/reasoning\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport {\n  applyContest,\n  applyOverride,\n  applyRejustification,\n  applyReversal,\n  applyVouch,\n  assertPremiseFalsified,\n  contestedCases,\n  deterministicCases,\n  hardestCase,\n  truncatedCases,\n  useReasoning,\n} from \"@/store/reasoning\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { LABEL_BACKGROUND, LABEL_COLOUR, LABEL_MEANING } from \"@/theme\";\nimport type { DecisionId, PremiseId, ProposalId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport type { PremiseType } from \"@/types/domain\";\nimport type { EntrenchmentBreakdown } from \"@/types/reasoning\";\nimport { type ReactElement, type ReactNode, useMemo, useState } from \"react\";\n\n/* -------------------------------------------------------------------------- */\n/* The view                                                                   */\n/* -------------------------------------------------------------------------- */\n\nexport function ReasoningView(): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const logStatus = useWhyLog((s) => s.status);\n\n  const reasoning = useReasoning();\n  const { status, result, cases, selected, error, committed, durationMs } = reasoning;\n  const unresolved = useReasoning((s) => s.unresolved);\n\n  const [showAudit, setShowAudit] = useState(false);\n  const [newcomerText, setNewcomerText] = useState(\"\");\n  const [newcomerVariable, setNewcomerVariable] = useState<string>(\"DATABASE\");\n  const [newcomerValue, setNewcomerValue] = useState(\"postgres\");\n  /** The last newcomer that went through screening. Kept so \"override anyway\" can force\n   *  the SAME information through rather than making the user retype it ΓÇö an override\n   *  that requires re-entry is an override nobody performs. */\n  const [pendingNewcomer, setPendingNewcomer] = useState<Newcomer | null>(null);\n\n  const premiseCount = state.premises.size;\n  const decisionCount = state.decisions.size;\n\n  const deterministic = useMemo(() => deterministicCases(cases), [cases]);\n  const contested = useMemo(() => contestedCases(cases), [cases]);\n  const truncated = useMemo(() => truncatedCases(cases), [cases]);\n  const hardest = useMemo(() => hardestCase(cases), [cases]);\n\n  const selectedCase = cases.find((entry) => entry.proposal.id === selected) ?? null;\n\n  /* ---------------------------------------------------------------------- */\n\n  if (decisionCount === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Reasoning</h2>\n        <p className=\"dim\">\n          There is nothing to reason about yet. Import a transcript and review it first ΓÇö the\n          reasoning cycle works on decisions and the premises they rest on, and neither exists until\n          an extraction has been committed.\n        </p>\n      </section>\n    );\n  }\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 16 }}>\n      {/* ---- the run ---- */}\n      <section className=\"card\">\n        <h2 className=\"card-title\">Truth maintenance</h2>\n        <p className=\"dim\" style={{ marginTop: 0 }}>\n          {decisionCount} decision(s), {premiseCount} premise(s). Running the cycle labels the\n          graph, fires all three gates, backtracks to the minimal set of assumptions responsible,\n          cascades ΓÇö stopping wherever a decision has independent support ΓÇö screens any new\n          information against what it contradicts, and proposes. It never applies.\n        </p>\n\n        <div className=\"metric-grid\">\n          <Metric label=\"findings\" value={String(cases.length)} />\n          <Metric label=\"deterministic\" value={String(deterministic.length)} />\n          <Metric label=\"contested\" value={String(contested.length)} />\n          <Metric label=\"events appended\" value={String(committed)} />\n          <Metric label=\"run time\" value={`${durationMs} ms`} />\n        </div>\n\n        <div style={{ display: \"flex\", gap: 8, marginTop: 12, flexWrap: \"wrap\" }}>\n          <RunButton\n            label={status === \"running\" ? \"RunningΓÇª\" : \"Run the revision cycle\"}\n            disabled={status === \"running\" || logStatus === \"degraded\"}\n            onClick={() => void reasoning.run()}\n          />\n          <RunButton\n            label=\"Re-examine, skipping gate (b)\"\n            disabled={status === \"running\"}\n            secondary\n            onClick={() => void reasoning.run({ skipSemantic: true })}\n          />\n          <RunButton\n            label={showAudit ? \"Hide audit trails\" : \"Audit every decision\"}\n            secondary\n            onClick={() => setShowAudit((current) => !current)}\n          />\n        </div>\n\n        {logStatus === \"degraded\" ? (\n          <p className=\"notice notice-error\" style={{ marginTop: 12 }}>\n            The log is read-only because its hash chain failed verification. The cycle can still\n            label and diagnose, but it cannot record what it found.\n          </p>\n        ) : null}\n\n        {error !== null ? (\n          <p className=\"notice notice-error\" style={{ marginTop: 12 }}>\n            {error}\n          </p>\n        ) : null}\n\n        {result !== null ? (\n          <pre\n            className=\"mono faint\"\n            style={{ marginTop: 12, whiteSpace: \"pre-wrap\", fontSize: 11 }}\n          >\n            {describeRun(result.gates)}\n            {\"\\n\"}\n            {describeAvailability(result.gates)}\n          </pre>\n        ) : null}\n      </section>\n\n      {/* ---- new information: the adjudication demo ---- */}\n      <NewInformation\n        text={newcomerText}\n        variable={newcomerVariable}\n        value={newcomerValue}\n        disabled={status === \"running\"}\n        onText={setNewcomerText}\n        onVariable={setNewcomerVariable}\n        onValue={setNewcomerValue}\n        onSubmit={(newcomer) => {\n          // Remember it. A rejected newcomer is not recoverable from the run's\n          // result ΓÇö the adjudication carries the BREAKDOWN, not the information\n          // itself ΓÇö and the Contested card's \"override anyway\" has to force the\n          // SAME information through rather than making the user retype it. An\n          // override that requires re-entry is an override nobody performs.\n          setPendingNewcomer(newcomer);\n          void reasoning.run({ newcomer });\n        }}\n      />\n\n      {result?.adjudication?.kind === \"reject-newcomer\" ? (\n        <ContestedCard\n          why={result.adjudication.why}\n          blockingDecisionId={result.adjudication.blockingDecisionId}\n          newcomerBreakdown={result.adjudication.newcomerBreakdown ?? null}\n          incumbentBreakdown={result.adjudication.incumbentBreakdown ?? null}\n          newcomer={pendingNewcomer}\n        />\n      ) : null}\n\n      {unresolved.length > 0 ? (\n        <section className=\"card\">\n          <h2 className=\"card-title\">Not acted on ΓÇö needs your confirmation</h2>\n          <p className=\"dim\" style={{ marginTop: 0, fontSize: 13 }}>\n            These assertions matched no premise by exact (type, predicate), so nothing was\n            invalidated. Gate (c) fires only on RESOLVED premise identity: a false match does not\n            miss a conflict, it produces a confident, spectacular, entirely wrong cascade. Guessing\n            here is the one thing worse than asking.\n          </p>\n          <ul style={{ margin: 0, paddingLeft: 18, fontSize: 13 }}>\n            {unresolved.map((entry, index) => (\n              <li key={`${entry.assertion.predicate}-${index}`} style={{ marginBottom: 6 }}>\n                <span className=\"mono\" style={{ fontSize: 11 }}>\n                  {entry.assertion.type}.{entry.assertion.predicate}\n                </span>{\" \"}\n                ΓÇö ΓÇ£{entry.assertion.text}ΓÇ¥{\" \"}\n                <span className=\"badge\" style={{ fontSize: 10 }}>\n                  {entry.kind === \"ambiguous\"\n                    ? `${entry.candidates.length} candidates`\n                    : \"no match\"}\n                </span>\n                <div className=\"faint\" style={{ fontSize: 11 }}>\n                  {entry.explanation}\n                </div>\n              </li>\n            ))}\n          </ul>\n        </section>\n      ) : null}\n\n      {/* ---- the G2 demonstration ---- */}\n      <FalsifySection />\n\n      {/* ---- findings + diagnosis ---- */}\n      {cases.length > 0 ? (\n        <section\n          style={{ display: \"grid\", gridTemplateColumns: \"minmax(260px, 340px) 1fr\", gap: 16 }}\n        >\n          <CaseList\n            cases={cases}\n            selected={selected}\n            truncated={truncated}\n            onSelect={reasoning.select}\n          />\n          {selectedCase === null ? (\n            <section className=\"card\">\n              <p className=\"dim\">Select a finding.</p>\n            </section>\n          ) : (\n            <CaseDetail\n              entry={selectedCase}\n              isHardest={hardest?.proposal.id === selectedCase.proposal.id}\n            />\n          )}\n        </section>\n      ) : status === \"done\" ? (\n        <section className=\"card\">\n          <h2 className=\"card-title\">No gate fired</h2>\n          <p className=\"dim\" style={{ marginTop: 0 }}>\n            Nothing in the log contradicts anything else, no world-observable premise has been\n            falsified, and no excluded condition has arrived. That is a result, not an absence of\n            one ΓÇö and it is only meaningful because the availability report above says which gates\n            actually ran.\n          </p>\n        </section>\n      ) : null}\n\n      {/* ---- audit trails ---- */}\n      {showAudit ? <AuditSection /> : null}\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Pieces                                                                     */\n/* -------------------------------------------------------------------------- */\n\nfunction Metric({ label, value }: { label: string; value: string }): ReactElement {\n  return (\n    <div className=\"metric\">\n      <div className=\"metric-value\">{value}</div>\n      <div className=\"metric-label\">{label}</div>\n    </div>\n  );\n}\n\nfunction RunButton({\n  label,\n  onClick,\n  disabled,\n  secondary,\n}: {\n  label: string;\n  onClick: () => void;\n  disabled?: boolean;\n  secondary?: boolean;\n}): ReactElement {\n  return (\n    <button\n      type=\"button\"\n      className=\"nav-item\"\n      onClick={onClick}\n      disabled={disabled === true}\n      style={\n        secondary === true ? undefined : { borderColor: \"var(--action)\", color: \"var(--action)\" }\n      }\n    >\n      {label}\n    </button>\n  );\n}\n\nfunction NewInformation({\n  text,\n  variable,\n  value,\n  disabled,\n  onText,\n  onVariable,\n  onValue,\n  onSubmit,\n}: {\n  text: string;\n  variable: string;\n  value: string;\n  disabled: boolean;\n  onText: (next: string) => void;\n  onVariable: (next: string) => void;\n  onValue: (next: string) => void;\n  onSubmit: (newcomer: Newcomer) => void;\n}): ReactElement {\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">New information</h2>\n      <p className=\"dim\" style={{ marginTop: 0 }}>\n        Something changed in the world. Enter it and the cycle will screen it against everything it\n        contradicts ΓÇö and may REFUSE it. This is the second-user scenario: a log built on \"single\n        user\" meeting the arrival of a second one.\n      </p>\n\n      <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\", alignItems: \"flex-end\" }}>\n        <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n          <span className=\"faint\">variable</span>\n          <select\n            className=\"mono\"\n            value={variable}\n            onChange={(event) => onVariable(event.target.value)}\n          >\n            {VARIABLES.map((entry) => (\n              <option key={entry} value={entry}>\n                {entry}\n              </option>\n            ))}\n          </select>\n        </label>\n\n        <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n          <span className=\"faint\">value</span>\n          <input\n            className=\"mono\"\n            value={value}\n            onChange={(event) => onValue(event.target.value)}\n            placeholder=\"postgres\"\n            style={{ minWidth: 140 }}\n          />\n        </label>\n\n        <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12, flex: 1 }}>\n          <span className=\"faint\">what was said, verbatim</span>\n          <input\n            value={text}\n            onChange={(event) => onText(event.target.value)}\n            placeholder=\"we just added a second editor, and they overwrote each other's changes\"\n            style={{ minWidth: 260 }}\n          />\n        </label>\n\n        <RunButton\n          label=\"Screen it\"\n          disabled={disabled || text.trim().length === 0}\n          onClick={() =>\n            onSubmit({\n              variable: variable as Newcomer[\"variable\"],\n              value,\n              text,\n              /* A human typed this in, so it carries the highest source authority there\n               * is. That is the honest classification, and it is also what makes the\n               * refusal interesting: even a human-stated observation can lose to an\n               * incumbent with corroboration and guards behind it. */\n              origin: \"human_stated\",\n              confidence: 0.9,\n            })\n          }\n        />\n      </div>\n    </section>\n  );\n}\n\nfunction CaseList({\n  cases,\n  selected,\n  truncated,\n  onSelect,\n}: {\n  cases: readonly RevisionCase[];\n  selected: ProposalId | null;\n  truncated: readonly RevisionCase[];\n  onSelect: (id: ProposalId) => void;\n}): ReactElement {\n  const truncatedIds = new Set(truncated.map((entry) => entry.proposal.id));\n\n  return (\n    <section className=\"card\" style={{ alignSelf: \"start\" }}>\n      <h2 className=\"card-title\">Findings</h2>\n      <p className=\"faint\" style={{ fontSize: 11, marginTop: 0 }}>\n        Deterministic gates first. A finding from gate (a) or (c) can be checked against the graph\n        without forming an opinion about a model; a finding from gate (b) cannot.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 6 }}>\n        {[...cases]\n          .sort((a, b) => Number(b.finding.deterministic) - Number(a.finding.deterministic))\n          .map((entry) => (\n            <button\n              key={entry.proposal.id}\n              type=\"button\"\n              className=\"nav-item\"\n              aria-current={selected === entry.proposal.id ? \"true\" : undefined}\n              onClick={() => onSelect(entry.proposal.id)}\n              style={{\n                textAlign: \"left\",\n                flexDirection: \"column\",\n                alignItems: \"flex-start\",\n                gap: 4,\n              }}\n            >\n              <span style={{ display: \"flex\", gap: 6, alignItems: \"center\" }}>\n                <GateBadge gate={entry.finding.gate} />\n                <span className=\"mono\" style={{ fontSize: 11 }}>\n                  {entry.finding.decisionId}\n                </span>\n                {truncatedIds.has(entry.proposal.id) ? (\n                  <span\n                    className=\"faint\"\n                    style={{ fontSize: 10 }}\n                    title=\"Backtracking or the cascade hit its depth cap. The diagnosis is knowingly incomplete.\"\n                  >\n                    incomplete\n                  </span>\n                ) : null}\n              </span>\n              <span className=\"dim\" style={{ fontSize: 12 }}>\n                {entry.finding.explanation.split(\"\\n\")[0]}\n              </span>\n            </button>\n          ))}\n      </div>\n    </section>\n  );\n}\n\nfunction GateBadge({ gate }: { gate: \"structural\" | \"semantic\" | \"premise\" }): ReactElement {\n  const label =\n    gate === \"structural\" ? \"(a) structural\" : gate === \"premise\" ? \"(c) premise\" : \"(b) semantic\";\n  const meaning =\n    gate === \"structural\"\n      ? \"Same variable, antonym values, both IN. The ontology's antonym table decided this ΓÇö no model, no threshold.\"\n      : gate === \"premise\"\n        ? \"A world-observable premise was falsified, or an excluded condition arrived. Label arithmetic on the justification set.\"\n        : \"Retrieval found the pair and a model adjudicated it. Weaker than the other two, and shown as such.\";\n\n  return (\n    <span\n      className=\"badge\"\n      title={meaning}\n      style={{\n        color: gate === \"semantic\" ? \"var(--label-unknown)\" : \"var(--label-in)\",\n        fontSize: 10,\n      }}\n    >\n      {label}\n    </span>\n  );\n}\n\nfunction CaseDetail({\n  entry,\n  isHardest,\n}: { entry: RevisionCase; isHardest: boolean }): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const proposal = entry.proposal;\n  const [reason, setReason] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n\n  /* Reversing needs the value that REPLACES the old one. When the finding names the\n   * other decision, its canonical value is the honest default; when it does not ΓÇö a\n   * premise invalidation with no rival ΓÇö the user has to supply one, because inventing\n   * it here would put a value in the log that nobody said. */\n  const rival =\n    entry.finding.otherDecisionId === null\n      ? null\n      : (state.decisions.get(entry.finding.otherDecisionId) ?? null);\n  const [newValue, setNewValue] = useState(rival?.value ?? \"\");\n\n  /* Rejustifying needs the premise the decision ACTUALLY rests on. Defaults come from\n   * the premise that failed: a rejustification usually replaces a reason of the same\n   * kind, and pre-filling the predicate keeps the new premise resolvable against the\n   * old one instead of creating a near-duplicate node. */\n  const failedPremise = state.premises.get(proposal.failedPremiseId);\n  const [premiseText, setPremiseText] = useState(\"\");\n  const [premiseType, setPremiseType] = useState<PremiseType>(failedPremise?.type ?? \"requirement\");\n  const [predicate, setPredicate] = useState(failedPremise?.predicate ?? \"requirement.statement\");\n\n  const [busy, setBusy] = useState(false);\n\n  /* Every action re-runs the cycle afterwards (┬º2.9: the label follows from the graph,\n   * never from the event), so all of them are async and the buttons lock while one is\n   * in flight. A second click mid-run would append a second batch against a graph that\n   * is about to change. */\n  const act = async (\n    run: () => Promise<{ ok: boolean; error?: string; value?: string }>,\n  ): Promise<void> => {\n    setBusy(true);\n    const outcome = await run();\n    setBusy(false);\n    setMessage(outcome.ok ? (outcome.value ?? \"Recorded.\") : (outcome.error ?? \"Failed.\"));\n  };\n\n  const wantsReverse = proposal.availableActions.includes(\"reverse\");\n  const wantsRejustify = proposal.availableActions.includes(\"rejustify\");\n  const needsValue = wantsReverse && newValue.trim().length === 0;\n  const needsPremise = wantsRejustify && premiseText.trim().length === 0;\n  const ready = reason.trim().length > 0 && !needsValue && !needsPremise;\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">\n        {proposal.unsoundDecisionId}{\" \"}\n        <span className=\"faint\" style={{ fontSize: 12, fontWeight: 400 }}>\n          proposal {proposal.id}\n        </span>\n      </h2>\n\n      {isHardest ? (\n        <p className=\"notice notice-warning\">\n          This is the most entrenched finding in the run ΓÇö the one that will cost the most to act\n          on. It is called out on purpose: the proposals most likely to be dismissed unread are the\n          ones that matter most.\n        </p>\n      ) : null}\n\n      {/* 1 */}\n      <Part n={1} title=\"What failed\">\n        <p style={{ marginTop: 0 }}>{proposal.failedPremiseText}</p>\n      </Part>\n\n      {/* 2 */}\n      <Part n={2} title=\"The evidence\">\n        <blockquote\n          style={{\n            margin: \"0 0 6px\",\n            padding: \"6px 10px\",\n            borderLeft: \"2px solid var(--edge-related)\",\n            fontSize: 13,\n          }}\n        >\n          {proposal.evidence.quote}\n        </blockquote>\n        <p className=\"faint\" style={{ fontSize: 11, margin: 0 }}>\n          source: {proposal.evidence.source} ┬╖ confidence {proposal.evidence.confidence.toFixed(2)}{\" \"}\n          ┬╖ verbatim, never paraphrased\n        </p>\n      </Part>\n\n      {/* 3 */}\n      <Part n={3} title=\"What cannot both hold\">\n        {proposal.nogood === undefined ? (\n          <p className=\"dim\" style={{ marginTop: 0 }}>\n            No conjunction was recorded for this finding.\n          </p>\n        ) : (\n          <pre className=\"mono\" style={{ whiteSpace: \"pre-wrap\", fontSize: 12, margin: 0 }}>\n            {proposal.nogood.explanation}\n          </pre>\n        )}\n      </Part>\n\n      {/* the diagnosis: steps 5 and 6 in prose */}\n      <Part n={0} title=\"The diagnosis\">\n        <p style={{ marginTop: 0, whiteSpace: \"pre-wrap\", fontSize: 13 }}>{entry.narrative}</p>\n      </Part>\n\n      {/* 4 */}\n      <Part n={4} title=\"What else it affects\">\n        {entry.cascade.steps.length === 0 ? (\n          <p className=\"dim\" style={{ marginTop: 0 }}>\n            Nothing else depended on it.\n          </p>\n        ) : (\n          <>\n            <ul style={{ margin: \"0 0 6px\", paddingLeft: 18, fontSize: 13 }}>\n              {entry.cascade.steps.map((step, index) => (\n                <li key={`${step.to}-${index}`}>\n                  <span className=\"mono\">{step.to}</span>{\" \"}\n                  {step.stoppedAtIndependentSupport ? (\n                    <span style={{ color: \"var(--label-in)\" }}>\n                      STOPS ΓÇö independent support survives\n                    </span>\n                  ) : (\n                    <LabelChip label={step.became} />\n                  )}\n                  <div className=\"faint\" style={{ fontSize: 11 }}>\n                    depth {step.depth} ┬╖ {step.reason}\n                  </div>\n                </li>\n              ))}\n            </ul>\n            {entry.cascade.truncated ? (\n              <p className=\"notice notice-warning\" style={{ fontSize: 12 }}>\n                Propagation hit the depth cap with {entry.cascade.potentiallyAffectedBeyondCap}{\" \"}\n                decision(s) unexamined. There may be more downstream than this shows.\n              </p>\n            ) : null}\n          </>\n        )}\n      </Part>\n\n      {/* 5 */}\n      <Part n={5} title=\"How costly is it to change\">\n        <p style={{ marginTop: 0 }}>\n          <strong>{proposal.entrenchment.capped.toFixed(2)}</strong>{\" \"}\n          <span className=\"badge\">{proposal.entrenchmentBand}</span>\n        </p>\n        <ul className=\"faint\" style={{ fontSize: 11, margin: 0, paddingLeft: 18 }}>\n          <li>\n            source authority {proposal.entrenchment.components.sourceAuthority.toFixed(2)} ├ù 0.30\n          </li>\n          <li>\n            implementation cost{\" \"}\n            {proposal.entrenchment.implementationCostUnknown\n              ? \"UNKNOWN ΓÇö no guard exists yet, counted as 0.50 but not measured\"\n              : `${proposal.entrenchment.components.implementationCost.toFixed(2)} ├ù 0.20`}\n          </li>\n          <li>corroboration {proposal.entrenchment.components.corroboration.toFixed(2)} ├ù 0.20</li>\n          <li>confidence {proposal.entrenchment.components.confidence.toFixed(2)} ├ù 0.15</li>\n          <li>recency {proposal.entrenchment.components.recency.toFixed(2)} ├ù 0.15</li>\n          {proposal.entrenchment.ee3CapApplied ? (\n            <li>\n              EE3 cap binds at {proposal.entrenchment.capped.toFixed(2)} because of{\" \"}\n              <span className=\"mono\">{proposal.entrenchment.weakestPremiseId}</span> ΓÇö a derived\n              belief is never more entrenched than its weakest premise\n            </li>\n          ) : null}\n        </ul>\n      </Part>\n\n      {/* 6 */}\n      <Part n={6} title=\"What you can do\">\n        <p className=\"faint\" style={{ fontSize: 11, marginTop: 0 }}>\n          Every action requires a reason. The reason is what the audit trail shows six months from\n          now when somebody asks why this changed.\n        </p>\n\n        {wantsReverse ? (\n          <label\n            style={{\n              display: \"flex\",\n              flexDirection: \"column\",\n              gap: 4,\n              fontSize: 12,\n              marginBottom: 8,\n            }}\n          >\n            <span className=\"faint\">\n              the value that replaces it\n              {rival === null ? \"\" : ` ΓÇö defaults to ${rival.id} \"${rival.value}\"`}\n            </span>\n            <input\n              className=\"mono\"\n              value={newValue}\n              onChange={(event) => setNewValue(event.target.value)}\n              placeholder=\"postgres\"\n            />\n          </label>\n        ) : null}\n\n        {wantsRejustify ? (\n          <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\", marginBottom: 8 }}>\n            <label\n              style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12, flex: 1 }}\n            >\n              <span className=\"faint\">\n                what it really rests on\n                {failedPremise === undefined ? \"\" : ` ΓÇö replacing \"${failedPremise.text}\"`}\n              </span>\n              <input\n                value={premiseText}\n                onChange={(event) => setPremiseText(event.target.value)}\n                placeholder=\"we are fine with two users as long as writes are serialised\"\n                style={{ minWidth: 240 }}\n              />\n            </label>\n            <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n              <span className=\"faint\">premise type</span>\n              <select\n                className=\"mono\"\n                value={premiseType}\n                onChange={(event) => setPremiseType(event.target.value as PremiseType)}\n              >\n                {PREMISE_TYPES_CLOSED.map((entry) => (\n                  <option key={entry} value={entry}>\n                    {entry}\n                  </option>\n                ))}\n              </select>\n            </label>\n            <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n              <span className=\"faint\">predicate</span>\n              <input\n                className=\"mono\"\n                value={predicate}\n                onChange={(event) => setPredicate(event.target.value)}\n                style={{ minWidth: 160 }}\n              />\n            </label>\n          </div>\n        ) : null}\n\n        <input\n          value={reason}\n          onChange={(event) => setReason(event.target.value)}\n          placeholder=\"why ΓÇö required, and it goes in the log\"\n          style={{ width: \"100%\", marginBottom: 8 }}\n        />\n\n        <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n          {proposal.availableActions.map((action) => (\n            <RunButton\n              key={action}\n              label={action}\n              disabled={!ready || busy}\n              onClick={() => {\n                switch (action) {\n                  case \"reverse\":\n                    void act(() =>\n                      applyReversal(proposal.unsoundDecisionId, newValue.trim(), reason),\n                    );\n                    return;\n                  case \"rejustify\":\n                    /* Creates the premise, its justification and the link in one batch.\n                     * It cannot take an id from here: ids come from the folded counters,\n                     * so any id invented in the view would point at nothing. */\n                    void act(() =>\n                      applyRejustification(proposal.unsoundDecisionId, {\n                        premiseText: premiseText.trim(),\n                        premiseType,\n                        predicate,\n                        reason,\n                      }),\n                    );\n                    return;\n                  case \"contest\":\n                    void act(() => applyContest(proposal.failedPremiseId, reason));\n                    return;\n                }\n              }}\n            />\n          ))}\n          <RunButton\n            label=\"keep it ΓÇö I vouch for this\"\n            secondary\n            disabled={reason.trim().length === 0 || busy}\n            onClick={() => void act(() => applyVouch(proposal.id, reason))}\n          />\n        </div>\n\n        <p className=\"faint\" style={{ fontSize: 11, marginTop: 8 }}>\n          {proposal.availableActions.map((action) => describeAction(action)).join(\" ┬╖ \")} ┬╖ keep it\n          ΓÇö vouch for the decision personally, raising its authority to 0.9 and resolving the\n          proposal\n        </p>\n\n        {entry.reassertsNogood !== null ? (\n          <p className=\"notice notice-warning\" style={{ fontSize: 12, marginTop: 8 }}>\n            You are re-asserting a combination this log already found impossible on{\" \"}\n            {entry.reassertsNogood.recordedAt.slice(0, 10)} (\n            <span className=\"mono\">{entry.reassertsNogood.id}</span>).{\" \"}\n            {entry.reassertsNogood.explanation}\n          </p>\n        ) : null}\n\n        {message !== null ? (\n          <p className=\"notice notice-info\" style={{ fontSize: 12 }}>\n            {message}\n          </p>\n        ) : null}\n      </Part>\n\n      {/* 7 */}\n      <Part n={7} title=\"Why this was not applied for you\">\n        <p style={{ marginTop: 0, whiteSpace: \"pre-wrap\", fontSize: 13 }}>\n          {proposal.whyNotAutoApplied}\n        </p>\n      </Part>\n    </section>\n  );\n}\n\nfunction Part({\n  n,\n  title,\n  children,\n}: {\n  n: number;\n  title: string;\n  /** `ReactNode`, not `ReactElement`: a section's body is often a conditional, and a\n   *  conditional that renders nothing is `null`, not a missing element. */\n  children: ReactNode;\n}): ReactElement {\n  return (\n    <div style={{ marginTop: 14 }}>\n      <h3 style={{ fontSize: 12, letterSpacing: \"0.02em\", margin: \"0 0 6px\" }}>\n        {n > 0 ? `${n}. ` : \"\"}\n        {title}\n      </h3>\n      {children}\n    </div>\n  );\n}\n\nfunction LabelChip({ label }: { label: DecisionLabel }): ReactElement {\n  return (\n    <span\n      className=\"badge\"\n      title={LABEL_MEANING[label]}\n      style={{ color: LABEL_COLOUR[label], background: LABEL_BACKGROUND[label] }}\n    >\n      {label}\n    </span>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The Contested queue                                                        */\n/* -------------------------------------------------------------------------- */\n\n/**\n * ┬º2.8: \"A rejected newcomer appears in a Contested queue with the FULL ENTRENCHMENT\n * BREAKDOWN OF BOTH SIDES and an explicit 'override anyway' action.\"\n *\n * Both breakdowns are rendered term by term, not as two totals. That is what makes\n * override an informed choice: the user can see that the newcomer lost on corroboration\n * and implementation cost ΓÇö the two terms it structurally cannot have ΓÇö rather than on\n * authority, and decide whether that is a good enough reason to refuse them.\n */\nfunction ContestedCard({\n  why,\n  blockingDecisionId,\n  newcomerBreakdown,\n  incumbentBreakdown,\n  newcomer,\n}: {\n  why: string;\n  blockingDecisionId: DecisionId;\n  newcomerBreakdown: EntrenchmentBreakdown | null;\n  incumbentBreakdown: EntrenchmentBreakdown | null;\n  newcomer: Newcomer | null;\n}): ReactElement {\n  const [reason, setReason] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const override = async (): Promise<void> => {\n    if (newcomer === null) return;\n    setBusy(true);\n    const outcome = await applyOverride(newcomer, null, reason);\n    setBusy(false);\n    setMessage(outcome.ok ? outcome.value : outcome.error);\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Contested ΓÇö the new information was refused</h2>\n      <p style={{ marginTop: 0, whiteSpace: \"pre-wrap\", fontSize: 13 }}>{why}</p>\n\n      <div style={{ display: \"grid\", gridTemplateColumns: \"1fr 1fr\", gap: 12, marginTop: 12 }}>\n        <BreakdownColumn\n          title=\"the newcomer\"\n          breakdown={newcomerBreakdown}\n          tone=\"var(--label-unknown)\"\n        />\n        <BreakdownColumn\n          title={`${blockingDecisionId} (incumbent)`}\n          breakdown={incumbentBreakdown}\n          tone=\"var(--label-in)\"\n        />\n      </div>\n\n      <p className=\"faint\" style={{ fontSize: 11, marginTop: 10 }}>\n        Non-prioritized revision (Hansson). AGM's Success postulate ΓÇö always accept new information\n        ΓÇö would let one remark in a transcript overwrite a decision made over three days. Refusal is\n        never silent: this is the queue, and the override is right here.\n      </p>\n\n      {newcomer === null ? (\n        <p className=\"faint\" style={{ fontSize: 12 }}>\n          The refused information is no longer in hand ΓÇö re-enter it above to override.\n        </p>\n      ) : (\n        <div style={{ marginTop: 10 }}>\n          <input\n            value={reason}\n            onChange={(event) => setReason(event.target.value)}\n            placeholder=\"why you are overruling the arithmetic ΓÇö required, and it goes in the log\"\n            style={{ width: \"100%\", marginBottom: 8 }}\n          />\n          <RunButton\n            label={busy ? \"OverridingΓÇª\" : \"override anyway\"}\n            disabled={busy || reason.trim().length === 0}\n            onClick={() => void override()}\n          />\n          <p className=\"faint\" style={{ fontSize: 11, marginTop: 6 }}>\n            Writes a <span className=\"mono\">HumanOverride</span> event and raises the newcomer's\n            source authority to 0.9 ΓÇö high enough to win every subsequent adjudication, but still\n            below a directly human-stated decision (1.0), so an override can itself be overridden by\n            better evidence. An override that could never be overturned is not a queue, it is a dead\n            end.\n          </p>\n        </div>\n      )}\n\n      {message !== null ? (\n        <p className=\"notice notice-info\" style={{ fontSize: 12, marginTop: 8 }}>\n          {message}\n        </p>\n      ) : null}\n    </section>\n  );\n}\n\nfunction BreakdownColumn({\n  title,\n  breakdown,\n  tone,\n}: {\n  title: string;\n  breakdown: EntrenchmentBreakdown | null;\n  tone: string;\n}): ReactElement {\n  if (breakdown === null) {\n    return (\n      <div>\n        <h3 style={{ fontSize: 12, margin: \"0 0 6px\", color: tone }}>{title}</h3>\n        <p className=\"dim\" style={{ fontSize: 12, margin: 0 }}>\n          No breakdown recorded.\n        </p>\n      </div>\n    );\n  }\n\n  const c = breakdown.components;\n\n  return (\n    <div>\n      <h3 style={{ fontSize: 12, margin: \"0 0 6px\", color: tone }}>\n        {title} ΓÇö {breakdown.capped.toFixed(2)}\n      </h3>\n      <ul className=\"faint\" style={{ fontSize: 11, margin: 0, paddingLeft: 18 }}>\n        <li>source authority {c.sourceAuthority.toFixed(2)} ├ù 0.30</li>\n        <li>\n          implementation cost {c.implementationCost.toFixed(2)} ├ù 0.20\n          {breakdown.implementationCostUnknown ? \" ΓÇö unknown, not measured\" : \"\"}\n        </li>\n        <li>corroboration {c.corroboration.toFixed(2)} ├ù 0.20</li>\n        <li>confidence {c.confidence.toFixed(2)} ├ù 0.15</li>\n        <li>recency {c.recency.toFixed(2)} ├ù 0.15</li>\n        {breakdown.ee3CapApplied ? (\n          <li>\n            EE3 cap binds at {breakdown.capped.toFixed(2)} via{\" \"}\n            <span className=\"mono\">{breakdown.weakestPremiseId}</span>\n          </li>\n        ) : null}\n      </ul>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The G2 demonstration                                                       */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Falsify a world-observable premise.\n *\n * This is gate G2: `single-user` becomes false, the decision resting on it goes\n * UNSOUND, anything downstream cascades, anything with independent support survives,\n * and a proposal appears with its entrenchment broken down.\n *\n * Only WORLD-OBSERVABLE premises are listed ΓÇö `scale`, `deployment`, `capability`,\n * `external`. The intent-based ones (`team`, `budget`, `time`, `requirement`) are\n * excluded on purpose: nobody can observe that you stopped wanting offline mode, so\n * only a human can retract those, and offering a button that pretends otherwise would\n * be offering a lie. They are listed separately, greyed, saying exactly that.\n */\nfunction FalsifySection(): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const labels = useReasoning((s) => s.result?.labels);\n  const empty = useMemo(() => new Map<NodeId, Labelled>(), []);\n  const labelMap: ReadonlyMap<NodeId, Labelled> = labels ?? empty;\n\n  const [target, setTarget] = useState<PremiseId | null>(null);\n  const [observed, setObserved] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const premises = useMemo(() => {\n    const all = [...state.premises.values()].sort((a, b) => (a.id < b.id ? -1 : 1));\n    return {\n      observable: all.filter((premise) => isWorldObservable(premise.type)),\n      intent: all.filter((premise) => !isWorldObservable(premise.type)),\n    };\n  }, [state.premises]);\n\n  if (premises.observable.length === 0 && premises.intent.length === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Falsify a premise</h2>\n        <p className=\"dim\" style={{ marginTop: 0 }}>\n          No premises in the log yet. Premises are what make this more than a decision list: they\n          are the conditions a decision was true under, and they are what reality invalidates.\n        </p>\n      </section>\n    );\n  }\n\n  const submit = async (): Promise<void> => {\n    if (target === null) return;\n    setBusy(true);\n    const outcome = await assertPremiseFalsified(target, observed);\n    setBusy(false);\n    setMessage(outcome.ok ? outcome.value : outcome.error);\n    if (outcome.ok) {\n      setTarget(null);\n      setObserved(\"\");\n    }\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Something stopped being true</h2>\n      <p className=\"dim\" style={{ marginTop: 0, fontSize: 13 }}>\n        This is the demonstration the whole project exists for. Pick a premise about the world, say\n        what you observed instead, and the cycle will find every decision that was true{\" \"}\n        <em>given</em> it ΓÇö then backtrack, cascade, weigh what it would cost to change, and\n        propose. It will not apply anything.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 6 }}>\n        {premises.observable.map((premise) => {\n          const expanded = target === premise.id;\n          const label = labelMap.get(premise.id)?.label ?? premise.label;\n\n          return (\n            <div key={premise.id} style={{ borderTop: \"1px solid var(--edge-related)\" }}>\n              <button\n                type=\"button\"\n                className=\"nav-item\"\n                onClick={() => setTarget(expanded ? null : premise.id)}\n                style={{ width: \"100%\", justifyContent: \"space-between\", textAlign: \"left\" }}\n              >\n                <span>\n                  <span className=\"mono\" style={{ fontSize: 11 }}>\n                    {premise.id}\n                  </span>{\" \"}\n                  {premise.text}\n                </span>\n                <span style={{ display: \"flex\", gap: 6, alignItems: \"center\" }}>\n                  <LabelChip label={label} />\n                  <span className=\"badge faint\" style={{ fontSize: 10 }}>\n                    {premise.type}\n                  </span>\n                </span>\n              </button>\n\n              {expanded ? (\n                <div style={{ padding: \"8px 4px 14px\", display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n                  <input\n                    value={observed}\n                    onChange={(event) => setObserved(event.target.value)}\n                    placeholder={`what you observed instead ΓÇö e.g. \"there are two of us editing it now\"`}\n                    style={{ flex: 1, minWidth: 260 }}\n                  />\n                  <RunButton\n                    label={busy ? \"Running the cycleΓÇª\" : \"Falsify it\"}\n                    disabled={busy || observed.trim().length === 0}\n                    onClick={() => void submit()}\n                  />\n                  <p className=\"faint\" style={{ fontSize: 11, width: \"100%\", margin: 0 }}>\n                    Recorded as a <span className=\"mono\">repo-scan</span> observation that refutes{\" \"}\n                    <span className=\"mono\">{premise.predicate}</span>. The same path a guard will\n                    take in Phase 4 ΓÇö no branch in the reasoning code knows or cares which one it\n                    was.\n                  </p>\n                </div>\n              ) : null}\n            </div>\n          );\n        })}\n      </div>\n\n      {premises.intent.length > 0 ? (\n        <details style={{ marginTop: 12 }}>\n          <summary className=\"faint\" style={{ fontSize: 12, cursor: \"pointer\" }}>\n            {premises.intent.length} premise(s) about intent, which cannot be falsified by\n            observation\n          </summary>\n          <ul className=\"faint\" style={{ fontSize: 12, paddingLeft: 18 }}>\n            {premises.intent.map((premise) => (\n              <li key={premise.id}>\n                <span className=\"mono\">{premise.id}</span> {premise.text}{\" \"}\n                <span className=\"badge\" style={{ fontSize: 10 }}>\n                  {premise.type}\n                </span>\n              </li>\n            ))}\n          </ul>\n          <p className=\"faint\" style={{ fontSize: 11 }}>\n            <span className=\"mono\">team</span>, <span className=\"mono\">budget</span>,{\" \"}\n            <span className=\"mono\">time</span> and <span className=\"mono\">requirement</span>{\" \"}\n            premises record what you wanted, not what the world is. No scan can observe that you\n            stopped wanting offline mode, so no guard can check them and nothing here will retract\n            them. Only you can, and the log marks them unverifiable rather than pretending\n            otherwise.\n          </p>\n        </details>\n      ) : null}\n\n      {message !== null ? (\n        <p\n          className=\"notice notice-info\"\n          style={{ fontSize: 12, marginTop: 12, whiteSpace: \"pre-wrap\" }}\n        >\n          {message}\n        </p>\n      ) : null}\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The audit section                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction AuditSection(): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const labels = useReasoning((s) => s.result?.labels);\n  const [open, setOpen] = useState<DecisionId | null>(null);\n\n  const empty = useMemo(() => new Map<NodeId, Labelled>(), []);\n  const labelMap: ReadonlyMap<NodeId, Labelled> = labels ?? empty;\n\n  const decisions = useMemo(\n    () => [...state.decisions.values()].sort((a, b) => (a.id < b.id ? -1 : 1)),\n    [state.decisions],\n  );\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Why do you believe this?</h2>\n      <p className=\"dim\" style={{ marginTop: 0, fontSize: 13 }}>\n        The full support chain for every decision, ordered by <strong>learned</strong> time ΓÇö when\n        the system found out, not when it happened. An audit ordered by valid time would claim the\n        system reasoned about something before it knew about it, and an audit that lies about its\n        own clock is not an audit.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 6 }}>\n        {decisions.map((decision) => {\n          const trail = auditDecision(state, labelMap, decision.id);\n          const expanded = open === decision.id;\n\n          return (\n            <div key={decision.id} style={{ borderTop: \"1px solid var(--edge-related)\" }}>\n              <button\n                type=\"button\"\n                className=\"nav-item\"\n                onClick={() => setOpen(expanded ? null : decision.id)}\n                style={{ width: \"100%\", justifyContent: \"space-between\", textAlign: \"left\" }}\n              >\n                <span>\n                  <span className=\"mono\" style={{ fontSize: 11 }}>\n                    {decision.id}\n                  </span>{\" \"}\n                  {decision.statement}\n                </span>\n                <span style={{ display: \"flex\", gap: 6, alignItems: \"center\" }}>\n                  <LabelChip label={labelMap.get(decision.id)?.label ?? decision.label} />\n                  <span className=\"faint\" style={{ fontSize: 11 }}>\n                    {trail.premiseCount} premise(s)\n                    {trail.weakest === null ? \"\" : ` ┬╖ weak: ${trail.weakest.kind}`}\n                  </span>\n                </span>\n              </button>\n\n              {expanded ? (\n                <div style={{ padding: \"8px 4px 14px\" }}>\n                  <p className=\"notice notice-info\" style={{ fontSize: 12 }}>\n                    {renderWeakest(trail)}\n                  </p>\n                  <pre\n                    className=\"mono\"\n                    style={{ whiteSpace: \"pre-wrap\", fontSize: 11, margin: \"8px 0 0\" }}\n                  >\n                    {renderTrail(trail)}\n                  </pre>\n                  <details style={{ marginTop: 8 }}>\n                    <summary className=\"faint\" style={{ fontSize: 11, cursor: \"pointer\" }}>\n                      the same chain in learned-time order ({chronologicalOrder(trail).length} node\n                      (s))\n                    </summary>\n                    <ol className=\"faint\" style={{ fontSize: 11, paddingLeft: 18 }}>\n                      {chronologicalOrder(trail).map((step, index) => (\n                        <li key={`${step.nodeId}-${index}`}>\n                          <span className=\"mono\">{step.nodeId}</span> {step.text}\n                          {step.learnedAt === null ? \"\" : ` ΓÇö learned ${step.learnedAt}`}\n                          {step.learnedFrom === null ? \"\" : ` via ${step.learnedFrom}`}\n                        </li>\n                      ))}\n                    </ol>\n                  </details>\n                </div>\n              ) : null}\n            </div>\n          );\n        })}\n      </div>\n    </section>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 24 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 24 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 24 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\views\\ReasoningView.tsx"},"span":[18538,18548],"sourceCode":"/**\n * The reasoning view ΓÇö gate G2: \"it reasons\".\n *\n * Phase 2 ┬╖ the demo surface for sub-phases 2.1ΓÇô2.10\n * Plan: plan/phase-2-truth-maintenance.md ┬º2.11\n *\n * ---------------------------------------------------------------------------\n * WHAT G2 HAS TO SHOW\n *\n * Not that a graph exists. That a change in one place MOVES a belief somewhere else,\n * through a chain the user can read, and that the system stopped short of acting on it.\n *\n * Three things on screen, in this order, because this is the order the argument runs:\n *\n *   1. THE FINDING      what is unsound, and which gate said so\n *   2. THE DIAGNOSIS    backtracking ΓåÆ nogood ΓåÆ cascade ΓåÆ entrenchment, as prose\n *   3. THE PROPOSAL     seven parts, with buttons that require a reason\n *\n * Plus the two things that make it credible rather than impressive:\n *\n *   ┬╖ GATE AVAILABILITY, always visible. Gate (b) is unavailable until Phase 3, and\n *     saying so on screen is the difference between a demo and a claim.\n *   ┬╖ THE AUDIT TRAIL, on demand. \"Why do you believe this?\" answered as a chain\n *     ordered by LEARNED time, with the weak link named.\n *\n * ---------------------------------------------------------------------------\n * COLOUR ENCODES EPISTEMIC STATUS, NEVER SEVERITY\n *\n * IN is green, OUT is grey, UNKNOWN amber, UNFOUNDED violet ΓÇö the same four colours\n * used everywhere else in the product. Red is reserved for \"an action is available\",\n * which is why the proposal buttons are the only red things here. A finding is not an\n * error; it is information about the state of a belief.\n * ---------------------------------------------------------------------------\n */\n\nimport { PREMISE_TYPES_CLOSED, VARIABLES, isWorldObservable } from \"@/ontology\";\nimport {\n  type Newcomer,\n  type RevisionCase,\n  auditDecision,\n  chronologicalOrder,\n  describeAction,\n  describeAvailability,\n  describeRun,\n  renderTrail,\n  renderWeakest,\n} from \"@/reasoning\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport {\n  applyContest,\n  applyOverride,\n  applyRejustification,\n  applyReversal,\n  applyVouch,\n  assertPremiseFalsified,\n  contestedCases,\n  deterministicCases,\n  hardestCase,\n  truncatedCases,\n  useReasoning,\n} from \"@/store/reasoning\";\nimport { useWhyLog } from \"@/store/whylog\";\nimport { LABEL_BACKGROUND, LABEL_COLOUR, LABEL_MEANING } from \"@/theme\";\nimport type { DecisionId, PremiseId, ProposalId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport type { PremiseType } from \"@/types/domain\";\nimport type { EntrenchmentBreakdown } from \"@/types/reasoning\";\nimport { type ReactElement, type ReactNode, useMemo, useState } from \"react\";\n\n/* -------------------------------------------------------------------------- */\n/* The view                                                                   */\n/* -------------------------------------------------------------------------- */\n\nexport function ReasoningView(): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const logStatus = useWhyLog((s) => s.status);\n\n  const reasoning = useReasoning();\n  const { status, result, cases, selected, error, committed, durationMs } = reasoning;\n  const unresolved = useReasoning((s) => s.unresolved);\n\n  const [showAudit, setShowAudit] = useState(false);\n  const [newcomerText, setNewcomerText] = useState(\"\");\n  const [newcomerVariable, setNewcomerVariable] = useState<string>(\"DATABASE\");\n  const [newcomerValue, setNewcomerValue] = useState(\"postgres\");\n  /** The last newcomer that went through screening. Kept so \"override anyway\" can force\n   *  the SAME information through rather than making the user retype it ΓÇö an override\n   *  that requires re-entry is an override nobody performs. */\n  const [pendingNewcomer, setPendingNewcomer] = useState<Newcomer | null>(null);\n\n  const premiseCount = state.premises.size;\n  const decisionCount = state.decisions.size;\n\n  const deterministic = useMemo(() => deterministicCases(cases), [cases]);\n  const contested = useMemo(() => contestedCases(cases), [cases]);\n  const truncated = useMemo(() => truncatedCases(cases), [cases]);\n  const hardest = useMemo(() => hardestCase(cases), [cases]);\n\n  const selectedCase = cases.find((entry) => entry.proposal.id === selected) ?? null;\n\n  /* ---------------------------------------------------------------------- */\n\n  if (decisionCount === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Reasoning</h2>\n        <p className=\"dim\">\n          There is nothing to reason about yet. Import a transcript and review it first ΓÇö the\n          reasoning cycle works on decisions and the premises they rest on, and neither exists until\n          an extraction has been committed.\n        </p>\n      </section>\n    );\n  }\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: 16 }}>\n      {/* ---- the run ---- */}\n      <section className=\"card\">\n        <h2 className=\"card-title\">Truth maintenance</h2>\n        <p className=\"dim\" style={{ marginTop: 0 }}>\n          {decisionCount} decision(s), {premiseCount} premise(s). Running the cycle labels the\n          graph, fires all three gates, backtracks to the minimal set of assumptions responsible,\n          cascades ΓÇö stopping wherever a decision has independent support ΓÇö screens any new\n          information against what it contradicts, and proposes. It never applies.\n        </p>\n\n        <div className=\"metric-grid\">\n          <Metric label=\"findings\" value={String(cases.length)} />\n          <Metric label=\"deterministic\" value={String(deterministic.length)} />\n          <Metric label=\"contested\" value={String(contested.length)} />\n          <Metric label=\"events appended\" value={String(committed)} />\n          <Metric label=\"run time\" value={`${durationMs} ms`} />\n        </div>\n\n        <div style={{ display: \"flex\", gap: 8, marginTop: 12, flexWrap: \"wrap\" }}>\n          <RunButton\n            label={status === \"running\" ? \"RunningΓÇª\" : \"Run the revision cycle\"}\n            disabled={status === \"running\" || logStatus === \"degraded\"}\n            onClick={() => void reasoning.run()}\n          />\n          <RunButton\n            label=\"Re-examine, skipping gate (b)\"\n            disabled={status === \"running\"}\n            secondary\n            onClick={() => void reasoning.run({ skipSemantic: true })}\n          />\n          <RunButton\n            label={showAudit ? \"Hide audit trails\" : \"Audit every decision\"}\n            secondary\n            onClick={() => setShowAudit((current) => !current)}\n          />\n        </div>\n\n        {logStatus === \"degraded\" ? (\n          <p className=\"notice notice-error\" style={{ marginTop: 12 }}>\n            The log is read-only because its hash chain failed verification. The cycle can still\n            label and diagnose, but it cannot record what it found.\n          </p>\n        ) : null}\n\n        {error !== null ? (\n          <p className=\"notice notice-error\" style={{ marginTop: 12 }}>\n            {error}\n          </p>\n        ) : null}\n\n        {result !== null ? (\n          <pre\n            className=\"mono faint\"\n            style={{ marginTop: 12, whiteSpace: \"pre-wrap\", fontSize: 11 }}\n          >\n            {describeRun(result.gates)}\n            {\"\\n\"}\n            {describeAvailability(result.gates)}\n          </pre>\n        ) : null}\n      </section>\n\n      {/* ---- new information: the adjudication demo ---- */}\n      <NewInformation\n        text={newcomerText}\n        variable={newcomerVariable}\n        value={newcomerValue}\n        disabled={status === \"running\"}\n        onText={setNewcomerText}\n        onVariable={setNewcomerVariable}\n        onValue={setNewcomerValue}\n        onSubmit={(newcomer) => {\n          // Remember it. A rejected newcomer is not recoverable from the run's\n          // result ΓÇö the adjudication carries the BREAKDOWN, not the information\n          // itself ΓÇö and the Contested card's \"override anyway\" has to force the\n          // SAME information through rather than making the user retype it. An\n          // override that requires re-entry is an override nobody performs.\n          setPendingNewcomer(newcomer);\n          void reasoning.run({ newcomer });\n        }}\n      />\n\n      {result?.adjudication?.kind === \"reject-newcomer\" ? (\n        <ContestedCard\n          why={result.adjudication.why}\n          blockingDecisionId={result.adjudication.blockingDecisionId}\n          newcomerBreakdown={result.adjudication.newcomerBreakdown ?? null}\n          incumbentBreakdown={result.adjudication.incumbentBreakdown ?? null}\n          newcomer={pendingNewcomer}\n        />\n      ) : null}\n\n      {unresolved.length > 0 ? (\n        <section className=\"card\">\n          <h2 className=\"card-title\">Not acted on ΓÇö needs your confirmation</h2>\n          <p className=\"dim\" style={{ marginTop: 0, fontSize: 13 }}>\n            These assertions matched no premise by exact (type, predicate), so nothing was\n            invalidated. Gate (c) fires only on RESOLVED premise identity: a false match does not\n            miss a conflict, it produces a confident, spectacular, entirely wrong cascade. Guessing\n            here is the one thing worse than asking.\n          </p>\n          <ul style={{ margin: 0, paddingLeft: 18, fontSize: 13 }}>\n            {unresolved.map((entry, index) => (\n              <li key={`${entry.assertion.predicate}-${index}`} style={{ marginBottom: 6 }}>\n                <span className=\"mono\" style={{ fontSize: 11 }}>\n                  {entry.assertion.type}.{entry.assertion.predicate}\n                </span>{\" \"}\n                ΓÇö ΓÇ£{entry.assertion.text}ΓÇ¥{\" \"}\n                <span className=\"badge\" style={{ fontSize: 10 }}>\n                  {entry.kind === \"ambiguous\"\n                    ? `${entry.candidates.length} candidates`\n                    : \"no match\"}\n                </span>\n                <div className=\"faint\" style={{ fontSize: 11 }}>\n                  {entry.explanation}\n                </div>\n              </li>\n            ))}\n          </ul>\n        </section>\n      ) : null}\n\n      {/* ---- the G2 demonstration ---- */}\n      <FalsifySection />\n\n      {/* ---- findings + diagnosis ---- */}\n      {cases.length > 0 ? (\n        <section\n          style={{ display: \"grid\", gridTemplateColumns: \"minmax(260px, 340px) 1fr\", gap: 16 }}\n        >\n          <CaseList\n            cases={cases}\n            selected={selected}\n            truncated={truncated}\n            onSelect={reasoning.select}\n          />\n          {selectedCase === null ? (\n            <section className=\"card\">\n              <p className=\"dim\">Select a finding.</p>\n            </section>\n          ) : (\n            <CaseDetail\n              entry={selectedCase}\n              isHardest={hardest?.proposal.id === selectedCase.proposal.id}\n            />\n          )}\n        </section>\n      ) : status === \"done\" ? (\n        <section className=\"card\">\n          <h2 className=\"card-title\">No gate fired</h2>\n          <p className=\"dim\" style={{ marginTop: 0 }}>\n            Nothing in the log contradicts anything else, no world-observable premise has been\n            falsified, and no excluded condition has arrived. That is a result, not an absence of\n            one ΓÇö and it is only meaningful because the availability report above says which gates\n            actually ran.\n          </p>\n        </section>\n      ) : null}\n\n      {/* ---- audit trails ---- */}\n      {showAudit ? <AuditSection /> : null}\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* Pieces                                                                     */\n/* -------------------------------------------------------------------------- */\n\nfunction Metric({ label, value }: { label: string; value: string }): ReactElement {\n  return (\n    <div className=\"metric\">\n      <div className=\"metric-value\">{value}</div>\n      <div className=\"metric-label\">{label}</div>\n    </div>\n  );\n}\n\nfunction RunButton({\n  label,\n  onClick,\n  disabled,\n  secondary,\n}: {\n  label: string;\n  onClick: () => void;\n  disabled?: boolean;\n  secondary?: boolean;\n}): ReactElement {\n  return (\n    <button\n      type=\"button\"\n      className=\"nav-item\"\n      onClick={onClick}\n      disabled={disabled === true}\n      style={\n        secondary === true ? undefined : { borderColor: \"var(--action)\", color: \"var(--action)\" }\n      }\n    >\n      {label}\n    </button>\n  );\n}\n\nfunction NewInformation({\n  text,\n  variable,\n  value,\n  disabled,\n  onText,\n  onVariable,\n  onValue,\n  onSubmit,\n}: {\n  text: string;\n  variable: string;\n  value: string;\n  disabled: boolean;\n  onText: (next: string) => void;\n  onVariable: (next: string) => void;\n  onValue: (next: string) => void;\n  onSubmit: (newcomer: Newcomer) => void;\n}): ReactElement {\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">New information</h2>\n      <p className=\"dim\" style={{ marginTop: 0 }}>\n        Something changed in the world. Enter it and the cycle will screen it against everything it\n        contradicts ΓÇö and may REFUSE it. This is the second-user scenario: a log built on \"single\n        user\" meeting the arrival of a second one.\n      </p>\n\n      <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\", alignItems: \"flex-end\" }}>\n        <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n          <span className=\"faint\">variable</span>\n          <select\n            className=\"mono\"\n            value={variable}\n            onChange={(event) => onVariable(event.target.value)}\n          >\n            {VARIABLES.map((entry) => (\n              <option key={entry} value={entry}>\n                {entry}\n              </option>\n            ))}\n          </select>\n        </label>\n\n        <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n          <span className=\"faint\">value</span>\n          <input\n            className=\"mono\"\n            value={value}\n            onChange={(event) => onValue(event.target.value)}\n            placeholder=\"postgres\"\n            style={{ minWidth: 140 }}\n          />\n        </label>\n\n        <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12, flex: 1 }}>\n          <span className=\"faint\">what was said, verbatim</span>\n          <input\n            value={text}\n            onChange={(event) => onText(event.target.value)}\n            placeholder=\"we just added a second editor, and they overwrote each other's changes\"\n            style={{ minWidth: 260 }}\n          />\n        </label>\n\n        <RunButton\n          label=\"Screen it\"\n          disabled={disabled || text.trim().length === 0}\n          onClick={() =>\n            onSubmit({\n              variable: variable as Newcomer[\"variable\"],\n              value,\n              text,\n              /* A human typed this in, so it carries the highest source authority there\n               * is. That is the honest classification, and it is also what makes the\n               * refusal interesting: even a human-stated observation can lose to an\n               * incumbent with corroboration and guards behind it. */\n              origin: \"human_stated\",\n              confidence: 0.9,\n            })\n          }\n        />\n      </div>\n    </section>\n  );\n}\n\nfunction CaseList({\n  cases,\n  selected,\n  truncated,\n  onSelect,\n}: {\n  cases: readonly RevisionCase[];\n  selected: ProposalId | null;\n  truncated: readonly RevisionCase[];\n  onSelect: (id: ProposalId) => void;\n}): ReactElement {\n  const truncatedIds = new Set(truncated.map((entry) => entry.proposal.id));\n\n  return (\n    <section className=\"card\" style={{ alignSelf: \"start\" }}>\n      <h2 className=\"card-title\">Findings</h2>\n      <p className=\"faint\" style={{ fontSize: 11, marginTop: 0 }}>\n        Deterministic gates first. A finding from gate (a) or (c) can be checked against the graph\n        without forming an opinion about a model; a finding from gate (b) cannot.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 6 }}>\n        {[...cases]\n          .sort((a, b) => Number(b.finding.deterministic) - Number(a.finding.deterministic))\n          .map((entry) => (\n            <button\n              key={entry.proposal.id}\n              type=\"button\"\n              className=\"nav-item\"\n              aria-current={selected === entry.proposal.id ? \"true\" : undefined}\n              onClick={() => onSelect(entry.proposal.id)}\n              style={{\n                textAlign: \"left\",\n                flexDirection: \"column\",\n                alignItems: \"flex-start\",\n                gap: 4,\n              }}\n            >\n              <span style={{ display: \"flex\", gap: 6, alignItems: \"center\" }}>\n                <GateBadge gate={entry.finding.gate} />\n                <span className=\"mono\" style={{ fontSize: 11 }}>\n                  {entry.finding.decisionId}\n                </span>\n                {truncatedIds.has(entry.proposal.id) ? (\n                  <span\n                    className=\"faint\"\n                    style={{ fontSize: 10 }}\n                    title=\"Backtracking or the cascade hit its depth cap. The diagnosis is knowingly incomplete.\"\n                  >\n                    incomplete\n                  </span>\n                ) : null}\n              </span>\n              <span className=\"dim\" style={{ fontSize: 12 }}>\n                {entry.finding.explanation.split(\"\\n\")[0]}\n              </span>\n            </button>\n          ))}\n      </div>\n    </section>\n  );\n}\n\nfunction GateBadge({ gate }: { gate: \"structural\" | \"semantic\" | \"premise\" }): ReactElement {\n  const label =\n    gate === \"structural\" ? \"(a) structural\" : gate === \"premise\" ? \"(c) premise\" : \"(b) semantic\";\n  const meaning =\n    gate === \"structural\"\n      ? \"Same variable, antonym values, both IN. The ontology's antonym table decided this ΓÇö no model, no threshold.\"\n      : gate === \"premise\"\n        ? \"A world-observable premise was falsified, or an excluded condition arrived. Label arithmetic on the justification set.\"\n        : \"Retrieval found the pair and a model adjudicated it. Weaker than the other two, and shown as such.\";\n\n  return (\n    <span\n      className=\"badge\"\n      title={meaning}\n      style={{\n        color: gate === \"semantic\" ? \"var(--label-unknown)\" : \"var(--label-in)\",\n        fontSize: 10,\n      }}\n    >\n      {label}\n    </span>\n  );\n}\n\nfunction CaseDetail({\n  entry,\n  isHardest,\n}: { entry: RevisionCase; isHardest: boolean }): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const proposal = entry.proposal;\n  const [reason, setReason] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n\n  /* Reversing needs the value that REPLACES the old one. When the finding names the\n   * other decision, its canonical value is the honest default; when it does not ΓÇö a\n   * premise invalidation with no rival ΓÇö the user has to supply one, because inventing\n   * it here would put a value in the log that nobody said. */\n  const rival =\n    entry.finding.otherDecisionId === null\n      ? null\n      : (state.decisions.get(entry.finding.otherDecisionId) ?? null);\n  const [newValue, setNewValue] = useState(rival?.value ?? \"\");\n\n  /* Rejustifying needs the premise the decision ACTUALLY rests on. Defaults come from\n   * the premise that failed: a rejustification usually replaces a reason of the same\n   * kind, and pre-filling the predicate keeps the new premise resolvable against the\n   * old one instead of creating a near-duplicate node. */\n  const failedPremise = state.premises.get(proposal.failedPremiseId);\n  const [premiseText, setPremiseText] = useState(\"\");\n  const [premiseType, setPremiseType] = useState<PremiseType>(failedPremise?.type ?? \"requirement\");\n  const [predicate, setPredicate] = useState(failedPremise?.predicate ?? \"requirement.statement\");\n\n  const [busy, setBusy] = useState(false);\n\n  /* Every action re-runs the cycle afterwards (┬º2.9: the label follows from the graph,\n   * never from the event), so all of them are async and the buttons lock while one is\n   * in flight. A second click mid-run would append a second batch against a graph that\n   * is about to change. */\n  const act = async (\n    run: () => Promise<{ ok: boolean; error?: string; value?: string }>,\n  ): Promise<void> => {\n    setBusy(true);\n    const outcome = await run();\n    setBusy(false);\n    setMessage(outcome.ok ? (outcome.value ?? \"Recorded.\") : (outcome.error ?? \"Failed.\"));\n  };\n\n  const wantsReverse = proposal.availableActions.includes(\"reverse\");\n  const wantsRejustify = proposal.availableActions.includes(\"rejustify\");\n  const needsValue = wantsReverse && newValue.trim().length === 0;\n  const needsPremise = wantsRejustify && premiseText.trim().length === 0;\n  const ready = reason.trim().length > 0 && !needsValue && !needsPremise;\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">\n        {proposal.unsoundDecisionId}{\" \"}\n        <span className=\"faint\" style={{ fontSize: 12, fontWeight: 400 }}>\n          proposal {proposal.id}\n        </span>\n      </h2>\n\n      {isHardest ? (\n        <p className=\"notice notice-warning\">\n          This is the most entrenched finding in the run ΓÇö the one that will cost the most to act\n          on. It is called out on purpose: the proposals most likely to be dismissed unread are the\n          ones that matter most.\n        </p>\n      ) : null}\n\n      {/* 1 */}\n      <Part n={1} title=\"What failed\">\n        <p style={{ marginTop: 0 }}>{proposal.failedPremiseText}</p>\n      </Part>\n\n      {/* 2 */}\n      <Part n={2} title=\"The evidence\">\n        <blockquote\n          style={{\n            margin: \"0 0 6px\",\n            padding: \"6px 10px\",\n            borderLeft: \"2px solid var(--edge-related)\",\n            fontSize: 13,\n          }}\n        >\n          {proposal.evidence.quote}\n        </blockquote>\n        <p className=\"faint\" style={{ fontSize: 11, margin: 0 }}>\n          source: {proposal.evidence.source} ┬╖ confidence {proposal.evidence.confidence.toFixed(2)}{\" \"}\n          ┬╖ verbatim, never paraphrased\n        </p>\n      </Part>\n\n      {/* 3 */}\n      <Part n={3} title=\"What cannot both hold\">\n        {proposal.nogood === undefined ? (\n          <p className=\"dim\" style={{ marginTop: 0 }}>\n            No conjunction was recorded for this finding.\n          </p>\n        ) : (\n          <pre className=\"mono\" style={{ whiteSpace: \"pre-wrap\", fontSize: 12, margin: 0 }}>\n            {proposal.nogood.explanation}\n          </pre>\n        )}\n      </Part>\n\n      {/* the diagnosis: steps 5 and 6 in prose */}\n      <Part n={0} title=\"The diagnosis\">\n        <p style={{ marginTop: 0, whiteSpace: \"pre-wrap\", fontSize: 13 }}>{entry.narrative}</p>\n      </Part>\n\n      {/* 4 */}\n      <Part n={4} title=\"What else it affects\">\n        {entry.cascade.steps.length === 0 ? (\n          <p className=\"dim\" style={{ marginTop: 0 }}>\n            Nothing else depended on it.\n          </p>\n        ) : (\n          <>\n            <ul style={{ margin: \"0 0 6px\", paddingLeft: 18, fontSize: 13 }}>\n              {entry.cascade.steps.map((step, index) => (\n                <li key={`${step.to}-${index}`}>\n                  <span className=\"mono\">{step.to}</span>{\" \"}\n                  {step.stoppedAtIndependentSupport ? (\n                    <span style={{ color: \"var(--label-in)\" }}>\n                      STOPS ΓÇö independent support survives\n                    </span>\n                  ) : (\n                    <LabelChip label={step.became} />\n                  )}\n                  <div className=\"faint\" style={{ fontSize: 11 }}>\n                    depth {step.depth} ┬╖ {step.reason}\n                  </div>\n                </li>\n              ))}\n            </ul>\n            {entry.cascade.truncated ? (\n              <p className=\"notice notice-warning\" style={{ fontSize: 12 }}>\n                Propagation hit the depth cap with {entry.cascade.potentiallyAffectedBeyondCap}{\" \"}\n                decision(s) unexamined. There may be more downstream than this shows.\n              </p>\n            ) : null}\n          </>\n        )}\n      </Part>\n\n      {/* 5 */}\n      <Part n={5} title=\"How costly is it to change\">\n        <p style={{ marginTop: 0 }}>\n          <strong>{proposal.entrenchment.capped.toFixed(2)}</strong>{\" \"}\n          <span className=\"badge\">{proposal.entrenchmentBand}</span>\n        </p>\n        <ul className=\"faint\" style={{ fontSize: 11, margin: 0, paddingLeft: 18 }}>\n          <li>\n            source authority {proposal.entrenchment.components.sourceAuthority.toFixed(2)} ├ù 0.30\n          </li>\n          <li>\n            implementation cost{\" \"}\n            {proposal.entrenchment.implementationCostUnknown\n              ? \"UNKNOWN ΓÇö no guard exists yet, counted as 0.50 but not measured\"\n              : `${proposal.entrenchment.components.implementationCost.toFixed(2)} ├ù 0.20`}\n          </li>\n          <li>corroboration {proposal.entrenchment.components.corroboration.toFixed(2)} ├ù 0.20</li>\n          <li>confidence {proposal.entrenchment.components.confidence.toFixed(2)} ├ù 0.15</li>\n          <li>recency {proposal.entrenchment.components.recency.toFixed(2)} ├ù 0.15</li>\n          {proposal.entrenchment.ee3CapApplied ? (\n            <li>\n              EE3 cap binds at {proposal.entrenchment.capped.toFixed(2)} because of{\" \"}\n              <span className=\"mono\">{proposal.entrenchment.weakestPremiseId}</span> ΓÇö a derived\n              belief is never more entrenched than its weakest premise\n            </li>\n          ) : null}\n        </ul>\n      </Part>\n\n      {/* 6 */}\n      <Part n={6} title=\"What you can do\">\n        <p className=\"faint\" style={{ fontSize: 11, marginTop: 0 }}>\n          Every action requires a reason. The reason is what the audit trail shows six months from\n          now when somebody asks why this changed.\n        </p>\n\n        {wantsReverse ? (\n          <label\n            style={{\n              display: \"flex\",\n              flexDirection: \"column\",\n              gap: 4,\n              fontSize: 12,\n              marginBottom: 8,\n            }}\n          >\n            <span className=\"faint\">\n              the value that replaces it\n              {rival === null ? \"\" : ` ΓÇö defaults to ${rival.id} \"${rival.value}\"`}\n            </span>\n            <input\n              className=\"mono\"\n              value={newValue}\n              onChange={(event) => setNewValue(event.target.value)}\n              placeholder=\"postgres\"\n            />\n          </label>\n        ) : null}\n\n        {wantsRejustify ? (\n          <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\", marginBottom: 8 }}>\n            <label\n              style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12, flex: 1 }}\n            >\n              <span className=\"faint\">\n                what it really rests on\n                {failedPremise === undefined ? \"\" : ` ΓÇö replacing \"${failedPremise.text}\"`}\n              </span>\n              <input\n                value={premiseText}\n                onChange={(event) => setPremiseText(event.target.value)}\n                placeholder=\"we are fine with two users as long as writes are serialised\"\n                style={{ minWidth: 240 }}\n              />\n            </label>\n            <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n              <span className=\"faint\">premise type</span>\n              <select\n                className=\"mono\"\n                value={premiseType}\n                onChange={(event) => setPremiseType(event.target.value as PremiseType)}\n              >\n                {PREMISE_TYPES_CLOSED.map((entry) => (\n                  <option key={entry} value={entry}>\n                    {entry}\n                  </option>\n                ))}\n              </select>\n            </label>\n            <label style={{ display: \"flex\", flexDirection: \"column\", gap: 4, fontSize: 12 }}>\n              <span className=\"faint\">predicate</span>\n              <input\n                className=\"mono\"\n                value={predicate}\n                onChange={(event) => setPredicate(event.target.value)}\n                style={{ minWidth: 160 }}\n              />\n            </label>\n          </div>\n        ) : null}\n\n        <input\n          value={reason}\n          onChange={(event) => setReason(event.target.value)}\n          placeholder=\"why ΓÇö required, and it goes in the log\"\n          style={{ width: \"100%\", marginBottom: 8 }}\n        />\n\n        <div style={{ display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n          {proposal.availableActions.map((action) => (\n            <RunButton\n              key={action}\n              label={action}\n              disabled={!ready || busy}\n              onClick={() => {\n                switch (action) {\n                  case \"reverse\":\n                    void act(() =>\n                      applyReversal(proposal.unsoundDecisionId, newValue.trim(), reason),\n                    );\n                    return;\n                  case \"rejustify\":\n                    /* Creates the premise, its justification and the link in one batch.\n                     * It cannot take an id from here: ids come from the folded counters,\n                     * so any id invented in the view would point at nothing. */\n                    void act(() =>\n                      applyRejustification(proposal.unsoundDecisionId, {\n                        premiseText: premiseText.trim(),\n                        premiseType,\n                        predicate,\n                        reason,\n                      }),\n                    );\n                    return;\n                  case \"contest\":\n                    void act(() => applyContest(proposal.failedPremiseId, reason));\n                    return;\n                }\n              }}\n            />\n          ))}\n          <RunButton\n            label=\"keep it ΓÇö I vouch for this\"\n            secondary\n            disabled={reason.trim().length === 0 || busy}\n            onClick={() => void act(() => applyVouch(proposal.id, reason))}\n          />\n        </div>\n\n        <p className=\"faint\" style={{ fontSize: 11, marginTop: 8 }}>\n          {proposal.availableActions.map((action) => describeAction(action)).join(\" ┬╖ \")} ┬╖ keep it\n          ΓÇö vouch for the decision personally, raising its authority to 0.9 and resolving the\n          proposal\n        </p>\n\n        {entry.reassertsNogood !== null ? (\n          <p className=\"notice notice-warning\" style={{ fontSize: 12, marginTop: 8 }}>\n            You are re-asserting a combination this log already found impossible on{\" \"}\n            {entry.reassertsNogood.recordedAt.slice(0, 10)} (\n            <span className=\"mono\">{entry.reassertsNogood.id}</span>).{\" \"}\n            {entry.reassertsNogood.explanation}\n          </p>\n        ) : null}\n\n        {message !== null ? (\n          <p className=\"notice notice-info\" style={{ fontSize: 12 }}>\n            {message}\n          </p>\n        ) : null}\n      </Part>\n\n      {/* 7 */}\n      <Part n={7} title=\"Why this was not applied for you\">\n        <p style={{ marginTop: 0, whiteSpace: \"pre-wrap\", fontSize: 13 }}>\n          {proposal.whyNotAutoApplied}\n        </p>\n      </Part>\n    </section>\n  );\n}\n\nfunction Part({\n  n,\n  title,\n  children,\n}: {\n  n: number;\n  title: string;\n  /** `ReactNode`, not `ReactElement`: a section's body is often a conditional, and a\n   *  conditional that renders nothing is `null`, not a missing element. */\n  children: ReactNode;\n}): ReactElement {\n  return (\n    <div style={{ marginTop: 14 }}>\n      <h3 style={{ fontSize: 12, letterSpacing: \"0.02em\", margin: \"0 0 6px\" }}>\n        {n > 0 ? `${n}. ` : \"\"}\n        {title}\n      </h3>\n      {children}\n    </div>\n  );\n}\n\nfunction LabelChip({ label }: { label: DecisionLabel }): ReactElement {\n  return (\n    <span\n      className=\"badge\"\n      title={LABEL_MEANING[label]}\n      style={{ color: LABEL_COLOUR[label], background: LABEL_BACKGROUND[label] }}\n    >\n      {label}\n    </span>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The Contested queue                                                        */\n/* -------------------------------------------------------------------------- */\n\n/**\n * ┬º2.8: \"A rejected newcomer appears in a Contested queue with the FULL ENTRENCHMENT\n * BREAKDOWN OF BOTH SIDES and an explicit 'override anyway' action.\"\n *\n * Both breakdowns are rendered term by term, not as two totals. That is what makes\n * override an informed choice: the user can see that the newcomer lost on corroboration\n * and implementation cost ΓÇö the two terms it structurally cannot have ΓÇö rather than on\n * authority, and decide whether that is a good enough reason to refuse them.\n */\nfunction ContestedCard({\n  why,\n  blockingDecisionId,\n  newcomerBreakdown,\n  incumbentBreakdown,\n  newcomer,\n}: {\n  why: string;\n  blockingDecisionId: DecisionId;\n  newcomerBreakdown: EntrenchmentBreakdown | null;\n  incumbentBreakdown: EntrenchmentBreakdown | null;\n  newcomer: Newcomer | null;\n}): ReactElement {\n  const [reason, setReason] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const override = async (): Promise<void> => {\n    if (newcomer === null) return;\n    setBusy(true);\n    const outcome = await applyOverride(newcomer, null, reason);\n    setBusy(false);\n    setMessage(outcome.ok ? outcome.value : outcome.error);\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Contested ΓÇö the new information was refused</h2>\n      <p style={{ marginTop: 0, whiteSpace: \"pre-wrap\", fontSize: 13 }}>{why}</p>\n\n      <div style={{ display: \"grid\", gridTemplateColumns: \"1fr 1fr\", gap: 12, marginTop: 12 }}>\n        <BreakdownColumn\n          title=\"the newcomer\"\n          breakdown={newcomerBreakdown}\n          tone=\"var(--label-unknown)\"\n        />\n        <BreakdownColumn\n          title={`${blockingDecisionId} (incumbent)`}\n          breakdown={incumbentBreakdown}\n          tone=\"var(--label-in)\"\n        />\n      </div>\n\n      <p className=\"faint\" style={{ fontSize: 11, marginTop: 10 }}>\n        Non-prioritized revision (Hansson). AGM's Success postulate ΓÇö always accept new information\n        ΓÇö would let one remark in a transcript overwrite a decision made over three days. Refusal is\n        never silent: this is the queue, and the override is right here.\n      </p>\n\n      {newcomer === null ? (\n        <p className=\"faint\" style={{ fontSize: 12 }}>\n          The refused information is no longer in hand ΓÇö re-enter it above to override.\n        </p>\n      ) : (\n        <div style={{ marginTop: 10 }}>\n          <input\n            value={reason}\n            onChange={(event) => setReason(event.target.value)}\n            placeholder=\"why you are overruling the arithmetic ΓÇö required, and it goes in the log\"\n            style={{ width: \"100%\", marginBottom: 8 }}\n          />\n          <RunButton\n            label={busy ? \"OverridingΓÇª\" : \"override anyway\"}\n            disabled={busy || reason.trim().length === 0}\n            onClick={() => void override()}\n          />\n          <p className=\"faint\" style={{ fontSize: 11, marginTop: 6 }}>\n            Writes a <span className=\"mono\">HumanOverride</span> event and raises the newcomer's\n            source authority to 0.9 ΓÇö high enough to win every subsequent adjudication, but still\n            below a directly human-stated decision (1.0), so an override can itself be overridden by\n            better evidence. An override that could never be overturned is not a queue, it is a dead\n            end.\n          </p>\n        </div>\n      )}\n\n      {message !== null ? (\n        <p className=\"notice notice-info\" style={{ fontSize: 12, marginTop: 8 }}>\n          {message}\n        </p>\n      ) : null}\n    </section>\n  );\n}\n\nfunction BreakdownColumn({\n  title,\n  breakdown,\n  tone,\n}: {\n  title: string;\n  breakdown: EntrenchmentBreakdown | null;\n  tone: string;\n}): ReactElement {\n  if (breakdown === null) {\n    return (\n      <div>\n        <h3 style={{ fontSize: 12, margin: \"0 0 6px\", color: tone }}>{title}</h3>\n        <p className=\"dim\" style={{ fontSize: 12, margin: 0 }}>\n          No breakdown recorded.\n        </p>\n      </div>\n    );\n  }\n\n  const c = breakdown.components;\n\n  return (\n    <div>\n      <h3 style={{ fontSize: 12, margin: \"0 0 6px\", color: tone }}>\n        {title} ΓÇö {breakdown.capped.toFixed(2)}\n      </h3>\n      <ul className=\"faint\" style={{ fontSize: 11, margin: 0, paddingLeft: 18 }}>\n        <li>source authority {c.sourceAuthority.toFixed(2)} ├ù 0.30</li>\n        <li>\n          implementation cost {c.implementationCost.toFixed(2)} ├ù 0.20\n          {breakdown.implementationCostUnknown ? \" ΓÇö unknown, not measured\" : \"\"}\n        </li>\n        <li>corroboration {c.corroboration.toFixed(2)} ├ù 0.20</li>\n        <li>confidence {c.confidence.toFixed(2)} ├ù 0.15</li>\n        <li>recency {c.recency.toFixed(2)} ├ù 0.15</li>\n        {breakdown.ee3CapApplied ? (\n          <li>\n            EE3 cap binds at {breakdown.capped.toFixed(2)} via{\" \"}\n            <span className=\"mono\">{breakdown.weakestPremiseId}</span>\n          </li>\n        ) : null}\n      </ul>\n    </div>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The G2 demonstration                                                       */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Falsify a world-observable premise.\n *\n * This is gate G2: `single-user` becomes false, the decision resting on it goes\n * UNSOUND, anything downstream cascades, anything with independent support survives,\n * and a proposal appears with its entrenchment broken down.\n *\n * Only WORLD-OBSERVABLE premises are listed ΓÇö `scale`, `deployment`, `capability`,\n * `external`. The intent-based ones (`team`, `budget`, `time`, `requirement`) are\n * excluded on purpose: nobody can observe that you stopped wanting offline mode, so\n * only a human can retract those, and offering a button that pretends otherwise would\n * be offering a lie. They are listed separately, greyed, saying exactly that.\n */\nfunction FalsifySection(): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const labels = useReasoning((s) => s.result?.labels);\n  const empty = useMemo(() => new Map<NodeId, Labelled>(), []);\n  const labelMap: ReadonlyMap<NodeId, Labelled> = labels ?? empty;\n\n  const [target, setTarget] = useState<PremiseId | null>(null);\n  const [observed, setObserved] = useState(\"\");\n  const [message, setMessage] = useState<string | null>(null);\n  const [busy, setBusy] = useState(false);\n\n  const premises = useMemo(() => {\n    const all = [...state.premises.values()].sort((a, b) => (a.id < b.id ? -1 : 1));\n    return {\n      observable: all.filter((premise) => isWorldObservable(premise.type)),\n      intent: all.filter((premise) => !isWorldObservable(premise.type)),\n    };\n  }, [state.premises]);\n\n  if (premises.observable.length === 0 && premises.intent.length === 0) {\n    return (\n      <section className=\"card\">\n        <h2 className=\"card-title\">Falsify a premise</h2>\n        <p className=\"dim\" style={{ marginTop: 0 }}>\n          No premises in the log yet. Premises are what make this more than a decision list: they\n          are the conditions a decision was true under, and they are what reality invalidates.\n        </p>\n      </section>\n    );\n  }\n\n  const submit = async (): Promise<void> => {\n    if (target === null) return;\n    setBusy(true);\n    const outcome = await assertPremiseFalsified(target, observed);\n    setBusy(false);\n    setMessage(outcome.ok ? outcome.value : outcome.error);\n    if (outcome.ok) {\n      setTarget(null);\n      setObserved(\"\");\n    }\n  };\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Something stopped being true</h2>\n      <p className=\"dim\" style={{ marginTop: 0, fontSize: 13 }}>\n        This is the demonstration the whole project exists for. Pick a premise about the world, say\n        what you observed instead, and the cycle will find every decision that was true{\" \"}\n        <em>given</em> it ΓÇö then backtrack, cascade, weigh what it would cost to change, and\n        propose. It will not apply anything.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 6 }}>\n        {premises.observable.map((premise) => {\n          const expanded = target === premise.id;\n          const label = labelMap.get(premise.id)?.label ?? premise.label;\n\n          return (\n            <div key={premise.id} style={{ borderTop: \"1px solid var(--edge-related)\" }}>\n              <button\n                type=\"button\"\n                className=\"nav-item\"\n                onClick={() => setTarget(expanded ? null : premise.id)}\n                style={{ width: \"100%\", justifyContent: \"space-between\", textAlign: \"left\" }}\n              >\n                <span>\n                  <span className=\"mono\" style={{ fontSize: 11 }}>\n                    {premise.id}\n                  </span>{\" \"}\n                  {premise.text}\n                </span>\n                <span style={{ display: \"flex\", gap: 6, alignItems: \"center\" }}>\n                  <LabelChip label={label} />\n                  <span className=\"badge faint\" style={{ fontSize: 10 }}>\n                    {premise.type}\n                  </span>\n                </span>\n              </button>\n\n              {expanded ? (\n                <div style={{ padding: \"8px 4px 14px\", display: \"flex\", gap: 8, flexWrap: \"wrap\" }}>\n                  <input\n                    value={observed}\n                    onChange={(event) => setObserved(event.target.value)}\n                    placeholder={`what you observed instead ΓÇö e.g. \"there are two of us editing it now\"`}\n                    style={{ flex: 1, minWidth: 260 }}\n                  />\n                  <RunButton\n                    label={busy ? \"Running the cycleΓÇª\" : \"Falsify it\"}\n                    disabled={busy || observed.trim().length === 0}\n                    onClick={() => void submit()}\n                  />\n                  <p className=\"faint\" style={{ fontSize: 11, width: \"100%\", margin: 0 }}>\n                    Recorded as a <span className=\"mono\">repo-scan</span> observation that refutes{\" \"}\n                    <span className=\"mono\">{premise.predicate}</span>. The same path a guard will\n                    take in Phase 4 ΓÇö no branch in the reasoning code knows or cares which one it\n                    was.\n                  </p>\n                </div>\n              ) : null}\n            </div>\n          );\n        })}\n      </div>\n\n      {premises.intent.length > 0 ? (\n        <details style={{ marginTop: 12 }}>\n          <summary className=\"faint\" style={{ fontSize: 12, cursor: \"pointer\" }}>\n            {premises.intent.length} premise(s) about intent, which cannot be falsified by\n            observation\n          </summary>\n          <ul className=\"faint\" style={{ fontSize: 12, paddingLeft: 18 }}>\n            {premises.intent.map((premise) => (\n              <li key={premise.id}>\n                <span className=\"mono\">{premise.id}</span> {premise.text}{\" \"}\n                <span className=\"badge\" style={{ fontSize: 10 }}>\n                  {premise.type}\n                </span>\n              </li>\n            ))}\n          </ul>\n          <p className=\"faint\" style={{ fontSize: 11 }}>\n            <span className=\"mono\">team</span>, <span className=\"mono\">budget</span>,{\" \"}\n            <span className=\"mono\">time</span> and <span className=\"mono\">requirement</span>{\" \"}\n            premises record what you wanted, not what the world is. No scan can observe that you\n            stopped wanting offline mode, so no guard can check them and nothing here will retract\n            them. Only you can, and the log marks them unverifiable rather than pretending\n            otherwise.\n          </p>\n        </details>\n      ) : null}\n\n      {message !== null ? (\n        <p\n          className=\"notice notice-info\"\n          style={{ fontSize: 12, marginTop: 12, whiteSpace: \"pre-wrap\" }}\n        >\n          {message}\n        </p>\n      ) : null}\n    </section>\n  );\n}\n\n/* -------------------------------------------------------------------------- */\n/* The audit section                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction AuditSection(): ReactElement {\n  const state = useWhyLog((s) => s.state);\n  const labels = useReasoning((s) => s.result?.labels);\n  const [open, setOpen] = useState<DecisionId | null>(null);\n\n  const empty = useMemo(() => new Map<NodeId, Labelled>(), []);\n  const labelMap: ReadonlyMap<NodeId, Labelled> = labels ?? empty;\n\n  const decisions = useMemo(\n    () => [...state.decisions.values()].sort((a, b) => (a.id < b.id ? -1 : 1)),\n    [state.decisions],\n  );\n\n  return (\n    <section className=\"card\">\n      <h2 className=\"card-title\">Why do you believe this?</h2>\n      <p className=\"dim\" style={{ marginTop: 0, fontSize: 13 }}>\n        The full support chain for every decision, ordered by <strong>learned</strong> time ΓÇö when\n        the system found out, not when it happened. An audit ordered by valid time would claim the\n        system reasoned about something before it knew about it, and an audit that lies about its\n        own clock is not an audit.\n      </p>\n\n      <div style={{ display: \"flex\", flexDirection: \"column\", gap: 6 }}>\n        {decisions.map((decision) => {\n          const trail = auditDecision(state, labelMap, decision.id);\n          const expanded = open === decision.id;\n\n          return (\n            <div key={decision.id} style={{ borderTop: \"1px solid var(--edge-related)\" }}>\n              <button\n                type=\"button\"\n                className=\"nav-item\"\n                onClick={() => setOpen(expanded ? null : decision.id)}\n                style={{ width: \"100%\", justifyContent: \"space-between\", textAlign: \"left\" }}\n              >\n                <span>\n                  <span className=\"mono\" style={{ fontSize: 11 }}>\n                    {decision.id}\n                  </span>{\" \"}\n                  {decision.statement}\n                </span>\n                <span style={{ display: \"flex\", gap: 6, alignItems: \"center\" }}>\n                  <LabelChip label={labelMap.get(decision.id)?.label ?? decision.label} />\n                  <span className=\"faint\" style={{ fontSize: 11 }}>\n                    {trail.premiseCount} premise(s)\n                    {trail.weakest === null ? \"\" : ` ┬╖ weak: ${trail.weakest.kind}`}\n                  </span>\n                </span>\n              </button>\n\n              {expanded ? (\n                <div style={{ padding: \"8px 4px 14px\" }}>\n                  <p className=\"notice notice-info\" style={{ fontSize: 12 }}>\n                    {renderWeakest(trail)}\n                  </p>\n                  <pre\n                    className=\"mono\"\n                    style={{ whiteSpace: \"pre-wrap\", fontSize: 11, margin: \"8px 0 0\" }}\n                  >\n                    {renderTrail(trail)}\n                  </pre>\n                  <details style={{ marginTop: 8 }}>\n                    <summary className=\"faint\" style={{ fontSize: 11, cursor: \"pointer\" }}>\n                      the same chain in learned-time order ({chronologicalOrder(trail).length} node\n                      (s))\n                    </summary>\n                    <ol className=\"faint\" style={{ fontSize: 11, paddingLeft: 18 }}>\n                      {chronologicalOrder(trail).map((step, index) => (\n                        <li key={`${step.nodeId}-${index}`}>\n                          <span className=\"mono\">{step.nodeId}</span> {step.text}\n                          {step.learnedAt === null ? \"\" : ` ΓÇö learned ${step.learnedAt}`}\n                          {step.learnedFrom === null ? \"\" : ` via ${step.learnedFrom}`}\n                        </li>\n                      ))}\n                    </ol>\n                  </details>\n                </div>\n              ) : null}\n            </div>\n          );\n        })}\n      </div>\n    </section>\n  );\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 135 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 135 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 135 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[9887,9897],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  let next = decision;\n\n  const statement = fields[\"statement\"]fields.statement;\n  if (typeof statement === \"string\") next = { ...next, statement };\n  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1139}},{"diffOp":{"equal":{"range":[33,77]}}},{"diffOp":{"delete":{"range":[77,96]}}},{"diffOp":{"insert":{"range":[96,112]}}},{"diffOp":{"equal":{"range":[112,182]}}},{"equalLines":{"line_count":509}},{"diffOp":{"equal":{"range":[182,222]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[40811,40822],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"]fields.rationale;\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1142}},{"diffOp":{"equal":{"range":[33,122]}}},{"diffOp":{"delete":{"range":[122,141]}}},{"diffOp":{"insert":{"range":[141,157]}}},{"diffOp":{"equal":{"range":[157,259]}}},{"equalLines":{"line_count":506}},{"diffOp":{"equal":{"range":[259,299]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[40921,40932],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  }\n\n  const downside = fields[\"acceptedDownside\"]fields.acceptedDownside;\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1152}},{"diffOp":{"equal":{"range":[33,57]}}},{"diffOp":{"delete":{"range":[57,83]}}},{"diffOp":{"insert":{"range":[83,106]}}},{"diffOp":{"equal":{"range":[106,223]}}},{"equalLines":{"line_count":496}},{"diffOp":{"equal":{"range":[223,263]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[41349,41367],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  }\n\n  const yStatement = fields[\"yStatement\"]fields.yStatement;\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1159}},{"diffOp":{"equal":{"range":[33,59]}}},{"diffOp":{"delete":{"range":[59,79]}}},{"diffOp":{"insert":{"range":[79,96]}}},{"diffOp":{"equal":{"range":[96,201]}}},{"equalLines":{"line_count":489}},{"diffOp":{"equal":{"range":[201,241]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[41594,41606],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  }\n\n  const value = fields[\"value\"]fields.value;\n  if (typeof value === \"string\") next = { ...next, value };\n  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1166}},{"diffOp":{"equal":{"range":[33,54]}}},{"diffOp":{"delete":{"range":[54,69]}}},{"diffOp":{"insert":{"range":[69,81]}}},{"diffOp":{"equal":{"range":[81,143]}}},{"equalLines":{"line_count":482}},{"diffOp":{"equal":{"range":[143,183]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[41810,41817],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"]fields.variable;\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1169}},{"diffOp":{"equal":{"range":[33,113]}}},{"diffOp":{"delete":{"range":[113,131]}}},{"diffOp":{"insert":{"range":[131,146]}}},{"diffOp":{"equal":{"range":[146,244]}}},{"equalLines":{"line_count":479}},{"diffOp":{"equal":{"range":[244,284]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[41907,41917],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"]fields.appliesTo;\n  if (typeof appliesTo === \"string\") {\n    next = {  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1172}},{"diffOp":{"equal":{"range":[33,150]}}},{"diffOp":{"delete":{"range":[150,169]}}},{"diffOp":{"insert":{"range":[169,185]}}},{"diffOp":{"equal":{"range":[185,238]}}},{"equalLines":{"line_count":476}},{"diffOp":{"equal":{"range":[238,278]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[42044,42055],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  let next = premise;\n\n  const text = fields[\"text\"]fields.text;\n  if (typeof text === \"string\") next = { ...next, text };\n  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1189}},{"diffOp":{"equal":{"range":[33,71]}}},{"diffOp":{"delete":{"range":[71,85]}}},{"diffOp":{"insert":{"range":[85,96]}}},{"diffOp":{"equal":{"range":[96,156]}}},{"equalLines":{"line_count":459}},{"diffOp":{"equal":{"range":[156,196]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[42394,42400],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"]fields.predicate;\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1192}},{"diffOp":{"equal":{"range":[33,112]}}},{"diffOp":{"delete":{"range":[112,131]}}},{"diffOp":{"insert":{"range":[131,147]}}},{"diffOp":{"equal":{"range":[147,217]}}},{"equalLines":{"line_count":456}},{"diffOp":{"equal":{"range":[217,257]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[42489,42500],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"]fields.type;\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1195}},{"diffOp":{"equal":{"range":[33,117]}}},{"diffOp":{"delete":{"range":[117,131]}}},{"diffOp":{"insert":{"range":[131,142]}}},{"diffOp":{"equal":{"range":[142,227]}}},{"equalLines":{"line_count":453}},{"diffOp":{"equal":{"range":[227,267]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[42594,42600],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * The fold: log -> state.\n *  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"]fields.value;\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };  return fold(state.events, options);\n}\n","ops":[{"diffOp":{"equal":{"range":[0,33]}}},{"equalLines":{"line_count":1198}},{"diffOp":{"equal":{"range":[33,133]}}},{"diffOp":{"delete":{"range":[133,148]}}},{"diffOp":{"insert":{"range":[148,160]}}},{"diffOp":{"equal":{"range":[160,286]}}},{"equalLines":{"line_count":450}},{"diffOp":{"equal":{"range":[286,326]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[42710,42717],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 18 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 18 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 18 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\substrate\\materialize.ts"},"span":[47551,47576],"sourceCode":"/**\n * The fold: log -> state.\n *\n * Phase 0 ┬╖ sub-phase 0.2\n * Plan: plan/phase-0-foundation.md ┬º0.2\n *\n * ---------------------------------------------------------------------------\n * CONTRACT\n *\n * `fold(events)` is PURE and TOTAL.\n *\n *   PURE  ΓÇö no clock, no randomness, no I/O, no mutation of its argument.\n *           The same event array always produces a structurally identical state,\n *           which is what makes export -> import -> identical head hash a\n *           testable property rather than a hope.\n *   TOTAL ΓÇö every one of the 35 event types is handled, and a malformed or\n *           unresolvable event is RECORDED and skipped rather than thrown. A log\n *           that cannot be folded is a log that cannot be loaded, and a log that\n *           cannot be loaded is data loss.\n *\n * Target: full replay of 10^4 events in under 10 ms. The draft uses plain\n * mutable Maps internally and exposes ReadonlyMaps at the boundary, so a rebuild\n * is O(events) with no per-event copying.\n *\n * ---------------------------------------------------------------------------\n * WHY `applyEvent` IS EXPORTED SEPARATELY\n *\n * Incremental append must produce EXACTLY the state a full replay would. Keeping\n * one function that both `fold` and the live append path call is the only way\n * that property survives contact with Phase 2, where the case count grows.\n * ---------------------------------------------------------------------------\n */\n\nimport { asConfidence } from \"@/types/common\";\nimport type {\n  AlternativeId,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ExportId,\n  GuardId,\n  ISODateString,\n  JustificationId,\n  NogoodId,\n  PremiseId,\n  ProposalId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type {\n  Decision,\n  DecisionLabel,\n  DecisionVariable,\n  Episode,\n  Justification,\n  Nogood,\n  Premise,\n  PremiseEvidence,\n  RejectedAlternative,\n  Transcript,\n} from \"@/types/domain\";\nimport type { AnyEvent } from \"@/types/events\";\nimport type { ExportStats } from \"@/types/export\";\nimport type { Guard, GuardRunResult } from \"@/types/guards\";\nimport type { CascadeResult, NogoodRecord, RevisionProposal } from \"@/types/reasoning\";\nimport { entrenchmentBand } from \"@/types/reasoning\";\nimport { closeWindow, openWindow, reopenWindow } from \"./bi-temporal\";\nimport {\n  type ContradictionRecord,\n  type ExportRecordState,\n  type GraphState,\n  INDEX_UNBUILT,\n  ZERO_COUNTERS,\n} from \"./graph-state\";\nimport { GENESIS_HASH, linkHash } from \"./hash-chain\";\nimport { SCHEMA_VERSION } from \"./schema\";\n\n/* -------------------------------------------------------------------------- */\n/* The draft                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The mutable working form of {@link GraphState}.\n *\n * Every collection is widened to its mutable counterpart. Nothing outside this\n * module sees a Draft, and `freeze` is the only way out.\n */\nexport interface Draft {\n  events: AnyEvent[];\n  headHash: string;\n  lastEventId: EventId | null;\n  schemaVersion: number;\n\n  decisions: Map<DecisionId, Decision>;\n  premises: Map<PremiseId, Premise>;\n  justifications: Map<JustificationId, Justification>;\n  nogoods: Map<NogoodId, Nogood>;\n\n  transcripts: Map<TranscriptId, Transcript>;\n  episodes: Map<EpisodeId, Episode>;\n  alternatives: Map<AlternativeId, RejectedAlternative>;\n\n  guards: Map<GuardId, Guard>;\n  proposals: Map<ProposalId, RevisionProposal>;\n  contradictions: ContradictionRecord[];\n  exports: Map<ExportId, ExportRecordState>;\n\n  byVariable: ReadonlyMap<DecisionVariable, readonly DecisionId[]>;\n  byFingerprint: Map<string, DecisionId>;\n  premiseByFingerprint: Map<string, PremiseId>;\n  premiseToDecisions: ReadonlyMap<PremiseId, readonly DecisionId[]>;\n  guardIndex: Map<GuardId, DecisionId>;\n\n  pendingReview: DecisionId[];\n  pendingPremises: PremiseId[];\n  overrides: Map<DecisionId, number>;\n\n  engine: EngineId;\n  index: GraphState[\"index\"];\n  counters: GraphState[\"counters\"];\n\n  metrics: Map<string, number>;\n  computedAt: ISODateString;\n\n  /** Events that could not be applied, in order. Reported, never thrown. */\n  skipped: { eventId: EventId; type: string; reason: string }[];\n}\n\n/** A fresh draft. `engine` and `at` come from the caller ΓÇö the fold never reads\n *  a clock, which is the whole of its purity. */\nexport function emptyDraft(engine: EngineId, at: ISODateString): Draft {\n  return {\n    events: [],\n    headHash: GENESIS_HASH,\n    lastEventId: null,\n    schemaVersion: SCHEMA_VERSION,\n\n    decisions: new Map(),\n    premises: new Map(),\n    justifications: new Map(),\n    nogoods: new Map(),\n\n    transcripts: new Map(),\n    episodes: new Map(),\n    alternatives: new Map(),\n\n    guards: new Map(),\n    proposals: new Map(),\n    contradictions: [],\n    exports: new Map(),\n\n    byVariable: new Map(),\n    byFingerprint: new Map(),\n    premiseByFingerprint: new Map(),\n    premiseToDecisions: new Map(),\n    guardIndex: new Map(),\n\n    pendingReview: [],\n    pendingPremises: [],\n    overrides: new Map(),\n\n    engine,\n    index: INDEX_UNBUILT,\n    counters: ZERO_COUNTERS,\n\n    metrics: new Map(),\n    computedAt: at,\n    skipped: [],\n  };\n}\n\n/** Convert a frozen state back into a draft, for incremental append. */\nexport function toDraft(state: GraphState): Draft {\n  return {\n    events: [...state.events],\n    headHash: state.headHash,\n    lastEventId: state.lastEventId,\n    schemaVersion: state.schemaVersion,\n\n    decisions: new Map(state.decisions),\n    premises: new Map(state.premises),\n    justifications: new Map(state.justifications),\n    nogoods: new Map(state.nogoods),\n\n    transcripts: new Map(state.transcripts),\n    episodes: new Map(state.episodes),\n    alternatives: new Map(state.alternatives),\n\n    guards: new Map(state.guards),\n    proposals: new Map(state.proposals),\n    contradictions: [...state.contradictions],\n    exports: new Map(state.exports),\n\n    byVariable: new Map(state.byVariable),\n    byFingerprint: new Map(state.byFingerprint),\n    premiseByFingerprint: new Map(state.premiseByFingerprint),\n    premiseToDecisions: new Map(state.premiseToDecisions),\n    guardIndex: new Map(state.guardIndex),\n\n    pendingReview: [...state.pendingReview],\n    pendingPremises: [...state.pendingPremises],\n    overrides: new Map(state.overrides),\n\n    engine: state.engine,\n    index: state.index,\n    counters: state.counters,\n\n    metrics: new Map(state.metrics),\n    computedAt: state.computedAt,\n    skipped: [],\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Draft helpers                                                              */\n/* -------------------------------------------------------------------------- */\n\nfunction skip(draft: Draft, event: AnyEvent, reason: string): void {\n  draft.skipped.push({ eventId: event.id, type: event.type, reason });\n}\n\n/** Update one node. Returns false when the node does not exist, so callers can\n *  record a skip rather than silently no-op. */\nfunction patchDecision(\n  draft: Draft,\n  id: DecisionId,\n  patch: (current: Decision) => Decision,\n): boolean {\n  const current = draft.decisions.get(id);\n  if (!current) return false;\n  draft.decisions.set(id, patch(current));\n  return true;\n}\n\nfunction patchPremise(draft: Draft, id: PremiseId, patch: (c: Premise) => Premise): boolean {\n  const current = draft.premises.get(id);\n  if (!current) return false;\n  draft.premises.set(id, patch(current));\n  return true;\n}\n\nfunction patchGuard(draft: Draft, id: GuardId, patch: (c: Guard) => Guard): boolean {\n  const current = draft.guards.get(id);\n  if (!current) return false;\n  draft.guards.set(id, patch(current));\n  return true;\n}\n\ntype EdgeKey = \"supersedes\" | \"supersededBy\" | \"conflictsWith\" | \"dependsOn\" | \"related\";\n\nconst MIRROR: Readonly<Record<EdgeKey, EdgeKey | null>> = {\n  supersedes: \"supersededBy\",\n  supersededBy: \"supersedes\",\n  conflictsWith: \"conflictsWith\",\n  dependsOn: null,\n  related: \"related\",\n};\n\n/** Add an edge, mirroring it when the relation is symmetric. `supersedes` and\n *  `conflictsWith` mirror; `dependsOn` does not. */\nfunction addEdge(draft: Draft, from: DecisionId, to: DecisionId, key: EdgeKey): void {\n  if (from === to) return;\n  const source = draft.decisions.get(from);\n  const target = draft.decisions.get(to);\n  if (!source || !target) return;\n\n  const uniq = (ids: readonly DecisionId[], value: DecisionId): DecisionId[] =>\n    ids.includes(value) ? [...ids] : [...ids, value];\n\n  draft.decisions.set(from, {\n    ...source,\n    edges: { ...source.edges, [key]: uniq(source.edges[key], to) },\n  });\n\n  const back = MIRROR[key];\n  if (back === null) return;\n\n  const fresh = draft.decisions.get(to);\n  if (!fresh) return;\n  draft.decisions.set(to, {\n    ...fresh,\n    edges: { ...fresh.edges, [back]: uniq(fresh.edges[back], from) },\n  });\n}\n\nfunction removePending(draft: Draft, id: DecisionId): void {\n  const at = draft.pendingReview.indexOf(id);\n  if (at >= 0) draft.pendingReview.splice(at, 1);\n}\n\nfunction removePendingPremise(draft: Draft, id: PremiseId): void {\n  const at = draft.pendingPremises.indexOf(id);\n  if (at >= 0) draft.pendingPremises.splice(at, 1);\n}\n\nfunction withEvidence(premise: Premise, evidence: PremiseEvidence): readonly PremiseEvidence[] {\n  return [...premise.evidence, evidence];\n}\n\n/* -------------------------------------------------------------------------- */\n/* The dispatch                                                               */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one event to a draft, in place.\n *\n * Exhaustive over the closed 35-type vocabulary. The `never` assignment in the\n * default branch is what keeps it exhaustive: a 36th event type produces a\n * compile error HERE, the cheapest possible place to find out.\n */\nexport function applyEvent(draft: Draft, event: AnyEvent): Draft {\n  switch (event.type) {\n    /* ---------------- ingest ---------------- */\n\n    case \"TranscriptImported\": {\n      const p = event.payload;\n      const transcript: Transcript = {\n        id: p.transcriptId,\n        ...(p.label === undefined ? {} : { label: p.label }),\n        rawChars: p.rawChars,\n        importedAt: event.at,\n        ...(p.occurredAt === undefined ? {} : { occurredAt: p.occurredAt }),\n        episodeIds: [],\n      };\n      draft.transcripts.set(p.transcriptId, transcript);\n      draft.counters = { ...draft.counters, transcripts: draft.counters.transcripts + 1 };\n      return draft;\n    }\n\n    /* ---------------- extraction ---------------- */\n\n    case \"DecisionProposed\": {\n      const p = event.payload;\n      if (draft.decisions.has(p.decisionId)) {\n        skip(draft, event, `decision ${p.decisionId} already exists`);\n        return draft;\n      }\n\n      // An episode referenced but never separately announced is created here so\n      // provenance always resolves. A citation that cannot resolve is not a\n      // citation (docs/03 ┬º5).\n      if (!draft.episodes.has(p.episodeId)) {\n        // Prefer the real bounds from Phase 1.2 segmentation. Falling back to the\n        // decision's own snippet keeps hand-recorded decisions working, but a\n        // synthesised episode cannot show the negotiation that produced the\n        // decision, which is what the review UI needs for context.\n        const bounds = p.episode;\n        const episode: Episode = {\n          id: p.episodeId,\n          transcriptId: p.transcriptId,\n          ...(bounds?.variable === undefined\n            ? { variable: p.variable }\n            : { variable: bounds.variable }),\n          turnRange: bounds === undefined ? ([0, 0] as const) : bounds.turnRange,\n          charRange:\n            bounds === undefined ? ([p.snippet.start, p.snippet.end] as const) : bounds.charRange,\n        };\n        draft.episodes.set(p.episodeId, episode);\n        draft.counters = { ...draft.counters, episodes: draft.counters.episodes + 1 };\n        const transcript = draft.transcripts.get(p.transcriptId);\n        if (transcript) {\n          draft.transcripts.set(p.transcriptId, {\n            ...transcript,\n            episodeIds: [...transcript.episodeIds, p.episodeId],\n          });\n        }\n      }\n\n      // ONLY `asserted` modality can become an IN-labelled node. Everything else\n      // starts UNKNOWN and must be promoted by a human. This single line is what\n      // stops \"what if we used Redis?\" from becoming a decision and then\n      // contradicting the Redis decision made three sessions later.\n      const label: DecisionLabel = p.modality === \"asserted\" ? \"IN\" : \"UNKNOWN\";\n\n      const decision: Decision = {\n        id: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        statement: p.statement,\n        ...(p.rationale === undefined ? {} : { rationale: p.rationale }),\n        ...(p.yStatement === undefined ? {} : { yStatement: p.yStatement }),\n        ...(p.acceptedDownside === undefined ? {} : { acceptedDownside: p.acceptedDownside }),\n        label,\n        status: \"proposed\",\n        modality: p.modality,\n        justificationIds: [],\n        alternativeIds: [...p.alternativeIds],\n        guardIds: [],\n        edges: {\n          supersedes: [],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n        temporal: openWindow(event.occurredAt, event.at),\n        // Written properly by src/reasoning/entrenchment.ts in Phase 2. A stale\n        // 0 here is honest: the fold does not compute policy.\n        entrenchment: 0,\n        corroboration: 0,\n        appliesTo: p.appliesTo === undefined ? [] : [...p.appliesTo],\n        verifiability: \"pending\",\n      };\n\n      draft.decisions.set(p.decisionId, decision);\n      draft.pendingReview.push(p.decisionId);\n      for (const premiseId of p.premiseIds) {\n        if (!draft.pendingPremises.includes(premiseId)) draft.pendingPremises.push(premiseId);\n      }\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      return draft;\n    }\n\n    case \"PremiseAsserted\": {\n      const p = event.payload;\n      const existing = draft.premises.get(p.premiseId);\n\n      if (existing) {\n        // Re-assertion of an existing node appends evidence instead of creating a\n        // duplicate. Premises are SHARED nodes (invariant I2) and a second copy\n        // would silently halve the corroboration count on both.\n        draft.premises.set(p.premiseId, {\n          ...existing,\n          confidence: asConfidence(Math.max(existing.confidence, p.confidence)),\n          evidence: withEvidence(existing, {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        });\n        return draft;\n      }\n\n      const premise: Premise = {\n        id: p.premiseId,\n        type: p.type,\n        predicate: p.predicate,\n        ...(p.value === undefined ? {} : { value: p.value }),\n        text: p.text,\n        label: \"UNKNOWN\",\n        evidence: [\n          {\n            kind: \"transcript\",\n            supports: true,\n            span: p.snippet,\n            eventId: event.id,\n            at: event.occurredAt,\n          },\n        ],\n        temporal: openWindow(event.occurredAt, event.at),\n        corroboration: 0,\n        confidence: p.confidence,\n        resolvedFrom: [event.id],\n        justifications: [],\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n\n      draft.premises.set(p.premiseId, premise);\n      draft.counters = { ...draft.counters, premises: draft.counters.premises + 1 };\n      return draft;\n    }\n\n    case \"AlternativeRejected\": {\n      const p = event.payload;\n      const alternative: RejectedAlternative = {\n        id: p.alternativeId,\n        decisionId: p.decisionId,\n        variable: p.variable,\n        value: p.value,\n        ...(p.whyRejected === undefined ? {} : { whyRejected: p.whyRejected }),\n        snippet: p.snippet,\n        confidence: p.confidence,\n        // Alternatives need explicit confirmation before entering the\n        // pre-emption index: a false pre-emption is worse than none, and ARGUS\n        // measured 15.4% precision on exactly this component.\n        confirmedByHuman: false,\n        provenance: {\n          transcriptId: p.transcriptId,\n          episodeId: p.episodeId,\n          snippet: p.snippet,\n          origin: p.origin,\n          extractedBy: p.engine,\n          confidence: p.confidence,\n        },\n      };\n      draft.alternatives.set(p.alternativeId, alternative);\n\n      patchDecision(draft, p.decisionId, (d) =>\n        d.alternativeIds.includes(p.alternativeId)\n          ? d\n          : { ...d, alternativeIds: [...d.alternativeIds, p.alternativeId] },\n      );\n      return draft;\n    }\n\n    case \"ExtractionDiscarded\":\n      // Lives in the log as the precision metric's denominator; projects to\n      // nothing. A discarded candidate must not appear anywhere in the graph.\n      return draft;\n\n    /* ---------------- review ---------------- */\n\n    case \"DecisionApproved\": {\n      const p = event.payload;\n      const promoted = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"active\",\n        // Bulk approval is a weaker signal than individual review, so it opens\n        // the node for use without asserting its label.\n        label: d.label === \"UNKNOWN\" && !p.viaBulkApprove ? \"IN\" : d.label,\n      }));\n      if (!promoted) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"DecisionEdited\": {\n      const p = event.payload;\n      const applied = patchDecision(draft, p.decisionId, (d) => applyEdit(d, p.fields));\n      if (!applied) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The ORIGINAL extraction stays on the DecisionProposed event, so an edit\n      // never destroys provenance. That is why this patches and never replaces.\n      return draft;\n    }\n\n    case \"DecisionRejected\": {\n      const p = event.payload;\n      const rejected = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        status: \"archived\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!rejected) skip(draft, event, `unknown decision ${p.decisionId}`);\n      removePending(draft, p.decisionId);\n      return draft;\n    }\n\n    case \"PremiseConfirmed\": {\n      const p = event.payload;\n      const confirmed = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"IN\",\n        evidence: withEvidence(premise, {\n          kind: \"human\",\n          supports: true,\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!confirmed) skip(draft, event, `unknown premise ${p.premiseId}`);\n      removePendingPremise(draft, p.premiseId);\n      return draft;\n    }\n\n    case \"PremiseCorrected\": {\n      const p = event.payload;\n      const corrected = patchPremise(draft, p.premiseId, (premise) =>\n        applyPremiseEdit(premise, p.fields),\n      );\n      if (!corrected) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    /* ---------------- reasoning ---------------- */\n\n    case \"JustificationAttached\": {\n      const p = event.payload;\n      // The informant's eventId is REWRITTEN to the event that created the\n      // justification. A batch producer cannot know its own event ids ΓÇö they are\n      // minted inside `appendBatch` ΓÇö so it supplies a placeholder, and the fold is\n      // the only place that knows the truth. Deriving it here rather than trusting\n      // the payload is what makes the provenance correct instead of merely present.\n      const justification: Justification = {\n        ...p.justification,\n        informant:\n          p.justification.informant.kind === \"extraction\"\n            ? { ...p.justification.informant, eventId: event.id }\n            : p.justification.informant,\n      };\n      draft.justifications.set(p.justificationId, justification);\n      draft.counters = {\n        ...draft.counters,\n        justifications: draft.counters.justifications + 1,\n      };\n      patchDecision(draft, p.consequent, (d) =>\n        d.justificationIds.includes(p.justificationId)\n          ? d\n          : { ...d, justificationIds: [...d.justificationIds, p.justificationId] },\n      );\n      // A premise becomes load-bearing when it acquires a consequent, so it\n      // leaves the pending queue here rather than at approval.\n      for (const id of [...justification.inList, ...justification.outList]) {\n        removePendingPremise(draft, id);\n      }\n      return draft;\n    }\n\n    case \"LabelChanged\": {\n      const p = event.payload;\n      const asDecision = draft.decisions.get(p.nodeId as DecisionId);\n      if (asDecision) {\n        draft.decisions.set(asDecision.id, { ...asDecision, label: p.to });\n\n        /* Guards INHERIT their decision's label (Phase 4.7). A decision that stops being IN\n         * must stop having its guards run, and one that returns to IN must have them run again\n         * ΓÇö without anyone remembering to touch the guards.\n         *\n         * Maintaining `disabledByDecisionLabel` here rather than deriving it at read time keeps\n         * the stored field honest: the export in `guards/ci-export.ts` reads the guard record,\n         * and a CI runner enforcing a withdrawn decision would block work the log has already\n         * approved. The interpreter ALSO checks the live label, so a stale field cannot make a\n         * disabled guard run ΓÇö but it could make an exported one wrong, which is why both exist.\n         */\n        const disabled = p.to !== \"IN\";\n        for (const guardId of asDecision.guardIds) {\n          const guard = draft.guards.get(guardId);\n          if (guard === undefined) continue;\n          if (guard.disabledByDecisionLabel === disabled) continue;\n          draft.guards.set(guardId, { ...guard, disabledByDecisionLabel: disabled });\n        }\n\n        return draft;\n      }\n      const asPremise = draft.premises.get(p.nodeId as PremiseId);\n      if (asPremise) {\n        draft.premises.set(asPremise.id, { ...asPremise, label: p.to });\n        return draft;\n      }\n      skip(draft, event, `unknown node ${p.nodeId}`);\n      return draft;\n    }\n\n    case \"ContradictionDetected\": {\n      const p = event.payload;\n      const record: ContradictionRecord = {\n        id: event.id,\n        gate: p.gate,\n        verdict: p.verdict,\n        decisionA: p.decisionA,\n        ...(p.decisionB === undefined ? {} : { decisionB: p.decisionB }),\n        ...(p.premiseId === undefined ? {} : { premiseId: p.premiseId }),\n        explanation: p.explanation,\n        ...(p.diagnostic === undefined ? {} : { diagnostic: p.diagnostic }),\n        engine: p.engine,\n        detectedAt: event.at,\n        validAt: event.occurredAt,\n      };\n      draft.contradictions.push(record);\n\n      // `conflictsWith` is symmetric and is explicitly NEVER a cascade path: two\n      // decisions may conflict without either supporting the other.\n      if (p.decisionB !== undefined) addEdge(draft, p.decisionA, p.decisionB, \"conflictsWith\");\n      return draft;\n    }\n\n    case \"PremiseInvalidated\": {\n      const p = event.payload;\n      const kind: PremiseEvidence[\"kind\"] =\n        p.invalidatedBy.kind === \"guard\"\n          ? \"guard\"\n          : p.invalidatedBy.kind === \"human\"\n            ? \"human\"\n            : \"transcript\";\n\n      const invalidated = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"OUT\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n        evidence: withEvidence(premise, {\n          kind,\n          // An assertion or a human invalidates; a guard failure is evidence\n          // AGAINST the premise, so `supports` is false only in that case.\n          supports: kind !== \"guard\",\n          ...(p.evidenceSpan === undefined ? {} : { span: p.evidenceSpan }),\n          ...(p.evidenceQuote === undefined ? {} : { quote: p.evidenceQuote }),\n          eventId: event.id,\n          at: event.occurredAt,\n        }),\n      }));\n      if (!invalidated) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"NogoodRecorded\": {\n      const p = event.payload;\n      const conjunction = p.premiseIds\n        .map((id) => draft.premises.get(id)?.text ?? String(id))\n        .join(\" AND \");\n      const nogood: Nogood = {\n        id: p.nogoodId,\n        premiseIds: p.premiseIds,\n        derivedFrom: p.derivedFrom,\n        recordedAt: event.at,\n        // The event's reason is the human-facing explanation; the conjunction is\n        // appended so the sentence stands alone wherever it is rendered.\n        explanation: `${event.reason} (${conjunction})`,\n      };\n      draft.nogoods.set(p.nogoodId, nogood);\n      draft.counters = { ...draft.counters, nogoods: draft.counters.nogoods + 1 };\n      return draft;\n    }\n\n    case \"CascadePropagated\":\n      // The labels themselves arrive as LabelChanged events. This event exists so\n      // the cascade PATH ΓÇö including where it stopped and why ΓÇö stays\n      // reconstructable, which is the difference between \"these four decisions\n      // changed\" and \"these four changed because this premise died, and these two\n      // survived because they had independent support\".\n      return draft;\n\n    /* ---------------- revision ---------------- */\n\n    case \"RevisionProposed\": {\n      const p = event.payload;\n      const failedPremise = draft.premises.get(p.failedPremiseId);\n      const cascade: CascadeResult = {\n        steps: p.cascade.map((step, i) => ({\n          from: p.failedPremiseId,\n          to: step.decisionId,\n          depth: i + 1,\n          became: step.became,\n          stoppedAtIndependentSupport: p.survivors.includes(step.decisionId),\n          reason: event.reason,\n        })),\n        flipped: p.cascade.map((step) => step.decisionId),\n        survivors: p.survivors,\n        truncated: false,\n        potentiallyAffectedBeyondCap: 0,\n      };\n\n      const stored = p.nogoodId === undefined ? undefined : draft.nogoods.get(p.nogoodId);\n      const nogood: NogoodRecord | undefined =\n        p.nogoodId === undefined\n          ? undefined\n          : {\n              id: p.nogoodId,\n              premiseIds: stored?.premiseIds ?? [],\n              explanation: stored?.explanation ?? \"\",\n              derivedFrom: stored?.derivedFrom ?? event.id,\n            };\n\n      const proposal: RevisionProposal = {\n        id: p.proposalId,\n        createdAt: event.id,\n        unsoundDecisionId: p.unsoundDecisionId,\n        failedPremiseId: p.failedPremiseId,\n        failedPremiseText: failedPremise?.text ?? String(p.failedPremiseId),\n        evidence: {\n          /* The evidence the reasoning cycle saw, carried by the event. It used\n           * to be rebuilt here from `event.reason` ΓÇö and the reason is the\n           * \"why not auto-applied\" note, so every stored proposal quoted the\n           * boilerplate and claimed it came from a transcript. */\n          quote: p.evidence.quote,\n          source: p.evidence.source,\n          confidence: asConfidence(p.evidence.confidence),\n        },\n        ...(nogood === undefined ? {} : { nogood }),\n        cascade,\n        entrenchment: p.entrenchment,\n        entrenchmentBand: entrenchmentBand(p.entrenchment.total),\n        availableActions: p.availableActions,\n        // Invariant I4, on the record rather than only in the docs: the proposal\n        // exists BECAUSE the system is not allowed to apply it.\n        whyNotAutoApplied: p.rejectedNewcomer\n          ? `Newcomer screened out: ${p.rejectedNewcomer.why}`\n          : \"Extracted prose may not silently rewrite a considered decision. A human picks the action.\",\n        status: \"open\",\n      };\n\n      draft.proposals.set(p.proposalId, proposal);\n      draft.counters = { ...draft.counters, proposals: draft.counters.proposals + 1 };\n      return draft;\n    }\n\n    case \"DecisionReversed\": {\n      const p = event.payload;\n      const old = draft.decisions.get(p.decisionId);\n      if (!old) {\n        skip(draft, event, `unknown decision ${p.decisionId}`);\n        return draft;\n      }\n\n      // Reversal mints a NEW node and closes the old one. Nothing is deleted\n      // (I1), and the pair stays linked so the export compiler can drop the\n      // superseded rule instead of shipping both ΓÇö shipping both is exactly the\n      // \"the model may pick one arbitrarily\" failure.\n      draft.counters = { ...draft.counters, decisions: draft.counters.decisions + 1 };\n      const newId = mintDecisionId(draft.counters.decisions);\n\n      const replacement: Decision = {\n        ...old,\n        id: newId,\n        value: p.newValue,\n        statement: `${old.variable}: ${p.newValue} (reverses ${old.id})`,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: [],\n        alternativeIds: [],\n        guardIds: [],\n        edges: {\n          supersedes: [old.id],\n          supersededBy: [],\n          conflictsWith: [],\n          dependsOn: [],\n          sharesPremiseWith: [],\n          related: [],\n        },\n        provenance: { ...old.provenance, origin: \"human_override\" },\n        temporal: reopenWindow(event.occurredAt, event.at),\n        entrenchment: 0,\n        corroboration: 0,\n        verifiability: \"pending\",\n      };\n      draft.decisions.set(newId, replacement);\n\n      draft.decisions.set(old.id, {\n        ...old,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(old.temporal, event.occurredAt, event.id, event.reason),\n      });\n      addEdge(draft, old.id, newId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"DecisionRejustified\": {\n      const p = event.payload;\n      const rejustified = patchDecision(draft, p.decisionId, (d) => ({\n        ...d,\n        label: \"IN\",\n        status: \"active\",\n        justificationIds: d.justificationIds.includes(p.newJustificationId)\n          ? d.justificationIds\n          : [...d.justificationIds, p.newJustificationId],\n      }));\n      if (!rejustified) skip(draft, event, `unknown decision ${p.decisionId}`);\n      // The most common real outcome of a cascade, and the one no prior system\n      // offers: the decision survives on a NEW premise rather than dying.\n      removePendingPremise(draft, p.newPremiseId);\n      return draft;\n    }\n\n    case \"PremiseContested\": {\n      const p = event.payload;\n      const contested = patchPremise(draft, p.premiseId, (premise) => ({\n        ...premise,\n        label: \"UNKNOWN\",\n        temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!contested) skip(draft, event, `unknown premise ${p.premiseId}`);\n      return draft;\n    }\n\n    case \"DecisionSuperseded\": {\n      const p = event.payload;\n      const closed = patchDecision(draft, p.oldDecisionId, (d) => ({\n        ...d,\n        status: \"superseded\",\n        label: \"OUT\",\n        temporal: closeWindow(d.temporal, event.occurredAt, event.id, event.reason),\n      }));\n      if (!closed) skip(draft, event, `unknown decision ${p.oldDecisionId}`);\n      addEdge(draft, p.oldDecisionId, p.newDecisionId, \"supersededBy\");\n      return draft;\n    }\n\n    case \"HumanOverride\": {\n      const p = event.payload;\n      const count = draft.overrides.get(p.overriddenDecisionId) ?? 0;\n      draft.overrides.set(p.overriddenDecisionId, count + 1);\n\n      // Raising origin to human_override moves source_authority from 0.4 to 0.9,\n      // which is how a screened-out newcomer eventually wins the next\n      // adjudication instead of sitting in the contested queue forever.\n      patchDecision(draft, p.overriddenDecisionId, (d) => ({\n        ...d,\n        provenance: { ...d.provenance, origin: \"human_override\" },\n        status: d.status === \"contested\" ? \"active\" : d.status,\n      }));\n\n      const proposal = draft.proposals.get(p.proposalId);\n      if (proposal) {\n        draft.proposals.set(p.proposalId, {\n          ...proposal,\n          status: \"resolved\",\n          resolvedBy: event.id,\n        });\n      }\n      return draft;\n    }\n\n    /* ---------------- verification ---------------- */\n\n    case \"GuardSynthesised\": {\n      const p = event.payload;\n      const guard: Guard = {\n        id: p.guardId,\n        decisionId: p.decisionId,\n        spec: p.spec,\n        rationale: p.rationale,\n        severity: p.severity,\n        generatedBy: p.generatedBy,\n        engine: draft.engine,\n        // A `proposed` guard NEVER RUNS. An unaccepted check that fails is noise\n        // the user has not agreed to hear.\n        lifecycle: \"proposed\",\n        disabledByDecisionLabel: false,\n        createdAt: event.at,\n        createdByEvent: event.id,\n      };\n      draft.guards.set(p.guardId, guard);\n      draft.guardIndex.set(p.guardId, p.decisionId);\n      patchDecision(draft, p.decisionId, (d) =>\n        d.guardIds.includes(p.guardId) ? d : { ...d, guardIds: [...d.guardIds, p.guardId] },\n      );\n      return draft;\n    }\n\n    case \"GuardAccepted\": {\n      const p = event.payload;\n      const accepted = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"accepted\" }));\n      if (!accepted) skip(draft, event, `unknown guard ${p.guardId}`);\n      const guard = draft.guards.get(p.guardId);\n      if (guard)\n        patchDecision(draft, guard.decisionId, (d) => ({ ...d, verifiability: \"verified\" }));\n      return draft;\n    }\n\n    case \"GuardRan\": {\n      const p = event.payload;\n      const ran = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lastRun: runResult(p.guardId, p.result, p.evidence, p.ranAt),\n      }));\n      if (!ran) skip(draft, event, `unknown guard ${p.guardId}`);\n      // A passing re-run clears Drift Age: the decision is being honoured again.\n      if (p.result === \"pass\") {\n        // The key is removed, not set to undefined: \"never failed\" is the absence\n        // of the field, and `firstFailedAt: undefined` is not the same thing.\n        patchGuard(draft, p.guardId, (g) => {\n          const { firstFailedAt: _cleared, ...rest } = g;\n          return rest;\n        });\n      }\n      return draft;\n    }\n\n    case \"GuardFailed\": {\n      const p = event.payload;\n      const failed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        // Drift Age starts at the FIRST failure and is not reset by later failing\n        // runs. How long a decision has been knowingly violated is the number\n        // worth showing.\n        firstFailedAt: g.firstFailedAt ?? p.firstFailedAt,\n        lastRun: runResult(p.guardId, \"fail\", p.evidence, p.ranAt),\n      }));\n      if (!failed) skip(draft, event, `unknown guard ${p.guardId}`);\n\n      // A failure that falsifies a WORLD-OBSERVABLE premise is gate (c): nothing\n      // contradicts the user, the world simply moved.\n      if (p.falsifiesPremiseId !== undefined) {\n        patchPremise(draft, p.falsifiesPremiseId, (premise) => ({\n          ...premise,\n          label: \"OUT\",\n          temporal: closeWindow(premise.temporal, event.occurredAt, event.id, event.reason),\n          evidence: withEvidence(premise, {\n            kind: \"guard\",\n            supports: false,\n            // The line of the manifest that falsified it. There is no span to\n            // point at - a manifest is not a transcript - but the line IS the\n            // evidence, and the revision proposal has to quote it.\n            quote: p.evidence,\n            eventId: event.id,\n            at: event.occurredAt,\n          }),\n        }));\n      }\n      return draft;\n    }\n\n    case \"GuardSuppressed\": {\n      const p = event.payload;\n      const suppressed = patchGuard(draft, p.guardId, (g) => ({\n        ...g,\n        lifecycle: \"suppressed\",\n        suppressionReason: p.suppressionReason,\n      }));\n      if (!suppressed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    case \"GuardDeleted\": {\n      const p = event.payload;\n      // `deleted` is a lifecycle state, not a removal. The guard stays in the map\n      // so its run history ΓÇö and therefore the compliance trend ΓÇö survives.\n      const removed = patchGuard(draft, p.guardId, (g) => ({ ...g, lifecycle: \"deleted\" }));\n      if (!removed) skip(draft, event, `unknown guard ${p.guardId}`);\n      return draft;\n    }\n\n    /* ---------------- export ---------------- */\n\n    case \"ExportCompiled\": {\n      const p = event.payload;\n      const record: ExportRecordState = {\n        id: p.exportId,\n        stats: exportStats(p),\n        compiledAt: event.at,\n        mismatches: [],\n      };\n      draft.exports.set(p.exportId, record);\n      draft.counters = { ...draft.counters, exports: draft.counters.exports + 1 };\n      return draft;\n    }\n\n    case \"ExportStamped\": {\n      const p = event.payload;\n      const existing = draft.exports.get(p.exportId);\n      if (!existing) {\n        skip(draft, event, `unknown export ${p.exportId}`);\n        return draft;\n      }\n      draft.exports.set(p.exportId, { ...existing, stamp: p.stamp });\n      return draft;\n    }\n\n    case \"ExportIntegrityMismatch\": {\n      const p = event.payload;\n      const latest = draft.exports.size === 0 ? undefined : [...draft.exports.values()].at(-1);\n      if (!latest) {\n        skip(draft, event, \"integrity mismatch with no export in the log\");\n        return draft;\n      }\n      draft.exports.set(latest.id, {\n        ...latest,\n        mismatches: [\n          ...latest.mismatches,\n          { path: p.path, expectedHead: p.expectedHead, foundHead: p.foundHead },\n        ],\n      });\n      return draft;\n    }\n\n    /* ---------------- system ---------------- */\n\n    case \"EngineSwitched\": {\n      const p = event.payload;\n      draft.engine = p.to;\n      // Cosine similarity across embedding spaces is meaningless. Switching\n      // engine DISABLES semantic retrieval until an explicit re-index, rather\n      // than quietly mixing two vector spaces and returning confident nonsense.\n      const wasBuilt = draft.index.builtBy !== undefined;\n      const _staleSince =\n        wasBuilt && draft.index.staleSince === undefined ? event.at : draft.index.staleSince;\n      draft.index = {\n        ...draft.index,\n        stale: wasBuilt || draft.index.stale,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexRebuilt\": {\n      const p = event.payload;\n      draft.index = {\n        levels: p.levels,\n        decisionsIndexed: p.decisionsIndexed,\n        builtBy: p.engine,\n        builtAt: event.at,\n        stale: false,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"IndexStale\": {\n      const p = event.payload;\n      draft.index = {\n        ...draft.index,\n        stale: true,\n        staleSince: event.at,\n        builtBy: p.staleEngine,\n        lastEventId: event.id,\n      };\n      return draft;\n    }\n\n    case \"LogImported\":\n      // The merge/create counts exist for the double-import test (sub-phase 0.4:\n      // importing the same file twice must create ZERO new nodes). Projects to\n      // nothing else.\n      return draft;\n\n    case \"SchemaMigrated\": {\n      draft.schemaVersion = event.payload.toVersion;\n      return draft;\n    }\n\n    default: {\n      // Exhaustiveness: add a 36th type to EventType and this line fails to\n      // compile, naming the missing case.\n      const unhandled: never = event;\n      skip(draft, unhandled as AnyEvent, \"unhandled event type\");\n      return draft;\n    }\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Editing                                                                    */\n/* -------------------------------------------------------------------------- */\n\ntype EditableFields = Readonly<Record<string, string | number | boolean | null>>;\n\n/**\n * Apply a `DecisionEdited` payload.\n *\n * Unknown keys are IGNORED rather than written: an edit event from a future\n * schema must not be able to inject arbitrary fields into a Decision, and a\n * typo'd key silently vanishing is far cheaper than a corrupted node.\n */\nfunction applyEdit(decision: Decision, fields: EditableFields): Decision {\n  let next = decision;\n\n  const statement = fields[\"statement\"];\n  if (typeof statement === \"string\") next = { ...next, statement };\n\n  const rationale = fields[\"rationale\"];\n  if (typeof rationale === \"string\") next = { ...next, rationale };\n  else if (rationale === null) {\n    // The key is removed, not set to undefined. \"No rationale\" is the absence of\n    // the field; leaving `rationale: undefined` behind would make the node\n    // carry a field whose value is explicitly nothing.\n    const { rationale: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const downside = fields[\"acceptedDownside\"];\n  if (typeof downside === \"string\") next = { ...next, acceptedDownside: downside };\n  else if (downside === null) {\n    const { acceptedDownside: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const yStatement = fields[\"yStatement\"];\n  if (typeof yStatement === \"string\") next = { ...next, yStatement };\n  else if (yStatement === null) {\n    const { yStatement: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\") next = { ...next, value };\n\n  const variable = fields[\"variable\"];\n  if (typeof variable === \"string\") next = { ...next, variable: variable as DecisionVariable };\n\n  const appliesTo = fields[\"appliesTo\"];\n  if (typeof appliesTo === \"string\") {\n    next = {\n      ...next,\n      appliesTo: appliesTo\n        .split(\",\")\n        .map((s) => s.trim())\n        .filter((s) => s.length > 0),\n    };\n  }\n\n  return next;\n}\n\nfunction applyPremiseEdit(premise: Premise, fields: EditableFields): Premise {\n  let next = premise;\n\n  const text = fields[\"text\"];\n  if (typeof text === \"string\") next = { ...next, text };\n\n  const predicate = fields[\"predicate\"];\n  if (typeof predicate === \"string\") next = { ...next, predicate };\n\n  const type = fields[\"type\"];\n  if (typeof type === \"string\") next = { ...next, type: type as Premise[\"type\"] };\n\n  const value = fields[\"value\"];\n  if (typeof value === \"string\" || typeof value === \"number\" || typeof value === \"boolean\") {\n    next = { ...next, value };\n  } else if (value === null) {\n    const { value: _cleared, ...rest } = next;\n    next = rest;\n  }\n\n  return next;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Small constructors used by the dispatch                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction runResult(\n  guardId: GuardId,\n  outcome: \"pass\" | \"fail\" | \"skip\",\n  evidence: string,\n  ranAt: ISODateString,\n): GuardRunResult {\n  return {\n    guardId,\n    outcome,\n    evidence,\n    ranAt,\n    // The fold does not measure; the runner does. A replay reconstructs the\n    // result, not the timing.\n    durationMs: 0,\n  };\n}\n\nfunction exportStats(p: {\n  decisionsIncluded: number;\n  decisionsLinkedOut: number;\n  lineCount: number;\n}): ExportStats {\n  return {\n    decisionsIncluded: p.decisionsIncluded,\n    decisionsLinkedOut: p.decisionsLinkedOut,\n    // Recomputed from the graph in finalise(); the payload carries only what the\n    // compiler counted at generation time.\n    decisionsExcluded: 0,\n    lineCount: p.lineCount,\n    estimatedTokens: Math.ceil((p.lineCount * 48) / 4),\n    compliance: 0,\n    verifiableCoverage: 0,\n  };\n}\n\nfunction mintDecisionId(n: number): DecisionId {\n  return `WLD-${String(n).padStart(4, \"0\")}` as DecisionId;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Finalise: rebuild every DERIVED field                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Derived fields are rebuilt once per fold rather than maintained incrementally,\n * because each is a function of the WHOLE graph: `sharesPremiseWith` needs every\n * justification, corroboration needs every reference, the queues need every\n * status.\n *\n * Maintaining them across 35 event types instead is precisely where replay and\n * append would drift apart ΓÇö and that drift is invisible until a round-trip\n * produces a different head hash.\n */\nexport function finalise(draft: Draft): Draft {\n  rebuildDecisionIndexes(draft);\n  rebuildPremiseIndexes(draft);\n  rebuildSharedPremiseEdges(draft);\n  rebuildCorroboration(draft);\n  rebuildGuardInheritance(draft);\n  rebuildQueues(draft);\n  rebuildExportStats(draft);\n  rebuildMetrics(draft);\n  return draft;\n}\n\nfunction fingerprintOf(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${value.trim().toLowerCase()}`;\n}\n\nfunction rebuildDecisionIndexes(draft: Draft): void {\n  const byVariable = new Map<DecisionVariable, DecisionId[]>();\n  const byFingerprint = new Map<string, DecisionId>();\n\n  // Insertion order is learned-time order, so the EARLIEST node keeps the\n  // fingerprint. Identity resolution consults the ladder before it ever reaches\n  // this map (src/substrate/identity.ts); this is the dedup fast path only.\n  for (const decision of draft.decisions.values()) {\n    const bucket = byVariable.get(decision.variable);\n    if (bucket) bucket.push(decision.id);\n    else byVariable.set(decision.variable, [decision.id]);\n\n    const fp = fingerprintOf(decision.variable, decision.value);\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, decision.id);\n  }\n\n  draft.byVariable = byVariable;\n  draft.byFingerprint = byFingerprint;\n}\n\nfunction rebuildPremiseIndexes(draft: Draft): void {\n  const byFingerprint = new Map<string, PremiseId>();\n  for (const premise of draft.premises.values()) {\n    // Type is part of the fingerprint: merging across premise TYPES is forbidden\n    // regardless of text similarity. \"single user\" (scale) and \"single sign-on\n    // user flow\" (requirement) are never the same node, and a false merge there\n    // produces a spectacular wrong cascade.\n    const fp = `${premise.type}\\u0000${premise.predicate}`;\n    if (!byFingerprint.has(fp)) byFingerprint.set(fp, premise.id);\n  }\n  draft.premiseByFingerprint = byFingerprint;\n\n  const toDecisions = new Map<PremiseId, DecisionId[]>();\n  const link = (premiseId: PremiseId, decisionId: DecisionId): void => {\n    const bucket = toDecisions.get(premiseId);\n    if (bucket) {\n      if (!bucket.includes(decisionId)) bucket.push(decisionId);\n    } else {\n      toDecisions.set(premiseId, [decisionId]);\n    }\n  };\n\n  for (const justification of draft.justifications.values()) {\n    for (const id of justification.inList) link(id, justification.consequent);\n    // OUT-list membership is a dependency too: the justification is valid only\n    // while that premise stays OUT, so invalidating it must reach the decision.\n    for (const id of justification.outList) link(id, justification.consequent);\n  }\n\n  draft.premiseToDecisions = toDecisions;\n}\n\nfunction rebuildSharedPremiseEdges(draft: Draft): void {\n  const shared = new Map<DecisionId, Set<DecisionId>>();\n\n  for (const decisionIds of draft.premiseToDecisions.values()) {\n    if (decisionIds.length < 2) continue;\n    for (const a of decisionIds) {\n      let bucket = shared.get(a);\n      if (!bucket) {\n        bucket = new Set();\n        shared.set(a, bucket);\n      }\n      for (const b of decisionIds) {\n        if (a !== b) bucket.add(b);\n      }\n    }\n  }\n\n  for (const [id, peers] of shared) {\n    const decision = draft.decisions.get(id);\n    if (!decision) continue;\n    draft.decisions.set(id, {\n      ...decision,\n      edges: { ...decision.edges, sharesPremiseWith: [...peers].sort() },\n    });\n  }\n}\n\nfunction rebuildCorroboration(draft: Draft): void {\n  // premiseToDecisions was rebuilt immediately before this, so it is the\n  // authoritative reference count for both premises and decisions.\n  const premiseRefs = new Map<PremiseId, number>();\n  for (const [premiseId, decisionIds] of draft.premiseToDecisions) {\n    premiseRefs.set(premiseId, decisionIds.length);\n  }\n\n  for (const [id, premise] of draft.premises) {\n    const refs = premiseRefs.get(id) ?? 0;\n    // log2 scaling: the fourth independent justification is worth much less than\n    // the second. Matches docs/02 ┬º3.4's corroboration term.\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.premises.set(id, { ...premise, corroboration });\n  }\n\n  for (const [id, decision] of draft.decisions) {\n    const refs = decision.justificationIds.length;\n    const corroboration =\n      refs <= 1 ? (refs === 1 ? 0.5 : 0) : Math.min(1, 0.5 + Math.log2(refs) / 4);\n    draft.decisions.set(id, { ...decision, corroboration });\n  }\n}\n\n/**\n * Guards INHERIT their decision's label.\n *\n * A decision that is OUT or superseded has its guards auto-disabled, and\n * re-enabling requires the decision to return to IN. Without this, reversing a\n * decision leaves its old guard failing forever ΓÇö the fastest known way to get a\n * verification feature switched off.\n */\nfunction rebuildGuardInheritance(draft: Draft): void {\n  for (const [id, guard] of draft.guards) {\n    const decision = draft.decisions.get(guard.decisionId);\n    const disabled =\n      decision === undefined || decision.label === \"OUT\" || decision.status === \"superseded\";\n    if (guard.disabledByDecisionLabel !== disabled) {\n      draft.guards.set(id, { ...guard, disabledByDecisionLabel: disabled });\n    }\n  }\n}\n\nfunction rebuildQueues(draft: Draft): void {\n  // Derived from status rather than maintained as events arrive, so a replay and\n  // an incremental append cannot disagree about what is still awaiting review.\n  draft.pendingReview = [...draft.decisions.values()]\n    .filter((d) => d.status === \"proposed\")\n    .map((d) => d.id);\n\n  draft.pendingPremises = [...draft.premises.values()]\n    .filter((p) => p.label === \"UNKNOWN\" && p.temporal.invalidFrom === undefined)\n    .map((p) => p.id);\n}\n\nfunction rebuildExportStats(draft: Draft): void {\n  if (draft.exports.size === 0) return;\n\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.status !== \"superseded\");\n  const withGuard = live.filter((d) => d.guardIds.length > 0);\n  const verifiableCoverage = live.length === 0 ? 0 : withGuard.length / live.length;\n\n  for (const [id, record] of draft.exports) {\n    draft.exports.set(id, {\n      ...record,\n      stats: {\n        ...record.stats,\n        decisionsExcluded: Math.max(0, decisions.length - record.stats.decisionsIncluded),\n        verifiableCoverage,\n      },\n    });\n  }\n}\n\nfunction rebuildMetrics(draft: Draft): void {\n  const decisions = [...draft.decisions.values()];\n  const live = decisions.filter((d) => d.label === \"IN\" && d.temporal.invalidFrom === undefined);\n  const guards = [...draft.guards.values()];\n  const accepted = guards.filter((g) => g.lifecycle === \"accepted\");\n  const passing = accepted.filter((g) => g.lastRun?.outcome === \"pass\");\n  const failing = accepted.filter((g) => g.lastRun?.outcome === \"fail\");\n\n  const otherCount = draft.byVariable.get(\"OTHER\")?.length ?? 0;\n\n  const metrics: [string, number][] = [\n    [\"events\", draft.events.length],\n    [\"decisions\", decisions.length],\n    [\"decisionsLive\", live.length],\n    [\"decisionsOut\", decisions.filter((d) => d.label === \"OUT\").length],\n    [\"decisionsUnknown\", decisions.filter((d) => d.label === \"UNKNOWN\").length],\n    [\"decisionsUnfounded\", decisions.filter((d) => d.label === \"UNFOUNDED\").length],\n    [\"premises\", draft.premises.size],\n    [\n      \"premisesOpen\",\n      [...draft.premises.values()].filter((p) => p.temporal.invalidFrom === undefined).length,\n    ],\n    [\"justifications\", draft.justifications.size],\n    [\n      \"nonMonotonicJustifications\",\n      [...draft.justifications.values()].filter((j) => j.outList.length > 0).length,\n    ],\n    [\"nogoods\", draft.nogoods.size],\n    [\"transcripts\", draft.transcripts.size],\n    [\"episodes\", draft.episodes.size],\n    [\"alternatives\", draft.alternatives.size],\n    [\n      \"alternativesConfirmed\",\n      [...draft.alternatives.values()].filter((a) => a.confirmedByHuman).length,\n    ],\n    [\"guards\", guards.length],\n    [\"guardsAccepted\", accepted.length],\n    [\"guardsPassing\", passing.length],\n    [\"guardsFailing\", failing.length],\n    [\"contradictions\", draft.contradictions.length],\n    [\"proposalsOpen\", [...draft.proposals.values()].filter((p) => p.status === \"open\").length],\n    [\"overrides\", [...draft.overrides.values()].reduce((a, b) => a + b, 0)],\n    [\"pendingReview\", draft.pendingReview.length],\n    [\"pendingPremises\", draft.pendingPremises.length],\n    // The ontology health check (sub-phase 0.7). Above ~0.15 the 14 typed slots\n    // are not covering the corpus and Phase 1's numbers cannot be trusted.\n    [\"otherVariableRate\", decisions.length === 0 ? 0 : otherCount / decisions.length],\n    [\"compliance\", accepted.length === 0 ? 1 : passing.length / accepted.length],\n    [\n      \"verifiableCoverage\",\n      live.length === 0 ? 0 : live.filter((d) => d.guardIds.length > 0).length / live.length,\n    ],\n    [\"skippedEvents\", draft.skipped.length],\n  ];\n\n  draft.metrics = new Map(metrics);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Freeze                                                                     */\n/* -------------------------------------------------------------------------- */\n\n/** The only way out of a Draft. Exposes every collection as Readonly. */\nexport function freeze(draft: Draft): GraphState {\n  return {\n    events: draft.events,\n    headHash: draft.headHash,\n    lastEventId: draft.lastEventId,\n    schemaVersion: draft.schemaVersion,\n\n    decisions: draft.decisions,\n    premises: draft.premises,\n    justifications: draft.justifications,\n    nogoods: draft.nogoods,\n\n    transcripts: draft.transcripts,\n    episodes: draft.episodes,\n    alternatives: draft.alternatives,\n\n    guards: draft.guards,\n    proposals: draft.proposals,\n    contradictions: draft.contradictions,\n    exports: draft.exports,\n\n    byVariable: draft.byVariable,\n    byFingerprint: draft.byFingerprint,\n    premiseByFingerprint: draft.premiseByFingerprint,\n    premiseToDecisions: draft.premiseToDecisions,\n    guardIndex: draft.guardIndex,\n\n    pendingReview: draft.pendingReview,\n    pendingPremises: draft.pendingPremises,\n    overrides: draft.overrides,\n\n    engine: draft.engine,\n    index: draft.index,\n    counters: draft.counters,\n\n    metrics: draft.metrics,\n    computedAt: draft.computedAt,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Public entry points                                                        */\n/* -------------------------------------------------------------------------- */\n\nexport interface FoldOptions {\n  readonly engine: EngineId;\n  /** Stamps `computedAt`. Supplied by the caller so the fold stays pure. */\n  readonly now: ISODateString;\n  /** Skip finalise(). Only for benchmarks that measure raw dispatch cost. */\n  readonly raw?: boolean;\n}\n\n/**\n * Fold an event log into a state.\n *\n * The hash chain is advanced here as well, so `state.headHash` always agrees\n * with `verifyChain(state.events).headHash`. Computing it in two places is how\n * the two would eventually disagree.\n */\nexport function fold(events: readonly AnyEvent[], options: FoldOptions): GraphState {\n  const draft = emptyDraft(options.engine, options.now);\n\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    if (event.schemaVersion !== undefined) {\n      draft.schemaVersion = Math.max(draft.schemaVersion, event.schemaVersion);\n    }\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n\n  return freeze(options.raw === true ? draft : finalise(draft));\n}\n\n/** Fold nothing: the state the app renders on first boot (sub-phase 0.10). */\nexport function emptyFold(options: FoldOptions): GraphState {\n  return freeze(finalise(emptyDraft(options.engine, options.now)));\n}\n\n/**\n * Materialise the graph AS OF a point in time.\n *\n * Replay stops after the last event whose LEARNED time is at or before `asOf`.\n * That is the audit-trail question ΓÇö \"what did WhyLog believe then?\" ΓÇö and it is\n * answerable only because learned time is on every event.\n *\n * Passing a VALID-time instant instead is a different question (\"what was true\n * then?\") and is answered by filtering the full state with\n * src/substrate/bi-temporal.ts `matchesAsOf`, not by truncating the replay:\n * truncating on valid time would drop events the system genuinely knew about.\n */\nexport function materializeAsOf(\n  events: readonly AnyEvent[],\n  asOfLearned: ISODateString,\n  options: FoldOptions,\n): GraphState {\n  const visible = events.filter((e) => e.at <= asOfLearned);\n  return fold(visible, options);\n}\n\n/** Materialise up to and including a specific event id. */\nexport function materializeThrough(\n  events: readonly AnyEvent[],\n  throughEventId: EventId,\n  options: FoldOptions,\n): GraphState {\n  const cut = events.findIndex((e) => e.id === throughEventId);\n  return fold(cut < 0 ? events : events.slice(0, cut + 1), options);\n}\n\n/**\n * Apply one event to an existing state.\n *\n * Used by the live append path. Produces exactly what a full replay would,\n * because it runs the same `applyEvent` and the same `finalise`.\n */\nexport function applyToState(state: GraphState, event: AnyEvent): GraphState {\n  const draft = toDraft(state);\n  draft.events.push(event);\n  draft.headHash = linkHash(draft.headHash, event);\n  draft.lastEventId = event.id;\n  draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n  applyEvent(draft, event);\n  return freeze(finalise(draft));\n}\n\n/** Apply a batch. One finalise for the whole batch ΓÇö appending N events one at a\n *  time would rebuild every derived index N times. */\nexport function applyBatch(state: GraphState, events: readonly AnyEvent[]): GraphState {\n  if (events.length === 0) return state;\n  const draft = toDraft(state);\n  for (const event of events) {\n    draft.events.push(event);\n    draft.headHash = linkHash(draft.headHash, event);\n    draft.lastEventId = event.id;\n    draft.counters = { ...draft.counters, events: draft.counters.events + 1 };\n    applyEvent(draft, event);\n  }\n  return freeze(finalise(draft));\n}\n\n/**\n * Throw the cache away and rebuild it.\n *\n * Exposed as a first-class operation because the projections ARE disposable: if\n * a derived index is ever suspected of drift, rebuilding from the log is the\n * answer, and having a button for it is better than having a theory about it.\n */\nexport function rebuild(state: GraphState, options: FoldOptions): GraphState {\n  return fold(state.events, options);\n}\n"},"tags":[],"source":null}],"command":"check"}
