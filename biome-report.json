":[665,666]}}},{"diffOp":{"equal":{"range":[608,609]}}},{"diffOp":{"delete":{"range":[327,331]}}},{"diffOp":{"insert":{"range":[506,518]}}},{"diffOp":{"equal":{"range":[608,619]}}},{"diffOp":{"delete":{"range":[203,211]}}},{"diffOp":{"insert":{"range":[413,420]}}},{"diffOp":{"equal":{"range":[649,650]}}},{"diffOp":{"delete":{"range":[331,338]}}},{"diffOp":{"insert":{"range":[518,523]}}},{"diffOp":{"equal":{"range":[767,774]}}},{"equalLines":{"line_count":352}},{"diffOp":{"equal":{"range":[774,802]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\report.ts"},"span":null,"sourceCode":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *\n * Phase 7 ┬╖ sub-phase 7.7\n *\n * ---------------------------------------------------------------------------\n * THE REPORT SHOWS ITS WORKING\n *\n * Every headline number is followed by the per-plant and per-question breakdown that produced it, the\n * sample size, the comparator (or an explicit statement that none exists) and what the number does not\n * establish. A report of summary numbers alone would be indistinguishable from marketing, and G6 asks\n * that every claim be backed by a number or a diagram rather than an adjective ΓÇö which means the number\n * has to be traceable to the cases behind it.\n *\n * ---------------------------------------------------------------------------\n * IT IS GENERATED, NOT WRITTEN\n *\n * `docs/EVALUATION.md` quotes from this file; it does not restate it. Two copies of a number drift, and\n * a benchmark whose published figures disagree with its own output is worse than one with no published\n * figures. Regenerating the report is the only way to keep them identical.\n * ---------------------------------------------------------------------------\n */\n\nimport { nowISO } from \"@/lib/format\";\nimport { describeCorpus } from \"./corpus/labels\";\nimport { describeLoad } from \"./corpus/loader\";\nimport type { ResolvedCorpus } from \"./corpus/labels\";\nimport type { ScoredRun } from \"./metrics\";\nimport { metricsWithoutComparator, renderSuite, unusualMetrics } from \"./metrics\";\nimport type { MetricResult } from \"./metrics/types\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./ablation/run\";\nimport { harden, renderHardening, type HardeningReport } from \"./hardening\";\nimport { renderAblationTable, renderPredictionAudit } from \"./ablation/table\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { runConfig } from \"./harness\";\nimport { scoreAll } from \"./metrics\";\nimport { DEFAULT_PARAMS, FULL } from \"./ablation/toggles\";\n\n/**\n * The whole report as Markdown.\n *\n * `study` is optional: the baseline report is useful without fifteen ablation runs, and requiring the\n * study would mean the fastest possible verification path ΓÇö load the corpus, run it once, print the\n * numbers ΓÇö took fifteen times longer than it needs to.\n */\nexport function renderFullReport(\n  corpus: ResolvedCorpus,\n  scored: ScoredRun,\n  study: AblationStudy | null,\n  hardening: HardeningReport | null = null,\n): string {\n  const out: string[] = [];\n\n  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\");\n  out.push(\"\");\n  out.push(\"Corpus \" + corpus.version + \" ┬╖ engine \" + describeEngine(scored) + \" ┬╖ \" + corpus.transcripts.length + \" transcripts\");\n  out.push(\"\");\n\n  /* ---- the honest summary first ---- */\n  out.push(\"## Summary\");\n  out.push(\"\");\n  out.push(metricsSummary(scored));\n  out.push(\"\");\n\n  /* ---- the suite ---- */\n  out.push(\"## The thirteen metrics\");\n  out.push(\"\");\n  out.push(\"```\");\n  out.push(renderSuite(scored));\n  out.push(\"```\");\n  out.push(\"\");\n\n  out.push(\"### Each metric, with what it does not establish\");\n  out.push(\"\");\n  for (const metric of scored.metrics) out.push(...metricSection(metric));\n\n  /* ---- the two unusual ones, pulled forward ---- */\n  out.push(\"## The two metrics no competitor can produce\");\n  out.push(\"\");\n  out.push(\n    \"┬º7.2 calls these out specifically. Neither measures a capability the surveyed systems have at any\",\n    \"quality, because neither component exists in them: no surveyed system cascades a retraction, and no\",\n    \"surveyed extractor operates on a corpus where speculation outnumbers decisions.\",\n  );\n  out.push(\"\");\n  for (const metric of unusualMetrics(scored)) {\n    out.push(\"- **\" + metric.name + \"** ΓÇö \" + metric.gloss);\n    out.push(\"  \" + metric.honestNote);\n  }\n  out.push(\"\");\n\n  /* ---- detail ---- */\n  out.push(\"## Per-case detail\");\n  out.push(\"\");\n  out.push(...extractionDetail(scored));\n  out.push(...plantDetail(scored));\n  out.push(...questionDetail(scored));\n  out.push(...guardDetail(scored));\n\n  /* ---- ablation ---- */\n  if (study !== null) {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(describeStudy(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderAblationTable(study));\n    out.push(\"```\");\n    out.push(\"\");\n    out.push(\"### Prediction audit\");\n    out.push(\"\");\n    out.push(\"```\");\n    out.push(renderPredictionAudit(study));\n    out.push(\"```\");\n    out.push(\"\");\n  } else {\n    out.push(\"## Ablation study\");\n    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\");\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }\n\n  /* ---- hardening ---- */\n  out.push(\"## Hardening pass\");\n  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");\n    out.push(renderHardening(hardening));\n    out.push(\"```\");\n  }\n  out.push(\"\");\n\n  /* ---- new territory ---- */\n  out.push(\"## Metrics with no published comparator\");\n  out.push(\"\");\n  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length + \" of \" + scored.metrics.length +\n    \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );\n  out.push(\"\");\n  for (const metric of without) out.push(\"- \" + metric.name);\n  out.push(\"\");\n\n  return out.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Sections                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction describeEngine(scored: ScoredRun): string {\n  const first = scored.metrics[0]?.perEngine[0];\n  return first === undefined ? \"unknown\" : first.engine;\n}\n\nfunction metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" + scored.run.transcripts.length + \" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  ];\n\n  for (const metric of scored.metrics) {\n    const value = metric.id === \"false-positive-rate\"\n      ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n      : metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction metricSection(metric: MetricResult): string[] {\n  const out = [\"#### \" + metric.name, \"\"];\n  const detail = metric.detail;\n\n  out.push(\n    \"**\" + (metric.id === \"false-positive-rate\" ? metric.value.toFixed(1) + \" per 100 decisions\" : metric.value.toFixed(3)) +\n    \"** ┬╖ n=\" + metric.n +\n    (detail === null ? \"\" : \" ┬╖ P \" + detail.precision.toFixed(3) + \" / R \" + detail.recall.toFixed(3) +\n      \" / F1 \" + detail.f1.toFixed(3) + \" (TP \" + detail.truePositives + \", FP \" + detail.falsePositives + \", FN \" + detail.falseNegatives + \")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" + (metric.comparator === null\n    ? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n    : metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);\n  out.push(\"\");\n  return out;\n}\n\nfunction extractionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Extraction\", \"\"];\n\n  out.push(\"| transcript | TP | FP | FN |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");\n\n  if (scored.extraction.variableErrors.length > 0) {\n    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\n      scored.extraction.variableErrors.length + \"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.variable + \", extracted as \" + entry.node.variable);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" + scored.premise.predicateErrors.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled `\" + entry.label.predicate + \"`, extracted as `\" + entry.node.predicate + \"`\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" + scored.premise.typeErrors.length + \") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(\"- `\" + entry.label.key + \"` labelled \" + entry.label.type + \", extracted as \" + entry.node.type);\n    }\n    out.push(\"\");\n  }\n\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" + scored.modality.wronglyPromoted.length + \"):\");\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {\n      out.push(\"- `\" + entry.label.key + \"` (\" + entry.label.modality + \") ΓåÆ \" + entry.node.id);\n    }\n    out.push(\"\");\n  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;\n}\n\nfunction plantDetail(scored: ScoredRun): string[] {\n  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" + entry.plant + \" | \" + (entry.testable ? \"yes\" : \"NO\") + \" | \" + entry.expectedFlips.length + \" | \" +\n      entry.flipped.length + \" | \" + entry.missedFlips.length + \" | \" + entry.survived.length + \" | \" +\n      entry.overRetracted.length + \" | \" + (entry.correct ? \"Γ£ô\" : \"Γ£ù\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  if (scored.cascade.overRetractions > 0) {\n    out.push(\"**Over-retractions** ΓÇö each one is the demo-killer ┬º7.4 names first:\");\n    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted) out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\");\n    }\n    out.push(\"\");\n  }\n\n  if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" + scored.resolver.unresolvable.length + \"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\n    out.push(\"\");\n    for (const key of scored.resolver.unresolvable) out.push(\"- \" + key);\n    out.push(\"\");\n  }\n\n  out.push(\"Contradiction records by gate: \" +\n    scored.contradiction.byGate.structural + \" structural, \" +\n    scored.contradiction.byGate.semantic + \" semantic, \" +\n    scored.contradiction.byGate.premise + \" premise. Kantara diagnostics: \" +\n    scored.contradiction.m1Detections + \" M1, \" + scored.contradiction.m2Detections + \" M2.\");\n  out.push(\"\");\n  out.push(\"Justifications carrying a non-empty OUT-list: \" + scored.invalidation.outListPopulated +\n    \" of \" + scored.invalidation.decisionsTotal + \" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" + scored.falsePositives.examples.length + \":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\n    out.push(\"\");\n  }\n\n  return out;\n}\n\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\", \"\", \"| id | verdict | expected | groundedness | claims | searches | over budget |\", \"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.verdict + \" | \" + entry.expectedVerdict + \" | \" +\n      entry.groundedness.toFixed(2) + \" | \" + entry.groundedClaims + \"/\" + entry.claims + \" | \" +\n      entry.searches + \" | \" + (entry.overBudget ? \"YES\" : \"no\") + \" |\",\n    );\n  }\n  out.push(\"\");\n\n  out.push(\"| id | relevant expected | found in top 5 | first relevant rank |\");\n  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" + entry.question + \" | \" + entry.relevant.length + \" | \" + entry.relevantFound + \" | \" +\n      (entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) + \" |\",\n    );\n  }\n  out.push(\"\");\n  return out;\n}\n\nfunction guardDetail(scored: ScoredRun): string[] {\n  const out = [\"### Guards\", \"\"];\n  out.push(\n    \"Precision is NOT MEASURED ΓÇö a transcript corpus contains no repository state, so no violation could be\",\n    \"seeded. See `docs/LIMITATIONS.md`. What is measurable:\",\n  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" + scored.guards.decisionsWithGuard + \" of \" + scored.guards.decisionsTotal + \" decisions got a proposed guard\");\n  out.push(\"- determinism share: \" + scored.guards.deterministic + \" deterministic, \" + scored.guards.judged + \" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" + scored.guards.autoAccepted);\n  out.push(\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags);\n  out.push(\"\");\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* CLI                                                                        */\n/* -------------------------------------------------------------------------- */\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, load, engine, engineId } = prepare();\n\n  banner(\"Generating the evaluation report\");\n  line(describeCorpus(resolved));\n  blank();\n  line(describeLoad(load));\n\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, { id: \"full\", engine, engineId, toggles: FULL, params: DEFAULT_PARAMS });\n  line(\"imported in \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.state.decisions.size + \" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  let study: AblationStudy | null = null;\n  if (args.has(\"ablation\")) {\n    heading(\"Ablation study\");\n    study = await runAblation(resolved, { engine, engineId });\n    line(describeStudy(study));\n  }\n\n  const hardened = harden(resolved, scored);\n  const markdown = renderFullReport(resolved, scored, study, hardened);\n  write(args.get(\"out\") ?? \"docs/generated/EVAL-REPORT.md\", markdown);\n\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 23 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 23 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 23 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\guards\\eval\\string.ts"},"span":[1670,1680],"sourceCode":"/**\n * `string_in_files` / `string_absent_in_files` ΓÇö 4.3.\n *\n * Phase 4 ┬╖ sub-phase 4.3\n * Plan: plan/phase-4-executable-guards.md ┬º4.3\n * Docs: docs/04-executable-decision-guards.md ┬º8 (false-positive drift)\n *\n * ---------------------------------------------------------------------------\n * WORD-BOUNDARY MATCHING IS THE WHOLE MITIGATION\n *\n * A bare substring match on \"pg\" hits \"pgp\", \"pgsql-tools\", and any passing mention in a\n * comment. That is the documented failure mode of this kind, and it is why string guards\n * default to `warning` rather than `blocking`: a pattern is far easier to match by accident\n * than a dependency entry is.\n *\n * `compilePattern` from `lib/glob.ts` already implements the boundary, and defaults to it ON.\n * This file does not reimplement matching ΓÇö it decides WHICH files to search and turns the hit\n * into an evidence string.\n *\n * ---------------------------------------------------------------------------\n * SCOPED BY GLOB, ALWAYS\n *\n * Every string guard carries a glob, and the search is restricted to it. An unscoped\n * `string_absent_in_files: \"postgres\"` over a whole repository fails on the migration script\n * that moves data OUT of Postgres ΓÇö a file whose existence is evidence FOR the decision, being\n * reported as evidence against it.\n * ---------------------------------------------------------------------------\n */\n\nimport { filterByGlob, findMatchInText } from \"@/lib/glob\";\nimport type { StringSpec, VirtualProject } from \"@/types/guards\";\nimport { hasFileContents, hasFileListing } from \"../project\";\nimport { type Evaluation, SKIP_NO_CONTENTS, SKIP_NO_LISTING } from \"./types\";\n\nexport function evalString(spec: StringSpec, project: VirtualProject): Evaluation {\n  /* Both a listing AND contents are needed: the glob scopes the search over the listing, and\n   * the contents are what gets searched. Having one without the other means the guard cannot\n   * tell \"not present\" from \"not pasted\". */\n  if (!hasFileListing(project)) return SKIP_NO_LISTING;\n  if (!hasFileContents(project)) return SKIP_NO_CONTENTS;\n\n  const scoped = filterByGlob(project.filePaths, spec.glob);\n  if (scoped.length === 0) {\n    return {\n      outcome: \"skip\",\n      evidence: \"\",\n      skipReason: `No pasted file matches the scope glob \\`${spec.glob}\\`, so there was nothing to search. Widen the glob or paste a file it covers.`,\n    };\n  }\n\n  const withContents = scoped.filter((path) => project.fileContents[path] !== undefined);\n  if (withContents.length === 0) {\n    return {\n      outcome: \"skip\",\n      evidence: \"\",\n      skipReason: `${scoped.length} file(s) match the scope \\`${spec.glob}\\` but none of their contents were pasted, so there was nothing to search: ${scoped.slice(0, 4).join(\", \")}${scoped.length > 4 ? \", ΓÇª\" : \"\"}`,\n    };\n  }\n\n  const options = {\n    wordBoundary: spec.wordBoundary ?? true,\n    caseSensitive: spec.caseSensitive ?? false,\n  };\n\n  for (const path of withContents) {\n    const text = project.fileContents[path];\n    if (text === undefined) continue;\n\n    const hit = findMatchInText(text, spec.pattern, options);\n    if (hit === null) continue;\n\n    const quoted = hit.text.length > 160 ? `${hit.text.slice(0, 157)}...` : hit.text;\n    const where = `${path}:${hit.line}`;\n\n    if (spec.kind === \"string_absent_in_files\") {\n      return {\n        outcome: \"fail\",\n        evidence: `\"${spec.pattern}\" found at ${where} ΓÇö ${JSON.stringify(quoted)}${options.wordBoundary ? \"\" : \" (matched WITHOUT word boundaries, so this may be part of a longer identifier)\"}`,\n      };\n    }\n\n    /* string_in_files: a hit is a PASS. Return on the first one ΓÇö the guard asserts presence,\n     * not absence, so further hits add nothing to the evidence. */\n    return {\n      outcome: \"pass\",\n      evidence: `\"${spec.pattern}\" found at ${where} ΓÇö ${JSON.stringify(quoted)}`,\n    };\n  }\n\n  const searched = `${withContents.length} file(s) matching \\`${spec.glob}\\``;\n\n  if (spec.kind === \"string_in_files\") {\n    return {\n      outcome: \"fail\",\n      evidence: `\"${spec.pattern}\" does not appear in ${searched}.${\n        withContents.length < scoped.length\n          ? ` ${scoped.length - withContents.length} file(s) in scope had no pasted contents and were not searched.`\n          : \"\"\n      }`,\n    };\n  }\n\n  return {\n    outcome: \"pass\",\n    evidence: `\"${spec.pattern}\" does not appear in ${searched}.`,\n  };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 20 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 20 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 20 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\guards\\ci-export.ts"},"span":[4969,4977],"sourceCode":"/**\n * CI export ΓÇö 4.6.\n *\n * Phase 4 ┬╖ sub-phase 4.6\n * Plan: plan/phase-4-executable-guards.md ┬º4.6\n * Docs: docs/04-executable-decision-guards.md ┬º5.2\n *\n * ---------------------------------------------------------------------------\n * THE FAILURE MESSAGE IS THE PRODUCT\n *\n * Not \"guard G-0007b failed\". This:\n *\n *   Γ£ù WLD-0007 ΓÇö Use SQLite, not Postgres\n *     Guard G-0007b (dependency_absent: pg) FAILED\n *     Evidence: \"pg\": \"^8.11.3\" found in package.json dependencies\n *     Decided: 2026-10-03 ┬╖ Rests on: P-0002 single-user (IN), P-0005 no-deploy-infra (IN)\n *     Rejected alternative Postgres ΓÇö reason: \"deploy complexity\"\n *\n *     ΓåÆ Is this a deliberate reversal?   whylog reverse WLD-0007 --to postgres\n *     ΓåÆ Or is this drift?                remove the dependency.\n *\n * That message does the job of an ADR, a code-review comment and an onboarding document, at the\n * exact moment it is useful ΓÇö which is the moment someone has just installed the thing you\n * turned down six weeks ago and has no idea you turned it down.\n *\n * Everything it needs is embedded at export time: the decision, its premises with their labels\n * as they stood when the export was made, and the rejected alternatives with their reasons. A CI\n * job cannot query the log, so the log has to travel with the check.\n *\n * ---------------------------------------------------------------------------\n * SAME GUARD SET, SAME RESULTS\n *\n * ┬º4.6's acceptance criterion. The exported runner evaluates the SAME six predicates as the\n * in-browser interpreter, over the same data, and the guard set is serialised as DATA rather\n * than regenerated ΓÇö so the two cannot drift apart by having been written twice. The predicates\n * below are transcriptions of `eval/dependency.ts`, `eval/path.ts` and `eval/string.ts`,\n * including the word-boundary default and the dev-dependency asymmetry.\n *\n * What cannot be identical is the file discovery: the browser runs against a pasted virtual\n * project, CI against the real tree. That difference is the point of exporting, and it is why\n * the export carries the head hash ΓÇö so a result can be tied to the log state that produced it.\n *\n * ---------------------------------------------------------------------------\n * BLOCKING FAILS THE BUILD; WARNING DOES NOT\n *\n * `blocking` failures exit non-zero. `warning` failures are printed as advisory and do not\n * affect the exit code, because a string pattern is far easier to match by accident than a\n * dependency entry is, and a build that fails on an accidental match gets its guard deleted\n * rather than its code fixed.\n * ---------------------------------------------------------------------------\n */\n\nimport { RUNNER_PATH } from \"@/export/verify-command\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { Guard } from \"@/types/guards\";\nimport { isDeterministic } from \"@/types/guards\";\nimport { specTarget } from \"./feedback\";\n\n/* -------------------------------------------------------------------------- */\n/* What gets exported                                                         */\n/* -------------------------------------------------------------------------- */\n\n/** A guard plus everything the failure message needs, frozen at export time. */\nexport interface ExportedGuard {\n  readonly id: string;\n  readonly decisionId: string;\n  readonly statement: string;\n  readonly kind: Guard[\"spec\"][\"kind\"];\n  readonly target: string;\n  readonly severity: Guard[\"severity\"];\n  readonly rationale: string;\n  readonly spec: unknown;\n  readonly decidedAt: string;\n  readonly restsOn: readonly { id: string; text: string; label: string }[];\n  readonly rejected: readonly { value: string; whyRejected: string | null }[];\n  readonly appliesTo: readonly string[];\n}\n\nexport interface CiExport {\n  /** A standalone Node script. No dependencies beyond the standard library. */\n  readonly runner: string;\n  /** A GitHub Actions workflow running it on push and PR. */\n  readonly workflow: string;\n  readonly guards: readonly ExportedGuard[];\n  /** Decisions whose guards were all non-deterministic, so nothing could be exported for them.\n   *  Reported rather than silently omitted: an export that covers 8 of 12 decisions and does\n   *  not say so is an export that looks like coverage. */\n  readonly notExported: readonly { decisionId: DecisionId; reason: string }[];\n  readonly headHash: string;\n}\n\nexport interface CiExportInput {\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly headHash: string;\n  /** Export proposed guards too. Off by default: CI should run what a human accepted, and a\n   *  proposed guard failing a build is the day-one wall of red ┬º4.2 exists to prevent. */\n  readonly includeProposed?: boolean;\n}\n\nexport function exportCi(input: CiExportInput): CiExport {\n  const guards: ExportedGuard[] = [];\n  const notExported: { decisionId: DecisionId; reason: string }[] = [];\n  const seenDecisions = new Set<DecisionId>();\n\n  for (const guard of input.state.guards.values()) {\n    if (guard.lifecycle === \"deleted\" || guard.lifecycle === \"suppressed\") continue;\n    if (guard.lifecycle === \"proposed\" && input.includeProposed !== true) continue;\n\n    const decision = input.state.decisions.get(guard.decisionId);\n    if (decision === undefined) continue;\n\n    /* A superseded or archived decision's guards are not exported: the log has withdrawn the\n     * decision, and a CI job enforcing a withdrawn decision blocks work the log already\n     * approved. */\n    if (decision.status === \"superseded\" || decision.status === \"archived\") {\n      seenDecisions.add(decision.id);\n      notExported.push({\n        decisionId: decision.id,\n        reason: `the decision is ${decision.status}, so its guards are withdrawn with it`,\n      });\n      continue;\n    }\n\n    if (!isDeterministic(guard.spec.kind)) {\n      notExported.push({\n        decisionId: decision.id,\n        reason:\n          guard.spec.kind === \"command_exit_zero\"\n            ? `${guard.id} is a command guard ΓÇö exported separately below, since CI is exactly where a command can run`\n            : `${guard.id} is judged by a model, so it is advisory and cannot fail a build deterministically`,\n      });\n\n      /* Command guards CAN be exported: CI has a shell, which the browser does not. They are\n       * emitted into the runner's command section rather than the deterministic section. */\n      if (guard.spec.kind !== \"command_exit_zero\") continue;\n    }\n\n    seenDecisions.add(decision.id);\n    guards.push(exportedGuardOf(input.state, input.labels, guard, decision));\n  }\n\n  return {\n    runner: renderRunner(guards, input.headHash),\n    workflow: renderWorkflow(guards.length),\n    guards,\n    notExported,\n    headHash: input.headHash,\n  };\n}\n\nfunction exportedGuardOf(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  guard: Guard,\n  decision: Decision,\n): ExportedGuard {\n  const restsOn: { id: string; text: string; label: string }[] = [];\n  const seen = new Set<string>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n\n      restsOn.push({\n        id: premiseId,\n        text: premise.text,\n        /* The label as it stood AT EXPORT TIME. A CI job runs later, against a tree that may\n         * have moved; pretending the label is live would be a lie, and dating it is not. */\n        label: labels.get(premiseId)?.label ?? premise.label,\n      });\n    }\n  }\n\n  const rejected: { value: string; whyRejected: string | null }[] = [];\n  for (const alternativeId of decision.alternativeIds) {\n    const alternative = state.alternatives.get(alternativeId);\n    if (alternative === undefined) continue;\n    rejected.push({ value: alternative.value, whyRejected: alternative.whyRejected ?? null });\n  }\n\n  return {\n    id: guard.id,\n    decisionId: decision.id,\n    statement: decision.statement,\n    kind: guard.spec.kind,\n    target: specTarget(guard),\n    severity: guard.severity,\n    rationale: guard.rationale,\n    spec: guard.spec,\n    decidedAt: decision.temporal.valid.slice(0, 10),\n    restsOn,\n    rejected,\n    appliesTo: decision.appliesTo,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The runner                                                                 */\n/* -------------------------------------------------------------------------- */\n\n/**\n * A standalone Node script.\n *\n * Standard library only ΓÇö `fs` and `path`. No dependency to install, no build step, no\n * framework: it has to run in a CI job that has just checked out a repository and nothing else.\n */\nexport function renderRunner(guards: readonly ExportedGuard[], headHash: string): string {\n  const lines: string[] = [];\n\n  lines.push(\"#!/usr/bin/env node\");\n  lines.push(\"/**\");\n  lines.push(\" * WhyLog decision guards ΓÇö generated. Do not edit by hand.\");\n  lines.push(\" *\");\n  lines.push(` * Log head: ${headHash}`);\n  lines.push(` * Guards:   ${guards.length}`);\n  lines.push(\" *\");\n  lines.push(\" * Exits non-zero if any BLOCKING guard fails. Warning failures are printed\");\n  lines.push(\" * as advice and do not affect the exit code.\");\n  lines.push(\" *\");\n  lines.push(\" * Re-export from the app after any change to the log: the guard set below is\");\n  lines.push(\" * frozen at export time, and so are the premise labels in each failure message.\");\n  lines.push(\" */\");\n  lines.push(\"\");\n  lines.push('const fs = require(\"node:fs\");');\n  lines.push('const path = require(\"node:path\");');\n  lines.push(\"\");\n  lines.push(`const GUARDS = ${JSON.stringify(guards, null, 2)};`);\n  lines.push(\"\");\n  lines.push(RUNNER_BODY);\n\n  return lines.join(\"\\n\");\n}\n\n/**\n * The evaluator, transcribed.\n *\n * Kept as one block of emitted source rather than generated line by line, because it has to be\n * readable by whoever debugs a CI failure at 2am ΓÇö and generated-looking code is not.\n */\nconst RUNNER_BODY = `\n/* ---------------------------------------------------------------- project -- */\n\nfunction readManifest() {\n  try {\n    const raw = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\"));\n    return {\n      dependencies: raw.dependencies || {},\n      devDependencies: raw.devDependencies || {},\n    };\n  } catch {\n    return { dependencies: {}, devDependencies: {} };\n  }\n}\n\nfunction listFiles(dir, out) {\n  out = out || [];\n  let entries;\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    if (entry.name === \"node_modules\" || entry.name === \".git\") continue;\n    const full = path.join(dir, entry.name);\n    if (entry.isDirectory()) listFiles(full, out);\n    else out.push(full.split(path.sep).join(\"/\"));\n  }\n  return out;\n}\n\nfunction readFile(p) {\n  try {\n    return fs.readFileSync(p, \"utf8\");\n  } catch {\n    return undefined;\n  }\n}\n\n/* -------------------------------------------------------------------- glob -- */\n/* Transcribed from src/lib/glob.ts so results match the in-browser run.      */\n\nfunction globToRegExpSource(glob) {\n  let out = \"\";\n  for (let i = 0; i < glob.length; i += 1) {\n    const c = glob[i];\n    if (c === \"*\") {\n      if (glob[i + 1] === \"*\") {\n        if (glob[i + 2] === \"/\") { out += \"(?:.*/)?\"; i += 2; }\n        else { out += \".*\"; i += 1; }\n      } else out += \"[^/]*\";\n    } else if (c === \"?\") out += \"[^/]\";\n    else if (c === \".\") out += \"\\\\\\\\.\";\n    else if (\"+^$\\{}|()[]\".includes(c)) out += \"\\\\\\\\\" + c;\n    else out += c;\n  }\n  return out;\n}\n\nfunction matchesGlob(p, glob) {\n  return new RegExp(\"^\" + globToRegExpSource(glob) + \"$\").test(p);\n}\n\n/* Word boundaries ON by default: a bare substring match on \"pg\" hits \"pgp\",   */\n/* \"pgsql-tools\" and any passing mention in a comment.                        */\nfunction compilePattern(pattern, wordBoundary, caseSensitive) {\n  const escaped = pattern.replace(/[.*+?^\\${}()|[\\\\]\\\\\\\\]/g, \"\\\\\\\\$&\");\n  const source = wordBoundary === false ? escaped : \"\\\\\\\\b\" + escaped + \"\\\\\\\\b\";\n  return new RegExp(source, caseSensitive ? \"g\" : \"gi\");\n}\n\nfunction findMatchInText(text, pattern, wordBoundary, caseSensitive) {\n  const re = compilePattern(pattern, wordBoundary, caseSensitive);\n  const lines = text.split(\"\\\\n\");\n  for (let i = 0; i < lines.length; i += 1) {\n    re.lastIndex = 0;\n    if (re.test(lines[i])) return { line: i + 1, text: lines[i].trim() };\n  }\n  return null;\n}\n\n/* ---------------------------------------------------------------- evaluate -- */\n\nfunction evaluate(guard, project) {\n  const spec = guard.spec;\n\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\": {\n      /* Same asymmetry as the browser: an ABSENCE check covers devDependencies, because a\n       * rejected package installed for tooling is still installed. A PRESENCE check does not,\n       * because a build-only dependency does not mean the decision was implemented. */\n      const includeDev = spec.includeDev === undefined\n        ? spec.kind === \"dependency_absent\"\n        : spec.includeDev;\n\n      const inRuntime = project.dependencies[spec.package];\n      const inDev = includeDev ? project.devDependencies[spec.package] : undefined;\n      const version = inRuntime !== undefined ? inRuntime : inDev;\n      const where = inRuntime !== undefined ? \"dependencies\" : \"devDependencies\";\n\n      if (spec.kind === \"dependency_present\") {\n        return version === undefined\n          ? { outcome: \"fail\", evidence: '\"' + spec.package + '\" is not in package.json' + (includeDev ? \" (checked dependencies and devDependencies)\" : \" (checked dependencies only)\") }\n          : { outcome: \"pass\", evidence: '\"' + spec.package + '\": \"' + version + '\" is present in ' + where };\n      }\n      return version !== undefined\n        ? { outcome: \"fail\", evidence: '\"' + spec.package + '\": \"' + version + '\" found in package.json ' + where }\n        : { outcome: \"pass\", evidence: '\"' + spec.package + '\" does not appear in package.json' };\n    }\n\n    case \"path_glob_exists\":\n    case \"path_glob_absent\": {\n      const matches = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (spec.kind === \"path_glob_exists\") {\n        return matches.length === 0\n          ? { outcome: \"fail\", evidence: \"No file matches \\`\" + spec.glob + \"\\` among \" + project.files.length + \" path(s)\" }\n          : { outcome: \"pass\", evidence: matches.length + \" file(s) match \\`\" + spec.glob + \"\\`: \" + matches.slice(0, 6).join(\", \") };\n      }\n      return matches.length > 0\n        ? { outcome: \"fail\", evidence: matches.length + \" file(s) match \\`\" + spec.glob + \"\\` but none should: \" + matches.slice(0, 6).join(\", \") }\n        : { outcome: \"pass\", evidence: \"No file matches \\`\" + spec.glob + \"\\`\" };\n    }\n\n    case \"string_in_files\":\n    case \"string_absent_in_files\": {\n      const scoped = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (scoped.length === 0) {\n        return { outcome: \"skip\", evidence: \"no file matches the scope \\`\" + spec.glob + \"\\`\" };\n      }\n      const wordBoundary = spec.wordBoundary === undefined ? true : spec.wordBoundary;\n      const caseSensitive = spec.caseSensitive === undefined ? false : spec.caseSensitive;\n\n      for (const file of scoped) {\n        const text = readFile(file);\n        if (text === undefined) continue;\n        const hit = findMatchInText(text, spec.pattern, wordBoundary, caseSensitive);\n        if (hit === null) continue;\n\n        const where = file + \":\" + hit.line;\n        const quoted = JSON.stringify(hit.text.length > 160 ? hit.text.slice(0, 157) + \"...\" : hit.text);\n        if (spec.kind === \"string_absent_in_files\") {\n          return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n        }\n        return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n      }\n\n      if (spec.kind === \"string_in_files\") {\n        return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching \\`\" + spec.glob + \"\\`\" };\n      }\n      return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching \\`\" + spec.glob + \"\\`\" };\n    }\n\n    case \"command_exit_zero\": {\n      /* CI has a shell, which the browser does not. This is the one kind whose result can\n       * legitimately differ between the two targets, and it is environment-dependent by\n       * nature ΓÇö which is why it is never \\`blocking\\` by default. */\n      try {\n        const { execSync } = require(\"node:child_process\");\n        execSync(spec.command, { stdio: \"pipe\", cwd: spec.cwd || \".\" });\n        return { outcome: \"pass\", evidence: \"\\`\" + spec.command + \"\\` exited 0\" };\n      } catch (error) {\n        const out = (error.stdout || error.stderr || \"\").toString().trim().split(\"\\\\n\")[0] || \"\";\n        return { outcome: \"fail\", evidence: \"\\`\" + spec.command + \"\\` exited non-zero\" + (out ? \": \" + out : \"\") };\n      }\n    }\n\n    default:\n      return { outcome: \"skip\", evidence: \"kind \" + spec.kind + \" cannot run in CI without a model\" };\n  }\n}\n\n/* ----------------------------------------------------------------- report -- */\n/* The failure message is the product. It does the job of an ADR, a code-review */\n/* comment and an onboarding document, at the moment it is useful.             */\n\nfunction reportFailure(guard, result) {\n  const lines = [];\n  lines.push(\"\");\n  lines.push(\"\\\\x1b[31m\\\\u2717 \" + guard.decisionId + \" \\\\u2014 \" + guard.statement + \"\\\\x1b[0m\");\n  lines.push(\"  Guard \" + guard.id + \" (\" + guard.kind + \": \" + guard.target + \") FAILED  [\" + guard.severity + \"]\");\n  lines.push(\"  Evidence: \" + result.evidence);\n  lines.push(\"  Why this check verifies that decision: \" + guard.rationale);\n\n  const premises = guard.restsOn.length === 0\n    ? \"nothing recorded\"\n    : guard.restsOn.map((p) => p.id + \" \" + p.text + \" (\" + p.label + \")\").join(\", \");\n  lines.push(\"  Decided: \" + guard.decidedAt + \" \\\\u00b7 Rests on: \" + premises);\n\n  if (guard.restsOn.length === 0) {\n    lines.push(\"    (no recorded premise, so nothing can falsify it \\\\u2014 a gap worth filling in WhyLog)\");\n  }\n\n  for (const alt of guard.rejected) {\n    lines.push(\"  Rejected alternative \" + alt.value + (alt.whyRejected ? \" \\\\u2014 reason: \\\\\"\" + alt.whyRejected + \"\\\\\"\" : \" \\\\u2014 no reason recorded\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"  \\\\u2192 Is this a deliberate reversal?   Record it in WhyLog so the log stops claiming otherwise.\");\n  lines.push(\"  \\\\u2192 Or is this drift?                Undo the change: \" + undoHint(guard));\n  return lines.join(\"\\\\n\");\n}\n\nfunction undoHint(guard) {\n  switch (guard.kind) {\n    case \"dependency_absent\": return \"remove the \\\\\"\" + guard.target + \"\\\\\" dependency.\";\n    case \"dependency_present\": return \"install \\\\\"\" + guard.target + \"\\\\\", or record the decision that replaced it.\";\n    case \"path_glob_absent\": return \"remove the file(s) matching \\\\\"\" + guard.target + \"\\\\\".\";\n    case \"path_glob_exists\": return \"restore the file(s) matching \\\\\"\" + guard.target + \"\\\\\".\";\n    case \"string_absent_in_files\": return \"remove \\\\\"\" + guard.target + \"\\\\\" from the files in scope.\";\n    case \"string_in_files\": return \"add \\\\\"\" + guard.target + \"\\\\\" where the decision expects it.\";\n    default: return \"see the guard's rationale above.\";\n  }\n}\n\n/* -------------------------------------------------------------------- main -- */\n\nfunction main() {\n  const manifest = readManifest();\n  const files = listFiles(\".\");\n  const project = { dependencies: manifest.dependencies, devDependencies: manifest.devDependencies, files: files };\n\n  console.log(\"WhyLog decision guards \\\\u00b7 \" + GUARDS.length + \" guard(s) \\\\u00b7 \" + files.length + \" file(s) scanned\");\n\n  let blocking = 0;\n  let warnings = 0;\n  let passed = 0;\n  let skipped = 0;\n\n  for (const guard of GUARDS) {\n    const result = evaluate(guard, project);\n\n    if (result.outcome === \"pass\") { passed += 1; continue; }\n    if (result.outcome === \"skip\") {\n      skipped += 1;\n      console.log(\"\\\\x1b[33m\\\\u2013 \" + guard.id + \" SKIPPED\\\\x1b[0m (\" + guard.kind + \": \" + guard.target + \") \\\\u2014 \" + result.evidence);\n      continue;\n    }\n\n    if (guard.severity === \"blocking\") blocking += 1;\n    else warnings += 1;\n\n    console.log(reportFailure(guard, result));\n  }\n\n  console.log(\"\");\n  console.log(\"  passed \" + passed + \" \\\\u00b7 failed \" + (blocking + warnings) + \" (\" + blocking + \" blocking, \" + warnings + \" warning) \\\\u00b7 skipped \" + skipped);\n\n  if (blocking > 0) {\n    console.log(\"\\\\n\\\\x1b[31m\" + blocking + \" blocking decision guard(s) failed.\\\\x1b[0m\");\n    console.log(\"Each failure above names the decision, the premise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\\\n\" + warnings + \" warning-level guard(s) failed \\\\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n`;\n\n/* -------------------------------------------------------------------------- */\n/* The workflow                                                               */\n/* -------------------------------------------------------------------------- */\n\nexport function renderWorkflow(guardCount: number): string {\n  return [\n    \"# Generated by WhyLog. Runs the exported decision guards on every push and PR.\",\n    `# ${guardCount} guard(s). Re-export from the app when the log changes.`,\n    \"name: decision-guards\",\n    \"\",\n    \"on:\",\n    \"  push:\",\n    \"  pull_request:\",\n    \"\",\n    \"jobs:\",\n    \"  guards:\",\n    \"    runs-on: ubuntu-latest\",\n    \"    steps:\",\n    \"      - uses: actions/checkout@v4\",\n    \"\",\n    \"      - uses: actions/setup-node@v4\",\n    \"        with:\",\n    \"          node-version: 20\",\n    \"\",\n    \"      # No install step: the runner uses only the Node standard library.\",\n    \"      - name: WhyLog decision guards\",\n    /* The runner's path comes from RUNNER_PATH, the same constant the verify commands use.\n     * It used to be hard-coded here as `.whylog/guards.cjs`, a path that does not exist: the\n     * runner is written to `scripts/whylog-guards.cjs`, so the emitted workflow failed at\n     * \"Cannot find module\" before it could run a single guard. A workflow that points at the\n     * wrong file is a workflow that proves nothing. */\n    `        run: node ${RUNNER_PATH}`,\n    \"\",\n    \"      # Advisory only. A guard is a lock on a decision, not a lint rule, so its\",\n    \"      # failure is uploaded as an artifact for the PR rather than commented by a bot.\",\n    \"      - name: Upload guard report on failure\",\n    \"        if: failure()\",\n    \"        uses: actions/upload-artifact@v4\",\n    \"        with:\",\n    \"          name: whylog-guard-failures\",\n    `          path: ${RUNNER_PATH.slice(0, RUNNER_PATH.lastIndexOf(\"/\"))}/`,\n    \"          if-no-files-found: ignore\",\n    \"\",\n  ].join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeExport(exported: CiExport): string {\n  const kinds = new Map<string, number>();\n  for (const guard of exported.guards) {\n    kinds.set(guard.kind, (kinds.get(guard.kind) ?? 0) + 1);\n  }\n\n  const lines = [\n    `Exported ${exported.guards.length} guard(s) over ${new Set(exported.guards.map((g) => g.decisionId)).size} decision(s).`,\n    `Log head: ${exported.headHash}`,\n    \"\",\n  ];\n\n  for (const [kind, count] of [...kinds.entries()].sort((a, b) => b[1] - a[1])) {\n    lines.push(`  ${kind.padEnd(24)}${count}`);\n  }\n\n  if (exported.notExported.length > 0) {\n    lines.push(\"\");\n    lines.push(`Not exported (${exported.notExported.length}):`);\n    for (const entry of exported.notExported.slice(0, 10)) {\n      lines.push(`  ${entry.decisionId} ΓÇö ${entry.reason}`);\n    }\n    if (exported.notExported.length > 10)\n      lines.push(`  ΓÇª ${exported.notExported.length - 10} more`);\n  }\n\n  lines.push(\"\");\n  lines.push(\"Two files: `.whylog/guards.cjs` (standalone Node, standard library only) and\");\n  lines.push(\"`.github/workflows/decision-guards.yml`. Blocking failures exit non-zero; warnings\");\n  lines.push(\"are printed as advice and do not block the build.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 16 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 16 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 16 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\guards\\ci-export.ts"},"span":[6972,6987],"sourceCode":"/**\n * CI export ΓÇö 4.6.\n *\n * Phase 4 ┬╖ sub-phase 4.6\n * Plan: plan/phase-4-executable-guards.md ┬º4.6\n * Docs: docs/04-executable-decision-guards.md ┬º5.2\n *\n * ---------------------------------------------------------------------------\n * THE FAILURE MESSAGE IS THE PRODUCT\n *\n * Not \"guard G-0007b failed\". This:\n *\n *   Γ£ù WLD-0007 ΓÇö Use SQLite, not Postgres\n *     Guard G-0007b (dependency_absent: pg) FAILED\n *     Evidence: \"pg\": \"^8.11.3\" found in package.json dependencies\n *     Decided: 2026-10-03 ┬╖ Rests on: P-0002 single-user (IN), P-0005 no-deploy-infra (IN)\n *     Rejected alternative Postgres ΓÇö reason: \"deploy complexity\"\n *\n *     ΓåÆ Is this a deliberate reversal?   whylog reverse WLD-0007 --to postgres\n *     ΓåÆ Or is this drift?                remove the dependency.\n *\n * That message does the job of an ADR, a code-review comment and an onboarding document, at the\n * exact moment it is useful ΓÇö which is the moment someone has just installed the thing you\n * turned down six weeks ago and has no idea you turned it down.\n *\n * Everything it needs is embedded at export time: the decision, its premises with their labels\n * as they stood when the export was made, and the rejected alternatives with their reasons. A CI\n * job cannot query the log, so the log has to travel with the check.\n *\n * ---------------------------------------------------------------------------\n * SAME GUARD SET, SAME RESULTS\n *\n * ┬º4.6's acceptance criterion. The exported runner evaluates the SAME six predicates as the\n * in-browser interpreter, over the same data, and the guard set is serialised as DATA rather\n * than regenerated ΓÇö so the two cannot drift apart by having been written twice. The predicates\n * below are transcriptions of `eval/dependency.ts`, `eval/path.ts` and `eval/string.ts`,\n * including the word-boundary default and the dev-dependency asymmetry.\n *\n * What cannot be identical is the file discovery: the browser runs against a pasted virtual\n * project, CI against the real tree. That difference is the point of exporting, and it is why\n * the export carries the head hash ΓÇö so a result can be tied to the log state that produced it.\n *\n * ---------------------------------------------------------------------------\n * BLOCKING FAILS THE BUILD; WARNING DOES NOT\n *\n * `blocking` failures exit non-zero. `warning` failures are printed as advisory and do not\n * affect the exit code, because a string pattern is far easier to match by accident than a\n * dependency entry is, and a build that fails on an accidental match gets its guard deleted\n * rather than its code fixed.\n * ---------------------------------------------------------------------------\n */\n\nimport { RUNNER_PATH } from \"@/export/verify-command\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { Guard } from \"@/types/guards\";\nimport { isDeterministic } from \"@/types/guards\";\nimport { specTarget } from \"./feedback\";\n\n/* -------------------------------------------------------------------------- */\n/* What gets exported                                                         */\n/* -------------------------------------------------------------------------- */\n\n/** A guard plus everything the failure message needs, frozen at export time. */\nexport interface ExportedGuard {\n  readonly id: string;\n  readonly decisionId: string;\n  readonly statement: string;\n  readonly kind: Guard[\"spec\"][\"kind\"];\n  readonly target: string;\n  readonly severity: Guard[\"severity\"];\n  readonly rationale: string;\n  readonly spec: unknown;\n  readonly decidedAt: string;\n  readonly restsOn: readonly { id: string; text: string; label: string }[];\n  readonly rejected: readonly { value: string; whyRejected: string | null }[];\n  readonly appliesTo: readonly string[];\n}\n\nexport interface CiExport {\n  /** A standalone Node script. No dependencies beyond the standard library. */\n  readonly runner: string;\n  /** A GitHub Actions workflow running it on push and PR. */\n  readonly workflow: string;\n  readonly guards: readonly ExportedGuard[];\n  /** Decisions whose guards were all non-deterministic, so nothing could be exported for them.\n   *  Reported rather than silently omitted: an export that covers 8 of 12 decisions and does\n   *  not say so is an export that looks like coverage. */\n  readonly notExported: readonly { decisionId: DecisionId; reason: string }[];\n  readonly headHash: string;\n}\n\nexport interface CiExportInput {\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly headHash: string;\n  /** Export proposed guards too. Off by default: CI should run what a human accepted, and a\n   *  proposed guard failing a build is the day-one wall of red ┬º4.2 exists to prevent. */\n  readonly includeProposed?: boolean;\n}\n\nexport function exportCi(input: CiExportInput): CiExport {\n  const guards: ExportedGuard[] = [];\n  const notExported: { decisionId: DecisionId; reason: string }[] = [];\n  const seenDecisions = new Set<DecisionId>();\n\n  for (const guard of input.state.guards.values()) {\n    if (guard.lifecycle === \"deleted\" || guard.lifecycle === \"suppressed\") continue;\n    if (guard.lifecycle === \"proposed\" && input.includeProposed !== true) continue;\n\n    const decision = input.state.decisions.get(guard.decisionId);\n    if (decision === undefined) continue;\n\n    /* A superseded or archived decision's guards are not exported: the log has withdrawn the\n     * decision, and a CI job enforcing a withdrawn decision blocks work the log already\n     * approved. */\n    if (decision.status === \"superseded\" || decision.status === \"archived\") {\n      seenDecisions.add(decision.id);\n      notExported.push({\n        decisionId: decision.id,\n        reason: `the decision is ${decision.status}, so its guards are withdrawn with it`,\n      });\n      continue;\n    }\n\n    if (!isDeterministic(guard.spec.kind)) {\n      notExported.push({\n        decisionId: decision.id,\n        reason:\n          guard.spec.kind === \"command_exit_zero\"\n            ? `${guard.id} is a command guard ΓÇö exported separately below, since CI is exactly where a command can run`\n            : `${guard.id} is judged by a model, so it is advisory and cannot fail a build deterministically`,\n      });\n\n      /* Command guards CAN be exported: CI has a shell, which the browser does not. They are\n       * emitted into the runner's command section rather than the deterministic section. */\n      if (guard.spec.kind !== \"command_exit_zero\") continue;\n    }\n\n    seenDecisions.add(decision.id);\n    guards.push(exportedGuardOf(input.state, input.labels, guard, decision));\n  }\n\n  return {\n    runner: renderRunner(guards, input.headHash),\n    workflow: renderWorkflow(guards.length),\n    guards,\n    notExported,\n    headHash: input.headHash,\n  };\n}\n\nfunction exportedGuardOf(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  guard: Guard,\n  decision: Decision,\n): ExportedGuard {\n  const restsOn: { id: string; text: string; label: string }[] = [];\n  const seen = new Set<string>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n\n      restsOn.push({\n        id: premiseId,\n        text: premise.text,\n        /* The label as it stood AT EXPORT TIME. A CI job runs later, against a tree that may\n         * have moved; pretending the label is live would be a lie, and dating it is not. */\n        label: labels.get(premiseId)?.label ?? premise.label,\n      });\n    }\n  }\n\n  const rejected: { value: string; whyRejected: string | null }[] = [];\n  for (const alternativeId of decision.alternativeIds) {\n    const alternative = state.alternatives.get(alternativeId);\n    if (alternative === undefined) continue;\n    rejected.push({ value: alternative.value, whyRejected: alternative.whyRejected ?? null });\n  }\n\n  return {\n    id: guard.id,\n    decisionId: decision.id,\n    statement: decision.statement,\n    kind: guard.spec.kind,\n    target: specTarget(guard),\n    severity: guard.severity,\n    rationale: guard.rationale,\n    spec: guard.spec,\n    decidedAt: decision.temporal.valid.slice(0, 10),\n    restsOn,\n    rejected,\n    appliesTo: decision.appliesTo,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The runner                                                                 */\n/* -------------------------------------------------------------------------- */\n\n/**\n * A standalone Node script.\n *\n * Standard library only ΓÇö `fs` and `path`. No dependency to install, no build step, no\n * framework: it has to run in a CI job that has just checked out a repository and nothing else.\n */\nexport function renderRunner(guards: readonly ExportedGuard[], headHash: string): string {\n  const lines: string[] = [];\n\n  lines.push(\"#!/usr/bin/env node\");\n  lines.push(\"/**\");\n  lines.push(\" * WhyLog decision guards ΓÇö generated. Do not edit by hand.\");\n  lines.push(\" *\");\n  lines.push(` * Log head: ${headHash}`);\n  lines.push(` * Guards:   ${guards.length}`);\n  lines.push(\" *\");\n  lines.push(\" * Exits non-zero if any BLOCKING guard fails. Warning failures are printed\");\n  lines.push(\" * as advice and do not affect the exit code.\");\n  lines.push(\" *\");\n  lines.push(\" * Re-export from the app after any change to the log: the guard set below is\");\n  lines.push(\" * frozen at export time, and so are the premise labels in each failure message.\");\n  lines.push(\" */\");\n  lines.push(\"\");\n  lines.push('const fs = require(\"node:fs\");');\n  lines.push('const path = require(\"node:path\");');\n  lines.push(\"\");\n  lines.push(`const GUARDS = ${JSON.stringify(guards, null, 2)};`);\n  lines.push(\"\");\n  lines.push(RUNNER_BODY);\n\n  return lines.join(\"\\n\");\n}\n\n/**\n * The evaluator, transcribed.\n *\n * Kept as one block of emitted source rather than generated line by line, because it has to be\n * readable by whoever debugs a CI failure at 2am ΓÇö and generated-looking code is not.\n */\nconst RUNNER_BODY = `\n/* ---------------------------------------------------------------- project -- */\n\nfunction readManifest() {\n  try {\n    const raw = JSON.parse(fs.readFileSync(\"package.json\", \"utf8\"));\n    return {\n      dependencies: raw.dependencies || {},\n      devDependencies: raw.devDependencies || {},\n    };\n  } catch {\n    return { dependencies: {}, devDependencies: {} };\n  }\n}\n\nfunction listFiles(dir, out) {\n  out = out || [];\n  let entries;\n  try {\n    entries = fs.readdirSync(dir, { withFileTypes: true });\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    if (entry.name === \"node_modules\" || entry.name === \".git\") continue;\n    const full = path.join(dir, entry.name);\n    if (entry.isDirectory()) listFiles(full, out);\n    else out.push(full.split(path.sep).join(\"/\"));\n  }\n  return out;\n}\n\nfunction readFile(p) {\n  try {\n    return fs.readFileSync(p, \"utf8\");\n  } catch {\n    return undefined;\n  }\n}\n\n/* -------------------------------------------------------------------- glob -- */\n/* Transcribed from src/lib/glob.ts so results match the in-browser run.      */\n\nfunction globToRegExpSource(glob) {\n  let out = \"\";\n  for (let i = 0; i < glob.length; i += 1) {\n    const c = glob[i];\n    if (c === \"*\") {\n      if (glob[i + 1] === \"*\") {\n        if (glob[i + 2] === \"/\") { out += \"(?:.*/)?\"; i += 2; }\n        else { out += \".*\"; i += 1; }\n      } else out += \"[^/]*\";\n    } else if (c === \"?\") out += \"[^/]\";\n    else if (c === \".\") out += \"\\\\\\\\.\";\n    else if (\"+^$\\{}|()[]\".includes(c)) out += \"\\\\\\\\\" + c;\n    else out += c;\n  }\n  return out;\n}\n\nfunction matchesGlob(p, glob) {\n  return new RegExp(\"^\" + globToRegExpSource(glob) + \"$\").test(p);\n}\n\n/* Word boundaries ON by default: a bare substring match on \"pg\" hits \"pgp\",   */\n/* \"pgsql-tools\" and any passing mention in a comment.                        */\nfunction compilePattern(pattern, wordBoundary, caseSensitive) {\n  const escaped = pattern.replace(/[.*+?^\\${}()|[\\\\]\\\\\\\\]/g, \"\\\\\\\\$&\");\n  const source = wordBoundary === false ? escaped : \"\\\\\\\\b\" + escaped + \"\\\\\\\\b\";\n  return new RegExp(source, caseSensitive ? \"g\" : \"gi\");\n}\n\nfunction findMatchInText(text, pattern, wordBoundary, caseSensitive) {\n  const re = compilePattern(pattern, wordBoundary, caseSensitive);\n  const lines = text.split(\"\\\\n\");\n  for (let i = 0; i < lines.length; i += 1) {\n    re.lastIndex = 0;\n    if (re.test(lines[i])) return { line: i + 1, text: lines[i].trim() };\n  }\n  return null;\n}\n\n/* ---------------------------------------------------------------- evaluate -- */\n\nfunction evaluate(guard, project) {\n  const spec = guard.spec;\n\n  switch (spec.kind) {\n    case \"dependency_present\":\n    case \"dependency_absent\": {\n      /* Same asymmetry as the browser: an ABSENCE check covers devDependencies, because a\n       * rejected package installed for tooling is still installed. A PRESENCE check does not,\n       * because a build-only dependency does not mean the decision was implemented. */\n      const includeDev = spec.includeDev === undefined\n        ? spec.kind === \"dependency_absent\"\n        : spec.includeDev;\n\n      const inRuntime = project.dependencies[spec.package];\n      const inDev = includeDev ? project.devDependencies[spec.package] : undefined;\n      const version = inRuntime !== undefined ? inRuntime : inDev;\n      const where = inRuntime !== undefined ? \"dependencies\" : \"devDependencies\";\n\n      if (spec.kind === \"dependency_present\") {\n        return version === undefined\n          ? { outcome: \"fail\", evidence: '\"' + spec.package + '\" is not in package.json' + (includeDev ? \" (checked dependencies and devDependencies)\" : \" (checked dependencies only)\") }\n          : { outcome: \"pass\", evidence: '\"' + spec.package + '\": \"' + version + '\" is present in ' + where };\n      }\n      return version !== undefined\n        ? { outcome: \"fail\", evidence: '\"' + spec.package + '\": \"' + version + '\" found in package.json ' + where }\n        : { outcome: \"pass\", evidence: '\"' + spec.package + '\" does not appear in package.json' };\n    }\n\n    case \"path_glob_exists\":\n    case \"path_glob_absent\": {\n      const matches = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (spec.kind === \"path_glob_exists\") {\n        return matches.length === 0\n          ? { outcome: \"fail\", evidence: \"No file matches \\`\" + spec.glob + \"\\` among \" + project.files.length + \" path(s)\" }\n          : { outcome: \"pass\", evidence: matches.length + \" file(s) match \\`\" + spec.glob + \"\\`: \" + matches.slice(0, 6).join(\", \") };\n      }\n      return matches.length > 0\n        ? { outcome: \"fail\", evidence: matches.length + \" file(s) match \\`\" + spec.glob + \"\\` but none should: \" + matches.slice(0, 6).join(\", \") }\n        : { outcome: \"pass\", evidence: \"No file matches \\`\" + spec.glob + \"\\`\" };\n    }\n\n    case \"string_in_files\":\n    case \"string_absent_in_files\": {\n      const scoped = project.files.filter((f) => matchesGlob(f, spec.glob));\n      if (scoped.length === 0) {\n        return { outcome: \"skip\", evidence: \"no file matches the scope \\`\" + spec.glob + \"\\`\" };\n      }\n      const wordBoundary = spec.wordBoundary === undefined ? true : spec.wordBoundary;\n      const caseSensitive = spec.caseSensitive === undefined ? false : spec.caseSensitive;\n\n      for (const file of scoped) {\n        const text = readFile(file);\n        if (text === undefined) continue;\n        const hit = findMatchInText(text, spec.pattern, wordBoundary, caseSensitive);\n        if (hit === null) continue;\n\n        const where = file + \":\" + hit.line;\n        const quoted = JSON.stringify(hit.text.length > 160 ? hit.text.slice(0, 157) + \"...\" : hit.text);\n        if (spec.kind === \"string_absent_in_files\") {\n          return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n        }\n        return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" found at ' + where + \" ΓÇö \" + quoted };\n      }\n\n      if (spec.kind === \"string_in_files\") {\n        return { outcome: \"fail\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching \\`\" + spec.glob + \"\\`\" };\n      }\n      return { outcome: \"pass\", evidence: '\"' + spec.pattern + '\" does not appear in ' + scoped.length + \" file(s) matching \\`\" + spec.glob + \"\\`\" };\n    }\n\n    case \"command_exit_zero\": {\n      /* CI has a shell, which the browser does not. This is the one kind whose result can\n       * legitimately differ between the two targets, and it is environment-dependent by\n       * nature ΓÇö which is why it is never \\`blocking\\` by default. */\n      try {\n        const { execSync } = require(\"node:child_process\");\n        execSync(spec.command, { stdio: \"pipe\", cwd: spec.cwd || \".\" });\n        return { outcome: \"pass\", evidence: \"\\`\" + spec.command + \"\\` exited 0\" };\n      } catch (error) {\n        const out = (error.stdout || error.stderr || \"\").toString().trim().split(\"\\\\n\")[0] || \"\";\n        return { outcome: \"fail\", evidence: \"\\`\" + spec.command + \"\\` exited non-zero\" + (out ? \": \" + out : \"\") };\n      }\n    }\n\n    default:\n      return { outcome: \"skip\", evidence: \"kind \" + spec.kind + \" cannot run in CI without a model\" };\n  }\n}\n\n/* ----------------------------------------------------------------- report -- */\n/* The failure message is the product. It does the job of an ADR, a code-review */\n/* comment and an onboarding document, at the moment it is useful.             */\n\nfunction reportFailure(guard, result) {\n  const lines = [];\n  lines.push(\"\");\n  lines.push(\"\\\\x1b[31m\\\\u2717 \" + guard.decisionId + \" \\\\u2014 \" + guard.statement + \"\\\\x1b[0m\");\n  lines.push(\"  Guard \" + guard.id + \" (\" + guard.kind + \": \" + guard.target + \") FAILED  [\" + guard.severity + \"]\");\n  lines.push(\"  Evidence: \" + result.evidence);\n  lines.push(\"  Why this check verifies that decision: \" + guard.rationale);\n\n  const premises = guard.restsOn.length === 0\n    ? \"nothing recorded\"\n    : guard.restsOn.map((p) => p.id + \" \" + p.text + \" (\" + p.label + \")\").join(\", \");\n  lines.push(\"  Decided: \" + guard.decidedAt + \" \\\\u00b7 Rests on: \" + premises);\n\n  if (guard.restsOn.length === 0) {\n    lines.push(\"    (no recorded premise, so nothing can falsify it \\\\u2014 a gap worth filling in WhyLog)\");\n  }\n\n  for (const alt of guard.rejected) {\n    lines.push(\"  Rejected alternative \" + alt.value + (alt.whyRejected ? \" \\\\u2014 reason: \\\\\"\" + alt.whyRejected + \"\\\\\"\" : \" \\\\u2014 no reason recorded\"));\n  }\n\n  lines.push(\"\");\n  lines.push(\"  \\\\u2192 Is this a deliberate reversal?   Record it in WhyLog so the log stops claiming otherwise.\");\n  lines.push(\"  \\\\u2192 Or is this drift?                Undo the change: \" + undoHint(guard));\n  return lines.join(\"\\\\n\");\n}\n\nfunction undoHint(guard) {\n  switch (guard.kind) {\n    case \"dependency_absent\": return \"remove the \\\\\"\" + guard.target + \"\\\\\" dependency.\";\n    case \"dependency_present\": return \"install \\\\\"\" + guard.target + \"\\\\\", or record the decision that replaced it.\";\n    case \"path_glob_absent\": return \"remove the file(s) matching \\\\\"\" + guard.target + \"\\\\\".\";\n    case \"path_glob_exists\": return \"restore the file(s) matching \\\\\"\" + guard.target + \"\\\\\".\";\n    case \"string_absent_in_files\": return \"remove \\\\\"\" + guard.target + \"\\\\\" from the files in scope.\";\n    case \"string_in_files\": return \"add \\\\\"\" + guard.target + \"\\\\\" where the decision expects it.\";\n    default: return \"see the guard's rationale above.\";\n  }\n}\n\n/* -------------------------------------------------------------------- main -- */\n\nfunction main() {\n  const manifest = readManifest();\n  const files = listFiles(\".\");\n  const project = { dependencies: manifest.dependencies, devDependencies: manifest.devDependencies, files: files };\n\n  console.log(\"WhyLog decision guards \\\\u00b7 \" + GUARDS.length + \" guard(s) \\\\u00b7 \" + files.length + \" file(s) scanned\");\n\n  let blocking = 0;\n  let warnings = 0;\n  let passed = 0;\n  let skipped = 0;\n\n  for (const guard of GUARDS) {\n    const result = evaluate(guard, project);\n\n    if (result.outcome === \"pass\") { passed += 1; continue; }\n    if (result.outcome === \"skip\") {\n      skipped += 1;\n      console.log(\"\\\\x1b[33m\\\\u2013 \" + guard.id + \" SKIPPED\\\\x1b[0m (\" + guard.kind + \": \" + guard.target + \") \\\\u2014 \" + result.evidence);\n      continue;\n    }\n\n    if (guard.severity === \"blocking\") blocking += 1;\n    else warnings += 1;\n\n    console.log(reportFailure(guard, result));\n  }\n\n  console.log(\"\");\n  console.log(\"  passed \" + passed + \" \\\\u00b7 failed \" + (blocking + warnings) + \" (\" + blocking + \" blocking, \" + warnings + \" warning) \\\\u00b7 skipped \" + skipped);\n\n  if (blocking > 0) {\n    console.log(\"\\\\n\\\\x1b[31m\" + blocking + \" blocking decision guard(s) failed.\\\\x1b[0m\");\n    console.log(\"Each failure above names the decision, the premise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\\\n\" + warnings + \" warning-level guard(s) failed \\\\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n`;\n\n/* -------------------------------------------------------------------------- */\n/* The workflow                                                               */\n/* -------------------------------------------------------------------------- */\n\nexport function renderWorkflow(guardCount: number): string {\n  return [\n    \"# Generated by WhyLog. Runs the exported decision guards on every push and PR.\",\n    `# ${guardCount} guard(s). Re-export from the app when the log changes.`,\n    \"name: decision-guards\",\n    \"\",\n    \"on:\",\n    \"  push:\",\n    \"  pull_request:\",\n    \"\",\n    \"jobs:\",\n    \"  guards:\",\n    \"    runs-on: ubuntu-latest\",\n    \"    steps:\",\n    \"      - uses: actions/checkout@v4\",\n    \"\",\n    \"      - uses: actions/setup-node@v4\",\n    \"        with:\",\n    \"          node-version: 20\",\n    \"\",\n    \"      # No install step: the runner uses only the Node standard library.\",\n    \"      - name: WhyLog decision guards\",\n    /* The runner's path comes from RUNNER_PATH, the same constant the verify commands use.\n     * It used to be hard-coded here as `.whylog/guards.cjs`, a path that does not exist: the\n     * runner is written to `scripts/whylog-guards.cjs`, so the emitted workflow failed at\n     * \"Cannot find module\" before it could run a single guard. A workflow that points at the\n     * wrong file is a workflow that proves nothing. */\n    `        run: node ${RUNNER_PATH}`,\n    \"\",\n    \"      # Advisory only. A guard is a lock on a decision, not a lint rule, so its\",\n    \"      # failure is uploaded as an artifact for the PR rather than commented by a bot.\",\n    \"      - name: Upload guard report on failure\",\n    \"        if: failure()\",\n    \"        uses: actions/upload-artifact@v4\",\n    \"        with:\",\n    \"          name: whylog-guard-failures\",\n    `          path: ${RUNNER_PATH.slice(0, RUNNER_PATH.lastIndexOf(\"/\"))}/`,\n    \"          if-no-files-found: ignore\",\n    \"\",\n  ].join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeExport(exported: CiExport): string {\n  const kinds = new Map<string, number>();\n  for (const guard of exported.guards) {\n    kinds.set(guard.kind, (kinds.get(guard.kind) ?? 0) + 1);\n  }\n\n  const lines = [\n    `Exported ${exported.guards.length} guard(s) over ${new Set(exported.guards.map((g) => g.decisionId)).size} decision(s).`,\n    `Log head: ${exported.headHash}`,\n    \"\",\n  ];\n\n  for (const [kind, count] of [...kinds.entries()].sort((a, b) => b[1] - a[1])) {\n    lines.push(`  ${kind.padEnd(24)}${count}`);\n  }\n\n  if (exported.notExported.length > 0) {\n    lines.push(\"\");\n    lines.push(`Not exported (${exported.notExported.length}):`);\n    for (const entry of exported.notExported.slice(0, 10)) {\n      lines.push(`  ${entry.decisionId} ΓÇö ${entry.reason}`);\n    }\n    if (exported.notExported.length > 10)\n      lines.push(`  ΓÇª ${exported.notExported.length - 10} more`);\n  }\n\n  lines.push(\"\");\n  lines.push(\"Two files: `.whylog/guards.cjs` (standalone Node, standard library only) and\");\n  lines.push(\"`.github/workflows/decision-guards.yml`. Blocking failures exit non-zero; warnings\");\n  lines.push(\"are printed as advice and do not block the build.\");\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 34 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 34 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 34 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\guards\\eval\\llm-judge.ts"},"span":[3171,3183],"sourceCode":"/**\n * `llm_judge` ΓÇö 4.3. The last resort, scored separately.\n *\n * Phase 4 ┬╖ sub-phase 4.3\n * Plan: plan/phase-4-executable-guards.md ┬º4.3\n * Docs: docs/04-executable-decision-guards.md ┬º8\n *\n * ---------------------------------------------------------------------------\n * JUDGED VERDICTS NEVER ENTER THE COMPLIANCE SCORE\n *\n * This is the documented failure mode: \"`llm_judge` results laundered into the compliance\n * number\". The mitigation is structural, not a warning label ΓÇö `isDeterministic(kind)` is false\n * for this kind, `metrics/compliance.ts` filters on exactly that predicate, and there is no\n * code path by which a judged verdict reaches the headline number.\n *\n * A compliance score that includes a model's opinion is a score nobody can reproduce, and a\n * number that changes when the model changes is not a measurement of the codebase.\n *\n * ---------------------------------------------------------------------------\n * IT IS STILL WORTH HAVING\n *\n * Some decisions genuinely cannot be expressed deterministically. \"Keep the API surface small\"\n * has no dependency to check and no glob to match. For those, a rubric verdict over the scoped\n * files is better than an `unverifiable` mark ΓÇö but it is reported as ADVISORY, in its own\n * section, with the engine named on every verdict, and it never contributes to compliance.\n *\n * And when no key is configured, it does not fake a verdict. It skips, with a reason that says\n * what is missing. The downloaded-cross-encoder lesson from Phase 3 applies unchanged: an\n * unavailable path is documented as unavailable, never simulated.\n * ---------------------------------------------------------------------------\n */\n\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { filterByGlob } from \"@/lib/glob\";\nimport type { EngineId } from \"@/types/common\";\nimport type { LlmJudgeSpec, VirtualProject } from \"@/types/guards\";\nimport { hasFileContents, hasFileListing } from \"../project\";\nimport { type Evaluation, SKIP_NO_CONTENTS, SKIP_NO_LISTING } from \"./types\";\n\n/** How much file text is sent to the judge. Bounded because a rubric verdict over 200 KB of\n *  source is not a better verdict than one over the first 20 KB ΓÇö it is a slower and more\n *  expensive one, and the bound keeps the cost of an advisory check predictable. */\nexport const JUDGE_CHAR_BUDGET = 20_000;\n\n/** How many files, at most. */\nexport const JUDGE_FILE_LIMIT = 8;\n\nexport interface JudgeInput {\n  readonly spec: LlmJudgeSpec;\n  readonly project: VirtualProject;\n  readonly engine: WhyLogEngine | null;\n  readonly engineId: EngineId;\n  readonly decisionStatement: string;\n  readonly signal?: AbortSignal;\n}\n\nexport interface JudgeVerdict {\n  readonly evaluation: Evaluation;\n  /** Named on every verdict. A judgement with no attributed judge cannot be weighed. */\n  readonly engine: EngineId | null;\n  readonly filesJudged: readonly string[];\n  readonly truncated: boolean;\n}\n\n/**\n * Ask the engine to judge.\n *\n * Returns a SKIP evaluation ΓÇö never a fabricated verdict ΓÇö when there is no engine, when the\n * engine cannot classify, or when the data the rubric needs was not pasted.\n */\nexport async function evalLlmJudge(input: JudgeInput): Promise<JudgeVerdict> {\n  const { spec, project } = input;\n\n  if (input.engine === null) {\n    return skipped(\n      \"No engine is available, so this guard cannot be judged. It is advisory in any case and never contributes to the compliance score.\",\n      input.engineId,\n    );\n  }\n\n  if (!input.engine.capabilities().classification) {\n    return skipped(\n      `The active engine (${input.engineId}) cannot produce a judgement. Configure an LLM engine in Settings, or replace this guard with a deterministic one.`,\n      input.engineId,\n    );\n  }\n\n  if (!hasFileListing(project))\n    return skippedResult(SKIP_NO_LISTING.skipReason ?? \"\", input.engineId);\n  if (!hasFileContents(project))\n    return skippedResult(SKIP_NO_CONTENTS.skipReason ?? \"\", input.engineId);\n\n  const scoped: string[] = [];\n  for (const glob of spec.scopeGlobs) {\n    for (const path of filterByGlob(project.filePaths, glob)) {\n      if (project.fileContents[path] === undefined) continue;\n      if (!scoped.includes(path)) scoped.push(path);\n    }\n  }\n\n  if (scoped.length === 0) {\n    return skipped(\n      `No pasted file matches this guard's scope (${spec.scopeGlobs.join(\", \")}), so there was nothing to judge.`,\n      input.engineId,\n    );\n  }\n\n  const files = scoped.slice(0, JUDGE_FILE_LIMIT);\n  let budget = JUDGE_CHAR_BUDGET;\n  let truncated = scoped.length > files.length;\n  const material: string[] = [];\n\n  for (const path of files) {\n    const text = project.fileContents[path] ?? \"\";\n    if (budget <= 0) {\n      truncated = true;\n      break;\n    }\n    const slice = text.length > budget ? text.slice(0, budget) : text;\n    if (text.length > budget) truncated = true;\n    budget -= slice.length;\n    material.push(`--- ${path} ---\\n${slice}`);\n  }\n\n  const prompt = [\n    `Decision under test: ${input.decisionStatement}`,\n    \"\",\n    `Rubric: ${spec.rubric}`,\n    \"\",\n    \"Files in scope:\",\n    material.join(\"\\n\\n\"),\n    \"\",\n    \"Answer with exactly one of PASS or FAIL on the first line, then one line of evidence\",\n    \"quoting the file and the text that decided it. If the files do not let you tell, answer\",\n    \"SKIP and say what is missing.\",\n  ].join(\"\\n\");\n\n  const result = await input.engine.compose({\n    kind: \"guard-rationale\",\n    material: [],\n    question: prompt,\n    maxLengthChars: 600,\n    ...(input.signal === undefined ? {} : { signal: input.signal }),\n  });\n\n  const firstLine = result.text.split(\"\\n\")[0]?.trim().toUpperCase() ?? \"\";\n  const rest = result.text.split(\"\\n\").slice(1).join(\" \").trim();\n\n  if (firstLine.startsWith(\"PASS\")) {\n    return {\n      evaluation: {\n        outcome: \"pass\",\n        evidence: `Judged by ${result.engine}: ${rest.length > 0 ? rest : \"the rubric was satisfied\"}`,\n      },\n      engine: result.engine,\n      filesJudged: files,\n      truncated,\n    };\n  }\n\n  if (firstLine.startsWith(\"FAIL\")) {\n    return {\n      evaluation: {\n        outcome: \"fail\",\n        evidence: `Judged by ${result.engine}: ${rest.length > 0 ? rest : \"the rubric was not satisfied\"}`,\n      },\n      engine: result.engine,\n      filesJudged: files,\n      truncated,\n    };\n  }\n\n  return {\n    evaluation: {\n      outcome: \"skip\",\n      evidence: \"\",\n      skipReason: `The judge could not tell from the files in scope${rest.length > 0 ? `: ${rest}` : \".\"}${truncated ? ` The material was truncated to ${JUDGE_CHAR_BUDGET} characters.` : \"\"}`,\n    },\n    engine: result.engine,\n    filesJudged: files,\n    truncated,\n  };\n}\n\nfunction skipped(reason: string, engineId: EngineId): JudgeVerdict {\n  return {\n    evaluation: { outcome: \"skip\", evidence: \"\", skipReason: reason },\n    engine: engineId,\n    filesJudged: [],\n    truncated: false,\n  };\n}\n\nfunction skippedResult(reason: string, engineId: EngineId): JudgeVerdict {\n  return skipped(reason, engineId);\n}\n\n/** The advisory framing, printed wherever a judged verdict appears. */\nexport const ADVISORY_NOTICE =\n  \"Judged guards are ADVISORY. They are produced by a model, they are not reproducible, and \" +\n  \"they never enter the compliance score ΓÇö which is computed over deterministic guards only. \" +\n  \"A compliance number that included a model's opinion would change when the model changed, \" +\n  \"and would no longer be a measurement of the codebase.\";\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 31 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 31 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 31 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\voting.ts"},"span":[4399,4413],"sourceCode":"/**\n * Three-run majority voting ΓÇö 1.8, the LLM path only.\n *\n * Phase 1 ┬╖ sub-phase 1.8\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.8\n *\n * ---------------------------------------------------------------------------\n * WHY VOTE AT ALL\n *\n * ARGUS used exactly this because single-run consistency was imperfect: ╬▒ 0.64ΓÇô0.88\n * across components (docs/05 ┬º4). A model asked the same question three times at\n * low temperature does not answer identically, and the components it drops are not\n * random ΓÇö they are the ones it was least sure about. So agreement is a usable\n * confidence signal, and disagreement is a usable doubt signal.\n *\n * It costs 3├ù tokens and buys a measurable precision gain. That trade is worth\n * making explicit and TOGGLEABLE, so a demo can run at 1├ù when latency matters and\n * Phase 7 can measure what the 3├ù actually bought.\n *\n * ---------------------------------------------------------------------------\n * WHY THE LOCAL ENGINE DOES NOT VOTE\n *\n * It is deterministic. Three runs return three byte-identical results, so voting\n * would cost 3├ù the time and change nothing. `LOCAL_CAPABILITIES.voting` is false\n * and `vote()` short-circuits on a single run, so a caller cannot get this wrong by\n * accident.\n *\n * ---------------------------------------------------------------------------\n * ALIGNMENT IS THE HARD PART\n *\n * Three runs produce three differently-ordered, differently-worded lists. Voting\n * requires knowing which item in run 2 is \"the same\" as which item in run 1, and\n * the only stable handle is the ONTOLOGY: variable + canonical value for decisions,\n * type + canonical predicate for premises. Aligning on statement text would count\n * the same decision three times whenever the model rephrased it, which is the\n * opposite of what voting is for.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  ExtractionResult,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { normalise } from \"@/lib/text\";\nimport { canonicalPredicate, canonicalValueOf, foldKey } from \"@/ontology/canonicalize\";\nimport type { Confidence } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport { type ConfidenceTier, tierOf } from \"./types\";\n\n/** How many runs must agree for full confidence. Two of three, per the plan. */\nexport const MAJORITY_OF_THREE = 2;\n\nexport interface VotingOptions {\n  /** 1 disables voting: the first run is returned unchanged. */\n  readonly runs: 1 | 2 | 3;\n  /** Below this temperature the runs stop disagreeing and the vote stops meaning\n   *  anything. Reported, not enforced ΓÇö the caller owns the request. */\n  readonly temperature: number;\n}\n\nexport const DEFAULT_VOTING: VotingOptions = { runs: 3, temperature: 0.2 };\n\nexport interface RunAgreement {\n  readonly presentIn: number;\n  readonly totalRuns: number;\n  readonly majority: boolean;\n  /** Multiplier applied to the item's own confidence. 1 for a majority, less for\n   *  a singleton ΓÇö and the reduction is enough to move it down a tier, which is\n   *  what \"collapsed\" means in the review UI. */\n  readonly factor: number;\n}\n\nexport interface VoteOutcome {\n  readonly result: ExtractionResult;\n  readonly runsUsed: number;\n  readonly decisionAgreement: readonly RunAgreement[];\n  readonly premiseAgreement: readonly RunAgreement[];\n  readonly alternativeAgreement: readonly RunAgreement[];\n  /** Items that appeared in only one run. Kept, downgraded, collapsed. */\n  readonly singletons: number;\n  /** Items in no majority. Reported because it is the number that says whether\n   *  voting was worth the tokens. */\n  readonly agreementRate: number;\n}\n\n/** Confidence a singleton is multiplied by. 0.55 lands a 0.7 item at 0.385, which\n *  is below `TIER_MEDIUM_AT` ΓÇö so a singleton always collapses. */\nexport const SINGLETON_FACTOR = 0.55;\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Vote across runs.\n *\n * @param runs results in run order. `runs[0]` supplies the wording of every\n *             surviving item, so the output reads consistently rather than being\n *             stitched from three phrasings.\n */\nexport function voteAcrossRuns(runs: readonly ExtractionResult[]): VoteOutcome {\n  const first = runs[0];\n  if (first === undefined) {\n    throw new Error(\"voteAcrossRuns needs at least one run\");\n  }\n  if (runs.length <= 1) {\n    return {\n      result: first,\n      runsUsed: runs.length,\n      decisionAgreement: first.decisions.map(() => unanimous(1)),\n      premiseAgreement: first.premises.map(() => unanimous(1)),\n      alternativeAgreement: first.alternatives.map(() => unanimous(1)),\n      singletons: 0,\n      agreementRate: 1,\n    };\n  }\n\n  const total = runs.length;\n  const decisionKeys = runs.map((run) => new Set(run.decisions.map(decisionKey)));\n  const premiseKeys = runs.map((run) => new Set(run.premises.map(premiseKey)));\n  const alternativeKeys = runs.map((run) => new Set(run.alternatives.map(alternativeKey)));\n\n  let singletons = 0;\n  let agreed = 0;\n  let counted = 0;\n\n  const decisionAgreement: RunAgreement[] = [];\n  const decisions = first.decisions.map((candidate) => {\n    const agreement = agreementFor(decisionKey(candidate), decisionKeys, total);\n    decisionAgreement.push(agreement);\n    counted += 1;\n    agreed += agreement.majority ? 1 : 0;\n    if (!agreement.majority) singletons += 1;\n    return applyFactor(candidate, agreement.factor, (c, confidence) => ({ ...c, confidence }));\n  });\n\n  const premiseAgreement: RunAgreement[] = [];\n  const premises = first.premises.map((candidate) => {\n    const agreement = agreementFor(premiseKey(candidate), premiseKeys, total);\n    premiseAgreement.push(agreement);\n    counted += 1;\n    agreed += agreement.majority ? 1 : 0;\n    if (!agreement.majority) singletons += 1;\n\n    return applyFactor(candidate, agreement.factor, (c, confidence) => ({\n      ...c,\n      confidence,\n      // A premise only one run found is exactly the case the review exists for.\n      needsReview: true,\n    }));\n  });\n\n  const alternativeAgreement: RunAgreement[] = [];\n  const alternatives = first.alternatives.map((candidate) => {\n    const agreement = agreementFor(alternativeKey(candidate), alternativeKeys, total);\n    alternativeAgreement.push(agreement);\n    counted += 1;\n    agreed += agreement.majority ? 1 : 0;\n    if (!agreement.majority) singletons += 1;\n    return applyFactor(candidate, agreement.factor, (c, confidence) => ({ ...c, confidence }));\n  });\n\n  // Items found ONLY by later runs are added at singleton confidence. Dropping them\n  // would make voting strictly worse than one run: three chances to find something,\n  // but only the first run's findings count.\n  for (let i = 1; i < runs.length; i += 1) {\n    const run = runs[i];\n    if (run === undefined) continue;\n\n    for (const candidate of run.decisions) {\n      if (decisionKeys[0]?.has(decisionKey(candidate))) continue;\n      const agreement = agreementFor(decisionKey(candidate), decisionKeys, total);\n      if (agreement.presentIn < MAJORITY_OF_THREE) continue;\n      decisions.push(\n        applyFactor(candidate, agreement.factor, (c, confidence) => ({ ...c, confidence })),\n      );\n      decisionAgreement.push(agreement);\n    }\n\n    for (const candidate of run.premises) {\n      if (premiseKeys[0]?.has(premiseKey(candidate))) continue;\n      const agreement = agreementFor(premiseKey(candidate), premiseKeys, total);\n      if (agreement.presentIn < MAJORITY_OF_THREE) continue;\n      premises.push(\n        applyFactor(candidate, agreement.factor, (c, confidence) => ({\n          ...c,\n          confidence,\n          needsReview: true,\n        })),\n      );\n      premiseAgreement.push(agreement);\n    }\n\n    for (const candidate of run.alternatives) {\n      if (alternativeKeys[0]?.has(alternativeKey(candidate))) continue;\n      const agreement = agreementFor(alternativeKey(candidate), alternativeKeys, total);\n      if (agreement.presentIn < MAJORITY_OF_THREE) continue;\n      alternatives.push(\n        applyFactor(candidate, agreement.factor, (c, confidence) => ({ ...c, confidence })),\n      );\n      alternativeAgreement.push(agreement);\n    }\n  }\n\n  const usage = sumUsage(runs);\n\n  return {\n    result: {\n      ...first,\n      decisions,\n      premises,\n      alternatives,\n      // Discards are unioned: a candidate one run rejected and another kept is\n      // worth showing, and the denominator of the precision metric should count\n      // every candidate any run produced.\n      discarded: dedupeDiscards(runs),\n      durationMs: runs.reduce((sum, run) => sum + run.durationMs, 0),\n      ...(usage === undefined ? {} : { usage }),\n    },\n    runsUsed: total,\n    decisionAgreement,\n    premiseAgreement,\n    alternativeAgreement,\n    singletons,\n    agreementRate: counted === 0 ? 0 : Math.round((agreed / counted) * 100) / 100,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Alignment keys                                                             */\n/* -------------------------------------------------------------------------- */\n\n/** variable + canonical value. Stable across rephrasings, which is the point. */\nexport function decisionKey(candidate: DecisionCandidate): string {\n  const canonical =\n    candidate.variable === \"OTHER\"\n      ? foldKey(candidate.value)\n      : canonicalValueOf(candidate.variable, candidate.value);\n  return `D\\u0000${candidate.variable}\\u0000${normalise(canonical)}`;\n}\n\n/** type + canonical predicate. Values are deliberately NOT in the key: a premise\n *  whose value the model read differently across runs is still the same premise,\n *  and splitting it would hide the disagreement instead of surfacing it. */\nexport function premiseKey(candidate: PremiseCandidate): string {\n  return `P\\u0000${candidate.type}\\u0000${normalise(canonicalPredicate(candidate.type, candidate.predicate))}`;\n}\n\nexport function alternativeKey(candidate: AlternativeCandidate): string {\n  const canonical =\n    candidate.variable === \"OTHER\"\n      ? foldKey(candidate.value)\n      : canonicalValueOf(candidate.variable, candidate.value);\n  return `A\\u0000${candidate.decisionRef}\\u0000${candidate.variable}\\u0000${normalise(canonical)}`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Agreement                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction agreementFor(\n  key: string,\n  keySets: readonly (ReadonlySet<string> | undefined)[],\n  total: number,\n): RunAgreement {\n  let presentIn = 0;\n  for (const set of keySets) {\n    if (set?.has(key)) presentIn += 1;\n  }\n\n  const majority = presentIn >= MAJORITY_OF_THREE;\n  return {\n    presentIn,\n    totalRuns: total,\n    majority,\n    factor: majority ? 1 : SINGLETON_FACTOR,\n  };\n}\n\nfunction unanimous(totalRuns: number): RunAgreement {\n  return { presentIn: totalRuns, totalRuns, majority: true, factor: 1 };\n}\n\nfunction applyFactor<T extends { confidence: Confidence }>(\n  candidate: T,\n  factor: number,\n  withConfidence: (candidate: T, confidence: Confidence) => T,\n): T {\n  if (factor === 1) return candidate;\n  return withConfidence(candidate, asConfidence(Math.max(0.05, candidate.confidence * factor)));\n}\n\nfunction dedupeDiscards(runs: readonly ExtractionResult[]): ExtractionResult[\"discarded\"] {\n  const seen = new Set<string>();\n  const out: ExtractionResult[\"discarded\"][number][] = [];\n\n  for (const run of runs) {\n    for (const discard of run.discarded) {\n      const key = `${discard.kind}\\u0000${discard.discardedBy}\\u0000${normalise(discard.rawText).slice(0, 120)}`;\n      if (seen.has(key)) continue;\n      seen.add(key);\n      out.push(discard);\n    }\n  }\n  return out;\n}\n\nfunction sumUsage(runs: readonly ExtractionResult[]): ExtractionResult[\"usage\"] {\n  let promptTokens = 0;\n  let completionTokens = 0;\n  let any = false;\n\n  for (const run of runs) {\n    if (run.usage === undefined) continue;\n    any = true;\n    promptTokens += run.usage.promptTokens;\n    completionTokens += run.usage.completionTokens;\n  }\n\n  return any ? { promptTokens, completionTokens } : undefined;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeVoting(outcome: VoteOutcome): string {\n  if (outcome.runsUsed <= 1) {\n    return \"voting off ΓÇö one run. Turn it on in Settings to trade 3├ù tokens for run-agreement confidence.\";\n  }\n\n  const percent = Math.round(outcome.agreementRate * 100);\n  const parts = [\n    `${outcome.runsUsed} runs`,\n    `${percent}% of items reached a ${MAJORITY_OF_THREE}-of-${outcome.runsUsed} majority`,\n  ];\n  if (outcome.singletons > 0) {\n    parts.push(\n      `${outcome.singletons} appeared in only one run ΓÇö kept at ${SINGLETON_FACTOR} ├ù confidence, which collapses them`,\n    );\n  }\n  return parts.join(\" ┬╖ \");\n}\n\n/** What a run-agreement record means, for the review UI's per-item explanation. */\nexport function describeAgreement(agreement: RunAgreement): string {\n  if (agreement.majority) {\n    return `found in ${agreement.presentIn} of ${agreement.totalRuns} runs ΓÇö full confidence`;\n  }\n  return `found in ${agreement.presentIn} of ${agreement.totalRuns} runs ΓÇö confidence ├ù ${SINGLETON_FACTOR}, collapsed by default`;\n}\n\n/** The tier a voted item lands in, so callers can check that a singleton really\n *  does collapse rather than trusting the factor. */\nexport function tierAfterVoting(confidence: Confidence): ConfidenceTier {\n  return tierOf(confidence);\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 26 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 26 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 26 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\guards\\metrics\\coverage.ts"},"span":[1365,1373],"sourceCode":"/**\n * Verifiable Coverage ΓÇö 4.4.\n *\n * Phase 4 ┬╖ sub-phase 4.4\n * Plan: plan/phase-4-executable-guards.md ┬º4.4\n *\n *       IN decisions with ΓëÑ1 accepted guard\n *       ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n *              all IN decisions\n *\n * Low coverage means most of the log is unfalsifiable prose. This is the number that stops\n * compliance from flattering itself, and the reason `unverifiable` is a visible state rather\n * than a silent omission.\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { UnverifiableDecision } from \"@/types/guards\";\n\nexport interface CoverageResult {\n  readonly score: number;\n  readonly covered: number;\n  readonly inDecisions: number;\n  /** IN decisions with no accepted guard, and why ΓÇö from synthesis where it said. */\n  readonly uncovered: readonly DecisionId[];\n  readonly unverifiable: readonly UnverifiableDecision[];\n  /** Decisions that have PROPOSED guards but none accepted. Distinct from uncovered: these are\n   *  one review click away from being checkable, and saying so is more useful than listing them\n   *  as gaps. */\n  readonly awaitingAcceptance: readonly DecisionId[];\n}\n\nexport function coverage(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  unverifiable: readonly UnverifiableDecision[],\n): CoverageResult {\n  const inDecisions: DecisionId[] = [];\n\n  for (const decision of state.decisions.values()) {\n    if (decision.status === \"superseded\" || decision.status === \"archived\") continue;\n    const label = labels.get(decision.id)?.label ?? decision.label;\n    if (label !== \"IN\") continue;\n    inDecisions.push(decision.id);\n  }\n\n  const covered: DecisionId[] = [];\n  const awaiting: DecisionId[] = [];\n\n  for (const decisionId of inDecisions) {\n    const decision = state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    let accepted = 0;\n    let proposed = 0;\n\n    for (const guardId of decision.guardIds) {\n      const guard = state.guards.get(guardId);\n      if (guard === undefined) continue;\n      if (guard.lifecycle === \"accepted\") accepted += 1;\n      else if (guard.lifecycle === \"proposed\") proposed += 1;\n    }\n\n    if (accepted > 0) covered.push(decisionId);\n    else if (proposed > 0) awaiting.push(decisionId);\n  }\n\n  const uncovered = inDecisions.filter((id) => !covered.includes(id) && !awaiting.includes(id));\n\n  return {\n    score: inDecisions.length === 0 ? 0 : covered.length / inDecisions.length,\n    covered: covered.length,\n    inDecisions: inDecisions.length,\n    uncovered,\n    unverifiable,\n    awaitingAcceptance: awaiting,\n  };\n}\n\nexport function describeCoverage(result: CoverageResult): string {\n  if (result.inDecisions === 0) {\n    return \"No IN decisions, so there is nothing to cover.\";\n  }\n\n  const lines = [\n    `Verifiable coverage: ${result.covered} of ${result.inDecisions} IN decisions have at least one accepted guard.`,\n  ];\n\n  if (result.awaitingAcceptance.length > 0) {\n    lines.push(\n      `  ${result.awaitingAcceptance.length} more have PROPOSED guards awaiting acceptance: ${result.awaitingAcceptance.join(\", \")}. One review click each.`,\n    );\n  }\n\n  if (result.uncovered.length > 0) {\n    lines.push(\n      `  ${result.uncovered.length} have nothing proposed: ${result.uncovered.join(\", \")}`,\n    );\n  }\n\n  if (result.unverifiable.length > 0) {\n    lines.push(\"\");\n    lines.push(\"Unverifiable ΓÇö no guard could be synthesised, and the reason is recorded:\");\n    for (const entry of result.unverifiable) {\n      lines.push(`  ${entry.decisionId} ΓÇö ${entry.reason}`);\n    }\n  }\n\n  lines.push(\"\");\n  lines.push(\n    \"Unverifiable decisions are SHOWN, never skipped. They are exactly the ones most likely to\",\n    \"drift, because nothing would tell you if they did ΓÇö and a compliance score computed only\",\n    \"over the decisions that happened to be checkable is a score that flatters itself.\",\n  );\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\guards\\metrics\\compliance.ts"},"span":[3213,3223],"sourceCode":"/**\n * Decision Compliance ΓÇö 4.4. The headline number.\n *\n * Phase 4 ┬╖ sub-phase 4.4\n * Plan: plan/phase-4-executable-guards.md ┬º4.4\n * Docs: docs/04-executable-decision-guards.md ┬º7\n *\n * ---------------------------------------------------------------------------\n *       ╬ú | IN decisions whose guards all pass |\n *       ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ\n *       ╬ú | IN decisions with ΓëÑ1 accepted guard |\n *\n * ---------------------------------------------------------------------------\n * DETERMINISTIC GUARDS ONLY, AND THAT IS STRUCTURAL\n *\n * A judged verdict never enters this number. Not because it is labelled advisory elsewhere and\n * we trust the label ΓÇö because this file filters on `isDeterministic(kind)` and there is no code\n * path from an `llm_judge` result to the quotient. A compliance score that included a model's\n * opinion would change when the model changed, and would stop being a measurement of the\n * codebase.\n *\n * ---------------------------------------------------------------------------\n * THE DENOMINATOR IS THE PART THAT CAN BE GAMED, SO IT IS NAMED\n *\n * Only decisions WITH an accepted guard appear in the denominator. A log with one guard that\n * passes scores 100%, and that is why Verifiable Coverage sits next to this number in every\n * rendering of it. Compliance without coverage is a score that flatters itself, and the two are\n * never shown apart.\n *\n * ---------------------------------------------------------------------------\n * SKIPS ARE NOT PASSES\n *\n * A decision whose guards all skipped has no passing guard and no failing guard. It is counted\n * as NOT compliant ΓÇö because \"we could not check it\" is not \"it holds\" ΓÇö but it is reported\n * separately as `unchecked`, so a low score caused by a missing paste is distinguishable from a\n * low score caused by real drift. Conflating the two would make the number measure how much the\n * user pasted.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { DecisionId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport { isDeterministic } from \"@/types/guards\";\nimport type { EvaluatedGuard } from \"../types\";\n\nexport interface ComplianceResult {\n  readonly score: number;\n  readonly compliant: number;\n  readonly denominator: number;\n  /** Decisions whose guards all skipped ΓÇö no pass and no fail. */\n  readonly unchecked: readonly DecisionId[];\n  readonly failing: readonly DecisionId[];\n  /** Compliance counting only violations NEW since the baseline. The two numbers are always\n   *  shown together: raw hides nothing, baseline-relative is what you act on. */\n  readonly excludingBaselined: number;\n  readonly baselinedOnly: readonly DecisionId[];\n}\n\n/**\n * Compute compliance from a completed run.\n *\n * `labels` supplies the decision label, because labels are computed from the graph and nothing\n * stores them. Only IN decisions count: a decision the log does not currently believe is not a\n * decision the codebase is failing to honour.\n */\nexport function compliance(\n  evaluated: readonly EvaluatedGuard[],\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionOfGuard: ReadonlyMap<string, DecisionId>,\n): ComplianceResult {\n  const byDecision = new Map<DecisionId, readonly EvaluatedGuard[]>();\n\n  for (const entry of evaluated) {\n    /* Only deterministic guards, and only accepted ones that actually ran. */\n    if (!isDeterministic(entry.guard.spec.kind)) continue;\n    if (entry.guard.lifecycle !== \"accepted\") continue;\n\n    const decisionId = decisionOfGuard.get(entry.guard.id) ?? entry.guard.decisionId;\n    const label: DecisionLabel = labels.get(decisionId)?.label ?? \"UNKNOWN\";\n    if (label !== \"IN\") continue;\n\n    const existing = byDecision.get(decisionId);\n    if (existing === undefined) byDecision.set(decisionId, [entry]);\n    else (existing as EvaluatedGuard[]).push(entry);\n  }\n\n  let compliant = 0;\n  const unchecked: DecisionId[] = [];\n  const failing: DecisionId[] = [];\n  const baselinedOnly: DecisionId[] = [];\n\n  for (const [decisionId, guards] of byDecision) {\n    /* A decision whose guards were ALL disabled by label or skipped has nothing to say. */\n    const ran = guards.filter((entry) => !entry.skipped);\n    if (ran.length === 0) {\n      unchecked.push(decisionId);\n      continue;\n    }\n\n    const failures = ran.filter((entry) => entry.result.outcome === \"fail\");\n\n    if (failures.length === 0) {\n      compliant += 1;\n      continue;\n    }\n\n    failing.push(decisionId);\n\n    /* Every failure is one the baseline already knew about: the decision is not drifting, it\n     * was already like this when the baseline froze. */\n    if (failures.every((entry) => !entry.newViolation)) baselinedOnly.push(decisionId);\n  }\n\n  const denominator = byDecision.size - unchecked.length;\n  const score = denominator === 0 ? 0 : compliant / denominator;\n\n  /* Same quotient, but decisions failing only on baselined violations count as compliant. */\n  const excludingBaselined =\n    denominator === 0 ? 0 : (compliant + baselinedOnly.length) / denominator;\n\n  return {\n    score,\n    compliant,\n    denominator,\n    unchecked,\n    failing,\n    excludingBaselined,\n    baselinedOnly,\n  };\n}\n\n/** The headline sentence. Written for a person, because this is the number the plan pitches:\n *  \"your codebase has quietly stopped believing 3 of your 12 decisions.\" */\nexport function describeCompliance(result: ComplianceResult, inDecisions: number): string {\n  if (result.denominator === 0) {\n    return result.unchecked.length > 0\n      ? `No compliance score: ${result.unchecked.length} decision(s) have accepted guards but none of them could run against the pasted project. Paste a package.json or a file listing and the score becomes meaningful.`\n      : \"No compliance score: no IN decision has an accepted guard yet. Synthesise and accept guards first ΓÇö until then there is nothing to measure.\";\n  }\n\n  const drifted = result.denominator - result.compliant;\n\n  return [\n    drifted === 0\n      ? `All ${result.denominator} checkable decision(s) hold. The code still does what the log says it does.`\n      : `Your codebase has quietly stopped believing ${drifted} of ${result.denominator} checkable decision(s): ${result.failing.join(\", \")}.`,\n    \"\",\n    `  raw compliance              ${percent(result.score)}  (${result.compliant}/${result.denominator})`,\n    `  excluding baselined         ${percent(result.excludingBaselined)}  (${result.compliant + result.baselinedOnly.length}/${result.denominator})`,\n    `  verifiable coverage         ${percent(result.denominator / Math.max(1, inDecisions))}  (${result.denominator} of ${inDecisions} IN decisions have an accepted deterministic guard)`,\n    result.unchecked.length > 0\n      ? `  unchecked                   ${result.unchecked.length} decision(s) whose guards all skipped ΓÇö not counted either way, because 'could not check' is not 'holds'`\n      : \"\",\n    \"\",\n    \"Compliance and coverage are NEVER shown apart: a log with one passing guard scores 100%\",\n    \"compliance, so the number on its own flatters itself. Deterministic guards only ΓÇö a judged\",\n    \"verdict cannot reach this quotient, because a score that moved when the model changed would\",\n    \"not be a measurement of the codebase.\",\n  ]\n    .filter((line) => line !== \"\")\n    .join(\"\\n\");\n}\n\nexport function percent(value: number): string {\n  return `${(value * 100).toFixed(0)}%`;\n}\n\n/** Bar for the dashboard, ten cells, as in the plan's D4.2 mock. */\nexport function bar(value: number, width = 10): string {\n  const filled = Math.max(0, Math.min(width, Math.round(value * width)));\n  return \"\\u2588\".repeat(filled) + \"\\u2591\".repeat(width - filled);\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 24 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 24 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 24 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\stamp\\index.ts"},"span":[1274,1284],"sourceCode":"/**\n * Integrity stamp assembly ΓÇö 5.5.\n *\n * Phase 5 ┬╖ sub-phase 5.5\n * Plan: plan/phase-5-export-compiler.md ┬º5.5\n *\n * The footer every artifact carries. Counts, not vibes: a reader who disagrees with the export\n * can check each number against the log, and a number that cannot be checked is not a stamp.\n */\n\nimport { acceptedGuards } from \"@/guards\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { ISODateString } from \"@/types/common\";\nimport type { IntegrityStamp } from \"@/types/export\";\nimport { STAMP_MARKER, STAMP_MARKER_END, artifactDigest, headHashOf, shortHash } from \"./hash\";\n\n/** Bumped when the stamp's SHAPE changes, not when the log changes. An importer refuses a stamp\n *  it cannot parse rather than guessing at fields, so a reader from an older build sees\n *  \"incompatible\" instead of silently reading zeros. */\nexport const STAMP_SCHEMA_VERSION = 1;\n\nexport interface StampInput {\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly headHash: string;\n  readonly generatedAt: ISODateString;\n  readonly engineAtGeneration: string;\n  readonly compliance: number;\n  readonly verifiableCoverage: number;\n}\n\nexport function buildStamp(input: StampInput): IntegrityStamp {\n  const decisions = { total: 0, inLabel: 0, out: 0, superseded: 0 };\n  const premises = { total: 0, inLabel: 0, out: 0, contested: 0 };\n\n  for (const decision of input.state.decisions.values()) {\n    decisions.total += 1;\n\n    if (decision.status === \"superseded\" || decision.status === \"archived\") {\n      decisions.superseded += 1;\n      continue;\n    }\n\n    const label = input.labels.get(decision.id)?.label ?? decision.label;\n    if (label === \"IN\") decisions.inLabel += 1;\n    else if (label === \"OUT\") decisions.out += 1;\n  }\n\n  for (const premise of input.state.premises.values()) {\n    premises.total += 1;\n\n    const label = input.labels.get(premise.id)?.label ?? premise.label;\n    if (label === \"IN\") premises.inLabel += 1;\n    else if (label === \"OUT\") premises.out += 1;\n    else if (label === \"UNKNOWN\") premises.contested += 1;\n  }\n\n  let passing = 0;\n  let failing = 0;\n  for (const guard of acceptedGuards(input.state)) {\n    if (guard.lastRun === undefined) continue;\n    if (guard.lastRun.outcome === \"pass\") passing += 1;\n    else if (guard.lastRun.outcome === \"fail\") failing += 1;\n  }\n\n  return {\n    headHash: headHashOf(input.headHash),\n    generatedAt: input.generatedAt,\n    schemaVersion: STAMP_SCHEMA_VERSION,\n    decisions,\n    premises,\n    compliance: input.compliance,\n    verifiableCoverage: input.verifiableCoverage,\n    guards: { passing, failing },\n    engineAtGeneration: input.engineAtGeneration,\n  };\n}\n\n/**\n * The footer, as it appears in the artifact.\n *\n * Machine-readable JSON inside an HTML comment, followed by a human-readable summary. Both, in\n * the same block: the comment is what `stamp/verify.ts` parses, and the prose is what a person\n * reads. A stamp only a machine can read is a stamp nobody checks, and one only a human can read\n * cannot be verified on re-import.\n */\nexport function renderStamp(stamp: IntegrityStamp, contentsForDigest: string): string {\n  const payload = JSON.stringify({\n    v: stamp.schemaVersion,\n    head: stamp.headHash,\n    at: stamp.generatedAt,\n    digest: artifactDigest(contentsForDigest),\n    decisions: stamp.decisions,\n    premises: stamp.premises,\n    compliance: round(stamp.compliance),\n    coverage: round(stamp.verifiableCoverage),\n    guards: stamp.guards,\n    engine: stamp.engineAtGeneration,\n  });\n\n  return [\n    \"---\",\n    \"\",\n    STAMP_MARKER,\n    payload,\n    STAMP_MARKER_END,\n    \"\",\n    `Generated by WhyLog ┬╖ ${stamp.generatedAt}`,\n    `Log head: ${shortHash(stamp.headHash)}    Decisions: ${stamp.decisions.total} (IN ${stamp.decisions.inLabel} ┬╖ OUT ${stamp.decisions.out} ┬╖ superseded ${stamp.decisions.superseded})`,\n    `Premises: ${stamp.premises.total} (IN ${stamp.premises.inLabel} ┬╖ OUT ${stamp.premises.out} ┬╖ contested ${stamp.premises.contested})`,\n    `Compliance: ${Math.round(stamp.compliance * 100)}% ┬╖ Verifiable coverage: ${Math.round(stamp.verifiableCoverage * 100)}% ┬╖ Guards: ${stamp.guards.passing} passing / ${stamp.guards.failing} failing`,\n    `Schema: whylog/v${stamp.schemaVersion} ┬╖ Engine at generation: ${stamp.engineAtGeneration}`,\n    \"\",\n    \"This stamp is for AUDITABILITY, not security. It lets you say which log state produced this\",\n    \"file and detect that the file no longer corresponds to it. It is unsalted and the algorithm\",\n    \"is in the source, so anyone can recompute it ΓÇö including an agent that has just rewritten the\",\n    \"file and the stamp along with it. Compare against the log; do not trust the file.\",\n  ].join(\"\\n\");\n}\n\nfunction round(value: number): number {\n  return Math.round(value * 1000) / 1000;\n}\n\nexport {\n  artifactDigest,\n  headHashOf,\n  shortHash,\n  stripStamp,\n  STAMP_MARKER,\n  STAMP_MARKER_END,\n} from \"./hash\";\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * `npm run eval:report` ΓÇö write the full evaluation report to disk.\n *  out.push(\"# DecisionMemEval ΓÇö evaluation report\");\n  out.push(\"\");\n  out.push(\n    \"Generated \" + nowISO() + \". Do not edit by hand: `npm run eval:report` regenerates it.\",\n  );\n  out.push(\"\");\n  out.push(\"Corpus \" +\n      corpus.version +\" ┬╖ engine \" +describeEngine(scored) +\" ┬╖ \" +corpus.transcripts.length +\" transcripts\"    out.push(\"\");\n    out.push(\"NOT RUN. Pass `--ablation` or run `npm run eval:ablation` separately.\");\n    out.push(\"A baseline without ablations supports claims about what the system scores, not about which\",\n    );\n    out.push(\"component earned the score ΓÇö and only the second kind of claim is an architectural one.\");\n    out.push(\"\");\n  }  out.push(\"\");\n  if (hardening === null) {\n    out.push(\"NOT RUN. `npm run eval` computes it; a report without it has checked no demo-killer.\");\n  } else {\n    out.push(\"```\");  const without = metricsWithoutComparator(scored);\n  out.push(\n    without.length +\" of \" +scored.metrics.length +\n      \" metrics have no published comparator. This is the new-territory claim stated as a count rather than\",\n    \"as an adjective:\",\n  );function metricsSummary(scored: ScoredRun): string {\n  const lines = [\n    \"Thirteen metrics over \" +scored.run.transcripts.length +\" transcripts. Every one carries its sample\",\n    \"size, its comparator where one is published, and a statement of what it does not establish.\",\n    \"\",\n  for (const metric of scored.metrics) {\n    const value =metric.id === \"false-positive-rate\"\n        ? metric.value.toFixed(1) + \" per 100 (lower is better)\"\n: metric.value.toFixed(3);\n    lines.push(\"- **\" + metric.name + \"**: \" + value + \" (n=\" + metric.n + \")\");\n  }\n  out.push(\n    \"**\" +(metric.id === \"false-positive-rate\"\n        ? metric.value.toFixed(1) + \" per 100 decisions\": metric.value.toFixed(3)) +\n\"** ┬╖ n=\" +metric.n +\n(detail === null? \"\": \" ┬╖ P \" +\n          detail.precision.toFixed(3) +\" / R \" +detail.recall.toFixed(3) +\n          \" / F1 \" +detail.f1.toFixed(3) +\" (TP \" +detail.truePositives +\", FP \" +detail.falsePositives +\", FN \" +detail.falseNegatives +\")\"),\n  );\n  out.push(\"\");\n  out.push(metric.gloss);\n  out.push(\"\");\n  out.push(\"Comparator: \" +(metric.comparator === null\n? \"**none published.** The absence is the finding ΓÇö see the honest note.\"\n: metric.comparator.source + \" ΓÇö \" + metric.comparator.value));\n  out.push(\"\");\n  out.push(\"> \" + metric.honestNote);  out.push(\"| --- | --- | --- | --- |\");\n  for (const entry of scored.extraction.perTranscript) {\n    out.push(\"| \" + entry.transcript + \" | \" + entry.tp + \" | \" + entry.fp + \" | \" + entry.fn + \" |\");\n  }\n  out.push(\"\");    out.push(\n      \"Found the sentence, understood it as the wrong kind of decision (\" +\nscored.extraction.variableErrors.length +\"):\",\n    );\n    out.push(\"\");\n    for (const entry of scored.extraction.variableErrors.slice(0, 12)) {\n      out.push(\"- `\" +entry.label.key +\"` labelled \" +entry.label.variable +\", extracted as \" +entry.node.variable,\n      );\n    }\n    out.push(\"\");\n  if (scored.premise.predicateErrors.length > 0) {\n    out.push(\"Premises matched on span but given the wrong predicate (\" +scored.premise.predicateErrors.length +);\n    out.push(\"\");\n    for (const entry of scored.premise.predicateErrors.slice(0, 12)) {\n      out.push(\"` labelled `\" +entry.label.predicate +\"`, extracted as `\" +entry.node.predicate +\"`\"  if (scored.premise.typeErrors.length > 0) {\n    out.push(\n      \"Premise TYPE errors (\" +scored.premise.typeErrors.length +\") ΓÇö spans overlap but the types disagree.\",\n      \"The substrate forbids merging across types, so these are near-misses the alignment refused:\",\n    );\n    out.push(\"\");\n    for (const entry of scored.premise.typeErrors.slice(0, 12)) {\n      out.push(entry.label.type +entry.node.type\n  if (scored.modality.wronglyPromoted.length > 0) {\n    out.push(\"**Statements that should not have become nodes, and did** (\" +scored.modality.wronglyPromoted.length +);\n    out.push(\"\");\n    for (const entry of scored.modality.wronglyPromoted) {  }\n\n  out.push(\"Alternative FP:FN ratio ΓÇö \" + scored.alternative.fpToFnRatio + \" (ARGUS published 13:1).\");\n  out.push(\"\");\n  return out;  const out = [\"### Planted cases\", \"\"];\n\n  out.push(\"| plant | testable | expected flips | flipped | missed | survivors kept | over-retracted | correct |\");\n  out.push(\"| --- | --- | --- | --- | --- | --- | --- | --- |\");\n  for (const entry of scored.cascade.perPlant) {\n    out.push(\n      \"| \" +entry.plant +\" | \" +(entry.testable ? \"yes\" : \"NO\") +entry.expectedFlips.length +\" | \" +\nentry.flipped.length +entry.missedFlips.length +entry.survived.length +entry.overRetracted.length +(entry.correct ? \"Γ£ô\" : \"Γ£ù\") +\" |\",\n    );\n  }    out.push(\"\");\n    for (const entry of scored.cascade.perPlant) {\n      for (const key of entry.overRetracted)out.push(\"- \" + entry.plant + \" retracted `\" + key + \"`, which shares no falsified premise\",\n          if (scored.resolver.unresolvable.length > 0) {\n    out.push(\n      \"**Plant keys with no runtime node** (\" +scored.resolver.unresolvable.length +\"). These plants are scored as\",\n      \"FAILED rather than skipped ΓÇö skipping would make cascade correctness improve as extraction worsens:\",\n    );\"Contradiction records by gate: \" +\nscored.contradiction.byGate.structural +\" structural, \" +\nscored.contradiction.byGate.semantic +\" semantic, \" +\nscored.contradiction.byGate.premise +\" premise. Kantara diagnostics: \" +\nscored.contradiction.m1Detections +\" M1, \" +scored.contradiction.m2Detections +\" M2.\"\"Justifications carrying a non-empty OUT-list: \" +scored.invalidation.outListPopulated +\nscored.invalidation.decisionsTotal +\" decisions. Zero means the graph is monotonic and L2 cannot score.\");\n  out.push(\"\");\n\n  if (scored.falsePositives.examples.length > 0) {\n    out.push(\"Unexpected interruptions (the false-positive numerator), first \" +scored.falsePositives.examples.length +\":\");\n    out.push(\"\");\n    for (const example of scored.falsePositives.examples) out.push(\"- \" + example);\nfunction questionDetail(scored: ScoredRun): string[] {\n  const out = [\"### Questions\",\"\",\"| id | verdict | expected | groundedness | claims | searches | over budget |\",\"| --- | --- | --- | --- | --- | --- | --- |\"];\n\n  for (const entry of scored.groundedness.perQuestion) {\n    out.push(\n      \"| \" +entry.question +entry.verdict +entry.expectedVerdict +entry.groundedness.toFixed(2) +entry.groundedClaims +\"/\" +entry.claims +entry.searches +(entry.overBudget ? \"YES\" : \"no\") +  for (const entry of scored.retrieval.perQuestion) {\n    out.push(\n      \"| \" +entry.relevant.length +entry.relevantFound +(entry.firstRelevantRank === null ? \"ΓÇö\" : String(entry.firstRelevantRank)) +  );\n  out.push(\"\");\n  out.push(\"- synthesis rate: \" +scored.guards.decisionsWithGuard +scored.guards.decisionsTotal +\" decisions got a proposed guard\"\"- determinism share: \" +scored.guards.deterministic +\" deterministic, \" +scored.guards.judged +\" `llm_judge`\");\n  out.push(\"- skips counted as passes (must be 0): \" + scored.guards.skippedCountedAsPass);\n  out.push(\"- guards auto-accepted without a human (must be 0, invariant I4): \" +scored.guards.autoAccepted\"- stale `disabledByDecisionLabel` flags (must be 0): \" + scored.guards.staleDisabledFlags\n  heading(\"Baseline run\");\n  const run = await runConfig(resolved, {id: \"full\",engine,engineId,toggles: FULL,params: DEFAULT_PARAMS});\n  line(\"imported in \" +(run.durationMs / 1000).toFixed(1) +\"s ┬╖ \" +run.state.decisions.size +\" decisions\");\n\n  const scored = scoreAll(resolved, run, engineId);\n  blank();\n  line(\"The report is generated. docs/EVALUATION.md quotes from it and never restates it, because two\");\n  line(\"copies of a number drift and a benchmark that disagrees with its own output is worse than none.\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,77]}}},{"equalLines":{"line_count":50}},{"diffOp":{"equal":{"range":[77,159]}}},{"diffOp":{"insert":{"range":[159,164]}}},{"diffOp":{"equal":{"range":[164,252]}}},{"diffOp":{"insert":{"range":[252,256]}}},{"diffOp":{"equal":{"range":[256,286]}}},{"diffOp":{"insert":{"range":[159,164]}}},{"diffOp":{"equal":{"range":[286,297]}}},{"diffOp":{"delete":{"range":[77,78]}}},{"diffOp":{"insert":{"range":[297,304]}}},{"diffOp":{"equal":{"range":[304,320]}}},{"diffOp":{"delete":{"range":[77,78]}}},{"diffOp":{"insert":{"range":[297,304]}}},{"diffOp":{"equal":{"range":[320,335]}}},{"diffOp":{"delete":{"range":[77,78]}}},{"diffOp":{"insert":{"range":[297,304]}}},{"diffOp":{"equal":{"range":[335,359]}}},{"diffOp":{"delete":{"range":[77,78]}}},{"diffOp":{"insert":{"range":[297,304]}}},{"diffOp":{"equal":{"range":[359,367]}}},{"diffOp":{"delete":{"range":[77,78]}}},{"diffOp":{"insert":{"range":[297,304]}}},{"diffOp":{"equal":{"range":[367,394]}}},{