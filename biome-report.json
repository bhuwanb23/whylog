ent starts to mean something about\n * determinism rather than about warm state.\n *\n * Consecutive matters more than the count. Three runs with a rebuild in between test the build; three\n * runs back to back test that the SECOND and THIRD start from whatever the first left behind ΓÇö which is\n * the actual failure mode, because a demo that only works from a cold start is a demo that cannot be\n * repeated for a second judge who walks up to the table afterwards.\n *\n * ---------------------------------------------------------------------------\n * WHAT IS COMPARED\n *\n * Node counts, label assignments and contradiction records. Not timings and not id strings: timings\n * vary with machine load and comparing them would produce a \"non-deterministic\" verdict for a run that\n * is perfectly reproducible, which teaches the presenter to ignore the report.\n *\n * Ids ARE compared, but only for stability across runs, not for value ΓÇö a run that mints different ids\n * from the same input has a counter that depends on something other than the input, and that is a real\n * defect worth catching even though the specific ids do not matter.\n * ---------------------------------------------------------------------------\n */\n\nimport type { SeedResult } from \"./kit\";\nimport { buildSeed } from \"./kit\";\nimport { verifyDemo, type VerificationReport } from \"./verify\";\n\nexport const REQUIRED_DRY_RUNS = 3;\n\nexport interface DryRunFingerprint {\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly guards: number;\n  readonly contradictions: number;\n  readonly justifications: number;\n  /** Sorted decision ids. Compared for stability, not for value. */\n  readonly decisionIds: readonly string[];\n  /** Sorted `id=label` pairs. This is the comparison that matters: a cascade that fires on run one and\n   *  not on run two produces identical counts and different labels, and counts alone would pass it. */\n  readonly labels: readonly string[];\n  readonly durationMs: number;\n}\n\nexport interface DryRun {\n  readonly n: number;\n  readonly fingerprint: DryRunFingerprint;\n  /** Null when the run threw. A stub report would look like a real one in the table. */\n  readonly verification: VerificationReport | null;\n  readonly warnings: readonly string[];\n  readonly error: string | null;\n}\n\nexport interface DryRunReport {\n  readonly runs: readonly DryRun[];\n  readonly deterministic: boolean;\n  readonly divergences: readonly string[];\n  readonly allDemoable: boolean;\n  readonly passed: boolean;\n}\n\n/**\n * Run the demo dry-run sequence.\n *\n * Deliberately does NOT reset between runs. That is the point: run two and run three start from whatever\n * run one left in storage, which is exactly the condition a second judge at the table reproduces. A\n * harness that reset between runs would be testing a scenario nobody encounters.\n */\nexport async function runDryRuns(count: number = REQUIRED_DRY_RUNS): Promise<DryRunReport> {\n  const runs: DryRun[] = [];\n\n  for (let n = 1; n <= count; n += 1) {\n    const started = Date.now();\n    try {\n      const seed = await buildSeed();\n      runs.push({\n        n,\n        fingerprint: fingerprintOf(seed, Date.now() - started),\n        verification: verifyDemo(seed),\n        warnings: seed.warnings,\n        error: null,\n      });\n    } catch (error) {\n      /* No verification is attempted on a run that threw. Building a stub report to fill the slot would\n       * print a row of zeros that looks like a measured result, and the whole point of the table is that\n       * every number in it came from a run that completed. */\n      runs.push({\n        n,\n        fingerprint: emptyFingerprint(Date.now() - started),\n        verification: null,\n        warnings: [],\n        error: error instanceof Error ? error.message : String(error),\n      });\n    }\n  }\n\n  const divergences = compare(runs);\n\n  return {\n    runs,\n    divergences,\n    deterministic: divergences.length === 0,\n    allDemoable: runs.every((run) => run.verification !== null && run.verification.demoable),\n    /* Passing requires determinism AND demoability across all three. A demo that works differently each\n     * time is not a demo that can be relied on, even if each individual run looked fine. */\n    passed: divergences.length === 0 && runs.every((run) => run.verification !== null && run.verification.demoable),\n  };\n}\n\nfunction fingerprintOf(seed: SeedResult, durationMs: number): DryRunFingerprint {\n  const decisions = [...seed.state.decisions.values()];\n\n  return {\n    decisions: decisions.length,\n    premises: seed.state.premises.size,\n    alternatives: seed.state.alternatives.size,\n    guards: seed.state.guards.size,\n    contradictions: seed.state.contradictions.length,\n    justifications: seed.state.justifications.size,\n    decisionIds: decisions.map((decision) => String(decision.id)).sort(),\n    labels: decisions.map((decision) => decision.id + \"=\" + decision.label).sort(),\n    durationMs,\n  };\n}\n\nfunction emptyFingerprint(durationMs: number): DryRunFingerprint {\n  return {\n    decisions: 0, premises: 0, alternatives: 0, guards: 0, contradictions: 0, justifications: 0,\n    decisionIds: [], labels: [], durationMs,\n  };\n}\n\nfunction compare(runs: readonly DryRun[]): readonly string[] {\n  const out: string[] = [];\n  const first = runs[0];\n  if (first === undefined) return [\"no runs completed\"];\n\n  for (const run of runs.slice(1)) {\n    if (run.error !== null) {\n      out.push(\"run \" + run.n + \" threw: \" + run.error);\n      continue;\n    }\n    if (first.error !== null) continue;\n\n    const fields: (keyof DryRunFingerprint)[] = [\n      \"decisions\", \"premises\", \"alternatives\", \"guards\", \"contradictions\", \"justifications\",\n    ];\n\n    for (const field of fields) {\n      const a = first.fingerprint[field];\n      const b = run.fingerprint[field];\n      if (typeof a === \"number\" && typeof b === \"number\" && a !== b) {\n        out.push(field + \": run 1 had \" + a + \", run \" + run.n + \" had \" + b);\n      }\n    }\n\n    if (first.fingerprint.labels.join(\"|\") !== run.fingerprint.labels.join(\"|\")) {\n      const differing = run.fingerprint.labels.filter((entry) => !first.fingerprint.labels.includes(entry));\n      out.push(\n        \"LABELS DIVERGED between run 1 and run \" + run.n + \" ΓÇö the same input produced different \" +\n        \"epistemic states. Counts alone would not have caught this. Differing: \" +\n        (differing.length === 0 ? \"(reordered only)\" : differing.slice(0, 6).join(\", \")),\n      );\n    }\n\n    if (first.fingerprint.decisionIds.join(\"|\") !== run.fingerprint.decisionIds.join(\"|\")) {\n      out.push(\"IDS DIVERGED between run 1 and run \" + run.n + \" ΓÇö a counter depends on something other than the input.\");\n    }\n  }\n\n  return out;\n}\n\nexport function renderDryRuns(report: DryRunReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"DRY RUNS ΓÇö \" + report.runs.length + \" consecutive, no reset between them\");\n  lines.push(report.passed ? \"PASSED: deterministic and demoable across all runs.\" : \"NOT PASSED.\");\n  lines.push(\"\");\n\n  lines.push(\"Run\".padEnd(5) + \"dec\".padStart(5) + \"prem\".padStart(6) + \"alt\".padStart(5) +\n    \"grd\".padStart(5) + \"contra\".padStart(8) + \"just\".padStart(6) + \"  verified/manual/failed\".padEnd(26) + \"secs\");\n  lines.push(\"-\".repeat(78));\n\n  for (const run of report.runs) {\n    const f = run.fingerprint;\n    const v = run.verification;\n    if (v === null) {\n      lines.push(String(run.n).padEnd(5) + \"  THREW ΓÇö \" + (run.error ?? \"unknown\"));\n      continue;\n    }\n    lines.push(\n      String(run.n).padEnd(5) +\n      String(f.decisions).padStart(5) + String(f.premises).padStart(6) + String(f.alternatives).padStart(5) +\n      String(f.guards).padStart(5) + String(f.contradictions).padStart(8) + String(f.justifications).padStart(6) +\n      (\"  \" + v.verified + \"/\" + v.manual + \"/\" + v.failed).padEnd(26) +\n      (f.durationMs / 1000).toFixed(1),\n    );\n  }\n\n  lines.push(\"\");\n  lines.push(\"Timings are shown but NOT compared: they vary with machine load, and treating a slow run as\");\n  lines.push(\"non-determinism teaches the presenter to ignore this report.\");\n\n  if (report.divergences.length > 0) {\n    lines.push(\"\");\n    lines.push(\"DIVERGENCES (\" + report.divergences.length + \"):\");\n    for (const divergence of report.divergences) lines.push(\"  \" + divergence);\n  } else {\n    lines.push(\"\");\n    lines.push(\"No divergences. Runs 2 and 3 started from whatever run 1 left in storage and produced\");\n    lines.push(\"identical node counts, identical labels and identical ids.\");\n  }\n\n  const warnings = report.runs.flatMap((run) => run.warnings.map((warning) => \"run \" + run.n + \": \" + warning));\n  if (warnings.length > 0) {\n    lines.push(\"\");\n    lines.push(\"WARNINGS:\");\n    for (const warning of [...new Set(warnings)]) lines.push(\"  \" + warning);\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 8 ΓÇö false-positive rate per 100 decisions.\n *    unexpectedContradictions += 1;\n    if (examples.length < 8) {\n      examples.push(\n        `${record.gate + \"}\" + ${record.verdict ┬╖ record.decisionA +\n          (}${record.decisionB === undefined ? \"\" : \" vs \" + record.decisionB) +\n          \"record.explanation.slice(0, 90)}`,\n      );\n    }  };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,61]}}},{"equalLines":{"line_count":89}},{"diffOp":{"equal":{"range":[61,147]}}},{"diffOp":{"equal":{"range":[147,156]}}},{"diffOp":{"insert":{"range":[156,159]}}},{"diffOp":{"equal":{"range":[159,170]}}},{"diffOp":{"delete":{"range":[170,174]}}},{"diffOp":{"insert":{"range":[174,175]}}},{"diffOp":{"equal":{"range":[0,1]}}},{"diffOp":{"delete":{"range":[175,179]}}},{"diffOp":{"insert":{"range":[179,181]}}},{"diffOp":{"equal":{"range":[181,195]}}},{"diffOp":{"delete":{"range":[170,174]}}},{"diffOp":{"insert":{"range":[174,175]}}},{"diffOp":{"equal":{"range":[195,199]}}},{"diffOp":{"delete":{"range":[175,179]}}},{"diffOp":{"insert":{"range":[179,181]}}},{"diffOp":{"equal":{"range":[199,215]}}},{"diffOp":{"delete":{"range":[215,229]}}},{"diffOp":{"insert":{"range":[229,232]}}},{"diffOp":{"equal":{"range":[232,295]}}},{"diffOp":{"delete":{"range":[295,310]}}},{"diffOp":{"insert":{"range":[174,175]}}},{"diffOp":{"equal":{"range":[195,199]}}},{"diffOp":{"delete":{"range":[175,179]}}},{"diffOp":{"insert":{"range":[179,181]}}},{"diffOp":{"equal":{"range":[310,341]}}},{"diffOp":{"insert":{"range":[341,343]}}},{"diffOp":{"equal":{"range":[343,359]}}},{"equalLines":{"line_count":52}},{"diffOp":{"equal":{"range":[359,366]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\false-positive.ts"},"span":[4478,4671],"sourceCode":"/**\n * Metric 8 ΓÇö false-positive rate per 100 decisions.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: ARGUS's FP:FN ratio of 13:1 (155 false positives against 12 false negatives).\n *\n * ---------------------------------------------------------------------------\n * THE METRIC THAT DECIDES WHETHER ANYBODY KEEPS THE TOOL INSTALLED\n *\n * A contradiction panel that is wrong once a day gets closed and never reopened. docs/03 ┬º8 and\n * docs/02 ┬º7 both list false positives as the failure mode that ends the product, and ARGUS's 13:1\n * ratio is the published evidence that this is not a hypothetical concern: the state of the art in\n * rationale mining produces fifteen wrong answers for every one it misses.\n *\n * Recall can always be bought with false positives. This metric is the price of the recall reported\n * everywhere else in the table, and it is why the table must never be read one row at a time.\n *\n * ---------------------------------------------------------------------------\n * THE DENOMINATOR IS DECISIONS, NOT QUERIES\n *\n * \"Per 100 decisions\" is a rate over the size of the graph, which is the quantity a user experiences:\n * a project with 400 decisions and a rate of 5 per 100 produces twenty interruptions, and twenty is\n * what determines whether the panel stays open. A rate over queries would measure something the user\n * never sees, because they do not query the graph twenty times a day ΓÇö they are interrupted by it.\n *\n * ---------------------------------------------------------------------------\n * WHAT COUNTS AS A FALSE POSITIVE\n *\n * A contradiction record is a false positive when no plant expects it AND its verdict is one the user\n * would experience as an interruption ΓÇö `contradiction` or `reversal`. `refinement` is excluded,\n * because the substrate treats refinement as the overwhelmingly common relationship between related\n * decisions and surfacing it as a conflict is precisely what docs/03 says gets a tool switched off\n * within a day; counting it here would measure the classifier's restraint rather than its errors.\n *\n * Label changes are counted too. A decision that flipped to OUT without any plant expecting it is an\n * interruption of exactly the same kind, and counting only contradiction records would let a system\n * achieve a perfect score by silently retracting decisions instead of reporting conflicts.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface FalsePositiveOutcome {\n  readonly metric: MetricResult;\n  readonly ratePer100: number;\n  readonly decisions: number;\n  readonly unexpectedContradictions: number;\n  readonly unexpectedRetractions: number;\n  readonly refinementVerdicts: number;\n  readonly examples: readonly string[];\n}\n\n/** Verdicts a user experiences as an interruption. `refinement` is deliberately absent. */\nconst INTERRUPTING = new Set([\"contradiction\", \"reversal\"]);\n\nexport function scoreFalsePositives(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): FalsePositiveOutcome {\n  /* Every decision the plants say should be flagged, by key. Anything outside this set is unexpected. */\n  const expected = new Set<string>();\n  for (const plant of corpus.plants) {\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id !== null) expected.add(id);\n    }\n  }\n\n  let unexpectedContradictions = 0;\n  let refinementVerdicts = 0;\n  const examples: string[] = [];\n\n  for (const record of run.state.contradictions) {\n    if (record.verdict === \"refinement\") {\n      refinementVerdicts += 1;\n      continue;\n    }\n    if (!INTERRUPTING.has(record.verdict)) continue;\n\n    /* A record is expected when EITHER side is a node some plant expected to become unsound. Requiring\n     * both would count a genuine detection as a false positive whenever the corpus only labelled one\n     * side of the pair. */\n    const aExpected = expected.has(record.decisionA);\n    const bExpected = record.decisionB !== undefined && expected.has(record.decisionB);\n    if (aExpected || bExpected) continue;\n\n    unexpectedContradictions += 1;\n    if (examples.length < 8) {\n      examples.push(\n        record.gate + \"/\" + record.verdict + \" ┬╖ \" + record.decisionA +\n          (record.decisionB === undefined ? \"\" : \" vs \" + record.decisionB) +\n          \" ┬╖ \" + record.explanation.slice(0, 90),\n      );\n    }\n  }\n\n  let unexpectedRetractions = 0;\n  for (const decision of run.state.decisions.values()) {\n    if (decision.label !== \"OUT\" && decision.label !== \"UNFOUNDED\") continue;\n    if (expected.has(decision.id)) continue;\n\n    unexpectedRetractions += 1;\n    if (examples.length < 8) {\n      examples.push(\"retraction ┬╖ \" + decision.id + \" (\" + decision.variable + \"=\" + decision.value + \") -> \" + decision.label);\n    }\n  }\n\n  const decisions = run.state.decisions.size;\n  const total = unexpectedContradictions + unexpectedRetractions;\n  const ratePer100 = decisions === 0 ? 0 : (total / decisions) * 100;\n\n  return {\n    ratePer100,\n    decisions,\n    unexpectedContradictions,\n    unexpectedRetractions,\n    refinementVerdicts,\n    examples,\n    metric: {\n      id: \"false-positive-rate\",\n      name: METRIC_NAMES[\"false-positive-rate\"],\n      /* Lower is better, which is the opposite of every other metric in the table. The report sorts by\n       * this one ascending and says so; a table where one row's good direction is inverted and nothing\n       * marks it is a table that will be misread. */\n      value: ratePer100,\n      detail: null,\n      n: decisions,\n      perEngine: [{ engine: describeEngineId(engine), value: ratePer100, n: decisions, detail: null }],\n      comparator: COMPARATORS[\"false-positive-rate\"] ?? {\n        source: \"ARGUS (arXiv:2604.10345)\",\n        value: \"FP:FN 13:1 ΓÇö 155 false positives against 12 false negatives on alternatives\",\n      },\n      gloss:\n        ratePer100.toFixed(1) + \" unexpected interruption(s) per 100 decisions (\" + unexpectedContradictions +\n        \" contradiction(s) and \" + unexpectedRetractions + \" unexplained retraction(s) over \" + decisions +\n        \" decisions). \" + refinementVerdicts + \" refinement verdict(s) were correctly NOT surfaced as conflicts.\",\n      honestNote:\n        \"LOWER IS BETTER ΓÇö the only metric in the table whose good direction is inverted. The denominator is decisions in \" +\n        \"the graph, not queries, because that is the quantity a user experiences: they are interrupted by the tool rather \" +\n        \"than polling it. 'Unexpected' means no plant labelled it, so a detection that is CORRECT but unlabelled counts \" +\n        \"against the system ΓÇö this metric is biased pessimistic by construction, and on a corpus of \" + decisions +\n        \" decisions a single unlabelled true positive moves the rate by several points. ARGUS's 13:1 is a ratio over \" +\n        \"alternatives in a different corpus and is cited as the nearest published statement of the same failure, not as a \" +\n        \"like-for-like rate. Refinement verdicts are excluded on purpose: surfacing them is what docs/03 says gets a tool \" +\n        \"switched off, so counting them would measure restraint rather than error.\",\n    },\n  };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 8 ΓÇö false-positive rate per 100 decisions.\n *      examples.push(\n        record.gate + \"/\" + record.verdict + \" ┬╖ \" + record.decisionA +\n          (record.decisionB === undefined ? \"\" : \"` vs \" + ${record.decisionB}`) +\n          \" ┬╖ \" + record.explanation.slice(0, 90),\n      );  };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,61]}}},{"equalLines":{"line_count":91}},{"diffOp":{"equal":{"range":[61,204]}}},{"diffOp":{"delete":{"range":[204,205]}}},{"diffOp":{"insert":{"range":[205,206]}}},{"diffOp":{"equal":{"range":[206,210]}}},{"diffOp":{"delete":{"range":[210,214]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[216,232]}}},{"diffOp":{"insert":{"range":[232,234]}}},{"diffOp":{"equal":{"range":[234,298]}}},{"equalLines":{"line_count":53}},{"diffOp":{"equal":{"range":[298,305]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\false-positive.ts"},"span":[4592,4617],"sourceCode":"/**\n * Metric 8 ΓÇö false-positive rate per 100 decisions.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: ARGUS's FP:FN ratio of 13:1 (155 false positives against 12 false negatives).\n *\n * ---------------------------------------------------------------------------\n * THE METRIC THAT DECIDES WHETHER ANYBODY KEEPS THE TOOL INSTALLED\n *\n * A contradiction panel that is wrong once a day gets closed and never reopened. docs/03 ┬º8 and\n * docs/02 ┬º7 both list false positives as the failure mode that ends the product, and ARGUS's 13:1\n * ratio is the published evidence that this is not a hypothetical concern: the state of the art in\n * rationale mining produces fifteen wrong answers for every one it misses.\n *\n * Recall can always be bought with false positives. This metric is the price of the recall reported\n * everywhere else in the table, and it is why the table must never be read one row at a time.\n *\n * ---------------------------------------------------------------------------\n * THE DENOMINATOR IS DECISIONS, NOT QUERIES\n *\n * \"Per 100 decisions\" is a rate over the size of the graph, which is the quantity a user experiences:\n * a project with 400 decisions and a rate of 5 per 100 produces twenty interruptions, and twenty is\n * what determines whether the panel stays open. A rate over queries would measure something the user\n * never sees, because they do not query the graph twenty times a day ΓÇö they are interrupted by it.\n *\n * ---------------------------------------------------------------------------\n * WHAT COUNTS AS A FALSE POSITIVE\n *\n * A contradiction record is a false positive when no plant expects it AND its verdict is one the user\n * would experience as an interruption ΓÇö `contradiction` or `reversal`. `refinement` is excluded,\n * because the substrate treats refinement as the overwhelmingly common relationship between related\n * decisions and surfacing it as a conflict is precisely what docs/03 says gets a tool switched off\n * within a day; counting it here would measure the classifier's restraint rather than its errors.\n *\n * Label changes are counted too. A decision that flipped to OUT without any plant expecting it is an\n * interruption of exactly the same kind, and counting only contradiction records would let a system\n * achieve a perfect score by silently retracting decisions instead of reporting conflicts.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId } from \"@/types/common\";\nimport type { ResolvedCorpus } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, type MetricResult } from \"./types\";\n\nexport interface FalsePositiveOutcome {\n  readonly metric: MetricResult;\n  readonly ratePer100: number;\n  readonly decisions: number;\n  readonly unexpectedContradictions: number;\n  readonly unexpectedRetractions: number;\n  readonly refinementVerdicts: number;\n  readonly examples: readonly string[];\n}\n\n/** Verdicts a user experiences as an interruption. `refinement` is deliberately absent. */\nconst INTERRUPTING = new Set([\"contradiction\", \"reversal\"]);\n\nexport function scoreFalsePositives(\n  corpus: ResolvedCorpus,\n  run: RunResult,\n  resolver: Resolver,\n  engine: EngineId,\n): FalsePositiveOutcome {\n  /* Every decision the plants say should be flagged, by key. Anything outside this set is unexpected. */\n  const expected = new Set<string>();\n  for (const plant of corpus.plants) {\n    for (const key of plant.expectUnsound) {\n      const id = resolver.decision(key);\n      if (id !== null) expected.add(id);\n    }\n  }\n\n  let unexpectedContradictions = 0;\n  let refinementVerdicts = 0;\n  const examples: string[] = [];\n\n  for (const record of run.state.contradictions) {\n    if (record.verdict === \"refinement\") {\n      refinementVerdicts += 1;\n      continue;\n    }\n    if (!INTERRUPTING.has(record.verdict)) continue;\n\n    /* A record is expected when EITHER side is a node some plant expected to become unsound. Requiring\n     * both would count a genuine detection as a false positive whenever the corpus only labelled one\n     * side of the pair. */\n    const aExpected = expected.has(record.decisionA);\n    const bExpected = record.decisionB !== undefined && expected.has(record.decisionB);\n    if (aExpected || bExpected) continue;\n\n    unexpectedContradictions += 1;\n    if (examples.length < 8) {\n      examples.push(\n        record.gate + \"/\" + record.verdict + \" ┬╖ \" + record.decisionA +\n          (record.decisionB === undefined ? \"\" : \" vs \" + record.decisionB) +\n          \" ┬╖ \" + record.explanation.slice(0, 90),\n      );\n    }\n  }\n\n  let unexpectedRetractions = 0;\n  for (const decision of run.state.decisions.values()) {\n    if (decision.label !== \"OUT\" && decision.label !== \"UNFOUNDED\") continue;\n    if (expected.has(decision.id)) continue;\n\n    unexpectedRetractions += 1;\n    if (examples.length < 8) {\n      examples.push(\"retraction ┬╖ \" + decision.id + \" (\" + decision.variable + \"=\" + decision.value + \") -> \" + decision.label);\n    }\n  }\n\n  const decisions = run.state.decisions.size;\n  const total = unexpectedContradictions + unexpectedRetractions;\n  const ratePer100 = decisions === 0 ? 0 : (total / decisions) * 100;\n\n  return {\n    ratePer100,\n    decisions,\n    unexpectedContradictions,\n    unexpectedRetractions,\n    refinementVerdicts,\n    examples,\n    metric: {\n      id: \"false-positive-rate\",\n      name: METRIC_NAMES[\"false-positive-rate\"],\n      /* Lower is better, which is the opposite of every other metric in the table. The report sorts by\n       * this one ascending and says so; a table where one row's good direction is inverted and nothing\n       * marks it is a table that will be misread. */\n      value: ratePer100,\n      detail: null,\n      n: decisions,\n      perEngine: [{ engine: describeEngineId(engine), value: ratePer100, n: decisions, detail: null }],\n      comparator: COMPARATORS[\"false-positive-rate\"] ?? {\n        source: \"ARGUS (arXiv:2604.10345)\",\n        value: \"FP:FN 13:1 ΓÇö 155 false positives against 12 false negatives on alternatives\",\n      },\n      gloss:\n        ratePer100.toFixed(1) + \" unexpected interruption(s) per 100 decisions (\" + unexpectedContradictions +\n        \" contradiction(s) and \" + unexpectedRetractions + \" unexplained retraction(s) over \" + decisions +\n        \" decisions). \" + refinementVerdicts + \" refinement verdict(s) were correctly NOT surfaced as conflicts.\",\n      honestNote:\n        \"LOWER IS BETTER ΓÇö the only metric in the table whose good direction is inverted. The denominator is decisions in \" +\n        \"the graph, not queries, because that is the quantity a user experiences: they are interrupted by the tool rather \" +\n        \"than polling it. 'Unexpected' means no plant labelled it, so a detection that is CORRECT but unlabelled counts \" +\n        \"against the system ΓÇö this metric is biased pessimistic by construction, and on a corpus of \" + decisions +\n        \" decisions a single unlabelled true positive moves the rate by several points. ARGUS's 13:1 is a ratio over \" +\n        \"alternatives in a different corpus and is cited as the nearest published statement of the same failure, not as a \" +\n        \"like-for-like rate. Refinement verdicts are excluded on purpose: surfacing them is what docs/03 says gets a tool \" +\n        \"switched off, so counting them would measure restraint rather than error.\",\n    },\n  };\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 8 ΓÇö false-positive rate per 100 decisions.\n *    unexpectedRetractions += 1;\n    if (examples.length < 8) {\n      examples.push(\"`retraction ┬╖ \" +${decision.id +}\" (\" + decision.variable + \"=decision.value) -> decision.label}`);\n    }\n  }  };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,61]}}},{"equalLines":{"line_count":104}},{"diffOp":{"equal":{"range":[61,144]}}},{"diffOp":{"delete":{"range":[144,145]}}},{"diffOp":{"insert":{"range":[145,146]}}},{"diffOp":{"equal":{"range":[146,159]}}},{"diffOp":{"delete":{"range":[159,163]}}},{"diffOp":{"equal":{"range":[159,160]}}},{"diffOp":{"insert":{"range":[163,165]}}},{"diffOp":{"equal":{"range":[165,176]}}},{"diffOp":{"delete":{"range":[176,178]}}},{"diffOp":{"insert":{"range":[178,179]}}},{"diffOp":{"equal":{"range":[176,177]}}},{"diffOp":{"delete":{"range":[179,181]}}},{"diffOp":{"equal":{"range":[181,182]}}},{"diffOp":{"delete":{"range":[182,186]}}},{"diffOp