    expect([...second.nodes.values()].map((n) => [n.id, n.x, n.y])).toEqual(\n      [...first.nodes.values()].map((n) => [n.id, n.x, n.y]),\n    );\n    expect(second.edges).toEqual(first.edges);\n  });\n\n  it(\"puts premises in a column per type, and decisions below them\", async () => {\n    const { layout } = await lattice();\n\n    // Every premise of a type shares that type's column x.\n    const columnX = new Map<string, number>();\n    for (const node of layout.nodes.values()) {\n      if (node.kind !== \"premise\" || node.column === null) continue;\n      const seen = columnX.get(node.column);\n      if (seen === undefined) columnX.set(node.column, node.x);\n      else expect(node.x).toBe(seen);\n    }\n    expect(columnX.size).toBeGreaterThan(0);\n\n    // The columns are laid out left to right, COLUMN_WIDTH apart.\n    const xs = [...columnX.values()].sort((a, b) => a - b);\n    for (let i = 1; i < xs.length; i += 1) {\n      expect(xs[i]! - xs[i - 1]!).toBe(COLUMN_WIDTH);\n    }\n\n    // Decisions sit BELOW the premise band, never interleaved with the premises.\n    const premises = [...layout.nodes.values()].filter((n) => n.kind === \"premise\");\n    const decisions = [...layout.nodes.values()].filter((n) => n.kind === \"decision\");\n    const lowestPremise = Math.max(...premises.map((n) => n.y));\n    const highestDecision = Math.min(...decisions.map((n) => n.y));\n    expect(highestDecision).toBeGreaterThan(lowestPremise);\n  });\n\n  it(\"no two nodes overlap\", async () => {\n    const { layout } = await lattice();\n    const nodes = [...layout.nodes.values()];\n\n    for (let i = 0; i < nodes.length; i += 1) {\n      for (let j = i + 1; j < nodes.length; j += 1) {\n        const a = nodes[i]!;\n        const b = nodes[j]!;\n        const sameX = a.x === b.x;\n        const sameY = a.y === b.y;\n        expect(sameX && sameY).toBe(false);\n      }\n    }\n  });\n\n  it(\"reports a hairball rather than silently dropping edges to hit a number\", async () => {\n    const { layout } = await lattice();\n    const report = reportHairball(layout, false);\n\n    /* The report is derived from the layout, and it says what was WITHHELD rather than\n     * hiding it: \"nothing was dropped, the picture is just dense\" is a different statement\n     * from \"we dropped 12 edges to make it fit\", and only the first is honest. */\n    expect(report.collapsedPremises).toBe(layout.collapsedPremiseCount);\n    expect(report.hiddenSuperseded).toBe(layout.droppedDecisionCount);\n    expect(report.nodeCount).toBe(layout.nodes.size);\n    expect(report.edgeCount).toBe(layout.edges.length);\n    expect(report.tooDense).toBe(layout.edges.length > DENSITY_LIMIT);\n\n    /* Nothing is hidden by the density limit itself - it is a prompt to focus, not a\n     * filter. A diagram that silently drops edges to hit a number makes the diagram lie. */\n    expect(report.edgeCount).toBe(layout.edges.length);\n  });\n});\n"},"tags":[],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\graph\\lattice-layout.test.ts"},"span":[4844,4853],"sourceCode":"/**\n * The premise lattice ΓÇö 6.6.\n *\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * \"The differentiating visual is not another chat UI and not another decision timeline. It is\n * the premise lattice ΓÇö a bipartite graph where assumptions are the load-bearing nodes and\n * decisions hang off them.\"\n *\n * The lattice is the one piece of Phase 6 that is pure geometry, so it is also the one piece\n * that can be tested exactly rather than eyeballed. Four properties matter, and each one is\n * a promise the plan makes:\n *\n *   1. BIPARTITE. Premises on one side, decisions on the other. The edges run from a premise\n *      to the decisions that rest on it.\n *   2. DETERMINISTIC. No force simulation. Two renderings of the same log must place the same\n *      node at the same pixel, or the lattice is decoration rather than evidence: a cascade\n *      animation would move the node you are watching, and \"the lattice at time T\" would not\n *      look like the lattice you remember.\n *   3. COLUMNS BY PREMISE TYPE. Premises sit in a column per type, so two premises of the\n *      same kind line up and the eye can compare them.\n *   4. ANTI-HAIRBALL. A premise that 40 decisions rest on must not draw 40 edges into the\n *      space of one node; the layout reports what it withheld instead of silently dropping it.\n */\n\nimport { describe, expect, it } from \"vitest\";\n\nimport { DENSITY_LIMIT, reportHairball } from \"@/components/graph/AntiHairballFilter\";\nimport {\n  COLUMN_WIDTH,\n  type LatticeLayout,\n  type LatticeNode,\n  layoutLattice,\n} from \"@/components/graph/LatticeLayout\";\nimport { label } from \"@/reasoning/labeller\";\nimport { buildDemoLog } from \"../../helpers/demo-log\";\n\nasync function lattice(): Promise<{ layout: LatticeLayout; node: (id: string) => LatticeNode }> {\n  const state = await buildDemoLog(\"curated\");\n  const labels = label(state).labels;\n  const built = layoutLattice(state, labels);\n  return { layout: built, node: (id) => built.nodes.get(id as never) as LatticeNode };\n}\n\ndescribe(\"The premise lattice\", () => {\n  it(\"is bipartite: premises on one side, decisions on the other, edges from premise to decision\", async () => {\n    const { layout } = await lattice();\n\n    const premises = [...layout.nodes.values()].filter((n) => n.kind === \"premise\");\n    const decisions = [...layout.nodes.values()].filter((n) => n.kind === \"decision\");\n    expect(premises.length).toBeGreaterThan(0);\n    expect(decisions.length).toBeGreaterThan(0);\n\n    // Every edge runs FROM a premise TO a decision. If one ran the other way the picture\n    // would stop being \"assumptions with decisions hanging off them\".\n    for (const edge of layout.edges) {\n      const from = layout.nodes.get(edge.from);\n      const to = layout.nodes.get(edge.to);\n      expect(from?.kind).toBe(\"premise\");\n      expect(to?.kind).toBe(\"decision\");\n    }\n  });\n\n  it(\"is deterministic: the same log lays out to the same pixels\", async () => {\n    const state = await buildDemoLog(\"curated\");\n    const labels = label(state).labels;\n\n    const first = layoutLattice(state, labels);\n    const second = layoutLattice(state, labels);\n\n    expect([...second.nodes.values()].map((n) => [n.id, n.x, n.y])).toEqual(\n      [...first.nodes.values()].map((n) => [n.id, n.x, n.y]),\n    );\n    expect(second.edges).toEqual(first.edges);\n  });\n\n  it(\"puts premises in a column per type, and decisions below them\", async () => {\n    const { layout } = await lattice();\n\n    // Every premise of a type shares that type's column x.\n    const columnX = new Map<string, number>();\n    for (const node of layout.nodes.values()) {\n      if (node.kind !== \"premise\" || node.column === null) continue;\n      const seen = columnX.get(node.column);\n      if (seen === undefined) columnX.set(node.column, node.x);\n      else expect(node.x).toBe(seen);\n    }\n    expect(columnX.size).toBeGreaterThan(0);\n\n    // The columns are laid out left to right, COLUMN_WIDTH apart.\n    const xs = [...columnX.values()].sort((a, b) => a - b);\n    for (let i = 1; i < xs.length; i += 1) {\n      expect(xs[i]! - xs[i - 1]!).toBe(COLUMN_WIDTH);\n    }\n\n    // Decisions sit BELOW the premise band, never interleaved with the premises.\n    const premises = [...layout.nodes.values()].filter((n) => n.kind === \"premise\");\n    const decisions = [...layout.nodes.values()].filter((n) => n.kind === \"decision\");\n    const lowestPremise = Math.max(...premises.map((n) => n.y));\n    const highestDecision = Math.min(...decisions.map((n) => n.y));\n    expect(highestDecision).toBeGreaterThan(lowestPremise);\n  });\n\n  it(\"no two nodes overlap\", async () => {\n    const { layout } = await lattice();\n    const nodes = [...layout.nodes.values()];\n\n    for (let i = 0; i < nodes.length; i += 1) {\n      for (let j = i + 1; j < nodes.length; j += 1) {\n        const a = nodes[i]!;\n        const b = nodes[j]!;\n        const sameX = a.x === b.x;\n        const sameY = a.y === b.y;\n        expect(sameX && sameY).toBe(false);\n      }\n    }\n  });\n\n  it(\"reports a hairball rather than silently dropping edges to hit a number\", async () => {\n    const { layout } = await lattice();\n    const report = reportHairball(layout, false);\n\n    /* The report is derived from the layout, and it says what was WITHHELD rather than\n     * hiding it: \"nothing was dropped, the picture is just dense\" is a different statement\n     * from \"we dropped 12 edges to make it fit\", and only the first is honest. */\n    expect(report.collapsedPremises).toBe(layout.collapsedPremiseCount);\n    expect(report.hiddenSuperseded).toBe(layout.droppedDecisionCount);\n    expect(report.nodeCount).toBe(layout.nodes.size);\n    expect(report.edgeCount).toBe(layout.edges.length);\n    expect(report.tooDense).toBe(layout.edges.length > DENSITY_LIMIT);\n\n    /* Nothing is hidden by the density limit itself - it is a prompt to focus, not a\n     * filter. A diagram that silently drops edges to hit a number makes the diagram lie. */\n    expect(report.edgeCount).toBe(layout.edges.length);\n  });\n});\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 28 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 28 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 28 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\emitters\\decisions-md.ts"},"span":[5863,5872],"sourceCode":"/**\n * DECISIONS.md ΓÇö 5.2. The human target.\n *\n * Phase 5 ┬╖ sub-phase 5.2\n * Plan: plan/phase-5-export-compiler.md ┬º5.2\n *\n * ---------------------------------------------------------------------------\n * FULL ADR FORM, AND THE ONLY TARGET THAT CARRIES HISTORY\n *\n * Context ┬╖ Decision ┬╖ Consequences ┬╖ Alternatives ┬╖ Related. Plus superseded and OUT decisions,\n * which the agent files exclude by default.\n *\n * That exclusion is correct for agents and wrong for humans. An agent following rules needs the\n * current set and nothing else ΓÇö a reversed rule next to its replacement is the \"model may pick\n * one arbitrarily\" failure. A human reading history needs the reversals, because \"we tried\n * Postgres and moved back\" is the single most useful sentence in a decision log, and it exists\n * only in the superseded records.\n *\n * So the compiler builds TWO CIFs: one with exclusions and a budget for the agent files, one\n * without either for this. Both come from the same graph in the same pass, which keeps the\n * single-pass guarantee ΓÇö there is still exactly one read of the graph, and still no emitter that\n * reads it.\n *\n * ---------------------------------------------------------------------------\n * THE NARRATIVE IS PASSED IN, NOT FETCHED\n *\n * `DecisionNarrative` carries what an ADR needs and the agent record does not: the Y-statement,\n * the accepted downside, what this supersedes, what shares its premises. The compiler builds the\n * map once from the graph; this emitter is a pure function of (CIF, narratives).\n *\n * Letting this file read the graph directly would be convenient and would break the one property\n * that keeps five formats from drifting: that there is a single place a decision becomes a record.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId } from \"@/types/common\";\nimport type { ExportCif, ExportRecord } from \"@/types/export\";\nimport { renderStatus } from \"../record\";\n\n/** What an ADR needs beyond the agent record. Built by the compiler, consumed here. */\nexport interface DecisionNarrative {\n  readonly yStatement?: string;\n  readonly rationale?: string;\n  readonly acceptedDownside?: string;\n  readonly supersedes: readonly DecisionId[];\n  readonly supersededBy: readonly DecisionId[];\n  readonly sharesPremiseWith: readonly DecisionId[];\n  readonly dependsOn: readonly DecisionId[];\n  readonly conflictsWith: readonly DecisionId[];\n  readonly variable: string;\n  readonly value: string;\n  readonly origin: string;\n  readonly confidence: number;\n  readonly decidedAt: string;\n  readonly entrenchment: number;\n  readonly status: string;\n}\n\nexport function emitDecisionsMd(\n  cif: ExportCif,\n  stampBlock: string,\n  narratives: ReadonlyMap<DecisionId, DecisionNarrative>,\n  projectName?: string,\n): string {\n  const name = projectName ?? \"this project\";\n  const sections: string[] = [];\n\n  sections.push(`# ${name} ΓÇö Decision log`);\n  sections.push(\"\");\n  sections.push(\n    \"Compiled from a WhyLog decision log. Every decision the log holds is here, including the \" +\n      \"superseded and unsupported ones ΓÇö unlike the agent files, which carry only what is \" +\n      \"currently in force. A reversal is the most useful sentence in a decision log, and it exists \" +\n      \"only in the records an agent should not see.\",\n  );\n  sections.push(\"\");\n  sections.push(\n    \"Each entry is a belief held under assumptions. The **Context** is the set of conditions that \" +\n      \"made it right; when one of them stops holding, the decision stops being justified, and that \" +\n      \"is a supersession rather than a mistake.\",\n  );\n  sections.push(\"\");\n\n  sections.push(\"## Summary\");\n  sections.push(\"\");\n  sections.push(\"| | |\");\n  sections.push(\"|---|---|\");\n  sections.push(`| Decisions rendered | ${cif.records.length} |`);\n  sections.push(\n    `| Inline / linked out | ${cif.stats.decisionsIncluded} / ${cif.stats.decisionsLinkedOut} |`,\n  );\n  sections.push(`| Excluded from the agent files | ${cif.stats.decisionsExcluded} |`);\n  sections.push(`| Compliance | ${Math.round(cif.stats.compliance * 100)}% |`);\n  sections.push(`| Verifiable coverage | ${Math.round(cif.stats.verifiableCoverage * 100)}% |`);\n  sections.push(`| Log head | \\`${cif.headHash}\\` |`);\n  sections.push(`| Generated | ${cif.generatedAt} |`);\n  sections.push(\"\");\n\n  if (cif.records.length === 0) sections.push(\"_The log holds no decisions._\");\n\n  for (const record of cif.records) {\n    sections.push(renderAdr(record, narratives.get(record.id)));\n    sections.push(\"\");\n  }\n\n  if (cif.rejected.length > 0) {\n    sections.push(\"## Rejected alternatives\");\n    sections.push(\"\");\n    sections.push(\n      \"Recorded so nobody re-litigates them by accident. Each carries the reason and the status of \" +\n        \"the premise that reason rests on ΓÇö a rejection whose premise has since been falsified is \" +\n        \"an invitation to revisit, not a rule to obey.\",\n    );\n    sections.push(\"\");\n    sections.push(\"| Alternative | Decision | Reason | Premise status |\");\n    sections.push(\"|---|---|---|---|\");\n\n    for (const entry of cif.rejected) {\n      sections.push(\n        `| **${entry.value}** | ${entry.decisionId} | ${entry.why} | ${entry.premiseStatus}${entry.contested ? \" ! **UNDER REVIEW**\" : \"\"} |`,\n      );\n    }\n    sections.push(\"\");\n  }\n\n  if (cif.index.length > 0) {\n    sections.push(\"## Linked out of the agent files\");\n    sections.push(\"\");\n    sections.push(\n      \"These are in force but did not fit the agent files' token budget, so they appear there as \" +\n        \"one-line index entries pointing here.\",\n    );\n    sections.push(\"\");\n    for (const entry of cif.index) {\n      sections.push(`- ${entry.id} ┬╖ ${entry.imperative}`);\n    }\n    sections.push(\"\");\n  }\n\n  sections.push(stampBlock);\n\n  return sections.join(\"\\n\");\n}\n\nfunction renderAdr(record: ExportRecord, narrative: DecisionNarrative | undefined): string {\n  const lines: string[] = [];\n\n  lines.push(\"---\");\n  lines.push(\"\");\n  lines.push(`## ${record.id} ΓÇö ${narrative?.yStatement ?? record.imperative}`);\n  lines.push(\"\");\n\n  lines.push(renderStatus(record));\n  if (narrative !== undefined) {\n    lines.push(\n      `Lifecycle: ${narrative.status} ┬╖ Variable: ${narrative.variable} = ${narrative.value} ┬╖ Origin: ${narrative.origin} (confidence ${narrative.confidence.toFixed(2)}) ┬╖ Entrenchment ${narrative.entrenchment.toFixed(2)} ┬╖ Decided ${narrative.decidedAt.slice(0, 10)}`,\n    );\n  }\n  lines.push(\"\");\n\n  /* ---- context ---- */\n  lines.push(\"### Context\");\n  lines.push(\"\");\n  if (record.becauseText.length > 0) {\n    lines.push(\"Held under these assumptions:\");\n    lines.push(\"\");\n    for (const premiseId of record.becausePremiseIds) {\n      lines.push(`- \\`${premiseId}\\` ΓÇö ${premiseTextFor(record, premiseId)}`);\n    }\n    lines.push(\"\");\n    lines.push(\n      \"If any of these stops being true, this decision stops being justified. That is not a \" +\n        \"violation of the decision; it is the condition for revisiting it.\",\n    );\n    if (record.contestedPremise) {\n      lines.push(\"\");\n      lines.push(\n        \"**At least one of these premises is contested** ΓÇö neither confirmed nor refuted.\",\n      );\n    }\n  } else {\n    lines.push(\n      \"**No premises recorded.** This decision was captured without the conditions that made it \" +\n        \"right, so nothing can falsify it and nothing would tell you when to stop following it. \" +\n        \"That is a gap in the log worth filling.\",\n    );\n  }\n  lines.push(\"\");\n\n  /* ---- decision ---- */\n  lines.push(\"### Decision\");\n  lines.push(\"\");\n  lines.push(record.imperative);\n  if (narrative?.rationale !== undefined && narrative.rationale.length > 0) {\n    lines.push(\"\");\n    lines.push(`Rationale: ${narrative.rationale}`);\n  }\n  if (record.appliesTo.length > 0) {\n    lines.push(\"\");\n    lines.push(`Applies to: ${record.appliesTo.map((glob) => `\\`${glob}\\``).join(\", \")}`);\n  }\n  lines.push(\"\");\n\n  /* ---- consequences ---- */\n  lines.push(\"### Consequences\");\n  lines.push(\"\");\n  if (narrative?.acceptedDownside !== undefined && narrative.acceptedDownside.length > 0) {\n    lines.push(`Accepted downside: ${narrative.acceptedDownside}`);\n    lines.push(\"\");\n  }\n  if (record.verifyCommand !== undefined) {\n    lines.push(\"Verified by:\");\n    lines.push(\"\");\n    lines.push(\"```sh\");\n    lines.push(record.verifyCommand);\n    lines.push(\"```\");\n    lines.push(\"\");\n    lines.push(\n      `Guards ${record.guardsPassing}/${record.guardsTotal} passing${record.failingGuard ? \" ΓÇö **currently failing**\" : \"\"}${record.lastVerifiedAt !== undefined ? ` ┬╖ last verified ${record.lastVerifiedAt.slice(0, 10)}` : \"\"}.`,\n    );\n  } else {\n    lines.push(\n      \"**Unverifiable.** No guard could be compiled from this decision, so nothing checks whether \" +\n        \"it still holds. It is recorded because it is believed, not because it is enforced.\",\n    );\n  }\n  lines.push(\"\");\n\n  /* ---- alternatives ---- */\n  if (record.rejected.length > 0) {\n    lines.push(\"### Alternatives considered\");\n    lines.push(\"\");\n    for (const entry of record.rejected) {\n      lines.push(\n        `- **${entry.value}**${entry.why === undefined ? \" ΓÇö no reason recorded\" : ` ΓÇö ${entry.why}`}`,\n      );\n    }\n    lines.push(\"\");\n  }\n\n  /* ---- related ---- */\n  const related = relatedLines(narrative);\n  if (related.length > 0) {\n    lines.push(\"### Related\");\n    lines.push(\"\");\n    for (const line of related) lines.push(line);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction relatedLines(narrative: DecisionNarrative | undefined): readonly string[] {\n  if (narrative === undefined) return [];\n\n  const out: string[] = [];\n  if (narrative.supersedes.length > 0) out.push(`- Supersedes: ${narrative.supersedes.join(\", \")}`);\n  if (narrative.supersededBy.length > 0)\n    out.push(`- **Superseded by: ${narrative.supersededBy.join(\", \")}** ΓÇö this record is history`);\n  if (narrative.dependsOn.length > 0) out.push(`- Depends on: ${narrative.dependsOn.join(\", \")}`);\n  if (narrative.sharesPremiseWith.length > 0) {\n    out.push(\n      `- Shares a premise with: ${narrative.sharesPremiseWith.join(\", \")} ΓÇö falsifying that premise puts all of them in play at once`,\n    );\n  }\n  if (narrative.conflictsWith.length > 0)\n    out.push(`- Recorded conflict with: ${narrative.conflictsWith.join(\", \")}`);\n\n  return out;\n}\n\n/** `becauseText` is a joined string; the ADR wants one bullet per premise. The ids are on the\n *  record, so the text is split back out rather than re-read from the graph ΓÇö which would be the\n *  emitter reaching past the CIF. */\nfunction premiseTextFor(record: ExportRecord, premiseId: string): string {\n  const marker = ` (${premiseId})`;\n\n  for (const part of record.becauseText.split(\", \")) {\n    if (part.endsWith(marker)) return part.slice(0, part.length - marker.length);\n  }\n\n  return \"\";\n}\n"},"tags":[],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *  PremiseCandidate,\n} from \"@/ai/types\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISOlabel } from \"@/libreasoninglabeller\";\nimport reviseLabelled, type ReviseResultNodeId } from \"@/reasoning/\";\nimport { ReviseResult, revise } from \"@/reasoning/\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";import type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEventDecisionEventTypePremiseNewEventRejectedAlternative } from \"@/types/eventsdomain\";\nimport type {  NodeId }fromEventType,\"@/reasoning/labeller\";\nimport type{ Answer } from \"@/types/retrievalDecision, Premise, RejectedAlternativeGuardguardsGraphStateAnswersubstratetypesgraph-stateWhyLogEngine } fromAblationConfig,\"@/ai/types\";\nimport typeSweptParams{ Guard @.ablationguards\";\nimport { guardStatusMap } from toggles@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":35}},{"diffOp":{"equal":{"range":[53,101]}}},{"diffOp":{"insert":{"range":[101,149]}}},{"diffOp":{"equal":{"range":[149,260]}}},{"diffOp":{"insert":{"range":[260,365]}}},{"diffOp":{"equal":{"range":[365,469]}}},{"diffOp":{"delete":{"range":[469,489]}}},{"diffOp":{"insert":{"range":[489,494]}}},{"diffOp":{"equal":{"range":[494,505]}}},{"diffOp":{"delete":{"range":[505,