{"insert":{"range":[682,691]}}},{"diffOp":{"equal":{"range":[1536,1548]}}},{"diffOp":{"delete":{"range":[180,181]}}},{"diffOp":{"insert":{"range":[682,691]}}},{"diffOp":{"equal":{"range":[1548,1763]}}},{"diffOp":{"delete":{"range":[180,181]}}},{"diffOp":{"insert":{"range":[682,691]}}},{"diffOp":{"equal":{"range":[1052,1067]}}},{"diffOp":{"delete":{"range":[180,181]}}},{"diffOp":{"insert":{"range":[682,691]}}},{"diffOp":{"equal":{"range":[1763,1946]}}},{"equalLines":{"line_count":3}},{"diffOp":{"equal":{"range":[1946,2172]}}},{"diffOp":{"insert":{"range":[1000,1003]}}},{"diffOp":{"equal":{"range":[2172,2207]}}},{"diffOp":{"delete":{"range":[776,777]}}},{"diffOp":{"insert":{"range":[1000,1003]}}},{"diffOp":{"equal":{"range":[2207,2232]}}},{"diffOp":{"insert":{"range":[259,261]}}},{"diffOp":{"equal":{"range":[2232,2344]}}},{"equalLines":{"line_count":21}},{"diffOp":{"equal":{"range":[2344,2372]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\premise.ts"},"span":null,"sourceCode":"/**\n * Metric 2 ΓÇö premise extraction precision / recall / F1.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: NONE PUBLISHED. That absence is the result.\n *\n * ---------------------------------------------------------------------------\n * WHY THIS METRIC HAS NO COMPARATOR, AND WHY THAT IS THE POINT\n *\n * No system surveyed in docs/05 or docs/06 extracts premises from dialogue. RecovAr recovers\n * rationale, ARGUS recovers alternatives, Kantara builds decision graphs from commits, agentmemory\n * stores turns. None of them represents \"this decision is true GIVEN these assumptions\" as first-class\n * nodes, so none of them can be measured on recovering them.\n *\n * A metric with no comparator cannot be spun. There is no prior number to beat, no framing in which\n * 0.4 recall is a win, and no baseline to blame. It is the one metric in this file where the only\n * available interpretation of the number is the true one ΓÇö which is precisely why ┬º7.2 requires it and\n * why the report leads with it rather than burying it after the metrics that do have comparators.\n *\n * ---------------------------------------------------------------------------\n * PREDICATE-FIRST, TYPE-STRICT\n *\n * A premise node is matched on span overlap like every other node, but the alignment additionally\n * requires the premise TYPE to agree. The substrate forbids merging across types regardless of text\n * similarity ΓÇö \"single user\" (scale) and \"single sign-on user flow\" (requirement) are never the same\n * node, because a false merge produces a spectacular wrong cascade. A metric that scored across types\n * would be measuring something the system is not allowed to do.\n *\n * Predicate disagreement is counted separately, for the same reason variable disagreement is in\n * `extraction.ts`: the right sentence found and the wrong predicate assigned is a distinct, fixable\n * failure and folding it into a miss makes it invisible.\n * ---------------------------------------------------------------------------\n */\n\nimport type { EngineId, PremiseId } from \"@/types/common\";\nimport type { Premise } from \"@/types/domain\";\nimport type { ResolvedCorpus, ResolvedPremise } from \"../corpus/labels\";\nimport type { RunResult } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface PremiseOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedPremise, Premise>;\n  readonly predicateErrors: readonly { label: ResolvedPremise; node: Premise }[];\n  readonly typeErrors: readonly { label: ResolvedPremise; node: Premise }[];\n}\n\nexport function scorePremiseExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): PremiseOutcome {\n  const labels: ResolvedPremise[] = [];\n  for (const transcript of corpus.transcripts) {\n    for (const premise of transcript.premises) {\n      /* `expectInList` is the premise-level form of \"should this become a node\": true when the\n       * transcript STATES it as a fact, false when it is only mentioned. A mentioned premise is not\n       * an extraction failure, so counting it as one would penalise the system for not inventing\n       * beliefs nobody held. */\n      if (!premise.expectInList) continue;\n      labels.push(premise);\n    }\n  }\n\n  const nodes: Premise[] = [...run.state.premises.values()];\n\n  /* Premise spans live on the EVIDENCE, not the node: a premise is shared (invariant I2) and may have\n   * several observations behind it. The first evidence entry with a span is the one that created it,\n   * which is the span the label refers to. A premise with no span at all ΓÇö created by a guard result\n   * or a human assertion rather than by extraction ΓÇö cannot be matched and is reported as spurious,\n   * which is correct: it was not extracted from this corpus. */\n  const spanOf = (premise: Premise): { start: number; end: number } | null => {\n    for (const evidence of premise.evidence) {\n      if (evidence.span !== undefined) return { start: evidence.span.start, end: evidence.span.end };\n    }\n    return null;\n  };\n\n  const alignable = nodes.filter((node) => spanOf(node) !== null);\n  const unspanned = nodes.length - alignable.length;\n\n  const alignment = align(\n    labels,\n    alignable,\n    (label) => label.span,\n    (node) => spanOf(node) ?? { start: 0, end: 0 },\n    (label, node) => label.type === node.type,\n  );\n\n  const predicateErrors = alignment.pairs\n    .filter((pair) => pair.label.predicate !== pair.node.predicate)\n    .map((pair) => ({ label: pair.label, node: pair.node }));\n\n  const typeErrors = findTypeErrors(labels, nodes);\n\n  const detail = precisionRecall(\n    alignment.truePositives,\n    alignment.falsePositives + unspanned,\n    alignment.falseNegatives,\n  );\n\n  return {\n    alignment,\n    predicateErrors,\n    typeErrors,\n    metric: {\n      id: \"premise-extraction\",\n      name: METRIC_NAMES[\"premise-extraction\"],\n      value: detail.f1,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.f1, n: labels.length, detail }],\n      comparator: null, /* deliberately null: see COMPARATORS, whose entry states that none exists */\n      gloss:\n        detail.truePositives + \" of \" + labels.length + \" labelled premises became shared nodes; \" +\n        predicateErrors.length + \" matched on span but were given the wrong predicate; \" +\n        unspanned + \" node(s) carried no extraction span at all.\",\n      honestNote:\n        \"NO PUBLISHED COMPARATOR EXISTS for this metric ΓÇö see \" + (COMPARATORS[\"premise-extraction\"]?.source ?? \"none\") +\n        \". The absence is reported rather than filled with a borrowed number from a different task. \" +\n        \"Matched by \" + MATCH_RULE + \", additionally requiring premise TYPE to agree, because the substrate forbids \" +\n        \"merging across types and a metric that scored across them would measure something the system may not do. \" +\n        \"n=\" + labels.length + \" premises, hand-labelled by the system's author. Premise extraction is the weakest link \" +\n        \"in the architecture (risk R1) and this is the metric that would show it.\",\n    },\n  };\n}\n\n/** Spans that overlap but whose types disagree. Excluded from `align` by the eligibility predicate, so\n *  they surface here instead ΓÇö otherwise a type error would look identical to a total miss. */\nfunction findTypeErrors(labels: readonly ResolvedPremise[], nodes: readonly Premise[]): { label: ResolvedPremise; node: Premise }[] {\n  const out: { label: ResolvedPremise; node: Premise }[] = [];\n\n  for (const label of labels) {\n    for (const node of nodes) {\n      if (node.type === label.type) continue;\n\n      let span: { start: number; end: number } | null = null;\n      for (const evidence of node.evidence) {\n        if (evidence.span !== undefined) {\n          span = { start: evidence.span.start, end: evidence.span.end };\n          break;\n        }\n      }\n      if (span === null) continue;\n\n      const start = Math.max(label.span.start, span.start);\n      const end = Math.min(label.span.end, span.end);\n      if (end > start) out.push({ label, node });\n    }\n  }\n\n  return out;\n}\n\nexport type { PremiseId };\n"},"tags":[],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * Metrics 10 and 11 ΓÇö retrieval precision@5 and MRR.\n *import type { RunResult } from \"../harness\";\nimport type { Resolver } from \"./resolve\";\nimport { \n  COMPARATORS,METRIC_NAMES,describeEngineId,meanReciprocalRank,precisionAtK,type MetricResult,\n} from \"./types\";\n\nconst K = 5;      .filter((id): id is DecisionId => id !== null);\n\n    const retrieved =\n      entry.answer === null ? [] : entry.answer.retrieved.slice(0, K).map((hit) => hit.decisionId);\n    const relevantFound = retrieved.filter((id) => relevantIds.includes(id)).length;\n  const achievableValue = perQuestion.length === 0 ? 0 : achievable / perQuestion.length;\n\n  const ranks = perQuestion.filterperQuestion\n    .filter((entry) => !entry.unanswerable).map((entry) => entry.firstRelevantRank);\n  const mrrValue = meanReciprocalRank(ranks);\n      detail,\n      n: perQuestion.length,\n      perEngine: [\n        { engine: describeEngineId(engine), value: precisionValue, n: perQuestion.length, detail },\n      ],\n      comparator: COMPARATORS[\"retrieval-precision\"] ?? null,\n      gloss:\n        relevantInTopK +\" relevant result(s) across \" +slots +\" top-\" +K +\" slots = \" +\n        (precisionValue * 100).toFixed(1) +\"%. The achievable ceiling on these questions is \" +\n        (achievableValue * 100).toFixed(1) +\"%, because \" +perQuestion.filter((entry) => entry.relevant.length < K).length +\n        \" question(s) have fewer than \" +\" relevant decisions in the whole corpus.\",\n      honestNote:\n        \"precision@\" +\" over \" +perQuestion.length +\" questions, one of which is deliberately UNANSWERABLE and \" +\n        \"contributes a guaranteed zero rather than being dropped ΓÇö dropping it would inflate the score by deleting the \" +\n        \"hardest case. The achievable ceiling is printed beside the value because most questions have one or two relevant \" +      detail: null,\n      n: ranks.length,\n      perEngine: [{ engine: describeEngineId(engine), value: mrrValue, n: ranks.length, detail: null }],\n      comparator: null,\n      gloss:\n        \"MRR \" +mrrValue.toFixed(3) +ranks.length +\" answerable question(s). \" +\n        ranks.filter((rank) => rank === null).length +\" returned no relevant decision in the top \" +\" at all.\",\n      honestNote:\n        \"MRR is reported because precision@5 cannot distinguish 'ranked fifth' from 'never retrieved', and those are \" +\n        \"different failures with different fixes. n=\" +\" ΓÇö the unanswerable question is EXCLUDED from MRR \" +\n        \"(where it can only contribute a structural zero) but INCLUDED in precision@5, which is an inconsistency in \" +\n        \"convention made deliberately and stated here rather than hidden: MRR answers 'when there is an answer, how high \" +  };\n}\n","ops":[{"diffOp":{"equal":{"range":[0,62]}}},{"equalLines":{"line_count":41}},{"diffOp":{"equal":{"range":[62,158]}}},{"diffOp":{"delete":{"range":[158,159]}}},{"diffOp":{"insert":{"range":[159,162]}}},{"diffOp":{"equal":{"range":[162,174]}}},{"diffOp":{"delete":{"range":[158,159]}}},{"diffOp":{"insert":{"range":[159,162]}}},{"diffOp":{"equal":{"range":[174,187]}}},{"diffOp":{"delete":{"range":[158,159]}}},{"diffOp":{"inse