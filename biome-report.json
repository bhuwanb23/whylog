{"line_count":2}},{"diffOp":{"equal":{"range":[3364,3474]}}},{"diffOp":{"delete":{"range":[3364,3365]}}},{"diffOp":{"insert":{"range":[1859,1864]}}},{"diffOp":{"equal":{"range":[3474,3583]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":null,"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Replace with optional chain operator "},{"elements":["Emphasis"],"content":"?."},{"elements":[],"content":" This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator"}]]},{"diff":{"dictionary":"/**\n * The cascade animation ΓÇö 6.6.\n *\n    for (const decision of decisions) {\n      expect(decision.order).toBeGreaterThan(premise!?.order);\n    }\n  });\n});\n","ops":[{"diffOp":{"equal":{"range":[0,40]}}},{"equalLines":{"line_count":84}},{"diffOp":{"equal":{"range":[40,126]}}},{"diffOp":{"equal":{"range":[126,133]}}},{"diffOp":{"delete":{"range":[133,134]}}},{"diffOp":{"insert":{"range":[134,135]}}},{"diffOp":{"equal":{"range":[135,141]}}},{"diffOp":{"equal":{"range":[141,150]}}},{"equalLines":{"line_count":45}},{"diffOp":{"equal":{"range":[150,160]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\graph\\cascade-animation.test.ts"},"span":[3411,3419],"sourceCode":"/**\n * The cascade animation ΓÇö 6.6.\n *\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * STRUCTURE.md ┬º18.6 records the deviation that matters: \"a cascade animation driven by a\n * real label diff rather than a simulation\".\n *\n * That is a testable claim, and it is the difference between the animation telling the user\n * what the reasoning layer did and the animation performing its own little story. The plan\n * gives it teeth:\n *\n *   \"Premises flip before the decisions that rest on them, and decisions flip in cascade\n *    depth order. Without ordering, the animation shows an effect before its cause.\"\n *\n * So the tests are about three things:\n *\n *   1. The steps are the ACTUAL label changes. A node whose label did not change is not\n *      animated; a node whose label changed is animated, with the before and the after.\n *   2. The order is causal. Premises first, then the decisions resting on them.\n *   3. Nothing happens when nothing happened. An animation that always plays is a screensaver.\n *\n * The reasons are the labeller's own, passed through untouched. A reason written by the\n * animation would be a claim about the reasoning layer that the reasoning layer did not make.\n */\n\nimport { describe, expect, it } from \"vitest\";\n\nimport { planCascade, revealedAt, stepAt } from \"@/components/graph/CascadeAnimation\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport { asDecisionId, asPremiseId } from \"@/types/common\";\nimport type { DecisionLabel } from \"@/types/domain\";\n\nfunction labelled(label: DecisionLabel): Labelled {\n  return { label, reason: { kind: \"no-justification\" } };\n}\n\nfunction mapOf(entries: readonly (readonly [NodeId, DecisionLabel])[]): Map<NodeId, Labelled> {\n  return new Map(entries.map(([id, l]) => [id, labelled(l)]));\n}\n\nconst P = (n: string): NodeId => asPremiseId(`P-${n}`);\nconst D = (n: string): NodeId => asDecisionId(`WLD-${n}`);\n\nconst REASON = (node: NodeId, label: DecisionLabel): string => `${node} became ${label}`;\n\ndescribe(\"The cascade animation is driven by a real label diff\", () => {\n  it(\"animates exactly the nodes whose label changed\", () => {\n    const before = mapOf([\n      [P(\"0001\"), \"IN\"],\n      [D(\"0001\"), \"IN\"],\n      [D(\"0002\"), \"IN\"],\n    ]);\n    const after = mapOf([\n      [P(\"0001\"), \"OUT\"],\n      [D(\"0001\"), \"OUT\"],\n      [D(\"0002\"), \"IN\"],\n    ]);\n\n    const plan = planCascade(before, after, P(\"0001\"), [P(\"0001\"), D(\"0001\")], REASON);\n\n    const animated = plan.steps.map((s) => s.node).sort();\n    expect(animated).toEqual([P(\"0001\"), D(\"0001\")]);\n\n    const premise = plan.steps.find((s) => s.node === P(\"0001\"));\n    expect(premise?.from).toBe(\"IN\");\n    expect(premise?.to).toBe(\"OUT\");\n  });\n\n  it(\"shows an effect AFTER its cause: premises flip before the decisions on them\", () => {\n    const before = mapOf([\n      [P(\"0001\"), \"IN\"],\n      [D(\"0001\"), \"IN\"],\n      [D(\"0002\"), \"IN\"],\n    ]);\n    const after = mapOf([\n      [P(\"0001\"), \"OUT\"],\n      [D(\"0001\"), \"OUT\"],\n      [D(\"0002\"), \"OUT\"],\n    ]);\n\n    const plan = planCascade(before, after, P(\"0001\"), [P(\"0001\"), D(\"0001\"), D(\"0002\")], REASON);\n\n    const premise = plan.steps.find((s) => s.isPremise);\n    const decisions = plan.steps.filter((s) => !s.isPremise);\n    expect(premise).toBeDefined();\n    expect(decisions.length).toBeGreaterThan(0);\n\n    for (const decision of decisions) {\n      expect(decision.order).toBeGreaterThan(premise!.order);\n    }\n\n    // And the steps are ordered among themselves.\n    const orders = plan.steps.map((s) => s.order);\n    expect([...orders].sort((a, b) => a - b)).toEqual(orders);\n  });\n\n  it(\"plays nothing when nothing changed\", () => {\n    const same = mapOf([\n      [P(\"0001\"), \"IN\"],\n      [D(\"0001\"), \"IN\"],\n    ]);\n\n    const plan = planCascade(same, same, P(\"0001\"), [P(\"0001\"), D(\"0001\")], REASON);\n\n    expect(plan.steps).toHaveLength(0);\n    expect(stepAt(plan, 10_000)).toBeNull();\n    expect(revealedAt(plan, 10_000).size).toBe(0);\n  });\n\n  it(\"carries the labeller's own reason, unparaphrased\", () => {\n    const before = mapOf([[P(\"0001\"), \"IN\"]]);\n    const after = mapOf([[P(\"0001\"), \"OUT\"]]);\n\n    const plan = planCascade(before, after, P(\"0001\"), [P(\"0001\")], REASON);\n    expect(plan.steps[0]?.reason).toContain(\"P-0001\");\n  });\n\n  it(\"reveals nodes progressively as the animation runs\", () => {\n    const before = mapOf([\n      [P(\"0001\"), \"IN\"],\n      [D(\"0001\"), \"IN\"],\n    ]);\n    const after = mapOf([\n      [P(\"0001\"), \"OUT\"],\n      [D(\"0001\"), \"OUT\"],\n    ]);\n\n    const plan = planCascade(before, after, P(\"0001\"), [P(\"0001\"), D(\"0001\")], REASON);\n\n    // At the very start, nothing has been revealed yet.\n    expect(revealedAt(plan, 0).size).toBeLessThanOrEqual(plan.steps.length);\n\n    // After the whole plan has run, everything has.\n    const last = plan.steps[plan.steps.length - 1];\n    expect(last).toBeDefined();\n    expect(revealedAt(plan, 100_000).size).toBe(plan.steps.length);\n  });\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\alternatives.ts"},"span":[5669,5688],"sourceCode":"/**\n * Rejected-alternative recovery ΓÇö 1.5.\n *\n * Phase 1 ┬╖ sub-phase 1.5\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.5\n *\n * ---------------------------------------------------------------------------\n * WHY THIS GETS ITS OWN SUB-PHASE\n *\n * ARGUS measured **15.4% precision** on Alternatives with run-consistency ╬▒ = 0.64\n * ΓÇö the worst of any rationale component (docs/05 ┬º4). It is also the\n * highest-value one, because alternatives power PRE-EMPTION: catching a mistake\n * before the decision rather than after.\n *\n * Their finding argues in WhyLog's favour, and it is testable: \"Alternatives occur\n * almost exclusively in issues, pull requests, and code reviews\" ΓÇö that is, in\n * DISCUSSION. A transcript IS continuous discussion, so it should be the richest\n * available source. Phase 7 tests that hypothesis; this file is written to make the\n * test possible rather than to assume the result.\n *\n * ---------------------------------------------------------------------------\n * HOW PRECISION IS BOUGHT\n *\n * Three restrictions, each of which costs recall and buys precision, in the order\n * they cost least:\n *\n *   1. **Only values the ontology recognises.** An unknown noun rejected for\n *      unknown reasons is not worth pre-empting on. `value-phrase.ts` supplies the\n *      strength; anything `bare` is dropped.\n *\n *   2. **Only inside an episode that produced a decision.** A rejected alternative\n *      with nothing chosen against it is not an alternative, it is a topic. Those\n *      become discards, which is the denominator of the precision measurement.\n *\n *   3. **`whyRejected` gates the pre-emption index, not the store.** An\n *      alternative with no reason is recorded ΓÇö losing it would lose information ΓÇö\n *      but it never warns anybody. Pre-empting without a reason is nagging, and a\n *      tool that nags gets switched off.\n *\n * Plus the review tier: alternatives are collapsed by default and require explicit\n * confirmation before entering the index. A false pre-emption (\"you rejected\n * Supabase\" when you did not) is worse than no pre-emption at all, because it\n * arrives at the moment the user is most receptive to it.\n * ---------------------------------------------------------------------------\n */\n\nimport { type ValueCandidate, rankValues } from \"@/ai/local/value-phrase\";\nimport type { AlternativeCandidate, DiscardedCandidate } from \"@/ai/types\";\nimport { normalise } from \"@/lib/text\";\nimport { canonicalValueOf, foldKey, variableFromValue } from \"@/ontology/canonicalize\";\nimport { asConfidence } from \"@/types/common\";\nimport type { DecisionVariable } from \"@/types/domain\";\nimport type { DecisionContext, RecoveredDecision } from \"./decisions\";\nimport { locateInEpisode, toNormalised } from \"./episode-position\";\nimport { spanFrom } from \"./offset-map\";\nimport type { EpisodeWindow } from \"./types\";\n\nexport interface RecoveredAlternative {\n  readonly candidate: AlternativeCandidate;\n  /** Index into the episode's recovered decisions. */\n  readonly decisionIndex: number;\n  readonly value: ValueCandidate;\n  /** How it was found. `pivot` is the syntactically explicit case and by far the\n   *  most precise; `cue` is a rejection phrase; `contrast` is the weakest. */\n  readonly via: \"pivot\" | \"cue\" | \"contrast\";\n  readonly cuePhrase: string | null;\n  readonly episodeIndex: number;\n}\n\nexport interface AlternativeRecovery {\n  readonly alternatives: readonly RecoveredAlternative[];\n  readonly discarded: readonly DiscardedCandidate[];\n  /** How many carry a reason. The ratio is the number that decides whether the\n   *  pre-emption index has anything in it. */\n  readonly withReason: number;\n}\n\n/** Rejection phrases, longest first so \"we could have used\" is not read as\n *  \"could have\". */\nconst REJECTION_CUES: readonly { phrase: string; weight: number; whyAfter: boolean }[] = [\n  { phrase: \"we could have used\", weight: 0.85, whyAfter: true },\n  { phrase: \"we could have gone with\", weight: 0.85, whyAfter: true },\n  { phrase: \"could have used\", weight: 0.8, whyAfter: true },\n  { phrase: \"ruled out\", weight: 0.9, whyAfter: true },\n  { phrase: \"rule out\", weight: 0.7, whyAfter: true },\n  { phrase: \"decided against\", weight: 0.95, whyAfter: true },\n  { phrase: \"instead of\", weight: 0.9, whyAfter: false },\n  { phrase: \"rather than\", weight: 0.9, whyAfter: false },\n  { phrase: \"in preference to\", weight: 0.85, whyAfter: false },\n  { phrase: \"over using\", weight: 0.7, whyAfter: false },\n  { phrase: \"we skipped\", weight: 0.8, whyAfter: true },\n  { phrase: \"skipping\", weight: 0.65, whyAfter: true },\n  { phrase: \"dropped\", weight: 0.7, whyAfter: true },\n  { phrase: \"dropping\", weight: 0.65, whyAfter: true },\n  { phrase: \"ditched\", weight: 0.8, whyAfter: true },\n  { phrase: \"not using\", weight: 0.75, whyAfter: true },\n  { phrase: \"no longer using\", weight: 0.8, whyAfter: true },\n  { phrase: \"reverted\", weight: 0.75, whyAfter: true },\n  { phrase: \"before we go down the\", weight: 0.7, whyAfter: false },\n  { phrase: \"would work but\", weight: 0.8, whyAfter: true },\n  { phrase: \"would have worked but\", weight: 0.8, whyAfter: true },\n  { phrase: \"is tempting but\", weight: 0.75, whyAfter: true },\n  { phrase: \"seems like a good fit but\", weight: 0.7, whyAfter: true },\n  { phrase: \"we don't need\", weight: 0.6, whyAfter: true },\n  { phrase: \"avoid\", weight: 0.55, whyAfter: true },\n];\n\nconst MIN_CONFIDENCE = 0.35;\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function recoverAlternatives(\n  episode: EpisodeWindow,\n  decisions: readonly RecoveredDecision[],\n  context: DecisionContext,\n): AlternativeRecovery {\n  if (decisions.length === 0) {\n    // Nothing was chosen, so nothing was chosen AGAINST. Every rejection phrase in\n    // this episode becomes a discard ΓÇö recorded, so the precision denominator is\n    // honest, and visible in the review UI's \"why was this dropped\" list.\n    return { alternatives: [], discarded: collectOrphans(episode), withReason: 0 };\n  }\n\n  const found: RecoveredAlternative[] = [];\n  const discarded: DiscardedCandidate[] = [];\n  const seen = new Set<string>();\n\n  /* ---- 1. the pivot values the decision recovery already found ---- */\n  decisions.forEach((decision, decisionIndex) => {\n    for (const rejected of decision.rejectedValues) {\n      const key = dedupeKey(decision.candidate.variable, rejected);\n      if (seen.has(key)) continue;\n\n      const value = valueFromText(episode.text, rejected, decision.candidate.variable);\n      if (value === null) continue;\n      seen.add(key);\n\n      const built = build(\n        episode,\n        decisionIndex,\n        decisions,\n        value,\n        \"pivot\",\n        null,\n        context,\n        discarded,\n      );\n      if (built !== null) found.push(built);\n    }\n  });\n\n  /* ---- 2. rejection cues in the episode text ---- */\n  const lower = episode.text.toLowerCase();\n  for (const cue of REJECTION_CUES) {\n    let from = 0;\n    for (;;) {\n      const at = lower.indexOf(cue.phrase, from);\n      if (at < 0) break;\n      from = at + cue.phrase.length;\n\n      const value = valueNear(episode.text, at + cue.phrase.length, decisions);\n      if (value === null) {\n        discarded.push({\n          kind: \"alternative\",\n          discardedBy: \"confidence-threshold\",\n          rawText: episode.text.slice(Math.max(0, at - 20), at + cue.phrase.length + 60).trim(),\n          confidence: asConfidence(cue.weight * 0.4),\n        });\n        continue;\n      }\n\n      const decisionIndex = nearestDecision(decisions, episode, at);\n      const key = dedupeKey(\n        value.variable ?? decisions[decisionIndex]?.candidate.variable ?? \"OTHER\",\n        value.canonical,\n      );\n      if (seen.has(key)) continue;\n      seen.add(key);\n\n      const built = build(\n        episode,\n        decisionIndex,\n        decisions,\n        value,\n        \"cue\",\n        cue,\n        context,\n        discarded,\n        at,\n        cue.whyAfter,\n      );\n      if (built !== null) found.push(built);\n    }\n  }\n\n  return {\n    alternatives: found,\n    discarded,\n    withReason: found.filter((a) => a.candidate.whyRejected !== undefined).length,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Building                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction build(\n  episode: EpisodeWindow,\n  decisionIndex: number,\n  decisions: readonly RecoveredDecision[],\n  value: ValueCandidate,\n  via: RecoveredAlternative[\"via\"],\n  cue: { phrase: string; weight: number } | null,\n  context: DecisionContext,\n  discarded: DiscardedCandidate[],\n  cueAt?: number,\n  whyAfter?: boolean,\n): RecoveredAlternative | null {\n  const decision = decisions[decisionIndex];\n  if (decision === undefined) return null;\n\n  // Never record the chosen value as its own alternative. A pivot construction\n  // mis-parsed at either end produces exactly this, and \"you rejected SQLite\" on a\n  // SQLite decision is the most damaging false pre-emption available.\n  if (normalise(value.canonical) === normalise(decision.candidate.value)) return null;\n\n  const variable: DecisionVariable = value.variable ?? decision.candidate.variable;\n  const canonical =\n    variable === \"OTHER\" ? foldKey(value.surface) : canonicalValueOf(variable, value.surface);\n\n  const why = findWhyRejected(episode.text, cueAt ?? value.start, whyAfter ?? true);\n  const confidence = score(value, via, cue, why !== null);\n\n  if (confidence < MIN_CONFIDENCE) {\n    discarded.push({\n      kind: \"alternative\",\n      discardedBy: \"confidence-threshold\",\n      rawText: value.surface,\n      confidence,\n    });\n    return null;\n  }\n\n  const snippet = spanFor(episode, value, context);\n  if (snippet === null) return null;\n\n  return {\n    candidate: {\n      variable,\n      value: canonical,\n      ...(why === null ? {} : { whyRejected: why }),\n      confidence,\n      snippet,\n      decisionRef: decisionIndex,\n    },\n    decisionIndex,\n    value,\n    via,\n    cuePhrase: cue?.phrase ?? null,\n    episodeIndex: episode.index,\n  };\n}\n\n/**\n * The reason this alternative was turned down.\n *\n * Sought after the cue (\"ruled out Postgres ΓÇö migrations before we have a user\")\n * and, when that fails, before it (\"migrations are a hassle, so not Postgres\").\n * Both directions because dialogue puts the reason wherever the speaker was\n * heading.\n */\nfunction findWhyRejected(text: string, at: number, afterFirst: boolean): string | null {\n  const order = afterFirst ? [\"after\", \"before\"] : [\"before\", \"after\"];\n\n  for (const direction of order) {\n    const window =\n      direction === \"after\"\n        ? text.slice(at, Math.min(text.length, at + 180))\n        : text.slice(Math.max(0, at - 180), at);\n\n    const found = reasonClause(window, direction === \"before\");\n    if (found !== null) return found;\n  }\n  return null;\n}\n\nconst REASON_MARKERS = [\n  \"because\",\n  \"since\",\n  \"due to\",\n  \"as it\",\n  \"as they\",\n  \"so \",\n  \"which means\",\n  \"that means\",\n  \"but it\",\n  \"but that\",\n  \"but you\",\n  \"but we\",\n  \"too much\",\n  \"too many\",\n  \"requires\",\n  \"would need\",\n  \"would mean\",\n  \"means\",\n  \"the problem\",\n  \"the catch\",\n  \"overkill\",\n  \"heavier\",\n  \"more complex\",\n  \"dependency\",\n  \"ceremony\",\n  \"hassle\",\n];\n\nfunction reasonClause(window: string, reversed: boolean): string | null {\n  const lower = window.toLowerCase();\n  const positions = REASON_MARKERS.map((marker) => ({\n    marker,\n    at: reversed ? lower.lastIndexOf(marker) : lower.indexOf(marker),\n  }))\n    .filter((entry) => entry.at >= 0)\n    .sort((a, b) => (reversed ? b.at - a.at : a.at - b.at));\n\n  const best = positions[0];\n  if (best === undefined) return null;\n\n  const body = reversed ? window.slice(0, best.at).trim() : window.slice(best.at).trim();\n\n  const clause = body.split(/[.!?\\n;]/)[0]?.trim() ?? \"\";\n  if (clause.length < 10 || clause.length > 200) return null;\n  return clause;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Values                                                                     */\n/* -------------------------------------------------------------------------- */\n\nfunction valueNear(\n  text: string,\n  at: number,\n  decisions: readonly RecoveredDecision[],\n): ValueCandidate | null {\n  const hint = decisions[0]?.candidate.variable ?? null;\n  const ranked = rankValues(text, at, Math.min(text.length, at + 80), hint);\n\n  // Only values the ontology recognises. See the file header: restriction 1.\n  const known = ranked.find((c) => c.strength === \"known\" || c.strength === \"scoped-known\");\n  if (known !== undefined) return known;\n\n  const shaped = ranked.find((c) => c.strength === \"tech-shaped\");\n  return shaped ?? null;\n}\n\nfunction valueFromText(\n  text: string,\n  surface: string,\n  hint: DecisionVariable,\n): ValueCandidate | null {\n  const at = text.toLowerCase().indexOf(surface.toLowerCase());\n  if (at < 0) {\n    const variable = variableFromValue(surface)?.variable ?? hint;\n    return {\n      surface,\n      canonical: variable === \"OTHER\" ? foldKey(surface) : canonicalValueOf(variable, surface),\n      variable,\n      strength: \"known\",\n      score: 0.8,\n      start: 0,\n      end: 0,\n    };\n  }\n  const ranked = rankValues(text, at, at + surface.length + 1, hint);\n  return ranked[0] ?? null;\n}\n\n/** The decision whose value is closest in the text, so the alternative attaches to\n *  the choice it was weighed against rather than to whichever decision came first. */\nfunction nearestDecision(\n  decisions: readonly RecoveredDecision[],\n  episode: EpisodeWindow,\n  at: number,\n): number {\n  let best = 0;\n  let bestDistance = Number.POSITIVE_INFINITY;\n\n  decisions.forEach((decision, index) => {\n    const decisionAt = episode.text.toLowerCase().indexOf(decision.candidate.value.toLowerCase());\n    if (decisionAt < 0) return;\n    const distance = Math.abs(decisionAt - at);\n    if (distance < bestDistance) {\n      bestDistance = distance;\n      best = index;\n    }\n  });\n\n  return best;\n}\n\nfunction spanFor(\n  episode: EpisodeWindow,\n  value: ValueCandidate,\n  context: DecisionContext,\n): ReturnType<typeof spanFrom> {\n  const located = locateInEpisode(episode, value.start);\n  if (located === null) return null;\n\n  const localAt = value.start - located.offset;\n  const start = toNormalised(located, localAt);\n  const end = toNormalised(located, localAt + value.surface.length);\n  if (end <= start) return null;\n\n  return spanFrom(context.transcriptId, context.raw, context.map, start, end);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Scoring                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Deliberately harsher than the decision rubric.\n *\n * The published precision is 15.4%, so a score that mirrors the decision rubric\n * would put alternatives in the bulk-approvable tier and the user would approve\n * wrong ones in bulk. `confidence.ts` demotes the tier again on top of this.\n */\nfunction score(\n  value: ValueCandidate,\n  via: RecoveredAlternative[\"via\"],\n  cue: { weight: number } | null,\n  hasReason: boolean,\n): ReturnType<typeof asConfidence> {\n  let score = 0;\n\n  score += via === \"pivot\" ? 0.4 : via === \"cue\" ? 0.3 : 0.2;\n  score += (cue?.weight ?? 0.7) * 0.2;\n  score += value.strength === \"scoped-known\" ? 0.2 : value.strength === \"known\" ? 0.15 : 0.05;\n  if (hasReason) score += 0.15;\n\n  return asConfidence(Math.max(0.05, Math.min(0.85, score)));\n}\n\nfunction dedupeKey(variable: DecisionVariable, value: string): string {\n  return `${variable}\\u0000${normalise(value)}`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Orphans                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/** Rejection phrases in an episode that produced no decision. Recorded as\n *  discards so the precision denominator counts them. */\nfunction collectOrphans(episode: EpisodeWindow): readonly DiscardedCandidate[] {\n  const lower = episode.text.toLowerCase();\n  const out: DiscardedCandidate[] = [];\n\n  for (const cue of REJECTION_CUES) {\n    const at = lower.indexOf(cue.phrase);\n    if (at < 0) continue;\n    out.push({\n      kind: \"alternative\",\n      discardedBy: \"duplicate\",\n      rawText: episode.text.slice(Math.max(0, at - 20), at + cue.phrase.length + 60).trim(),\n      confidence: asConfidence(cue.weight * 0.3),\n    });\n  }\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeRecovery(recovery: AlternativeRecovery): string {\n  const parts = [\n    `${recovery.alternatives.length} alternative${recovery.alternatives.length === 1 ? \"\" : \"s\"}`,\n  ];\n  if (recovery.alternatives.length > 0) {\n    parts.push(\n      `${recovery.withReason} with a reason${recovery.withReason === recovery.alternatives.length ? \"\" : ` ΓÇö ${recovery.alternatives.length - recovery.withReason} stored but excluded from pre-emption`}`,\n    );\n  }\n  if (recovery.discarded.length > 0) parts.push(`${recovery.discarded.length} discarded`);\n  return parts.join(\", \");\n}\n\nexport const ALTERNATIVE_MIN_CONFIDENCE = MIN_CONFIDENCE;\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 59 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 59 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 59 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\commit.ts"},"span":[6704,6716],"sourceCode":"/**\n * Commit ΓÇö 1.9's write path. THE ENFORCEMENT POINT.\n *\n * Phase 1 ┬╖ sub-phase 1.9\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.9\n *\n * ---------------------------------------------------------------------------\n * THE RULE THIS FILE EXISTS TO ENFORCE\n *\n * **Nothing enters the log unreviewed.**\n *\n * `commitReview` REFUSES an item with no `ReviewAction`. Not \"accepts it at low\n * confidence\", not \"marks it needsReview\" ΓÇö refuses, and reports which items were\n * the problem. An extraction that has not been looked at by a person is a set of\n * guesses, and guesses in an append-only hash-chained log are worse than guesses in\n * a scratchpad: they cannot be deleted, they drive cascades, and they get exported\n * into `AGENTS.md` where an agent will obey them.\n *\n * ---------------------------------------------------------------------------\n * WHY ONE BATCH\n *\n * A commit is all-or-nothing. Half a justification ΓÇö a decision whose premise was\n * written but whose `JustificationAttached` was not ΓÇö is worse than nothing,\n * because the decision looks justified while resting on nothing, and the cascade\n * has no edge to walk. `recordBatch` is already all-or-nothing; this module's job\n * is to build the batch so that its ordering makes the references resolvable.\n *\n * Ordering, therefore:\n *\n *   1. `PremiseAsserted`      ΓÇö premises exist before anything refers to them\n *   2. `DecisionProposed`     ΓÇö carries `premiseIds`, so premises come first\n *   3. `JustificationAttached`ΓÇö carries the IN and OUT lists\n *   4. `AlternativeRejected`  ΓÇö carries `decisionId`, so decisions come first\n *   5. the review events       ΓÇö `DecisionApproved` / `DecisionEdited` /\n *                               `DecisionRejected` / `PremiseConfirmed` /\n *                               `PremiseCorrected`\n *   6. `ExtractionDiscarded`  ΓÇö the precision denominator\n *\n * ---------------------------------------------------------------------------\n * THE IN/OUT SPLIT IS RECOVERED HERE, NOT CARRIED\n *\n * `DecisionCandidate.premiseRefs` is one list, because the engine interface has one\n * list. Splitting it into a justification's IN-list and OUT-list needs the\n * exclusion table, and the table is ontology data ΓÇö so the split happens here, at\n * the boundary between candidates and events, where both are in scope. An OUT-list\n * entry is recognised by the marker `premise-linker.ts` writes into its text.\n *\n * ---------------------------------------------------------------------------\n * WHY `DecisionProposed` IS WRITTEN FOR DISCARDED ITEMS TOO\n *\n * It is not. A discarded item never becomes a node; it becomes an\n * `ExtractionDiscarded` event, which is the record that it was produced and\n * rejected. Writing the node and then rejecting it would leave a `status:\n * \"rejected\"` decision in the graph forever, polluting every projection that\n * counts decisions.\n * ---------------------------------------------------------------------------\n */\n\nimport {\n  formatAlternativeId,\n  formatDecisionId,\n  formatEpisodeId,\n  formatJustificationId,\n  formatPremiseId,\n} from \"@/lib/ids\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type {\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  EventId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { Actor } from \"@/types/common\";\nimport type { Justification } from \"@/types/domain\";\nimport type { EventType, JustificationAttachedPayload, NewEvent } from \"@/types/events\";\nimport { isDerivedPremise } from \"./review\";\nimport { isAccepted } from \"./types\";\nimport type { ResolvedCandidate, ReviewAction } from \"./types\";\n\nexport interface CommitInput {\n  readonly transcriptId: TranscriptId;\n  readonly engine: EngineId;\n  /** The transcript's own time. Every event in the batch carries it as\n   *  `occurredAt`, so ordering uses VALID time (0.3) rather than the moment of\n   *  import. Losing this would stamp every imported decision \"now\" and silently\n   *  destroy the bi-temporal split for the whole pipeline. */\n  readonly occurredAt: ISODateString;\n  readonly items: readonly ResolvedCandidate[];\n  /** Discards produced by the recognisers, which the human never saw. Recorded\n   *  alongside the human's own discards so the denominator is complete. */\n  readonly machineDiscards?: readonly {\n    kind: \"decision\" | \"premise\" | \"alternative\";\n    discardedBy: \"confidence-threshold\" | \"modality\" | \"duplicate\";\n    rawText: string;\n    confidence: Confidence;\n  }[];\n  readonly episodeIds?: readonly (EpisodeId | null)[];\n  /** True when the human approved several decisions with one action. Sets\n   *  `viaBulkApprove`, which the fold reads to KEEP THE LABEL AT UNKNOWN: a bulk\n   *  approval is not a considered one, and promoting ten decisions to IN in a\n   *  single click is how a machine inference ends up driving a cascade. */\n  readonly viaBulkApprove?: boolean;\n  readonly actor?: Actor;\n}\n\nexport interface CommitOk {\n  readonly ok: true;\n  readonly drafts: readonly NewEvent<EventType>[];\n  readonly counts: CommitCounts;\n  /** The review events carry a `reason`, and every one of them says which item it\n   *  was about. Exposed so the caller can show the batch before appending. */\n  readonly reasons: readonly string[];\n}\n\nexport interface CommitCounts {\n  readonly premises: number;\n  readonly decisions: number;\n  readonly justifications: number;\n  readonly alternatives: number;\n  readonly approvals: number;\n  readonly edits: number;\n  readonly rejections: number;\n  readonly premiseConfirmations: number;\n  readonly discards: number;\n  readonly events: number;\n  /** How many justifications carry a non-empty OUT-list. The number of decisions\n   *  from this transcript that gate (c) can fire on. */\n  readonly nonMonotonic: number;\n}\n\nexport type CommitFailure =\n  | { readonly ok: false; readonly kind: \"unreviewed\"; readonly keys: readonly string[] }\n  | { readonly ok: false; readonly kind: \"empty\" }\n  | { readonly ok: false; readonly kind: \"no-accepted\" };\n\nexport type CommitResult = CommitOk | CommitFailure;\n\n/** Placeholder for `Justification.informant.eventId`. The fold rewrites it to the\n *  real event id, because a batch producer cannot know the ids `appendBatch` will\n *  mint. See the `JustificationAttached` case in `materialize.ts`. */\nconst PLACEHOLDER_EVENT_ID = \"EV-000000-000000\" as EventId;\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function commitReview(input: CommitInput, state: GraphState): CommitResult {\n  const reviewed = input.items.filter((item) => item.action !== null);\n  const unreviewed = input.items.filter((item) => item.action === null).map((item) => item.key);\n\n  if (unreviewed.length > 0) {\n    // The rule, enforced. See the file header.\n    return { ok: false, kind: \"unreviewed\", keys: unreviewed };\n  }\n  if (reviewed.length === 0 && (input.machineDiscards?.length ?? 0) === 0) {\n    return { ok: false, kind: \"empty\" };\n  }\n\n  // `contest` is not an acceptance and not a discard: it parks the item. Phase 2\n  // turns the Contested queue into proposals; until then a contested item is\n  // recorded as a discard so it does not silently vanish, with the human's reason.\n  const accepted = reviewed.filter(\n    (item) =>\n      item.action !== null && item.action.type !== \"discard\" && item.action.type !== \"contest\",\n  );\n  const rejected = reviewed.filter((item) => item.action?.type === \"discard\");\n  const contested = reviewed.filter((item) => item.action?.type === \"contest\");\n  if (accepted.length === 0 && rejected.length === 0 && contested.length === 0) {\n    return { ok: false, kind: \"no-accepted\" };\n  }\n\n  const drafts: NewEvent<EventType>[] = [];\n  const reasons: string[] = [];\n\n  /* ---- id allocation, from the CURRENT counters ---- */\n  // Derived from state rather than from a module-level counter, so a failed commit\n  // leaves no gap and two commits in one session cannot collide.\n  let premiseSeq = state.counters.premises;\n  let decisionSeq = state.counters.decisions;\n  let justificationSeq = state.counters.justifications;\n\n  const premiseIds = new Map<string, PremiseId>();\n  const decisionIds = new Map<string, DecisionId>();\n  const alternativesByDecision = new Map<string, number>();\n\n  const nextPremiseId = (): PremiseId => {\n    premiseSeq += 1;\n    return formatPremiseId(premiseSeq);\n  };\n  const nextDecisionId = (): DecisionId => {\n    decisionSeq += 1;\n    return formatDecisionId(decisionSeq);\n  };\n\n  /* ---- 1. premises ---- */\n  let premiseCount = 0;\n  let premiseConfirmations = 0;\n\n  for (const item of input.items) {\n    if (item.kind !== \"premise\" || item.premise === null || !isAccepted(item.action)) continue;\n\n    // A merge does not create a node: `PremiseAsserted` on an EXISTING id appends\n    // evidence and takes the max confidence, which is what corroboration is.\n    const id =\n      item.resolution.action === \"merge\" && item.resolution.matchedId !== null\n        ? (item.resolution.matchedId as PremiseId)\n        : nextPremiseId();\n\n    premiseIds.set(item.key, id);\n\n    drafts.push({\n      type: \"PremiseAsserted\",\n      payload: {\n        premiseId: id,\n        transcriptId: input.transcriptId,\n        type: item.premise.type,\n        predicate: item.premise.predicate,\n        ...(item.premise.value === undefined ? {} : { value: item.premise.value }),\n        text: item.premise.text,\n        confidence: item.confidence,\n        engine: input.engine,\n        snippet: item.premise.snippet,\n      },\n    });\n    premiseCount += 1;\n\n    if (item.action?.type === \"edit\") {\n      drafts.push(\n        reviewEvent(\n          \"PremiseCorrected\",\n          {\n            premiseId: id,\n            fields: item.action.fields,\n          },\n          `Premise ${id} corrected by hand: ${item.premise.predicate}`,\n          reasons,\n        ),\n      );\n    } else if (isDerivedPremise(item.premise.predicate, item.premise.text)) {\n      /* A DERIVED EXCLUSION is NOT confirmed.\n       *\n       * An exclusion premise describes a condition the decision EXCLUDES ΓÇö\n       * \"more than one process needs to write at once\". It is a hypothesis about\n       * what would break the decision, not an observation that it holds.\n       *\n       * Confirming it would label it IN, and an OUT-list premise that is IN\n       * invalidates its justification: the decision is unsound because the thing\n       * it excluded turns out to be true. So confirming every derived exclusion\n       * makes EVERY decision in the log unsound the moment it is written, and\n       * one falsification takes the whole graph with it. That is risk R2 ΓÇö the\n       * cascade crying wolf ΓÇö and over-retraction is worse than under-retraction.\n       *\n       * It stays UNKNOWN until somebody OBSERVES it, and an observation is\n       * exactly what makes it IN: the world moved, the excluded condition turned\n       * out to hold, and the decision has to be revisited. That is Doyle's\n       * non-monotonic justification running in the right direction.\n       */\n    } else {\n      drafts.push(\n        reviewEvent(\n          \"PremiseConfirmed\",\n          { premiseId: id },\n          `Premise ${id} confirmed: ${item.premise.text}`,\n          reasons,\n        ),\n      );\n      premiseConfirmations += 1;\n    }\n  }\n\n  /* ---- 2. decisions ---- */\n  let decisionCount = 0;\n  let approvals = 0;\n  let edits = 0;\n\n  for (const item of input.items) {\n    if (item.kind !== \"decision\" || item.decision === null || !isAccepted(item.action)) continue;\n\n    const id =\n      item.resolution.action === \"merge\" && item.resolution.matchedId !== null\n        ? (item.resolution.matchedId as DecisionId)\n        : nextDecisionId();\n\n    decisionIds.set(item.key, id);\n\n    const refs = resolvePremiseRefs(item.inRefs, input.items, premiseIds);\n    const episodeId = episodeIdFor(item.episodeIndex, input.episodeIds, state);\n\n    drafts.push({\n      type: \"DecisionProposed\",\n      payload: {\n        decisionId: id,\n        transcriptId: input.transcriptId,\n        episodeId,\n        variable: item.decision.variable,\n        value: item.decision.value,\n        statement: item.decision.statement,\n        ...(item.decision.rationale === undefined ? {} : { rationale: item.decision.rationale }),\n        ...(item.decision.acceptedDownside === undefined\n          ? {}\n          : { acceptedDownside: item.decision.acceptedDownside }),\n        origin: item.origin,\n        modality: item.decision.modality,\n        confidence: item.confidence,\n        engine: input.engine,\n        snippet: item.decision.snippet,\n        premiseIds: refs.all,\n        alternativeIds: [],\n        ...(item.decision.yStatement === undefined ? {} : { yStatement: item.decision.yStatement }),\n        ...(item.decision.appliesTo.length === 0 ? {} : { appliesTo: item.decision.appliesTo }),\n        // `episode` is deliberately NOT supplied. A candidate carries no turn\n        // indices, and inventing a range from the snippet's character offsets would\n        // put turn numbers where character numbers belong. The fold synthesises an\n        // episode from the decision's own snippet, which is a real range in a real\n        // transcript; `episodeIds` above is what names it.\n      },\n    });\n    decisionCount += 1;\n\n    /* ---- 3. justification, immediately after its decision ---- */\n    if (refs.inList.length > 0 || refs.outList.length > 0) {\n      justificationSeq += 1;\n      const justificationId = formatJustificationId(justificationSeq);\n      const justification: Justification = {\n        id: justificationId,\n        consequent: id,\n        inList: refs.inList,\n        outList: refs.outList,\n        informant: { kind: \"extraction\", engine: input.engine, eventId: PLACEHOLDER_EVENT_ID },\n        createdAt: input.occurredAt,\n      };\n\n      drafts.push({\n        type: \"JustificationAttached\",\n        payload: { justificationId, consequent: id, justification },\n        // A STATE_CHANGING event, so `reason` is mandatory. It states what the\n        // justification rests on, which is the sentence a user reads when gate (c)\n        // fires six months later.\n        reason: justificationReason(justification),\n        ...(input.actor === undefined ? {} : { actor: input.actor }),\n        occurredAt: input.occurredAt,\n      });\n      reasons.push(justificationReason(justification));\n    }\n\n    /* ---- 5. the review event ---- */\n    if (item.action?.type === \"edit\") {\n      drafts.push(\n        reviewEvent(\n          \"DecisionEdited\",\n          {\n            decisionId: id,\n            fields: item.action.fields,\n          },\n          `Decision ${id} (${item.decision.variable} ΓåÆ ${item.decision.value}) edited by hand before acceptance`,\n          reasons,\n        ),\n      );\n      edits += 1;\n    } else {\n      const viaBulk =\n        item.action?.type === \"approve\" ? item.action.viaBulk : input.viaBulkApprove === true;\n      drafts.push(\n        reviewEvent(\n          \"DecisionApproved\",\n          {\n            decisionId: id,\n            viaBulkApprove: viaBulk,\n          },\n          approvalReason(item, viaBulk),\n          reasons,\n        ),\n      );\n      approvals += 1;\n    }\n  }\n\n  /* ---- 4. alternatives, after their decisions ---- */\n  let alternativeCount = 0;\n\n  for (const item of input.items) {\n    if (item.kind !== \"alternative\" || item.alternative === null || !isAccepted(item.action))\n      continue;\n\n    const decisionKey = `decision:${item.alternative.decisionRef}`;\n    const decisionId = decisionIds.get(decisionKey);\n    if (decisionId === undefined) continue; // its decision was discarded, so it has nothing to be an alternative TO\n\n    const seq = (alternativesByDecision.get(decisionId) ?? 0) + 1;\n    alternativesByDecision.set(decisionId, seq);\n    const alternativeId: AlternativeId = formatAlternativeId(decisionId, seq);\n\n    drafts.push({\n      type: \"AlternativeRejected\",\n      payload: {\n        alternativeId,\n        decisionId,\n        variable: item.alternative.variable,\n        value: item.alternative.value,\n        ...(item.alternative.whyRejected === undefined\n          ? {}\n          : { whyRejected: item.alternative.whyRejected }),\n        confidence: item.confidence,\n        engine: input.engine,\n        snippet: item.alternative.snippet,\n      },\n    });\n    alternativeCount += 1;\n  }\n\n  /* ---- 6. discards ---- */\n  let discardCount = 0;\n\n  for (const item of [...rejected, ...contested]) {\n    const action = item.action;\n    drafts.push({\n      type: \"ExtractionDiscarded\",\n      payload: {\n        candidateKind: item.kind,\n        discardedBy: \"human\",\n        // A contested item is recorded as a discard with its reason attached, so it\n        // survives the run instead of vanishing when the queue is cleared. Phase 2\n        // reads these back out of the log to build the Contested queue properly.\n        rawText: contestedReason(action, item.snippet.text, item.key),\n        confidence: asConfidence(item.confidence),\n      },\n    });\n    discardCount += 1;\n  }\n\n  for (const discard of input.machineDiscards ?? []) {\n    drafts.push({\n      type: \"ExtractionDiscarded\",\n      payload: {\n        candidateKind: discard.kind,\n        discardedBy: discard.discardedBy,\n        rawText: discard.rawText,\n        confidence: discard.confidence,\n      },\n    });\n    discardCount += 1;\n  }\n\n  const nonMonotonic = drafts.filter(\n    (draft) =>\n      draft.type === \"JustificationAttached\" &&\n      (draft.payload as JustificationAttachedPayload).justification.outList.length > 0,\n  ).length;\n\n  return {\n    ok: true,\n    drafts,\n    reasons,\n    counts: {\n      premises: premiseCount,\n      decisions: decisionCount,\n      justifications: justificationSeq - state.counters.justifications,\n      alternatives: alternativeCount,\n      approvals,\n      edits,\n      rejections: rejected.length,\n      premiseConfirmations,\n      discards: discardCount,\n      events: drafts.length,\n      nonMonotonic,\n    },\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Justification lists                                                        */\n/* -------------------------------------------------------------------------- */\n\ninterface ResolvedRefs {\n  /** IN-list and OUT-list together, in the order the candidate listed them. This\n   *  is what `DecisionProposed.premiseIds` carries. */\n  readonly all: readonly PremiseId[];\n  readonly inList: readonly PremiseId[];\n  readonly outList: readonly PremiseId[];\n}\n\n/**\n * Turn local premise indices into ids, split into IN and OUT.\n *\n * The split is by the derived-premise marker: an OUT-list entry was inferred from\n * another premise rather than quoted, and `premise-linker.ts` says so in its text.\n * A premise the human DISCARDED is dropped from both lists rather than referenced\n * by id ΓÇö a justification that points at a premise nobody accepted rests on\n * nothing, and \"rests on nothing\" is indistinguishable from \"rests on something\n * unrecorded\" once the graph is written.\n */\nfunction resolvePremiseRefs(\n  refs: readonly number[],\n  items: readonly ResolvedCandidate[],\n  premiseIds: ReadonlyMap<string, PremiseId>,\n): ResolvedRefs {\n  const all: PremiseId[] = [];\n  const inList: PremiseId[] = [];\n  const outList: PremiseId[] = [];\n\n  for (const ref of refs) {\n    const item = items.find((candidate) => candidate.key === `premise:${ref}`);\n    if (item === undefined || item.premise === null) continue;\n    if (!isAccepted(item.action)) continue;\n\n    const id = premiseIds.get(item.key);\n    if (id === undefined) continue;\n\n    all.push(id);\n    if (isDerivedPremise(item.premise.predicate, item.premise.text)) outList.push(id);\n    else inList.push(id);\n  }\n\n  return { all, inList, outList };\n}\n\nfunction justificationReason(justification: Justification): string {\n  const parts = [\n    `${justification.inList.length} supporting premise${justification.inList.length === 1 ? \"\" : \"s\"}`,\n  ];\n  if (justification.outList.length > 0) {\n    parts.push(\n      `${justification.outList.length} excluded condition${justification.outList.length === 1 ? \"\" : \"s\"} ΓÇö non-monotonic, so it can be invalidated by the world rather than only by a contradiction`,\n    );\n  }\n  return `Attaching a justification for ${justification.consequent}: ${parts.join(\", \")}.`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Review events                                                              */\n/* -------------------------------------------------------------------------- */\n\n/**\n * A review event with its reason.\n *\n * Every one of the five review types is STATE_CHANGING, so `reason` is mandatory ΓÇö\n * and it should say WHICH item it was about, because the reason is what the audit\n * trail shows six months later when somebody asks why a decision is IN.\n */\nfunction reviewEvent<\n  T extends\n    | \"DecisionApproved\"\n    | \"DecisionEdited\"\n    | \"DecisionRejected\"\n    | \"PremiseConfirmed\"\n    | \"PremiseCorrected\",\n>(type: T, payload: NewEvent<T>[\"payload\"], reason: string, reasons: string[]): NewEvent<T> {\n  reasons.push(reason);\n  return { type, payload, reason };\n}\n\nfunction approvalReason(item: ResolvedCandidate, bulk: boolean): string {\n  const label =\n    item.decision === null ? item.key : `${item.decision.variable} ΓåÆ ${item.decision.value}`;\n  return bulk\n    ? `Approved ${label} in a bulk action, so it stays UNKNOWN rather than IN until it is approved individually.`\n    : `Approved ${label}: the extraction is accepted and the decision is asserted.`;\n}\n\n/** A contested item's raw text carries its reason, because `ExtractionDiscarded`\n *  has no reason field and the reason is the only thing that distinguishes \"the\n *  human disagreed\" from \"the human is not sure yet\". */\nfunction contestedReason(action: ReviewAction | null, snippet: string, fallback: string): string {\n  const base = snippet.length > 0 ? snippet : fallback;\n  if (action?.type === \"contest\") return `CONTESTED: ${action.reason} ΓÇö ${base}`;\n  if (action?.type === \"discard\") return `DISCARDED: ${action.reason} ΓÇö ${base}`;\n  return base;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Episodes                                                                   */\n/* -------------------------------------------------------------------------- */\n\nfunction episodeIdFor(\n  episodeIndex: number,\n  episodeIds: readonly (EpisodeId | null)[] | undefined,\n  state: GraphState,\n): EpisodeId {\n  const supplied = episodeIds?.[episodeIndex] ?? null;\n  if (supplied !== null) return supplied;\n  // The fold synthesises an episode from the decision's own snippet when the event\n  // names one that does not exist, so the safest fallback is the next id in\n  // sequence rather than a guess at an existing one.\n  return formatEpisodeId(state.counters.episodes + Math.max(1, episodeIndex + 1));\n}\n\nexport { PLACEHOLDER_EVENT_ID };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 17 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 17 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 17 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\record.ts"},"span":[3078,3087],"sourceCode":"/**\n * The agent-optimized record ΓÇö 5.3.\n *\n * Phase 5 ┬╖ sub-phase 5.3\n * Plan: plan/phase-5-export-compiler.md ┬º5.3\n * Docs: docs/01-prior-art-landscape.md ┬º4.5\n *\n * ---------------------------------------------------------------------------\n * SIX PROPERTIES, AND WHERE EACH COMES FROM\n *\n *   scoped to file globs      Phase 1 extraction + guard globs\n *   imperative, not prose     compiled from variable, value and rejected alternatives\n *   verifiable                Phase 4 guards ΓåÆ `verify-command.ts`   ΓåÉ nobody else can do this\n *   token-aware               `priority.ts` + `budget.ts`\n *   non-conflicting           Phase 2, enforced by `consistency-gate.ts`  ΓåÉ nor this\n *   addressable               WLD-0007, never renumbered, never reused\n *\n * Two of the six are satisfied automatically and they are the two that require a reasoning layer.\n * Everything else here is Markdown generation ΓÇö which is true and not the point.\n *\n * ---------------------------------------------------------------------------\n * THE `Because:` LINE CARRIES PREMISE IDS, NOT PROSE\n *\n * That is the single most important formatting decision in the file. An agent that reads\n * \"Because: single user (P-0002)\" can see WHAT WOULD HAVE TO CHANGE for this rule to stop\n * applying, and can tell you which record to supersede when it does. An agent that reads\n * \"Because: we're a small team\" can only repeat the sentence.\n *\n * The premise text is included alongside the id so the line is readable without a lookup, but the\n * id comes first and is never dropped ΓÇö a record whose justification is only prose has thrown\n * away the part that makes it checkable.\n *\n * ---------------------------------------------------------------------------\n * THE CLOSING LINE IS THE ANTI-RE-LITIGATION INSTRUCTION\n *\n * \"Do not re-litigate without superseding this record.\" That sentence is what makes the whole\n * exercise pay off: it tells the agent that disagreeing is allowed but has a FORM, and the form\n * is a recorded supersession rather than a quiet deviation in a pull request.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, ISODateString, PremiseId } from \"@/types/common\";\nimport type { Decision, DecisionLabel } from \"@/types/domain\";\nimport type { ExportRecord, RejectedBlockEntry } from \"@/types/export\";\nimport { verifyCommandFor } from \"./verify-command\";\n\nexport interface RecordInput {\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly decision: Decision;\n  readonly label: DecisionLabel;\n  readonly tier: \"inline\" | \"index\";\n  readonly priority: number;\n  readonly now: number;\n}\n\n/**\n * Build one export record.\n *\n * Pure: it reads the graph and returns a record. It does not decide inclusion, ordering or\n * budget ΓÇö `cif.ts` does that ΓÇö so the same decision renders identically whichever emitter\n * asks for it.\n */\nexport function recordFor(input: RecordInput): ExportRecord {\n  const { state, decision, label } = input;\n\n  const premises = premisesOf(state, decision.id);\n  const rejected = rejectedOf(state, decision.id);\n\n  let passing = 0;\n  let total = 0;\n  let lastVerifiedAt: ISODateString | undefined;\n\n  for (const guardId of decision.guardIds) {\n    const guard = state.guards.get(guardId);\n    if (guard === undefined) continue;\n    if (guard.lifecycle !== \"accepted\") continue;\n    if (guard.disabledByDecisionLabel) continue;\n\n    total += 1;\n    if (guard.lastRun === undefined) continue;\n    if (guard.lastRun.outcome === \"pass\") passing += 1;\n\n    if (lastVerifiedAt === undefined || guard.lastRun.ranAt > lastVerifiedAt) {\n      lastVerifiedAt = guard.lastRun.ranAt;\n    }\n  }\n\n  const guards = acceptedGuardsOf(state, decision.id);\n  const verify = verifyCommandFor(decision.id, guards);\n\n  return {\n    id: decision.id,\n    imperative: imperativeFor(decision, rejected),\n    appliesTo: decision.appliesTo,\n    becausePremiseIds: premises.map((entry) => entry.id),\n    becauseText:\n      premises.length === 0\n        ? \"\"\n        : premises.map((entry) => `${entry.text} (${entry.id})`).join(\", \"),\n    rejected: rejected.map((entry) =>\n      entry.why === undefined ? { value: entry.value } : { value: entry.value, why: entry.why },\n    ),\n    ...(verify === null ? {} : { verifyCommand: verify.command }),\n    status: label,\n    guardsPassing: passing,\n    guardsTotal: total,\n    ...(lastVerifiedAt === undefined ? {} : { lastVerifiedAt }),\n    contestedPremise: premises.some((entry) => entry.contested),\n    failingGuard: guards.some(\n      (guard) => guard.lastRun !== undefined && guard.lastRun.outcome === \"fail\",\n    ),\n    tier: input.tier,\n    priority: input.priority,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* The imperative form                                                        */\n/* -------------------------------------------------------------------------- */\n\n/**\n * \"MUST use SQLite (better-sqlite3). MUST NOT introduce Postgres.\"\n *\n * Normative keywords an agent can follow beat a paragraph it has to summarise first. The\n * decision's own `statement` is used when it is already imperative, because a human-written or\n * transcript-derived statement usually reads better than a generated one ΓÇö and overriding it\n * would discard the only phrasing anyone actually said out loud.\n */\nexport function imperativeFor(\n  decision: Decision,\n  rejected: readonly { value: string; why?: string }[],\n): string {\n  const parts: string[] = [];\n\n  const statement = decision.statement.trim();\n  if (isAlreadyImperative(statement)) {\n    parts.push(`${statement.replace(/\\.\\s*$/, \"\")}.`);\n  } else {\n    parts.push(`MUST use ${decision.value}.`);\n  }\n\n  /* The MUST NOT clause is compiled from the rejected alternatives, which is why alternatives are\n   * indexed first-class: without them there is nothing to forbid, and an agent is free to\n   * propose the thing you already turned down. */\n  if (rejected.length > 0) {\n    const names = rejected.map((entry) => entry.value).slice(0, MUST_NOT_LIMIT);\n    parts.push(\n      `MUST NOT introduce ${names.join(\", \")}${rejected.length > MUST_NOT_LIMIT ? ` (and ${rejected.length - MUST_NOT_LIMIT} other rejected options ΓÇö see the Rejected section)` : \"\"}.`,\n    );\n  }\n\n  return parts.join(\" \");\n}\n\n/** Cap on how many rejections appear in the headline. More than three and the sentence stops\n *  being an instruction and starts being a list ΓÇö the full list is one section below. */\nexport const MUST_NOT_LIMIT = 3;\n\nfunction isAlreadyImperative(statement: string): boolean {\n  return /^(MUST|DO NOT|USE|AVOID|ALWAYS|NEVER|PREFER|KEEP)\\b/i.test(statement);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Premises and alternatives                                                  */\n/* -------------------------------------------------------------------------- */\n\ninterface PremiseEntry {\n  readonly id: PremiseId;\n  readonly text: string;\n  readonly label: DecisionLabel;\n  /** True when the premise is contested ΓÇö surfaced in the export so the agent knows this\n   *  particular justification is under review. */\n  readonly contested: boolean;\n}\n\nexport function premisesOf(state: GraphState, decisionId: DecisionId): readonly PremiseEntry[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: PremiseEntry[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n\n      const premise = state.premises.get(premiseId);\n      if (premise === undefined) continue;\n\n      out.push({\n        id: premiseId,\n        text: premise.text,\n        label: premise.label,\n        /* \"Contested\" means neither confirmed nor refuted ΓÇö the decision rests on something the\n         * log has not settled. `GraphState` has no `contestedPremises` set; UNKNOWN is the label\n         * that carries it, and `rejected-block.ts` reads it the same way so the two cannot\n         * disagree about which rejections are under review. */\n        contested: premise.label === \"UNKNOWN\",\n      });\n    }\n  }\n\n  return out;\n}\n\nexport function rejectedOf(\n  state: GraphState,\n  decisionId: DecisionId,\n): readonly { value: string; why?: string }[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: { value: string; why?: string }[] = [];\n\n  for (const alternativeId of decision.alternativeIds) {\n    const alternative = state.alternatives.get(alternativeId);\n    if (alternative === undefined) continue;\n    out.push(\n      alternative.whyRejected === undefined\n        ? { value: alternative.value }\n        : { value: alternative.value, why: alternative.whyRejected },\n    );\n  }\n\n  return out;\n}\n\nfunction acceptedGuardsOf(state: GraphState, decisionId: DecisionId) {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out = [];\n  for (const guardId of decision.guardIds) {\n    const guard = state.guards.get(guardId);\n    if (guard === undefined) continue;\n    out.push(guard);\n  }\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The status line                                                            */\n/* -------------------------------------------------------------------------- */\n\n/**\n * \"Status: IN ┬╖ sound ┬╖ guards 2/2 passing ┬╖ last verified 2026-10-21\"\n *\n * Carries the annotations the consistency gate asked for ΓÇö contested premise, failing guard ΓÇö\n * INLINE rather than in a footnote. An agent reading the record has to see them at the point of\n * use; a warning three sections away is a warning that does not exist.\n */\nexport function renderStatus(record: ExportRecord): string {\n  const parts: string[] = [`Status: ${record.status}`];\n\n  if (record.status === \"IN\") parts.push(\"sound\");\n  else if (record.status === \"UNKNOWN\") parts.push(\"justification incomplete\");\n  else if (record.status === \"UNFOUNDED\") parts.push(\"justification never reaches a premise\");\n\n  if (record.guardsTotal === 0) {\n    parts.push(\"no guards ΓÇö UNVERIFIABLE\");\n  } else {\n    parts.push(`guards ${record.guardsPassing}/${record.guardsTotal} passing`);\n  }\n\n  if (record.lastVerifiedAt !== undefined)\n    parts.push(`last verified ${record.lastVerifiedAt.slice(0, 10)}`);\n\n  if (record.contestedPremise) parts.push(\"PREMISE CONTESTED\");\n  if (record.failingGuard) parts.push(\"VERIFY CURRENTLY FAILS\");\n\n  return parts.join(\" ┬╖ \");\n}\n\n/** The closing instruction. Present on every inline record. */\nexport const ANTI_RELITIGATION = \"Do not re-litigate without superseding this record.\";\n\nexport type { RejectedBlockEntry };\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\premise-linker.ts"},"span":[6292,6304],"sourceCode":"/**\n * Premise linking ΓÇö 1.4, the IN-list and the OUT-list.\n *\n * Phase 1 ┬╖ sub-phase 1.4\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.4\n *\n * ---------------------------------------------------------------------------\n * THE OUT-LIST IS THE SUBTLE PART AND MUST NOT BE SKIPPED\n *\n * \"Use SQLite\" is justified by\n *\n *     IN:  [ scale.single_user, deployment.local_only ]\n *     OUT: [ scale.concurrent_writers ]\n *\n * A justification with a non-empty OUT-list is Doyle's NON-MONOTONIC justification,\n * and it is the only mechanism in the system that detects invalidation when the\n * user never states a contradiction. Gate (a) fires when YOU contradict yourself.\n * Gate (c) fires when REALITY does ΓÇö and gate (c) needs an OUT-list, because what\n * reality does is make one of those excluded conditions true.\n *\n * Concretely: the day the app gets a second writer, `scale.concurrent_writers`\n * becomes IN. The justification is then invalid ΓÇö an OUT-list node is IN ΓÇö SQLite\n * is relabelled OUT, and the cascade walks to everything that rested on it. No\n * event was ever recorded saying \"SQLite is wrong\". The world just moved.\n *\n * ---------------------------------------------------------------------------\n * WHERE THE OUT-LIST PREMISE COMES FROM\n *\n * Nobody says \"we exclude concurrent writers\". They say \"it's one person, one\n * machine, one log\". So the excluded condition is DERIVED, from\n * `src/ontology/data/exclusions.ts`: a curated table pairing each supporting\n * predicate with the condition that would break it, in words.\n *\n * The derived node reuses the SOURCE premise's snippet rather than inventing one.\n * That keeps the evidence contract intact ΓÇö the quote is verbatim and resolves ΓÇö at\n * the cost of a node whose text is a quote about something adjacent. The trade is\n * deliberate: a fabricated snippet is a lie the user cannot detect, and an adjacent\n * quote is an inference the user can see labelled as one.\n *\n * ---------------------------------------------------------------------------\n * POLICIES THAT ARE EASY TO GET BACKWARDS\n *\n *   ΓÇó A premise with `negative` polarity (\"no other users\") is a TRUE FACT about a\n *     bound, so it goes in the IN-list. Its exclusion rule supplies the OUT-list\n *     entry. It does NOT go in the OUT-list itself ΓÇö an OUT-list node is one that\n *     must NOT hold, and \"no other users\" does hold.\n *\n *   ΓÇó One OUT-list entry per supporting premise, from its PRIMARY exclusion.\n *     `scale.single_user` is broken by concurrent writers AND by multi-tenancy;\n *     emitting both doubles the review burden for one decision. The rest are\n *     reachable from the decision card, which lists all exclusions for its\n *     premises.\n *\n *   ΓÇó An OUT-list entry whose predicate is not world-observable is still emitted.\n *     Only a human can retract it (Phase 2), but recording it is what lets the\n *     human SEE what the decision assumed away.\n * ---------------------------------------------------------------------------\n */\n\nimport type { PremiseCandidate } from \"@/ai/types\";\nimport { canonicalPredicate } from \"@/ontology/canonicalize\";\nimport { type ExclusionRule, exclusionsFor, primaryExclusion } from \"@/ontology/data/exclusions\";\nimport { lookupPredicate } from \"@/ontology/data/premise-types\";\nimport { VARIABLE_META } from \"@/ontology/data/variables\";\nimport type { PremiseId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { DecisionVariable, PremiseType } from \"@/types/domain\";\nimport type { RecoveredDecision } from \"./decisions\";\nimport type { RecoveredPremise } from \"./premises\";\n\nexport interface LinkedPremise {\n  readonly premise: RecoveredPremise;\n  readonly supports: boolean;\n}\n\n/**\n * An OUT-list entry derived from a supporting premise.\n *\n * This is a CANDIDATE, not a node: it goes through the same review gate and the\n * same identity ladder as everything else, and it can be discarded like anything\n * else. An exclusion the user disagrees with is a wrong exclusion, and silently\n * applying it would put a phantom constraint on a real decision.\n */\nexport interface ExcludedPremise {\n  readonly candidate: PremiseCandidate;\n  readonly type: PremiseType;\n  readonly predicate: string;\n  /** The condition that would break the source premise, in words. Shown verbatim\n   *  in the decision card's EXCLUDES row. */\n  readonly text: string;\n  /** Reused from the source premise. See the file header. */\n  readonly snippet: RecoveredPremise[\"candidate\"][\"snippet\"];\n  readonly sourcePremiseIndex: number;\n  readonly rule: ExclusionRule;\n  readonly confidence: ReturnType<typeof asConfidence>;\n}\n\nexport interface JustificationLink {\n  /** Index into the recovered decisions. */\n  readonly decisionIndex: number;\n  /** Indices into the recovered premises ΓÇö the IN-list. */\n  readonly inRefs: readonly number[];\n  /** Indices into `excluded` ΓÇö the OUT-list. */\n  readonly outRefs: readonly number[];\n}\n\nexport interface PremiseLinking {\n  readonly links: readonly JustificationLink[];\n  readonly excluded: readonly ExcludedPremise[];\n  /** Premises that could not be attached to any decision in the episode. They are\n   *  still asserted ΓÇö a premise with no decision yet is a fact about the project ΓÇö\n   *  but they get no justification, and that is worth reporting. */\n  readonly unlinked: readonly number[];\n}\n\n/** An OUT-list entry is an inference, so it inherits less than full confidence from\n *  its source. Below the review tier either way; the number matters for ranking. */\nconst EXCLUSION_CONFIDENCE_FACTOR = 0.8;\n\n/* -------------------------------------------------------------------------- */\n/* Linking                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Attach the episode's premises to the episode's decisions.\n *\n * Episode-scoped, not transcript-scoped: a premise stated in one negotiation is\n * evidence for the decision made in THAT negotiation. Attaching every premise in a\n * transcript to every decision in it would produce a justification that looks\n * thorough and means nothing ΓÇö and would make the cascade fire across the whole\n * graph whenever any premise moved.\n */\nexport function linkPremises(\n  decisions: readonly RecoveredDecision[],\n  premises: readonly RecoveredPremise[],\n): PremiseLinking {\n  if (decisions.length === 0) {\n    return { links: [], excluded: [], unlinked: premises.map((_, i) => i) };\n  }\n\n  const excluded: ExcludedPremise[] = [];\n  const links: JustificationLink[] = [];\n  const attached = new Set<number>();\n\n  for (let decisionIndex = 0; decisionIndex < decisions.length; decisionIndex += 1) {\n    const decision = decisions[decisionIndex];\n    if (decision === undefined) continue;\n\n    const inRefs: number[] = [];\n    const outRefs: number[] = [];\n\n    for (let premiseIndex = 0; premiseIndex < premises.length; premiseIndex += 1) {\n      const premise = premises[premiseIndex];\n      if (premise === undefined) continue;\n\n      if (!relevantTo(decision, premise)) continue;\n\n      inRefs.push(premiseIndex);\n      attached.add(premiseIndex);\n\n      const exclusion = deriveExclusion(premise, premiseIndex);\n      if (exclusion === null) continue;\n\n      const duplicate = excluded.findIndex(\n        (existing) =>\n          existing.predicate === exclusion.predicate &&\n          existing.sourcePremiseIndex === exclusion.sourcePremiseIndex,\n      );\n      if (duplicate >= 0) {\n        outRefs.push(duplicate);\n        continue;\n      }\n\n      outRefs.push(excluded.length);\n      excluded.push(exclusion);\n    }\n\n    links.push({ decisionIndex, inRefs, outRefs });\n  }\n\n  const unlinked: number[] = [];\n  for (let i = 0; i < premises.length; i += 1) {\n    if (!attached.has(i)) unlinked.push(i);\n  }\n\n  return { links, excluded, unlinked };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Relevance                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Is this premise evidence for this decision?\n *\n * Three routes, in order of strength:\n *\n *   1. the decision's own rationale clause CONTAINS the premise text ΓÇö the human\n *      wrote the reason and the cue found it independently, which is two signals\n *      agreeing;\n *   2. the premise's type is one the ontology lists as typical for the decision's\n *      variable ΓÇö `scale` and `deployment` for DATABASE;\n *   3. the premise is in the same episode and the decision has no other premises\n *      at all, so there is nothing better to attach.\n *\n * Route 3 is what stops a decision from being asserted with an empty justification\n * when the transcript plainly stated a constraint. An empty IN-list is not a\n * neutral outcome: it means the truth-maintenance layer has nothing to maintain,\n * which is the failure this whole phase exists to avoid.\n */\nfunction relevantTo(decision: RecoveredDecision, premise: RecoveredPremise): boolean {\n  const rationale = decision.fields.rationale?.text.toLowerCase() ?? \"\";\n  const premiseText = premise.candidate.text.toLowerCase();\n\n  if (rationale.length > 0 && premiseText.length > 0) {\n    if (rationale.includes(premiseText)) return true;\n    if (sharesContentWords(rationale, premiseText)) return true;\n  }\n\n  if (decision.candidate.variable !== \"OTHER\") {\n    const typical = typicalPremiseTypes(decision.candidate.variable);\n    if (typical.includes(premise.candidate.type)) return true;\n  }\n\n  // A world-observable premise in the same episode is relevant by default: it is\n  // the kind of thing a guard could later falsify, and attaching it is what makes\n  // gate (c) possible at all.\n  return (\n    premise.candidate.type === \"scale\" ||\n    premise.candidate.type === \"deployment\" ||\n    premise.candidate.type === \"capability\" ||\n    premise.candidate.type === \"external\"\n  );\n}\n\nfunction sharesContentWords(a: string, b: string): boolean {\n  const words = (text: string): Set<string> =>\n    new Set(\n      text\n        .split(/[^a-z0-9]+/i)\n        .map((w) => w.toLowerCase())\n        .filter((w) => w.length > 3),\n    );\n\n  const left = words(a);\n  const right = words(b);\n  for (const word of left) {\n    if (right.has(word)) return true;\n  }\n  return false;\n}\n\nfunction typicalPremiseTypes(variable: DecisionVariable): readonly PremiseType[] {\n  return VARIABLE_META[variable].typicalPremises;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Exclusion derivation                                                       */\n/* -------------------------------------------------------------------------- */\n\nfunction deriveExclusion(premise: RecoveredPremise, premiseIndex: number): ExcludedPremise | null {\n  const rule = primaryExclusion(premise.candidate.predicate);\n  if (rule === null) return null;\n\n  const predicate = canonicalPredicate(rule.breaksType, rule.breaksPredicate);\n  if (lookupPredicate(predicate) === null) return null;\n\n  const value = rule.breaksValue ?? negateValue(premise.candidate.value);\n\n  const candidate: PremiseCandidate = {\n    type: rule.breaksType,\n    predicate,\n    ...(value === undefined ? {} : { value }),\n    // The rule's own wording, plus the verbatim quote that produced it. The quote\n    // is what makes the inference checkable; the wording is what makes it readable.\n    text: `${rule.text} ΓÇö excluded by \"${premise.candidate.text}\"`,\n    confidence: asConfidence(premise.candidate.confidence * EXCLUSION_CONFIDENCE_FACTOR),\n    snippet: premise.candidate.snippet,\n    // Always reviewed. A derived constraint on a real decision is exactly the kind\n    // of thing a human should see before it can trigger a cascade.\n    needsReview: true,\n  };\n\n  return {\n    candidate,\n    type: rule.breaksType,\n    predicate,\n    text: rule.text,\n    snippet: premise.candidate.snippet,\n    sourcePremiseIndex: premiseIndex,\n    rule,\n    confidence: candidate.confidence,\n  };\n}\n\n/** A boolean premise's exclusion is its negation. A counted premise has no\n *  mechanical negation ΓÇö the curated table supplies one, and if it does not, there\n *  is no honest OUT-list entry to emit. */\nfunction negateValue(value: string | number | boolean | undefined): boolean | undefined {\n  if (typeof value === \"boolean\") return !value;\n  return undefined;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function describeLinking(\n  linking: PremiseLinking,\n  decisionCount: number,\n  premiseCount: number,\n): string {\n  const withOut = linking.links.filter((link) => link.outRefs.length > 0).length;\n  const parts = [\n    `${linking.links.length} justification${linking.links.length === 1 ? \"\" : \"s\"} over ${decisionCount} decision${decisionCount === 1 ? \"\" : \"s\"}`,\n    `${linking.excluded.length} excluded condition${linking.excluded.length === 1 ? \"\" : \"s\"}`,\n  ];\n  if (withOut > 0) {\n    parts.push(\n      `${withOut} decision${withOut === 1 ? \"\" : \"s\"} non-monotonic ΓÇö gate (c) can fire on ${withOut === 1 ? \"it\" : \"them\"}`,\n    );\n  } else {\n    parts.push(\"no OUT-lists ΓÇö gate (c) cannot fire on anything from this transcript\");\n  }\n  if (linking.unlinked.length > 0) {\n    parts.push(`${linking.unlinked.length} of ${premiseCount} premises attached to no decision`);\n  }\n  return parts.join(\" ┬╖ \");\n}\n\n/** Every exclusion available for a premise, not just the primary one. The decision\n *  card lists these so a user can see what else the decision assumes away. */\nexport function allExclusionsFor(predicate: string): readonly ExclusionRule[] {\n  return exclusionsFor(predicate);\n}\n\n/** Which premise ids a committed justification should carry. Called by\n *  `commit.ts` once local indices have become real ids. */\nexport interface ResolvedJustification {\n  readonly decisionIndex: number;\n  readonly inList: readonly PremiseId[];\n  readonly outList: readonly PremiseId[];\n}\n\nexport function resolveJustification(\n  link: JustificationLink,\n  premiseIds: readonly (PremiseId | null)[],\n  excludedIds: readonly (PremiseId | null)[],\n): ResolvedJustification {\n  const inList = link.inRefs\n    .map((index) => premiseIds[index] ?? null)\n    .filter((id): id is PremiseId => id !== null);\n\n  const outList = link.outRefs\n    .map((index) => excludedIds[index] ?? null)\n    .filter((id): id is PremiseId => id !== null);\n\n  return { decisionIndex: link.decisionIndex, inList, outList };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 16 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 16 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 16 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\noise.ts"},"span":[9103,9113],"sourceCode":"/**\n * Tool-call, diff and stack-trace collapsing ΓÇö 1.1.\n *\n * Phase 1 ┬╖ sub-phase 1.1\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.1\n *\n * ---------------------------------------------------------------------------\n * COLLAPSED FOR EXTRACTION, RETAINED VERBATIM FOR SNIPPETS\n *\n * Those are two different requirements and the design has to satisfy both:\n *\n *   ΓÇó A 400-line `npm install` output between two turns is not decision text.\n *     Left in, it dilutes every cue scan, inflates the chunk count, and gives the\n *     episode segmenter a 400-line \"topic\" to split on. It gets replaced by a\n *     placeholder in the text the recognisers read.\n *\n *   ΓÇó But a decision CAN cite it ΓÇö \"we dropped the ORM because the migration\n *     output was 90 lines of ALTER TABLE\" is a real rationale, and the evidence\n *     contract requires that quote to resolve. So the raw characters stay in\n *     `NormalizedTranscript.raw`, and `NoiseRegion.raw` keeps the verbatim text.\n *\n * The offset map is what makes both true at once: the placeholder occupies\n * normalised characters that map to a raw range, and `spanFrom` refuses to build a\n * span across that discontinuity unless the caller asks for the raw text\n * explicitly. See `offset-map.ts`.\n *\n * ---------------------------------------------------------------------------\n * WHY DETECTION IS CONSERVATIVE\n *\n * A false collapse destroys evidence permanently ΓÇö the recogniser never sees the\n * text. A missed collapse only costs precision. So every detector here requires\n * either a strong marker or a minimum run length, and anything ambiguous is left\n * alone. The stats are reported so a transcript that collapsed 80% of itself is\n * visibly suspicious in the review header.\n * ---------------------------------------------------------------------------\n */\n\nimport type { OffsetMapBuilder } from \"./offset-map\";\nimport { type LineSpan, linesWithOffsets } from \"./speakers\";\nimport type { NoiseKind, NoiseRegion } from \"./types\";\n\n/** Shortest run of lines that may be collapsed. Below this, leave it: a\n *  three-line diff is often quoted deliberately. */\nconst MIN_RUN_LINES = 4;\n\n/** A diff or a file listing may be shorter if its marker density is perfect. */\nconst MIN_DENSE_RUN_LINES = 3;\n\nconst TOOL_OPEN = /^\\s*(?:ΓÅ║|ΓùÅ)\\s*[A-Za-z][\\w.-]*\\s*\\(/u;\nconst TOOL_CONTINUATION = /^\\s*ΓÄ┐/u;\nconst TOOL_LABEL =\n  /^\\s*(?:Bash|Read|Write|Edit|Grep|Glob|LS|WebFetch|WebSearch|Task|TodoWrite|NotebookEdit|MultiEdit)\\s*\\(/;\n\nconst DIFF_HEADER = /^(?:diff --git|index [0-9a-f]{7,}\\.\\.|---\\s+a\\/|\\+\\+\\+\\s+b\\/|@@\\s)/;\nconst DIFF_LINE = /^[+-]\\s?\\S/;\n\nconst TRACE_START =\n  /^\\s*(?:at\\s+[\\w$.<>/[\\]-]+\\s*\\(|(?:[\\w$.]+\\.)?(?:Error|Exception|Failure|panic|Traceback)\\b)/;\nconst TRACE_FRAME = /^\\s*(?:at\\s+|File\\s+\"|Caused by:|\\s+from\\s+|\\tat\\s)/;\nconst TRACE_PATH =\n  /^\\s*(?:node_modules|dist|build|src|\\.\\/|\\.\\.\\/|\\/)[\\w./@-]+\\.(?:ts|tsx|js|jsx|py|rb|go|rs|java|c|cpp|h)[:(]\\d+/;\n\nconst FILE_LINE =\n  /^\\s*(?:[-*ΓÇó]\\s+)?[\\w.@/-]+\\.(?:ts|tsx|js|jsx|json|md|py|rb|go|rs|css|html|yml|yaml|toml|svg|sh)(?:\\s+\\(\\d+\\s+(?:lines?|bytes?)\\))?\\s*$/;\nconst FILE_HEADER = /^\\s*(?:file listing|files changed|\\d+ files? changed)/i;\n\nconst INDENTED_OUTPUT = /^\\s{2,}\\S/;\n\n/* -------------------------------------------------------------------------- */\n/* Result                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface NoiseScan {\n  readonly regions: readonly NoiseRegion[];\n  readonly charsCollapsed: number;\n  readonly byKind: Readonly<Record<NoiseKind, number>>;\n}\n\nexport const EMPTY_NOISE_SCAN: NoiseScan = {\n  regions: [],\n  charsCollapsed: 0,\n  byKind: { \"tool-call\": 0, diff: 0, \"stack-trace\": 0, \"long-output\": 0, \"file-listing\": 0 },\n};\n\n/** A single run of consecutive noisy lines. */\ninterface Run {\n  readonly kind: NoiseKind;\n  readonly startLine: number;\n  readonly endLine: number;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Scan                                                                       */\n/* -------------------------------------------------------------------------- */\n\n/** Find the noisy runs. Does not modify anything ΓÇö `collapseNoise` applies them. */\nexport function scanNoise(raw: string): readonly Run[] {\n  const lines = linesWithOffsets(raw);\n  const runs: Run[] = [];\n\n  let i = 0;\n  while (i < lines.length) {\n    const detected =\n      detectToolCall(lines, i) ??\n      detectStackTrace(lines, i) ??\n      detectDiff(lines, i) ??\n      detectFileListing(lines, i) ??\n      detectLongOutput(lines, i);\n\n    if (detected === null) {\n      i += 1;\n      continue;\n    }\n    runs.push(detected);\n    i = detected.endLine + 1;\n  }\n\n  return runs;\n}\n\n/**\n * Apply the runs: produce the extraction text and the retained regions.\n *\n * The builder advances the offset map through `keep()` for prose and `skip()` for\n * each collapsed run, which is the only way the map stays exact.\n */\nexport function collapseNoise(\n  raw: string,\n  runs: readonly Run[],\n  builder: OffsetMapBuilder,\n  parts: string[],\n): NoiseScan {\n  if (runs.length === 0) {\n    builder.keep(raw.length);\n    parts.push(raw);\n    return EMPTY_NOISE_SCAN;\n  }\n\n  const lines = linesWithOffsets(raw);\n  const regions: NoiseRegion[] = [];\n  const byKind: Record<NoiseKind, number> = {\n    \"tool-call\": 0,\n    diff: 0,\n    \"stack-trace\": 0,\n    \"long-output\": 0,\n    \"file-listing\": 0,\n  };\n  let charsCollapsed = 0;\n  let cursor = 0;\n\n  for (const run of runs) {\n    const first = lines[run.startLine];\n    const last = lines[run.endLine];\n    if (first === undefined || last === undefined) continue;\n\n    const start = first.start;\n    const end = last.end;\n    if (start < cursor) continue; // overlapping runs: the first one wins\n\n    // Prose before this run.\n    if (start > cursor) {\n      const prose = raw.slice(cursor, start);\n      builder.keep(prose.length);\n      parts.push(prose);\n    }\n\n    const regionRaw = raw.slice(start, end);\n    const lineCount = run.endLine - run.startLine + 1;\n    const placeholder = placeholderFor(run.kind, lineCount);\n\n    builder.skip(regionRaw.length, placeholder.length);\n    parts.push(placeholder);\n\n    regions.push({\n      kind: run.kind,\n      rawStart: start,\n      rawEnd: end,\n      raw: regionRaw,\n      replacedWith: placeholder,\n    });\n\n    byKind[run.kind] += 1;\n    charsCollapsed += regionRaw.length;\n    cursor = end;\n  }\n\n  if (cursor < raw.length) {\n    const tail = raw.slice(cursor);\n    builder.keep(tail.length);\n    parts.push(tail);\n  }\n\n  return { regions, charsCollapsed, byKind };\n}\n\n/** The placeholder is stable text rather than a counter, so the same transcript\n *  normalises to the same string on every run. Determinism is what makes the\n *  local path's output comparable across runs and fixtures. */\nexport function placeholderFor(kind: NoiseKind, lineCount: number): string {\n  const label: Record<NoiseKind, string> = {\n    \"tool-call\": \"tool call\",\n    diff: \"diff\",\n    \"stack-trace\": \"stack trace\",\n    \"long-output\": \"command output\",\n    \"file-listing\": \"file listing\",\n  };\n  return `\\n[${label[kind]} ┬╖ ${lineCount} lines collapsed]\\n`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Detectors                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction detectToolCall(lines: readonly LineSpan[], at: number): Run | null {\n  const line = lines[at];\n  if (line === undefined) return null;\n  if (\n    !TOOL_OPEN.test(line.text) &&\n    !TOOL_LABEL.test(line.text) &&\n    !TOOL_CONTINUATION.test(line.text)\n  )\n    return null;\n\n  let end = at;\n  for (let i = at + 1; i < lines.length; i += 1) {\n    const next = lines[i];\n    if (next === undefined) break;\n    const continues =\n      TOOL_CONTINUATION.test(next.text) || INDENTED_OUTPUT.test(next.text) || next.blank;\n    // A blank line only continues the run if something noisy follows it.\n    if (!continues) break;\n    if (next.blank && !hasNoiseWithin(lines, i + 1, 2)) break;\n    end = i;\n  }\n\n  if (end - at + 1 < 2) return null; // a lone tool header is a decision-adjacent fact, keep it\n  return { kind: \"tool-call\", startLine: at, endLine: end };\n}\n\nfunction detectStackTrace(lines: readonly LineSpan[], at: number): Run | null {\n  const line = lines[at];\n  if (line === undefined) return null;\n  if (!TRACE_START.test(line.text) && !TRACE_PATH.test(line.text)) return null;\n\n  let end = at;\n  let frames = 0;\n  for (let i = at + 1; i < lines.length; i += 1) {\n    const next = lines[i];\n    if (next === undefined) break;\n    if (TRACE_FRAME.test(next.text) || TRACE_PATH.test(next.text)) {\n      frames += 1;\n      end = i;\n      continue;\n    }\n    if (next.blank && hasTraceWithin(lines, i + 1, 2)) {\n      end = i;\n      continue;\n    }\n    break;\n  }\n\n  if (frames < 2 || end - at + 1 < MIN_RUN_LINES) return null;\n  return { kind: \"stack-trace\", startLine: at, endLine: end };\n}\n\nfunction detectDiff(lines: readonly LineSpan[], at: number): Run | null {\n  const line = lines[at];\n  if (line === undefined) return null;\n\n  const startsWithHeader = DIFF_HEADER.test(line.text);\n  if (!startsWithHeader && !DIFF_LINE.test(line.text)) return null;\n\n  let end = at;\n  let diffLines = 0;\n  for (let i = at; i < lines.length; i += 1) {\n    const candidate = lines[i];\n    if (candidate === undefined) break;\n    if (DIFF_HEADER.test(candidate.text) || DIFF_LINE.test(candidate.text)) {\n      diffLines += 1;\n      end = i;\n      continue;\n    }\n    if (candidate.blank && i > at) {\n      end = i;\n      continue;\n    }\n    break;\n  }\n\n  const length = end - at + 1;\n  const dense = diffLines / Math.max(length, 1);\n  if (dense < 0.6) return null;\n  if (length < (startsWithHeader ? MIN_DENSE_RUN_LINES : MIN_RUN_LINES)) return null;\n  return { kind: \"diff\", startLine: at, endLine: end };\n}\n\nfunction detectFileListing(lines: readonly LineSpan[], at: number): Run | null {\n  const line = lines[at];\n  if (line === undefined) return null;\n\n  const startsWithHeader = FILE_HEADER.test(line.text);\n  if (!startsWithHeader && !FILE_LINE.test(line.text)) return null;\n\n  let end = at;\n  let fileLines = 0;\n  for (let i = at; i < lines.length; i += 1) {\n    const candidate = lines[i];\n    if (candidate === undefined) break;\n    if (FILE_LINE.test(candidate.text)) {\n      fileLines += 1;\n      end = i;\n      continue;\n    }\n    if (startsWithHeader && i === at) {\n      end = i;\n      continue;\n    }\n    break;\n  }\n\n  const length = end - at + 1;\n  if (fileLines < MIN_DENSE_RUN_LINES) return null;\n  if (fileLines / Math.max(length, 1) < 0.7) return null;\n  return { kind: \"file-listing\", startLine: at, endLine: end };\n}\n\n/**\n * A long run of indented, non-prose lines with no decision cue in it.\n *\n * The weakest detector, so it has the highest bar: 15 lines minimum, and it stops\n * immediately at anything that looks like a sentence. Command output is what this\n * catches ΓÇö the `npm install` wall, the test-runner summary, the `ls -R`.\n */\nfunction detectLongOutput(lines: readonly LineSpan[], at: number): Run | null {\n  const line = lines[at];\n  if (line === undefined || line.blank) return null;\n  if (!INDENTED_OUTPUT.test(line.text)) return null;\n  if (TOOL_OPEN.test(line.text) || DIFF_LINE.test(line.text)) return null;\n\n  let end = at;\n  let count = 0;\n  for (let i = at; i < lines.length; i += 1) {\n    const candidate = lines[i];\n    if (candidate === undefined) break;\n    if (candidate.blank) {\n      end = i;\n      continue;\n    }\n    if (!INDENTED_OUTPUT.test(candidate.text)) break;\n    if (looksLikeProse(candidate.text)) break;\n    count += 1;\n    end = i;\n  }\n\n  if (count < 15) return null;\n  return { kind: \"long-output\", startLine: at, endLine: end };\n}\n\n/** Ends in sentence punctuation, or has a subject-verb shape. Prose is never\n *  collapsed, because prose is where decisions live. */\nfunction looksLikeProse(text: string): boolean {\n  const trimmed = text.trim();\n  if (/[.!?]$/.test(trimmed) && trimmed.split(/\\s+/).length > 6) return true;\n  return /^(so|then|because|but|and|we|i|you|the|this|that|if|when|let'?s)\\b/i.test(trimmed);\n}\n\nfunction hasNoiseWithin(lines: readonly LineSpan[], from: number, depth: number): boolean {\n  for (let i = from; i < Math.min(from + depth, lines.length); i += 1) {\n    const candidate = lines[i];\n    if (candidate === undefined) continue;\n    if (TOOL_CONTINUATION.test(candidate.text) || INDENTED_OUTPUT.test(candidate.text)) return true;\n  }\n  return false;\n}\n\nfunction hasTraceWithin(lines: readonly LineSpan[], from: number, depth: number): boolean {\n  for (let i = from; i < Math.min(from + depth, lines.length); i += 1) {\n    const candidate = lines[i];\n    if (candidate === undefined) continue;\n    if (TRACE_FRAME.test(candidate.text) || TRACE_PATH.test(candidate.text)) return true;\n  }\n  return false;\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\pipeline.ts"},"span":[4534,4547],"sourceCode":"/**\n * The extraction pipeline ΓÇö the orchestrator.\n *\n * Phase 1 ┬╖ all sub-phases\n * Plan: plan/phase-1-extraction-pipeline.md\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS OWNS\n *\n * The stages, in order, and the telemetry between them:\n *\n *     normalise ΓåÆ segment ΓåÆ recognise ΓåÆ validate ΓåÆ score ΓåÆ resolve ΓåÆ review queue\n *\n * The recognisers live in `src/ai/local/` and `src/ai/llm/` behind one interface.\n * Everything else is here, because everything else is the same whichever engine\n * ran ΓÇö and a stage that is duplicated per engine is a stage whose two copies will\n * drift.\n *\n * ---------------------------------------------------------------------------\n * THE STAGE REPORTS ARE NOT DECORATION\n *\n * Extraction is the layer users trust least, so it reports what it DID rather than\n * only what it found. \"4 turns unattributed, 2 episodes, 9 cues ΓåÆ 3 decisions,\n * 5 premises, 2 discarded, 1 snippet failed validation\" is a sentence a user can\n * argue with. \"3 decisions\" is not.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DiscardedCandidate } from \"@/ai/types\";\nimport type { ExtractionRequest, ExtractionResult, WhyLogEngine } from \"@/ai/types\";\nimport { nowISO } from \"@/lib/format\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { EngineId, ISODateString, TranscriptId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport { type ChunkingResult, chunkTurns, describeChunking } from \"./chunking\";\nimport { describeHistogram } from \"./confidence\";\nimport { type NormalizerOptions, describeNormalisation, normaliseTranscript } from \"./normalizer\";\nimport { type OriginClassification, describeProvenance, summariseOrigins } from \"./provenance\";\nimport { buildQueue, fallbackOrigin, mergeTiers, originOf } from \"./queue-build\";\nimport {\n  type ResolutionReport,\n  describeIdempotence,\n  describeResolution,\n  resolveExtraction,\n} from \"./resolution\";\nimport { describeSegmentation, segmentEpisodes } from \"./segmentation\";\nimport {\n  type ValidationReport,\n  describeValidation,\n  validateExtraction,\n} from \"./snippet-validation\";\nimport type {\n  EpisodeWindow,\n  ExtractionRun,\n  NormalizedTranscript,\n  ResolvedCandidate,\n  StageReport,\n} from \"./types\";\nimport { type VoteOutcome, type VotingOptions, describeVoting, voteAcrossRuns } from \"./voting\";\n\nexport interface ExtractionInput {\n  readonly transcriptId: TranscriptId;\n  /** The RAW text, exactly as pasted. Never pre-normalised: the offset map has to\n   *  start from the real characters or nothing downstream resolves. */\n  readonly raw: string;\n  readonly label?: string;\n  readonly occurredAt?: ISODateString;\n}\n\nexport interface PipelineOptions {\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** The graph as it stands, so resolution can merge instead of duplicating. */\n  readonly state: GraphState;\n  /** Force a transcript shape rather than detecting it. */\n  readonly shape?: NormalizerOptions[\"shape\"];\n  readonly collapseNoise?: boolean;\n  readonly chunkChars?: number;\n  /** Three-run voting. Ignored when `engine.capabilities().voting` is false. */\n  readonly voting?: VotingOptions;\n  readonly signal?: AbortSignal;\n}\n\nexport interface PipelineOutcome {\n  readonly run: ExtractionRun;\n  readonly normalized: NormalizedTranscript;\n  readonly episodes: readonly EpisodeWindow[];\n  readonly chunking: ChunkingResult;\n  readonly result: ExtractionResult;\n  readonly validation: ValidationReport;\n  readonly resolution: ResolutionReport;\n  readonly queue: readonly ResolvedCandidate[];\n  readonly origins: readonly OriginClassification[];\n  readonly stages: readonly StageReport[];\n  readonly voting: VoteOutcome | null;\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nexport type PipelineFailure =\n  | { readonly kind: \"empty-input\" }\n  | { readonly kind: \"no-turns\" }\n  | { readonly kind: \"engine-unsupported\" }\n  | { readonly kind: \"engine-error\"; readonly message: string }\n  | { readonly kind: \"cancelled\" };\n\nexport type PipelineResult =\n  | { readonly ok: true; readonly outcome: PipelineOutcome }\n  | { readonly ok: false; readonly failure: PipelineFailure };\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport async function runExtraction(\n  input: ExtractionInput,\n  options: PipelineOptions,\n): Promise<PipelineResult> {\n  const startedAt = nowISO();\n  const started = nowMs();\n  const stages: StageReport[] = [];\n\n  if (input.raw.trim().length === 0) {\n    return { ok: false, failure: { kind: \"empty-input\" } };\n  }\n  if (!options.engine.capabilities().extraction) {\n    return { ok: false, failure: { kind: \"engine-unsupported\" } };\n  }\n\n  /* ---- 1.1 normalise ---- */\n  let stageStart = nowMs();\n  const normalized = normaliseTranscript(input.raw, {\n    transcriptId: input.transcriptId,\n    ...(options.shape === undefined ? {} : { shape: options.shape }),\n    ...(input.occurredAt === undefined ? {} : { occurredAt: input.occurredAt }),\n    ...(options.collapseNoise === undefined ? {} : { collapseNoise: options.collapseNoise }),\n    ...(input.label === undefined ? {} : { label: input.label }),\n  });\n  stages.push(\n    stage(\n      \"normalise\",\n      stageStart,\n      input.raw.length,\n      normalized.text.length,\n      describeNormalisation(normalized),\n    ),\n  );\n\n  if (normalized.turns.length === 0) {\n    return { ok: false, failure: { kind: \"no-turns\" } };\n  }\n\n  /* ---- 1.1 chunk ---- */\n  stageStart = nowMs();\n  const chunking = chunkTurns(normalized.turns, options.chunkChars);\n  stages.push(\n    stage(\n      \"segment\",\n      stageStart,\n      normalized.turns.length,\n      chunking.chunks.length,\n      describeChunking(chunking),\n    ),\n  );\n\n  /* ---- 1.2 segment ---- */\n  stageStart = nowMs();\n  const segmentation = segmentEpisodes(normalized);\n  stages.push(\n    stage(\n      \"segment\",\n      stageStart,\n      chunking.chunks.length,\n      segmentation.episodes.length,\n      describeSegmentation(segmentation, normalized.turns.length),\n    ),\n  );\n\n  /* ---- 1.3ΓÇô1.6 recognise, through the engine seam ---- */\n  stageStart = nowMs();\n  const request: ExtractionRequest = {\n    transcriptId: input.transcriptId,\n    text: normalized.text,\n    ...(normalized.occurredAt.length > 0 ? { occurredAt: normalized.occurredAt } : {}),\n    ...(options.signal === undefined ? {} : { signal: options.signal }),\n  };\n\n  let result: ExtractionResult;\n  let voting: VoteOutcome | null = null;\n\n  const votingOn =\n    options.voting !== undefined && options.voting.runs > 1 && options.engine.capabilities().voting;\n\n  try {\n    if (votingOn && options.voting !== undefined) {\n      const runs: ExtractionResult[] = [];\n      for (let i = 0; i < options.voting.runs; i += 1) {\n        if (options.signal?.aborted) return { ok: false, failure: { kind: \"cancelled\" } };\n        runs.push(await options.engine.extract(request));\n      }\n      voting = voteAcrossRuns(runs);\n      result = voting.result;\n    } else {\n      result = await options.engine.extract(request);\n    }\n  } catch (error) {\n    return { ok: false, failure: { kind: \"engine-error\", message: messageOf(error) } };\n  }\n\n  if (options.signal?.aborted) return { ok: false, failure: { kind: \"cancelled\" } };\n\n  stages.push(\n    stage(\n      \"recognise\",\n      stageStart,\n      segmentation.episodes.length,\n      result.decisions.length + result.premises.length + result.alternatives.length,\n      voting === null\n        ? `${result.decisions.length} decisions, ${result.premises.length} premises, ${result.alternatives.length} alternatives, ${result.discarded.length} discarded`\n        : describeVoting(voting),\n    ),\n  );\n\n  /* ---- 1.6 validate snippets ---- */\n  stageStart = nowMs();\n  const validated = validateExtraction(result, normalized.raw);\n  stages.push(\n    stage(\n      \"recognise\",\n      stageStart,\n      validated.report.checked,\n      validated.report.passed,\n      describeValidation(validated.report),\n    ),\n  );\n  result = validated.result;\n\n  /* ---- 1.6 origin, which needs the whole turn list ---- */\n  const origins = result.decisions.map((candidate) =>\n    originOf(segmentation.episodes, candidate.snippet.text, candidate.modality),\n  );\n\n  /* ---- 1.8 tier ---- */\n  stageStart = nowMs();\n  const tiered = buildQueue(result, origins);\n  stages.push(\n    stage(\n      \"score\",\n      stageStart,\n      result.decisions.length + result.premises.length + result.alternatives.length,\n      tiered.queue.length,\n      describeHistogram(tiered.histogram),\n    ),\n  );\n\n  /* ---- 1.7 resolve ---- */\n  stageStart = nowMs();\n  const resolved = resolveExtraction(\n    result.decisions.map((candidate, i) => ({ candidate, origin: origins[i] ?? fallbackOrigin })),\n    result.premises,\n    result.alternatives,\n    { state: options.state, engine: options.engineId },\n  );\n  stages.push(\n    stage(\n      \"resolve\",\n      stageStart,\n      tiered.queue.length,\n      resolved.resolved.length,\n      describeResolution(resolved.report),\n    ),\n  );\n\n  const run: ExtractionRun = {\n    transcriptId: input.transcriptId,\n    normalized,\n    episodes: segmentation.episodes,\n    decisions: result.decisions,\n    premises: result.premises,\n    alternatives: result.alternatives,\n    discarded: [...result.discarded, ...discardsFromValidation(result, validated.report.failed)],\n    engine: options.engineId,\n    stages,\n    startedAt,\n    durationMs: nowMs() - started,\n  };\n\n  return {\n    ok: true,\n    outcome: {\n      run,\n      normalized,\n      episodes: segmentation.episodes,\n      chunking,\n      result,\n      validation: validated.report,\n      resolution: resolved.report,\n      queue: mergeTiers(tiered.queue, resolved.resolved),\n      origins,\n      stages,\n      voting,\n      startedAt,\n      durationMs: run.durationMs,\n    },\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\nfunction discardsFromValidation(\n  result: ExtractionResult,\n  failed: number,\n): readonly DiscardedCandidate[] {\n  if (failed === 0) return [];\n\n  // A downgraded decision keeps its structure and loses its span, so an empty span\n  // is the marker. It is counted as a discard because it IS a candidate the\n  // extractor produced, and the discard list is the denominator of the precision\n  // metric Phase 7 reports.\n  return result.decisions\n    .filter((candidate) => candidate.snippet.end <= candidate.snippet.start)\n    .map((candidate) => ({\n      kind: \"decision\" as const,\n      discardedBy: \"confidence-threshold\" as const,\n      rawText: candidate.statement,\n      confidence: asConfidence(candidate.confidence),\n    }));\n}\n\nfunction stage(\n  name: StageReport[\"stage\"],\n  startedAt: number,\n  itemsIn: number,\n  itemsOut: number,\n  note?: string,\n): StageReport {\n  return {\n    stage: name,\n    durationMs: Math.round(nowMs() - startedAt),\n    itemsIn,\n    itemsOut,\n    ...(note === undefined ? {} : { note }),\n  };\n}\n\nfunction nowMs(): number {\n  return typeof performance !== \"undefined\" ? performance.now() : Date.now();\n}\n\nfunction messageOf(error: unknown): string {\n  if (error instanceof Error) return error.message;\n  return String(error);\n}\n\n/** The whole outcome as a paragraph, for the review header and for the notice the\n *  store raises when an import finishes. */\nexport function describeOutcome(outcome: PipelineOutcome): string {\n  const summary = summariseOrigins(outcome.origins);\n  return [\n    describeNormalisation(outcome.normalized),\n    describeSegmentation(\n      { episodes: outcome.episodes, uncoveredTurns: 0, cueHits: 0 },\n      outcome.normalized.turns.length,\n    ),\n    describeValidation(outcome.validation),\n    describeProvenance(summary, outcome.origins.length),\n    describeResolution(outcome.resolution),\n    describeIdempotence(outcome.resolution),\n    outcome.voting === null ? \"voting off\" : describeVoting(outcome.voting),\n  ].join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 16 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 16 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 16 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\normalizer.ts"},"span":[10654,10668],"sourceCode":"/**\n * The normaliser ΓÇö 1.1's orchestrator.\n *\n * Phase 1 ┬╖ sub-phase 1.1\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.1\n *\n * ---------------------------------------------------------------------------\n * WHAT IT PRODUCES\n *\n * One `NormalizedTranscript` from any of the six supported input shapes, holding\n * BOTH texts:\n *\n *   `raw`  ΓÇö untouched. Snippets are validated against it, the review pane\n *            highlights ranges in it, and the export quotes from it.\n *   `text` ΓÇö what the recognisers read: tool noise collapsed, code fences lifted\n *            out, speaker markers stripped.\n *\n * and the `anchors` that map an index in `text` back to an index in `raw`. That\n * map is the acceptance criterion; everything else in this module exists to build\n * it honestly.\n *\n * ---------------------------------------------------------------------------\n * TWO COORDINATE SYSTEMS, ONE WALK\n *\n * Turn bounds are stored in NORMALISED coordinates because `NormalizedTurn.text`\n * is a slice of the normalised string and the recognisers work in that string.\n * Raw bounds are needed too ΓÇö for highlighting and for episode display ΓÇö so the\n * single walk that assembles `text` builds BOTH maps. Building them separately\n * would mean walking the claims twice and keeping two cursors in agreement, which\n * is how an offset bug gets written.\n *\n * ---------------------------------------------------------------------------\n * ORDER OF OPERATIONS\n *\n * Speaker attribution runs FIRST, on the raw text. It has to: the markers it looks\n * for (`ΓÅ║`, `User:`) are exactly the things a later stage strips, and a 400-line\n * tool dump can contain lines that look like markers. Attributing before\n * collapsing also means the turn list is complete, so a code block can be\n * attributed to the turn that contains it.\n * ---------------------------------------------------------------------------\n */\n\nimport type { ISODateString, TranscriptId } from \"@/types/common\";\nimport { placeholderFor, scanNoise } from \"./noise\";\nimport { type OffsetMap, OffsetMapBuilder, identityMap, rawAt, rawBounds } from \"./offset-map\";\nimport { type RawTurn, attributeSpeakers, detectShape, linesWithOffsets } from \"./speakers\";\nimport { type RecoveredTime, recoverTimestamp } from \"./timestamps\";\nimport type {\n  CodeBlock,\n  InputShape,\n  NoiseKind,\n  NoiseRegion,\n  NormalizationStats,\n  NormalizedTranscript,\n  NormalizedTurn,\n} from \"./types\";\n\nexport interface NormalizerOptions {\n  readonly transcriptId: TranscriptId;\n  /** Force a shape instead of detecting it. The review UI exposes this: a wrong\n   *  guess must be correctable, not merely visible. */\n  readonly shape?: InputShape;\n  readonly occurredAt?: ISODateString;\n  readonly label?: string;\n  /** Default true. Set false to keep tool output in the extraction text ΓÇö useful\n   *  when a decision is ABOUT the noise (\"we dropped the ORM because the\n   *  migration output was 90 lines\"). */\n  readonly collapseNoise?: boolean;\n  /** Default true. Code fences are lifted into `codeBlocks` either way; this only\n   *  controls whether a placeholder marks the lift in `text`. */\n  readonly liftCodeBlocks?: boolean;\n}\n\n/** A region of `raw` claimed by a stage, and what replaces it in `text`. Sorted\n *  and non-overlapping: two claims on one range would corrupt the map. */\ninterface Claim {\n  readonly start: number;\n  readonly end: number;\n  readonly replacement: string;\n  readonly kind: \"code\" | NoiseKind;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function normaliseTranscript(raw: string, options: NormalizerOptions): NormalizedTranscript {\n  const shape: InputShape = options.shape ?? detectShape(raw);\n  const attribution = attributeSpeakers(raw, shape);\n  const time: RecoveredTime = recoverTimestamp(raw, options.occurredAt);\n\n  const collected = collectClaims(raw, attribution.turns, options);\n  const assembled = assemble(raw, collected.claims, attribution.turns);\n\n  const turns: readonly NormalizedTurn[] = attribution.turns.map((turn, i) => {\n    const bounds = assembled.turnBounds[i];\n    const start = bounds?.start ?? 0;\n    const end = bounds?.end ?? start;\n    return {\n      index: i,\n      speaker: turn.speaker,\n      rawStart: turn.rawStart,\n      rawEnd: turn.rawEnd,\n      text: assembled.text.slice(start, end),\n      start,\n      end,\n      attribution: turn.attribution,\n    };\n  });\n\n  const codeBlocks = collected.codeBlocks;\n  const noise = assembled.noise;\n\n  const stats: NormalizationStats = {\n    rawChars: raw.length,\n    normalisedChars: assembled.text.length,\n    turns: turns.length,\n    humanTurns: turns.filter((t) => t.speaker === \"human\").length,\n    agentTurns: turns.filter((t) => t.speaker === \"agent\").length,\n    unattributedTurns: turns.filter((t) => t.speaker === \"unknown\").length,\n    codeBlocks: codeBlocks.length,\n    noiseRegions: noise.length,\n    noiseCharsCollapsed: noise.reduce(\n      (total, region) => total + (region.rawEnd - region.rawStart),\n      0,\n    ),\n  };\n\n  return {\n    transcriptId: options.transcriptId,\n    shape,\n    raw,\n    text: assembled.text,\n    turns,\n    codeBlocks,\n    noise,\n    anchors: assembled.forward.anchors,\n    occurredAt: time.at,\n    timeUncertain: time.uncertain,\n    stats,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Claims                                                                     */\n/* -------------------------------------------------------------------------- */\n\ninterface Collected {\n  readonly claims: readonly Claim[];\n  readonly codeBlocks: readonly CodeBlock[];\n}\n\n/**\n * Decide what gets replaced, in one place, so that the claim list is sorted and\n * non-overlapping BEFORE the walk. Two claims on one range would corrupt both\n * maps, and the only way to guarantee that is to never build the second claim\n * without seeing the first.\n */\nfunction collectClaims(\n  raw: string,\n  turns: readonly RawTurn[],\n  options: NormalizerOptions,\n): Collected {\n  const claims: Claim[] = [];\n  const codeBlocks: CodeBlock[] = [];\n\n  if (options.liftCodeBlocks !== false) {\n    for (const block of findCodeBlocks(raw, turns)) {\n      codeBlocks.push(block);\n      claims.push({\n        start: block.rawStart,\n        end: block.rawEnd,\n        replacement: codePlaceholder(block.lang, block.text),\n        kind: \"code\",\n      });\n    }\n  }\n\n  if (options.collapseNoise !== false) {\n    const lines = linesWithOffsets(raw);\n    for (const run of scanNoise(raw)) {\n      const first = lines[run.startLine];\n      const last = lines[run.endLine];\n      if (first === undefined || last === undefined) continue;\n\n      // A run that overlaps an already-claimed code block is dropped: the block\n      // owns those characters.\n      const overlaps = claims.some((claim) => first.start < claim.end && last.end > claim.start);\n      if (overlaps) continue;\n\n      claims.push({\n        start: first.start,\n        end: last.end,\n        replacement: placeholderFor(run.kind, run.endLine - run.startLine + 1),\n        kind: run.kind,\n      });\n    }\n  }\n\n  return { claims: [...claims].sort((a, b) => a.start - b.start), codeBlocks };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Assembly                                                                   */\n/* -------------------------------------------------------------------------- */\n\ninterface Assembled {\n  readonly text: string;\n  /** normalised ΓåÆ raw */\n  readonly forward: OffsetMap;\n  /** raw ΓåÆ normalised */\n  readonly inverse: OffsetMap;\n  readonly noise: readonly NoiseRegion[];\n  /** Per turn, the bounds of its body in the NORMALISED text. */\n  readonly turnBounds: readonly { start: number; end: number }[];\n}\n\n/**\n * One walk over the raw text.\n *\n * Prose is emitted verbatim and advances both maps together; a claim emits its\n * replacement and advances them apart. Because both builders are driven by the\n * same cursor, they cannot disagree.\n */\nfunction assemble(raw: string, claims: readonly Claim[], turns: readonly RawTurn[]): Assembled {\n  const forward = new OffsetMapBuilder();\n  const inverse = new OffsetMapBuilder();\n  const parts: string[] = [];\n  const noise: NoiseRegion[] = [];\n\n  let cursor = 0;\n\n  for (const claim of claims) {\n    if (claim.start < cursor) continue;\n\n    if (claim.start > cursor) {\n      const prose = raw.slice(cursor, claim.start);\n      forward.keep(prose.length);\n      inverse.keep(prose.length);\n      parts.push(prose);\n    }\n\n    const rawLength = claim.end - claim.start;\n    forward.skip(rawLength, claim.replacement.length);\n    inverse.skip(claim.replacement.length, rawLength);\n    parts.push(claim.replacement);\n\n    cursor = claim.end;\n\n    if (claim.kind !== \"code\") {\n      noise.push({\n        kind: claim.kind,\n        rawStart: claim.start,\n        rawEnd: claim.end,\n        raw: raw.slice(claim.start, claim.end),\n        replacedWith: claim.replacement,\n      });\n    }\n  }\n\n  if (cursor < raw.length) {\n    const tail = raw.slice(cursor);\n    forward.keep(tail.length);\n    inverse.keep(tail.length);\n    parts.push(tail);\n  }\n\n  const text = parts.join(\"\");\n  const forwardMap = forward.build(text, raw);\n  const inverseMap = inverse.build(raw, text);\n\n  // Turn bodies are known in RAW coordinates and must be reported in NORMALISED\n  // ones, so they go through the inverse map. `rawAt` clamps, and a body that was\n  // entirely inside a lifted region collapses to a zero-length range, which the\n  // recognisers skip rather than mis-read.\n  const turnBounds = turns.map((turn) => ({\n    start: rawAt(inverseMap, turn.bodyStart),\n    end: rawAt(inverseMap, turn.bodyEnd),\n  }));\n\n  return { text, forward: forwardMap, inverse: inverseMap, noise, turnBounds };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Code blocks                                                                */\n/* -------------------------------------------------------------------------- */\n\nconst FENCE = /^(\\s*)(```+|~~~+)\\s*([\\w+#.-]*)\\s*$/;\n\n/**\n * Find fenced code blocks and the turn each sits in.\n *\n * Lifted because a fence is evidence for GUARDS (Phase 4), not decision text: a\n * 60-line config file between two turns is not a decision, and leaving it in\n * dilutes every cue scan. It is retained verbatim in `CodeBlock.text` with raw\n * bounds, so a decision that quotes a line of it still resolves.\n */\nexport function findCodeBlocks(raw: string, turns: readonly RawTurn[]): readonly CodeBlock[] {\n  const lines = linesWithOffsets(raw);\n  const blocks: CodeBlock[] = [];\n  let open: { fence: string; lang: string | null; start: number } | null = null;\n\n  for (const line of lines) {\n    const match = FENCE.exec(line.text);\n\n    if (open === null) {\n      if (match === null) continue;\n      open = {\n        fence: (match[2] ?? \"```\").slice(0, 3),\n        lang: (match[3] ?? \"\").length > 0 ? (match[3] as string) : null,\n        start: line.start,\n      };\n      continue;\n    }\n\n    if (match !== null && (match[2] ?? \"\").startsWith(open.fence)) {\n      blocks.push({\n        lang: open.lang,\n        text: raw.slice(open.start, line.end),\n        rawStart: open.start,\n        rawEnd: line.end,\n        turnIndex: turnContaining(turns, open.start, line.end),\n      });\n      open = null;\n    }\n  }\n\n  // An unterminated fence runs to the end of the input. Treat it as a block: the\n  // alternative is to leave a half-transcript in the extraction text, which is\n  // worse than lifting too much.\n  if (open !== null) {\n    blocks.push({\n      lang: open.lang,\n      text: raw.slice(open.start),\n      rawStart: open.start,\n      rawEnd: raw.length,\n      turnIndex: turnContaining(turns, open.start, raw.length),\n    });\n  }\n\n  return blocks;\n}\n\nfunction turnContaining(turns: readonly RawTurn[], start: number, end: number): number | null {\n  for (const turn of turns) {\n    if (turn.rawStart <= start && turn.rawEnd >= start) return turn.index;\n    if (turn.rawStart >= start && turn.rawEnd <= end) return turn.index;\n  }\n  return null;\n}\n\nfunction codePlaceholder(lang: string | null, body: string): string {\n  const lineCount = body.split(\"\\n\").length;\n  const label = lang === null ? \"code\" : `${lang} code`;\n  return `\\n[${label} ┬╖ ${lineCount} lines lifted]\\n`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/** How much of the transcript reached the recognisers. A normalisation that\n *  consumed most of the input is worth doubting out loud. */\nexport function describeNormalisation(result: NormalizedTranscript): string {\n  const s = result.stats;\n  const kept = s.rawChars === 0 ? 100 : Math.round((s.normalisedChars / s.rawChars) * 100);\n  const parts = [\n    `${s.turns} turns (${s.humanTurns} human ┬╖ ${s.agentTurns} agent ┬╖ ${s.unattributedTurns} unattributed)`,\n    `${kept}% of the raw text reached the recognisers`,\n  ];\n  if (s.codeBlocks > 0)\n    parts.push(`${s.codeBlocks} code block${s.codeBlocks === 1 ? \"\" : \"s\"} lifted`);\n  if (s.noiseRegions > 0)\n    parts.push(`${s.noiseRegions} noise region${s.noiseRegions === 1 ? \"\" : \"s\"} collapsed`);\n  if (s.unattributedTurns > 0) {\n    parts.push(\"unattributed turns default to the LOWEST authority, never to human\");\n  }\n  return parts.join(\" ┬╖ \");\n}\n\n/** Raw bounds of a normalised range, for the review pane. Re-exported here so\n *  callers of the normaliser do not need a second import. */\nexport function toRawBounds(\n  result: NormalizedTranscript,\n  start: number,\n  end: number,\n): readonly [number, number] {\n  return rawBounds(\n    { anchors: result.anchors, normalisedLength: result.text.length, rawLength: result.raw.length },\n    start,\n    end,\n  );\n}\n\n/** The identity normalisation, for callers that already have clean text. */\nexport function asAlreadyNormalised(\n  transcriptId: TranscriptId,\n  raw: string,\n  occurredAt: ISODateString,\n): NormalizedTranscript {\n  const map = identityMap(raw);\n  return {\n    transcriptId,\n    shape: \"plain-prose\",\n    raw,\n    text: raw,\n    turns: [],\n    codeBlocks: [],\n    noise: [],\n    anchors: map.anchors,\n    occurredAt,\n    timeUncertain: true,\n    stats: {\n      rawChars: raw.length,\n      normalisedChars: raw.length,\n      turns: 0,\n      humanTurns: 0,\n      agentTurns: 0,\n      unattributedTurns: 0,\n      codeBlocks: 0,\n      noiseRegions: 0,\n      noiseCharsCollapsed: 0,\n    },\n  };\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 21 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 21 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 21 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\premises.ts"},"span":[5011,5026],"sourceCode":"/**\n * Premise recovery ΓÇö 1.4. THE LOAD-BEARING SUB-PHASE.\n *\n * Phase 1 ┬╖ sub-phase 1.4\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.4\n *\n * ---------------------------------------------------------------------------\n * WHY THIS IS THE PRODUCT\n *\n * Everything else in Phase 1 is commodity: decisions are extractable at published\n * rates (~0.75 F1) and three shipping tools already do it. Premises are not. RAAM\n * needed an expert walkthrough to recover the assumptions a decision rests on,\n * which is the same as saying nobody has automated it.\n *\n * If premises cannot be recovered from dialogue at usable precision, the\n * truth-maintenance layer has nothing to maintain and the product collapses to a\n * decision log ΓÇö that is, to `ai-memory`. So this file is the one to prototype and\n * measure before anything else is built, and the one whose numbers must be reported\n * honestly.\n *\n * ---------------------------------------------------------------------------\n * CLOSED SET DISCIPLINE\n *\n * Exactly the 8 premise types from Phase 0.7. An unclassifiable assumption becomes\n * `requirement` with a free-text predicate and is flagged low-confidence. There is\n * no ninth type and no code path that invents one: RAAM's precision problem is\n * unbounded assumption discovery, and the closed set is the mitigation.\n *\n * ---------------------------------------------------------------------------\n * WHY EVERY CANDIDATE IS REVIEWED\n *\n * `needsReview` is true for every topical cue and for every explicit cue below\n * 0.9 ΓÇö which, reading `premise-cues.ts`, is all of them. That is not an oversight\n * in the table, it is the table saying out loud that premise extraction does not\n * yet earn auto-acceptance. `TOPICAL_AUTO_ACCEPT_THRESHOLD = 1.0` is unreachable by\n * construction. When Phase 7's measurement says otherwise, the threshold moves and\n * this file does not.\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS FILE DOES *NOT* DO\n *\n * It does not decide whether a premise SUPPORTS a decision or is EXCLUDED by it.\n * That is `premise-linker.ts`, because the answer depends on the decision as well\n * as on the premise, and this module only ever sees one episode's text.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DiscardedCandidate, PremiseCandidate } from \"@/ai/types\";\nimport { canonicalPredicate, snakeCase } from \"@/ontology/canonicalize\";\nimport {\n  EXPLICIT_AUTO_ACCEPT_THRESHOLD,\n  PREMISE_CUES,\n  type PremiseCue,\n  TOPICAL_AUTO_ACCEPT_THRESHOLD,\n  needsReview as cueNeedsReview,\n} from \"@/ontology/data/premise-cues\";\nimport { PREMISE_TYPE_META, lookupPredicate } from \"@/ontology/data/premise-types\";\nimport type { Confidence } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { PremiseType } from \"@/types/domain\";\nimport type { DecisionContext } from \"./decisions\";\nimport { type Located, locateInEpisode } from \"./episode-position\";\nimport { spanFrom } from \"./offset-map\";\nimport type { EpisodeWindow } from \"./types\";\n\nexport interface RecoveredPremise {\n  readonly candidate: PremiseCandidate;\n  readonly cue: PremiseCue;\n  readonly kind: \"explicit\" | \"topical\";\n  /** Positive supports the decision; negative and restrictive constrain it. The\n   *  linker turns a constrained premise into an OUT-list entry. */\n  readonly polarity: PremisePolarity;\n  readonly turn: Located[\"turn\"];\n  readonly episodeIndex: number;\n  /** How the predicate was obtained. `cue` is the strong case; `derived` means the\n   *  cue had no predicate and one was built from the text, which always needs a\n   *  human look. */\n  readonly predicateVia: \"cue\" | \"derived\";\n}\n\nexport type PremisePolarity = \"positive\" | \"negative\" | \"restrictive\";\n\nexport interface PremiseRecovery {\n  readonly premises: readonly RecoveredPremise[];\n  readonly discarded: readonly DiscardedCandidate[];\n  /** Per-type counts, for the histogram that shows whether the cue table is\n   *  lopsided against this corpus. */\n  readonly byType: Readonly<Record<PremiseType, number>>;\n}\n\n/** Below this a topical cue is noise. It is recorded as a discard rather than\n *  dropped, because the discard list is the denominator of the precision metric. */\nconst MIN_CUE_WEIGHT = 0.4;\n\n/** Longest cue phrase first, so \"no other users\" wins over \"no\". */\nconst CUES_BY_LENGTH: readonly PremiseCue[] = [...PREMISE_CUES].sort(\n  (a, b) => b.phrase.length - a.phrase.length || b.weight - a.weight,\n);\n\nconst WORD_NUMBERS: Readonly<Record<string, number>> = {\n  one: 1,\n  two: 2,\n  three: 3,\n  four: 4,\n  five: 5,\n  six: 6,\n  seven: 7,\n  eight: 8,\n  nine: 9,\n  ten: 10,\n  twelve: 12,\n  twenty: 20,\n  fifty: 50,\n  hundred: 100,\n};\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport function recoverPremises(episode: EpisodeWindow, context: DecisionContext): PremiseRecovery {\n  const found: RecoveredPremise[] = [];\n  const discarded: DiscardedCandidate[] = [];\n  /** Positions already claimed by a longer cue, so \"no other users\" does not also\n   *  fire \"no\". */\n  const claimed: boolean[] = new Array(episode.text.length).fill(false);\n  /** One candidate per predicate per episode. Two cues for the same assumption are\n   *  one assumption, and emitting both would double its corroboration. */\n  const seenPredicate = new Set<string>();\n\n  for (const cue of CUES_BY_LENGTH) {\n    let from = 0;\n    for (;;) {\n      const at = episode.text.toLowerCase().indexOf(cue.phrase, from);\n      if (at < 0) break;\n      from = at + cue.phrase.length;\n\n      if (claimed.slice(at, at + cue.phrase.length).some(Boolean)) continue;\n      for (let i = at; i < at + cue.phrase.length; i += 1) claimed[i] = true;\n\n      const located = locateInEpisode(episode, at);\n      if (located === null) continue;\n\n      const built = buildPremise(episode, cue, at, located, context);\n      if (built === null) {\n        discarded.push({\n          kind: \"premise\",\n          discardedBy: \"confidence-threshold\",\n          rawText: windowAround(episode.text, at, 90),\n          confidence: asConfidence(cue.weight * 0.5),\n        });\n        continue;\n      }\n\n      const key = `${built.candidate.type}\\u0000${built.candidate.predicate}`;\n      if (seenPredicate.has(key)) continue;\n      seenPredicate.add(key);\n\n      found.push(built);\n    }\n  }\n\n  const byType = countByType(found);\n  return { premises: found, discarded, byType };\n}\n\nfunction buildPremise(\n  episode: EpisodeWindow,\n  cue: PremiseCue,\n  at: number,\n  located: Located,\n  context: DecisionContext,\n): RecoveredPremise | null {\n  if (cue.weight < MIN_CUE_WEIGHT) return null;\n\n  /* ---- predicate: from the cue, or derived from the text ---- */\n  const viaCue = cue.predicate !== undefined && lookupPredicate(cue.predicate) !== null;\n  const derived = viaCue ? null : derivePredicate(cue, located.turn.text, at - located.offset);\n  const predicate = viaCue ? canonicalPredicate(cue.type, cue.predicate as string) : derived;\n  if (predicate === null) return null;\n\n  /* ---- value ---- */\n  const meta = PREMISE_TYPE_META[cue.type];\n  const declared = lookupPredicate(predicate);\n  const valueKind = declared?.predicate.valueKind ?? meta.predicates[0]?.valueKind ?? \"string\";\n  const value = readValue(episode.text, at, cue.phrase.length, valueKind);\n\n  /* ---- text: the clause, verbatim ---- */\n  const clause = readClause(located.turn.text, at - located.offset, cue.phrase.length);\n  if (clause.text.trim().length < 4) return null;\n\n  /* ---- span, in raw coordinates ---- */\n  const normalisedStart = located.turn.start + clause.start;\n  const normalisedEnd = located.turn.start + clause.end;\n  const snippet = spanFrom(\n    context.transcriptId,\n    context.raw,\n    context.map,\n    normalisedStart,\n    normalisedEnd,\n  );\n  if (snippet === null) return null;\n\n  const polarity: PremisePolarity = cue.polarity ?? \"positive\";\n  const confidence = scorePremise(cue, viaCue, value !== undefined, polarity);\n\n  const candidate: PremiseCandidate = {\n    type: cue.type,\n    predicate,\n    ...(value === undefined ? {} : { value }),\n    text: clause.text.trim(),\n    confidence,\n    snippet,\n    // Every premise is reviewed. See the file header: the cue table's own\n    // thresholds are unreachable on purpose, and this module does not get to\n    // decide otherwise.\n    needsReview: cueNeedsReview(cue) || !viaCue || confidence < EXPLICIT_AUTO_ACCEPT_THRESHOLD,\n  };\n\n  return {\n    candidate,\n    cue,\n    kind: cue.kind,\n    polarity,\n    turn: located.turn,\n    episodeIndex: episode.index,\n    predicateVia: viaCue ? \"cue\" : \"derived\",\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Predicate                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Build a predicate for a cue that does not declare one.\n *\n * Always namespaced under the cue's own type, so rung 1 of the identity ladder can\n * still match it exactly on a re-import. An unnamespaced predicate would resolve\n * differently on each run and mint a duplicate node every time ΓÇö the failure the\n * closed vocabulary exists to prevent.\n *\n * The result is `requirement.<free text>` when nothing better is available, which\n * is the plan's designated escape hatch and is always flagged low-confidence.\n */\nfunction derivePredicate(cue: PremiseCue, turnText: string, localAt: number): string | null {\n  const namespace = PREMISE_TYPE_META[cue.type].namespace;\n  const cueWords = snakeCase(cue.phrase.replace(/[^A-Za-z0-9 ]/g, \" \"));\n\n  // A cue whose phrase already reads as a predicate name (\"single user\",\n  // \"free tier\") is the best available derivation and is stable across runs.\n  if (cueWords.length >= 3 && cueWords.length <= 40) {\n    const candidate = canonicalPredicate(cue.type, cueWords);\n    if (lookupPredicate(candidate) !== null) return candidate;\n\n    // Not a declared predicate, but still stable and still namespaced.\n    const words = cueWords.split(\"_\").filter((w) => w.length > 0);\n    if (words.length > 0 && words.length <= 4) return `${namespace}.${words.join(\"_\")}`;\n  }\n\n  const clause = readClause(turnText, localAt, cue.phrase.length).text;\n  const words = snakeCase(clause.replace(/[^A-Za-z0-9 ]/g, \" \"))\n    .split(\"_\")\n    .filter((w) => w.length > 2)\n    .slice(0, 4);\n\n  if (words.length === 0) return null;\n  return `${namespace}.${words.join(\"_\")}`;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Value                                                                      */\n/* -------------------------------------------------------------------------- */\n\n/** Read the value a cue introduces, in the shape its predicate declares. */\nfunction readValue(\n  text: string,\n  at: number,\n  phraseLength: number,\n  valueKind: \"boolean\" | \"number\" | \"string\" | \"enum\",\n): string | number | boolean | undefined {\n  const window = text.slice(Math.max(0, at - 40), Math.min(text.length, at + phraseLength + 40));\n\n  if (valueKind === \"boolean\") {\n    // A negative cue asserts `false` on a predicate whose name implies presence:\n    // \"no concurrent writers\" is `concurrent_writers = 0`, \"not multi-tenant\" is\n    // `multi_tenant = false`. Returning `true` here would invert the premise.\n    return undefined;\n  }\n\n  if (valueKind === \"number\") {\n    const number = readNumber(window);\n    if (number !== null) return number;\n    return undefined;\n  }\n\n  // `string` and `enum`: the cue phrase is the value. Canonicalisation of an enum\n  // is the predicate table's job, not the extractor's ΓÇö guessing a permitted value\n  // here would be inventing data.\n  const trimmed = window.trim();\n  return trimmed.length > 0 && trimmed.length <= 60 ? trimmed : undefined;\n}\n\nfunction readNumber(window: string): number | null {\n  const digits = /\\b(\\d{1,7})\\b/.exec(window);\n  if (digits !== null) return Number(digits[1]);\n\n  for (const [word, value] of Object.entries(WORD_NUMBERS)) {\n    if (new RegExp(`\\\\b${word}\\\\b`, \"i\").test(window)) return value;\n  }\n  return null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Clause                                                                     */\n/* -------------------------------------------------------------------------- */\n\nconst CLAUSE_END = /[.!?\\n;]/;\n\n/** The clause containing a cue, expanded a little either side so the premise reads\n *  as a sentence rather than as a fragment. */\nfunction readClause(\n  text: string,\n  at: number,\n  phraseLength: number,\n): { text: string; start: number; end: number } {\n  let start = at;\n  while (start > 0 && !CLAUSE_END.test(text[start - 1] ?? \"\")) start -= 1;\n\n  let end = at + phraseLength;\n  while (end < text.length && !CLAUSE_END.test(text[end] ?? \"\")) end += 1;\n\n  const body = text.slice(start, end);\n  const trimmed = body.replace(/^\\s*(?:and|but|so|because|since)\\s+/i, \"\");\n  return { text: trimmed, start, end };\n}\n\nfunction windowAround(text: string, at: number, chars: number): string {\n  const start = Math.max(0, at - Math.floor(chars / 3));\n  return text.slice(start, Math.min(text.length, at + chars)).trim();\n}\n\n/* -------------------------------------------------------------------------- */\n/* Confidence                                                                 */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Additive, inspectable, and deliberately capped below the decision rubric.\n *\n * Plan ┬º1.8: premises are always one tier lower than the decision they attach to,\n * reflecting the published precision gap. `confidence.ts` applies the tier demotion;\n * this score is the input to it.\n */\nfunction scorePremise(\n  cue: PremiseCue,\n  predicateFromCue: boolean,\n  hasValue: boolean,\n  polarity: PremisePolarity,\n): Confidence {\n  let score = cue.weight * 0.55;\n\n  if (cue.kind === \"explicit\") score += 0.2;\n  if (predicateFromCue) score += 0.15; // a namespaced predicate is rung-1 matchable\n  if (hasValue) score += 0.05;\n\n  // A restrictive cue (\"one person\", \"only me\") is the strongest premise signal in\n  // dialogue: it states a bound rather than mentioning a topic.\n  if (polarity === \"restrictive\") score += 0.05;\n\n  // Topical cues never clear the auto-accept threshold, and the score should say\n  // so rather than leaving it to `needsReview` alone.\n  if (cue.kind === \"topical\") score = Math.min(score, TOPICAL_AUTO_ACCEPT_THRESHOLD - 0.15);\n\n  return asConfidence(Math.max(0.05, Math.min(0.9, score)));\n}\n\n/* -------------------------------------------------------------------------- */\n/* Reporting                                                                  */\n/* -------------------------------------------------------------------------- */\n\nfunction countByType(found: readonly RecoveredPremise[]): Readonly<Record<PremiseType, number>> {\n  const out: Record<PremiseType, number> = {\n    scale: 0,\n    team: 0,\n    budget: 0,\n    time: 0,\n    deployment: 0,\n    capability: 0,\n    requirement: 0,\n    external: 0,\n  };\n  for (const premise of found) out[premise.candidate.type] += 1;\n  return out;\n}\n\nexport function describeRecovery(recovery: PremiseRecovery): string {\n  const parts: string[] = [];\n  for (const type of Object.keys(recovery.byType) as PremiseType[]) {\n    const count = recovery.byType[type];\n    if (count > 0) parts.push(`${type} ${count}`);\n  }\n  const summary = parts.length === 0 ? \"no typed premises\" : parts.join(\" ┬╖ \");\n  return `${recovery.premises.length} premise${recovery.premises.length === 1 ? \"\" : \"s\"} (${summary}), ${recovery.discarded.length} discarded`;\n}\n\n/**\n * How many premises came from a cue that declared its predicate.\n *\n * This is the number that decides whether the closed set is doing its job. A low\n * rate means the extractor is inventing `requirement.<free text>` predicates, which\n * resolve at rung 4 or worse and therefore need review every time.\n */\nexport function predicateFromCueRate(recovery: PremiseRecovery): number {\n  if (recovery.premises.length === 0) return 0;\n  const fromCue = recovery.premises.filter((p) => p.predicateVia === \"cue\").length;\n  return fromCue / recovery.premises.length;\n}\n\nexport { MIN_CUE_WEIGHT as PREMISE_MIN_CUE_WEIGHT };\n"},"tags":[],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Review actions ΓÇö 1.9, the five things a human can do.\n *      ? {}\n      : { text: stringField(fields, \"text\") as string }),\n    ...(fields[\"value\"]fields.value=== undefined || fields[\"value\"] === null\n      ? {}\n      : { value: fields[\"value\"] as string | number | boolean }),  }\n}\n","ops":[{"diffOp":{"equal":{"range":[0,65]}}},{"equalLines":{"line_count":223}},{"diffOp":{"equal":{"range":[65,142]}}},{"diffOp":{"delete":{"range":[142,157]}}},{"diffOp":{"insert":{"range":[157,169]}}},{"diffOp":{"equal":{"range":[65,66]}}},{"diffOp":{"equal":{"range":[169,287]}}},{"equalLines":{"line_count":130}},{"diffOp":{"equal":{"range":[287,293]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\extraction\\review\\actions.ts"},"span":[8715,8722],"sourceCode":"/**\n * Review actions ΓÇö 1.9, the five things a human can do.\n *\n * Phase 1 ┬╖ sub-phase 1.9\n * Plan: plan/phase-1-extraction-pipeline.md ┬º1.9\n *\n * ---------------------------------------------------------------------------\n * FIVE ACTIONS, AND EACH ONE WRITES A DIFFERENT EVENT\n *\n *   approve       ΓåÆ the candidate becomes a node at `status: \"proposed\"`. It does\n *                   NOT become IN unless `viaBulk` is false ΓÇö a bulk approval is not\n *                   a considered one, and the fold enforces that.\n *   edit          ΓåÆ the human's wording wins, at `origin: \"human_override\"`, and the\n *                   ORIGINAL extraction stays on the `DecisionProposed` event.\n *   discard       ΓåÆ `ExtractionDiscarded` with the human's reason. Recorded, because\n *                   the discard list is the denominator of the precision metric.\n *   merge-into    ΓåÆ the human overrides the identity ladder. Rung-4 merges are\n *                   flagged `needsReview` precisely so this action exists.\n *   contest       ΓåÆ the Hansson screening outcome: a newcomer that cannot outrank\n *                   every contradictor goes to the Contested queue rather than being\n *                   silently applied or silently dropped.\n *\n * There is no sixth action, and specifically no \"approve as IN\". Promoting a\n * decision to IN is a separate deliberate act with its own reason, available from\n * the decision card once the extraction is committed.\n *\n * ---------------------------------------------------------------------------\n * WHY EDITING RAISES AUTHORITY\n *\n * A human who edits an extraction has read it and changed it. That is stronger\n * evidence of ownership than a human who clicked approve on something that looked\n * right, so the edited item carries `human_override` (0.9) rather than\n * `human_stated` (1.0): it is the human's version of the MACHINE's sentence, not the\n * human's own sentence.\n *\n * The distinction matters because entrenchment reads it. An edited decision is\n * harder to retract than an approved one, which is correct ΓÇö a human has already\n * looked at the words.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  DiscardedCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport type { ResolvedCandidate, ReviewAction } from \"@/extraction/types\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport { asConfidence } from \"@/types/common\";\nimport type { ReviewItem } from \"./types\";\n\n/** An edit raises the item to the top of the range a machine extraction can reach.\n *  Not 1.0: the machine still found it, and a human correcting a wrong extraction\n *  into a right one is not the same act as a human stating it from scratch. */\nexport const EDITED_CONFIDENCE = asConfidence(0.95);\n\n/* -------------------------------------------------------------------------- */\n/* Constructors ΓÇö the only way to build an action                             */\n/* -------------------------------------------------------------------------- */\n\nexport const approve = (viaBulk = false): ReviewAction => ({ type: \"approve\", viaBulk });\n\nexport const edit = (\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): ReviewAction => ({ type: \"edit\", fields });\n\nexport const discard = (reason: string): ReviewAction => ({\n  type: \"discard\",\n  reason: reason.trim().length === 0 ? \"discarded in review\" : reason.trim(),\n});\n\n/** Override the identity ladder: this candidate IS that node. */\nexport const mergeInto = (targetId: DecisionId | PremiseId): ReviewAction => ({\n  type: \"merge-into\",\n  targetId,\n});\n\n/** Hansson screening: it cannot outrank its contradictors, so it waits. */\nexport const contest = (reason: string): ReviewAction => ({\n  type: \"contest\",\n  reason: reason.trim().length === 0 ? \"contested in review\" : reason.trim(),\n});\n\n/** Has a human decided this item? `commit.ts` refuses anything that has not. */\nexport function isActedOn(candidate: ResolvedCandidate): boolean {\n  return candidate.action !== null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Applying an action                                                         */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one action to one candidate, returning the candidate as it will be\n * committed.\n *\n * The action is data, so applying it is a pure function: the same candidate and the\n * same action always produce the same result, which is what makes a review\n * resumable after a reload.\n */\nexport function applyAction(candidate: ResolvedCandidate, action: ReviewAction): ResolvedCandidate {\n  const withAction: ResolvedCandidate = { ...candidate, action };\n\n  switch (action.type) {\n    case \"edit\":\n      return applyEdit(withAction, action.fields);\n\n    case \"merge-into\":\n      return {\n        ...withAction,\n        resolution: {\n          ...candidate.resolution,\n          action: \"merge\",\n          matchedId: action.targetId,\n          score: 1,\n          needsReview: false,\n          explanation: `${candidate.resolution.explanation}. A human overrode the ladder and merged this onto ${action.targetId}.`,\n        },\n      };\n\n    case \"contest\":\n      return {\n        ...withAction,\n        resolution: {\n          ...candidate.resolution,\n          needsReview: true,\n          explanation: `${candidate.resolution.explanation}. Contested: ${action.reason}`,\n        },\n      };\n\n    case \"approve\":\n    case \"discard\":\n      return withAction;\n  }\n}\n\n/**\n * Apply a human edit.\n *\n * The fields are a partial, so an untouched field keeps the machine's value. What\n * always changes is the ORIGIN and the CONFIDENCE, because a human has now read this\n * item ΓÇö and an item a human has read is different evidence from one they have not.\n */\nexport function applyEdit(\n  candidate: ResolvedCandidate,\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): ResolvedCandidate {\n  if (candidate.kind === \"decision\" && candidate.decision !== null) {\n    return {\n      ...candidate,\n      decision: editDecision(candidate.decision, fields),\n      origin: \"human_override\",\n      confidence: EDITED_CONFIDENCE,\n      tier: \"high\",\n      resolution: {\n        ...candidate.resolution,\n        needsReview: false,\n        explanation: `${candidate.resolution.explanation}. Edited by a human, so it is recorded at human_override authority.`,\n      },\n    };\n  }\n\n  if (candidate.kind === \"premise\" && candidate.premise !== null) {\n    return {\n      ...candidate,\n      premise: editPremise(candidate.premise, fields),\n      origin: \"human_override\",\n      confidence: EDITED_CONFIDENCE,\n      tier: \"high\",\n    };\n  }\n\n  if (candidate.kind === \"alternative\" && candidate.alternative !== null) {\n    return {\n      ...candidate,\n      alternative: editAlternative(candidate.alternative, fields),\n      origin: \"human_override\",\n      confidence: EDITED_CONFIDENCE,\n      tier: \"high\",\n    };\n  }\n\n  return candidate;\n}\n\nfunction editDecision(\n  candidate: DecisionCandidate,\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): DecisionCandidate {\n  return {\n    ...candidate,\n    ...(stringField(fields, \"variable\") === null\n      ? {}\n      : { variable: stringField(fields, \"variable\") as DecisionCandidate[\"variable\"] }),\n    ...(stringField(fields, \"value\") === null\n      ? {}\n      : { value: stringField(fields, \"value\") as string }),\n    ...(stringField(fields, \"statement\") === null\n      ? {}\n      : { statement: stringField(fields, \"statement\") as string }),\n    ...(stringField(fields, \"yStatement\") === null\n      ? {}\n      : { yStatement: stringField(fields, \"yStatement\") as string }),\n    ...(stringField(fields, \"rationale\") === null\n      ? {}\n      : { rationale: stringField(fields, \"rationale\") as string }),\n    origin: \"human_override\",\n    confidence: EDITED_CONFIDENCE,\n    // An edited decision is asserted, not proposed: the human has said the words.\n    // This is the one place `modality` is changed by the review rather than by the\n    // modality detector, and it is correct ΓÇö the human asserting it IS the evidence.\n    modality: \"asserted\",\n  };\n}\n\nfunction editPremise(\n  candidate: PremiseCandidate,\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): PremiseCandidate {\n  return {\n    ...candidate,\n    ...(stringField(fields, \"predicate\") === null\n      ? {}\n      : { predicate: stringField(fields, \"predicate\") as string }),\n    ...(stringField(fields, \"text\") === null\n      ? {}\n      : { text: stringField(fields, \"text\") as string }),\n    ...(fields[\"value\"] === undefined || fields[\"value\"] === null\n      ? {}\n      : { value: fields[\"value\"] as string | number | boolean }),\n    confidence: EDITED_CONFIDENCE,\n    // A human-confirmed premise no longer needs review. This is the only route to\n    // `needsReview: false` in Phase 1, and it requires a person.\n    needsReview: false,\n  };\n}\n\nfunction editAlternative(\n  candidate: AlternativeCandidate,\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n): AlternativeCandidate {\n  return {\n    ...candidate,\n    ...(stringField(fields, \"value\") === null\n      ? {}\n      : { value: stringField(fields, \"value\") as string }),\n    ...(stringField(fields, \"whyRejected\") === null\n      ? {}\n      : { whyRejected: stringField(fields, \"whyRejected\") as string }),\n    confidence: EDITED_CONFIDENCE,\n  };\n}\n\nfunction stringField(\n  fields: Readonly<Record<string, string | number | boolean | null>>,\n  key: string,\n): string | null {\n  const value = fields[key];\n  return typeof value === \"string\" ? value : null;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Batch                                                                      */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Apply one action to a batch.\n *\n * Bulk approve passes `viaBulk: true`, which the fold reads to KEEP THE LABEL AT\n * UNKNOWN. Ten decisions promoted to IN by one click is how a machine inference\n * ends up driving a cascade, so the fast path is fast without being authoritative.\n */\nexport function applyBatch(\n  candidates: readonly ResolvedCandidate[],\n  action: ReviewAction,\n): readonly ResolvedCandidate[] {\n  return candidates.map((candidate) => applyAction(candidate, action));\n}\n\n/** The discard event for one item. Keeps the confidence the item HAD, so the\n *  precision metric can be computed per tier: \"of the items scored high, how many\n *  did the human discard?\" is the number that says whether the rubric is calibrated. */\nexport function discardFrom(item: ReviewItem): DiscardedCandidate {\n  return {\n    kind: item.kind,\n    discardedBy: \"human\",\n    // The quote is preferred over the machine's summary: the discard list is what\n    // Phase 7 reads to compute precision, and a paraphrase in it would make the\n    // measurement measure the paraphraser.\n    rawText: item.quote.length > 0 ? item.quote : item.detail,\n    confidence: asConfidence(item.confidence),\n  };\n}\n\n/**\n * Which decisions a batch would conflict with.\n *\n * Shown BEFORE the action is applied. Bulk-approving three items that each\n * contradict a live decision is the fastest way to put the graph into a state where\n * every subsequent contradiction check fires, and the user is told first.\n */\nexport function conflictsInBatch(candidates: readonly ResolvedCandidate[]): readonly DecisionId[] {\n  const out = new Set<DecisionId>();\n  for (const candidate of candidates) {\n    for (const id of candidate.resolution.conflictsWith) out.add(id);\n  }\n  return [...out];\n}\n\n/** Can this item be bulk-approved? Mirrors `tierDecision.bulkApprovable` for the\n *  graph-sourced queue, where the tier is recomputed from the node's confidence. */\nexport function isBulkApprovable(item: ReviewItem): boolean {\n  return item.kind === \"decision\" && item.tier === \"high\" && item.action === null;\n}\n\n/** The contested items, which is the Hansson queue in Phase 1's clothing: things\n *  that could not outrank a contradictor and are waiting for a human. */\nexport function contestedIn(\n  candidates: readonly ResolvedCandidate[],\n): readonly ResolvedCandidate[] {\n  return candidates.filter((candidate) => candidate.action?.type === \"contest\");\n}\n\n/** The keyboard map, exported so the component and the help panel cannot disagree\n *  about what a key does. */\nexport const REVIEW_KEYS: Readonly<Record<string, string>> = {\n  j: \"next item\",\n  k: \"previous item\",\n  a: \"approve\",\n  d: \"discard\",\n  e: \"edit\",\n  c: \"contest\",\n  Enter: \"approve and advance\",\n  Escape: \"close the editor\",\n  \"Shift+A\": \"approve every expanded item (bulk ΓÇö stays UNKNOWN)\",\n  \"Shift+D\": \"discard every collapsed item\",\n};\n\nexport function describeKeys(): string {\n  return Object.entries(REVIEW_KEYS)\n    .map(([key, meaning]) => `${key} ΓÇö ${meaning}`)\n    .join(\" ┬╖ \");\n}\n\n/** What an action says, in the words the audit trail will show. */\nexport function describeAction(action: ReviewAction | null): string {\n  if (action === null) return \"not reviewed\";\n  switch (action.type) {\n    case \"approve\":\n      return action.viaBulk\n        ? \"approved in bulk ΓÇö recorded, but stays UNKNOWN until approved individually\"\n        : \"approved\";\n    case \"edit\":\n      return `edited: ${Object.keys(action.fields).join(\", \")}`;\n    case \"discard\":\n      return `discarded ΓÇö ${action.reason}`;\n    case \"merge-into\":\n      return `merged into ${action.targetId}, overriding the ladder`;\n    case \"contest\":\n      return `contested ΓÇö ${action.reason}`;\n  }\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/useLiteralKeys","severity":"error","description":"The computed expression can be simplified without the use of a string literal.","message":[{"elements":[],"content":"The computed expression can be simplified without the use of a string literal."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a literal key instead."}]]},{"diff":{"dictionary":"/**\n * Review actions ΓÇö 1.9, the five things a human can do.\n *      ? {}\n      : { text: stringField(fields, \"text\") as string }),\n    ...(fields[\"value\"] ==