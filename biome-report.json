},{"diffOp":{"equal":{"range":[298,321]}}},{"diffOp":{"delete":{"range":[242,243]}}},{"diffOp":{"insert":{"range":[170,177]}}},{"diffOp":{"equal":{"range":[321,337]}}},{"diffOp":{"delete":{"range":[238,242]}}},{"diffOp":{"insert":{"range":[242,248]}}},{"diffOp":{"equal":{"range":[337,370]}}},{"diffOp":{"delete":{"range":[101,102]}}},{"diffOp":{"insert":{"range":[170,177]}}},{"diffOp":{"equal":{"range":[370,410]}}},{"diffOp":{"insert":{"range":[170,175]}}},{"diffOp":{"equal":{"range":[410,424]}}},{"diffOp":{"delete":{"range":[101,102]}}},{"diffOp":{"insert":{"range":[170,177]}}},{"diffOp":{"equal":{"range":[424,460]}}},{"diffOp":{"delete":{"range":[242,243]}}},{"diffOp":{"insert":{"range":[170,177]}}},{"diffOp":{"equal":{"range":[460,469]}}},{"diffOp":{"delete":{"range":[242,243]}}},{"diffOp":{"insert":{"range":[170,177]}}},{"diffOp":{"equal":{"range":[469,490]}}},{"diffOp":{"delete":{"range":[242,243]}}},{"diffOp":{"insert":{"range":[170,177]}}},{"diffOp":{"equal":{"range":[490,520]}}},{"diffOp":{"insert":{"range":[520,524]}}},{"diffOp":{"equal":{"range":[524,625]}}},{"equalLines":{"line_count":11}},{"diffOp":{"equal":{"range":[625,724]}}},{"diffOp":{"insert":{"range":[724,733]}}},{"diffOp":{"equal":{"range":[733,739]}}},{"diffOp":{"delete":{"range":[242,243]}}},{"diffOp":{"insert":{"range":[739,750]}}},{"diffOp":{"equal":{"range":[750,802]}}},{"diffOp":{"delete":{"range":[101,102]}}},{"diffOp":{"insert":{"range":[739,750]}}},{"diffOp":{"equal":{"range":[802,807]}}},{"diffOp":{"delete":{"range":[101,102]}}},{"diffOp":{"insert":{"range":[739,750]}}},{"diffOp":{"equal":{"range":[807,827]}}},{"diffOp":{"delete":{"range":[238,239]}}},{"diffOp":{"insert":{"range":[739,750]}}},{"diffOp":{"equal":{"range":[827,835]}}},{"diffOp":{"delete":{"range":[238,239]}}},{"diffOp":{"insert":{"range":[739,750]}}},{"diffOp":{"equal":{"range":[835,857]}}},{"diffOp":{"insert":{"range":[857,865]}}},{"diffOp":{"equal":{"range":[865,922]}}},{"equalLines":{"line_count":18}},{"diffOp":{"equal":{"range":[922,949]}}},{"diffOp":{"delete":{"range":[242,243]}}},{"diffOp":{"insert":{"range":[739,744]}}},{"diffOp":{"equal":{"range":[949,1081]}}},{"equalLines":{"line_count":20}},{"diffOp":{"equal":{"range":[1081,1140]}}},{"diffOp":{"insert":{"range":[739,744]}}},{"diffOp":{"equal":{"range":[1140,1173]}}},{"diffOp":{"insert":{"range":[750,751]}}},{"diffOp":{"equal":{"range":[1173,1201]}}},{"diffOp":{"insert":{"range":[524,525]}}},{"diffOp":{"equal":{"range":[1201,1225]}}},{"diffOp":{"insert":{"range":[857,861]}}},{"diffOp":{"equal":{"range":[1225,1256]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\run.ts"},"span":null,"sourceCode":"/**\n * `npm run eval` ΓÇö score the full system once, on the local engine, and print every number.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * This is the entry point a judge should be invited to run. It needs no API key, no network and no\n * build step: `tsx src/eval/run.ts` against the checked-in corpus. If it cannot be run by a stranger in\n * under a minute, the numbers in the pitch are not verifiable and the pitch is an advertisement.\n */\n\nimport { describeFailures, runConfig } from \"./harness\";\nimport { FULL, DEFAULT_PARAMS } from \"./ablation/toggles\";\nimport { renderSuite, scoreAll } from \"./metrics\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { renderFullReport } from \"./report\";\nimport { harden, renderHardening } from \"./hardening\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, engine, engineId } = prepare();\n\n  banner(\"Baseline run ΓÇö all eleven components on\");\n\n  const run = await runConfig(resolved, {\n    id: \"full\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  heading(\"Import\");\n  line(describeFailures(run));\n  line(\n    run.state.decisions.size + \" decisions ┬╖ \" + run.state.premises.size + \" premises ┬╖ \" +\n    run.state.alternatives.size + \" alternatives ┬╖ \" + run.state.guards.size + \" guards ┬╖ \" +\n    run.state.contradictions.length + \" contradiction record(s)\",\n  );\n  line(\"Wall time \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.proposalsRaised + \" revision proposal(s) raised\");\n\n  /* A revision the log refused means the reasoner emitted a draft that failed validation, so the\n   * graph scored below is the PRE-revision graph for that pass. Printed rather than swallowed:\n   * without it a cascade score of \"nothing changed\" is indistinguishable from \"nothing was allowed\n   * to change\". */\n  if (run.revisionFailures.length > 0) {\n    blank();\n    line(\"Revision passes the log REFUSED (\" + run.revisionFailures.length + \"):\");\n    for (const failure of run.revisionFailures) line(\"  \" + failure);\n  }\n\n  if (run.interventions.length > 0) {\n    blank();\n    line(\"Planted interventions:\");\n    for (const intervention of run.interventions) {\n      line(\"  \" + (intervention.applied ? \"APPLIED  \" : \"UNAPPLIED\") + \" \" + intervention.plant + \" ┬╖ \" + intervention.predicate);\n      line(\"           \" + intervention.reason);\n    }\n  }\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  heading(\"Metrics\");\n  line(renderSuite(scored));\n\n  const hardened = harden(resolved, scored);\n\n  heading(\"Hardening pass (7.4)\");\n  line(renderHardening(hardened));\n\n  heading(\"What each number does not establish\");\n  for (const metric of scored.metrics) {\n    line(\"┬╖ \" + metric.name);\n    line(\"  \" + metric.gloss);\n    line(\"  honest note: \" + metric.honestNote);\n    blank();\n  }\n\n  if (args.has(\"out\")) write(args.get(\"out\") ?? \"eval-report.md\", renderFullReport(resolved, scored, null, hardened));\n  if (args.has(\"json\")) {\n    write(\n      args.get(\"json\") ?? \"eval-report.json\",\n      JSON.stringify(\n        {\n          corpus: resolved.version,\n          engine: engineId,\n          ranAt: run.startedAt,\n          metrics: scored.metrics,\n        },\n        null,\n        2,\n      ),\n    );\n  }\n\n  blank();\n  line(\"Run `npm run eval:ablation` for the delta table and the prediction audit.\");\n  line(\"Run `npm run demo:verify` for the demo kit: script, beat verification, three dry runs.\");\n\n  if (!hardened.ready) process.exitCode = 1;\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 40 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 40 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 40 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\consistency-gate.ts"},"span":[4988,5003],"sourceCode":"/**\n * The pre-export consistency gate ΓÇö 5.6. Γÿà\n *\n * Phase 5 ┬╖ sub-phase 5.6\n * Plan: plan/phase-5-export-compiler.md ┬º5.6\n * Docs: docs/01-prior-art-landscape.md ┬º4.5\n *\n * ---------------------------------------------------------------------------\n * THE ONLY PLACE THE TWO PILLARS VISIBLY INTERLOCK\n *\n * \"A human reconciles contradictions on the fly. An agent needs them reconciled in advance.\"\n *\n * Everywhere else in the product, truth maintenance produces a finding for a person to read.\n * Here it PREVENTS an outcome: a log containing two mutually exclusive IN decisions cannot be\n * compiled into a context file, because the file would tell an agent to do two incompatible\n * things and ΓÇö in Anthropic's words ΓÇö \"the model may pick one arbitrarily\".\n *\n * That is worth saying out loud, because it is the moment the reasoning layer stops being a\n * dashboard and starts being load-bearing for something the user ships.\n *\n * ---------------------------------------------------------------------------\n * IT DELEGATES TO GATE (a) RATHER THAN RE-DETECTING\n *\n * `wouldContradict` from `reasoning/gates/structural.ts` decides what conflicts. This file only\n * decides whether both sides are being exported.\n *\n * That is a deliberate lesson from the Phase 2 audit, where the adjudicator implemented a\n * NARROWER rule than gate (a) ΓÇö antonym pairs only, where the gate fired on two conditions ΓÇö so\n * a newcomer could be ACCEPTED while gate (a) reported a contradiction. A detector and a\n * consumer of that detector must never each have their own idea of what it detects. If this file\n * re-implemented the antonym lookup, an export could be blocked for a pair the reasoning layer\n * considered fine, or cleared for one it had already flagged.\n *\n * ---------------------------------------------------------------------------\n * FOUR OUTCOMES, AND ONLY ONE OF THEM STOPS THE EXPORT\n *\n *   two exported decisions in conflict      BLOCK   ΓÇö never silently drop one side\n *   an exported decision labelled OUT       WARN + exclude\n *   a contested premise in a Because: line  ANNOTATE\n *   a failing guard on an emitted decision  ANNOTATE\n *\n * Blocking is reserved for the case where the file would be actively wrong. Everything else is\n * surfaced in the artifact itself, at the point of use, because a warning in a side panel is a\n * warning an agent never sees.\n *\n * Dropping one side of a conflict would be the easy implementation and the wrong one: the user\n * would get a clean-looking file and no idea that the log disagrees with itself.\n * ---------------------------------------------------------------------------\n */\n\nimport { detectStructural } from \"@/reasoning/gates/structural\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { DecisionId, PremiseId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { ConflictPair, ConsistencyGateResult, ExportWarning } from \"@/types/export\";\n\nexport interface GateInput {\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  /** The decisions the caller intends to emit. */\n  readonly candidates: readonly DecisionId[];\n  /**\n   * The subset of `candidates` that will actually be WRITTEN.\n   *\n   * Two sets, because two different questions are being asked. \"Does the log contradict\n   * itself?\" is answered over every candidate, and every conflict is reported. \"Would the\n   * file tell an agent to do two incompatible things?\" is answered over the emitted set\n   * only: a decision that is labelled OUT, or superseded, is excluded from the file, so a\n   * conflict with it is the log's problem and not the file's.\n   *\n   * Defaults to `candidates` when the caller does not say, so a standalone preview of the\n   * gate blocks on anything it can see.\n   */\n  readonly emitted?: readonly DecisionId[];\n}\n\nexport interface GateReport {\n  readonly result: ConsistencyGateResult;\n  /** Conflicts found, whether or not they block. A conflict where one side is already excluded\n   *  is reported as a warning: the file will be consistent, but the log is not, and hiding that\n   *  because the export happened to dodge it would be the wrong kind of helpful. */\n  readonly conflicts: readonly ConflictPair[];\n  readonly warnings: readonly ExportWarning[];\n  readonly annotations: readonly Annotation[];\n  readonly blocked: boolean;\n}\n\n/** An inline annotation to attach to a specific record. */\nexport interface Annotation {\n  readonly decisionId: DecisionId;\n  readonly kind: \"contested-premise\" | \"failing-guard\" | \"no-guards\";\n  readonly text: string;\n}\n\n/**\n * Run the gate.\n *\n * Pure and synchronous: it reads the graph and returns a verdict. It does not modify the\n * candidate list ΓÇö `cif.ts` applies the exclusions, so the gate can be run on its own for a\n * preview (\"would this export be blocked?\") without committing to a compile.\n */\nexport function consistencyGate(input: GateInput): GateReport {\n  const candidateSet = new Set(input.candidates);\n  /* The decisions that will actually be WRITTEN. See `GateInput.emitted`: the two sets answer\n   * two different questions, and blocking is about the file, not about the log. */\n  const emittedSet = new Set(input.emitted ?? input.candidates);\n  const conflicts: ConflictPair[] = [];\n  const warnings: ExportWarning[] = [];\n  const annotations: Annotation[] = [];\n  const seenPairs = new Set<string>();\n\n  /* ---- conflicts: delegated to gate (a) ----\n   *\n   * `detectStructural` is gate (a)'s POST-HOC form: it looks at decisions that ALREADY EXIST and\n   * returns pairs of them. `wouldContradict` is gate (a)'s PRE-COMMIT form: it answers \"would\n   * asserting this value contradict something live?\", so the side it names as `decisionB` is the\n   * NEWCOMER sentinel - the decision that does not exist yet.\n   *\n   * This file used the pre-commit form and copied `hit.decisionA`/`hit.decisionB` straight into\n   * the conflict pair. Every pair therefore contained \"WLD-NEW\", which is never in the candidate\n   * set, so `candidateSet.has(a) && candidateSet.has(b)` was never true and `blocking` was always\n   * empty: the gate DETECTED contradictions, REPORTED them, and could never REFUSE anything. A\n   * gate that cannot block is a comment.\n   *\n   * Both forms share one detector - `canonicalValueOf` plus `areAntonyms` plus the same\n   * exclusions - so using the post-hoc form does not give the export a second opinion about what\n   * a contradiction is. It gives it the right SHAPE: two real decisions.\n   */\n  const structural = detectStructural(input.state);\n\n  for (const decisionId of input.candidates) {\n    const decision = input.state.decisions.get(decisionId);\n    if (decision === undefined) continue;\n\n    const label = input.labels.get(decisionId)?.label ?? decision.label;\n\n    /* ---- OUT: warn and exclude ---- */\n    if (label === \"OUT\") {\n      warnings.push({ kind: \"out-decision-excluded\", decisionId });\n    }\n\n    /* ---- conflicts ---- */\n    const hits = structural.filter(\n      (hit) => hit.decisionA === decisionId || hit.decisionB === decisionId,\n    );\n\n    for (const hit of hits) {\n      const other = hit.decisionA === decisionId ? hit.decisionB : hit.decisionA;\n      const key =\n        decisionId < other ? `${decisionId}\\u0000${other}` : `${other}\\u0000${decisionId}`;\n      if (seenPairs.has(key)) continue;\n      seenPairs.add(key);\n\n      const pair: ConflictPair = {\n        a: hit.decisionA,\n        b: hit.decisionB,\n        explanation:\n          hit.explanation +\n          (emittedSet.has(hit.decisionA) && emittedSet.has(hit.decisionB)\n            ? \" BOTH are being exported, so the compiled file would tell an agent to do two incompatible things.\"\n            : \" Only one of the two is being exported, so the file itself stays consistent ΓÇö but the log does not.\"),\n      };\n\n      conflicts.push(pair);\n\n      if (!candidateSet.has(other)) {\n        warnings.push({ kind: \"out-decision-excluded\", decisionId: other });\n      }\n    }\n\n    /* ---- contested premise in the Because: line ---- */\n    for (const premiseId of premisesOf(input.state, decisionId)) {\n      const premise = input.state.premises.get(premiseId);\n      const premiseLabel = input.labels.get(premiseId)?.label ?? premise?.label ?? \"UNKNOWN\";\n\n      if (premiseLabel === \"UNKNOWN\") {\n        warnings.push({ kind: \"contested-premise\", decisionId, premiseId });\n        annotations.push({\n          decisionId,\n          kind: \"contested-premise\",\n          text: `Premise ${premiseId}${premise === undefined ? \"\" : ` (\"${premise.text}\")`} is CONTESTED ΓÇö neither confirmed nor refuted. This rule rests on something the log has not settled, so it may be about to change.`,\n        });\n      }\n    }\n\n    /* ---- failing guard ---- */\n    const failing = failingGuardIds(input.state, decision);\n    if (failing.length > 0) {\n      warnings.push({ kind: \"failing-guard\", decisionId });\n      annotations.push({\n        decisionId,\n        kind: \"failing-guard\",\n        text: `VERIFY CURRENTLY FAILS: ${failing.join(\", \")}. The code does not currently satisfy this rule. Either the rule has drifted or the decision has been reversed in practice and not in the log ΓÇö resolve it before trusting the rule.`,\n      });\n    }\n\n    /* ---- no guards at all ---- */\n    if (decision.guardIds.length === 0) {\n      annotations.push({\n        decisionId,\n        kind: \"no-guards\",\n        text: \"UNVERIFIABLE: no guard could be compiled from this decision, so nothing would tell you if it stopped holding. It is emitted because it is believed, not because it is checked.\",\n      });\n    }\n  }\n\n  /* Only a conflict where BOTH sides are EMITTED blocks. A conflict with an excluded\n   * decision is the log's inconsistency, not the file's: the file never contains both\n   * answers, so the file is not wrong. It is still reported, because the log is. */\n  const blocking = conflicts.filter((pair) => emittedSet.has(pair.a) && emittedSet.has(pair.b));\n\n  const result: ConsistencyGateResult =\n    blocking.length === 0 ? { ok: true } : { ok: false, blocking, warnings };\n\n  return { result, conflicts, warnings, annotations, blocked: blocking.length > 0 };\n}\n\n/** The premise ids a decision rests on. Typed `PremiseId`, not `DecisionId`: getting this wrong\n *  forces a cast at every use site, and a cast silencing the checker exactly where two id kinds\n *  meet is how a premise id ends up compared against a decision id. */\nfunction premisesOf(state: GraphState, decisionId: DecisionId): readonly PremiseId[] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return [];\n\n  const out: PremiseId[] = [];\n  const seen = new Set<PremiseId>();\n\n  for (const justificationId of decision.justificationIds) {\n    const justification = state.justifications.get(justificationId);\n    if (justification === undefined) continue;\n    for (const premiseId of justification.inList) {\n      if (seen.has(premiseId)) continue;\n      seen.add(premiseId);\n      out.push(premiseId);\n    }\n  }\n\n  return out;\n}\n\nfunction failingGuardIds(state: GraphState, decision: Decision): readonly string[] {\n  const out: string[] = [];\n\n  for (const guardId of decision.guardIds) {\n    const guard = state.guards.get(guardId);\n    if (guard === undefined) continue;\n    if (guard.lifecycle !== \"accepted\") continue;\n    if (guard.disabledByDecisionLabel) continue;\n    if (guard.lastRun === undefined) continue;\n    if (guard.lastRun.outcome === \"fail\") out.push(guardId);\n  }\n\n  return out;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\n/**\n * The blocked-export explanation.\n *\n * Shows the conflicting pair, the rule that fired, the nogood if the log has one covering these\n * premises, and where to resolve it. Never one side alone ΓÇö presenting one decision as \"the\n * problem\" would invite deleting it, and deleting a decision is not reconciling a contradiction.\n */\nexport function renderBlocked(report: GateReport, state: GraphState): string {\n  const blocking = report.result.ok ? [] : report.result.blocking;\n\n  const lines = [\n    \"EXPORT BLOCKED ΓÇö the log contradicts itself, and compiling it would hand an agent two\",\n    'incompatible rules. \"If two rules contradict each other, the model may pick one',\n    'arbitrarily.\" Neither side is dropped: dropping one would produce a clean-looking file and',\n    \"hide the fact that the log disagrees with itself.\",\n    \"\",\n  ];\n\n  for (const pair of blocking) {\n    const a = state.decisions.get(pair.a);\n    const b = state.decisions.get(pair.b);\n\n    lines.push(`  ${pair.a} ΓÇö ${a?.statement ?? \"(not in log)\"}`);\n    lines.push(`  ${pair.b} ΓÇö ${b?.statement ?? \"(not in log)\"}`);\n    lines.push(`  ${pair.explanation}`);\n\n    const nogood = relevantNogood(state, pair);\n    if (nogood !== null) {\n      lines.push(`  Recorded nogood ${nogood.id}: ${nogood.explanation}`);\n    }\n\n    const proposal = relevantProposal(state, pair);\n    if (proposal !== null) lines.push(`  Revision proposal ${proposal} already covers this pair.`);\n\n    lines.push(\"\");\n    lines.push(\"  Resolve it on the Reasoning tab: reverse one, re-justify one, or vouch for the\");\n    lines.push(\"  incumbent. Then re-export.\");\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction relevantNogood(\n  state: GraphState,\n  pair: ConflictPair,\n): { id: string; explanation: string } | null {\n  const a = state.decisions.get(pair.a);\n  const b = state.decisions.get(pair.b);\n  if (a === undefined || b === undefined) return null;\n\n  /* Relevant when the nogood covers premises on BOTH sides: the log has already recorded that\n   * this conjunction of assumptions is impossible, which is the strongest available explanation\n   * of why the two decisions cannot both stand. */\n  const aPremises = premisesOf(state, pair.a);\n  const bPremises = premisesOf(state, pair.b);\n  if (aPremises.length === 0 || bPremises.length === 0) return null;\n\n  for (const nogood of state.nogoods.values()) {\n    const premises = new Set<PremiseId>(nogood.premiseIds);\n    if (aPremises.some((id) => premises.has(id)) && bPremises.some((id) => premises.has(id))) {\n      return { id: nogood.id, explanation: nogood.explanation };\n    }\n  }\n\n  return null;\n}\n\n/** A proposal covers this pair when either side is the decision it found unsound.\n *  `RevisionProposal` names that field `unsoundDecisionId` ΓÇö it has no `decisionId`, because a\n *  proposal is ABOUT a failure, not about a decision in the abstract. */\nfunction relevantProposal(state: GraphState, pair: ConflictPair): string | null {\n  for (const proposal of state.proposals.values()) {\n    if (proposal.unsoundDecisionId === pair.a || proposal.unsoundDecisionId === pair.b)\n      return proposal.id;\n  }\n  return null;\n}\n\n/** The annotations for one record, as the lines appended to it. */\nexport function annotationsFor(report: GateReport, decisionId: DecisionId): readonly string[] {\n  return report.annotations\n    .filter((entry) => entry.decisionId === decisionId)\n    .map((entry) => entry.text);\n}\n\n/** Warnings that do not block, for the export summary. */\nexport function renderWarnings(report: GateReport): string {\n  if (report.warnings.length === 0)\n    return \"No warnings. Every emitted decision is IN, settled, and currently passing its guards.\";\n\n  const counts = new Map<string, number>();\n  for (const warning of report.warnings) {\n    counts.set(warning.kind, (counts.get(warning.kind) ?? 0) + 1);\n  }\n\n  const lines = [\"Annotated rather than hidden:\"];\n  for (const [kind, count] of counts) {\n    lines.push(`  ${count} ├ù ${describeWarningKind(kind)}`);\n  }\n\n  lines.push(\"\");\n  lines.push(\n    \"Each of these appears INLINE on the record it concerns. An agent reading the file has\",\n  );\n  lines.push(\n    \"to see them at the point of use ΓÇö a warning in a side panel is a warning it never sees.\",\n  );\n\n  return lines.join(\"\\n\");\n}\n\nfunction describeWarningKind(kind: string): string {\n  switch (kind) {\n    case \"out-decision-excluded\":\n      return \"OUT decision excluded from the export\";\n    case \"contested-premise\":\n      return \"contested premise in a Because: line\";\n    case \"failing-guard\":\n      return \"failing guard on an emitted decision\";\n    case \"over-budget\":\n      return \"decision pushed to the tier-2 index by the token budget\";\n    default:\n      return kind;\n  }\n}\n\nexport function describeGate(): string {\n  return [\n    \"Pre-export consistency gate ΓÇö four outcomes, one of which stops the export:\",\n    \"\",\n    \"  two exported decisions in conflict      BLOCK    never silently drop one side\",\n    \"  an exported decision labelled OUT       WARN + exclude\",\n    \"  a contested premise in a Because: line  ANNOTATE inline\",\n    \"  a failing guard on an emitted decision  ANNOTATE inline\",\n    \"\",\n    \"Conflict detection is DELEGATED to gate (a)'s `wouldContradict`. This file decides only\",\n    \"whether both sides are being exported. A detector and a consumer of that detector must never\",\n    \"each have their own idea of what it detects ΓÇö that mismatch was the Phase 2 audit's gap 3,\",\n    \"where an adjudicator with a narrower rule than its gate let a newcomer be ACCEPTED while the\",\n    \"gate reported a contradiction.\",\n    \"\",\n    \"This is the only place in the product where truth maintenance PREVENTS an outcome rather than\",\n    \"reporting one. Everywhere else it produces a finding for a person to read; here it stops a\",\n    \"self-contradictory file from reaching an agent's context window.\",\n  ].join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 16 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 16 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 16 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\export\\priority.ts"},"span":[6127,6141],"sourceCode":"/**\n * Inclusion priority ΓÇö 5.4.\n *\n * Phase 5 ┬╖ sub-phase 5.4\n * Plan: plan/phase-5-export-compiler.md ┬º5.4\n *\n * ---------------------------------------------------------------------------\n * WHY RANK AT ALL\n *\n * Anthropic's guidance is ~200 lines per context file, because \"longer files consume more\n * context and reduce adherence\". A mature log has more decisions than fit. So something has to\n * be left out, and the question is whether the thing left out is chosen by a rule anyone can\n * read or by whichever decision happened to sort first by id.\n *\n * ---------------------------------------------------------------------------\n *     priority(d) = 0.35 ┬╖ soundness       IN > UNKNOWN > OUT\n *                 + 0.25 ┬╖ entrenchment    strongly held decisions first\n *                 + 0.20 ┬╖ scope breadth   decisions governing many files first\n *                 + 0.15 ┬╖ guard severity  blocking guards before warning\n *                 + 0.05 ┬╖ recency\n *\n * The weights come from the plan and are printed in the export view. They are inspectable\n * because a ranking nobody can read is a ranking nobody can argue with ΓÇö the same rule the\n * retrieval reranker follows.\n *\n * ---------------------------------------------------------------------------\n * SOUNDNESS DOMINATES, AND OUT IS EXCLUDED BEFORE RANKING\n *\n * 0.35 is the largest weight, but it is not what keeps OUT decisions out of the file ΓÇö they are\n * removed BEFORE ranking, by default, and only returned under an explicit toggle. Ranking an OUT\n * decision highly and then emitting it would put a rule the log no longer believes into an\n * agent's context alongside its replacement, which is exactly the \"the model may pick one\n * arbitrarily\" failure ┬º5.6 exists to prevent.\n *\n * The weight matters for the cases in between: UNKNOWN and UNFOUNDED decisions are still\n * believed, just not well-supported, and they should lose a budget slot to an IN one.\n * ---------------------------------------------------------------------------\n */\n\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { Decision } from \"@/types/domain\";\nimport type { DecisionLabel } from \"@/types/domain\";\nimport { EXPORT_PRIORITY_WEIGHTS } from \"@/types/export\";\n\n/** Soundness by label. IN is 1; the rest are graded by how much support is missing. */\nexport const SOUNDNESS_BY_LABEL: Readonly<Record<DecisionLabel, number>> = {\n  IN: 1,\n  UNKNOWN: 0.5,\n  UNFOUNDED: 0.3,\n  OUT: 0,\n};\n\n/** Recency half-life for the 0.05 term. 365 days, deliberately long: recency is a tie-breaker,\n *  not a signal. A three-year-old decision that is IN, entrenched and blocking-guarded should\n *  outrank something decided last week that governs one file. Using the 180-day half-life the\n *  retrieval reranker uses would let freshness move decisions the other four terms agree on. */\nexport const RECENCY_HALF_LIFE_DAYS = 365;\n\n/** Scope breadth saturates here. A decision governing 12 globs is not four times as important as\n *  one governing 3; it is somewhat broader. Without saturation a single decision with a long\n *  `applies_to` list would outrank everything else on 0.20 of the total. */\nexport const SCOPE_SATURATION = 6;\n\nexport interface PriorityInput {\n  readonly decision: Decision;\n  readonly label: DecisionLabel;\n  /** Fraction of the decision's accepted guards that pass, or null when it has none. */\n  readonly guardStatus: { passing: number; total: number; hasBlocking: boolean } | null;\n  readonly now: number;\n}\n\nexport interface PriorityBreakdown {\n  readonly total: number;\n  readonly soundness: number;\n  readonly entrenchment: number;\n  readonly scopeBreadth: number;\n  readonly guardSeverity: number;\n  readonly recency: number;\n}\n\nexport function priorityOf(input: PriorityInput): PriorityBreakdown {\n  const soundness = SOUNDNESS_BY_LABEL[input.label] ?? 0;\n\n  /* `decision.entrenchment` is already 0..1 and already folds in source authority,\n   * implementation cost, corroboration, confidence and recency. Reusing it rather than\n   * recomputing keeps the export's notion of \"strongly held\" identical to the reasoning layer's\n   * ΓÇö two entrenchment functions would eventually rank differently and nobody would know which\n   * was right. */\n  const entrenchment = clamp01(input.decision.entrenchment);\n\n  const scopeBreadth = clamp01(input.decision.appliesTo.length / SCOPE_SATURATION);\n\n  /* Blocking guards outrank warning ones because a blocking guard failing stops a build: the\n   * decision it protects is one the project has already agreed to enforce. A decision with no\n   * guards scores 0 here, which is correct ΓÇö it is less load-bearing in the verification sense,\n   * and ┬º5.3's \"verifiable\" property is exactly what it lacks. */\n  let guardSeverity = 0;\n  if (input.guardStatus !== null && input.guardStatus.total > 0) {\n    guardSeverity = input.guardStatus.hasBlocking ? 1 : 0.6;\n  }\n\n  const recency = recencyScore(input.decision.temporal.valid, input.now);\n\n  const total =\n    EXPORT_PRIORITY_WEIGHTS.soundness * soundness +\n    EXPORT_PRIORITY_WEIGHTS.entrenchment * entrenchment +\n    EXPORT_PRIORITY_WEIGHTS.scopeBreadth * scopeBreadth +\n    EXPORT_PRIORITY_WEIGHTS.guardSeverity * guardSeverity +\n    EXPORT_PRIORITY_WEIGHTS.recency * recency;\n\n  return { total, soundness, entrenchment, scopeBreadth, guardSeverity, recency };\n}\n\n/** Exponential decay on VALID time, not learned time. Ordering and display use valid time\n *  throughout the product: a decision made three years ago and imported yesterday is three years\n *  old, and ranking it as fresh would misrepresent when it was taken. */\nexport function recencyScore(validFrom: string, now: number): number {\n  const then = Date.parse(validFrom);\n  if (Number.isNaN(then)) return 0;\n\n  const days = Math.max(0, (now - then) / 86_400_000);\n  return 0.5 ** (days / RECENCY_HALF_LIFE_DAYS);\n}\n\nfunction clamp01(value: number): number {\n  if (Number.isNaN(value)) return 0;\n  return Math.min(1, Math.max(0, value));\n}\n\n/** Guard facts for one decision, read once. */\nexport function guardStatusFor(\n  state: GraphState,\n  labels: ReadonlyMap<NodeId, Labelled>,\n  decisionId: Decision[\"id\"],\n): PriorityInput[\"guardStatus\"] {\n  const decision = state.decisions.get(decisionId);\n  if (decision === undefined) return null;\n\n  let passing = 0;\n  let total = 0;\n  let hasBlocking = false;\n\n  for (const guardId of decision.guardIds) {\n    const guard = state.guards.get(guardId);\n    if (guard === undefined) continue;\n    if (guard.lifecycle !== \"accepted\") continue;\n    if (guard.disabledByDecisionLabel) continue;\n    if (labels.get(decisionId)?.label !== \"IN\") continue;\n\n    total += 1;\n    if (guard.severity === \"blocking\") hasBlocking = true;\n    if (guard.lastRun !== undefined && guard.lastRun.outcome === \"pass\") passing += 1;\n  }\n\n  return total === 0 ? null : { passing, total, hasBlocking };\n}\n\nexport function explainPriority(breakdown: PriorityBreakdown): string {\n  return `priority ${breakdown.total.toFixed(3)} = ${EXPORT_PRIORITY_WEIGHTS.soundness}┬╖soundness(${breakdown.soundness.toFixed(2)}) + ${EXPORT_PRIORITY_WEIGHTS.entrenchment}┬╖entrenchment(${breakdown.entrenchment.toFixed(2)}) + ${EXPORT_PRIORITY_WEIGHTS.scopeBreadth}┬╖scope(${breakdown.scopeBreadth.toFixed(2)}) + ${EXPORT_PRIORITY_WEIGHTS.guardSeverity}┬╖guardSeverity(${breakdown.guardSeverity.toFixed(2)}) + ${EXPORT_PRIORITY_WEIGHTS.recency}┬╖recency(${breakdown.recency.toFixed(2)})`;\n}\n\nexport function describePriority(): string {\n  return [\n    \"Inclusion priority ΓÇö what gets an inline slot when the log is bigger than the budget:\",\n    \"\",\n    `  ${EXPORT_PRIORITY_WEIGHTS.soundness}  soundness       IN 1.0 ┬╖ UNKNOWN 0.5 ┬╖ UNFOUNDED 0.3 ┬╖ OUT 0.0`,\n    `  ${EXPORT_PRIORITY_WEIGHTS.entrenchment}  entrenchment    decision.entrenchment, REUSED not recomputed`,\n    `  ${EXPORT_PRIORITY_WEIGHTS.scopeBreadth}  scope breadth   appliesTo.length / ${SCOPE_SATURATION}, saturating`,\n    `  ${EXPORT_PRIORITY_WEIGHTS.guardSeverity}  guard severity  1.0 with a blocking guard ┬╖ 0.6 warning-only ┬╖ 0 none`,\n    `  ${EXPORT_PRIORITY_WEIGHTS.recency}  recency         half-life ${RECENCY_HALF_LIFE_DAYS} days on VALID time`,\n    \"\",\n    \"OUT decisions are EXCLUDED before ranking, not ranked low. Ranking one highly and emitting it\",\n    'would put a rule the log no longer believes next to its replacement ΓÇö the \"model may pick',\n    \"one arbitrarily\\\" failure. Recency's half-life is a year rather than the 180 days retrieval\",\n    \"uses, because here it is a tie-breaker and must not overturn the other four terms.\",\n  ].join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"`revision-rejected: \" + ${validationMessage(committed.validation)}` };\n  }\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":183}},{"diffOp":{"equal":{"range":[53,113]}}},{"diffOp":{"delete":{"range":[113,114]}}},{"diffOp":{"insert":{"range":[114,115]}}},{"diffOp":{"equal":{"range":[115,134]}}},{"diffOp":{"delete":{"range":[134,138]}}},{"diffOp":{"insert":{"range":[138,140]}}},{"diffOp":{"equal":{"range":[140,179]}}},{"diffOp":{"insert":{"range":[179,181]}}},{"diffOp":{"equal":{"range":[181,182]}}},{"diffOp":{"equal":{"range":[182,189]}}},{"equalLines":{"line_count":535}},{"diffOp":{"equal":{"range":[189,218]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[8225,8288],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *          now: clock.next(),\n          actor: ACTOR,\n          reason: \"`Eval harness importing \" + ${transcript.id}`,\n          occurredAt: asISO(transcript.occurredAt),\n        },  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":329}},{"diffOp":{"equal":{"range":[53,124]}}},{"diffOp":{"delete":{"range":[124,125]}}},{"diffOp":{"insert":{"range":[125,126]}}},{"diffOp":{"equal":{"range":[126,149]}}},{"diffOp":{"delete":{"range":[149,153]}}},{"diffOp":{"insert":{"range":[153,155]}}},{"diffOp":{"equal":{"range":[155,168]}}},{"diffOp":{"insert":{"range":[168,170]}}},{"diffOp":{"equal":{"range":[170,234]}}},{"equalLines":{"line_count":389}},{"diffOp":{"equal":{"range":[234,263]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[14592,14633],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *        runtimeId: transcriptId,\n        ok: false,\n        failure: \"`append-rejected: \" + ${validationMessage(appended.validation)}`,\n        durationMs: monotonicNow() - tStart,\n        decisionIds,  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":340}},{"diffOp":{"equal":{"range":[53,122]}}},{"diffOp":{"delete":{"range":[122,123]}}},{"diffOp":{"insert":{"range":[123,124]}}},{"diffOp":{"equal":{"range":[124,141]}}},{"diffOp":{"delete":{"range":[141,145]}}},{"diffOp":{"insert":{"range":[145,147]}}},{"diffOp":{"equal":{"range":[147,185]}}},{"diffOp":{"insert":{"range":[185,187]}}},{"diffOp":{"equal":{"range":[187,254]}}},{"equalLines":{"line_count":378}},{"diffOp":{"equal":{"range":[254,283]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[14855,14915],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *      revised,\n      clock,\n      config.engineId,\n      \"`Eval harness revision pass after importing \" + ${transcript.id}`,\n    );\n    log = afterImport.log;  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":370}},{"diffOp":{"equal":{"range":[53,103]}}},{"diffOp":{"equal":{"range":[103,110]}}},{"diffOp":{"delete":{"range":[110,111]}}},{"diffOp":{"insert":{"range":[111,112]}}},{"diffOp":{"equal":{"range":[112,155]}}},{"diffOp":{"delete":{"range":[155,159]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[161,174]}}},{"diffOp":{"insert":{"range":[174,176]}}},{"diffOp":{"equal":{"range":[176,211]}}},{"equalLines":{"line_count":347}},{"diffOp":{"equal":{"range":[211,240]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[15898,15959],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"`append rejected: \" + ${validationMessage(falsified.validation)}` });\n        continue;\n      }  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":440}},{"diffOp":{"equal":{"range":[53,200]}}},{"diffOp":{"delete":{"range":[200,201]}}},{"diffOp":{"insert":{"range":[201,202]}}},{"diffOp":{"equal":{"range":[202,219]}}},{"diffOp":{"delete":{"range":[219,223]}}},{"diffOp":{"insert":{"range":[223,225]}}},{"diffOp":{"equal":{"range":[225,264]}}},{"diffOp":{"insert":{"range":[264,266]}}},{"diffOp":{"equal":{"range":[266,267]}}},{"diffOp":{"equal":{"range":[267,296]}}},{"equalLines":{"line_count":278}},{"diffOp":{"equal":{"range":[296,325]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[18520,18581],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *        afterFalsify,\n        clock,\n        config.engineId,\n        \"`Eval harness revision pass after falsifying \" + ${step.predicate}`,\n      );\n      log = afterIntervention.log;  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":459}},{"diffOp":{"equal":{"range":[53,114]}}},{"diffOp":{"equal":{"range":[114,123]}}},{"diffOp":{"delete":{"range":[123,124]}}},{"diffOp":{"insert":{"range":[124,125]}}},{"diffOp":{"equal":{"range":[125,169]}}},{"diffOp":{"delete":{"range":[169,173]}}},{"diffOp":{"insert":{"range":[173,175]}}},{"diffOp":{"equal":{"range":[175,189]}}},{"diffOp":{"insert":{"range":[189,191]}}},{"diffOp":{"equal":{"range":[191,236]}}},{"equalLines":{"line_count":258}},{"diffOp":{"equal":{"range":[236,265]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[19149,19212],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/complexity/noExcessiveCognitiveComplexity","severity":"warning","description":"Excessive complexity of 51 detected (max: 15).","message":[{"elements":[],"content":"Excessive complexity of 51 detected (max: 15)."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Please refactor this function to reduce its complexity score from 51 to the max allowed complexity 15."}]]}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[9159,9168],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"`Eval harness importing \" + ${transcript.id}`,\n    payload: {\n      transcriptId,  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":537}},{"diffOp":{"equal":{"range":[53,115]}}},{"diffOp":{"delete":{"range":[115,116]}}},{"diffOp":{"insert":{"range":[116,117]}}},{"diffOp":{"equal":{"range":[117,140]}}},{"diffOp":{"delete":{"range":[140,144]}}},{"diffOp":{"insert":{"range":[144,146]}}},{"diffOp":{"equal":{"range":[146,159]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[161,197]}}},{"equalLines":{"line_count":181}},{"diffOp":{"equal":{"range":[197,226]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[21575,21616],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"`Extracted from transcript \" + ${transcriptId}`,\n    payload: {\n      decisionId: id,  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":558}},{"diffOp":{"equal":{"range":[53,113]}}},{"diffOp":{"delete":{"range":[113,114]}}},{"diffOp":{"insert":{"range":[114,115]}}},{"diffOp":{"equal":{"range":[115,141]}}},{"diffOp":{"delete":{"range":[141,145]}}},{"diffOp":{"insert":{"range":[145,147]}}},{"diffOp":{"equal":{"range":[147,159]}}},{"diffOp":{"insert":{"range":[159,161]}}},{"diffOp":{"equal":{"range":[161,199]}}},{"equalLines":{"line_count":160}},{"diffOp":{"equal":{"range":[199,228]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[22090,22133],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"`Extracted from transcript \" + ${transcriptId}`,\n    payload: {\n      premiseId: id,  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":590}},{"diffOp":{"equal":{"range":[53,112]}}},{"diffOp":{"delete":{"range":[112,113]}}},{"diffOp":{"insert":{"range":[113,114]}}},{"diffOp":{"equal":{"range":[114,140]}}},{"diffOp":{"delete":{"range":[140,144]}}},{"diffOp":{"insert":{"range":[144,146]}}},{"diffOp":{"equal":{"range":[146,158]}}},{"diffOp":{"insert":{"range":[158,160]}}},{"diffOp":{"equal":{"range":[160,197]}}},{"equalLines":{"line_count":128}},{"diffOp":{"equal":{"range":[197,226]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[23232,23275],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"`Extracted alongside decision \" + ${decisionId}`,\n    payload: {\n      alternativeId: id,  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":614}},{"diffOp":{"equal":{"range":[53,116]}}},{"diffOp":{"delete":{"range":[116,117]}}},{"diffOp":{"insert":{"range":[117,118]}}},{"diffOp":{"equal":{"range":[118,147]}}},{"diffOp":{"delete":{"range":[147,151]}}},{"diffOp":{"insert":{"range":[151,153]}}},{"diffOp":{"equal":{"range":[153,163]}}},{"diffOp":{"insert":{"range":[163,165]}}},{"diffOp":{"equal":{"range":[165,206]}}},{"equalLines":{"line_count":104}},{"diffOp":{"equal":{"range":[206,235]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[23860,23904],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n * */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return `${transcriptId + \"}#e\" + ${offset}`;\n}\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":641}},{"diffOp":{"equal":{"range":[53,145]}}},{"diffOp":{"insert":{"range":[145,148]}}},{"diffOp":{"equal":{"range":[148,160]}}},{"diffOp":{"delete":{"range":[160,164]}}},{"diffOp":{"insert":{"range":[164,165]}}},{"diffOp":{"equal":{"range":[165,167]}}},{"diffOp":{"delete":{"range":[167,171]}}},{"diffOp":{"insert":{"range":[171,173]}}},{"diffOp":{"equal":{"range":[173,179]}}},{"diffOp":{"insert":{"range":[179,181]}}},{"diffOp":{"equal":{"range":[181,185]}}},{"equalLines":{"line_count":77}},{"diffOp":{"equal":{"range":[185,214]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[25020,25048],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *export function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"`All \" + ${run.transcripts.length + \"} transcripts imported without failure.;\n\n  const lines = [  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":713}},{"diffOp":{"equal":{"range":[53,209]}}},{"diffOp":{"delete":{"range":[209,210]}}},{"diffOp":{"insert":{"range":[210,211]}}},{"diffOp":{"equal":{"range":[211,215]}}},{"diffOp":{"delete":{"range":[215,219]}}},{"diffOp":{"insert":{"range":[219,221]}}},{"diffOp":{"equal":{"range":[221,243]}}},{"diffOp":{"delete":{"range":[243,247]}}},{"diffOp":{"insert":{"range":[247,248]}}},{"diffOp":{"equal":{"range":[248,286]}}},{"diffOp":{"delete":{"range":[209,210]}}},{"diffOp":{"insert":{"range":[210,211]}}},{"diffOp":{"equal":{"range":[286,306]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[306,335]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[27822,27896],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    `${failed.length + \"} of \" + ${run.transcripts.length transcript(s) FAILED to import.,\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":715}},{"diffOp":{"equal":{"range":[53,181]}}},{"diffOp":{"equal":{"range":[181,186]}}},{"diffOp":{"insert":{"range":[186,189]}}},{"diffOp":{"equal":{"range":[189,202]}}},{"diffOp":{"delete":{"range":[202,206]}}},{"diffOp":{"insert":{"range":[206,207]}}},{"diffOp":{"equal":{"range":[207,211]}}},{"diffOp":{"delete":{"range":[211,215]}}},{"diffOp":{"insert":{"range":[215,217]}}},{"diffOp":{"equal":{"range":[217,239]}}},{"diffOp":{"delete":{"range":[202,206]}}},{"diffOp":{"insert":{"range":[206,207]}}},{"diffOp":{"equal":{"range":[239,271]}}},{"diffOp":{"delete":{"range":[211,212]}}},{"diffOp":{"insert":{"range":[186,187]}}},{"diffOp":{"equal":{"range":[271,444]}}},{"equalLines":{"line_count":2}},{"diffOp":{"equal":{"range":[444,473]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[27921,28005],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"`\" + ${entry.transcript.id + \"} ┬╖ \"+ (entry.failure ?? \"unknown\")}`);\n  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":720}},{"diffOp":{"equal":{"range":[53,175]}}},{"diffOp":{"delete":{"range":[175,176]}}},{"diffOp":{"insert":{"range":[176,177]}}},{"diffOp":{"equal":{"range":[53,55]}}},{"diffOp":{"delete":{"range":[177,181]}}},{"diffOp":{"insert":{"range":[181,183]}}},{"diffOp":{"equal":{"range":[183,202]}}},{"diffOp":{"delete":{"range":[202,206]}}},{"diffOp":{"insert":{"range":[206,207]}}},{"diffOp":{"equal":{"range":[207,210]}}},{"diffOp":{"delete":{"range":[210,212]}}},{"diffOp":{"equal":{"range":[202,203]}}},{"diffOp":{"delete":{"range":[212,215]}}},{"diffOp":{"insert":{"range":[181,183]}}},{"diffOp":{"equal":{"range":[215,241]}}},{"diffOp":{"delete":{"range":[241,242]}}},{"diffOp":{"insert":{"range":[242,244]}}},{"diffOp":{"equal":{"range":[244,276]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[28225,28291],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedImports","severity":"error","description":"This import is unused.","message":[{"elements":[],"content":"This "},{"elements":["Emphasis"],"content":"import"},{"elements":[],"content":" is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused imports might be the result of an incomplete refactoring."}]]},{"log":["info",[{"elements":[],"content":"Safe fix: Remove the unused import."}]]},{"diff":{"dictionary":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *import type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,53]}}},{"equalLines":{"line_count":49}},{"diffOp":{"equal":{"range":[53,92]}}},{"diffOp":{"delete":{"range":[92,105]}}},{"diffOp":{"delete":{"range":[105,106]}}},{"diffOp":{"equal":{"range":[106,132]}}},{"equalLines":{"line_count":668}},{"diffOp":{"equal":{"range":[132,161]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\harness.ts"},"span":[2708,2718],"sourceCode":"/**\n * The evaluation harness ΓÇö 7.2's substrate.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * ---------------------------------------------------------------------------\n * WHAT THIS DOES, AND WHY IT IS NOT A TEST\n *\n * A test asks \"does this function return what I expect\". This asks \"when the whole pipeline runs\n * over text nobody wrote for it, how much of the meaning survives\". The difference is that a test\n * can be made to pass by fixing the test; a metric cannot, because the ground truth is a set of\n * quotes in files a reader can open and check.\n *\n * The harness drives the REAL pipeline ΓÇö `runExtraction`, `appendBatch`, `materialize`, `revise`,\n * `label`, `ask` ΓÇö with no shortcuts and no test doubles. Every number this produces is a number\n * about the shipping code path. If a metric is good, the product is good at that metric; if the\n * harness faked anything, that sentence would stop being true.\n *\n * ---------------------------------------------------------------------------\n * ONE MERGED GRAPH, NOT ONE PER TRANSCRIPT\n *\n * All twelve transcripts are appended into a single log in corpus order, producing one graph.\n * Questions are then asked against that graph.\n *\n * This is the realistic configuration: a user has one decision log and many transcripts in it. A\n * harness that gave each transcript a private graph would let retrieval win by construction, because\n * the distractors that make retrieval hard ΓÇö twelve other decisions about databases, in other\n * transcripts ΓÇö would be absent. Measuring on the easy configuration and reporting it as the product\n * is the kind of number that does not survive a judge's second question.\n *\n * Order is corpus order and ids are minted from the running counters, so the whole run is\n * deterministic and reproducible.\n * ---------------------------------------------------------------------------\n */\n\nimport type {\n  AlternativeCandidate,\n  DecisionCandidate,\n  PremiseCandidate,\n} from \"@/ai/types\";\nimport { runExtraction } from \"@/extraction/pipeline\";\nimport { DEFAULT_VOTING } from \"@/extraction/voting\";\nimport { formatAlternativeId, formatDecisionId, formatPremiseId, formatTranscriptId } from \"@/lib/ids\";\nimport { monotonicNow, nowISO } from \"@/lib/format\";\nimport { revise, type ReviseResult } from \"@/reasoning/revise\";\nimport { label } from \"@/reasoning/labeller\";\nimport { ask } from \"@/retrieval\";\nimport { buildIndex } from \"@/retrieval/build-index\";\nimport { appendBatch, emptyLog, fold } from \"@/substrate\";\nimport type { EventLog } from \"@/substrate/event-log\";\nimport { validationMessage } from \"@/substrate/event-validation\";\nimport { asISO } from \"@/types/common\";\nimport type {\n  Actor,\n  AlternativeId,\n  Confidence,\n  DecisionId,\n  EngineId,\n  EpisodeId,\n  ISODateString,\n  PremiseId,\n  TranscriptId,\n} from \"@/types/common\";\nimport type { AnyEvent, EventType, NewEvent } from \"@/types/events\";\nimport type { Labelled, NodeId } from \"@/reasoning/labeller\";\nimport type { Answer } from \"@/types/retrieval\";\nimport type { Decision, Premise, RejectedAlternative } from \"@/types/domain\";\nimport type { GraphState } from \"@/substrate/graph-state\";\nimport type { WhyLogEngine } from \"@/ai/types\";\nimport type { Guard } from \"@/types/guards\";\nimport { guardStatusMap } from \"@/guards/feedback\";\nimport type { LabelledQuestion, ResolvedCorpus, ResolvedTranscript } from \"./corpus/labels\";\nimport type { AblationConfig, SweptParams } from \"./ablation/toggles\";\n\n/* -------------------------------------------------------------------------- */\n/* Shapes                                                                     */\n/* -------------------------------------------------------------------------- */\n\nexport interface RunConfig {\n  readonly id: string;\n  readonly engine: WhyLogEngine;\n  readonly engineId: EngineId;\n  /** Every toggle, present and named, even when all are at their baseline value. A config that\n   *  omits its toggles cannot be reproduced from its report. */\n  readonly toggles: AblationConfig;\n  /** The swept parameters, separate from the toggles for the reason given in `ablation/toggles.ts`:\n   *  a toggle answers \"does this matter\", a parameter answers \"is this value right\". */\n  readonly params: SweptParams;\n}\n\nexport interface TranscriptRun {\n  readonly transcript: ResolvedTranscript;\n  /** The id the log actually minted. Corpus keys are stable labels; runtime ids depend on import\n   *  order and on what earlier transcripts already consumed. Every metric that matches a label to a\n   *  node needs this one, because two transcripts have overlapping character offsets and a span\n   *  alone cannot say which transcript it belongs to. */\n  readonly runtimeId: TranscriptId;\n  readonly ok: boolean;\n  readonly failure: string | null;\n  readonly durationMs: number;\n  readonly decisionIds: readonly DecisionId[];\n  readonly premiseIds: readonly PremiseId[];\n  readonly alternativeIds: readonly AlternativeId[];\n  readonly candidatesFound: number;\n  readonly candidatesDiscarded: number;\n}\n\nexport interface InterventionOutcome {\n  readonly plant: string;\n  readonly predicate: string;\n  readonly applied: boolean;\n  readonly premiseId: PremiseId | null;\n  /** What was done, or why it could not be. Printed verbatim in the report. */\n  readonly reason: string;\n}\n\nexport interface QuestionRun {\n  readonly question: LabelledQuestion;\n  readonly answer: Answer | null;\n  readonly error: string | null;\n  readonly durationMs: number;\n}\n\nexport interface RunResult {\n  readonly configId: string;\n  readonly engine: EngineId;\n  readonly toggles: AblationConfig;\n  readonly params: SweptParams;\n  readonly state: GraphState;\n  readonly labels: ReadonlyMap<NodeId, Labelled>;\n  readonly transcripts: readonly TranscriptRun[];\n  readonly questions: readonly QuestionRun[];\n  readonly proposalsRaised: number;\n  /** Revision passes whose drafts the log REFUSED, with the validation message.\n   *\n   *  Recorded rather than thrown: a revision the log rejects is a finding about the reasoner, and\n   *  abandoning the run would bury it under a stack trace. Left visible because the alternative ΓÇö\n   *  silently keeping the pre-revision graph ΓÇö reports every cascade as a no-op that passed. */\n  readonly revisionFailures: readonly string[];\n  /** Every planted intervention, applied or not. An unapplied one means the plant it belongs to was\n   *  never tested, and the metrics that depend on it must say so rather than report a pass. */\n  readonly interventions: readonly InterventionOutcome[];\n  readonly startedAt: ISODateString;\n  readonly durationMs: number;\n}\n\nconst ACTOR: Actor = { kind: \"system\" };\n\n/**\n * Commit a revision pass and re-fold.\n *\n * `revise` returns DRAFTS, not a graph. Nothing changes until they are appended and the log is\n * re-folded, so a caller that reads a state off the result scores every gate against the\n * PRE-revision graph ΓÇö and the cascade then looks like a no-op that always passed. That is the one\n * failure mode this harness cannot have, because cascade correctness is the headline metric and the\n * only one of the thirteen with no published comparator.\n *\n * `proposals` counts RevisionProposed drafts alone. A proposal is a revision the system declines to\n * apply itself (I4: the system proposes, the human disposes). LabelChanged and CascadePropagated are\n * applications, not proposals; counting them would inflate the number the report presents as \"how\n * often the reasoner asked a human for help\".\n */\nfunction commitRevision(\n  log: EventLog,\n  revised: ReviseResult,\n  clock: EvalClock,\n  engineId: EngineId,\n  reason: string,\n): { log: EventLog; state: GraphState; proposals: number; failure: string | null } {\n  const proposals = revised.eventDrafts.filter((draft) => draft.type === \"RevisionProposed\").length;\n  const unchanged = {\n    log,\n    state: fold(log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n\n  if (revised.eventDrafts.length === 0) return unchanged;\n\n  const committed = appendBatch(\n    log,\n    revised.eventDrafts.map((draft) => ({\n      draft,\n      context: { now: clock.next(), actor: ACTOR, reason },\n    })),\n  );\n\n  if (!committed.ok) {\n    return { ...unchanged, failure: \"revision-rejected: \" + validationMessage(committed.validation) };\n  }\n\n  return {\n    log: committed.log,\n    state: fold(committed.log.events, { engine: engineId, now: clock.next() }),\n    proposals,\n    failure: null,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Entry point                                                                */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Run the whole pipeline over the corpus under one configuration.\n *\n * Never throws on a per-transcript failure: a transcript that fails to extract is recorded as a\n * failure and scored as producing nothing, which is a real result. Throwing instead would abort the\n * run and leave the failure mode unmeasured ΓÇö and \"the pipeline dies on messy input\" is precisely\n * one of the failure modes this benchmark exists to measure.\n */\nexport async function runConfig(corpus: ResolvedCorpus, config: RunConfig): Promise<RunResult> {\n  const startedAt = nowISO();\n  const t0 = monotonicNow();\n\n  let log = emptyLog();\n  const clock = new EvalClock(startedAt);\n  let state = fold(log.events, { engine: config.engineId, now: clock.next() });\n  const transcripts: TranscriptRun[] = [];\n  let proposalsRaised = 0;\n  const revisionFailures: string[] = [];\n\n  for (const transcript of corpus.transcripts) {\n    const tStart = monotonicNow();\n    const transcriptId = formatTranscriptId(state.counters.transcripts + 1) as TranscriptId;\n\n    const result = await runExtraction(\n      {\n        transcriptId,\n        raw: transcript.raw,\n        label: transcript.id,\n        occurredAt: asISO(transcript.occurredAt),\n      },\n      {\n        engine: config.engine,\n        engineId: config.engineId,\n        state,\n        ...(config.toggles.noiseCollapse ? {} : { collapseNoise: false }),\n        /* Voting is OFF unless a VotingOptions is supplied (pipeline.ts gates on\n         * `options.voting !== undefined && runs > 1`), so the toggle has to pass one to enable\n         * it. Passing `undefined` instead left the toggle inert in both positions. It is still\n         * unmeasurable keyless ΓÇö the local engine reports capabilities().voting === false ΓÇö but\n         * an LLM run now genuinely exercises it. */\n        ...(config.toggles.voting ? { voting: DEFAULT_VOTING } : {}),\n      },\n    );\n\n    if (!result.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: result.failure.kind,\n        durationMs: monotonicNow() - tStart,\n        decisionIds: [],\n        premiseIds: [],\n        alternativeIds: [],\n        candidatesFound: 0,\n        candidatesDiscarded: 0,\n      });\n      continue;\n    }\n\n    /* ---- candidates ΓåÆ events ---- */\n    /* Ids are minted here, not by the pipeline, because the pipeline emits local keys and the log\n     * requires branded ids. The premise/alternative refs on a decision candidate are indices into\n     * the run's own arrays, so they are resolved by SNIPPET IDENTITY against those arrays: the\n     * queue reorders and drops items, but a snippet's offsets are unique within a run. */\n    const run = result.outcome.run;\n    const premiseIdByIndex = new Map<number, PremiseId>();\n    const decisionIdByIndex = new Map<number, DecisionId>();\n    const drafts: NewEvent<EventType>[] = [];\n\n    /* The import event comes first: it is what makes the transcript a node in the graph, and every\n     * decision below carries its id. Emitting decisions without it would leave provenance pointing at\n     * a transcript the fold has never seen. */\n    drafts.push(transcriptImported(transcriptId, transcript, config.engineId));\n\n    /* Premises and decisions are minted BEFORE alternatives, because `AlternativeRejectedPayload`\n     * requires the `decisionId` that rejected the alternative. An alternative is not a free-floating\n     * node ΓÇö it is a road not taken on a specific decision ΓÇö so the ordering is forced by the payload\n     * rather than chosen. */\n    let premiseSeq = 0;\n    for (const candidate of run.premises) {\n      premiseSeq += 1;\n      const id = formatPremiseId(state.counters.premises + premiseSeq) as PremiseId;\n      premiseIdByIndex.set(indexOfPremise(run.premises, candidate), id);\n      drafts.push(premiseProposed(id, transcriptId, candidate, config.engineId));\n    }\n\n    const decisionIds: DecisionId[] = [];\n    const alternativeIds: AlternativeId[] = [];\n\n    let decisionSeq = 0;\n    for (const candidate of run.decisions) {\n      decisionSeq += 1;\n      const id = formatDecisionId(state.counters.decisions + decisionSeq) as DecisionId;\n      decisionIds.push(id);\n      decisionIdByIndex.set(indexOfDecision(run.decisions, candidate), id);\n      drafts.push(\n        decisionProposed(id, transcriptId, candidate, config.engineId, {\n          premiseIds: candidate.premiseRefs.map((ref) => premiseIdByIndex.get(ref)).filter(isDefined),\n        }),\n      );\n    }\n\n    let alternativeSeq = 0;\n    for (const candidate of run.alternatives) {\n      /* An alternative whose decision was not minted ΓÇö because the decision was discarded, or the ref\n       * is out of range ΓÇö is dropped rather than attached to an arbitrary decision. Attaching it\n       * anyway would create a rejection that never happened, which is a false positive manufactured by\n       * the harness rather than found by the system, and it would corrupt alternative precision. */\n      const decisionId = decisionIdByIndex.get(candidate.decisionRef);\n      if (decisionId === undefined) continue;\n\n      alternativeSeq += 1;\n      /* The id is scoped to its decision (`A-<decision>-<n>`), so the sequence is per-transcript\n       * and the decision prefix keeps it unique across the merged graph. There is no global\n       * alternatives counter and there should not be one: alternatives belong to decisions. */\n      const id = formatAlternativeId(decisionId, alternativeSeq);\n      alternativeIds.push(id);\n      drafts.push(alternativeRejected(id, decisionId, candidate, config.engineId));\n    }\n\n    const premiseIds = [...premiseIdByIndex.values()];\n\n    /* ---- append, fold, revise ---- */\n    const appended = appendBatch(\n      log,\n      drafts.map((draft) => ({\n        draft,\n        context: {\n          now: clock.next(),\n          actor: ACTOR,\n          reason: \"Eval harness importing \" + transcript.id,\n          occurredAt: asISO(transcript.occurredAt),\n        },\n      })),\n    );\n\n    if (!appended.ok) {\n      transcripts.push({\n        transcript,\n        runtimeId: transcriptId,\n        ok: false,\n        failure: \"append-rejected: \" + validationMessage(appended.validation),\n        durationMs: monotonicNow() - tStart,\n        decisionIds,\n        premiseIds,\n        alternativeIds,\n        candidatesFound: drafts.length,\n        candidatesDiscarded: run.discarded.length,\n      });\n      continue;\n    }\n\n    log = appended.log;\n    state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n    /* The revision pass runs even when nothing was extracted, because \"no contradiction raised\" is a\n     * result and must be measured against the same baseline as \"one was\". */\n    const revised = await revise({\n      state,\n      engine: config.engine,\n      actor: ACTOR,\n      now: clock.next(),\n      guards: guardStatusMap(state),\n      ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      ...(config.toggles.semanticContradiction ? {} : { skipSemantic: true }),\n    });\n\n    const afterImport = commitRevision(\n      log,\n      revised,\n      clock,\n      config.engineId,\n      \"Eval harness revision pass after importing \" + transcript.id,\n    );\n    log = afterImport.log;\n    state = afterImport.state;\n    proposalsRaised += afterImport.proposals;\n    if (afterImport.failure !== null) revisionFailures.push(afterImport.failure);\n\n    transcripts.push({\n      transcript,\n      runtimeId: transcriptId,\n      ok: true,\n      failure: null,\n      durationMs: monotonicNow() - tStart,\n      decisionIds,\n      premiseIds,\n      alternativeIds,\n      candidatesFound: drafts.length,\n      candidatesDiscarded: run.discarded.length,\n    });\n  }\n\n  /* ---- planted interventions ---- */\n  /* Applied AFTER every transcript is imported, so the intervention reacts to the graph the corpus\n   * actually produced rather than to a graph built for the intervention's convenience. An intervention\n   * whose premise was never extracted is recorded as unapplied and reported: the cascade cannot be\n   * measured on a premise the system does not have, and silently skipping it would report a clean\n   * cascade result that was never tested. */\n  const interventions: InterventionOutcome[] = [];\n\n  for (const plant of corpus.plants) {\n    for (const step of plant.falsify ?? []) {\n      const owner = transcripts.find((entry) => entry.transcript.id === step.transcript);\n      if (owner === undefined) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: null, reason: \"transcript not imported\" });\n        continue;\n      }\n\n      const target = [...state.premises.values()].find((premise) =>\n        premise.predicate === step.predicate &&\n        premise.evidence.some((evidence) => evidence.span?.transcriptId === owner.runtimeId),\n      );\n\n      if (target === undefined) {\n        interventions.push({\n          plant: plant.id,\n          predicate: step.predicate,\n          applied: false,\n          premiseId: null,\n          reason: \"no extracted premise with that predicate in that transcript ΓÇö the cascade is UNTESTED, not passed\",\n        });\n        continue;\n      }\n\n      const falsified = appendBatch(log, [\n        {\n          draft: {\n            type: \"PremiseInvalidated\",\n            actor: ACTOR,\n            reason: step.reason,\n            payload: {\n              premiseId: target.id,\n              invalidatedBy: { kind: \"human\" },\n            },\n          } as NewEvent<EventType>,\n          context: { now: clock.next(), actor: ACTOR, reason: step.reason },\n        },\n      ]);\n\n      if (!falsified.ok) {\n        interventions.push({ plant: plant.id, predicate: step.predicate, applied: false, premiseId: target.id, reason: \"append rejected: \" + validationMessage(falsified.validation) });\n        continue;\n      }\n\n      log = falsified.log;\n      state = fold(log.events, { engine: config.engineId, now: clock.next() });\n\n      const afterFalsify = await revise({\n        state,\n        engine: config.engine,\n        actor: ACTOR,\n        now: clock.next(),\n        guards: guardStatusMap(state),\n        ...(config.params.cascadeDepthCap === null ? {} : { cascadeDepthCap: config.params.cascadeDepthCap }),\n      });\n      const afterIntervention = commitRevision(\n        log,\n        afterFalsify,\n        clock,\n        config.engineId,\n        \"Eval harness revision pass after falsifying \" + step.predicate,\n      );\n      log = afterIntervention.log;\n      state = afterIntervention.state;\n      proposalsRaised += afterIntervention.proposals;\n      if (afterIntervention.failure !== null) revisionFailures.push(afterIntervention.failure);\n\n      interventions.push({ plant: plant.id, predicate: step.predicate, applied: true, premiseId: target.id, reason: step.reason });\n    }\n  }\n\n  /* ---- labelling runs once over the merged graph ---- */\n  const labelled = label(state);\n\n  /* ---- questions ---- */\n  const built = await buildIndex({\n    state,\n    engine: config.engine,\n    actor: ACTOR,\n    /* Embeddings stay local on both paths ΓÇö a locked design decision, and the reason the whole\n     * benchmark runs keyless. The LLM path never sends decision text to a provider to embed it. */\n  });\n  const artifacts = built.artifacts;\n  const questions: QuestionRun[] = [];\n\n  for (const question of corpus.questions) {\n    const qStart = monotonicNow();\n    try {\n      const answer = await ask({\n        state,\n        artifacts,\n        labels: labelled.labels,\n        engine: config.engine,\n        engineId: config.engineId,\n        question: question.question,\n        ...(config.params.maxSearches === null ? {} : { maxSearches: config.params.maxSearches }),\n      });\n      questions.push({ question, answer, error: null, durationMs: monotonicNow() - qStart });\n    } catch (error) {\n      questions.push({\n        question,\n        answer: null,\n        error: error instanceof Error ? error.message : String(error),\n        durationMs: monotonicNow() - qStart,\n      });\n    }\n  }\n\n  return {\n    configId: config.id,\n    engine: config.engineId,\n    toggles: config.toggles,\n    params: config.params,\n    state,\n    labels: labelled.labels,\n    transcripts,\n    questions,\n    proposalsRaised,\n    revisionFailures,\n    interventions,\n    startedAt,\n    durationMs: monotonicNow() - t0,\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Candidate ΓåÆ event                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptImported(\n  transcriptId: TranscriptId,\n  transcript: ResolvedTranscript,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"TranscriptImported\",\n    actor: ACTOR,\n    reason: \"Eval harness importing \" + transcript.id,\n    payload: {\n      transcriptId,\n      rawChars: transcript.raw.length,\n      label: transcript.id,\n      occurredAt: asISO(transcript.occurredAt),\n      engine,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction decisionProposed(\n  id: DecisionId,\n  transcriptId: TranscriptId,\n  candidate: DecisionCandidate,\n  engine: EngineId,\n  links: { premiseIds: readonly PremiseId[] },\n): NewEvent<EventType> {\n  return {\n    type: \"DecisionProposed\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      decisionId: id,\n      transcriptId,\n      episodeId: formatEpisodeId(transcriptId, candidate.snippet.start) as EpisodeId,\n      variable: candidate.variable,\n      value: candidate.value,\n      statement: candidate.statement,\n      ...(candidate.rationale === undefined ? {} : { rationale: candidate.rationale }),\n      ...(candidate.acceptedDownside === undefined ? {} : { acceptedDownside: candidate.acceptedDownside }),\n      origin: candidate.origin,\n      modality: candidate.modality,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n      premiseIds: links.premiseIds,\n      alternativeIds: [],\n      ...(candidate.yStatement === undefined ? {} : { yStatement: candidate.yStatement }),\n      ...(candidate.appliesTo.length === 0 ? {} : { appliesTo: candidate.appliesTo }),\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction premiseProposed(\n  id: PremiseId,\n  transcriptId: TranscriptId,\n  candidate: PremiseCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"PremiseAsserted\",\n    actor: ACTOR,\n    reason: \"Extracted from transcript \" + transcriptId,\n    payload: {\n      premiseId: id,\n      transcriptId,\n      type: candidate.type,\n      predicate: candidate.predicate,\n      ...(candidate.value === undefined ? {} : { value: candidate.value }),\n      text: candidate.text,\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\nfunction alternativeRejected(\n  id: AlternativeId,\n  decisionId: DecisionId,\n  candidate: AlternativeCandidate,\n  engine: EngineId,\n): NewEvent<EventType> {\n  return {\n    type: \"AlternativeRejected\",\n    actor: ACTOR,\n    reason: \"Extracted alongside decision \" + decisionId,\n    payload: {\n      alternativeId: id,\n      decisionId,\n      variable: candidate.variable,\n      value: candidate.value,\n      ...(candidate.whyRejected === undefined ? {} : { whyRejected: candidate.whyRejected }),\n      confidence: candidate.confidence,\n      engine,\n      snippet: candidate.snippet,\n    },\n  } as NewEvent<EventType>;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Helpers                                                                    */\n/* -------------------------------------------------------------------------- */\n\n/**\n * Episode ids are derived, not minted.\n *\n * The harness has no episode table of its own ΓÇö the pipeline segments episodes internally and does\n * not expose their ids on the candidate. Deriving a stable id from the transcript and the snippet\n * offset keeps every decision in one episode pointing at the same episode id, which is what the\n * graph needs, without inventing a counter that would disagree with the pipeline's own.\n */\nfunction formatEpisodeId(transcriptId: TranscriptId, offset: number): string {\n  return transcriptId + \"#e\" + offset;\n}\n\nfunction indexOfDecision(all: readonly DecisionCandidate[], one: DecisionCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.value === one.value);\n}\n\nfunction indexOfPremise(all: readonly PremiseCandidate[], one: PremiseCandidate): number {\n  return all.findIndex((candidate) => candidate.snippet.start === one.snippet.start && candidate.predicate === one.predicate);\n}\n\nfunction isDefined<T>(value: T | undefined): value is T {\n  return value !== undefined;\n}\n\n/**\n * A strictly increasing learned-time source.\n *\n * Validation rule 4 requires `at >= previous.at`, and rule 3 requires the hash chain to line up, so\n * two events stamped in the same millisecond are legal but two events stamped out of order are not.\n * `nowISO()` reads the wall clock and can return the same millisecond repeatedly on a fast machine;\n * `monotonicNow()` is a DURATION clock and returns a number, not a timestamp. Neither is what an\n * append loop needs, so the harness advances its own counter instead ΓÇö which also makes learned time\n * independent of how fast the machine happens to be, and the run reproducible.\n */\nclass EvalClock {\n  private cursor: number;\n\n  constructor(start: ISODateString) {\n    const parsed = Date.parse(start);\n    this.cursor = Number.isFinite(parsed) ? parsed : Date.now();\n  }\n\n  next(): ISODateString {\n    this.cursor += 1;\n    return new Date(this.cursor).toISOString() as ISODateString;\n  }\n}\n\n/* -------------------------------------------------------------------------- */\n/* Read access, used by every metric                                          */\n/* -------------------------------------------------------------------------- */\n\nexport function decisionsOf(run: RunResult): readonly Decision[] {\n  return [...run.state.decisions.values()];\n}\n\nexport function premisesOf(run: RunResult): readonly Premise[] {\n  return [...run.state.premises.values()];\n}\n\nexport function alternativesOf(run: RunResult): readonly RejectedAlternative[] {\n  return [...run.state.alternatives.values()];\n}\n\nexport function guardsOf(run: RunResult): readonly Guard[] {\n  return [...run.state.guards.values()];\n}\n\nexport function labelOf(run: RunResult, id: NodeId): Labelled | null {\n  return run.labels.get(id) ?? null;\n}\n\nexport function eventsOf(run: RunResult): readonly AnyEvent[] {\n  return run.state.events;\n}\n\n/** The transcript runs that failed, with their reasons. Printed before the metrics, because a run in\n *  which half the corpus failed to import produces numbers that look like poor recall and are\n *  actually a crash. */\nexport function describeFailures(run: RunResult): string {\n  const failed = run.transcripts.filter((entry) => !entry.ok);\n  if (failed.length === 0) return \"All \" + run.transcripts.length + \" transcripts imported without failure.\";\n\n  const lines = [\n    failed.length + \" of \" + run.transcripts.length + \" transcript(s) FAILED to import.\",\n    \"Metrics below are computed over what survived. A failure is scored as producing nothing,\",\n    \"which is a real result, but it is not the same result as low recall:\",\n  ];\n  for (const entry of failed) lines.push(\"  \" + entry.transcript.id + \" ┬╖ \" + (entry.failure ?? \"unknown\"));\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\graph\\lattice-layout.test.ts"},"span":[4063,4069],"sourceCode":"/**\n * The premise lattice ΓÇö 6.6.\n *\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * \"The differentiating visual is not another chat UI and not another decision timeline. It is\n * the premise lattice ΓÇö a bipartite graph where assumptions are the load-bearing nodes and\n * decisions hang off them.\"\n *\n * The lattice is the one piece of Phase 6 that is pure geometry, so it is also the one piece\n * that can be tested exactly rather than eyeballed. Four properties matter, and each one is\n * a promise the plan makes:\n *\n *   1. BIPARTITE. Premises on one side, decisions on the other. The edges run from a premise\n *      to the decisions that rest on it.\n *   2. DETERMINISTIC. No force simulation. Two renderings of the same log must place the same\n *      node at the same pixel, or the lattice is decoration rather than evidence: a cascade\n *      animation would move the node you are watching, and \"the lattice at time T\" would not\n *      look like the lattice you remember.\n *   3. COLUMNS BY PREMISE TYPE. Premises sit in a column per type, so two premises of the\n *      same kind line up and the eye can compare them.\n *   4. ANTI-HAIRBALL. A premise that 40 decisions rest on must not draw 40 edges into the\n *      space of one node; the layout reports what it withheld instead of silently dropping it.\n */\n\nimport { describe, expect, it } from \"vitest\";\n\nimport { DENSITY_LIMIT, reportHairball } from \"@/components/graph/AntiHairballFilter\";\nimport {\n  COLUMN_WIDTH,\n  type LatticeLayout,\n  type LatticeNode,\n  layoutLattice,\n} from \"@/components/graph/LatticeLayout\";\nimport { label } from \"@/reasoning/labeller\";\nimport { buildDemoLog } from \"../../helpers/demo-log\";\n\nasync function lattice(): Promise<{ layout: LatticeLayout; node: (id: string) => LatticeNode }> {\n  const state = await buildDemoLog(\"curated\");\n  const labels = label(state).labels;\n  const built = layoutLattice(state, labels);\n  return { layout: built, node: (id) => built.nodes.get(id as never) as LatticeNode };\n}\n\ndescribe(\"The premise lattice\", () => {\n  it(\"is bipartite: premises on one side, decisions on the other, edges from premise to decision\", async () => {\n    const { layout } = await lattice();\n\n    const premises = [...layout.nodes.values()].filter((n) => n.kind === \"premise\");\n    const decisions = [...layout.nodes.values()].filter((n) => n.kind === \"decision\");\n    expect(premises.length).toBeGreaterThan(0);\n    expect(decisions.length).toBeGreaterThan(0);\n\n    // Every edge runs FROM a premise TO a decision. If one ran the other way the picture\n    // would stop being \"assumptions with decisions hanging off them\".\n    for (const edge of layout.edges) {\n      const from = layout.nodes.get(edge.from);\n      const to = layout.nodes.get(edge.to);\n      expect(from?.kind).toBe(\"premise\");\n      expect(to?.kind).toBe(\"decision\");\n    }\n  });\n\n  it(\"is deterministic: the same log lays out to the same pixels\", async () => {\n    const state = await buildDemoLog(\"curated\");\n    const labels = label(state).labels;\n\n    const first = layoutLattice(state, labels);\n    const second = layoutLattice(state, labels);\n\n    expect([...second.nodes.values()].map((n) => [n.id, n.x, n.y])).toEqual(\n      [...first.nodes.values()].map((n) => [n.id, n.x, n.y]),\n    );\n    expect(second.edges).toEqual(first.edges);\n  });\n\n  it(\"puts premises in a column per type, and decisions below them\", async () => {\n    const { layout } = await lattice();\n\n    // Every premise of a type shares that type's column x.\n    const columnX = new Map<string, number>();\n    for (const node of layout.nodes.values()) {\n      if (node.kind !== \"premise\" || node.column === null) continue;\n      const seen = columnX.get(node.column);\n      if (seen === undefined) columnX.set(node.column, node.x);\n      else expect(node.x).toBe(seen);\n    }\n    expect(columnX.size).toBeGreaterThan(0);\n\n    // The columns are laid out left to right, COLUMN_WIDTH apart.\n    const xs = [...columnX.values()].sort((a, b) => a - b);\n    for (let i = 1; i < xs.length; i += 1) {\n      expect(xs[i]! - xs[i - 1]!).toBe(COLUMN_WIDTH);\n    }\n\n    // Decisions sit BELOW the premise band, never interleaved with the premises.\n    const premises = [...layout.nodes.values()].filter((n) => n.kind === \"premise\");\n    const decisions = [...layout.nodes.values()].filter((n) => n.kind === \"decision\");\n    const lowestPremise = Math.max(...premises.map((n) => n.y));\n    const highestDecision = Math.min(...decisions.map((n) => n.y));\n    expect(highestDecision).toBeGreaterThan(lowestPremise);\n  });\n\n  it(\"no two nodes overlap\", async () => {\n    const { layout } = await lattice();\n    const nodes = [...layout.nodes.values()];\n\n    for (let i = 0; i < nodes.length; i += 1) {\n      for (let j = i + 1; j < nodes.length; j += 1) {\n        const a = nodes[i]!;\n        const b = nodes[j]!;\n        const sameX = a.x === b.x;\n        const sameY = a.y === b.y;\n        expect(sameX && sameY).toBe(false);\n      }\n    }\n  });\n\n  it(\"reports a hairball rather than silently dropping edges to hit a number\", async () => {\n    const { layout } = await lattice();\n    const report = reportHairball(layout, false);\n\n    /* The report is derived from the layout, and it says what was WITHHELD rather than\n     * hiding it: \"nothing was dropped, the picture is just dense\" is a different statement\n     * from \"we dropped 12 edges to make it fit\", and only the first is honest. */\n    expect(report.collapsedPremises).toBe(layout.collapsedPremiseCount);\n    expect(report.hiddenSuperseded).toBe(layout.droppedDecisionCount);\n    expect(report.nodeCount).toBe(layout.nodes.size);\n    expect(report.edgeCount).toBe(layout.edges.length);\n    expect(report.tooDense).toBe(layout.edges.length > DENSITY_LIMIT);\n\n    /* Nothing is hidden by the density limit itself - it is a prompt to focus, not a\n     * filter. A diagram that silently drops edges to hit a number makes the diagram lie. */\n    expect(report.edgeCount).toBe(layout.edges.length);\n  });\n});\n"},"tags":[],"source":null},{"category":"lint/style/noNonNullAssertion","severity":"warning","description":"Forbidden non-null assertion.","message":[{"elements":[],"content":"Forbidden non-null assertion."}],"advices":{"advices":[]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\tests\\unit\\graph\\lattice-layout.test.ts"},"span":[4072,4082],"sourceCode":"/**\n * The premise lattice ΓÇö 6.6.\n *\n * Plan: plan/phase-6-presentation.md ┬º6.6\n *\n * \"The differentiating visual is not another chat UI and not another decision timeline. It is\n * the premise lattice ΓÇö a bipartite graph where assumptions are the load-bearing nodes and\n * decisions hang off them.\"\n *\n * The lattice is the one piece of Phase 6 that is pure geometry, so it is also the one piece\n * that can be tested exactly rather than eyeballed. Four properties matter, and each one is\n * a promise the plan makes:\n *\n *   1. BIPARTITE. Premises on one side, decisions on the other. The edges run from a premise\n *      to the decisions that rest on it.\n *   2. DETERMINISTIC. No force simulation. Two renderings of the same log must place the same\n *      node at the same pixel, or the lattice is decoration rather than evidence: a cascade\n *      animation would move the node you are watching, and \"the lattice at time T\" would not\n *      look like the lattice you remember.\n *   3. COLUMNS BY PREMISE TYPE. Premises sit in a column per type, so two premises of the\n *      same kind line up and the eye can compare them.\n *   4. ANTI-HAIRBALL. A premise that 40 decisions rest on must not draw 40 edges into the\n *      space of one node; the layout reports what it withheld instead of silently dropping it.\n */\n\nimport { describe, expect, it } from \"vitest\";\n\nimport { DENSITY_LIMIT, reportHairball } from \"@/components/graph/AntiHairballFilter\";\nimport {\n  COLUMN_WIDTH,\n  type LatticeLayout,\n  type LatticeNode,\n  layoutLattice,\n} from \"@/components/graph/LatticeLayout\";\nimport { label } from \"@/reasoning/labeller\";\nimport { buildDemoLog } from \"../../helpers/demo-log\";\n\nasync function lattice(): Promise<{ layout: LatticeLayout; nod