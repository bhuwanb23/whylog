);\n\n    /* A record counts for this plant when both of its decisions live in the plant's transcripts, or ΓÇö\n     * for the single-transcript plants ΓÇö when its one decision does. Restricting by transcript is what\n     * stops an unrelated contradiction elsewhere in the merged graph from being credited here. */\n    const owned = run.state.contradictions.filter((record) => {\n      const a = transcriptOfDecision(run, record.decisionA);\n      const b = record.decisionB === undefined ? a : transcriptOfDecision(run, record.decisionB);\n      return a !== null && runtimeIds.includes(a) && (b === null || runtimeIds.includes(b));\n    });\n\n    /* `duplicate-restatement` expects ZERO contradictions: three restatements of decisions already in\n     * the graph must merge, not conflict. Its expected count is inverted relative to every other plant,\n     * and treating it like the others would score correct behaviour as a miss. */\n    const expectsNone = plant.kind === \"duplicate-restatement\";\n    const expected = expectsNone ? 1 : 1;\n    const found = expectsNone ? (owned.length === 0 ? 1 : 0) : owned.length > 0 ? 1 : 0;\n\n    return {\n      plant: plant.id,\n      kind: plant.kind,\n      testable,\n      expected,\n      found: testable ? found : 0,\n      records: owned.map((record) => record.gate + \"/\" + record.verdict + (record.diagnostic ? \"/\" + record.diagnostic : \"\")),\n    };\n  });\n\n  const testable = perPlant.filter((entry) => entry.testable);\n  const detail = precisionRecall(\n    testable.reduce((sum, entry) => sum + entry.found, 0),\n    0,\n    testable.reduce((sum, entry) => sum + (entry.expected - entry.found), 0) +\n      perPlant.filter((entry) => !entry.testable).length,\n  );\n\n  const byGate = { structural: 0, semantic: 0, premise: 0 };\n  let m1 = 0;\n  let m2 = 0;\n  for (const record of run.state.contradictions) {\n    byGate[record.gate] += 1;\n    if (record.diagnostic === \"M1\") m1 += 1;\n    if (record.diagnostic === \"M2\") m2 += 1;\n  }\n\n  return {\n    perPlant,\n    m1Detections: m1,\n    m2Detections: m2,\n    byGate,\n    metric: {\n      id: \"contradiction-recall-l1\",\n      name: METRIC_NAMES[\"contradiction-recall-l1\"],\n      value: detail.recall,\n      detail,\n      n: perPlant.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.recall, n: perPlant.length, detail }],\n      comparator: COMPARATORS[\"contradiction-recall-l1\"] ?? null,\n      gloss:\n        detail.truePositives + \" of \" + perPlant.length + \" planted L1 cases produced the expected verdict. \" +\n        \"By gate: \" + byGate.structural + \" structural, \" + byGate.semantic + \" semantic, \" + byGate.premise +\n        \" premise. Kantara diagnostics: \" + m1 + \" M1, \" + m2 + \" M2.\",\n      honestNote:\n        \"n=\" + perPlant.length + \" plants, which is a count of CASES, not of contradiction pairs ΓÇö Kantara's 396 is a count \" +\n        \"of pairs found in the Linux kernel with no planted denominator, so the two numbers are not rates over the same kind \" +\n        \"of thing and must not be divided into each other. Recall here is over planted cases the corpus says must fire, plus \" +\n        \"one case (duplicate-restatement) that says must NOT fire; an untestable plant ΓÇö one whose transcript failed to \" +\n        \"import ΓÇö counts as a miss, because an unmeasured case is not a passed case. L1 is the CONTROL: every surveyed \" +\n        \"system does some version of it, and a failure here invalidates the rest of the table.\",\n    },\n  };\n}\n\nfunction transcriptOfDecision(run: RunResult, id: DecisionId): string | null {\n  const decision = run.state.decisions.get(id);\n  if (decision === undefined) return null;\n\n  const entry = run.transcripts.find((candidate) => candidate.runtimeId === decision.provenance.transcriptId);\n  return entry === undefined ? null : entry.runtimeId;\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Metric 1 ΓÇö decision extraction precision / recall / F1.\n *      perEngine: [{ engine: describeEngineId(engine), value: detail.f1, n: labels.length, detail }],\n      comparator: COMPARATORS[\"decision-extraction\"] ?? null,\n      gloss:\n        `${detail.truePositives + \"} of \" + ${labels.length labelled decisions became graph nodes; \" +\n        detail.falsePositivesnode(s) had no label behind them.,\n      honestNote:\n        \"Matched by \" + MATCH_RULE + \". Labels marked expectNode:false are excluded here and scored by modality precision, \" +}\n\n","ops":[{"diffOp":{"equal":{"range":[0,67]}}},{"equalLines":{"line_count":102}},{"diffOp":{"equal":{"range":[67,242]}}},{"diffOp":{"equal":{"range":[242,251]}}},{"diffOp":{"insert":{"range":[251,254]}}},{"diffOp":{"equal":{"range":[254,274]}}},{"diffOp":{"delete":{"range":[274,278]}}},{"diffOp":{"insert":{"range":[278,279]}}},{"diffOp":{"equal":{"range":[279,283]}}},{"diffOp":{"delete":{"range":[283,287]}}},{"diffOp":{"insert":{"range":[287,289]}}},{"diffOp":{"equal":{"range":[289,302]}}},{"diffOp":{"delete":{"range":[274,278]}}},{"diffOp":{"insert":{"range":[278,279]}}},{"diffOp":{"equal":{"range":[302,342]}}},{"diffOp":{"delete":{"range":[342,354]}}},{"diffOp":{"insert":{"range":[287,289]}}},{"diffOp":{"equal":{"range":[354,375]}}},{"diffOp":{"delete":{"range":[274,276]}}},{"diffOp":{"insert":{"range":[278,279]}}},{"diffOp":{"equal":{"range":[302,303]}}},{"diffOp":{"delete":{"range":[342,344]}}},{"diffOp":{"equal":{"range":[375,408]}}},{"diffOp":{"delete":{"range":[342,343]}}},{"diffOp":{"insert":{"range":[251,252]}}},{"diffOp":{"equal":{"range":[408,554]}}},{"equalLines":{"line_count":36}},{"diffOp":{"equal":{"range":[554,557]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\metrics\\extraction.ts"},"span":[5068,5229],"sourceCode":"/**\n * Metric 1 ΓÇö decision extraction precision / recall / F1.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n * Comparator: RecovAr, 75% recall / 77% precision (docs/05 ┬º4.1).\n *\n * ---------------------------------------------------------------------------\n * NOT THE SAME TASK AS THE COMPARATOR, AND THE NOTE SAYS SO\n *\n * RecovAr recovers rationale from commit messages and issue threads. This recovers decisions from\n * agent dialogue. The corpora differ in genre, length and how explicitly the decision is stated, so\n * the two numbers are adjacent rather than comparable. Printing them side by side without saying that\n * would be exactly the overstatement docs/07 ┬º2 warns about ΓÇö the comparator is cited because it is\n * the nearest published number that exists, and the gap between the tasks is stated in the same\n * breath.\n *\n * ---------------------------------------------------------------------------\n * `expectNode: false` IS A LABEL, NOT AN ABSENCE\n *\n * A labelled decision with `expectNode: false` is one the corpus says must NOT become a graph node ΓÇö\n * a hypothetical, a report of someone else's decision, a proposal that was talked out of. Counting\n * those as false negatives would punish the system for correctly declining, so they are excluded here\n * and scored by `modality.ts` instead, where declining correctly is the thing being measured.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionId, EngineId, TranscriptId } from \"@/types/common\";\nimport type { Decision } from \"@/types/domain\";\nimport type { ResolvedCorpus, ResolvedDecision } from \"../corpus/labels\";\nimport type { RunResult, TranscriptRun } from \"../harness\";\nimport { align, MATCH_RULE, type Alignment } from \"./match\";\nimport { COMPARATORS, METRIC_NAMES, describeEngineId, precisionRecall, type MetricResult } from \"./types\";\n\nexport interface ExtractionOutcome {\n  readonly metric: MetricResult;\n  readonly alignment: Alignment<ResolvedDecision, Decision>;\n  /** Overlapping spans whose variable disagrees: found the sentence, understood it as the wrong kind\n   *  of decision. Diagnosed separately because it is the most actionable failure the extractor has. */\n  readonly variableErrors: readonly { label: ResolvedDecision; node: Decision }[];\n  readonly perTranscript: readonly { transcript: string; tp: number; fp: number; fn: number }[];\n}\n\nexport function scoreDecisionExtraction(corpus: ResolvedCorpus, run: RunResult, engine: EngineId): ExtractionOutcome {\n  const labels: ResolvedDecision[] = [];\n  const nodes: Decision[] = [];\n  const transcriptOf = new Map<DecisionId, TranscriptId>();\n  const runByRuntime = new Map<TranscriptId, TranscriptRun>();\n\n  for (const entry of run.transcripts) runByRuntime.set(entry.runtimeId, entry);\n\n  for (const transcript of corpus.transcripts) {\n    /* A transcript the harness never imported has no runtime id. Skipping it is right: its labels\n     * are counted as misses by the metrics that own them, and inventing an id here would attribute\n     * them to whatever transcript happened to land at that index. */\n    const runtimeId = transcriptIdOf(run, transcript.id);\n    if (runtimeId === null) continue;\n\n    const entry = runByRuntime.get(runtimeId);\n    if (entry === undefined) continue;\n\n    for (const label of transcript.decisions) {\n      if (!label.expectNode) continue; /* declined-on-purpose; scored by modality.ts */\n      labels.push(label);\n    }\n  }\n\n  for (const decision of run.state.decisions.values()) {\n    nodes.push(decision);\n    transcriptOf.set(decision.id, decision.provenance.transcriptId);\n  }\n\n  const alignment = align(\n    labels,\n    nodes,\n    (label) => label.span,\n    (node) => ({ start: node.provenance.snippet.start, end: node.provenance.snippet.end }),\n    (label, node) => sameTranscript(run, label, node, transcriptOf),\n  );\n\n  const variableErrors = alignment.pairs\n    .filter((pair) => pair.label.variable !== pair.node.variable)\n    .map((pair) => ({ label: pair.label, node: pair.node }));\n\n  const perTranscript = corpus.transcripts.map((transcript) => {\n    const owned = alignment.pairs.filter((pair) => transcriptOf.get(pair.node.id) === transcriptIdOf(run, transcript.id));\n    return {\n      transcript: transcript.id,\n      tp: owned.length,\n      fp: alignment.spurious.filter((node) => transcriptOf.get(node.id) === transcriptIdOf(run, transcript.id)).length,\n      fn: transcript.decisions.filter((label) => label.expectNode && !owned.some((pair) => pair.label === label)).length,\n    };\n  });\n\n  const detail = precisionRecall(alignment.truePositives, alignment.falsePositives, alignment.falseNegatives);\n\n  return {\n    alignment,\n    variableErrors,\n    perTranscript,\n    metric: {\n      id: \"decision-extraction\",\n      name: METRIC_NAMES[\"decision-extraction\"],\n      value: detail.f1,\n      detail,\n      n: labels.length,\n      perEngine: [{ engine: describeEngineId(engine), value: detail.f1, n: labels.length, detail }],\n      comparator: COMPARATORS[\"decision-extraction\"] ?? null,\n      gloss:\n        detail.truePositives + \" of \" + labels.length + \" labelled decisions became graph nodes; \" +\n        detail.falsePositives + \" node(s) had no label behind them.\",\n      honestNote:\n        \"Matched by \" + MATCH_RULE + \". Labels marked expectNode:false are excluded here and scored by modality precision, \" +\n        \"because counting a correctly declined hypothetical as a miss would punish the right behaviour. \" +\n        \"n=\" + labels.length + \" across \" + corpus.transcripts.length + \" transcripts hand-labelled by the author of the system, \" +\n        \"which is the largest methodological weakness in this benchmark: the labels were written by the person being scored. \" +\n        \"The comparator is a different genre (commit messages, not agent dialogue) and is cited as the nearest published number, not as a like-for-like baseline.\",\n    },\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Transcript identity                                                        */\n/* -------------------------------------------------------------------------- */\n\nfunction transcriptIdOf(run: RunResult, corpusKey: string): TranscriptId | null {\n  const entry = run.transcripts.find((candidate) => candidate.transcript.id === corpusKey);\n  return entry === undefined ? null : entry.runtimeId;\n}\n\n/**\n * Which transcript a label belongs to.\n *\n * A label carries the corpus key of its transcript, not a runtime id, because runtime ids depend on\n * import order and the corpus file must stay readable. This resolves one to the other at match time.\n */\nfunction sameTranscript(\n  run: RunResult,\n  label: ResolvedDecision,\n  node: Decision,\n  transcriptOf: ReadonlyMap<DecisionId, TranscriptId>,\n): boolean {\n  const owner = transcriptOf.get(node.id);\n  if (owner === undefined) return false;\n\n  const entry = run.transcripts.find((candidate) => candidate.runtimeId === owner);\n  if (entry === undefined) return false;\n\n  return entry.transcript.decisions.some((candidate) => candidate === label);\n}\n\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":[