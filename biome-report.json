onsole.log(\"\\x1b[33m\\u2013 \" + guard.id + \" SKIPPED\\x1b[0m (\" + guard.kind + \": \" + guard.target + \") \\u2014 \" + result.evidence);\n      continue;\n    }\n\n    if (guard.severity === \"blocking\") blocking += 1;\n    else warnings += 1;\n\n    console.log(reportFailure(guard, result));\n  }\n\n  console.log(\"\");\n  console.log(\"  passed \" + passed + \" \\u00b7 failed \" + (blocking + warnings) + \" (\" + blocking + \" blocking, \" + warnings + \" warning) \\u00b7 skipped \" + skipped);\n\n  if (blocking > 0) {\n    console.log(\"\\n\\x1b[31m\" + blocking + \" blocking decision guard(s) failed.\\x1b[0m\");\n    console.log(\"Each failure above names the decision, the premise it rests on, and what was rejected.\");\n    process.exit(1);\n  }\n  if (warnings > 0) {\n    console.log(\"\\n\" + warnings + \" warning-level guard(s) failed \\u2014 advisory, build not blocked.\");\n  }\n  process.exit(0);\n}\n\nmain();\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"#!/usr/bin/env node\n/*\n * Emitted by the WhyLog export compiler alongside CLAUDE.md / AGENTS.md / DECISIONS.md.    if (result.outcome === \"skip\") {\n      skipped += 1;\n      console.log(\"`\\x1b[33m\\u2013 \" +${guard.id +}\" SKIPPED\\x1b[0m (\" + guard.kind + \":guard.target) \\u2014 result.evidence}`);\n      continue;\n    }\nmain();\n","ops":[{"diffOp":{"equal":{"range":[0,111]}}},{"equalLines":{"line_count":1294}},{"diffOp":{"equal":{"range":[111,186]}}},{"diffOp":{"delete":{"range":[186,187]}}},{"di