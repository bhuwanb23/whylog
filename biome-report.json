).toFixed(1) + \"s ┬╖ \" + run.proposalsRaised + \" revision proposal(s) raised\");\n\n  /* A revision the log refused means the reasoner emitted a draft that failed validation, so the\n   * graph scored below is the PRE-revision graph for that pass. Printed rather than swallowed:\n   * without it a cascade score of \"nothing changed\" is indistinguishable from \"nothing was allowed\n   * to change\". */\n  if (run.revisionFailures.length > 0) {\n    blank();\n    line(\"Revision passes the log REFUSED (\" + run.revisionFailures.length + \"):\");\n    for (const failure of run.revisionFailures) line(\"  \" + failure);\n  }\n\n  if (run.interventions.length > 0) {\n    blank();\n    line(\"Planted interventions:\");\n    for (const intervention of run.interventions) {\n      line(\"  \" + (intervention.applied ? \"APPLIED  \" : \"UNAPPLIED\") + \" \" + intervention.plant + \" ┬╖ \" + intervention.predicate);\n      line(\"           \" + intervention.reason);\n    }\n  }\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  heading(\"Metrics\");\n  line(renderSuite(scored));\n\n  const hardened = harden(resolved, scored);\n\n  heading(\"Hardening pass (7.4)\");\n  line(renderHardening(hardened));\n\n  heading(\"What each number does not establish\");\n  for (const metric of scored.metrics) {\n    line(\"┬╖ \" + metric.name);\n    line(\"  \" + metric.gloss);\n    line(\"  honest note: \" + metric.honestNote);\n    blank();\n  }\n\n  if (args.has(\"out\")) write(args.get(\"out\") ?? \"eval-report.md\", renderFullReport(resolved, scored, null, hardened));\n  if (args.has(\"json\")) {\n    write(\n      args.get(\"json\") ?? \"eval-report.json\",\n      JSON.stringify(\n        {\n          corpus: resolved.version,\n          engine: engineId,\n          ranAt: run.startedAt,\n          metrics: scored.metrics,\n        },\n        null,\n        2,\n      ),\n    );\n  }\n\n  blank();\n  line(\"Run `npm run eval:ablation` for the delta table and the prediction audit.\");\n  line(\"Run `npm run demo:verify` for the demo kit: script, beat verification, three dry runs.\");\n\n  if (!hardened.ready) process.exitCode = 1;\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"organizeImports","severity":"error","description":"Import statements could be sorted:","message":[{"elements":[],"content":"Import statements could be sorted:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * `npm run eval` ΓÇö score the full system once, on the local engine, and print every number.\n * */\n\nimport { describeFailuresDEFAULT_PARAMS, runConfigFULL } from \"./harnessablation/toggles\";\nimport { banner, blank, heading, line, preparereadArgs, writeclirenderSuitehardenscoreAllrenderHardeningmetricshardeningheading, line, prepare, readArgs,write } from \"./renderFullReportrenderSuite, scoreAllreport harden,\";\n\nasync function main(): Promise<void> {  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":5}},{"diffOp":{"equal":{"range":[101,115]}}},{"diffOp":{"delete":{"range":[115,131]}}},{"diffOp":{"insert":{"range":[131,145]}}},{"diffOp":{"equal":{"range":[145,147]}}},{"diffOp":{"delete":{"range":[147,156]}}},{"diffOp":{"insert":{"range":[156,160]}}},{"diffOp":{"equal":{"range":[160,171]}}},{"diffOp":{"delete":{"range":[171,178]}}},{"diffOp":{"insert":{"range":[178,194]}}},{"diffOp":{"equal":{"range":[194,206]}}},{"diffOp":{"delete":{"range":[156,160]}}},{"diffOp":{"insert":{"range":[206,243]}}},{"diffOp":{"equal":{"range":[145,147]}}},{"diffOp":{"delete":{"range":[131,145]}}},{"diffOp":{"insert":{"range":[243,258]}}},{"diffOp":{"equal":{"range":[160,171]}}},{"diffOp":{"delete":{"range":[178,194]}}},{"diffOp":{"insert":{"range":[258,261]}}},{"diffOp":{"equal":{"range":[194,206]}}},{"diffOp":{"delete":{"r