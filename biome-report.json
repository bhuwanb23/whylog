on the strength of a code path\n * that did not run.\n *\n * ---------------------------------------------------------------------------\n * VERIFIED, MANUAL OR FAILED ΓÇö AND NEVER A FOURTH THING\n *\n * There is no \"skipped\" state. A check that could not run is `manual`, which names the human action that\n * substitutes for it. A check that ran and did not hold is `failed`. Collapsing those two would produce a\n * green verification report for a demo that has never been exercised, which is the exact failure this\n * module exists to prevent.\n * ---------------------------------------------------------------------------\n */\n\nimport type { PremiseId } from \"@/types/common\";\nimport type { SeedResult } from \"./kit\";\nimport type { Beat, CheckId } from \"./script\";\nimport { SCRIPT } from \"./script\";\n\nexport type CheckStatus = \"verified\" | \"manual\" | \"failed\";\n\nexport interface CheckResult {\n  readonly check: CheckId;\n  readonly status: CheckStatus;\n  readonly evidence: string;\n  /** What a human must look at, when `status` is \"manual\". Empty otherwise. */\n  readonly manualStep: string;\n}\n\nexport interface VerificationReport {\n  readonly results: readonly CheckResult[];\n  readonly byBeat: readonly { beat: number; view: string; check: CheckId; status: CheckStatus }[];\n  readonly verified: number;\n  readonly manual: number;\n  readonly failed: number;\n  /** True only when nothing failed AND every beat's check resolved to something. A demo with an\n   *  unverified beat can still be given ΓÇö the manual steps cover it ΓÇö but a demo with a FAILED beat\n   *  cannot, because the beat will visibly not work. */\n  readonly demoable: boolean;\n}\n\n/**\n * Verify every beat of the script against a built seed.\n *\n * Takes the seed rather than building one, so the caller decides when the pipeline runs. Building it\n * inside would make verification cost a full import and would hide that cost from whoever is waiting on\n * it during a rehearsal.\n */\nexport function verifyDemo(seed: SeedResult): VerificationReport {\n  const results: CheckResult[] = [\n    checkSeedHasSqlite(seed),\n    checkSeedHasPremises(seed),\n    checkReversalDetected(seed),\n    checkL2Unsound(seed),\n    checkNoHypotheticalNodes(seed),\n    checkGuardsProposed(seed),\n    checkExportContainsDecision(seed),\n    checkAnswerIsGrounded(seed),\n    checkGraphRenders(seed),\n  ];\n\n  const byBeat = SCRIPT.map((beat) => {\n    const result = results.find((entry) => entry.check === beat.check);\n    return {\n      beat: beat.n,\n      view: beat.view,\n      check: beat.check,\n      status: result?.status ?? \"manual\",\n    };\n  });\n\n  return {\n    results,\n    byBeat,\n    verified: results.filter((entry) => entry.status === \"verified\").length,\n    manual: results.filter((entry) => entry.status === \"manual\").length,\n    failed: results.filter((entry) => entry.status === \"failed\").length,\n    demoable: results.every((entry) => entry.status !== \"failed\"),\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Individual checks                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction checkSeedHasSqlite(seed: SeedResult): CheckResult {\n  const hit = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  return hit === undefined\n    ? failed(\"seed-has-sqlite-decision\", \"No SQLite decision in the seed. Beat 1 has nothing to show and every later beat depends on it.\")\n    : verified(\"seed-has-sqlite-decision\", hit.id + \" ┬╖ \" + hit.statement);\n}\n\nfunction checkSeedHasPremises(seed: SeedResult): CheckResult {\n  const sqlite = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite === undefined) {\n    return failed(\"seed-has-premises\", \"No SQLite decision, so its premises cannot be checked.\");\n  }\n\n  /* Premises are reachable through justifications, not through a field on the decision ΓÇö the graph is\n   * bipartite and `Justification.consequent` is a DecisionId, so the edges are walked from the\n   * justification side. Reading a `decision.premises` field here would be reading something that does\n   * not exist and would silently report zero. */\n  const premiseIds = new Set<string>();\n  for (const justification of seed.state.justifications.values()) {\n    if (justification.consequent !== sqlite.id) continue;\n    for (const id of justification.inList) premiseIds.add(id);\n    for (const id of justification.outList) premiseIds.add(id);\n  }\n\n  if (premiseIds.size === 0) {\n    return failed(\n      \"seed-has-premises\",\n      sqlite.id + \" has no justification linking it to any premise. Beat 1's whole point ΓÇö 'notice what is underneath it' ΓÇö cannot be shown.\",\n    );\n  }\n\n  const names = [...premiseIds]\n    .map((id) => seed.state.premises.get(id as PremiseId))\n    .filter((premise) => premise !== undefined)\n    .map((premise) => (premise as { predicate: string }).predicate);\n\n  return verified(\n    \"seed-has-premises\",\n    premiseIds.size + \" premise(s) linked: \" + (names.length > 0 ? names.join(\", \") : \"ids resolved but predicates unreadable\"),\n  );\n}\n\nfunction checkReversalDetected(seed: SeedResult): CheckResult {\n  const records = seed.state.contradictions.filter(\n    (record) => record.verdict === \"contradiction\" || record.verdict === \"reversal\",\n  );\n\n  if (records.length === 0) {\n    return failed(\"reversal-detected\", \"No contradiction or reversal record in the seed. Beat 3 would show an empty panel.\");\n  }\n\n  const structural = records.filter((record) => record.gate === \"structural\").length;\n  return verified(\n    \"reversal-detected\",\n    records.length + \" record(s): \" + structural + \" structural, \" + (records.length - structural) + \" other gate(s).\",\n  );\n}\n\nfunction checkL2Unsound(seed: SeedResult): CheckResult {\n  /* The headline beat. The October SQLite decision must be OUT or UNFOUNDED after the November transcript\n   * is imported, without the November transcript mentioning databases. */\n  const sqlite = [...seed.state.decisions.values()].filter(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite.length === 0) return failed(\"l2-unsound\", \"No SQLite decision in the seed.\");\n\n  const unsound = sqlite.filter((decision) => decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n\n  if (unsound.length === 0) {\n    return failed(\n      \"l2-unsound\",\n      \"DEMO-KILLER: the SQLite decision is still \" + sqlite.map((decision) => decision.label).join(\"/\") +\n      \" after the November transcript. Beat 5 is the peak of the demo and it does not land. \" +\n      \"Fall back to driving the falsification by hand from the Reasoning view and say so out loud.\",\n    );\n  }\n\n  let outListTotal = 0;\n  for (const justification of seed.state.justifications.values()) outListTotal += justification.outList.length;\n\n  return verified(\n    \"l2-unsound\",\n    unsound.map((decision) => decision.id).join(\", \") + \" went unsound. \" + outListTotal +\n    \" OUT-list entry/entries in the graph, which is what makes the retraction non-monotonic rather than a supersede.\",\n  );\n}\n\nfunction checkNoHypotheticalNodes(seed: SeedResult): CheckResult {\n  const hypothetical = [...seed.state.decisions.values()].filter(\n    (decision) => decision.modality === \"hypothetical\" && decision.label === \"IN\",\n  );\n\n  /* A hypothetical node in the seed is only a failure if it is labelled IN: retaining the sentence is\n   * correct (nothing is deleted, invariant I1), promoting it to a live belief is not. */\n  return hypothetical.length === 0\n    ? verified(\"no-hypothetical-nodes\", \"No hypothetical-modality decision carries an IN label.\")\n    : failed(\n        \"no-hypothetical-nodes\",\n        \"DEMO-KILLER: \" + hypothetical.length + \" hypothetical decision(s) are labelled IN: \" +\n        hypothetical.map((decision) => decision.id + \" (\" + decision.statement.slice(0, 40) + \")\").join(\"; \") +\n        \". Beat 6 shows the graph, and a judge who reads one of these aloud ends the demo.\",\n      );\n}\n\nfunction checkGuardsProposed(seed: SeedResult): CheckResult {\n  const guards = [...seed.state.guards.values()];\n\n  if (guards.length === 0) {\n    return failed(\"guards-proposed-not-failing\", \"No guards synthesised. Beat 7 has nothing to show.\");\n  }\n\n  /* Day-one failures are the killer: a guard that has already FAILED before the user wrote any code\n   * reads as a broken tool rather than as a tool that found something. */\n  const failing = guards.filter((guard) => guard.lastRun?.outcome === \"fail\");\n  const accepted = guards.filter((guard) => guard.lifecycle === \"accepted\");\n\n  if (accepted.length > 0) {\n    return failed(\n      \"guards-proposed-not-failing\",\n      \"DEMO-KILLER: \" + accepted.length + \" guard(s) reached `accepted` with no human in the loop. Invariant I4 says the system proposes and the human disposes.\",\n    );\n  }\n\n  return {\n    check: \"guards-proposed-not-failing\",\n    status: failing.length === 0 ? \"verified\" : \"manual\",\n    evidence:\n      guards.length + \" guard(s) synthesised, all in `proposed` or `suppressed` lifecycle. \" +\n      failing.length + \" currently failing against the empty virtual project.\",\n    manualStep:\n      failing.length === 0\n        ? \"\"\n        : failing.length + \" guard(s) fail against an empty project. Paste a real package.json into the \" +\n          \"project panel before beat 7, or show the proposal list instead of the run list.\",\n  };\n}\n\nfunction checkExportContainsDecision(seed: SeedResult): CheckResult {\n  /* The export compiler runs in the browser against the current state and writes files through the UI.\n   * It can be driven headlessly, but doing so here would duplicate `export/index.ts`'s entry point and\n   * the two would drift. Marked manual, with the exact thing to look for. */\n  return {\n    check: \"export-contains-decision\",\n    status: \"manual\",\n    evidence: seed.state.decisions.size + \" decision(s) available to export; \" + seed.state.exports.size + \" export record(s) already in the log.\",\n    manualStep:\n      \"In the Export view, compile CLAUDE.md and confirm three things: (1) the Postgres decision appears \" +\n      \"as an imperative MUST scoped to a glob, (2) the rejected-alternatives block names SQLite, (3) the \" +\n      \"stamp's digest is non-empty and not the literal string 'unknown' ΓÇö that was a real Phase 4 bug \" +\n      \"where every CI export stamped 'unknown' because the code read `log.head.hash` instead of \" +\n      \"`log.headHash`.\",\n  };\n}\n\nfunction checkAnswerIsGrounded(seed: SeedResult): CheckResult {\n  return {\n    check: \"answer-is-grounded\",\n    status: \"manual\",\n    evidence: \"Asking a question runs the retrieval pipeline over the seeded index, which is built in the browser.\",\n    manualStep:\n      \"In the Ask view, ask 'Why did we choose SQLite over Postgres?' and confirm the answer carries a \" +\n      \"GROUNDED verdict with at least one citation that resolves to a real decision. Then ask a question \" +\n      \"the corpus cannot answer and confirm it says INSUFFICIENT_EVIDENCE rather than inventing a claim ΓÇö \" +\n      \"that refusal is the evidence contract and it is the half of the feature a judge will not think to \" +\n      \"test unless shown.\",\n  };\n}\n\nfunction checkGraphRenders(seed: SeedResult): CheckResult {\n  /* The lattice layout is deterministic by design, so its input can be checked headlessly even though\n   * the SVG cannot: a graph with premises and decisions on both sides of a bipartition will lay out. */\n  const decisions = seed.state.decisions.size;\n  const premises = seed.state.premises.size;\n\n  return decisions > 0 && premises > 0\n    ? verified(\"graph-renders\", decisions + \" decision(s) and \" + premises + \" premise(s): both sides of the bipartition are populated.\")\n    : failed(\"graph-renders\", decisions + \" decision(s), \" + premises + \" premise(s). An empty side produces an empty diagram.\");\n}\n\nfunction verified(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"verified\", evidence, manualStep: \"\" };\n}\n\nfunction failed(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"failed\", evidence, manualStep: \"\" };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function renderVerification(report: VerificationReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"KEYLESS DEMO VERIFICATION\");\n  lines.push(report.verified + \" verified ┬╖ \" + report.manual + \" manual ┬╖ \" + report.failed + \" FAILED\");\n  lines.push(report.demoable ? \"DEMOABLE.\" : \"NOT DEMOABLE ΓÇö a beat will visibly not work.\");\n  lines.push(\"\");\n\n  lines.push(\"Beat\".padEnd(6) + \"View\".padEnd(14) + \"Check\".padEnd(32) + \"Status\");\n  lines.push(\"-\".repeat(70));\n  for (const entry of report.byBeat) {\n    lines.push(String(entry.beat).padEnd(6) + entry.view.padEnd(14) + entry.check.padEnd(32) + entry.status.toUpperCase());\n  }\n  lines.push(\"\");\n\n  for (const result of report.results) {\n    lines.push(\"[\" + result.status.toUpperCase() + \"] \" + result.check);\n    lines.push(\"  \" + result.evidence);\n    if (result.manualStep.length > 0) lines.push(\"  HUMAN: \" + result.manualStep);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nexport type { Beat };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *  for (const result of report.results) {\n    lines.push(\"[\" + result.status.toUpperCase() + \"] \" + result.check);\n    lines.push(\"`\" + ${result.evidence}`);\n    if (result.manualStep.length > 0) lines.push(\"  HUMAN: \" + result.manualStep);\n    lines.push(\"\");\nexport type { Beat };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":308}},{"diffOp":{"equal":{"range":[51,180]}}},{"diffOp":{"delete":{"range":[180,181]}}},{"diffOp":{"insert":{"range":[181,182]}}},{"diffOp":{"equal":{"range":[51,53]}}},{"diffOp":{"delete":{"range":[182,186]}}},{"diffOp":{"insert":{"range":[186,188]}}},{"diffOp":{"equal":{"range":[188,203]}}},{"diffOp":{"insert":{"range":[203,205]}}},{"diffOp":{"equal":{"range":[205,310]}}},{"equalLines":{"line_count":4}},{"diffOp":{"equal":{"range":[310,333]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\verify.ts"},"span":[14154,14176],"sourceCode":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY \"KEYLESS\" IS A REQUIREMENT AND NOT A CONVENIENCE\n *\n * ┬º7.5 asks for keyless verification for one reason: a demo whose correctness depends on an API key is a\n * demo that cannot be checked. A judge cannot reproduce it, a presenter cannot rehearse it on a plane,\n * and the numbers in the pitch cannot be audited by anyone who does not want to pay for the privilege of\n * verifying a claim.\n *\n * So every check below runs on the local engine. Where a check would need an LLM, it is marked `manual`\n * and says what a human has to look at ΓÇö it is never marked `verified` on the strength of a code path\n * that did not run.\n *\n * ---------------------------------------------------------------------------\n * VERIFIED, MANUAL OR FAILED ΓÇö AND NEVER A FOURTH THING\n *\n * There is no \"skipped\" state. A check that could not run is `manual`, which names the human action that\n * substitutes for it. A check that ran and did not hold is `failed`. Collapsing those two would produce a\n * green verification report for a demo that has never been exercised, which is the exact failure this\n * module exists to prevent.\n * ---------------------------------------------------------------------------\n */\n\nimport type { PremiseId } from \"@/types/common\";\nimport type { SeedResult } from \"./kit\";\nimport type { Beat, CheckId } from \"./script\";\nimport { SCRIPT } from \"./script\";\n\nexport type CheckStatus = \"verified\" | \"manual\" | \"failed\";\n\nexport interface CheckResult {\n  readonly check: CheckId;\n  readonly status: CheckStatus;\n  readonly evidence: string;\n  /** What a human must look at, when `status` is \"manual\". Empty otherwise. */\n  readonly manualStep: string;\n}\n\nexport interface VerificationReport {\n  readonly results: readonly CheckResult[];\n  readonly byBeat: readonly { beat: number; view: string; check: CheckId; status: CheckStatus }[];\n  readonly verified: number;\n  readonly manual: number;\n  readonly failed: number;\n  /** True only when nothing failed AND every beat's check resolved to something. A demo with an\n   *  unverified beat can still be given ΓÇö the manual steps cover it ΓÇö but a demo with a FAILED beat\n   *  cannot, because the beat will visibly not work. */\n  readonly demoable: boolean;\n}\n\n/**\n * Verify every beat of the script against a built seed.\n *\n * Takes the seed rather than building one, so the caller decides when the pipeline runs. Building it\n * inside would make verification cost a full import and would hide that cost from whoever is waiting on\n * it during a rehearsal.\n */\nexport function verifyDemo(seed: SeedResult): VerificationReport {\n  const results: CheckResult[] = [\n    checkSeedHasSqlite(seed),\n    checkSeedHasPremises(seed),\n    checkReversalDetected(seed),\n    checkL2Unsound(seed),\n    checkNoHypotheticalNodes(seed),\n    checkGuardsProposed(seed),\n    checkExportContainsDecision(seed),\n    checkAnswerIsGrounded(seed),\n    checkGraphRenders(seed),\n  ];\n\n  const byBeat = SCRIPT.map((beat) => {\n    const result = results.find((entry) => entry.check === beat.check);\n    return {\n      beat: beat.n,\n      view: beat.view,\n      check: beat.check,\n      status: result?.status ?? \"manual\",\n    };\n  });\n\n  return {\n    results,\n    byBeat,\n    verified: results.filter((entry) => entry.status === \"verified\").length,\n    manual: results.filter((entry) => entry.status === \"manual\").length,\n    failed: results.filter((entry) => entry.status === \"failed\").length,\n    demoable: results.every((entry) => entry.status !== \"failed\"),\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Individual checks                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction checkSeedHasSqlite(seed: SeedResult): CheckResult {\n  const hit = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  return hit === undefined\n    ? failed(\"seed-has-sqlite-decision\", \"No SQLite decision in the seed. Beat 1 has nothing to show and every later beat depends on it.\")\n    : verified(\"seed-has-sqlite-decision\", hit.id + \" ┬╖ \" + hit.statement);\n}\n\nfunction checkSeedHasPremises(seed: SeedResult): CheckResult {\n  const sqlite = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite === undefined) {\n    return failed(\"seed-has-premises\", \"No SQLite decision, so its premises cannot be checked.\");\n  }\n\n  /* Premises are reachable through justifications, not through a field on the decision ΓÇö the graph is\n   * bipartite and `Justification.consequent` is a DecisionId, so the edges are walked from the\n   * justification side. Reading a `decision.premises` field here would be reading something that does\n   * not exist and would silently report zero. */\n  const premiseIds = new Set<string>();\n  for (const justification of seed.state.justifications.values()) {\n    if (justification.consequent !== sqlite.id) continue;\n    for (const id of justification.inList) premiseIds.add(id);\n    for (const id of justification.outList) premiseIds.add(id);\n  }\n\n  if (premiseIds.size === 0) {\n    return failed(\n      \"seed-has-premises\",\n      sqlite.id + \" has no justification linking it to any premise. Beat 1's whole point ΓÇö 'notice what is underneath it' ΓÇö cannot be shown.\",\n    );\n  }\n\n  const names = [...premiseIds]\n    .map((id) => seed.state.premises.get(id as PremiseId))\n    .filter((premise) => premise !== undefined)\n    .map((premise) => (premise as { predicate: string }).predicate);\n\n  return verified(\n    \"seed-has-premises\",\n    premiseIds.size + \" premise(s) linked: \" + (names.length > 0 ? names.join(\", \") : \"ids resolved but predicates unreadable\"),\n  );\n}\n\nfunction checkReversalDetected(seed: SeedResult): CheckResult {\n  const records = seed.state.contradictions.filter(\n    (record) => record.verdict === \"contradiction\" || record.verdict === \"reversal\",\n  );\n\n  if (records.length === 0) {\n    return failed(\"reversal-detected\", \"No contradiction or reversal record in the seed. Beat 3 would show an empty panel.\");\n  }\n\n  const structural = records.filter((record) => record.gate === \"structural\").length;\n  return verified(\n    \"reversal-detected\",\n    records.length + \" record(s): \" + structural + \" structural, \" + (records.length - structural) + \" other gate(s).\",\n  );\n}\n\nfunction checkL2Unsound(seed: SeedResult): CheckResult {\n  /* The headline beat. The October SQLite decision must be OUT or UNFOUNDED after the November transcript\n   * is imported, without the November transcript mentioning databases. */\n  const sqlite = [...seed.state.decisions.values()].filter(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite.length === 0) return failed(\"l2-unsound\", \"No SQLite decision in the seed.\");\n\n  const unsound = sqlite.filter((decision) => decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n\n  if (unsound.length === 0) {\n    return failed(\n      \"l2-unsound\",\n      \"DEMO-KILLER: the SQLite decision is still \" + sqlite.map((decision) => decision.label).join(\"/\") +\n      \" after the November transcript. Beat 5 is the peak of the demo and it does not land. \" +\n      \"Fall back to driving the falsification by hand from the Reasoning view and say so out loud.\",\n    );\n  }\n\n  let outListTotal = 0;\n  for (const justification of seed.state.justifications.values()) outListTotal += justification.outList.length;\n\n  return verified(\n    \"l2-unsound\",\n    unsound.map((decision) => decision.id).join(\", \") + \" went unsound. \" + outListTotal +\n    \" OUT-list entry/entries in the graph, which is what makes the retraction non-monotonic rather than a supersede.\",\n  );\n}\n\nfunction checkNoHypotheticalNodes(seed: SeedResult): CheckResult {\n  const hypothetical = [...seed.state.decisions.values()].filter(\n    (decision) => decision.modality === \"hypothetical\" && decision.label === \"IN\",\n  );\n\n  /* A hypothetical node in the seed is only a failure if it is labelled IN: retaining the sentence is\n   * correct (nothing is deleted, invariant I1), promoting it to a live belief is not. */\n  return hypothetical.length === 0\n    ? verified(\"no-hypothetical-nodes\", \"No hypothetical-modality decision carries an IN label.\")\n    : failed(\n        \"no-hypothetical-nodes\",\n        \"DEMO-KILLER: \" + hypothetical.length + \" hypothetical decision(s) are labelled IN: \" +\n        hypothetical.map((decision) => decision.id + \" (\" + decision.statement.slice(0, 40) + \")\").join(\"; \") +\n        \". Beat 6 shows the graph, and a judge who reads one of these aloud ends the demo.\",\n      );\n}\n\nfunction checkGuardsProposed(seed: SeedResult): CheckResult {\n  const guards = [...seed.state.guards.values()];\n\n  if (guards.length === 0) {\n    return failed(\"guards-proposed-not-failing\", \"No guards synthesised. Beat 7 has nothing to show.\");\n  }\n\n  /* Day-one failures are the killer: a guard that has already FAILED before the user wrote any code\n   * reads as a broken tool rather than as a tool that found something. */\n  const failing = guards.filter((guard) => guard.lastRun?.outcome === \"fail\");\n  const accepted = guards.filter((guard) => guard.lifecycle === \"accepted\");\n\n  if (accepted.length > 0) {\n    return failed(\n      \"guards-proposed-not-failing\",\n      \"DEMO-KILLER: \" + accepted.length + \" guard(s) reached `accepted` with no human in the loop. Invariant I4 says the system proposes and the human disposes.\",\n    );\n  }\n\n  return {\n    check: \"guards-proposed-not-failing\",\n    status: failing.length === 0 ? \"verified\" : \"manual\",\n    evidence:\n      guards.length + \" guard(s) synthesised, all in `proposed` or `suppressed` lifecycle. \" +\n      failing.length + \" currently failing against the empty virtual project.\",\n    manualStep:\n      failing.length === 0\n        ? \"\"\n        : failing.length + \" guard(s) fail against an empty project. Paste a real package.json into the \" +\n          \"project panel before beat 7, or show the proposal list instead of the run list.\",\n  };\n}\n\nfunction checkExportContainsDecision(seed: SeedResult): CheckResult {\n  /* The export compiler runs in the browser against the current state and writes files through the UI.\n   * It can be driven headlessly, but doing so here would duplicate `export/index.ts`'s entry point and\n   * the two would drift. Marked manual, with the exact thing to look for. */\n  return {\n    check: \"export-contains-decision\",\n    status: \"manual\",\n    evidence: seed.state.decisions.size + \" decision(s) available to export; \" + seed.state.exports.size + \" export record(s) already in the log.\",\n    manualStep:\n      \"In the Export view, compile CLAUDE.md and confirm three things: (1) the Postgres decision appears \" +\n      \"as an imperative MUST scoped to a glob, (2) the rejected-alternatives block names SQLite, (3) the \" +\n      \"stamp's digest is non-empty and not the literal string 'unknown' ΓÇö that was a real Phase 4 bug \" +\n      \"where every CI export stamped 'unknown' because the code read `log.head.hash` instead of \" +\n      \"`log.headHash`.\",\n  };\n}\n\nfunction checkAnswerIsGrounded(seed: SeedResult): CheckResult {\n  return {\n    check: \"answer-is-grounded\",\n    status: \"manual\",\n    evidence: \"Asking a question runs the retrieval pipeline over the seeded index, which is built in the browser.\",\n    manualStep:\n      \"In the Ask view, ask 'Why did we choose SQLite over Postgres?' and confirm the answer carries a \" +\n      \"GROUNDED verdict with at least one citation that resolves to a real decision. Then ask a question \" +\n      \"the corpus cannot answer and confirm it says INSUFFICIENT_EVIDENCE rather than inventing a claim ΓÇö \" +\n      \"that refusal is the evidence contract and it is the half of the feature a judge will not think to \" +\n      \"test unless shown.\",\n  };\n}\n\nfunction checkGraphRenders(seed: SeedResult): CheckResult {\n  /* The lattice layout is deterministic by design, so its input can be checked headlessly even though\n   * the SVG cannot: a graph with premises and decisions on both sides of a bipartition will lay out. */\n  const decisions = seed.state.decisions.size;\n  const premises = seed.state.premises.size;\n\n  return decisions > 0 && premises > 0\n    ? verified(\"graph-renders\", decisions + \" decision(s) and \" + premises + \" premise(s): both sides of the bipartition are populated.\")\n    : failed(\"graph-renders\", decisions + \" decision(s), \" + premises + \" premise(s). An empty side produces an empty diagram.\");\n}\n\nfunction verified(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"verified\", evidence, manualStep: \"\" };\n}\n\nfunction failed(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"failed\", evidence, manualStep: \"\" };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function renderVerification(report: VerificationReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"KEYLESS DEMO VERIFICATION\");\n  lines.push(report.verified + \" verified ┬╖ \" + report.manual + \" manual ┬╖ \" + report.failed + \" FAILED\");\n  lines.push(report.demoable ? \"DEMOABLE.\" : \"NOT DEMOABLE ΓÇö a beat will visibly not work.\");\n  lines.push(\"\");\n\n  lines.push(\"Beat\".padEnd(6) + \"View\".padEnd(14) + \"Check\".padEnd(32) + \"Status\");\n  lines.push(\"-\".repeat(70));\n  for (const entry of report.byBeat) {\n    lines.push(String(entry.beat).padEnd(6) + entry.view.padEnd(14) + entry.check.padEnd(32) + entry.status.toUpperCase());\n  }\n  lines.push(\"\");\n\n  for (const result of report.results) {\n    lines.push(\"[\" + result.status.toUpperCase() + \"] \" + result.check);\n    lines.push(\"  \" + result.evidence);\n    if (result.manualStep.length > 0) lines.push(\"  HUMAN: \" + result.manualStep);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nexport type { Beat };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *    lines.push(\"[\" + result.status.toUpperCase() + \"] \" + result.check);\n    lines.push(\"  \" + result.evidence);\n    if (result.manualStep.length > 0) lines.push(\"`  HUMAN: \" + ${result.manualStep}`);\n    lines.push(\"\");\n  }\nexport type { Beat };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":309}},{"diffOp":{"equal":{"range":[51,213]}}},{"diffOp":{"delete":{"range":[213,214]}}},{"diffOp":{"insert":{"range":[214,215]}}},{"diffOp":{"equal":{"range":[215,224]}}},{"diffOp":{"delete":{"range":[224,228]}}},{"diffOp":{"insert":{"range":[228,230]}}},{"diffOp":{"equal":{"range":[230,247]}}},{"diffOp":{"insert":{"range":[247,249]}}},{"diffOp":{"equal":{"range":[249,275]}}},{"equalLines":{"line_count":3}},{"diffOp":{"equal":{"range":[275,298]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\verify.ts"},"span":[14228,14259],"sourceCode":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY \"KEYLESS\" IS A REQUIREMENT AND NOT A CONVENIENCE\n *\n * ┬º7.5 asks for keyless verification for one reason: a demo whose correctness depends on an API key is a\n * demo that cannot be checked. A judge cannot reproduce it, a presenter cannot rehearse it on a plane,\n * and the numbers in the pitch cannot be audited by anyone who does not want to pay for the privilege of\n * verifying a claim.\n *\n * So every check below runs on the local engine. Where a check would need an LLM, it is marked `manual`\n * and says what a human has to look at ΓÇö it is never marked `verified` on the strength of a code path\n * that did not run.\n *\n * ---------------------------------------------------------------------------\n * VERIFIED, MANUAL OR FAILED ΓÇö AND NEVER A FOURTH THING\n *\n * There is no \"skipped\" state. A check that could not run is `manual`, which names the human action that\n * substitutes for it. A check that ran and did not hold is `failed`. Collapsing those two would produce a\n * green verification report for a demo that has never been exercised, which is the exact failure this\n * module exists to prevent.\n * ---------------------------------------------------------------------------\n */\n\nimport type { PremiseId } from \"@/types/common\";\nimport type { SeedResult } from \"./kit\";\nimport type { Beat, CheckId } from \"./script\";\nimport { SCRIPT } from \"./script\";\n\nexport type CheckStatus = \"verified\" | \"manual\" | \"failed\";\n\nexport interface CheckResult {\n  readonly check: CheckId;\n  readonly status: CheckStatus;\n  readonly evidence: string;\n  /** What a human must look at, when `status` is \"manual\". Empty otherwise. */\n  readonly manualStep: string;\n}\n\nexport interface VerificationReport {\n  readonly results: readonly CheckResult[];\n  readonly byBeat: readonly { beat: number; view: string; check: CheckId; status: CheckStatus }[];\n  readonly verified: number;\n  readonly manual: number;\n  readonly failed: number;\n  /** True only when nothing failed AND every beat's check resolved to something. A demo with an\n   *  unverified beat can still be given ΓÇö the manual steps cover it ΓÇö but a demo with a FAILED beat\n   *  cannot, because the beat will visibly not work. */\n  readonly demoable: boolean;\n}\n\n/**\n * Verify every beat of the script against a built seed.\n *\n * Takes the seed rather than building one, so the caller decides when the pipeline runs. Building it\n * inside would make verification cost a full import and would hide that cost from whoever is waiting on\n * it during a rehearsal.\n */\nexport function verifyDemo(seed: SeedResult): VerificationReport {\n  const results: CheckResult[] = [\n    checkSeedHasSqlite(seed),\n    checkSeedHasPremises(seed),\n    checkReversalDetected(seed),\n    checkL2Unsound(seed),\n    checkNoHypotheticalNodes(seed),\n    checkGuardsProposed(seed),\n    checkExportContainsDecision(seed),\n    checkAnswerIsGrounded(seed),\n    checkGraphRenders(seed),\n  ];\n\n  const byBeat = SCRIPT.map((beat) => {\n    const result = results.find((entry) => entry.check === beat.check);\n    return {\n      beat: beat.n,\n      view: beat.view,\n      check: beat.check,\n      status: result?.status ?? \"manual\",\n    };\n  });\n\n  return {\n    results,\n    byBeat,\n    verified: results.filter((entry) => entry.status === \"verified\").length,\n    manual: results.filter((entry) => entry.status === \"manual\").length,\n    failed: results.filter((entry) => entry.status === \"failed\").length,\n    demoable: results.every((entry) => entry.status !== \"failed\"),\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Individual checks                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction checkSeedHasSqlite(seed: SeedResult): CheckResult {\n  const hit = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  return hit === undefined\n    ? failed(\"seed-has-sqlite-decision\", \"No SQLite decision in the seed. Beat 1 has nothing to show and every later beat depends on it.\")\n    : verified(\"seed-has-sqlite-decision\", hit.id + \" ┬╖ \" + hit.statement);\n}\n\nfunction checkSeedHasPremises(seed: SeedResult): CheckResult {\n  const sqlite = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite === undefined) {\n    return failed(\"seed-has-premises\", \"No SQLite decision, so its premises cannot be checked.\");\n  }\n\n  /* Premises are reachable through justifications, not through a field on the decision ΓÇö the graph is\n   * bipartite and `Justification.consequent` is a DecisionId, so the edges are walked from the\n   * justification side. Reading a `decision.premises` field here would be reading something that does\n   * not exist and would silently report zero. */\n  const premiseIds = new Set<string>();\n  for (const justification of seed.state.justifications.values()) {\n    if (justification.consequent !== sqlite.id) continue;\n    for (const id of justification.inList) premiseIds.add(id);\n    for (const id of justification.outList) premiseIds.add(id);\n  }\n\n  if (premiseIds.size === 0) {\n    return failed(\n      \"seed-has-premises\",\n      sqlite.id + \" has no justification linking it to any premise. Beat 1's whole point ΓÇö 'notice what is underneath it' ΓÇö cannot be shown.\",\n    );\n  }\n\n  const names = [...premiseIds]\n    .map((id) => seed.state.premises.get(id as PremiseId))\n    .filter((premise) => premise !== undefined)\n    .map((premise) => (premise as { predicate: string }).predicate);\n\n  return verified(\n    \"seed-has-premises\",\n    premiseIds.size + \" premise(s) linked: \" + (names.length > 0 ? names.join(\", \") : \"ids resolved but predicates unreadable\"),\n  );\n}\n\nfunction checkReversalDetected(seed: SeedResult): CheckResult {\n  const records = seed.state.contradictions.filter(\n    (record) => record.verdict === \"contradiction\" || record.verdict === \"reversal\",\n  );\n\n  if (records.length === 0) {\n    return failed(\"reversal-detected\", \"No contradiction or reversal record in the seed. Beat 3 would show an empty panel.\");\n  }\n\n  const structural = records.filter((record) => record.gate === \"structural\").length;\n  return verified(\n    \"reversal-detected\",\n    records.length + \" record(s): \" + structural + \" structural, \" + (records.length - structural) + \" other gate(s).\",\n  );\n}\n\nfunction checkL2Unsound(seed: SeedResult): CheckResult {\n  /* The headline beat. The October SQLite decision must be OUT or UNFOUNDED after the November transcript\n   * is imported, without the November transcript mentioning databases. */\n  const sqlite = [...seed.state.decisions.values()].filter(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite.length === 0) return failed(\"l2-unsound\", \"No SQLite decision in the seed.\");\n\n  const unsound = sqlite.filter((decision) => decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n\n  if (unsound.length === 0) {\n    return failed(\n      \"l2-unsound\",\n      \"DEMO-KILLER: the SQLite decision is still \" + sqlite.map((decision) => decision.label).join(\"/\") +\n      \" after the November transcript. Beat 5 is the peak of the demo and it does not land. \" +\n      \"Fall back to driving the falsification by hand from the Reasoning view and say so out loud.\",\n    );\n  }\n\n  let outListTotal = 0;\n  for (const justification of seed.state.justifications.values()) outListTotal += justification.outList.length;\n\n  return verified(\n    \"l2-unsound\",\n    unsound.map((decision) => decision.id).join(\", \") + \" went unsound. \" + outListTotal +\n    \" OUT-list entry/entries in the graph, which is what makes the retraction non-monotonic rather than a supersede.\",\n  );\n}\n\nfunction checkNoHypotheticalNodes(seed: SeedResult): CheckResult {\n  const hypothetical = [...seed.state.decisions.values()].filter(\n    (decision) => decision.modality === \"hypothetical\" && decision.label === \"IN\",\n  );\n\n  /* A hypothetical node in the seed is only a failure if it is labelled IN: retaining the sentence is\n   * correct (nothing is deleted, invariant I1), promoting it to a live belief is not. */\n  return hypothetical.length === 0\n    ? verified(\"no-hypothetical-nodes\", \"No hypothetical-modality decision carries an IN label.\")\n    : failed(\n        \"no-hypothetical-nodes\",\n        \"DEMO-KILLER: \" + hypothetical.length + \" hypothetical decision(s) are labelled IN: \" +\n        hypothetical.map((decision) => decision.id + \" (\" + decision.statement.slice(0, 40) + \")\").join(\"; \") +\n        \". Beat 6 shows the graph, and a judge who reads one of these aloud ends the demo.\",\n      );\n}\n\nfunction checkGuardsProposed(seed: SeedResult): CheckResult {\n  const guards = [...seed.state.guards.values()];\n\n  if (guards.length === 0) {\n    return failed(\"guards-proposed-not-failing\", \"No guards synthesised. Beat 7 has nothing to show.\");\n  }\n\n  /* Day-one failures are the killer: a guard that has already FAILED before the user wrote any code\n   * reads as a broken tool rather than as a tool that found something. */\n  const failing = guards.filter((guard) => guard.lastRun?.outcome === \"fail\");\n  const accepted = guards.filter((guard) => guard.lifecycle === \"accepted\");\n\n  if (accepted.length > 0) {\n    return failed(\n      \"guards-proposed-not-failing\",\n      \"DEMO-KILLER: \" + accepted.length + \" guard(s) reached `accepted` with no human in the loop. Invariant I4 says the system proposes and the human disposes.\",\n    );\n  }\n\n  return {\n    check: \"guards-proposed-not-failing\",\n    status: failing.length === 0 ? \"verified\" : \"manual\",\n    evidence:\n      guards.length + \" guard(s) synthesised, all in `proposed` or `suppressed` lifecycle. \" +\n      failing.length + \" currently failing against the empty virtual project.\",\n    manualStep:\n      failing.length === 0\n        ? \"\"\n        : failing.length + \" guard(s) fail against an empty project. Paste a real package.json into the \" +\n          \"project panel before beat 7, or show the proposal list instead of the run list.\",\n  };\n}\n\nfunction checkExportContainsDecision(seed: SeedResult): CheckResult {\n  /* The export compiler runs in the browser against the current state and writes files through the UI.\n   * It can be driven headlessly, but doing so here would duplicate `export/index.ts`'s entry point and\n   * the two would drift. Marked manual, with the exact thing to look for. */\n  return {\n    check: \"export-contains-decision\",\n    status: \"manual\",\n    evidence: seed.state.decisions.size + \" decision(s) available to export; \" + seed.state.exports.size + \" export record(s) already in the log.\",\n    manualStep:\n      \"In the Export view, compile CLAUDE.md and confirm three things: (1) the Postgres decision appears \" +\n      \"as an imperative MUST scoped to a glob, (2) the rejected-alternatives block names SQLite, (3) the \" +\n      \"stamp's digest is non-empty and not the literal string 'unknown' ΓÇö that was a real Phase 4 bug \" +\n      \"where every CI export stamped 'unknown' because the code read `log.head.hash` instead of \" +\n      \"`log.headHash`.\",\n  };\n}\n\nfunction checkAnswerIsGrounded(seed: SeedResult): CheckResult {\n  return {\n    check: \"answer-is-grounded\",\n    status: \"manual\",\n    evidence: \"Asking a question runs the retrieval pipeline over the seeded index, which is built in the browser.\",\n    manualStep:\n      \"In the Ask view, ask 'Why did we choose SQLite over Postgres?' and confirm the answer carries a \" +\n      \"GROUNDED verdict with at least one citation that resolves to a real decision. Then ask a question \" +\n      \"the corpus cannot answer and confirm it says INSUFFICIENT_EVIDENCE rather than inventing a claim ΓÇö \" +\n      \"that refusal is the evidence contract and it is the half of the feature a judge will not think to \" +\n      \"test unless shown.\",\n  };\n}\n\nfunction checkGraphRenders(seed: SeedResult): CheckResult {\n  /* The lattice layout is deterministic by design, so its input can be checked headlessly even though\n   * the SVG cannot: a graph with premises and decisions on both sides of a bipartition will lay out. */\n  const decisions = seed.state.decisions.size;\n  const premises = seed.state.premises.size;\n\n  return decisions > 0 && premises > 0\n    ? verified(\"graph-renders\", decisions + \" decision(s) and \" + premises + \" premise(s): both sides of the bipartition are populated.\")\n    : failed(\"graph-renders\", decisions + \" decision(s), \" + premises + \" premise(s). An empty side produces an empty diagram.\");\n}\n\nfunction verified(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"verified\", evidence, manualStep: \"\" };\n}\n\nfunction failed(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"failed\", evidence, manualStep: \"\" };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function renderVerification(report: VerificationReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"KEYLESS DEMO VERIFICATION\");\n  lines.push(report.verified + \" verified ┬╖ \" + report.manual + \" manual ┬╖ \" + report.failed + \" FAILED\");\n  lines.push(report.demoable ? \"DEMOABLE.\" : \"NOT DEMOABLE ΓÇö a beat will visibly not work.\");\n  lines.push(\"\");\n\n  lines.push(\"Beat\".padEnd(6) + \"View\".padEnd(14) + \"Check\".padEnd(32) + \"Status\");\n  lines.push(\"-\".repeat(70));\n  for (const entry of report.byBeat) {\n    lines.push(String(entry.beat).padEnd(6) + entry.view.padEnd(14) + entry.check.padEnd(32) + entry.status.toUpperCase());\n  }\n  lines.push(\"\");\n\n  for (const result of report.results) {\n    lines.push(\"[\" + result.status.toUpperCase() + \"] \" + result.check);\n    lines.push(\"  \" + result.evidence);\n    if (result.manualStep.length > 0) lines.push(\"  HUMAN: \" + result.manualStep);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nexport type { Beat };\n"},"tags":["fixable"],"source":null},{"category":"lint/correctness/noUnusedVariables","severity":"error","description":"This parameter is unused.","message":[{"elements":[],"content":"This parameter is unused."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unused variables usually are result of incomplete refactoring, typos and other source of bugs."}]]},{"log":["info",[{"elements":[],"content":"Unsafe fix: If this is intentional, prepend "},{"elements":["Emphasis"],"content":"seed"},{"elements":[],"content":" with an underscore."}]]},{"diff":{"dictionary":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *}\n\nfunction checkAnswerIsGrounded(seed_seed: SeedResult): CheckResult {\n  return {\n    check: \"answer-is-grounded\",\nexport type { Beat };\n","ops":[{"diffOp":{"equal":{"range":[0,51]}}},{"equalLines":{"line_count":254}},{"diffOp":{"equal":{"range":[51,85]}}},{"diffOp":{"delete":{"range":[85,89]}}},{"diffOp":{"insert":{"range":[89,94]}}},{"diffOp":{"equal":{"range":[94,166]}}},{"equalLines":{"line_count":58}},{"diffOp":{"equal":{"range":[166,189]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\verify.ts"},"span":[11466,11470],"sourceCode":"/**\n * Keyless verification of the demo ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY \"KEYLESS\" IS A REQUIREMENT AND NOT A CONVENIENCE\n *\n * ┬º7.5 asks for keyless verification for one reason: a demo whose correctness depends on an API key is a\n * demo that cannot be checked. A judge cannot reproduce it, a presenter cannot rehearse it on a plane,\n * and the numbers in the pitch cannot be audited by anyone who does not want to pay for the privilege of\n * verifying a claim.\n *\n * So every check below runs on the local engine. Where a check would need an LLM, it is marked `manual`\n * and says what a human has to look at ΓÇö it is never marked `verified` on the strength of a code path\n * that did not run.\n *\n * ---------------------------------------------------------------------------\n * VERIFIED, MANUAL OR FAILED ΓÇö AND NEVER A FOURTH THING\n *\n * There is no \"skipped\" state. A check that could not run is `manual`, which names the human action that\n * substitutes for it. A check that ran and did not hold is `failed`. Collapsing those two would produce a\n * green verification report for a demo that has never been exercised, which is the exact failure this\n * module exists to prevent.\n * ---------------------------------------------------------------------------\n */\n\nimport type { PremiseId } from \"@/types/common\";\nimport type { SeedResult } from \"./kit\";\nimport type { Beat, CheckId } from \"./script\";\nimport { SCRIPT } from \"./script\";\n\nexport type CheckStatus = \"verified\" | \"manual\" | \"failed\";\n\nexport interface CheckResult {\n  readonly check: CheckId;\n  readonly status: CheckStatus;\n  readonly evidence: string;\n  /** What a human must look at, when `status` is \"manual\". Empty otherwise. */\n  readonly manualStep: string;\n}\n\nexport interface VerificationReport {\n  readonly results: readonly CheckResult[];\n  readonly byBeat: readonly { beat: number; view: string; check: CheckId; status: CheckStatus }[];\n  readonly verified: number;\n  readonly manual: number;\n  readonly failed: number;\n  /** True only when nothing failed AND every beat's check resolved to something. A demo with an\n   *  unverified beat can still be given ΓÇö the manual steps cover it ΓÇö but a demo with a FAILED beat\n   *  cannot, because the beat will visibly not work. */\n  readonly demoable: boolean;\n}\n\n/**\n * Verify every beat of the script against a built seed.\n *\n * Takes the seed rather than building one, so the caller decides when the pipeline runs. Building it\n * inside would make verification cost a full import and would hide that cost from whoever is waiting on\n * it during a rehearsal.\n */\nexport function verifyDemo(seed: SeedResult): VerificationReport {\n  const results: CheckResult[] = [\n    checkSeedHasSqlite(seed),\n    checkSeedHasPremises(seed),\n    checkReversalDetected(seed),\n    checkL2Unsound(seed),\n    checkNoHypotheticalNodes(seed),\n    checkGuardsProposed(seed),\n    checkExportContainsDecision(seed),\n    checkAnswerIsGrounded(seed),\n    checkGraphRenders(seed),\n  ];\n\n  const byBeat = SCRIPT.map((beat) => {\n    const result = results.find((entry) => entry.check === beat.check);\n    return {\n      beat: beat.n,\n      view: beat.view,\n      check: beat.check,\n      status: result?.status ?? \"manual\",\n    };\n  });\n\n  return {\n    results,\n    byBeat,\n    verified: results.filter((entry) => entry.status === \"verified\").length,\n    manual: results.filter((entry) => entry.status === \"manual\").length,\n    failed: results.filter((entry) => entry.status === \"failed\").length,\n    demoable: results.every((entry) => entry.status !== \"failed\"),\n  };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Individual checks                                                          */\n/* -------------------------------------------------------------------------- */\n\nfunction checkSeedHasSqlite(seed: SeedResult): CheckResult {\n  const hit = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  return hit === undefined\n    ? failed(\"seed-has-sqlite-decision\", \"No SQLite decision in the seed. Beat 1 has nothing to show and every later beat depends on it.\")\n    : verified(\"seed-has-sqlite-decision\", hit.id + \" ┬╖ \" + hit.statement);\n}\n\nfunction checkSeedHasPremises(seed: SeedResult): CheckResult {\n  const sqlite = [...seed.state.decisions.values()].find(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite === undefined) {\n    return failed(\"seed-has-premises\", \"No SQLite decision, so its premises cannot be checked.\");\n  }\n\n  /* Premises are reachable through justifications, not through a field on the decision ΓÇö the graph is\n   * bipartite and `Justification.consequent` is a DecisionId, so the edges are walked from the\n   * justification side. Reading a `decision.premises` field here would be reading something that does\n   * not exist and would silently report zero. */\n  const premiseIds = new Set<string>();\n  for (const justification of seed.state.justifications.values()) {\n    if (justification.consequent !== sqlite.id) continue;\n    for (const id of justification.inList) premiseIds.add(id);\n    for (const id of justification.outList) premiseIds.add(id);\n  }\n\n  if (premiseIds.size === 0) {\n    return failed(\n      \"seed-has-premises\",\n      sqlite.id + \" has no justification linking it to any premise. Beat 1's whole point ΓÇö 'notice what is underneath it' ΓÇö cannot be shown.\",\n    );\n  }\n\n  const names = [...premiseIds]\n    .map((id) => seed.state.premises.get(id as PremiseId))\n    .filter((premise) => premise !== undefined)\n    .map((premise) => (premise as { predicate: string }).predicate);\n\n  return verified(\n    \"seed-has-premises\",\n    premiseIds.size + \" premise(s) linked: \" + (names.length > 0 ? names.join(\", \") : \"ids resolved but predicates unreadable\"),\n  );\n}\n\nfunction checkReversalDetected(seed: SeedResult): CheckResult {\n  const records = seed.state.contradictions.filter(\n    (record) => record.verdict === \"contradiction\" || record.verdict === \"reversal\",\n  );\n\n  if (records.length === 0) {\n    return failed(\"reversal-detected\", \"No contradiction or reversal record in the seed. Beat 3 would show an empty panel.\");\n  }\n\n  const structural = records.filter((record) => record.gate === \"structural\").length;\n  return verified(\n    \"reversal-detected\",\n    records.length + \" record(s): \" + structural + \" structural, \" + (records.length - structural) + \" other gate(s).\",\n  );\n}\n\nfunction checkL2Unsound(seed: SeedResult): CheckResult {\n  /* The headline beat. The October SQLite decision must be OUT or UNFOUNDED after the November transcript\n   * is imported, without the November transcript mentioning databases. */\n  const sqlite = [...seed.state.decisions.values()].filter(\n    (decision) => decision.variable === \"DATABASE\" && /sqlite/i.test(decision.value + \" \" + decision.statement),\n  );\n\n  if (sqlite.length === 0) return failed(\"l2-unsound\", \"No SQLite decision in the seed.\");\n\n  const unsound = sqlite.filter((decision) => decision.label === \"OUT\" || decision.label === \"UNFOUNDED\");\n\n  if (unsound.length === 0) {\n    return failed(\n      \"l2-unsound\",\n      \"DEMO-KILLER: the SQLite decision is still \" + sqlite.map((decision) => decision.label).join(\"/\") +\n      \" after the November transcript. Beat 5 is the peak of the demo and it does not land. \" +\n      \"Fall back to driving the falsification by hand from the Reasoning view and say so out loud.\",\n    );\n  }\n\n  let outListTotal = 0;\n  for (const justification of seed.state.justifications.values()) outListTotal += justification.outList.length;\n\n  return verified(\n    \"l2-unsound\",\n    unsound.map((decision) => decision.id).join(\", \") + \" went unsound. \" + outListTotal +\n    \" OUT-list entry/entries in the graph, which is what makes the retraction non-monotonic rather than a supersede.\",\n  );\n}\n\nfunction checkNoHypotheticalNodes(seed: SeedResult): CheckResult {\n  const hypothetical = [...seed.state.decisions.values()].filter(\n    (decision) => decision.modality === \"hypothetical\" && decision.label === \"IN\",\n  );\n\n  /* A hypothetical node in the seed is only a failure if it is labelled IN: retaining the sentence is\n   * correct (nothing is deleted, invariant I1), promoting it to a live belief is not. */\n  return hypothetical.length === 0\n    ? verified(\"no-hypothetical-nodes\", \"No hypothetical-modality decision carries an IN label.\")\n    : failed(\n        \"no-hypothetical-nodes\",\n        \"DEMO-KILLER: \" + hypothetical.length + \" hypothetical decision(s) are labelled IN: \" +\n        hypothetical.map((decision) => decision.id + \" (\" + decision.statement.slice(0, 40) + \")\").join(\"; \") +\n        \". Beat 6 shows the graph, and a judge who reads one of these aloud ends the demo.\",\n      );\n}\n\nfunction checkGuardsProposed(seed: SeedResult): CheckResult {\n  const guards = [...seed.state.guards.values()];\n\n  if (guards.length === 0) {\n    return failed(\"guards-proposed-not-failing\", \"No guards synthesised. Beat 7 has nothing to show.\");\n  }\n\n  /* Day-one failures are the killer: a guard that has already FAILED before the user wrote any code\n   * reads as a broken tool rather than as a tool that found something. */\n  const failing = guards.filter((guard) => guard.lastRun?.outcome === \"fail\");\n  const accepted = guards.filter((guard) => guard.lifecycle === \"accepted\");\n\n  if (accepted.length > 0) {\n    return failed(\n      \"guards-proposed-not-failing\",\n      \"DEMO-KILLER: \" + accepted.length + \" guard(s) reached `accepted` with no human in the loop. Invariant I4 says the system proposes and the human disposes.\",\n    );\n  }\n\n  return {\n    check: \"guards-proposed-not-failing\",\n    status: failing.length === 0 ? \"verified\" : \"manual\",\n    evidence:\n      guards.length + \" guard(s) synthesised, all in `proposed` or `suppressed` lifecycle. \" +\n      failing.length + \" currently failing against the empty virtual project.\",\n    manualStep:\n      failing.length === 0\n        ? \"\"\n        : failing.length + \" guard(s) fail against an empty project. Paste a real package.json into the \" +\n          \"project panel before beat 7, or show the proposal list instead of the run list.\",\n  };\n}\n\nfunction checkExportContainsDecision(seed: SeedResult): CheckResult {\n  /* The export compiler runs in the browser against the current state and writes files through the UI.\n   * It can be driven headlessly, but doing so here would duplicate `export/index.ts`'s entry point and\n   * the two would drift. Marked manual, with the exact thing to look for. */\n  return {\n    check: \"export-contains-decision\",\n    status: \"manual\",\n    evidence: seed.state.decisions.size + \" decision(s) available to export; \" + seed.state.exports.size + \" export record(s) already in the log.\",\n    manualStep:\n      \"In the Export view, compile CLAUDE.md and confirm three things: (1) the Postgres decision appears \" +\n      \"as an imperative MUST scoped to a glob, (2) the rejected-alternatives block names SQLite, (3) the \" +\n      \"stamp's digest is non-empty and not the literal string 'unknown' ΓÇö that was a real Phase 4 bug \" +\n      \"where every CI export stamped 'unknown' because the code read `log.head.hash` instead of \" +\n      \"`log.headHash`.\",\n  };\n}\n\nfunction checkAnswerIsGrounded(seed: SeedResult): CheckResult {\n  return {\n    check: \"answer-is-grounded\",\n    status: \"manual\",\n    evidence: \"Asking a question runs the retrieval pipeline over the seeded index, which is built in the browser.\",\n    manualStep:\n      \"In the Ask view, ask 'Why did we choose SQLite over Postgres?' and confirm the answer carries a \" +\n      \"GROUNDED verdict with at least one citation that resolves to a real decision. Then ask a question \" +\n      \"the corpus cannot answer and confirm it says INSUFFICIENT_EVIDENCE rather than inventing a claim ΓÇö \" +\n      \"that refusal is the evidence contract and it is the half of the feature a judge will not think to \" +\n      \"test unless shown.\",\n  };\n}\n\nfunction checkGraphRenders(seed: SeedResult): CheckResult {\n  /* The lattice layout is deterministic by design, so its input can be checked headlessly even though\n   * the SVG cannot: a graph with premises and decisions on both sides of a bipartition will lay out. */\n  const decisions = seed.state.decisions.size;\n  const premises = seed.state.premises.size;\n\n  return decisions > 0 && premises > 0\n    ? verified(\"graph-renders\", decisions + \" decision(s) and \" + premises + \" premise(s): both sides of the bipartition are populated.\")\n    : failed(\"graph-renders\", decisions + \" decision(s), \" + premises + \" premise(s). An empty side produces an empty diagram.\");\n}\n\nfunction verified(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"verified\", evidence, manualStep: \"\" };\n}\n\nfunction failed(check: CheckId, evidence: string): CheckResult {\n  return { check, status: \"failed\", evidence, manualStep: \"\" };\n}\n\n/* -------------------------------------------------------------------------- */\n/* Rendering                                                                  */\n/* -------------------------------------------------------------------------- */\n\nexport function renderVerification(report: VerificationReport): string {\n  const lines: string[] = [];\n\n  lines.push(\"KEYLESS DEMO VERIFICATION\");\n  lines.push(report.verified + \" verified ┬╖ \" + report.manual + \" manual ┬╖ \" + report.failed + \" FAILED\");\n  lines.push(report.demoable ? \"DEMOABLE.\" : \"NOT DEMOABLE ΓÇö a beat will visibly not work.\");\n  lines.push(\"\");\n\n  lines.push(\"Beat\".padEnd(6) + \"View\".padEnd(14) + \"Check\".padEnd(32) + \"Status\");\n  lines.push(\"-\".repeat(70));\n  for (const entry of report.byBeat) {\n    lines.push(String(entry.beat).padEnd(6) + entry.view.padEnd(14) + entry.check.padEnd(32) + entry.status.toUpperCase());\n  }\n  lines.push(\"\");\n\n  for (const result of report.results) {\n    lines.push(\"[\" + result.status.toUpperCase() + \"] \" + result.check);\n    lines.push(\"  \" + result.evidence);\n    if (result.manualStep.length > 0) lines.push(\"  HUMAN: \" + result.manualStep);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n\nexport type { Beat };\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval` ΓÇö score the full system once, on the local engine, and print every number.\n *  heading(\"Import\");\n  line(describeFailures(run));\n  line(\n    `${run.state.decisions.size + \"} decisions ┬╖ \"+ ${run.state.premises.size premises ┬╖ \" +\n    run.state.alternatives.size alternatives ┬╖ \" + run.state.guards.size guards ┬╖ run.state.contradictions.length contradiction record(s),\n  );\n  line(\"Wall time \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.proposalsRaised + \" revision proposal(s) raised\");  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":28}},{"diffOp":{"equal":{"range":[101,160]}}},{"diffOp":{"equal":{"range":[160,165]}}},{"diffOp":{"insert":{"range":[165,168]}}},{"diffOp":{"equal":{"range":[168,192]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,197]}}},{"diffOp":{"equal":{"range":[197,210]}}},{"diffOp":{"delete":{"range":[210,212]}}},{"diffOp":{"equal":{"range":[197,198]}}},{"diffOp":{"delete":{"range":[212,214]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[216,239]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,197]}}},{"diffOp":{"equal":{"range":[239,252]}}},{"diffOp":{"delete":{"range":[252,260]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[260,287]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,197]}}},{"diffOp":{"equal":{"range":[287,304]}}},{"diffOp":{"delete":{"range":[304,308]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[308,329]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,197]}}},{"diffOp":{"equal":{"range":[329,340]}}},{"diffOp":{"delete":{"range":[252,260]}}},{"diffOp":{"insert":{"range":[214,216]}}},{"diffOp":{"equal":{"range":[340,371]}}},{"diffOp":{"delete":{"range":[192,196]}}},{"diffOp":{"insert":{"range":[196,197]}}},{"diffOp":{"equal":{"range":[371,395]}}},{"diffOp":{"delete":{"range":[304,305]}}},{"diffOp":{"insert":{"range":[165,166]}}},{"diffOp":{"equal":{"range":[395,525]}}},{"equalLines":{"line_count":64}},{"diffOp":{"equal":{"range":[525,553]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\run.ts"},"span":[1195,1445],"sourceCode":"/**\n * `npm run eval` ΓÇö score the full system once, on the local engine, and print every number.\n *\n * Phase 7 ┬╖ sub-phase 7.2\n *\n * This is the entry point a judge should be invited to run. It needs no API key, no network and no\n * build step: `tsx src/eval/run.ts` against the checked-in corpus. If it cannot be run by a stranger in\n * under a minute, the numbers in the pitch are not verifiable and the pitch is an advertisement.\n */\n\nimport { describeFailures, runConfig } from \"./harness\";\nimport { FULL, DEFAULT_PARAMS } from \"./ablation/toggles\";\nimport { renderSuite, scoreAll } from \"./metrics\";\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"./cli\";\nimport { renderFullReport } from \"./report\";\nimport { harden, renderHardening } from \"./hardening\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, engine, engineId } = prepare();\n\n  banner(\"Baseline run ΓÇö all eleven components on\");\n\n  const run = await runConfig(resolved, {\n    id: \"full\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  heading(\"Import\");\n  line(describeFailures(run));\n  line(\n    run.state.decisions.size + \" decisions ┬╖ \" + run.state.premises.size + \" premises ┬╖ \" +\n    run.state.alternatives.size + \" alternatives ┬╖ \" + run.state.guards.size + \" guards ┬╖ \" +\n    run.state.contradictions.length + \" contradiction record(s)\",\n  );\n  line(\"Wall time \" + (run.durationMs / 1000).toFixed(1) + \"s ┬╖ \" + run.proposalsRaised + \" revision proposal(s) raised\");\n\n  /* A revision the log refused means the reasoner emitted a draft that failed validation, so the\n   * graph scored below is the PRE-revision graph for that pass. Printed rather than swallowed:\n   * without it a cascade score of \"nothing changed\" is indistinguishable from \"nothing was allowed\n   * to change\". */\n  if (run.revisionFailures.length > 0) {\n    blank();\n    line(\"Revision passes the log REFUSED (\" + run.revisionFailures.length + \"):\");\n    for (const failure of run.revisionFailures) line(\"  \" + failure);\n  }\n\n  if (run.interventions.length > 0) {\n    blank();\n    line(\"Planted interventions:\");\n    for (const intervention of run.interventions) {\n      line(\"  \" + (intervention.applied ? \"APPLIED  \" : \"UNAPPLIED\") + \" \" + intervention.plant + \" ┬╖ \" + intervention.predicate);\n      line(\"           \" + intervention.reason);\n    }\n  }\n\n  const scored = scoreAll(resolved, run, engineId);\n\n  heading(\"Metrics\");\n  line(renderSuite(scored));\n\n  const hardened = harden(resolved, scored);\n\n  heading(\"Hardening pass (7.4)\");\n  line(renderHardening(hardened));\n\n  heading(\"What each number does not establish\");\n  for (const metric of scored.metrics) {\n    line(\"┬╖ \" + metric.name);\n    line(\"  \" + metric.gloss);\n    line(\"  honest note: \" + metric.honestNote);\n    blank();\n  }\n\n  if (args.has(\"out\")) write(args.get(\"out\") ?? \"eval-report.md\", renderFullReport(resolved, scored, null, hardened));\n  if (args.has(\"json\")) {\n    write(\n      args.get(\"json\") ?? \"eval-report.json\",\n      JSON.stringify(\n        {\n          corpus: resolved.version,\n          engine: engineId,\n          ranAt: run.startedAt,\n          metrics: scored.metrics,\n        },\n        null,\n        2,\n      ),\n    );\n  }\n\n  blank();\n  line(\"Run `npm run eval:ablation` for the delta table and the prediction audit.\");\n  line(\"Run `npm run demo:verify` for the demo kit: script, beat verification, three dry runs.\");\n\n  if (!hardened.ready) process.exitCode = 1;\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval` ΓÇö score the full system once, on the local engine, and print every number.\n *    run.state.contradictions.length + \" contradiction record(s)\",\n  );\n  line(\"`Wall time \"+ ${(run.durationMs / 1000).toFixed(1) + \"}s ┬╖ \" + run.proposalsRaised revision proposal(s) raised);\n\n  /* A revision the log refused means the reasoner emitted a draft that failed validation, so the  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"range":[0,101]}}},{"equalLines":{"line_count":33}},{"diffOp":{"equal":{"range":[101,179]}}},{"diffOp":{"delete":{"range":[179,180]}}},{"diffOp":{"insert":{"range":[180,181]}}},{"diffOp":{"equal":{"range":[181,190]}}},{"diffOp":{"delete":{"range":[190,192]}}},{"diffOp":{"equal":{"range":[190,191]}}},{"diffOp":{"delete":{"range":[192,194]}}},{"diffOp":{"insert":{"range":[194,196]}}},{"diffOp":{"equal":{"range":[196,230]}}},{"diffOp":{"delete":{"range":[230,234]}}},{"diffOp":{"insert":{"range":[234,235]}}},{"diffOp":{"equal":{"range":[235,240]}}},{"diffOp":{"delete":{"range":[240,244]}}},{"diffOp":{"insert":{"range":[194,196]}}},{"diffOp":{"equal":{"range":[244,263]}}},{"diffOp":{"delete":{"range":[230,234]}}},{"diffOp":{"insert":{"range":[234,235]}}},{"diffOp":{"equal":{"range":[263,291]}}},{"diffOp":{"delete":{"range":[240,241]}}},{"diffOp":{"insert":{"range":[180,181]}}},{"diffOp":{"equal":{"range":[291,392]}}},{"equalLines":{"line_count":62}},{"diffOp":{"equal":{"range":[392,4