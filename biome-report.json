t only `asserted` may create an IN node and the model has an\n  // incentive to make everything look settled.\n  return {\n    variable,\n    value: canonical,\n    statement:\n      stringOf(decision[\"statement\"]).length > 0\n        ? stringOf(decision[\"statement\"])\n        : `Use ${canonical}`,\n    ...(stringOf(decision[\"yStatement\"]).length === 0\n      ? {}\n      : { yStatement: stringOf(decision[\"yStatement\"]) }),\n    ...(stringOf(decision[\"rationale\"]).length === 0\n      ? {}\n      : { rationale: stringOf(decision[\"rationale\"]) }),\n    ...(stringOf(decision[\"acceptedDownside\"]).length === 0\n      ? {}\n      : { acceptedDownside: stringOf(decision[\"acceptedDownside\"]) }),\n    origin: originOf(decision[\"origin\"]),\n    modality,\n    // Capped below the local rubric's ceiling: an unreviewed model claim is not\n    // worth as much as a cue plus a resolved variable plus a rationale clause.\n    confidence: asConfidence(Math.min(0.85, clamp(Number(decision[\"confidence\"] ?? 0.6)))),\n    snippet,\n    premiseRefs: refs,\n    alternativeRefs,\n    appliesTo: arrayOf(decision[\"appliesTo\"])\n      .map(String)\n      .filter((glob) => glob.includes(\"*\"))\n      .slice(0, 8),\n  };\n}\n\nfunction toPremise(\n  premise: LlmPremise,\n  _index: number,\n  request: ExtractionRequest,\n  raw: string,\n  engine: EngineId,\n): ExtractionResult[\"premises\"][number] | null {\n  const text = stringOf(premise[\"text\"]);\n  if (text.length === 0) return null;\n\n  const snippet = resolveSpan(request, raw, stringOf(premise[\"snippet\"]) || text);\n  if (snippet === null) return null;\n\n  const type: PremiseType = isPremiseType(premise[\"type\"])\n    ? (premise[\"type\"] as PremiseType)\n    : \"requirement\";\n  const predicate = canonicalPredicate(type, stringOf(premise[\"predicate\"]) || text);\n  void engine;\n\n  return {\n    type,\n    predicate,\n    ...(premise[\"value\"] === undefined || premise[\"value\"] === null\n      ? {}\n      