`run.ts` is imported by `table.ts`, and a\n * module that starts a fifteen-configuration study on import would run the study every time anything\n * read the table renderer. Side effects belong at the edge.\n */\n\nimport { banner, blank, heading, line, prepare, readArgs, write } from \"../cli\";\nimport { renderSuite, type ScoredRun } from \"../metrics\";\nimport { describeStudy, runAblation, type AblationStudy } from \"./run\";\nimport { renderAblationTable, renderPredictionAudit } from \"./table\";\nimport { describePlan, fullPlan } from \"./toggles\";\n\nasync function main(): Promise<void> {\n  const args = readArgs(process.argv.slice(2));\n  const { corpus: resolved, engineId } = prepare();\n\n  const plan = fullPlan();\n\n  banner(\"Ablation study ΓÇö \" + plan.length + \" configurations\");\n  line(describePlan(plan));\n  blank();\n  line(\"This runs the full corpus once per configuration, sequentially. Configurations are NOT run\");\n  line(\"concurrently: the harness mints ids from a counter and stamps learned time from a clock that\");\n  line(\"advances per call, and interleaving them would make deltas unattributable to the toggles.\");\n\n  const study = await runAblation(resolved, { engineId });\n\n  heading(\"Study\");\n  line(describeStudy(study));\n\n  heading(\"Delta table\");\n  line(renderAblationTable(study));\n\n  heading(\"Prediction audit\");\n  line(renderPredictionAudit(study));\n\n  if (args.has(\"out\")) {\n    const baseline = study.baseline;\n    write(\n      args.get(\"out\") ?? \"ablation-report.md\",\n      renderAblationMarkdown(study, baseline === null ? null : baseline.scored),\n    );\n  }\n\n  blank();\n  line(\"A delta is only meaningful against the baseline row. If the baseline threw, nothing below it means anything.\");\n}\n\nfunction renderAblationMarkdown(study: AblationStudy, baseline: ScoredRun | null): string {\n  const parts = [\n    \"# Ablation study\",\n    \"\",\n    \"Corpus \" + study.corpusVersion + \" ┬╖ engine \" + study.engine.kind +\n      (study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") + \" ┬╖ ran \" + study.ranAt,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",\n    \"delta always means the full system is better. Thresholds were declared in `toggles.ts` before any\",\n    \"configuration was run.\",\n    \"\",\n    \"```\",\n    describeStudy(study),\n    \"\",\n    renderAblationTable(study),\n    \"\",\n    renderPredictionAudit(study),\n    \"```\",\n    \"\",\n  ];\n\n  if (baseline !== null) {\n    parts.push(\"## Baseline metrics\", \"\", \"```\", renderSuite(baseline), \"```\", \"\");\n  }\n\n  return parts.join(\"\\n\");\n}\n\nmain().catch((error: unknown) => {\n  process.stderr.write(\"\\n\" + (error instanceof Error ? error.stack ?? error.message : String(error)) + \"\\n\");\n  process.exitCode = 1;\n});\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * `npm run eval:ablation` ΓÇö run every configuration and print the delta table plus the prediction audit.\n *  const parts = [\n    \"# Ablation study\",\n    \"\",\n    \"`Corpus \" +${study.corpusVersion + \"} ┬╖ engine \" + study.engine.kind +\n      (}${study.engine.model.length > 0 ? \"/\" + study.engine.model : \"\") +┬╖ ran study.ranAt}`,\n    \"\",\n    \"Every number below is (ablated ΓêÆ baseline), sign-flipped for false-positive rate so that a positive\",  process.exitCode = 1;\n});\n","ops":[{"diffOp":{"equal":{"r