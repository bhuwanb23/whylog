# ---------------------------------------------------------------------------
# WhyLog environment configuration
# ---------------------------------------------------------------------------
# EVERYTHING HERE IS OPTIONAL.
#
# The local engine (src/ai/local/) is the DEFAULT, not a fallback. The whole
# product -- extraction, premise invalidation, cascade, entrenchment, guards,
# export -- runs with no key and no network. That is verified by
# tests/integration/keyless.test.ts.
#
# Supplying a key upgrades exactly three things:
#   1. extraction quality   (Phase 1.10)
#   2. gate (b) recall      (Phase 2.4)
#   3. prose composition    (answers, export narrative, guard rationale)
#
# Keys live in localStorage at runtime. They are NEVER written into the event
# log and NEVER appear in an export. See src/store/settings.ts.
# ---------------------------------------------------------------------------

# local | openai | anthropic | openrouter
VITE_WHYLOG_ENGINE=local

VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-sonnet-4-5

VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Extraction: run the LLM n times and keep components present in >= 2 runs.
# ARGUS used exactly this because single-run consistency was imperfect
# (Krippendorff alpha 0.64-0.88). Costs n x tokens; measurable precision gain.
VITE_WHYLOG_EXTRACTION_VOTES=1

# Embedding dimensions for the local hashed n-gram vectoriser (Phase 3.1).
VITE_WHYLOG_EMBED_DIM=512

# Cascade depth cap (Phase 2.7). Beyond this the system reports
# "N more potentially affected" rather than flipping labels.
VITE_WHYLOG_CASCADE_DEPTH=4

# Backtracking depth bound (Phase 2.6).
VITE_WHYLOG_BACKTRACK_DEPTH=6

# Retrieval knobs (Phase 3.4 / 3.5).
VITE_WHYLOG_RRF_K=60
VITE_WHYLOG_RECALL_K=20
VITE_WHYLOG_RERANK_K=5
