l\\demo\\script.ts"},"span":[9453,9479],"sourceCode":"/**\n * The demo script ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * THE SCRIPT IS DATA, AND THE VERIFIER RUNS IT\n *\n * A demo script in a markdown file rots: the clicks stop matching the UI and nobody notices until the\n * rehearsal. Here the script is a typed list of beats, each with the view it happens in, the action\n * taken, what the audience should see, and the predicate that says whether it happened.\n *\n * `verify.ts` walks the same list. So the script that gets rehearsed, the script that gets checked and\n * the script that gets presented are one artefact, and a beat whose predicate fails is a beat that\n * cannot be delivered ΓÇö found before the room rather than in it.\n *\n * ---------------------------------------------------------------------------\n * FIVE MINUTES, AND THE PEAK IS GATE (c)\n *\n * The plan is explicit that the demo peak is premise invalidation, not contradiction detection. Beat 5\n * is where it lands and every earlier beat exists to make it legible: by the time the presenter says\n * \"nothing contradicted me\", the audience has already seen the decision, seen its premises, and seen a\n * transcript that never mentions databases.\n *\n * Contradiction detection is beat 3 and is deliberately underplayed. It is the thing every competitor\n * can do, and spending the demo's momentum on it would be spending it on the least defensible claim.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DemoKiller } from \"../hardening\";\n\nexport type ViewId =\n  | \"foundation\" | \"review\" | \"reasoning\" | \"ask\" | \"guards\" | \"export\"\n  | \"graph\" | \"timeline\" | \"health\" | \"time-machine\" | \"settings\";\n\nexport interface Beat {\n  readonly n: number;\n  readonly seconds: number;\n  readonly view: ViewId;\n  /** What the presenter does. One action per beat: a beat with two actions is two beats, and a script\n   *  that cannot be walked one step at a time cannot be recovered from mid-presentation. */\n  readonly action: string;\n  /** What the audience should see, in words a non-technical judge can follow. */\n  readonly expect: string;\n  /** The line to say. Written out rather than paraphrased, because the wording of the peak beat has\n   *  been chosen and improvising it loses the point. */\n  readonly say: string;\n  /** Machine-checkable. `verify.ts` evaluates it against the seeded graph. */\n  readonly check: CheckId;\n  /** Which demo-killer this beat would expose if it went wrong. Beats that expose none are marked\n   *  \"none\" and are the ones safe to cut if the demo is running long. */\n  readonly killer: DemoKiller[\"id\"] | \"none\";\n}\n\nexport type CheckId =\n  | \"seed-has-sqlite-decision\"\n  | \"seed-has-premises\"\n  | \"reversal-detected\"\n  | \"l2-unsound\"\n  | \"no-hypothetical-nodes\"\n  | \"guards-proposed-not-failing\"\n  | \"export-contains-decision\"\n  | \"answer-is-grounded\"\n  | \"graph-renders\"\n  | \"none\";\n\nexport const DEMO_SECONDS = 300;\n\nexport const SCRIPT: readonly Beat[] = [\n  {\n    n: 1,\n    seconds: 30,\n    view: \"foundation\",\n    action: \"Load the seed and show the SQLite decision with its premises expanded.\",\n    expect: \"A decision card reading 'Use SQLite, not Postgres' with two premises beneath it: single-user, and no deploy infrastructure.\",\n    say:\n      \"This is a decision an AI agent helped me make in October. Every tool that stores this stores the \" +\n      \"decision. Notice what is underneath it ΓÇö the assumptions it is true GIVEN. Nobody stores those.\",\n    check: \"seed-has-premises\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 2,\n    seconds: 30,\n    view: \"graph\",\n    action: \"Open the graph view and highlight the SQLite decision and its premise column.\",\n    expect: \"A bipartite lattice: premises in one column, decisions in another, edges from the SQLite decision to both of its premises.\",\n    say:\n      \"The graph is bipartite on purpose. Decisions on one side, assumptions on the other. The layout is \" +\n      \"deterministic ΓÇö same graph, same picture, every time ΓÇö because a diagram that moves between runs \" +\n      \"cannot be reasoned about.\",\n    check: \"graph-renders\",\n    killer: \"none\",\n  },\n  {\n    n: 3,\n    seconds: 40,\n    view: \"reasoning\",\n    action: \"Quick-log the reversal: 'actually let's switch to Postgres, we need concurrent writes'.\",\n    expect: \"A contradiction is raised between the new Postgres decision and the October SQLite decision, and the older one moves to superseded.\",\n    say:\n      \"Now I contradict myself. This is the part every tool can do ΓÇö you said SQLite, now you said \" +\n      \"Postgres, here is a red badge. It is worth about thirty seconds of your attention, because it is \" +\n      \"not why this exists.\",\n    check: \"reversal-detected\",\n    killer: \"none\",\n  },\n  {\n    n: 4,\n    seconds: 45,\n    view: \"foundation\",\n    action: \"Import the second fixture ΓÇö the November transcript ΓÇö and show that it never mentions databases.\",\n    expect: \"The transcript is imported and its decisions appear. None of them is about a database. Scroll the text to prove it: the word appears nowhere.\",\n    say:\n      \"Here is a transcript from a month later. Read it. There is no database decision in it. There is no \" +\n      \"argument about storage. The word Postgres does not appear. What it says is that there are now four \" +\n      \"people on the project and two of them edit decisions at the same time.\",\n    check: \"seed-has-sqlite-decision\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 5,\n    seconds: 60,\n    view: \"reasoning\",\n    action: \"Show the SQLite decision's label change to unsound, with the reason naming the falsified premise.\",\n    expect: \"The October SQLite decision is marked OUT, and the reason names the concurrent-writers exclusion ΓÇö a premise that was in the OUT-list of its justification.\",\n    say:\n      \"Nothing contradicted me. I never said the word database. The world moved, and the log noticed ΓÇö \" +\n      \"because the decision was stored with the assumption it rests on, and the assumption stopped \" +\n      \"holding. This is the whole product. Contradiction detection fires when you contradict yourself. \" +\n      \"This fires when reality does.\",\n    check: \"l2-unsound\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 6,\n    seconds: 35,\n    view: \"graph\",\n    action: \"Replay the cascade and show that decisions sharing no premise with the falsified one keep their labels.\",\n    expect: \"The cascade animation flips the SQLite decision and leaves unrelated decisions untouched. The survivors are visibly still IN.\",\n    say:\n      \"A cascade that retracts everything reachable is worse than no cascade. Watch what does NOT change: \" +\n      \"these decisions rest on other assumptions, so they keep their labels. Over-retraction is the \" +\n      \"failure mode that ends a tool like this, and it is the one we measure hardest.\",\n    check: \"no-hypothetical-nodes\",\n    killer: \"cascade-over-retraction\",\n  },\n  {\n    n: 7,\n    seconds: 30,\n    view: \"guards\",\n    action: \"Show the guards proposed for the Postgres decision, and the verify command compiled from them.\",\n    expect: \"A list of PROPOSED guards ΓÇö not installed ΓÇö with a copyable verify command.\",\n    say:\n      \"Every decision gets a check generated from it. Proposed, never auto-installed ΓÇö the system proposes \" +\n      \"and you dispose. Nobody in the fitness-function literature generates the check from the decision; \" +\n      \"it is always written by hand, which is why it is always stale.\",\n    check: \"guards-proposed-not-failing\",\n    killer: \"day-one-guard-failures\",\n  },\n  {\n    n: 8,\n    seconds: 30,\n    view: \"export\",\n    action: \"Export to CLAUDE.md and show the rejected-alternatives block and the consistency stamp.\",\n    expect: \"A CLAUDE.md with imperative MUST/MUST NOT rules scoped to globs, a rejected block, and a stamp whose digest covers the body.\",\n    say:\n      \"And it exports to what your agent actually reads ΓÇö CLAUDE.md, AGENTS.md, .cursorrules ΓÇö with the \" +\n      \"rejected alternatives in there too, so the agent does not re-propose Postgres in three weeks. \" +\n      \"Stamped, so you can tell whether the file matches the graph.\",\n    check: \"export-contains-decision\",\n    killer: \"none\",\n  },\n];\n\nexport function totalSeconds(script: readonly Beat[] = SCRIPT): number {\n  return script.reduce((sum, beat) => sum + beat.seconds, 0);\n}\n\n/** Beats safe to cut if the demo is running long, in cut order. None of them exposes a demo-killer,\n *  which is the criterion: a beat that could reveal a killer is not cuttable on stage. */\nexport function cuttableBeats(script: readonly Beat[] = SCRIPT): readonly Beat[] {\n  return script.filter((beat) => beat.killer === \"none\");\n}\n\nexport function renderScript(script: readonly Beat[] = SCRIPT): string {\n  const lines: string[] = [];\n\n  lines.push(\"DEMO SCRIPT ΓÇö \" + script.length + \" beats, \" + totalSeconds(script) + \"s (\" +\n    (totalSeconds(script) / 60).toFixed(1) + \" min)\");\n  lines.push(\"Cuttable if running long: \" + cuttableBeats(script).map((beat) => \"beat \" + beat.n).join(\", \"));\n  lines.push(\"\");\n\n  for (const beat of script) {\n    lines.push(\"BEAT \" + beat.n + \" ┬╖ \" + beat.seconds + \"s ┬╖ \" + beat.view + \" ┬╖ check: \" + beat.check +\n      (beat.killer === \"none\" ? \"\" : \" ┬╖ exposes: \" + beat.killer));\n    lines.push(\"  DO:     \" + beat.action);\n    lines.push(\"  SEE:    \" + beat.expect);\n    lines.push(\"  SAY:    \" + beat.say);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The demo script ΓÇö 7.5.\n *    lines.push(\"  DO:     \" + beat.action);\n    lines.push(\"  SEE:    \" + beat.expect);\n    lines.push(\"`  SAY:    \" + ${beat.say}`);\n    lines.push(\"\");\n  }  return lines.join(\"\\n\");\n}\n","ops":[{"diffOp":{"equal":{"range":[0,34]}}},{"equalLines":{"line_count":193}},{"diffOp":{"equal":{"range":[34,137]}}},{"diffOp":{"delete":{"range":[137,138]}}},{"diffOp":{"insert":{"range":[138,139]}}},{"diffOp":{"equal":{"range":[139,149]}}},{"diffOp":{"delete":{"range":[149,153]}}},{"diffOp":{"insert":{"range":[153,155]}}},{"diffOp":{"equal":{"range":[155,163]}}},{"diffOp":{"insert":{"range":[163,165]}}},{"diffOp":{"equal":{"range":[165,191]}}},{"equalLines":{"line_count":1}},{"diffOp":{"equal":{"range":[191,220]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\script.ts"},"span":[9497,9520],"sourceCode":"/**\n * The demo script ΓÇö 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * THE SCRIPT IS DATA, AND THE VERIFIER RUNS IT\n *\n * A demo script in a markdown file rots: the clicks stop matching the UI and nobody notices until the\n * rehearsal. Here the script is a typed list of beats, each with the view it happens in, the action\n * taken, what the audience should see, and the predicate that says whether it happened.\n *\n * `verify.ts` walks the same list. So the script that gets rehearsed, the script that gets checked and\n * the script that gets presented are one artefact, and a beat whose predicate fails is a beat that\n * cannot be delivered ΓÇö found before the room rather than in it.\n *\n * ---------------------------------------------------------------------------\n * FIVE MINUTES, AND THE PEAK IS GATE (c)\n *\n * The plan is explicit that the demo peak is premise invalidation, not contradiction detection. Beat 5\n * is where it lands and every earlier beat exists to make it legible: by the time the presenter says\n * \"nothing contradicted me\", the audience has already seen the decision, seen its premises, and seen a\n * transcript that never mentions databases.\n *\n * Contradiction detection is beat 3 and is deliberately underplayed. It is the thing every competitor\n * can do, and spending the demo's momentum on it would be spending it on the least defensible claim.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DemoKiller } from \"../hardening\";\n\nexport type ViewId =\n  | \"foundation\" | \"review\" | \"reasoning\" | \"ask\" | \"guards\" | \"export\"\n  | \"graph\" | \"timeline\" | \"health\" | \"time-machine\" | \"settings\";\n\nexport interface Beat {\n  readonly n: number;\n  readonly seconds: number;\n  readonly view: ViewId;\n  /** What the presenter does. One action per beat: a beat with two actions is two beats, and a script\n   *  that cannot be walked one step at a time cannot be recovered from mid-presentation. */\n  readonly action: string;\n  /** What the audience should see, in words a non-technical judge can follow. */\n  readonly expect: string;\n  /** The line to say. Written out rather than paraphrased, because the wording of the peak beat has\n   *  been chosen and improvising it loses the point. */\n  readonly say: string;\n  /** Machine-checkable. `verify.ts` evaluates it against the seeded graph. */\n  readonly check: CheckId;\n  /** Which demo-killer this beat would expose if it went wrong. Beats that expose none are marked\n   *  \"none\" and are the ones safe to cut if the demo is running long. */\n  readonly killer: DemoKiller[\"id\"] | \"none\";\n}\n\nexport type CheckId =\n  | \"seed-has-sqlite-decision\"\n  | \"seed-has-premises\"\n  | \"reversal-detected\"\n  | \"l2-unsound\"\n  | \"no-hypothetical-nodes\"\n  | \"guards-proposed-not-failing\"\n  | \"export-contains-decision\"\n  | \"answer-is-grounded\"\n  | \"graph-renders\"\n  | \"none\";\n\nexport const DEMO_SECONDS = 300;\n\nexport const SCRIPT: readonly Beat[] = [\n  {\n    n: 1,\n    seconds: 30,\n    view: \"foundation\",\n    action: \"Load the seed and show the SQLite decision with its premises expanded.\",\n    expect: \"A decision card reading 'Use SQLite, not Postgres' with two premises beneath it: single-user, and no deploy infrastructure.\",\n    say:\n      \"This is a decision an AI agent helped me make in October. Every tool that stores this stores the \" +\n      \"decision. Notice what is underneath it ΓÇö the assumptions it is true GIVEN. Nobody stores those.\",\n    check: \"seed-has-premises\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 2,\n    seconds: 30,\n    view: \"graph\",\n    action: \"Open the graph view and highlight the SQLite decision and its premise column.\",\n    expect: \"A bipartite lattice: premises in one column, decisions in another, edges from the SQLite decision to both of its premises.\",\n    say:\n      \"The graph is bipartite on purpose. Decisions on one side, assumptions on the other. The layout is \" +\n      \"deterministic ΓÇö same graph, same picture, every time ΓÇö because a diagram that moves between runs \" +\n      \"cannot be reasoned about.\",\n    check: \"graph-renders\",\n    killer: \"none\",\n  },\n  {\n    n: 3,\n    seconds: 40,\n    view: \"reasoning\",\n    action: \"Quick-log the reversal: 'actually let's switch to Postgres, we need concurrent writes'.\",\n    expect: \"A contradiction is raised between the new Postgres decision and the October SQLite decision, and the older one moves to superseded.\",\n    say:\n      \"Now I contradict myself. This is the part every tool can do ΓÇö you said SQLite, now you said \" +\n      \"Postgres, here is a red badge. It is worth about thirty seconds of your attention, because it is \" +\n      \"not why this exists.\",\n    check: \"reversal-detected\",\n    killer: \"none\",\n  },\n  {\n    n: 4,\n    seconds: 45,\n    view: \"foundation\",\n    action: \"Import the second fixture ΓÇö the November transcript ΓÇö and show that it never mentions databases.\",\n    expect: \"The transcript is imported and its decisions appear. None of them is about a database. Scroll the text to prove it: the word appears nowhere.\",\n    say:\n      \"Here is a transcript from a month later. Read it. There is no database decision in it. There is no \" +\n      \"argument about storage. The word Postgres does not appear. What it says is that there are now four \" +\n      \"people on the project and two of them edit decisions at the same time.\",\n    check: \"seed-has-sqlite-decision\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 5,\n    seconds: 60,\n    view: \"reasoning\",\n    action: \"Show the SQLite decision's label change to unsound, with the reason naming the falsified premise.\",\n    expect: \"The October SQLite decision is marked OUT, and the reason names the concurrent-writers exclusion ΓÇö a premise that was in the OUT-list of its justification.\",\n    say:\n      \"Nothing contradicted me. I never said the word database. The world moved, and the log noticed ΓÇö \" +\n      \"because the decision was stored with the assumption it rests on, and the assumption stopped \" +\n      \"holding. This is the whole product. Contradiction detection fires when you contradict yourself. \" +\n      \"This fires when reality does.\",\n    check: \"l2-unsound\",\n    killer: \"false-premise-resolution\",\n  },\n  {\n    n: 6,\n    seconds: 35,\n    view: \"graph\",\n    action: \"Replay the cascade and show that decisions sharing no premise with the falsified one keep their labels.\",\n    expect: \"The cascade animation flips the SQLite decision and leaves unrelated decisions untouched. The survivors are visibly still IN.\",\n    say:\n      \"A cascade that retracts everything reachable is worse than no cascade. Watch what does NOT change: \" +\n      \"these decisions rest on other assumptions, so they keep their labels. Over-retraction is the \" +\n      \"failure mode that ends a tool like this, and it is the one we measure hardest.\",\n    check: \"no-hypothetical-nodes\",\n    killer: \"cascade-over-retraction\",\n  },\n  {\n    n: 7,\n    seconds: 30,\n    view: \"guards\",\n    action: \"Show the guards proposed for the Postgres decision, and the verify command compiled from them.\",\n    expect: \"A list of PROPOSED guards ΓÇö not installed ΓÇö with a copyable verify command.\",\n    say:\n      \"Every decision gets a check generated from it. Proposed, never auto-installed ΓÇö the system proposes \" +\n      \"and you dispose. Nobody in the fitness-function literature generates the check from the decision; \" +\n      \"it is always written by hand, which is why it is always stale.\",\n    check: \"guards-proposed-not-failing\",\n    killer: \"day-one-guard-failures\",\n  },\n  {\n    n: 8,\n    seconds: 30,\n    view: \"export\",\n    action: \"Export to CLAUDE.md and show the rejected-alternatives block and the consistency stamp.\",\n    expect: \"A CLAUDE.md with imperative MUST/MUST NOT rules scoped to globs, a rejected block, and a stamp whose digest covers the body.\",\n    say:\n      \"And it exports to what your agent actually reads ΓÇö CLAUDE.md, AGENTS.md, .cursorrules ΓÇö with the \" +\n      \"rejected alternatives in there too, so the agent does not re-propose Postgres in three weeks. \" +\n      \"Stamped, so you can tell whether the file matches the graph.\",\n    check: \"export-contains-decision\",\n    killer: \"none\",\n  },\n];\n\nexport function totalSeconds(script: readonly Beat[] = SCRIPT): number {\n  return script.reduce((sum, beat) => sum + beat.seconds, 0);\n}\n\n/** Beats safe to cut if the demo is running long, in cut order. None of them exposes a demo-killer,\n *  which is the criterion: a beat that could reveal a killer is not cuttable on stage. */\nexport function cuttableBeats(script: readonly Beat[] = SCRIPT): readonly Beat[] {\n  return script.filter((beat) => beat.killer === \"none\");\n}\n\nexport function renderScript(script: readonly Beat[] = SCRIPT): string {\n  const lines: string[] = [];\n\n  lines.push(\"DEMO SCRIPT ΓÇö \" + script.length + \" beats, \" + totalSeconds(script) + \"s (\" +\n    (totalSeconds(script) / 60).toFixed(1) + \" min)\");\n  lines.push(\"Cuttable if running long: \" + cuttableBeats(script).map((beat) => \"beat \" + beat.n).join(\", \"));\n  lines.push(\"\");\n\n  for (const beat of script) {\n    lines.push(\"BEAT \" + beat.n + \" ┬╖ \" + beat.seconds + \"s ┬╖ \" + beat.view + \" ┬╖ check: \" + beat.check +\n      (beat.killer === \"none\" ? \"\" : \" ┬╖ exposes: \" + beat.killer));\n    lines.push(\"  DO:     \" + beat.action);\n    lines.push(\"  SEE:    \" + beat.expect);\n    lines.push(\"  SAY:    \" + beat.say);\n    lines.push(\"\");\n  }\n\n  return lines.join(\"\\n\");\n}\n"},"tags":["fixable"],"source":null},{"category":"format","severity":"error","description":"Formatter would have printed the following content:","message":[{"elements":[],"content":"Formatter would have printed the following content:"}],"advices":{"advices":[{"diff":{"dictionary":"/**\n * The ground-truth label schema ΓÇö 7.1.\n *}\n\nexport interface ResolvedTranscript \n  extends Omit<LabelledTranscript, \"decisions\" | \"premises\" | \"alternatives\"> {\n  readonly raw: string;\n  readonly decisions: readonly ResolvedDecision[];  readonly transcripts: readonly ResolvedTranscript[];\n}\n","ops":[{"diffOp":{"equal":{"range":[0,48]}}},{"equalLines":{"line_count":327}},{"diffOp":{"equal":{"range":[48,86]}}},{"diffOp":{"delete":{"range":[86,87]}}},{"diffOp":{"insert":{"range":[87,90]}}},{"diffOp":{"equal":{"range":[90,242]}}},{"equalLines":{"line_count":8}},{"diffOp":{"equal":{"range":[242,299]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\corpus\\labels.ts"},"span":null,"sourceCode":"/**\n * The ground-truth label schema ΓÇö 7.1.\n *\n * Phase 7 ┬╖ sub-phase 7.1\n * Plan: plan/phase-7-evaluation.md ┬º7.1\n *\n * ---------------------------------------------------------------------------\n * LABEL FROM THE TRANSCRIPT, NOT FROM THE EXTRACTOR OUTPUT\n *\n * The plan names the bias risk directly: \"you labelled what your extractor finds\". The defence is\n * procedural and it is written into this schema ΓÇö a label records what the TRANSCRIPT says, with the\n * character span it was read from, and the span is verifiable against the source text. A label that\n * cannot be pointed at in the transcript is not a label.\n *\n * That is why `quote` is required on every labelled item and is VERBATIM. The loader resolves each\n * quote to a character span by searching the raw transcript, and REJECTS the label if the quote is\n * not a literal substring. That is strictly stronger than a hand-typed offset: an offset can point\n * at the wrong characters and still look plausible, while a quote that is not in the text cannot be\n * resolved at all. It makes label-from-output structurally harder, because you cannot quote a\n * decision the transcript does not contain.\n *\n * It is also the same discipline Phase 1 imposes on LLM-extracted snippets, applied to the ground\n * truth. If the labels were held to a weaker standard than the extractor, the benchmark would be\n * measuring the extractor against something less rigorous than itself.\n *\n * ---------------------------------------------------------------------------\n * THE PLANTED CASES ARE FIRST-CLASS, NOT ANNOTATIONS\n *\n * `plants` declares what was deliberately put into each transcript and what a correct system should\n * do about it. Three contradiction levels, plus the five special cases. Each has an `expect` field\n * naming the outcome, so the harness asserts against a declared expectation rather than against\n * whatever the system happened to produce.\n *\n * This is the part nobody else has: a benchmark for decision-rationale extraction does not exist in\n * the literature, and the L2/L3 levels cannot be built at all without a system that stores premises.\n * ---------------------------------------------------------------------------\n */\n\nimport type { DecisionVariable, PremiseType } from \"@/types/domain\";\n\nexport type CorpusTier = \"clean\" | \"messy\" | \"adversarial\";\n\n/** A labelled decision, as the transcript states it. */\nexport interface LabelledDecision {\n  /** Local to the transcript, e.g. \"d1\". Mapped to a WLD id by the harness. */\n  readonly key: string;\n  readonly variable: DecisionVariable;\n  readonly value: string;\n  readonly statement: string;\n  /** asserted / hypothetical / conditional / reported / question. Only `asserted` should ever\n   *  become a node ΓÇö that is what modality precision measures. */\n  readonly modality: \"asserted\" | \"hypothetical\" | \"conditional\" | \"reported\" | \"question\";\n  /** positive or negative polarity, for the \"not X\" constructions. */\n  readonly polarity: \"positive\" | \"negative\";\n  readonly origin: \"human_stated\" | \"human_override\" | \"agent_proposed\" | \"agent_inferred\";\n  /** VERBATIM text from the transcript. REQUIRED. The loader resolves it to a character span and\n   *  rejects the label if it is not a literal substring ΓÇö see the header. */\n  readonly quote: string;\n  /** The premises this decision rests on, by local key. */\n  readonly restsOn: readonly string[];\n  /** The conditions it excludes ΓÇö the OUT-list. */\n  readonly excludes: readonly string[];\n  /** Should this become a decision node at all? False for hypotheticals and agent proposals the\n   *  human never accepted. */\n  readonly expectNode: boolean;\n}\n\nexport interface LabelledPremise {\n  readonly key: string;\n  readonly type: PremiseType;\n  readonly predicate: string;\n  readonly value?: string | number | boolean;\n  readonly text: string;\n  /** VERBATIM text from the transcript. REQUIRED ΓÇö see the header. */\n  readonly quote: string;\n  /** True when the transcript states it as a fact, false when it is only mentioned. */\n  readonly expectInList: boolean;\n}\n\nexport interface LabelledAlternative {\n  readonly key: string;\n  readonly value: string;\n  readonly whyRejected: string | null;\n  readonly rejectedBy: string;\n  /** VERBATIM text from the transcript. REQUIRED ΓÇö see the header. */\n  readonly quote: string;\n  /** Alternatives require explicit human confirmation before entering the pre-emption index, so a\n   *  label records whether the transcript actually contains a rejection rather than a mention. */\n  readonly expectConfirmed: boolean;\n}\n\nexport interface LabelledEpisode {\n  readonly index: number;\n  readonly title: string;\n  readonly firstLine: number;\n  readonly lastLine: number;\n}\n\n/* -------------------------------------------------------------------------- */\n/* Planted cases                                                              */\n/* -------------------------------------------------------------------------- */\n\nexport type PlantLevel = \"L1-pairwise\" | \"L2-premise\" | \"L3-cascade\";\n\nexport type PlantKind =\n  | PlantLevel\n  | \"circular-justification\"\n  | \"M1-similar-decisions-contradictory-rationales\"\n  | \"M2-contradictory-decisions-similar-rationales\"\n  | \"duplicate-restatement\"\n  | \"unanswerable-question\";\n\n/**\n * One deliberately planted case.\n *\n * `expect` is the outcome a correct system produces, stated before the run. The harness compares\n * against this, so a result is a pass or a fail rather than an observation.\n */\nexport interface Plant {\n  readonly kind: PlantKind;\n  readonly id: string;\n  /** What was planted, in one sentence. */\n  readonly description: string;\n  /** The transcripts involved, by corpus id. */\n  readonly transcripts: readonly string[];\n  /** What a correct system does. */\n  readonly expect: string;\n  /** The node ids expected to flip, and the ones expected to survive. Both are asserted ΓÇö a\n   *  cascade that flips the right nodes and also flips a survivor is a FAILURE, and checking only\n   *  the flips would pass it. */\n  readonly expectUnsound: readonly string[];\n  readonly expectSurvivors: readonly string[];\n  /**\n   * What the harness must DO to this graph once every transcript is imported.\n   *\n   * Absent for most plants. Present for the ones whose whole point is a reaction to an event rather\n   * than a state: L2 and L3 are not \"the corpus contains a contradiction\", they are \"the corpus\n   * contains a premise, and when that premise is falsified the graph must respond in a specific way\".\n   *\n   * Declaring the intervention as DATA rather than as harness code is what keeps the plant readable\n   * next to its expectation. A reader looking at `expectUnsound: [\"l03/d1\"]` can see two lines above\n   * exactly what was done to provoke it, and can check that the expectation is the right one.\n   *\n   * The premise is named by transcript and PREDICATE, not by label key, because the harness has to\n   * find the node in the graph it actually built ΓÇö and if extraction never produced that premise, the\n   * intervention cannot be applied. That is recorded as an unapplied intervention and scored as a\n   * failure of the plant, which is the honest reading: the cascade cannot be measured on a premise the\n   * system never extracted.\n   */\n  readonly falsify?: readonly FalsifyStep[];\n}\n\n/** One intervention: find the premise with this predicate in this transcript, and falsify it. */\nexport interface FalsifyStep {\n  /** Corpus transcript id. */\n  readonly transcript: string;\n  /** Namespaced predicate, e.g. \"scale.max_users\". Matched against the graph, not the labels. */\n  readonly predicate: string;\n  /** The human-readable reason recorded on the event. STATE_CHANGING_EVENTS require a non-empty\n   *  reason, and an eval harness is not exempt from the invariant it is measuring. */\n  readonly reason: string;\n}\n\n/* -------------------------------------------------------------------------- */\n/* The transcript record                                                      */\n/* -------------------------------------------------------------------------- */\n\nexport interface LabelledTranscript {\n  readonly id: string;\n  readonly tier: CorpusTier;\n  /** Path relative to the repo root. */\n  readonly file: string;\n  /** What this transcript is for, in one line. */\n  readonly purpose: string;\n  readonly decisions: readonly LabelledDecision[];\n  readonly premises: readonly LabelledPremise[];\n  readonly alternatives: readonly LabelledAlternative[];\n  readonly episodes: readonly LabelledEpisode[];\n  /** The plants this transcript participates in. */\n  readonly plants: readonly string[];\n  /** Valid time of the conversation. The timeline orders by this, so a corpus without it cannot\n   *  test ordering at all. */\n  readonly occurredAt: string;\n}\n\n/** A question with a known answer status, for the retrieval and groundedness metrics. */\nexport interface LabelledQuestion {\n  readonly id: string;\n  readonly question: string;\n  /** The decisions a correct retrieval should surface. Empty means the question is UNANSWERABLE\n   *  from this corpus, which is itself a labelled case ΓÇö ┬º7.1 plants one deliberately. */\n  readonly relevant: readonly string[];\n  readonly expectVerdict: \"GROUNDED\" | \"PARTIAL\" | \"INSUFFICIENT_EVIDENCE\";\n}\n\n/** The whole corpus. Versioned, so a metric result is always tied to the labels it was scored\n *  against ΓÇö a corpus that changes silently makes every published number meaningless. */\nexport interface Corpus {\n  readonly version: string;\n  readonly transcripts: readonly LabelledTranscript[];\n  readonly questions: readonly LabelledQuestion[];\n  readonly plants: readonly Plant[];\n}\n\n/* -------------------------------------------------------------------------- */\n/* Composition                                                                */\n/* -------------------------------------------------------------------------- */\n\nexport interface CorpusComposition {\n  readonly total: number;\n  readonly clean: number;\n  readonly messy: number;\n  readonly adversarial: number;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly alternatives: number;\n  readonly plants: number;\n  readonly plantsByKind: Readonly<Record<string, number>>;\n}\n\nexport function compositionOf(corpus: Corpus): CorpusComposition {\n  const plantsByKind: Record<string, number> = {};\n  for (const plant of corpus.plants) {\n    plantsByKind[plant.kind] = (plantsByKind[plant.kind] ?? 0) + 1;\n  }\n\n  return {\n    total: corpus.transcripts.length,\n    clean: corpus.transcripts.filter((t) => t.tier === \"clean\").length,\n    messy: corpus.transcripts.filter((t) => t.tier === \"messy\").length,\n    adversarial: corpus.transcripts.filter((t) => t.tier === \"adversarial\").length,\n    decisions: corpus.transcripts.reduce((total, t) => total + t.decisions.length, 0),\n    premises: corpus.transcripts.reduce((total, t) => total + t.premises.length, 0),\n    alternatives: corpus.transcripts.reduce((total, t) => total + t.alternatives.length, 0),\n    plants: corpus.plants.length,\n    plantsByKind,\n  };\n}\n\n/**\n * The corpus, described honestly.\n *\n * The plan's own mitigation for \"corpus too small to be credible\" is to state the size, state the\n * limitation, and publish the corpus so others can extend it. This is that statement, generated\n * from the data rather than written by hand, so it cannot drift from what is actually there.\n */\nexport function describeCorpus(corpus: Corpus): string {\n  const c = compositionOf(corpus);\n\n  const lines = [\n    \"DecisionMemEval v\" + corpus.version + \" ΓÇö \" + c.total + \" transcript(s)\",\n    \"\",\n    \"  clean          \" + c.clean,\n    \"  messy          \" + c.messy,\n    \"  adversarial    \" + c.adversarial,\n    \"\",\n    \"  labelled decisions      \" + c.decisions,\n    \"  labelled premises       \" + c.premises,\n    \"  labelled alternatives   \" + c.alternatives,\n    \"  planted cases           \" + c.plants,\n    \"  labelled questions      \" + corpus.questions.length,\n  ];\n\n  if (Object.keys(c.plantsByKind).length > 0) {\n    lines.push(\"\");\n    lines.push(\"Planted cases by kind:\");\n    for (const [kind, count] of Object.entries(c.plantsByKind)) {\n      lines.push(\"  \" + kind.padEnd(46) + count);\n    }\n  }\n\n  lines.push(\"\");\n  lines.push(\"LIMITATION, stated because the plan says to: this corpus is hand-labelled by the\");\n  lines.push(\"author of the extractor. Labels were written from the transcripts and every one\");\n  lines.push(\"carries a character span verifiable against the source, which is the procedural\");\n  lines.push(\"defence against labelling what the extractor finds ΓÇö but it is a defence, not a\");\n  lines.push(\"cure. An independent labeller would be the cure, and there is not one.\");\n\n  return lines.join(\"\\n\");\n}\n\n/* -------------------------------------------------------------------------- */\n/* Resolved labels                                                            */\n/* -------------------------------------------------------------------------- */\n\n/**\n * A label after the loader resolved its quote to a character span.\n *\n * Separate from the authored label because the span is DERIVED, not written: the author supplies\n * verbatim text and the loader computes offsets. Keeping the two shapes apart means a hand-written\n * offset cannot sneak in, and a label whose quote does not appear in the transcript cannot be\n * silently scored as a match at offset zero.\n */\nexport interface ResolvedDecision extends Omit<LabelledDecision, \"quote\"> {\n  readonly quote: string;\n  readonly span: { readonly start: number; readonly end: number };\n  /** The corpus id of the transcript this label belongs to.\n   *\n   * Carried on the label rather than looked up later because the resolver that bridges corpus keys\n   * (\"l03/d1\") to runtime ids (WLD-0007) needs both halves of the key, and an alignment pair hands it\n   * a label and a node with no transcript in scope. Searching every transcript for the label would be\n   * quadratic inside a loop that already runs per metric, and would silently return the wrong\n   * transcript if the same label object ever appeared twice. */\n  readonly transcript: string;\n}\n\nexport interface ResolvedPremise extends Omit<LabelledPremise, \"quote\"> {\n  readonly quote: string;\n  readonly span: { readonly start: number; readonly end: number };\n  /** The corpus id of the transcript this label belongs to.\n   *\n   * Carried on the label rather than looked up later because the resolver that bridges corpus keys\n   * (\"l03/d1\") to runtime ids (WLD-0007) needs both halves of the key, and an alignment pair hands it\n   * a label and a node with no transcript in scope. Searching every transcript for the label would be\n   * quadratic inside a loop that already runs per metric, and would silently return the wrong\n   * transcript if the same label object ever appeared twice. */\n  readonly transcript: string;\n}\n\nexport interface ResolvedAlternative extends Omit<LabelledAlternative, \"quote\"> {\n  readonly quote: string;\n  readonly span: { readonly start: number; readonly end: number };\n  /** The corpus id of the transcript this label belongs to.\n   *\n   * Carried on the label rather than looked up later because the resolver that bridges corpus keys\n   * (\"l03/d1\") to runtime ids (WLD-0007) needs both halves of the key, and an alignment pair hands it\n   * a label and a node with no transcript in scope. Searching every transcript for the label would be\n   * quadratic inside a loop that already runs per metric, and would silently return the wrong\n   * transcript if the same label object ever appeared twice. */\n  readonly transcript: string;\n}\n\nexport interface ResolvedTranscript extends Omit<LabelledTranscript, \"decisions\" | \"premises\" | \"alternatives\"> {\n  readonly raw: string;\n  readonly decisions: readonly ResolvedDecision[];\n  readonly premises: readonly ResolvedPremise[];\n  readonly alternatives: readonly ResolvedAlternative[];\n  /** Labels whose quote could not be found in the transcript. Reported, never dropped: a label that\n   *  silently vanishes would lower recall for a reason nobody can see. */\n  readonly unresolved: readonly { kind: string; key: string; quote: string }[];\n}\n\nexport interface ResolvedCorpus extends Omit<Corpus, \"transcripts\"> {\n  readonly transcripts: readonly ResolvedTranscript[];\n}\n"},"tags":[],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *\n  if (loaded.missingFiles.length > 0) {\n    warnings.push(`${loaded.missingFiles.length + \"} corpus file(s) missing: \" + ${loaded.missingFiles.join(\", \")}`);\n  }\n  if (loaded.unresolved.length > 0) {  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n","ops":[{"diffOp":{"equal":{"range":[0,63]}}},{"equalLines":{"line_count":67}},{"diffOp":{"equal":{"range":[63,122]}}},{"diffOp":{"insert":{"range":[122,125]}}},{"diffOp":{"equal":{"range":[125,151]}}},{"diffOp":{"delete":{"range":[151,155]}}},{"diffOp":{"insert":{"range":[155,156]}}},{"diffOp":{"equal":{"range":[156,181]}}},{"diffOp":{"delete":{"range":[181,185]}}},{"diffOp":{"insert":{"range":[185,187]}}},{"diffOp":{"equal":{"range":[187,217]}}},{"diffOp":{"insert":{"range":[217,219]}}},{"diffOp":{"equal":{"range":[219,263]}}},{"equalLines":{"line_count":94}},{"diffOp":{"equal":{"range":[263,406]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\kit.ts"},"span":[3438,3527],"sourceCode":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THE SEED STATE IS BUILT, NOT CHECKED IN\n *\n * A demo needs to start from a known graph. The obvious implementation is a JSON dump of a graph\n * committed to the repo. That is wrong here for a specific reason: a checked-in state is a snapshot of\n * whatever the extraction pipeline produced on the day it was saved, and the moment extraction changes\n * the demo is showing the audience a graph the product no longer builds. The presenter would be\n * describing behaviour the code does not have.\n *\n * So the seed is BUILT at load time from the two demo fixtures through the real pipeline. It is slower\n * by a second or two and it cannot drift. A demo that shows the shipping code path is worth two seconds.\n *\n * ---------------------------------------------------------------------------\n * RESET IS A WIPE, NOT AN UNDO\n *\n * One-click reset clears every WhyLog storage key and rebuilds the seed. It does not attempt to reverse\n * the events of a live demo, because invariant I1 says nothing is deleted ΓÇö an undo would have to\n * rewrite the log, and a demo that rewrites its own hash chain in front of an audience is a demo that\n * has just contradicted its first claim.\n * ---------------------------------------------------------------------------\n */\n\nimport { createLocalEngine, localEngineId } from \"@/ai/local\";\nimport { nowISO } from \"@/lib/format\";\nimport { appendBatch, emptyLog, fold, type EventLog } from \"@/substrate\";\nimport { STORAGE_KEYS } from \"./keys\";\nimport type { EngineId, ISODateString } from \"@/types/common\";\nimport type { GraphState } from \"@/substrate/graph-state\";\n\n/** The storage keys a reset must clear. Listed here rather than scattered, because a reset that misses\n *  one key leaves the next demo starting from the previous one's state ΓÇö the failure is invisible until\n *  the presenter is three beats in and the graph has nodes nobody imported. */\nexport const RESET_KEYS: readonly string[] = STORAGE_KEYS;\n\nexport interface SeedResult {\n  readonly log: EventLog;\n  readonly state: GraphState;\n  readonly engineId: EngineId;\n  readonly builtAt: ISODateString;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly durationMs: number;\n  /** Anything that went wrong while building. A seed that built with warnings still loads, and the\n   *  presenter needs to know before the demo rather than discovering it on stage. */\n  readonly warnings: readonly string[];\n}\n\n/**\n * Build the seed graph from the demo fixtures through the real pipeline.\n *\n * Delegates to the eval harness rather than reimplementing an import path, because two import paths\n * would eventually disagree and the demo would be exercising the one the metrics do not measure.\n */\nexport async function buildSeed(): Promise<SeedResult> {\n  const started = Date.now();\n  const engine = createLocalEngine();\n  const engineId = localEngineId();\n  const warnings: string[] = [];\n\n  const { corpus, CORPUS_ROOT } = await import(\"../corpus/data\");\n  const { loadCorpus } = await import(\"../corpus/loader\");\n  const { runConfig } = await import(\"../harness\");\n  const { FULL, DEFAULT_PARAMS } = await import(\"../ablation/toggles\");\n\n  const loaded = loadCorpus(corpus, CORPUS_ROOT);\n\n  if (loaded.missingFiles.length > 0) {\n    warnings.push(loaded.missingFiles.length + \" corpus file(s) missing: \" + loaded.missingFiles.join(\", \"));\n  }\n  if (loaded.unresolved.length > 0) {\n    warnings.push(loaded.unresolved.length + \" corpus label(s) do not resolve ΓÇö the seed will still build, but the metrics would not be trustworthy.\");\n  }\n\n  /* Only the two demo fixtures are seeded. The full twelve-transcript corpus produces a graph too large\n   * to walk an audience through in five minutes, and the demo's job is the L1 reversal and the L2\n   * premise invalidation, both of which live entirely in these two files. */\n  const demoOnly = {\n    ...loaded.corpus,\n    transcripts: loaded.corpus.transcripts.filter((transcript) =>\n      transcript.id === \"demo1\" || transcript.id === \"demo2\",\n    ),\n    questions: loaded.corpus.questions.filter((question) => question.id === \"q1\" || question.id === \"q8\"),\n    plants: loaded.corpus.plants.filter((plant) =>\n      plant.id === \"L1-sqlite\" || plant.id === \"L2-premise-falsified\",\n    ),\n  };\n\n  const run = await runConfig(demoOnly, {\n    id: \"demo-seed\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  for (const entry of run.transcripts) {\n    if (!entry.ok) warnings.push(\"fixture \" + entry.transcript.id + \" failed to import: \" + (entry.failure ?? \"unknown\"));\n  }\n\n  return {\n    log: rebuildLog(run),\n    state: run.state,\n    engineId,\n    builtAt: nowISO(),\n    decisions: run.state.decisions.size,\n    premises: run.state.premises.size,\n    durationMs: Date.now() - started,\n    warnings,\n  };\n}\n\n/**\n * The event log behind a completed run.\n *\n * The harness keeps its log local and returns only the folded state, because metrics score states. The\n * demo needs the log too, since the app persists and replays events rather than snapshots ΓÇö so it is\n * reconstructed by re-folding the state's own event list, which is authoritative and hash-chained.\n */\nfunction rebuildLog(run: { state: GraphState }): EventLog {\n  const log = emptyLog();\n  const appended = appendBatch(\n    log,\n    run.state.events.map((event) => ({\n      draft: { type: event.type, payload: event.payload, actor: event.actor, reason: event.reason },\n      context: { now: event.at, actor: event.actor, reason: event.reason, occurredAt: event.occurredAt },\n    })),\n  );\n\n  /* Re-appending sealed events re-mints ids and re-stamps times, so the chain will not match the\n   * original. That is acceptable for a seed ΓÇö the app reseals on import via `substrate/portability.ts`,\n   * which is the supported path for bringing an external log in ΓÇö but it is not acceptable to pretend\n   * otherwise, so the reconstruction folds rather than claiming to restore. */\n  return appended.ok ? appended.log : fold(run.state.events, { engine: run.state.computedAt ? localEngineId() : localEngineId(), now: nowISO() }) && emptyLog();\n}\n\n/**\n * One-click reset.\n *\n * Clears every WhyLog key and reports what it cleared. Idempotent: resetting twice is the same as\n * resetting once, which matters because a presenter who is unsure whether the reset landed will press it\n * again, and a reset that compounds would be worse than none.\n */\nexport function resetDemo(storage: Storage | null): { cleared: readonly string[]; available: boolean } {\n  if (storage === null) return { cleared: [], available: false };\n\n  const cleared: string[] = [];\n  for (const key of RESET_KEYS) {\n    if (storage.getItem(key) !== null) {\n      storage.removeItem(key);\n      cleared.push(key);\n    }\n  }\n\n  return { cleared, available: true };\n}\n\n/** What the reset did, as a sentence a presenter can read aloud if asked. */\nexport function describeReset(result: { cleared: readonly string[]; available: boolean }): string {\n  if (!result.available) {\n    return \"No storage backend available ΓÇö the demo is running in memory and a page reload is the reset.\";\n  }\n  if (result.cleared.length === 0) {\n    return \"Nothing to clear: storage was already empty. Reset is idempotent, so this is a clean start.\";\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *  }\n  if (loaded.unresolved.length > 0) {\n    warnings.push(`${loaded.unresolved.length + \"} corpus label(s) do not resolve ΓÇö the seed will still build, but the metrics would not be trustworthy.\");\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n","ops":[{"diffOp":{"equal":{"range":[0,63]}}},{"equalLines":{"line_count":70}},{"diffOp":{"equal":{"range":[63,123]}}},{"diffOp":{"insert":{"range":[123,126]}}},{"diffOp":{"equal":{"range":[126,150]}}},{"diffOp":{"delete":{"range":[150,154]}}},{"diffOp":{"insert":{"range":[154,155]}}},{"diffOp":{"equal":{"range":[155,259]}}},{"diffOp":{"delete":{"range":[259,260]}}},{"diffOp":{"insert":{"range":[123,124]}}},{"diffOp":{"equal":{"range":[260,267]}}},{"equalLines":{"line_count":91}},{"diffOp":{"equal":{"range":[267,410]}}}]}}]},"verboseAdvices":{"advices":[]},"location":{"path":{"file":".\\src\\eval\\demo\\kit.ts"},"span":[3590,3723],"sourceCode":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *\n * Phase 7 ┬╖ sub-phase 7.5\n *\n * ---------------------------------------------------------------------------\n * WHY THE SEED STATE IS BUILT, NOT CHECKED IN\n *\n * A demo needs to start from a known graph. The obvious implementation is a JSON dump of a graph\n * committed to the repo. That is wrong here for a specific reason: a checked-in state is a snapshot of\n * whatever the extraction pipeline produced on the day it was saved, and the moment extraction changes\n * the demo is showing the audience a graph the product no longer builds. The presenter would be\n * describing behaviour the code does not have.\n *\n * So the seed is BUILT at load time from the two demo fixtures through the real pipeline. It is slower\n * by a second or two and it cannot drift. A demo that shows the shipping code path is worth two seconds.\n *\n * ---------------------------------------------------------------------------\n * RESET IS A WIPE, NOT AN UNDO\n *\n * One-click reset clears every WhyLog storage key and rebuilds the seed. It does not attempt to reverse\n * the events of a live demo, because invariant I1 says nothing is deleted ΓÇö an undo would have to\n * rewrite the log, and a demo that rewrites its own hash chain in front of an audience is a demo that\n * has just contradicted its first claim.\n * ---------------------------------------------------------------------------\n */\n\nimport { createLocalEngine, localEngineId } from \"@/ai/local\";\nimport { nowISO } from \"@/lib/format\";\nimport { appendBatch, emptyLog, fold, type EventLog } from \"@/substrate\";\nimport { STORAGE_KEYS } from \"./keys\";\nimport type { EngineId, ISODateString } from \"@/types/common\";\nimport type { GraphState } from \"@/substrate/graph-state\";\n\n/** The storage keys a reset must clear. Listed here rather than scattered, because a reset that misses\n *  one key leaves the next demo starting from the previous one's state ΓÇö the failure is invisible until\n *  the presenter is three beats in and the graph has nodes nobody imported. */\nexport const RESET_KEYS: readonly string[] = STORAGE_KEYS;\n\nexport interface SeedResult {\n  readonly log: EventLog;\n  readonly state: GraphState;\n  readonly engineId: EngineId;\n  readonly builtAt: ISODateString;\n  readonly decisions: number;\n  readonly premises: number;\n  readonly durationMs: number;\n  /** Anything that went wrong while building. A seed that built with warnings still loads, and the\n   *  presenter needs to know before the demo rather than discovering it on stage. */\n  readonly warnings: readonly string[];\n}\n\n/**\n * Build the seed graph from the demo fixtures through the real pipeline.\n *\n * Delegates to the eval harness rather than reimplementing an import path, because two import paths\n * would eventually disagree and the demo would be exercising the one the metrics do not measure.\n */\nexport async function buildSeed(): Promise<SeedResult> {\n  const started = Date.now();\n  const engine = createLocalEngine();\n  const engineId = localEngineId();\n  const warnings: string[] = [];\n\n  const { corpus, CORPUS_ROOT } = await import(\"../corpus/data\");\n  const { loadCorpus } = await import(\"../corpus/loader\");\n  const { runConfig } = await import(\"../harness\");\n  const { FULL, DEFAULT_PARAMS } = await import(\"../ablation/toggles\");\n\n  const loaded = loadCorpus(corpus, CORPUS_ROOT);\n\n  if (loaded.missingFiles.length > 0) {\n    warnings.push(loaded.missingFiles.length + \" corpus file(s) missing: \" + loaded.missingFiles.join(\", \"));\n  }\n  if (loaded.unresolved.length > 0) {\n    warnings.push(loaded.unresolved.length + \" corpus label(s) do not resolve ΓÇö the seed will still build, but the metrics would not be trustworthy.\");\n  }\n\n  /* Only the two demo fixtures are seeded. The full twelve-transcript corpus produces a graph too large\n   * to walk an audience through in five minutes, and the demo's job is the L1 reversal and the L2\n   * premise invalidation, both of which live entirely in these two files. */\n  const demoOnly = {\n    ...loaded.corpus,\n    transcripts: loaded.corpus.transcripts.filter((transcript) =>\n      transcript.id === \"demo1\" || transcript.id === \"demo2\",\n    ),\n    questions: loaded.corpus.questions.filter((question) => question.id === \"q1\" || question.id === \"q8\"),\n    plants: loaded.corpus.plants.filter((plant) =>\n      plant.id === \"L1-sqlite\" || plant.id === \"L2-premise-falsified\",\n    ),\n  };\n\n  const run = await runConfig(demoOnly, {\n    id: \"demo-seed\",\n    engine,\n    engineId,\n    toggles: FULL,\n    params: DEFAULT_PARAMS,\n  });\n\n  for (const entry of run.transcripts) {\n    if (!entry.ok) warnings.push(\"fixture \" + entry.transcript.id + \" failed to import: \" + (entry.failure ?? \"unknown\"));\n  }\n\n  return {\n    log: rebuildLog(run),\n    state: run.state,\n    engineId,\n    builtAt: nowISO(),\n    decisions: run.state.decisions.size,\n    premises: run.state.premises.size,\n    durationMs: Date.now() - started,\n    warnings,\n  };\n}\n\n/**\n * The event log behind a completed run.\n *\n * The harness keeps its log local and returns only the folded state, because metrics score states. The\n * demo needs the log too, since the app persists and replays events rather than snapshots ΓÇö so it is\n * reconstructed by re-folding the state's own event list, which is authoritative and hash-chained.\n */\nfunction rebuildLog(run: { state: GraphState }): EventLog {\n  const log = emptyLog();\n  const appended = appendBatch(\n    log,\n    run.state.events.map((event) => ({\n      draft: { type: event.type, payload: event.payload, actor: event.actor, reason: event.reason },\n      context: { now: event.at, actor: event.actor, reason: event.reason, occurredAt: event.occurredAt },\n    })),\n  );\n\n  /* Re-appending sealed events re-mints ids and re-stamps times, so the chain will not match the\n   * original. That is acceptable for a seed ΓÇö the app reseals on import via `substrate/portability.ts`,\n   * which is the supported path for bringing an external log in ΓÇö but it is not acceptable to pretend\n   * otherwise, so the reconstruction folds rather than claiming to restore. */\n  return appended.ok ? appended.log : fold(run.state.events, { engine: run.state.computedAt ? localEngineId() : localEngineId(), now: nowISO() }) && emptyLog();\n}\n\n/**\n * One-click reset.\n *\n * Clears every WhyLog key and reports what it cleared. Idempotent: resetting twice is the same as\n * resetting once, which matters because a presenter who is unsure whether the reset landed will press it\n * again, and a reset that compounds would be worse than none.\n */\nexport function resetDemo(storage: Storage | null): { cleared: readonly string[]; available: boolean } {\n  if (storage === null) return { cleared: [], available: false };\n\n  const cleared: string[] = [];\n  for (const key of RESET_KEYS) {\n    if (storage.getItem(key) !== null) {\n      storage.removeItem(key);\n      cleared.push(key);\n    }\n  }\n\n  return { cleared, available: true };\n}\n\n/** What the reset did, as a sentence a presenter can read aloud if asked. */\nexport function describeReset(result: { cleared: readonly string[]; available: boolean }): string {\n  if (!result.available) {\n    return \"No storage backend available ΓÇö the demo is running in memory and a page reload is the reset.\";\n  }\n  if (result.cleared.length === 0) {\n    return \"Nothing to clear: storage was already empty. Reset is idempotent, so this is a clean start.\";\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n"},"tags":["fixable"],"source":null},{"category":"lint/style/useTemplate","severity":"error","description":"Template literals are preferred over string concatenation.","message":[{"elements":["Emphasis"],"content":"Template"},{"elements":[],"content":" literals are preferred over "},{"elements":["Emphasis"],"content":"string concatenation."}],"advices":{"advices":[{"log":["info",[{"elements":[],"content":"Unsafe fix: Use a "},{"elements":["Emphasis"],"content":"template literal"},{"elements":[],"content":"."}]]},{"diff":{"dictionary":"/**\n * The demo kit ΓÇö seed state and one-click reset. 7.5.\n *\n  for (const entry of run.transcripts) {\n    if (!entry.ok) warnings.push(\"`fixture \" + ${entry.transcript.id + \"} failed to import: \"+ (entry.failure ?? \"unknown\")}`);\n  }\n  return \"Cleared \" + result.cleared.length + \" key(s): \" + result.cleared.join(\", \") + \". Rebuilding the seed from the two demo fixtures.\";\n}\n","ops":[{"diffOp":{"equal":{"range":[0,63]}}},{"equalLines":{"line_count":96}},{"diffOp":{"equal":{"range":[63,138]}}},{"diffOp":{"delete":{"range":[138,139]}}},{"diffOp":{"insert":{"range":[139,140]}}},{"diffOp":{"equal":{"range":[140,148]}}},{"diffOp":{"delete":{"range":[148,152]}}},{"diffOp":{"insert":{"range":[152,154]}}},{"diffOp":{"equal":{"range":[154,173]}}},{"diffOp":{"delete":{"range":[173,177]}}},{"diffOp":{"insert":{"range":[177,178]}}},{"diffOp":{"equal":{"range":[178,196]}}},{"diffOp":{"delete":{"range":[196,198]}}},{"diffOp":{"equal":{"range":[178,179]}}},{"diffOp":{"delete":{"range":[198,201]}}},{"diffOp":{"insert":{"range":[152,154]}}},{"diffOp":{"equal":{"range":[201,227]}}},{"diffOp":{"delete":{"range":[227,228]}}},{"diffOp":{"insert":{"range":[228,230]}}},{"diffOp":{"equal":{"range":[230,237]